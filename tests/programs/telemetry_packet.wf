fn store_u32_be['o](out: &uniq 'o buffer<u8>, offset: own u64, value: own u32) -> result: own Result<unit, NarrowError> reads('o), writes('o), traps {
  let first_word = ishr.wrap(value, 24_u32);
  let second_shifted = ishr.wrap(value, 16_u32);
  let second_word = iand(second_shifted, 255_u32);
  let third_shifted = ishr.wrap(value, 8_u32);
  let third_word = iand(third_shifted, 255_u32);
  let fourth_word = iand(value, 255_u32);
  let first = propagate cvt<u32, u8>(first_word);
  let second = propagate cvt<u32, u8>(second_word);
  let third = propagate cvt<u32, u8>(third_word);
  let fourth = propagate cvt<u32, u8>(fourth_word);
  let second_offset = offset +wrap 1_u64;
  let third_offset = offset +wrap 2_u64;
  let fourth_offset = offset +wrap 3_u64;
  let store_room = len(deref(out));
  let first_ok = ilt(offset, store_room);
  claim first_in_out: first_ok because "callers leave four bytes past the offset";
  set deref(out)[offset] = first;
  let second_ok = ilt(second_offset, store_room);
  claim second_in_out: second_ok because "callers leave four bytes past the offset";
  set deref(out)[second_offset] = second;
  let third_ok = ilt(third_offset, store_room);
  claim third_in_out: third_ok because "callers leave four bytes past the offset";
  set deref(out)[third_offset] = third;
  let fourth_ok = ilt(fourth_offset, store_room);
  claim fourth_in_out: fourth_ok because "callers leave four bytes past the offset";
  set deref(out)[fourth_offset] = fourth;
  return Ok<unit, NarrowError>(value: unit);
}

fn load_u32_be['i](input: &'i buffer<u8>, offset: own u64) -> result: own u32 reads('i), traps {
  let second_offset = offset +wrap 1_u64;
  let third_offset = offset +wrap 2_u64;
  let fourth_offset = offset +wrap 3_u64;
  let load_room = len(deref(input));
  let first_load_ok = ilt(offset, load_room);
  claim first_in_input: first_load_ok because "callers leave four bytes past the offset";
  let first_byte = deref(input)[offset];
  let second_load_ok = ilt(second_offset, load_room);
  claim second_in_input: second_load_ok because "callers leave four bytes past the offset";
  let second_byte = deref(input)[second_offset];
  let third_load_ok = ilt(third_offset, load_room);
  claim third_in_input: third_load_ok because "callers leave four bytes past the offset";
  let third_byte = deref(input)[third_offset];
  let fourth_load_ok = ilt(fourth_offset, load_room);
  claim fourth_in_input: fourth_load_ok because "callers leave four bytes past the offset";
  let fourth_byte = deref(input)[fourth_offset];
  let first = cvt<u8, u32>(first_byte);
  let second = cvt<u8, u32>(second_byte);
  let third = cvt<u8, u32>(third_byte);
  let fourth = cvt<u8, u32>(fourth_byte);
  let first_shifted = ishl.wrap(first, 24_u32);
  let second_shifted = ishl.wrap(second, 16_u32);
  let third_shifted = ishl.wrap(third, 8_u32);
  let first_second = ior(first_shifted, second_shifted);
  let first_third = ior(first_second, third_shifted);
  return ior(first_third, fourth);
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let packet = buffer_new(12_u64, 0_u8);
  let temperature = 36.5_f32;
  let temperature_bits = reinterpret<f32, u32>(temperature);
  region 'temperature_write {
    let stored = store_u32_be<'temperature_write>(out: &uniq 'temperature_write packet, offset: 0_u64, value: temperature_bits);
    match move stored {
      Ok(value: success) => {
      }
      Err(error: narrow) => {
        claim temperature_encoding: False() because "temperature encoding";
      }
    }
  }
  let negative_zero = -0.0_f32;
  let negative_zero_bits = reinterpret<f32, u32>(negative_zero);
  region 'zero_write {
    let stored = store_u32_be<'zero_write>(out: &uniq 'zero_write packet, offset: 4_u64, value: negative_zero_bits);
    match move stored {
      Ok(value: success) => {
      }
      Err(error: narrow) => {
        claim negative_zero_encoding: False() because "negative zero encoding";
      }
    }
  }
  let nan = fnan<f32>();
  let nan_bits = reinterpret<f32, u32>(nan);
  region 'nan_write {
    let stored = store_u32_be<'nan_write>(out: &uniq 'nan_write packet, offset: 8_u64, value: nan_bits);
    match move stored {
      Ok(value: success) => {
      }
      Err(error: narrow) => {
        claim nan_encoding: False() because "NaN encoding";
      }
    }
  }
  region 'temperature_read {
    let bits = load_u32_be<'temperature_read>(input: &'temperature_read packet, offset: 0_u64);
    let decoded = reinterpret<u32, f32>(bits);
    claim temperature_round_trip: feq(decoded, temperature) because "temperature round trip";
  }
  region 'zero_read {
    let bits = load_u32_be<'zero_read>(input: &'zero_read packet, offset: 4_u64);
    let decoded = reinterpret<u32, f32>(bits);
    let reciprocal = fdiv.strict(1.0_f32, decoded);
    let infinity = finf<f32>();
    let negative_infinity = fneg(infinity);
    claim negative_zero_sign: feq(reciprocal, negative_infinity) because "negative zero sign";
  }
  region 'nan_read {
    let bits = load_u32_be<'nan_read>(input: &'nan_read packet, offset: 8_u64);
    let decoded = reinterpret<u32, f32>(bits);
    claim nan_round_trip: fne(decoded, decoded) because "NaN round trip";
  }
  return exit_status(code: 0_u8);
}
