struct OptVec {
  buf: buffer<Option<u32>>;
  fill: u64;
}

fn optvec_new(capacity: own u64) -> result: own OptVec allocates(heap) contract {
  requires buffer_fits::<Option<u32>>(capacity);
  requires capacity <= 1000_u64;
} {
  let empty = buffer_vacant::<u32>(capacity);
  return OptVec(buf: move empty, fill: 0_u64);
}

fn optvec_push(v: &uniq OptVec, x: own u32) -> result: own unit reads(v.buf, v.fill), writes(v.buf, v.fill) {
  let count = deref(v).fill;
  let limit = len_of(deref(v).buf);
  let has_room = count < limit;
  if has_room {
  } else {
    return unit;
  }
  let filled = Some<u32>(value: x);
  let displaced = replace deref(v).buf[count] = move filled;
  match displaced {
    None() => {
    }
    Some(value: stray) => {
      return unit;
    }
  }
  let bumped = count + 1_u64;
  set deref(v).fill = bumped;
  return unit;
}

fn optvec_pop(v: &uniq OptVec) -> result: own u32 reads(v.buf, v.fill), writes(v.buf, v.fill) {
  let count = deref(v).fill;
  let nonempty = count > 0_u64;
  if nonempty {
  } else {
    return 0_u32;
  }
  let last = count - 1_u64;
  let limit = len_of(deref(v).buf);
  let in_range = last < limit;
  if in_range {
  } else {
    return 0_u32;
  }
  let taken = replace deref(v).buf[last] = None<u32>();
  set deref(v).fill = last;
  match taken {
    None() => {
      return 0_u32;
    }
    Some(value: w) => {
      return w;
    }
  }
}

fn boxed_slots() -> result: own unit allocates(heap) {
  let slots = buffer_vacant::<box<u64>>(3_u64);
  let first = box_new(11_u64);
  let wrapped = Some<box<u64>>(value: move first);
  let vacant = replace slots[0_u64] = move wrapped;
  match vacant {
    None() => {
    }
    Some(value: stray) => {
      return unit;
    }
  }
  let second = box_new(22_u64);
  let wrapped2 = Some<box<u64>>(value: move second);
  let vacant2 = replace slots[2_u64] = move wrapped2;
  match vacant2 {
    None() => {
    }
    Some(value: stray2) => {
      return unit;
    }
  }
  let taken = replace slots[0_u64] = None<box<u64>>();
  match taken {
    None() => {
      return unit;
    }
    Some(value: payload) => {
      let observed = deref(payload);
      if observed == 11_u64 {
      } else {
        return unit;
      }
    }
  }
  return unit;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let v = optvec_new(capacity: 4_u64);
  region {
    optvec_push(v: &uniq v, x: 10_u32);
  }
  region {
    optvec_push(v: &uniq v, x: 20_u32);
  }
  region {
    optvec_push(v: &uniq v, x: 30_u32);
  }
  region {
    let top = optvec_pop(v: &uniq v);
    if top == 30_u32 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  let remaining = v.fill;
  if remaining == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  boxed_slots();
  return exit_status(code: 0_u8);
}
