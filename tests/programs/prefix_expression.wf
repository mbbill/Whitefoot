const prefix_input: FixedVector<u8, 5> =[43_u8, 50_u8, 43_u8, 51_u8, 52_u8];

const prefix_incomplete: FixedVector<u8, 2> =[43_u8, 50_u8];

enum Expression['s] {
  Literal(value: u64);
  Add(left: Box<'s, Expression<'s>>, right: Box<'s, Expression<'s>>);
}

enum ParseError {
  Truncated();
  InvalidToken();
  NoStore();
}

struct ParseOutput['s] {
  node: Box<'s, Expression<'s>>;
  next: u64;
}

fn parse_expression['s](store: &uniq Heap<'s>, input: own Slice<u8>, offset: own u64) -> result: own Result<ParseOutput<'s>, ParseError> reads(store, input), writes(store), allocates(store) {
  doc "The refusal arm is the honest cost of a store that can say no: a cell formation hands the value back rather than trapping, so the parser carries one more error variant.";
  let size = len_of(input);
  let available = offset < size;
  if available {
  } else {
    let truncated_error = Truncated();
    return Err<ParseOutput<'s>, ParseError>(error: truncated_error);
  }
  let token = input[offset];
  let next = offset + 1_u64;
  let is_add = token == 43_u8;
  if is_add {
    region {
      match parse_expression(store: &uniq deref(store), input: input, offset: next) {
        Err(error: left_error) => {
          return Err<ParseOutput<'s>, ParseError>(error: left_error);
        }
        Ok(value: left_output) => {
          let right_offset = left_output.next;
          region {
            match parse_expression(store: &uniq deref(store), input: input, offset: right_offset) {
              Err(error: right_error) => {
                return Err<ParseOutput<'s>, ParseError>(error: right_error);
              }
              Ok(value: right_output) => {
                let final_offset = right_output.next;
                let left_node = move left_output.node;
                let right_node = move right_output.node;
                let expression = Add(left: move left_node, right: move right_node);
                region {
                  match heap_box(store: &uniq deref(store), value: move expression) {
                    Ok(value: node) => {
                      let output = ParseOutput(node: move node, next: final_offset);
                      return Ok<ParseOutput<'s>, ParseError>(value: move output);
                    }
                    Err(error: refused) => {
                      let store_error = NoStore();
                      return Err<ParseOutput<'s>, ParseError>(error: store_error);
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  } else {
    let below_digit = token < 48_u8;
    if below_digit {
      let low_error = InvalidToken();
      return Err<ParseOutput<'s>, ParseError>(error: low_error);
    }
    let above_digit = token > 57_u8;
    if above_digit {
      let high_error = InvalidToken();
      return Err<ParseOutput<'s>, ParseError>(error: high_error);
    }
    let digit_byte = token -wrap 48_u8;
    let digit = cvt::<u8, u64>(digit_byte);
    let expression = Literal<'s>(value: digit);
    region {
      match heap_box(store: &uniq deref(store), value: move expression) {
        Ok(value: node) => {
          let output = ParseOutput(node: move node, next: next);
          return Ok<ParseOutput<'s>, ParseError>(value: move output);
        }
        Err(error: refused) => {
          let store_error = NoStore();
          return Err<ParseOutput<'s>, ParseError>(error: store_error);
        }
      }
    }
  }
}

fn evaluate['s](expression: &Box<'s, Expression<'s>>) -> result: own Result<u64, Overflow> reads(expression) {
  match deref(deref(expression)) {
    Literal(value: literal_value) => {
      return Ok<u64, Overflow>(value: deref(literal_value));
    }
    Add(left: node_left, right: node_right) => {
      let left_value = propagate evaluate(expression: node_left);
      let right_value = propagate evaluate(expression: node_right);
      return left_value +checked right_value;
    }
  }
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  region {
    let input = slice_of(&prefix_input);
    let parsed = parse_expression(store: &uniq heap, input: input, offset: 0_u64);
    match parsed {
      Ok(value: output) => {
        let consumed = output.next;
        if consumed == 5_u64 {
        } else {
          return exit_status(code: 1_u8);
        }
        let root = move output.node;
        region {
          match evaluate(expression: &root) {
            Ok(value: evaluated) => {
              if evaluated == 9_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
            }
            Err(error: overflow) => {
              return exit_status(code: 1_u8);
            }
          }
        }
      }
      Err(error: parse_error) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  region {
    let incomplete = slice_of(&prefix_incomplete);
    let incomplete_result = parse_expression(store: &uniq heap, input: incomplete, offset: 0_u64);
    match incomplete_result {
      Ok(value: unexpected_output) => {
        return exit_status(code: 1_u8);
      }
      Err(error: expected_error) => {
      }
    }
  }
  return exit_status(code: 0_u8);
}
