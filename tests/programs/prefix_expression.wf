enum Expression {
  Literal(value: u64);
  Add(left: box<Expression>, right: box<Expression>);
}

enum ParseError {
  Truncated();
  InvalidToken();
}

struct ParseOutput {
  node: box<Expression>;
  next: u64;
}

fn parse_expression['r](input: &'r buffer<u8>, offset: own u64) -> result: own Result<ParseOutput, ParseError> reads('r), allocates(heap), traps {
  let size = len(deref(input));
  let available = ilt(offset, size);
  if available {
  } else {
    let truncated_error = Truncated();
    return Err<ParseOutput, ParseError>(error: truncated_error);
  }
  let token = deref(input)[offset];
  let next = offset + 1_u64;
  let is_add = ieq(token, 43_u8);
  if is_add {
    let left_output = propagate parse_expression<'r>(input: input, offset: next);
    let right_offset = left_output.next;
    let right_output = propagate parse_expression<'r>(input: input, offset: right_offset);
    let final_offset = right_output.next;
    let left_node = move left_output.node;
    let right_node = move right_output.node;
    let expression = Add(left: move left_node, right: move right_node);
    let node = box_new(move expression);
    let output = ParseOutput(node: move node, next: final_offset);
    return Ok<ParseOutput, ParseError>(value: move output);
  } else {
    let below_digit = ilt(token, 48_u8);
    if below_digit {
      let low_error = InvalidToken();
      return Err<ParseOutput, ParseError>(error: low_error);
    }
    let above_digit = igt(token, 57_u8);
    if above_digit {
      let high_error = InvalidToken();
      return Err<ParseOutput, ParseError>(error: high_error);
    }
    let digit_byte = token -wrap 48_u8;
    let digit = cvt<u8, u64>(digit_byte);
    let expression = Literal(value: digit);
    let node = box_new(move expression);
    let output = ParseOutput(node: move node, next: next);
    return Ok<ParseOutput, ParseError>(value: move output);
  }
}

fn evaluate['r](expression: &'r box<Expression>) -> result: own u64 reads('r), traps {
  match deref(deref(expression)) {
    Literal(value: literal_value) => {
      return deref(literal_value);
    }
    Add(left: node_left, right: node_right) => {
      let left_value = evaluate<'r>(expression: node_left);
      let right_value = evaluate<'r>(expression: node_right);
      let sum_defined = left_value +defined right_value;
      claim expression_sum_fits: sum_defined because "the evaluated expression result must fit in u64";
      return left_value + right_value;
    }
  }
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let input = buffer_new(5_u64, 0_u8);
  set input[0_u64] = 43_u8;
  set input[1_u64] = 50_u8;
  set input[2_u64] = 43_u8;
  set input[3_u64] = 51_u8;
  set input[4_u64] = 52_u8;
  region 'input {
    let parsed = parse_expression<'input>(input: &'input input, offset: 0_u64);
    match parsed {
      Ok(value: output) => {
        let consumed = output.next;
        claim prefix_parser_left_trailing_input: ieq(consumed, 5_u64) because "prefix parser left trailing input";
        let root = move output.node;
        region 'tree {
          let value = evaluate<'tree>(expression: &'tree root);
          claim prefix_expression_result: ieq(value, 9_u64) because "prefix expression result";
        }
      }
      Err(error: parse_error) => {
        claim valid_prefix_expression_rejected: False() because "valid prefix expression rejected";
      }
    }
  }
  let incomplete = buffer_new(2_u64, 0_u8);
  set incomplete[0_u64] = 43_u8;
  set incomplete[1_u64] = 50_u8;
  region 'incomplete {
    let incomplete_result = parse_expression<'incomplete>(input: &'incomplete incomplete, offset: 0_u64);
    match incomplete_result {
      Ok(value: unexpected_output) => {
        claim truncated_prefix_expression_accepted: False() because "truncated prefix expression accepted";
      }
      Err(error: expected_error) => {
      }
    }
  }
  return exit_status(code: 0_u8);
}
