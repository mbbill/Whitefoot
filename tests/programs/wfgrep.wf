const reason_root_too_long: array<u8, 29> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 115_u8, 101_u8, 97_u8, 114_u8, 99_u8, 104_u8, 32_u8, 114_u8, 111_u8, 111_u8, 116_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

struct TrailingChunk {
  available: u64;
  status: u8;
}

struct LineScan {
  terminator: u64;
  hit: Bool;
  status: u8;
}

struct ShiftedTail {
  tail: u64;
  status: u8;
}

fn io_class(error: own IoError) -> result: own u8 pure {
  doc "Reduces one portable IoError class to the distinctions wfgrep reports.";
  match error {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 9_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 9_u8;
    }
    Interrupted(code: c, origin: o) => {
      return 9_u8;
    }
    WouldBlock(code: c, origin: o) => {
      return 9_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 4_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn append_slice['d, 'm](destination: &uniq 'd buffer<u8>, filled: own u64, text: own slice<'m, u8>) -> result: own u64 reads('d 'm), writes('d) contract {
  define capacity = len(deref(destination));
  define admitted = ile(filled, capacity);
  requires admitted;
  ensures ile(result, capacity);
} {
  doc "Appends as much of one static message as the destination still holds.";
  let capacity = len(deref(destination));
  let admitted = ile(filled, capacity);
  let length = len(text);
  if admitted {
    for @append at in filled..capacity {
      let taken = at -wrap filled;
      let done = ige(taken, length);
      if done {
        return at;
      }
      let byte = text[taken];
      set deref(destination)[at] = byte;
    }
    return capacity;
  } else {
    return filled;
  }
}

fn copy_range['d, 's](destination: &uniq 'd buffer<u8>, at: own u64, source: &'s buffer<u8>, from: own u64, to: own u64) -> result: own u64 reads('d 's), writes('d) {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = len(deref(source));
  let destination_room = len(deref(destination));
  let target = at;
  let cursor = from;
  loop @copy {
    let done = ige(cursor, to);
    if done {
      break @copy;
    }
    let read_ok = ilt(cursor, source_room);
    if read_ok {
    } else {
      return target;
    }
    let byte = deref(source)[cursor];
    let write_ok = ilt(target, destination_room);
    if write_ok {
    } else {
      return target;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  return target;
}

fn publish_all['o, 's](output: &uniq 'o Output, source: &'s buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads('o 's), writes('o), external, blocks contract {
  define source_length = len(deref(source));
  requires ile(length, source_length);
} {
  doc "Publishes one prefix of the source buffer, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = ilt(sent, length);
    if pending {
    } else {
      break @publish;
    }
    region 'attempt {
      match write_once<'attempt, 's>(output: &uniq 'attempt deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

deny_claims fn byte_at['n](store: &'n buffer<u8>, index: own u64) -> result: own u8 reads('n) {
  doc "Reads one stored byte, delivering zero for a position the buffer does not hold.";
  let room = len(deref(store));
  let inside = ilt(index, room);
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

deny_claims fn name_before['n](names: &'n buffer<u8>, left: own u64, right: own u64) -> result: own Bool reads('n) {
  doc "Orders two collected entry records by their stored name bytes, a shorter prefix first.";
  let left_base = left *wrap 1026_u64;
  let right_base = right *wrap 1026_u64;
  let left_length_low_at = left_base +wrap 1_u64;
  let right_length_low_at = right_base +wrap 1_u64;
  let left_length_low = byte_at<'n>(store: names, index: left_length_low_at);
  let right_length_low = byte_at<'n>(store: names, index: right_length_low_at);
  let left_length_high_at = left_base +wrap 2_u64;
  let right_length_high_at = right_base +wrap 2_u64;
  let left_length_high = byte_at<'n>(store: names, index: left_length_high_at);
  let right_length_high = byte_at<'n>(store: names, index: right_length_high_at);
  let left_count_low = cvt<u8, u64>(left_length_low);
  let right_count_low = cvt<u8, u64>(right_length_low);
  let left_count_high = cvt<u8, u64>(left_length_high);
  let right_count_high = cvt<u8, u64>(right_length_high);
  let left_count_high_shifted = ishl.wrap(left_count_high, 8_u32);
  let right_count_high_shifted = ishl.wrap(right_count_high, 8_u32);
  let left_count = ior(left_count_low, left_count_high_shifted);
  let right_count = ior(right_count_low, right_count_high_shifted);
  let shared = if ilt(left_count, right_count) {
    give left_count;
  } else {
    give right_count;
  }
  let left_start = left_base +wrap 3_u64;
  let right_start = right_base +wrap 3_u64;
  let at = 0_u64;
  loop @compare {
    let done = ige(at, shared);
    if done {
      break @compare;
    }
    let left_at = left_start +wrap at;
    let right_at = right_start +wrap at;
    let left_byte = byte_at<'n>(store: names, index: left_at);
    let right_byte = byte_at<'n>(store: names, index: right_at);
    if ilt(left_byte, right_byte) {
      return True();
    }
    if igt(left_byte, right_byte) {
      return False();
    }
    set at = at +wrap 1_u64;
  }
  return ilt(left_count, right_count);
}

fn put_decimal['d](destination: &uniq 'd buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads('d), writes('d) {
  doc "Writes the decimal spelling of one unsigned value at one offset and reports the offset just past it, counting its digits first so it needs no scratch storage.";
  let digits = 1_u64;
  let probe = value;
  loop @measure {
    let single = ilt(probe, 10_u64);
    if single {
      break @measure;
    }
    set probe = probe / 10_u64;
    set digits = digits +wrap 1_u64;
  }
  let room = len(deref(destination));
  let glyphs = len(digit_glyphs);
  let end = at +wrap digits;
  let cursor = end;
  let rest = value;
  loop @emit {
    let started = ile(cursor, at);
    if started {
      break @emit;
    }
    set cursor = cursor -wrap 1_u64;
    let digit = rest % 10_u64;
    let known = ilt(digit, glyphs);
    if known {
      let writable = ilt(cursor, room);
      if writable {
        let glyph = digit_glyphs[digit];
        set deref(destination)[cursor] = glyph;
      }
    }
    set rest = rest / 10_u64;
  }
  return end;
}

fn report_failure['e, 'r, 'n](err: &uniq 'e Output, report: &uniq 'r buffer<u8>, path: &'n buffer<u8>, path_length: own u64, status: own u8) -> result: own unit reads('e 'r 'n), writes('e 'r), external, blocks {
  doc "Assembles one `wfgrep: PATH: reason` diagnostic in the report buffer and publishes it with a single write, copying the caller's path bytes and clamping the assembled length against the report's capacity.";
  let length = 0_u64;
  region 'report_prefix {
    let view = slice_of(&'report_prefix error_prefix);
    region 'prefix_append {
      set length = append_slice<'prefix_append, 'report_prefix>(destination: &uniq 'prefix_append deref(report), filled: length, text: move view);
    }
  }
  let prior_length = length;
  let report_capacity = len(deref(report));
  let path_room = len(deref(path));
  let copied_count = 0_u64;
  loop @name {
    let done = ige(copied_count, path_length);
    if done {
      break @name;
    }
    let readable = ilt(copied_count, path_room);
    if readable {
    } else {
      break @name;
    }
    let target_at = prior_length +wrap copied_count;
    let writable = ilt(target_at, report_capacity);
    if writable {
    } else {
      break @name;
    }
    let byte = deref(path)[copied_count];
    set deref(report)[target_at] = byte;
    set copied_count = copied_count +wrap 1_u64;
  }
  let candidate_length = prior_length +wrap copied_count;
  let candidate_fits = ile(candidate_length, report_capacity);
  let tail = if candidate_fits {
    give candidate_length;
  } else {
    give prior_length;
  }
  region 'report_separator {
    let view = slice_of(&'report_separator error_separator);
    region 'separator_append {
      set tail = append_slice<'separator_append, 'report_separator>(destination: &uniq 'separator_append deref(report), filled: tail, text: move view);
    }
  }
  let named = 0_u8;
  if ieq(status, 1_u8) {
    set named = 1_u8;
    region 'reason_missing_view {
      let view = slice_of(&'reason_missing_view reason_missing);
      region 'reason_missing_append {
        set tail = append_slice<'reason_missing_append, 'reason_missing_view>(destination: &uniq 'reason_missing_append deref(report), filled: tail, text: move view);
      }
    }
  }
  if ieq(status, 2_u8) {
    set named = 1_u8;
    region 'reason_denied_view {
      let view = slice_of(&'reason_denied_view reason_denied);
      region 'reason_denied_append {
        set tail = append_slice<'reason_denied_append, 'reason_denied_view>(destination: &uniq 'reason_denied_append deref(report), filled: tail, text: move view);
      }
    }
  }
  if ieq(status, 3_u8) {
    set named = 1_u8;
    region 'reason_directory_view {
      let view = slice_of(&'reason_directory_view reason_directory);
      region 'reason_directory_append {
        set tail = append_slice<'reason_directory_append, 'reason_directory_view>(destination: &uniq 'reason_directory_append deref(report), filled: tail, text: move view);
      }
    }
  }
  if ieq(status, 5_u8) {
    set named = 1_u8;
    region 'reason_path_view {
      let view = slice_of(&'reason_path_view reason_invalid_path);
      region 'reason_path_append {
        set tail = append_slice<'reason_path_append, 'reason_path_view>(destination: &uniq 'reason_path_append deref(report), filled: tail, text: move view);
      }
    }
  }
  if ieq(status, 6_u8) {
    set named = 1_u8;
    region 'reason_long_view {
      let view = slice_of(&'reason_long_view reason_long_line);
      region 'reason_long_append {
        set tail = append_slice<'reason_long_append, 'reason_long_view>(destination: &uniq 'reason_long_append deref(report), filled: tail, text: move view);
      }
    }
  }
  if ieq(named, 0_u8) {
    region 'reason_other_view {
      let view = slice_of(&'reason_other_view reason_unreadable);
      region 'reason_other_append {
        set tail = append_slice<'reason_other_append, 'reason_other_view>(destination: &uniq 'reason_other_append deref(report), filled: tail, text: move view);
      }
    }
  }
  region 'reason_write {
    match publish_all<'reason_write, 'reason_write>(output: &uniq 'reason_write deref(err), source: &'reason_write deref(report), length: tail) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return unit;
}

fn append_trailing_newline['i](input: &uniq 'i buffer<u8>, carry: own u64) -> result: own TrailingChunk reads('i), writes('i), traps {
  let input_room = len(deref(input));
  let admitted = ile(carry, input_room);
  if admitted {
  } else {
    let rejected = TrailingChunk(available: carry, status: 6_u8);
    return move rejected;
  }
  let room = input_room -wrap carry;
  let full = ieq(room, 0_u64);
  if full {
    let rejected = TrailingChunk(available: carry, status: 6_u8);
    return move rejected;
  }
  let carry_ok = ilt(carry, input_room);
  claim carry_in_input: carry_ok because "premises: carry is at most the input length, room is that length minus carry, and the full branch returns before the write\nderivation: the surviving nonzero room means carry is strictly below the input length\nconclusion: carry_ok is true\nchecker gap: ENT does not invert the wrapping subtraction and nonzero-result test into the strict operand bound\nconsumers: the following input[carry] write requires this exact bound";
  set deref(input)[carry] = 10_u8;
  let available = carry +wrap 1_u64;
  let accepted = TrailingChunk(available: available, status: 0_u8);
  return move accepted;
}

fn scan_line['i, 'p](input: &'i buffer<u8>, available: own u64, scan: own u64, pattern: &'p buffer<u8>, pattern_length: own u64, first_pattern_byte: own u8, empty_pattern: own Bool) -> result: own LineScan reads('i 'p), traps {
  let input_room = len(deref(input));
  let bounded_available = imin(available, input_room);
  let available_fits = ieq(available, bounded_available);
  if available_fits {
  } else {
    let missed = False();
    let rejected = LineScan(terminator: available, hit: missed, status: 6_u8);
    return move rejected;
  }
  let bounded_scan = imin(scan, bounded_available);
  let scan_fits = ieq(scan, bounded_scan);
  if scan_fits {
  } else {
    let missed = False();
    let rejected = LineScan(terminator: available, hit: missed, status: 6_u8);
    return move rejected;
  }
  let pattern_room = len(deref(pattern));
  let terminator = available;
  let hit = empty_pattern;
  let probe = scan;
  loop @walk_line {
    let done = ige(probe, bounded_available);
    if done {
      break @walk_line;
    }
    let probe_ok = ilt(probe, input_room);
    claim probe_in_input: probe_ok because "premises: bounded_available is the minimum of available and the input length; the equality branch rejects clipping; bounded_scan similarly admits scan; probe starts at scan and increments only while below bounded_available\nderivation: induction gives probe strictly below bounded_available, and the minimum cannot exceed the input length\nconclusion: probe_ok is true\nchecker gap: ENT does not publish the result range of imin or carry the probe induction across the ordinary-loop backedge\nconsumers: the following input[probe] read requires this exact bound";
    let byte = deref(input)[probe];
    let newline = ieq(byte, 10_u8);
    if newline {
      set terminator = probe;
      break @walk_line;
    }
    if hit {
    } else {
      let lead = ieq(byte, first_pattern_byte);
      if lead {
        let same = True();
        let ahead = 1_u64;
        loop @verify_line {
          let proven = ige(ahead, pattern_length);
          if proven {
            break @verify_line;
          }
          let spot = probe +wrap ahead;
          let inside = ilt(spot, bounded_available);
          if inside {
          } else {
            set same = False();
            break @verify_line;
          }
          let spot_ok = ilt(spot, input_room);
          claim spot_in_input: spot_ok because "premises: bounded_available is the minimum of available and the input length, and the surviving inside branch establishes spot strictly below bounded_available\nderivation: the minimum cannot exceed the input length, so spot is strictly below the input length\nconclusion: spot_ok is true\nchecker gap: ENT does not publish the result range of imin through the enclosing ordinary-loop backedges\nconsumers: the following input[spot] read requires this exact bound";
          let candidate = deref(input)[spot];
          let stopper = ieq(candidate, 10_u8);
          if stopper {
            set same = False();
            break @verify_line;
          }
          let ahead_ok = ilt(ahead, pattern_room);
          if ahead_ok {
          } else {
            set same = False();
            break @verify_line;
          }
          let expected = deref(pattern)[ahead];
          let equal = ieq(candidate, expected);
          if equal {
          } else {
            set same = False();
            break @verify_line;
          }
          set ahead = ahead +wrap 1_u64;
        }
        if same {
          set hit = True();
        }
      }
    }
    set probe = probe +wrap 1_u64;
  }
  let accepted = LineScan(terminator: terminator, hit: hit, status: 0_u8);
  return move accepted;
}

fn shift_input_tail['i](input: &uniq 'i buffer<u8>, available: own u64, scan: own u64) -> result: own ShiftedTail reads('i), writes('i), traps {
  let input_room = len(deref(input));
  let bounded_available = imin(available, input_room);
  let available_fits = ieq(available, bounded_available);
  if available_fits {
  } else {
    let rejected = ShiftedTail(tail: 0_u64, status: 6_u8);
    return move rejected;
  }
  let bounded_scan = imin(scan, bounded_available);
  let scan_fits = ieq(scan, bounded_scan);
  if scan_fits {
  } else {
    let rejected = ShiftedTail(tail: 0_u64, status: 6_u8);
    return move rejected;
  }
  let tail = bounded_available -wrap bounded_scan;
  let moved = 0_u64;
  loop @shift_input {
    let done = ige(moved, tail);
    if done {
      break @shift_input;
    }
    let source_index = bounded_scan +wrap moved;
    let shift_read_ok = ilt(source_index, input_room);
    claim shift_read_in_input: shift_read_ok because "premises: bounded_available is the minimum of available and the input length; bounded_scan is the minimum of scan and bounded_available; tail is their difference; moved starts at zero and continues only below tail\nderivation: induction gives source_index strictly below bounded_available and therefore below the input length without wrap\nconclusion: shift_read_ok is true\nchecker gap: ENT publishes neither imin result range nor the nested moved-and-sum induction across the loop backedge\nconsumers: the following input[source_index] read requires this exact bound";
    let byte = deref(input)[source_index];
    let shift_write_ok = ilt(moved, input_room);
    claim shift_write_in_input: shift_write_ok because "premises: tail is bounded_available minus bounded_scan, bounded_available is the minimum of available and the input length, and moved starts at zero and continues only below tail\nderivation: tail is at most bounded_available and induction gives moved below tail, so moved is below the input length\nconclusion: shift_write_ok is true\nchecker gap: ENT publishes neither imin result range nor the tail and moved induction across the ordinary-loop backedge\nconsumers: the following input[moved] write requires this exact bound";
    set deref(input)[moved] = byte;
    set moved = moved +wrap 1_u64;
  }
  let accepted = ShiftedTail(tail: tail, status: 0_u8);
  return move accepted;
}

fn search_file['f, 'a, 'n, 'o](file: &uniq 'f ReadFile, pattern: &'a buffer<u8>, pattern_length: own u64, path: &'n buffer<u8>, path_length: own u64, out: &uniq 'o Output) -> result: own u8 reads('f 'a 'n 'o), writes('f 'o), allocates(heap), external, blocks, traps {
  doc "Reads one open file and publishes `PATH:LINE:TEXT` for every line that holds the literal pattern bytes.";
  let input = buffer_new(4096_u64, 0_u8);
  let batch = buffer_new(8192_u64, 0_u8);
