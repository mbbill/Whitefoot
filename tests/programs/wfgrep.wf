const digit_glyphs: array<u8, 10> =[48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8];

const usage_text: array<u8, 27> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 32_u8, 80_u8, 65_u8, 84_u8, 84_u8, 69_u8, 82_u8, 78_u8, 32_u8, 82_u8, 79_u8, 79_u8, 84_u8, 10_u8];

const error_prefix: array<u8, 8> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8];

const error_separator: array<u8, 2> =[58_u8, 32_u8];

const reason_missing: array<u8, 26> =[110_u8, 111_u8, 32_u8, 115_u8, 117_u8, 99_u8, 104_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 111_u8, 114_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_denied: array<u8, 18> =[112_u8, 101_u8, 114_u8, 109_u8, 105_u8, 115_u8, 115_u8, 105_u8, 111_u8, 110_u8, 32_u8, 100_u8, 101_u8, 110_u8, 105_u8, 101_u8, 100_u8, 10_u8];

const reason_directory: array<u8, 15> =[105_u8, 115_u8, 32_u8, 97_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_invalid_path: array<u8, 22> =[105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 114_u8, 101_u8, 108_u8, 97_u8, 116_u8, 105_u8, 118_u8, 101_u8, 32_u8, 112_u8, 97_u8, 116_u8, 104_u8, 10_u8];

const reason_long_line: array<u8, 14> =[108_u8, 105_u8, 110_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

const reason_unreadable: array<u8, 12> =[99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 10_u8];

const reason_pattern_too_long: array<u8, 25> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 112_u8, 97_u8, 116_u8, 116_u8, 101_u8, 114_u8, 110_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

const reason_root_too_long: array<u8, 29> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 115_u8, 101_u8, 97_u8, 114_u8, 99_u8, 104_u8, 32_u8, 114_u8, 111_u8, 111_u8, 116_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

struct TrailingChunk {
  available: u64;
  status: u8;
}

struct LineScan {
  terminator: u64;
  hit: Bool;
  status: u8;
}

struct ShiftedTail {
  tail: u64;
  status: u8;
}

fn io_class(error: own IoError) -> result: own u8 pure {
  doc "Reduces one portable IoError class to the distinctions wfgrep reports.";
  match error {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 9_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 9_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 4_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn append_slice(destination: &uniq buffer<u8>, filled: own u64, text: own slice<u8>) -> result: own u64 reads(destination, text), writes(destination) contract {
  define capacity = len(deref(destination));
  define admitted = filled <= capacity;
  requires admitted;
  ensures result <= capacity;
} {
  doc "Appends as much of one static message as the destination still holds.";
  let capacity = len(deref(destination));
  let admitted = filled <= capacity;
  let length = len(text);
  if admitted {
    for @append (at in filled..capacity) {
      let taken = at -wrap filled;
      let done = taken >= length;
      if done {
        return at;
      }
      let byte = text[taken];
      set deref(destination)[at] = byte;
    }
    return capacity;
  } else {
    return filled;
  }
}

fn copy_range(destination: &uniq buffer<u8>, at: own u64, source: &buffer<u8>, from: own u64, to: own u64) -> result: own u64 reads(destination, source), writes(destination) {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = len(deref(source));
  let destination_room = len(deref(destination));
  let target = at;
  let cursor = from;
  loop @copy {
    let done = cursor >= to;
    if done {
      break @copy;
    }
    let read_ok = cursor < source_room;
    if read_ok {
    } else {
      return target;
    }
    let byte = deref(source)[cursor];
    let write_ok = target < destination_room;
    if write_ok {
    } else {
      return target;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  return target;
}

fn publish_all(output: &uniq Output, source: &buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define source_length = len(deref(source));
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source buffer, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(output: &uniq deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn byte_at(store: &buffer<u8>, index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the buffer does not hold.";
  let room = len(deref(store));
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn name_before(names: &buffer<u8>, left: own u64, right: own u64) -> result: own Bool reads(names) {
  doc "Orders two collected entry records by their stored name bytes, a shorter prefix first.";
  let left_base = left *wrap 1026_u64;
  let right_base = right *wrap 1026_u64;
  let left_length_low_at = left_base +wrap 1_u64;
  let right_length_low_at = right_base +wrap 1_u64;
  let left_length_low = byte_at(store: names, index: left_length_low_at);
  let right_length_low = byte_at(store: names, index: right_length_low_at);
  let left_length_high_at = left_base +wrap 2_u64;
  let right_length_high_at = right_base +wrap 2_u64;
  let left_length_high = byte_at(store: names, index: left_length_high_at);
  let right_length_high = byte_at(store: names, index: right_length_high_at);
  let left_count_low = cvt::<u8, u64>(left_length_low);
  let right_count_low = cvt::<u8, u64>(right_length_low);
  let left_count_high = cvt::<u8, u64>(left_length_high);
  let right_count_high = cvt::<u8, u64>(right_length_high);
  let left_count_high_shifted = ishl.wrap(left_count_high, 8_u32);
  let right_count_high_shifted = ishl.wrap(right_count_high, 8_u32);
  let left_count = ior(left_count_low, left_count_high_shifted);
  let right_count = ior(right_count_low, right_count_high_shifted);
  let shared = if left_count < right_count {
    give left_count;
  } else {
    give right_count;
  }
  let left_start = left_base +wrap 3_u64;
  let right_start = right_base +wrap 3_u64;
  let at = 0_u64;
  loop @compare {
    let done = at >= shared;
    if done {
      break @compare;
    }
    let left_at = left_start +wrap at;
    let right_at = right_start +wrap at;
    let left_byte = byte_at(store: names, index: left_at);
    let right_byte = byte_at(store: names, index: right_at);
    if left_byte < right_byte {
      return True();
    }
    if left_byte > right_byte {
      return False();
    }
    set at = at +wrap 1_u64;
  }
  return left_count < right_count;
}

fn put_decimal(destination: &uniq buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination) {
  doc "Writes the decimal spelling of one unsigned value at one offset and reports the offset just past it, counting its digits first so it needs no scratch storage.";
  let digits = 1_u64;
  let probe = value;
  loop @measure {
    let single = probe < 10_u64;
    if single {
      break @measure;
    }
    set probe = probe / 10_u64;
    set digits = digits +wrap 1_u64;
  }
  let room = len(deref(destination));
  let glyphs = len(digit_glyphs);
  let end = at +wrap digits;
  let cursor = end;
  let rest = value;
  loop @emit {
    let started = cursor <= at;
    if started {
      break @emit;
    }
    set cursor = cursor -wrap 1_u64;
    let digit = rest % 10_u64;
    let known = digit < glyphs;
    if known {
      let writable = cursor < room;
      if writable {
        let glyph = digit_glyphs[digit];
        set deref(destination)[cursor] = glyph;
      }
    }
    set rest = rest / 10_u64;
  }
  return end;
}

fn report_failure(err: &uniq Output, report: &uniq buffer<u8>, path: &buffer<u8>, path_length: own u64, status: own u8) -> result: own unit reads(err, report, path), writes(err, report) {
  doc "Assembles one `wfgrep: PATH: reason` diagnostic in the report buffer and publishes it with a single write, copying the caller's path bytes and clamping the assembled length against the report's capacity.";
  let length = 0_u64;
  region {
    let view = slice_of(&error_prefix);
    region {
      set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
    }
  }
  let prior_length = length;
  let report_capacity = len(deref(report));
  let path_room = len(deref(path));
  let copied_count = 0_u64;
  loop @name {
    let done = copied_count >= path_length;
    if done {
      break @name;
    }
    let readable = copied_count < path_room;
    if readable {
    } else {
      break @name;
    }
    let target_at = prior_length +wrap copied_count;
    let writable = target_at < report_capacity;
    if writable {
    } else {
      break @name;
    }
    let byte = deref(path)[copied_count];
    set deref(report)[target_at] = byte;
    set copied_count = copied_count +wrap 1_u64;
  }
  let candidate_length = prior_length +wrap copied_count;
  let candidate_fits = candidate_length <= report_capacity;
  let tail = if candidate_fits {
    give candidate_length;
  } else {
    give prior_length;
  }
  region {
    let view = slice_of(&error_separator);
    region {
      set tail = append_slice(destination: &uniq deref(report), filled: tail, text: move view);
    }
  }
  let named = 0_u8;
  if status == 1_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_missing);
      region {
        set tail = append_slice(destination: &uniq deref(report), filled: tail, text: move view);
      }
    }
  }
  if status == 2_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_denied);
      region {
        set tail = append_slice(destination: &uniq deref(report), filled: tail, text: move view);
      }
    }
  }
  if status == 3_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_directory);
      region {
        set tail = append_slice(destination: &uniq deref(report), filled: tail, text: move view);
      }
    }
  }
  if status == 5_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_invalid_path);
      region {
        set tail = append_slice(destination: &uniq deref(report), filled: tail, text: move view);
      }
    }
  }
  if status == 6_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_long_line);
      region {
        set tail = append_slice(destination: &uniq deref(report), filled: tail, text: move view);
      }
    }
  }
  if named == 0_u8 {
    region {
      let view = slice_of(&reason_unreadable);
      region {
        set tail = append_slice(destination: &uniq deref(report), filled: tail, text: move view);
      }
    }
  }
  region {
    match publish_all(output: &uniq deref(err), source: &deref(report), length: tail) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return unit;
}

fn append_trailing_newline(input: &uniq buffer<u8>, carry: own u64) -> result: own TrailingChunk reads(input), writes(input) {
  let input_room = len(deref(input));
  let carry_ok = carry < input_room;
  if carry_ok {
  } else {
    let rejected = TrailingChunk(available: carry, status: 6_u8);
    return move rejected;
  }
  set deref(input)[carry] = 10_u8;
  let available = carry +wrap 1_u64;
  let accepted = TrailingChunk(available: available, status: 0_u8);
  return move accepted;
}

fn scan_line(input: &buffer<u8>, available: own u64, scan: own u64, pattern: &buffer<u8>, pattern_length: own u64, first_pattern_byte: own u8, empty_pattern: own Bool) -> result: own LineScan reads(input, pattern) {
  let input_room = len(deref(input));
  let available_fits = available <= input_room;
  if available_fits {
  } else {
    let missed = False();
    let rejected = LineScan(terminator: available, hit: missed, status: 6_u8);
    return move rejected;
  }
  let scan_fits = scan <= available;
  if scan_fits {
  } else {
    let missed = False();
    let rejected = LineScan(terminator: available, hit: missed, status: 6_u8);
    return move rejected;
  }
  let pattern_room = len(deref(pattern));
  let terminator = available;
  let hit = empty_pattern;
  for @walk_line (probe in scan..available) {
    let byte = deref(input)[probe];
    let newline = byte == 10_u8;
    if newline {
      set terminator = probe;
      break @walk_line;
    }
    if hit {
    } else {
      let lead = byte == first_pattern_byte;
      if lead {
        let same = True();
        let ahead = 1_u64;
        loop @verify_line {
          let proven = ahead >= pattern_length;
          if proven {
            break @verify_line;
          }
          let spot = probe +wrap ahead;
          let inside = spot < available;
          if inside {
          } else {
            set same = False();
            break @verify_line;
          }
          let candidate = deref(input)[spot];
          let stopper = candidate == 10_u8;
          if stopper {
            set same = False();
            break @verify_line;
          }
          let ahead_ok = ahead < pattern_room;
          if ahead_ok {
          } else {
            set same = False();
            break @verify_line;
          }
          let expected = deref(pattern)[ahead];
          let equal = candidate == expected;
          if equal {
          } else {
            set same = False();
            break @verify_line;
          }
          set ahead = ahead +wrap 1_u64;
        }
        if same {
          set hit = True();
        }
      }
    }
  }
  let accepted = LineScan(terminator: terminator, hit: hit, status: 0_u8);
  return move accepted;
}

fn shift_input_tail(input: &uniq buffer<u8>, available: own u64, scan: own u64) -> result: own ShiftedTail reads(input), writes(input) {
  let input_room = len(deref(input));
  let available_fits = available <= input_room;
  if available_fits {
  } else {
    let rejected = ShiftedTail(tail: 0_u64, status: 6_u8);
    return move rejected;
  }
  let scan_fits = scan <= available;
  if scan_fits {
  } else {
    let rejected = ShiftedTail(tail: 0_u64, status: 6_u8);
    return move rejected;
  }
  let moved = 0_u64;
  for (
    source_index in scan..available,
    invariant destination_precedes_source: moved <= source_index
  ) {
    let byte = deref(input)[source_index];
    set deref(input)[moved] = byte;
    set moved = moved + 1_u64;
  }
  let accepted = ShiftedTail(tail: moved, status: 0_u8);
  return move accepted;
}

fn search_file(file: &ReadFile, pattern: &buffer<u8>, pattern_length: own u64, path: &buffer<u8>, path_length: own u64, out: &uniq Output) -> result: own u8 reads(file, pattern, path, out), writes(out), allocates(heap) {
  doc "Reads one open file and publishes `PATH:LINE:TEXT` for every line that holds the literal pattern bytes.";
  let input = buffer_new(4096_u64, 0_u8);
  let batch = buffer_new(8192_u64, 0_u8);
  let batch_room = len(batch);
  let pattern_room = len(deref(pattern));
  let first_pattern_byte = 0_u8;
  let has_pattern = pattern_room > 0_u64;
  if has_pattern {
    set first_pattern_byte = deref(pattern)[0_u64];
  }
  let empty_pattern = pattern_length == 0_u64;
  let matched = 0_u8;
  let status = 0_u8;
  let filled = 0_u64;
  let line_number = 0_u64;
  let carry = 0_u64;
  let file_offset = 0_u64;
  loop @chunks {
    let carry_within_input = carry <= 4096_u64;
    if carry_within_input {
    } else {
      set status = 6_u8;
      break @chunks;
    }
    let room = 4096_u64 -wrap carry;
    let overlong = room == 0_u64;
    if overlong {
      set status = 6_u8;
      break @chunks;
    }
    let available = 0_u64;
    let ended = 0_u8;
    region {
      match read_at(file: &deref(file), destination: &uniq input, file_offset: file_offset, start: carry, end: 4096_u64) {
        ReadBytes(next: endpoint) => {
          let received = endpoint -wrap carry;
          set file_offset = file_offset +wrap received;
          set available = endpoint;
        }
        ReadEnd() => {
          set ended = 1_u8;
        }
        ReadFailed(error: problem) => {
          set status = io_class(error: move problem);
          set ended = 2_u8;
        }
      }
    }
    if ended == 2_u8 {
      break @chunks;
    }
    if ended == 1_u8 {
      let trailing = carry > 0_u64;
      if trailing {
        let trailing_available = carry;
        let trailing_status = 0_u8;
        region {
          let result = append_trailing_newline(input: &uniq input, carry: carry);
          set trailing_available = result.available;
          set trailing_status = result.status;
        }
        if trailing_status == 0_u8 {
          set available = trailing_available;
        } else {
          set status = trailing_status;
          break @chunks;
        }
      }
    }
    let scan = 0_u64;
    loop @lines {
      let terminator = available;
      let hit = empty_pattern;
      let line_status = 0_u8;
      region {
        let result = scan_line(input: &input, available: available, scan: scan, pattern: pattern, pattern_length: pattern_length, first_pattern_byte: first_pattern_byte, empty_pattern: empty_pattern);
        set terminator = result.terminator;
        set hit = result.hit;
        set line_status = result.status;
      }
      if line_status == 0_u8 {
      } else {
        set status = line_status;
        break @chunks;
      }
      let complete = terminator < available;
      if complete {
      } else {
        break @lines;
      }
      set line_number = line_number +wrap 1_u64;
      if hit {
        set matched = 1_u8;
        let stop = terminator +wrap 1_u64;
        let span = stop -wrap scan;
        let head = path_length +wrap 24_u64;
        let record = head +wrap span;
        let need = filled +wrap record;
        let overfull = need > 8192_u64;
        if overfull {
          let batch_fits = filled <= batch_room;
          if batch_fits {
            region {
              match publish_all(output: &uniq deref(out), source: &batch, length: filled) {
                Ok(value: published) => {
                }
                Err(error: problem) => {
                  set status = io_class(error: move problem);
                }
              }
            }
          } else {
            set status = 6_u8;
          }
          set filled = 0_u64;
        }
        if status == 0_u8 {
          region {
            set filled = copy_range(destination: &uniq batch, at: filled, source: &deref(path), from: 0_u64, to: path_length);
          }
          let colon_room = filled < batch_room;
          if colon_room {
            set batch[filled] = 58_u8;
            set filled = filled +wrap 1_u64;
          }
          region {
            set filled = put_decimal(destination: &uniq batch, at: filled, value: line_number);
          }
          let second_room = filled < batch_room;
          if second_room {
            set batch[filled] = 58_u8;
            set filled = filled +wrap 1_u64;
          }
          region {
            set filled = copy_range(destination: &uniq batch, at: filled, source: &input, from: scan, to: stop);
          }
        } else {
          break @lines;
        }
      }
      set scan = terminator +wrap 1_u64;
    }
    if status == 0_u8 {
    } else {
      break @chunks;
    }
    if ended == 1_u8 {
      break @chunks;
    }
    let tail = 0_u64;
    let shift_status = 0_u8;
    region {
      let result = shift_input_tail(input: &uniq input, available: available, scan: scan);
      set tail = result.tail;
      set shift_status = result.status;
    }
    if shift_status == 0_u8 {
      set carry = tail;
    } else {
      set status = shift_status;
      break @chunks;
    }
  }
  let pending = filled > 0_u64;
  if pending {
    let final_fits = filled <= batch_room;
    if final_fits {
      region {
        match publish_all(output: &uniq deref(out), source: &batch, length: filled) {
          Ok(value: published) => {
          }
          Err(error: problem) => {
            set status = io_class(error: move problem);
          }
        }
      }
    } else {
      set status = 6_u8;
    }
  }
  let flag = if matched == 1_u8 {
    give 16_u8;
  } else {
    give 0_u8;
  }
  let packed = ior(status, flag);
  return packed;
}

fn open_source_from_factory(factory: &uniq FileFactory, directory: &DirectoryRead) -> result: own Result<DirectorySource, IoError> reads(factory, directory), writes(factory) {
  let permit = reserve_file(factory: move factory);
  return open_directory_source(permit: move permit, directory: directory);
}

fn open_file_from_factory(factory: &uniq FileFactory, root: &DirectoryRead, name: &buffer<u8>, start: own u64, end: own u64) -> result: own Result<ReadFile, IoError> reads(factory, root, name), writes(factory) contract {
  define ordered = start <= end;
  define capacity = len(deref(name));
  define within = end <= capacity;
  requires ordered;
  requires within;
} {
  let permit = reserve_file(factory: move factory);
  return open_file(permit: move permit, root: root, name: name, start: start, end: end);
}

fn open_directory_from_factory(factory: &uniq FileFactory, root: &DirectoryRead, name: &buffer<u8>, start: own u64, end: own u64) -> result: own Result<DirectoryRead, IoError> reads(factory, root, name), writes(factory) contract {
  define ordered = start <= end;
  define capacity = len(deref(name));
  define within = end <= capacity;
  requires ordered;
  requires within;
} {
  let permit = reserve_file(factory: move factory);
  return open_directory(permit: move permit, root: root, name: name, start: start, end: end);
}

fn walk(factory: &uniq FileFactory, dir: &DirectoryRead, prefix: &buffer<u8>, prefix_length: own u64, pattern: &buffer<u8>, pattern_length: own u64, out: &uniq Output, err: &uniq Output) -> result: own u8 reads(factory, dir, prefix, pattern, out, err), writes(factory, out, err), allocates(heap) {
  doc "Enumerates one directory in sorted order, searches the regular files it names, and descends into the subdirectories it names. The descent carries no source-level depth cap; stack availability remains outside this version's portable result model. Two program bounds remain and both are recorded as defects. One truncates silently: at most 64 entries per directory are retained, in the host's enumeration order, before sorting, and the walk returns normally, so that truncation is indistinguishable from a complete one. The other stops the descent: a display path past a thousand bytes refuses, which on a tree of one-byte directory names binds at roughly five hundred levels, and it reports by exit status alone with nothing on standard error.";
  let matched = 0_u8;
  let failed = 0_u8;
  let entries = buffer_new(8192_u64, 0_u8);
  let names = buffer_new(65664_u64, 0_u8);
  let order = buffer_new(64_u64, 0_u64);
  let child = buffer_new(1024_u64, 0_u8);
  let report = buffer_new(1280_u64, 0_u8);
  let entries_room = len(entries);
  let names_room = len(names);
  let order_room = len(order);
  let child_room = len(child);
  let prefix_room = len(deref(prefix));
  let stored = 0_u64;
  region {
    match open_source_from_factory(factory: &uniq deref(factory), directory: &deref(dir)) {
      Ok(value: list) => {
        loop @batches {
          let produced = 0_u64;
          let ended = 0_u8;
          region {
            match directory_next(source: &uniq list, destination: &uniq entries, start: 0_u64, end: 8192_u64) {
              ListBytes(next: endpoint, entries: reported) => {
                set produced = endpoint;
              }
              ListEnd() => {
                set ended = 1_u8;
              }
              ListFailed(error: problem) => {
                set ended = 2_u8;
                set failed = 1_u8;
              }
            }
          }
          if ended == 0_u8 {
          } else {
            break @batches;
          }
          let empty_batch = produced == 0_u64;
          if empty_batch {
            break @batches;
          }
          let at = 0_u64;
          loop @entry {
            let header_end = at +wrap 3_u64;
            let complete = header_end <= produced;
            if complete {
            } else {
              break @entry;
            }
            let kind_readable = at < entries_room;
            if kind_readable {
            } else {
              break @entry;
            }
            let kind = entries[at];
            let length_low_at = at +wrap 1_u64;
            let length_low_readable = length_low_at < entries_room;
            if length_low_readable {
            } else {
              break @entry;
            }
            let length_high_at = at +wrap 2_u64;
            let length_high_readable = length_high_at < entries_room;
            if length_high_readable {
            } else {
              break @entry;
            }
            let name_length_low = entries[length_low_at];
            let name_length_high = entries[length_high_at];
            let name_count_low = cvt::<u8, u64>(name_length_low);
            let name_count_high = cvt::<u8, u64>(name_length_high);
            let name_count_high_shifted = ishl.wrap(name_count_high, 8_u32);
            let name_count = ior(name_count_low, name_count_high_shifted);
            let name_at = at +wrap 3_u64;
            let name_end = name_at +wrap name_count;
            let bounded = name_end <= produced;
            if bounded {
            } else {
              break @entry;
            }
            let ordered = name_at <= name_end;
            if ordered {
            } else {
              break @entry;
            }
            let addressable = name_end <= entries_room;
            if addressable {
            } else {
              break @entry;
            }
            set at = name_end;
            let dotted = 0_u8;
            let single = name_count == 1_u64;
            if single {
              let first_readable = name_at < entries_room;
              if first_readable {
                let first = entries[name_at];
                if first == 46_u8 {
                  set dotted = 1_u8;
                }
              }
            }
            let paired = name_count == 2_u64;
            if paired {
              let second_at = name_at +wrap 1_u64;
              let first_readable = name_at < entries_room;
              let second_readable = second_at < entries_room;
              if first_readable {
                if second_readable {
                  let first = entries[name_at];
                  let second = entries[second_at];
                  if first == 46_u8 {
                    if second == 46_u8 {
                      set dotted = 1_u8;
                    }
                  }
                }
              }
            }
            let not_dotted = dotted == 0_u8;
            let component_fits = name_count <= 1023_u64;
            let usable = band(not_dotted, component_fits);
            let room_left = stored < 64_u64;
            if usable {
              if room_left {
                let base = stored *wrap 1026_u64;
                let kind_writable = base < names_room;
                if kind_writable {
                  set names[base] = kind;
                }
                let stored_length_low_at = base +wrap 1_u64;
                let length_low_writable = stored_length_low_at < names_room;
                if length_low_writable {
                  set names[stored_length_low_at] = name_length_low;
                }
                let stored_length_high_at = base +wrap 2_u64;
                let length_high_writable = stored_length_high_at < names_room;
                if length_high_writable {
                  set names[stored_length_high_at] = name_length_high;
                }
                let target_start = base +wrap 3_u64;
                let taken = 0_u64;
                loop @store_name {
                  let done = taken >= name_count;
                  if done {
                    break @store_name;
                  }
                  let source_at = name_at +wrap taken;
                  let readable = source_at < entries_room;
                  if readable {
                  } else {
                    break @store_name;
                  }
                  let target_at = target_start +wrap taken;
                  let writable = target_at < names_room;
                  if writable {
                  } else {
                    break @store_name;
                  }
                  let byte = entries[source_at];
                  set names[target_at] = byte;
                  set taken = taken +wrap 1_u64;
                }
                set stored = stored +wrap 1_u64;
              }
            }
          }
        }
      }
      Err(error: problem) => {
        set failed = 1_u8;
      }
    }
  }
  let seed = 0_u64;
  loop @seed_order {
    let done = seed >= stored;
    if done {
      break @seed_order;
    }
    let writable = seed < order_room;
    if writable {
    } else {
      break @seed_order;
    }
    set order[seed] = seed;
    set seed = seed +wrap 1_u64;
  }
  let selected = 0_u64;
  loop @sort {
    let done = selected >= stored;
    if done {
      break @sort;
    }
    let selected_readable = selected < order_room;
    if selected_readable {
    } else {
      break @sort;
    }
    let best = selected;
    let probe = selected +wrap 1_u64;
    loop @scan {
      let scanned = probe >= stored;
      if scanned {
        break @scan;
      }
      let probe_readable = probe < order_room;
      if probe_readable {
      } else {
        break @scan;
      }
      let best_readable = best < order_room;
      if best_readable {
      } else {
        break @scan;
      }
      let candidate = order[probe];
      let incumbent = order[best];
      let earlier = 0_u8;
      region {
        let closer = name_before(names: &names, left: candidate, right: incumbent);
        if closer {
          set earlier = 1_u8;
        }
      }
      if earlier == 1_u8 {
        set best = probe;
      }
      set probe = probe +wrap 1_u64;
    }
    let best_readable = best < order_room;
    if best_readable {
      let held = order[selected];
      let winner = order[best];
      set order[best] = held;
      set order[selected] = winner;
    }
    set selected = selected +wrap 1_u64;
  }
  let visited = 0_u64;
  loop @process {
    let done = visited >= stored;
    if done {
      break @process;
    }
    let readable = visited < order_room;
    if readable {
    } else {
      break @process;
    }
    let index = order[visited];
    set visited = visited +wrap 1_u64;
    let base = index *wrap 1026_u64;
    let kind_readable = base < names_room;
    if kind_readable {
    } else {
      break @process;
    }
    let kind = names[base];
    let stored_length_low_at = base +wrap 1_u64;
    let length_low_readable = stored_length_low_at < names_room;
    if length_low_readable {
    } else {
      break @process;
    }
    let stored_length_high_at = base +wrap 2_u64;
    let length_high_readable = stored_length_high_at < names_room;
    if length_high_readable {
    } else {
      break @process;
    }
    let stored_length_low = names[stored_length_low_at];
    let stored_length_high = names[stored_length_high_at];
    let name_count_low = cvt::<u8, u64>(stored_length_low);
    let name_count_high = cvt::<u8, u64>(stored_length_high);
    let name_count_high_shifted = ishl.wrap(name_count_high, 8_u32);
    let name_count = ior(name_count_low, name_count_high_shifted);
    let name_at = base +wrap 3_u64;
    let name_end = name_at +wrap name_count;
    let name_bounded = name_end <= names_room;
    if name_bounded {
    } else {
      set failed = 1_u8;
      break @process;
    }
    let name_ordered = name_at <= name_end;
    if name_ordered {
    } else {
      set failed = 1_u8;
      break @process;
    }
    let separated = prefix_length > 0_u64;
    let separated_length = prefix_length +wrap 1_u64;
    let child_length = if separated {
      give separated_length +wrap name_count;
    } else {
      give name_count;
    }
    let fits = child_length <= 1000_u64;
    if fits {
    } else {
      set failed = 1_u8;
      break @process;
    }
    let cursor = 0_u64;
    loop @prefix_copy {
      let copied = cursor >= prefix_length;
      if copied {
        break @prefix_copy;
      }
      let prefix_readable = cursor < prefix_room;
      if prefix_readable {
      } else {
        break @prefix_copy;
      }
      let writable = cursor < child_room;
      if writable {
      } else {
        break @prefix_copy;
      }
      let byte = deref(prefix)[cursor];
      set child[cursor] = byte;
      set cursor = cursor +wrap 1_u64;
    }
    if separated {
      let separator_fits = cursor < child_room;
      if separator_fits {
        set child[cursor] = 47_u8;
        set cursor = cursor +wrap 1_u64;
      }
    }
    let taken = 0_u64;
    loop @name_copy {
      let copied = taken >= name_count;
      if copied {
        break @name_copy;
      }
      let source_at = name_at +wrap taken;
      let source_readable = source_at < names_room;
      if source_readable {
      } else {
        break @name_copy;
      }
      let writable = cursor < child_room;
      if writable {
      } else {
        break @name_copy;
      }
      let byte = names[source_at];
      set child[cursor] = byte;
      set cursor = cursor +wrap 1_u64;
      set taken = taken +wrap 1_u64;
    }
    let regular = kind == 1_u8;
    if regular {
      let status = 0_u8;
      region {
        match open_file_from_factory(factory: &uniq deref(factory), root: &deref(dir), name: &names, start: name_at, end: name_end) {
          Ok(value: file) => {
            let outcome = 0_u8;
            region {
              set outcome = search_file(file: &file, pattern: pattern, pattern_length: pattern_length, path: &child, path_length: cursor, out: &uniq deref(out));
            }
            set status = iand(outcome, 15_u8);
            let found = iand(outcome, 16_u8);
            if found == 16_u8 {
              set matched = 1_u8;
            }
          }
          Err(error: problem) => {
            set status = io_class(error: move problem);
          }
        }
      }
      let reportable = status != 0_u8;
      if reportable {
        set failed = 1_u8;
        region {
          report_failure(err: &uniq deref(err), report: &uniq report, path: &child, path_length: cursor, status: status);
        }
      }
    }
    let descending = kind == 2_u8;
    if descending {
      let status = 0_u8;
      region {
        match open_directory_from_factory(factory: &uniq deref(factory), root: &deref(dir), name: &names, start: name_at, end: name_end) {
          Ok(value: opened) => {
            let outcome = 0_u8;
            region {
              set outcome = walk(factory: &uniq deref(factory), dir: &opened, prefix: &child, prefix_length: cursor, pattern: pattern, pattern_length: pattern_length, out: &uniq deref(out), err: &uniq deref(err));
            }
            let found = iand(outcome, 1_u8);
            let broke = iand(outcome, 2_u8);
            if found == 1_u8 {
              set matched = 1_u8;
            }
            if broke == 2_u8 {
              set failed = 1_u8;
            }
          }
          Err(error: problem) => {
            set status = io_class(error: move problem);
          }
        }
      }
      let reportable = status != 0_u8;
      if reportable {
        set failed = 1_u8;
        region {
          report_failure(err: &uniq deref(err), report: &uniq report, path: &child, path_length: cursor, status: status);
        }
      }
    }
  }
  let matched_bit = if matched == 1_u8 {
    give 1_u8;
  } else {
    give 0_u8;
  }
  let failed_bit = if failed == 1_u8 {
    give 2_u8;
  } else {
    give 0_u8;
  }
  let packed = ior(matched_bit, failed_bit);
  return packed;
}

command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.stderr as err: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, out, err, files), writes(cwd, out, err, files), allocates(heap) {
  doc "Searches one directory tree recursively and publishes `PATH:LINE:TEXT` for the lines holding the literal pattern bytes; 0 matched, 1 none, 2 error. The search is complete only within `walk`'s two remaining fixed bounds: 64 entries per directory, beyond which it truncates and still returns normally, and a thousand-byte display path, beyond which the descent stops and the run exits 2 with nothing on standard error.";
  let pattern = buffer_new(4096_u64, 0_u8);
  let root_name = buffer_new(256_u64, 0_u8);
  let root_path = buffer_new(1024_u64, 0_u8);
  let report = buffer_new(1280_u64, 0_u8);
  let arguments = 0_u64;
  region {
    set arguments = args_count(args: &args);
  }
  let startup = 0_u8;
  let pattern_length = 0_u64;
  let root_length = 0_u64;
  let usable = arguments >= 3_u64;
  if usable {
    region {
      match arg_get(args: &args, position: 1_u64) {
        Ok(value: text) => {
          region {
            match host_copy_bytes(value: &text, destination: &uniq pattern, start: 0_u64, end: 4096_u64) {
              Ok(value: copied) => {
                set pattern_length = copied;
              }
              Err(error: too_small) => {
                set startup = 2_u8;
              }
            }
          }
        }
        Err(error: absent) => {
          set startup = 1_u8;
        }
      }
    }
    region {
      match arg_get(args: &args, position: 2_u64) {
        Ok(value: text) => {
          region {
            match host_copy_bytes(value: &text, destination: &uniq root_name, start: 0_u64, end: 256_u64) {
              Ok(value: copied) => {
                set root_length = copied;
              }
              Err(error: too_small) => {
                set startup = 3_u8;
              }
            }
          }
        }
        Err(error: absent) => {
          set startup = 1_u8;
        }
      }
    }
  } else {
    set startup = 1_u8;
  }
  if startup == 0_u8 {
  } else {
    let length = 0_u64;
    if startup == 1_u8 {
      region {
        let view = slice_of(&usage_text);
        set length = append_slice(destination: &uniq report, filled: length, text: move view);
      }
    }
    if startup == 2_u8 {
      region {
        let view = slice_of(&reason_pattern_too_long);
        set length = append_slice(destination: &uniq report, filled: length, text: move view);
      }
    }
    if startup == 3_u8 {
      region {
        let view = slice_of(&reason_root_too_long);
        set length = append_slice(destination: &uniq report, filled: length, text: move view);
      }
    }
    region {
      match publish_all(output: &uniq err, source: &report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
    return exit_status(code: 2_u8);
  }
  let root_name_room = len(root_name);
  let root_length_fits = root_length <= root_name_room;
  if root_length_fits {
  } else {
    let length = 0_u64;
    region {
      let view = slice_of(&reason_root_too_long);
      set length = append_slice(destination: &uniq report, filled: length, text: move view);
    }
    region {
      match publish_all(output: &uniq err, source: &report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
    return exit_status(code: 2_u8);
  }
  let root_room = len(root_path);
  let copied = 0_u64;
  loop @root_copy_out {
    let done = copied >= root_length;
    if done {
      break @root_copy_out;
    }
    let readable = copied < 256_u64;
    if readable {
    } else {
      break @root_copy_out;
    }
    let writable = copied < root_room;
    if writable {
    } else {
      break @root_copy_out;
    }
    let byte = root_name[copied];
    set root_path[copied] = byte;
    set copied = copied +wrap 1_u64;
  }
  let matched = 0_u8;
  let failed = 0_u8;
  let root_status = 0_u8;
  region {
    let root_permit = reserve_file(factory: &uniq files);
    match open_directory(permit: move root_permit, root: &cwd, name: &root_name, start: 0_u64, end: root_length) {
      Ok(value: root) => {
        let outcome = 0_u8;
        region {
          set outcome = walk(factory: &uniq files, dir: &root, prefix: &root_path, prefix_length: copied, pattern: &pattern, pattern_length: pattern_length, out: &uniq out, err: &uniq err);
        }
        let found = iand(outcome, 1_u8);
        let broke = iand(outcome, 2_u8);
        if found == 1_u8 {
          set matched = 1_u8;
        }
        if broke == 2_u8 {
          set failed = 1_u8;
        }
      }
      Err(error: problem) => {
        set root_status = io_class(error: move problem);
      }
    }
  }
  let directory_refused = root_status != 0_u8;
  if directory_refused {
    let single = 0_u8;
    region {
      match arg_get(args: &args, position: 2_u64) {
        Ok(value: text) => {
          match relative_path(value: move text) {
            Ok(value: path) => {
              region {
                let fallback_permit = reserve_file(factory: &uniq files);
                match open_read(permit: move fallback_permit, root: &cwd, path: &path) {
                  Ok(value: file) => {
                    set single = 1_u8;
                    let outcome = 0_u8;
                    region {
                      set outcome = search_file(file: &file, pattern: &pattern, pattern_length: pattern_length, path: &root_path, path_length: copied, out: &uniq out);
                    }
                    set root_status = iand(outcome, 15_u8);
                    let found = iand(outcome, 16_u8);
                    if found == 16_u8 {
                      set matched = 1_u8;
                    }
                  }
                  Err(error: refused) => {
                  }
                }
              }
            }
            Err(error: rejected) => {
              set root_status = 5_u8;
            }
          }
        }
        Err(error: absent) => {
        }
      }
    }
  }
  let reportable = root_status != 0_u8;
  if reportable {
    set failed = 1_u8;
    region {
      report_failure(err: &uniq err, report: &uniq report, path: &root_path, path_length: copied, status: root_status);
    }
  }
  if failed == 0_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  if matched == 0_u8 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
