}

command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.stderr as err: own Output) -> status: own ExitStatus allocates(heap), external, blocks, traps {
  doc "Searches one directory tree recursively and publishes `PATH:LINE:TEXT` for the lines holding the literal pattern bytes; 0 matched, 1 none, 2 error. The search is complete only within `walk`'s two remaining fixed bounds: 64 entries per directory, beyond which it truncates and still returns normally, and a thousand-byte display path, beyond which the descent stops and the run exits 2 with nothing on standard error.";
  let pattern = buffer_new(4096_u64, 0_u8);
  let root_name = buffer_new(256_u64, 0_u8);
  let root_path = buffer_new(1024_u64, 0_u8);
  let report = buffer_new(1280_u64, 0_u8);
  let arguments = 0_u64;
  region 'invocation {
    set arguments = args_count<'invocation>(args: &'invocation args);
  }
  let startup = 0_u8;
  let pattern_length = 0_u64;
  let root_length = 0_u64;
  let usable = ige(arguments, 3_u64);
  if usable {
    region 'pattern_lease {
      match arg_get<'pattern_lease>(args: &'pattern_lease args, position: 1_u64) {
        Ok(value: text) => {
          region 'pattern_copy {
            match host_copy_bytes<'pattern_copy, 'pattern_copy>(value: &'pattern_copy text, destination: &uniq 'pattern_copy pattern, start: 0_u64, end: 4096_u64) {
              Ok(value: copied) => {
                set pattern_length = copied;
              }
              Err(error: too_small) => {
                set startup = 2_u8;
              }
            }
          }
        }
        Err(error: absent) => {
          set startup = 1_u8;
        }
      }
    }
    region 'root_lease {
      match arg_get<'root_lease>(args: &'root_lease args, position: 2_u64) {
        Ok(value: text) => {
          region 'root_copy {
            match host_copy_bytes<'root_copy, 'root_copy>(value: &'root_copy text, destination: &uniq 'root_copy root_name, start: 0_u64, end: 256_u64) {
              Ok(value: copied) => {
                set root_length = copied;
              }
              Err(error: too_small) => {
                set startup = 3_u8;
              }
            }
          }
        }
        Err(error: absent) => {
          set startup = 1_u8;
        }
      }
    }
  } else {
    set startup = 1_u8;
  }
  if ieq(startup, 0_u8) {
  } else {
    let length = 0_u64;
    if ieq(startup, 1_u8) {
      region 'startup_usage {
        let view = slice_of(&'startup_usage usage_text);
        set length = append_slice<'startup_usage, 'startup_usage>(destination: &uniq 'startup_usage report, filled: length, text: move view);
      }
    }
    if ieq(startup, 2_u8) {
      region 'startup_pattern {
        let view = slice_of(&'startup_pattern reason_pattern_too_long);
        set length = append_slice<'startup_pattern, 'startup_pattern>(destination: &uniq 'startup_pattern report, filled: length, text: move view);
      }
    }
    if ieq(startup, 3_u8) {
      region 'startup_root {
        let view = slice_of(&'startup_root reason_root_too_long);
        set length = append_slice<'startup_root, 'startup_root>(destination: &uniq 'startup_root report, filled: length, text: move view);
      }
    }
    region 'startup_write {
      match publish_all<'startup_write, 'startup_write>(output: &uniq 'startup_write err, source: &'startup_write report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
    return exit_status(code: 2_u8);
  }
  let root_name_room = len(root_name);
  let root_length_fits = ile(root_length, root_name_room);
  if root_length_fits {
  } else {
    let length = 0_u64;
    region 'root_length_view {
      let view = slice_of(&'root_length_view reason_root_too_long);
      set length = append_slice<'root_length_view, 'root_length_view>(destination: &uniq 'root_length_view report, filled: length, text: move view);
    }
    region 'root_length_write {
      match publish_all<'root_length_write, 'root_length_write>(output: &uniq 'root_length_write err, source: &'root_length_write report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
    return exit_status(code: 2_u8);
  }
  let root_room = len(root_path);
  let copied = 0_u64;
  loop @root_copy_out {
    let done = ige(copied, root_length);
    if done {
      break @root_copy_out;
    }
    let readable = ilt(copied, 256_u64);
    if readable {
    } else {
      break @root_copy_out;
    }
    let writable = ilt(copied, root_room);
    if writable {
    } else {
      break @root_copy_out;
    }
    let byte = root_name[copied];
    set root_path[copied] = byte;
    set copied = copied +wrap 1_u64;
  }
  let matched = 0_u8;
  let failed = 0_u8;
  let root_status = 0_u8;
  region 'root_open {
    match open_directory<'root_open, 'root_open>(root: &'root_open cwd, name: &'root_open root_name, start: 0_u64, end: root_length) {
      Ok(value: root) => {
        let outcome = 0_u8;
        region 'root_walk {
          set outcome = walk<'root_walk, 'root_walk, 'root_walk, 'root_walk, 'root_walk>(dir: &'root_walk root, prefix: &'root_walk root_path, prefix_length: copied, pattern: &'root_walk pattern, pattern_length: pattern_length, out: &uniq 'root_walk out, err: &uniq 'root_walk err);
        }
        let found = iand(outcome, 1_u8);
        let broke = iand(outcome, 2_u8);
        if ieq(found, 1_u8) {
          set matched = 1_u8;
        }
        if ieq(broke, 2_u8) {
          set failed = 1_u8;
        }
      }
      Err(error: problem) => {
        set root_status = io_class(error: move problem);
      }
    }
  }
  let directory_refused = ine(root_status, 0_u8);
  if directory_refused {
    let single = 0_u8;
    region 'file_lease {
      match arg_get<'file_lease>(args: &'file_lease args, position: 2_u64) {
        Ok(value: text) => {
          match relative_path(value: move text) {
            Ok(value: path) => {
              region 'open_call {
                match open_read<'open_call, 'open_call>(root: &'open_call cwd, path: &'open_call path) {
                  Ok(value: file) => {
                    set single = 1_u8;
                    let outcome = 0_u8;
                    region 'search_call {
                      set outcome = search_file<'search_call, 'search_call, 'search_call, 'search_call>(file: &uniq 'search_call file, pattern: &'search_call pattern, pattern_length: pattern_length, path: &'search_call root_path, path_length: copied, out: &uniq 'search_call out);
                    }
                    set root_status = iand(outcome, 15_u8);
                    let found = iand(outcome, 16_u8);
                    if ieq(found, 16_u8) {
                      set matched = 1_u8;
                    }
                  }
                  Err(error: refused) => {
                  }
                }
              }
            }
            Err(error: rejected) => {
              set root_status = 5_u8;
            }
          }
        }
        Err(error: absent) => {
        }
      }
    }
  }
  let reportable = ine(root_status, 0_u8);
  if reportable {
    set failed = 1_u8;
    region 'root_report {
      report_failure<'root_report, 'root_report, 'root_report>(err: &uniq 'root_report err, report: &uniq 'root_report report, path: &'root_report root_path, path_length: copied, status: root_status);
    }
  }
  if ieq(failed, 0_u8) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(matched, 0_u8) {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
