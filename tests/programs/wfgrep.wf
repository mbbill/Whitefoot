        if empty_batch {
          break @batches;
        }
        let at = 0_u64;
        loop @entry {
          let header_end = at +wrap 3_u64;
          let complete = ile(header_end, produced);
          if complete {
          } else {
            break @entry;
          }
          let kind_readable = ilt(at, entries_room);
          if kind_readable {
          } else {
            break @entry;
          }
