  let pattern_room = len(deref(pattern));
  let first_pattern_byte = 0_u8;
  let has_pattern = igt(pattern_room, 0_u64);
  if has_pattern {
    set first_pattern_byte = deref(pattern)[0_u64];
  }
  let empty_pattern = ieq(pattern_length, 0_u64);
  let matched = 0_u8;
  let status = 0_u8;
  let filled = 0_u64;
  let line_number = 0_u64;
  let carry = 0_u64;
  loop @chunks {
    let carry_within_input = ile(carry, 4096_u64);
    if carry_within_input {
    } else {
      set status = 6_u8;
      break @chunks;
    }
    let room = 4096_u64 -wrap carry;
    let overlong = ieq(room, 0_u64);
