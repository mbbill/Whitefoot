const digit_glyphs: Array<u8, 10> =[48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8];

const usage_text: Array<u8, 27> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 32_u8, 80_u8, 65_u8, 84_u8, 84_u8, 69_u8, 82_u8, 78_u8, 32_u8, 82_u8, 79_u8, 79_u8, 84_u8, 10_u8];

const error_prefix: Array<u8, 8> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8];

const error_separator: Array<u8, 2> =[58_u8, 32_u8];

const reason_missing: Array<u8, 26> =[110_u8, 111_u8, 32_u8, 115_u8, 117_u8, 99_u8, 104_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 111_u8, 114_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_denied: Array<u8, 18> =[112_u8, 101_u8, 114_u8, 109_u8, 105_u8, 115_u8, 115_u8, 105_u8, 111_u8, 110_u8, 32_u8, 100_u8, 101_u8, 110_u8, 105_u8, 101_u8, 100_u8, 10_u8];

const reason_directory: Array<u8, 15> =[105_u8, 115_u8, 32_u8, 97_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_invalid_path: Array<u8, 22> =[105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 114_u8, 101_u8, 108_u8, 97_u8, 116_u8, 105_u8, 118_u8, 101_u8, 32_u8, 112_u8, 97_u8, 116_u8, 104_u8, 10_u8];

const reason_long_line: Array<u8, 14> =[108_u8, 105_u8, 110_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

const reason_unreadable: Array<u8, 12> =[99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 10_u8];

const reason_pattern_too_long: Array<u8, 25> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 112_u8, 97_u8, 116_u8, 116_u8, 101_u8, 114_u8, 110_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

const reason_root_too_long: Array<u8, 29> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 115_u8, 101_u8, 97_u8, 114_u8, 99_u8, 104_u8, 32_u8, 114_u8, 111_u8, 111_u8, 116_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

struct TrailingChunk {
  available: u64;
  status: u8;
}

struct LineScan {
  terminator: u64;
  hit: Bool;
  status: u8;
}

struct ShiftedTail {
  tail: u64;
  status: u8;
}

fn io_class(error: own IoError) -> result: own u8 pure {
  doc "Reduces one portable IoError class to the distinctions wfgrep reports.";
  match error {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 9_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 9_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 4_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn zeroed_bytes(count: own u64) -> made: own Box<Slots<u8>> pure contract {
  requires count <= 131072_u64;
  ensures made.inner.len >= count;
} {
  doc "Takes one boxed runtime-capacity window of count byte slots and fills every slot with zero. There is one heap and allocation is total, so the construction has no refusal arm [STOR-8, TYPE-9]. The fill lives here rather than at each acquisition so its two invariants are proved once instead of once per scratch window of every caller, and the opened length reaches each caller off the signature [FN-9, CALL-4].";
  let built = box_slots_new::<u8>(capacity: count);
  for @fill (
    at in 0_u64..count,
    invariant grown: built.inner.len == at
  ) {
    place_back(window: &built.inner, value: 0_u8);
  }
  return move built;
}

fn zeroed_words(count: own u64) -> made: own Box<Slots<u64>> pure contract {
  requires count <= 1024_u64;
  ensures made.inner.len >= count;
} {
  doc "The same for word slots. A word window's byte extent is not its slot count, so the written bound is what discharges the allocation-size obligation [OP-9].";
  let built = box_slots_new::<u64>(capacity: count);
  for @fill (
    at in 0_u64..count,
    invariant grown: built.inner.len == at
  ) {
    place_back(window: &built.inner, value: 0_u64);
  }
  return move built;
}

fn append_slice(destination: &[u8], capacity: own u64, filled: own u64, text: &[u8]) -> result: own u64 reads(text), writes(destination) contract {
  requires capacity == deref(destination).len;
  requires filled <= capacity;
  ensures result <= capacity;
} {
  doc "Appends as much of one static message as the destination still holds. The destination's capacity is a written operand rather than a measure the row writes, so the published bound is a fact about a value this caller supplied [MSR-3].";
  let spare = deref(destination).len;
  let admitted = filled <= spare;
  let length = deref(text).len;
  if admitted {
    for @append (at in filled..spare) {
      let taken = at -wrap filled;
      let done = taken >= length;
      if done {
        return at;
      }
      let byte = deref(text)[taken];
      set deref(destination)[at] = byte;
    }
    return spare;
  } else {
    return filled;
  }
}

fn copy_range(destination: &[u8], at: own u64, source: &[u8], from: own u64, to: own u64) -> result: own u64 reads(source), writes(destination) {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = deref(source).len;
  let destination_room = deref(destination).len;
  let target = at;
  let cursor = from;
  loop @copy {
    let done = cursor >= to;
    if done {
      break @copy;
    }
    let read_ok = cursor < source_room;
    if read_ok {
    } else {
      return target;
    }
    let byte = deref(source)[cursor];
    let write_ok = target < destination_room;
    if write_ok {
    } else {
      return target;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  return target;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: own u64) -> result: own Result<unit, IoError> reads(source), writes(factory), writes(output) contract {
  define source_length = deref(source).len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it. A reference carries no permission marker, so the same range reference the caller writes through is what it reads from here [REF-1, EFF-1].";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    match write_once(factory: factory, output: output, source: source, start: sent, end: length) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn byte_at(store: &[u8], index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the range reference does not hold.";
  let spare = deref(store).len;
  let inside = index < spare;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn name_before(names: &[u8], left: own u64, right: own u64) -> result: own Bool reads(names) {
  doc "Orders two collected entry records by their stored name bytes, a shorter prefix first.";
  let left_base = left *wrap 1026_u64;
  let right_base = right *wrap 1026_u64;
  let left_length_low_at = left_base +wrap 1_u64;
  let right_length_low_at = right_base +wrap 1_u64;
  let left_length_low = byte_at(store: names, index: left_length_low_at);
  let right_length_low = byte_at(store: names, index: right_length_low_at);
  let left_length_high_at = left_base +wrap 2_u64;
  let right_length_high_at = right_base +wrap 2_u64;
  let left_length_high = byte_at(store: names, index: left_length_high_at);
  let right_length_high = byte_at(store: names, index: right_length_high_at);
  let left_count_low = cvt::<u8, u64>(left_length_low);
  let right_count_low = cvt::<u8, u64>(right_length_low);
  let left_count_high = cvt::<u8, u64>(left_length_high);
  let right_count_high = cvt::<u8, u64>(right_length_high);
  let left_count_high_shifted = ishl.wrap(left_count_high, 8_u32);
  let right_count_high_shifted = ishl.wrap(right_count_high, 8_u32);
  let left_count = ior(left_count_low, left_count_high_shifted);
  let right_count = ior(right_count_low, right_count_high_shifted);
  let shared = if left_count < right_count {
    give left_count;
  } else {
    give right_count;
  }
  let left_start = left_base +wrap 3_u64;
  let right_start = right_base +wrap 3_u64;
  let at = 0_u64;
  loop @compare {
    let done = at >= shared;
    if done {
      break @compare;
    }
    let left_at = left_start +wrap at;
    let right_at = right_start +wrap at;
    let left_byte = byte_at(store: names, index: left_at);
    let right_byte = byte_at(store: names, index: right_at);
    if left_byte < right_byte {
      return True();
    }
    if left_byte > right_byte {
      return False();
    }
    set at = at +wrap 1_u64;
  }
  return left_count < right_count;
}

fn put_decimal(destination: &[u8], at: own u64, value: own u64) -> result: own u64 writes(destination) {
  doc "Writes the decimal spelling of one unsigned value at one offset and reports the offset just past it, counting its digits first so it needs no scratch storage.";
  let digits = 1_u64;
  let probe = value;
  loop @measure {
    let single = probe < 10_u64;
    if single {
      break @measure;
    }
    set probe = probe / 10_u64;
    set digits = digits +wrap 1_u64;
  }
  let spare = deref(destination).len;
  let glyphs = digit_glyphs.len;
  let end = at +wrap digits;
  let cursor = end;
  let rest = value;
  loop @emit {
    let started = cursor <= at;
    if started {
      break @emit;
    }
    set cursor = cursor -wrap 1_u64;
    let digit = rest % 10_u64;
    let known = digit < glyphs;
    if known {
      let writable = cursor < spare;
      if writable {
        let glyph = digit_glyphs[digit];
        set deref(destination)[cursor] = glyph;
      }
    }
    set rest = rest / 10_u64;
  }
  return end;
}

fn assemble_failure(report: &[u8], capacity: own u64, path: &[u8], path_length: own u64, status: own u8) -> result: own u64 reads(path), writes(report) contract {
  requires capacity == deref(report).len;
  ensures result <= capacity;
} {
  doc "Assembles one `wfgrep: PATH: reason` diagnostic in the report range and hands back the assembled length, copying the caller's path bytes and clamping that length against the range's capacity. Publishing is the caller's, which now hands the same range reference to write_once [REF-1].";
  let length = 0_u64;
  let report_capacity = deref(report).len;
  let prefix_view = &error_prefix[0_u64..8_u64];
  set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: prefix_view);
  let prior_length = length;
  let path_room = deref(path).len;
  let copied_count = 0_u64;
  loop @name {
    let done = copied_count >= path_length;
    if done {
      break @name;
    }
    let readable = copied_count < path_room;
    if readable {
    } else {
      break @name;
    }
    let target_at = prior_length +wrap copied_count;
    let writable = target_at < report_capacity;
    if writable {
    } else {
      break @name;
    }
    let byte = deref(path)[copied_count];
    set deref(report)[target_at] = byte;
    set copied_count = copied_count +wrap 1_u64;
  }
  let candidate_length = prior_length +wrap copied_count;
  let candidate_fits = candidate_length <= report_capacity;
  let tail = if candidate_fits {
    give candidate_length;
  } else {
    give prior_length;
  }
  let separator_view = &error_separator[0_u64..2_u64];
  set tail = append_slice(destination: report, capacity: report_capacity, filled: tail, text: separator_view);
  let named = 0_u8;
  if status == 1_u8 {
    set named = 1_u8;
    let view = &reason_missing[0_u64..26_u64];
    set tail = append_slice(destination: report, capacity: report_capacity, filled: tail, text: view);
  }
  if status == 2_u8 {
    set named = 1_u8;
    let view = &reason_denied[0_u64..18_u64];
    set tail = append_slice(destination: report, capacity: report_capacity, filled: tail, text: view);
  }
  if status == 3_u8 {
    set named = 1_u8;
    let view = &reason_directory[0_u64..15_u64];
    set tail = append_slice(destination: report, capacity: report_capacity, filled: tail, text: view);
  }
  if status == 5_u8 {
    set named = 1_u8;
    let view = &reason_invalid_path[0_u64..22_u64];
    set tail = append_slice(destination: report, capacity: report_capacity, filled: tail, text: view);
  }
  if status == 6_u8 {
    set named = 1_u8;
    let view = &reason_long_line[0_u64..14_u64];
    set tail = append_slice(destination: report, capacity: report_capacity, filled: tail, text: view);
  }
  if named == 0_u8 {
    let view = &reason_unreadable[0_u64..12_u64];
    set tail = append_slice(destination: report, capacity: report_capacity, filled: tail, text: view);
  }
  return tail;
}

fn append_trailing_newline(input: &[u8], carry: own u64) -> result: own TrailingChunk writes(input) {
  let input_room = deref(input).len;
  let carry_ok = carry < input_room;
  if carry_ok {
  } else {
    let rejected = TrailingChunk(available: carry, status: 6_u8);
    return rejected;
  }
  set deref(input)[carry] = 10_u8;
  let available = carry +wrap 1_u64;
  let accepted = TrailingChunk(available: available, status: 0_u8);
  return accepted;
}

fn scan_line(input: &[u8], available: own u64, scan: own u64, pattern: &[u8], pattern_length: own u64, first_pattern_byte: own u8, empty_pattern: own Bool) -> result: own LineScan reads(input), reads(pattern) {
  let input_room = deref(input).len;
  let available_fits = available <= input_room;
  if available_fits {
  } else {
    let missed = False();
    let rejected = LineScan(terminator: available, hit: missed, status: 6_u8);
    return rejected;
  }
  let scan_fits = scan <= available;
  if scan_fits {
  } else {
    let missed = False();
    let rejected = LineScan(terminator: available, hit: missed, status: 6_u8);
    return rejected;
  }
  let pattern_room = deref(pattern).len;
  let terminator = available;
  let hit = empty_pattern;
  for @walk_line (probe in scan..available) {
    let byte = deref(input)[probe];
    let newline = byte == 10_u8;
    if newline {
      set terminator = probe;
      break @walk_line;
    }
    if hit {
    } else {
      let lead = byte == first_pattern_byte;
      if lead {
        let same = True();
        let ahead = 1_u64;
        loop @verify_line {
          let proven = ahead >= pattern_length;
          if proven {
            break @verify_line;
          }
          let spot = probe +wrap ahead;
          let inside = spot < available;
          if inside {
          } else {
            set same = False();
            break @verify_line;
          }
          let candidate = deref(input)[spot];
          let stopper = candidate == 10_u8;
          if stopper {
            set same = False();
            break @verify_line;
          }
          let ahead_ok = ahead < pattern_room;
          if ahead_ok {
          } else {
            set same = False();
            break @verify_line;
          }
          let expected = deref(pattern)[ahead];
          let equal = candidate == expected;
          if equal {
          } else {
            set same = False();
            break @verify_line;
          }
          set ahead = ahead +wrap 1_u64;
        }
        if same {
          set hit = True();
        }
      }
    }
  }
  let accepted = LineScan(terminator: terminator, hit: hit, status: 0_u8);
  return accepted;
}

fn shift_input_tail(input: &[u8], available: own u64, scan: own u64) -> result: own ShiftedTail writes(input) {
  let input_room = deref(input).len;
  let available_fits = available <= input_room;
  if available_fits {
  } else {
    let rejected = ShiftedTail(tail: 0_u64, status: 6_u8);
    return rejected;
  }
  let scan_fits = scan <= available;
  if scan_fits {
  } else {
    let rejected = ShiftedTail(tail: 0_u64, status: 6_u8);
    return rejected;
  }
  let moved = 0_u64;
  for (
    source_index in scan..available,
    invariant destination_precedes_source: moved <= source_index
  ) {
    let byte = deref(input)[source_index];
    set deref(input)[moved] = byte;
    set moved = moved + 1_u64;
  }
  let accepted = ShiftedTail(tail: moved, status: 0_u8);
  return accepted;
}

fn search_file(factory: &HandleFactory, file: &ReadFile, pattern: &[u8], pattern_length: own u64, path: &[u8], path_length: own u64, out: &OutputStream) -> result: own u8 reads(pattern), reads(path), writes(factory), writes(file), writes(out) {
  doc "Reads one open file and publishes `PATH:LINE:TEXT` for every line that holds the literal pattern bytes. Its two scratch windows are boxed runtime-capacity windows, each reached through one range reference [TYPE-9, REF-4].";
  let input_cell = zeroed_bytes(count: 4096_u64);
  let input = &input_cell.inner[0_u64..4096_u64];
  let batch_cell = zeroed_bytes(count: 8192_u64);
  let batch = &batch_cell.inner[0_u64..8192_u64];
  let batch_room = deref(batch).len;
  let pattern_room = deref(pattern).len;
  let first_pattern_byte = 0_u8;
  let has_pattern = pattern_room > 0_u64;
  if has_pattern {
    set first_pattern_byte = deref(pattern)[0_u64];
  }
  let empty_pattern = pattern_length == 0_u64;
  let matched = 0_u8;
  let status = 0_u8;
  let filled = 0_u64;
  let line_number = 0_u64;
  let carry = 0_u64;
  let file_offset = 0_u64;
  loop @chunks {
    let chunk_room = deref(input).len;
    let carry_within_input = carry <= chunk_room;
    if carry_within_input {
    } else {
      set status = 6_u8;
      break @chunks;
    }
    let spare = chunk_room -wrap carry;
    let overlong = spare == 0_u64;
    if overlong {
      set status = 6_u8;
      break @chunks;
    }
    let available = 0_u64;
    let ended = 0_u8;
    match read_at(factory: factory, file: file, destination: input, file_offset: file_offset, start: carry, end: chunk_room) {
      Ok(value: endpoint) => {
        let received = endpoint -wrap carry;
        set file_offset = file_offset +wrap received;
        set available = endpoint;
      }
      Err(error: read_stop_7) => {
        match read_stop_7 {
          ReadEnd() => {
            set ended = 1_u8;
          }
          ReadFailed(error: problem) => {
            set status = io_class(error: problem);
            set ended = 2_u8;
          }
        }
      }
    }
    if ended == 2_u8 {
      break @chunks;
    }
    if ended == 1_u8 {
      let trailing = carry > 0_u64;
      if trailing {
        let trailing_available = carry;
        let trailing_status = 0_u8;
        let trailing_result = append_trailing_newline(input: input, carry: carry);
        set trailing_available = trailing_result.available;
        set trailing_status = trailing_result.status;
        if trailing_status == 0_u8 {
          set available = trailing_available;
        } else {
          set status = trailing_status;
          break @chunks;
        }
      }
    }
    let scan = 0_u64;
    loop @lines {
      let terminator = available;
      let hit = empty_pattern;
      let line_status = 0_u8;
      let line_result = scan_line(input: input, available: available, scan: scan, pattern: pattern, pattern_length: pattern_length, first_pattern_byte: first_pattern_byte, empty_pattern: empty_pattern);
      set terminator = line_result.terminator;
      set hit = line_result.hit;
      set line_status = line_result.status;
      if line_status == 0_u8 {
      } else {
        set status = line_status;
        break @chunks;
      }
      let complete = terminator < available;
      if complete {
      } else {
        break @lines;
      }
      set line_number = line_number +wrap 1_u64;
      if hit {
        set matched = 1_u8;
        let stop = terminator +wrap 1_u64;
        let span = stop -wrap scan;
        let front = path_length +wrap 24_u64;
        let record = front +wrap span;
        let need = filled +wrap record;
        let overfull = need > 8192_u64;
        if overfull {
          let batch_fits = filled <= batch_room;
          if batch_fits {
            match publish_all(factory: factory, output: out, source: batch, length: filled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
                set status = io_class(error: problem);
              }
            }
          } else {
            set status = 6_u8;
          }
          set filled = 0_u64;
        }
        if status == 0_u8 {
          set filled = copy_range(destination: batch, at: filled, source: path, from: 0_u64, to: path_length);
          let colon_room = filled < batch_room;
          if colon_room {
            set deref(batch)[filled] = 58_u8;
            set filled = filled +wrap 1_u64;
          }
          set filled = put_decimal(destination: batch, at: filled, value: line_number);
          let second_room = filled < batch_room;
          if second_room {
            set deref(batch)[filled] = 58_u8;
            set filled = filled +wrap 1_u64;
          }
          set filled = copy_range(destination: batch, at: filled, source: input, from: scan, to: stop);
        } else {
          break @lines;
        }
      }
      set scan = terminator +wrap 1_u64;
    }
    if status == 0_u8 {
    } else {
      break @chunks;
    }
    if ended == 1_u8 {
      break @chunks;
    }
    let tail = 0_u64;
    let shift_status = 0_u8;
    let shift_result = shift_input_tail(input: input, available: available, scan: scan);
    set tail = shift_result.tail;
    set shift_status = shift_result.status;
    if shift_status == 0_u8 {
      set carry = tail;
    } else {
      set status = shift_status;
      break @chunks;
    }
  }
  let pending = filled > 0_u64;
  if pending {
    let final_fits = filled <= batch_room;
    if final_fits {
      match publish_all(factory: factory, output: out, source: batch, length: filled) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
          set status = io_class(error: problem);
        }
      }
    } else {
      set status = 6_u8;
    }
  }
  let flag = if matched == 1_u8 {
    give 16_u8;
  } else {
    give 0_u8;
  }
  let packed = ior(status, flag);
  return packed;
}

fn open_source_from_factory(factory: &HandleFactory, directory: &DirectoryRead) -> result: own Result<DirectorySource, IoError> reads(directory), writes(factory) {
  return open_directory_source(factory: factory, directory: directory);
}

fn open_file_from_factory(factory: &HandleFactory, root: &DirectoryRead, name: &[u8], start: own u64, end: own u64) -> result: own Result<ReadFile, IoError> reads(root), reads(name), writes(factory) contract {
  define ordered = start <= end;
  define capacity = deref(name).len;
  define within = end <= capacity;
  requires ordered;
  requires within;
} {
  return open_file(factory: factory, root: root, name: name, start: start, end: end);
}

fn open_directory_from_factory(factory: &HandleFactory, root: &DirectoryRead, name: &[u8], start: own u64, end: own u64) -> result: own Result<DirectoryRead, IoError> reads(root), reads(name), writes(factory) contract {
  define ordered = start <= end;
  define capacity = deref(name).len;
  define within = end <= capacity;
  requires ordered;
  requires within;
} {
  return open_directory(factory: factory, root: root, name: name, start: start, end: end);
}

fn walk(factory: &HandleFactory, dir: &DirectoryRead, prefix: &[u8], prefix_length: own u64, pattern: &[u8], pattern_length: own u64, out: &OutputStream, err: &OutputStream) -> result: own u8 reads(dir), reads(prefix), reads(pattern), writes(factory), writes(out), writes(err) {
  doc "Enumerates one directory in sorted order, searches the regular files it names, and descends into the subdirectories it names. The descent carries no source-level depth limit; stack availability remains outside this version's portable result model. Two program bounds remain and both are recorded as defects. One truncates silently: at most 64 entries per directory are retained, in the host's enumeration order, before sorting, and the walk returns normally, so that truncation is indistinguishable from a complete one. The other stops the descent: a display path past a thousand bytes refuses, which on a tree of one-byte directory names binds at roughly five hundred levels, and it reports by exit status alone with nothing on standard error.";
  let matched = 0_u8;
  let failed = 0_u8;
  let entries_cell = zeroed_bytes(count: 8192_u64);
  let entries = &entries_cell.inner[0_u64..8192_u64];
  let names_cell = zeroed_bytes(count: 65664_u64);
  let names = &names_cell.inner[0_u64..65664_u64];
  let order_cell = zeroed_words(count: 64_u64);
  let order = &order_cell.inner[0_u64..64_u64];
  let child_cell = zeroed_bytes(count: 1024_u64);
  let child = &child_cell.inner[0_u64..1024_u64];
  let report_cell = zeroed_bytes(count: 1280_u64);
  let report = &report_cell.inner[0_u64..1280_u64];
  let stored = 0_u64;
  match open_source_from_factory(factory: factory, directory: dir) {
    Ok(value: list) => {
      loop @batches {
        let produced = 0_u64;
        let ended = 0_u8;
        let window_room = deref(entries).len;
        let (list_result_8, endpoint, reported) = directory_next(source: &list, destination: entries, start: 0_u64, end: window_room);
        match list_result_8 {
          Ok(value: completed) => {
            set produced = endpoint;
          }
          Err(error: list_stop_8) => {
            match list_stop_8 {
              ListEnd() => {
                set ended = 1_u8;
              }
              ListFailed(error: problem) => {
                set ended = 2_u8;
                set failed = 1_u8;
              }
            }
          }
        }
        if ended == 0_u8 {
        } else {
          break @batches;
        }
        let empty_batch = produced == 0_u64;
        if empty_batch {
          break @batches;
        }
        let at = 0_u64;
        loop @stored_entry {
          let entries_room = deref(entries).len;
          let names_room = deref(names).len;
          let header_end = at +wrap 3_u64;
          let complete = header_end <= produced;
          if complete {
          } else {
            break @stored_entry;
          }
          let kind_readable = at < entries_room;
          if kind_readable {
          } else {
            break @stored_entry;
          }
          let kind = deref(entries)[at];
          let length_low_at = at +wrap 1_u64;
          let length_low_readable = length_low_at < entries_room;
          if length_low_readable {
          } else {
            break @stored_entry;
          }
          let length_high_at = at +wrap 2_u64;
          let length_high_readable = length_high_at < entries_room;
          if length_high_readable {
          } else {
            break @stored_entry;
          }
          let name_length_low = deref(entries)[length_low_at];
          let name_length_high = deref(entries)[length_high_at];
          let name_count_low = cvt::<u8, u64>(name_length_low);
          let name_count_high = cvt::<u8, u64>(name_length_high);
          let name_count_high_shifted = ishl.wrap(name_count_high, 8_u32);
          let name_count = ior(name_count_low, name_count_high_shifted);
          let name_at = at +wrap 3_u64;
          let name_end = name_at +wrap name_count;
          let bounded = name_end <= produced;
          if bounded {
          } else {
            break @stored_entry;
          }
          let ordered = name_at <= name_end;
          if ordered {
          } else {
            break @stored_entry;
          }
          let addressable = name_end <= entries_room;
          if addressable {
          } else {
            break @stored_entry;
          }
          set at = name_end;
          let dotted = 0_u8;
          let single = name_count == 1_u64;
          if single {
            let first_readable = name_at < entries_room;
            if first_readable {
              let first = deref(entries)[name_at];
              if first == 46_u8 {
                set dotted = 1_u8;
              }
            }
          }
          let paired = name_count == 2_u64;
          if paired {
            let second_at = name_at +wrap 1_u64;
            let first_readable = name_at < entries_room;
            let second_readable = second_at < entries_room;
            if first_readable {
              if second_readable {
                let first = deref(entries)[name_at];
                let second = deref(entries)[second_at];
                if first == 46_u8 {
                  if second == 46_u8 {
                    set dotted = 1_u8;
                  }
                }
              }
            }
          }
          let not_dotted = dotted == 0_u8;
          let component_fits = name_count <= 1023_u64;
          let usable = band(not_dotted, component_fits);
          let room_left = stored < 64_u64;
          if usable {
            if room_left {
              let base = stored *wrap 1026_u64;
              let kind_writable = base < names_room;
              if kind_writable {
                set deref(names)[base] = kind;
              }
              let stored_length_low_at = base +wrap 1_u64;
              let length_low_writable = stored_length_low_at < names_room;
              if length_low_writable {
                set deref(names)[stored_length_low_at] = name_length_low;
              }
              let stored_length_high_at = base +wrap 2_u64;
              let length_high_writable = stored_length_high_at < names_room;
              if length_high_writable {
                set deref(names)[stored_length_high_at] = name_length_high;
              }
              let target_start = base +wrap 3_u64;
              let taken = 0_u64;
              loop @store_name {
                let done = taken >= name_count;
                if done {
                  break @store_name;
                }
                let source_at = name_at +wrap taken;
                let readable = source_at < entries_room;
                if readable {
                } else {
                  break @store_name;
                }
                let target_at = target_start +wrap taken;
                let writable = target_at < names_room;
                if writable {
                } else {
                  break @store_name;
                }
                let byte = deref(entries)[source_at];
                set deref(names)[target_at] = byte;
                set taken = taken +wrap 1_u64;
              }
              set stored = stored +wrap 1_u64;
            }
          }
        }
      }
      close_directory_source(factory: factory, source: move list);
    }
    Err(error: problem) => {
      set failed = 1_u8;
    }
  }
  let seed = 0_u64;
  loop @seed_order {
    let order_room = deref(order).len;
    let done = seed >= stored;
    if done {
      break @seed_order;
    }
    let writable = seed < order_room;
    if writable {
    } else {
      break @seed_order;
    }
    set deref(order)[seed] = seed;
    set seed = seed +wrap 1_u64;
  }
  let selected = 0_u64;
  loop @sort {
    let order_room = deref(order).len;
    let done = selected >= stored;
    if done {
      break @sort;
    }
    let selected_readable = selected < order_room;
    if selected_readable {
    } else {
      break @sort;
    }
    let best = selected;
    let probe = selected +wrap 1_u64;
    loop @scan {
      let scan_room = deref(order).len;
      let scanned = probe >= stored;
      if scanned {
        break @scan;
      }
      let probe_readable = probe < scan_room;
      if probe_readable {
      } else {
        break @scan;
      }
      let best_readable = best < scan_room;
      if best_readable {
      } else {
        break @scan;
      }
      let candidate = deref(order)[probe];
      let incumbent = deref(order)[best];
      let earlier = 0_u8;
      let closer = name_before(names: names, left: candidate, right: incumbent);
      if closer {
        set earlier = 1_u8;
      }
      if earlier == 1_u8 {
        set best = probe;
      }
      set probe = probe +wrap 1_u64;
    }
    let best_readable = best < order_room;
    if best_readable {
      let held = deref(order)[selected];
      let winner = deref(order)[best];
      set deref(order)[best] = held;
      set deref(order)[selected] = winner;
    }
    set selected = selected +wrap 1_u64;
  }
  let visited = 0_u64;
  loop @process {
    let names_room = deref(names).len;
    let order_room = deref(order).len;
    let child_room = deref(child).len;
    let prefix_room = deref(prefix).len;
    let done = visited >= stored;
    if done {
      break @process;
    }
    let readable = visited < order_room;
    if readable {
    } else {
      break @process;
    }
    let index = deref(order)[visited];
    set visited = visited +wrap 1_u64;
    let base = index *wrap 1026_u64;
    let kind_readable = base < names_room;
    if kind_readable {
    } else {
      break @process;
    }
    let kind = deref(names)[base];
    let stored_length_low_at = base +wrap 1_u64;
    let length_low_readable = stored_length_low_at < names_room;
    if length_low_readable {
    } else {
      break @process;
    }
    let stored_length_high_at = base +wrap 2_u64;
    let length_high_readable = stored_length_high_at < names_room;
    if length_high_readable {
    } else {
      break @process;
    }
    let stored_length_low = deref(names)[stored_length_low_at];
    let stored_length_high = deref(names)[stored_length_high_at];
    let name_count_low = cvt::<u8, u64>(stored_length_low);
    let name_count_high = cvt::<u8, u64>(stored_length_high);
    let name_count_high_shifted = ishl.wrap(name_count_high, 8_u32);
    let name_count = ior(name_count_low, name_count_high_shifted);
    let name_at = base +wrap 3_u64;
    let name_end = name_at +wrap name_count;
    let name_bounded = name_end <= names_room;
    if name_bounded {
    } else {
      set failed = 1_u8;
      break @process;
    }
    let name_ordered = name_at <= name_end;
    if name_ordered {
    } else {
      set failed = 1_u8;
      break @process;
    }
    let separated = prefix_length > 0_u64;
    let separated_length = prefix_length +wrap 1_u64;
    let child_length = if separated {
      give separated_length +wrap name_count;
    } else {
      give name_count;
    }
    let fits = child_length <= 1000_u64;
    if fits {
    } else {
      set failed = 1_u8;
      break @process;
    }
    let cursor = 0_u64;
    loop @prefix_copy {
      let copied = cursor >= prefix_length;
      if copied {
        break @prefix_copy;
      }
      let prefix_readable = cursor < prefix_room;
      if prefix_readable {
      } else {
        break @prefix_copy;
      }
      let writable = cursor < child_room;
      if writable {
      } else {
        break @prefix_copy;
      }
      let byte = deref(prefix)[cursor];
      set deref(child)[cursor] = byte;
      set cursor = cursor +wrap 1_u64;
    }
    if separated {
      let separator_fits = cursor < child_room;
      if separator_fits {
        set deref(child)[cursor] = 47_u8;
        set cursor = cursor +wrap 1_u64;
      }
    }
    let taken = 0_u64;
    loop @name_copy {
      let copied = taken >= name_count;
      if copied {
        break @name_copy;
      }
      let source_at = name_at +wrap taken;
      let source_readable = source_at < names_room;
      if source_readable {
      } else {
        break @name_copy;
      }
      let writable = cursor < child_room;
      if writable {
      } else {
        break @name_copy;
      }
      let byte = deref(names)[source_at];
      set deref(child)[cursor] = byte;
      set cursor = cursor +wrap 1_u64;
      set taken = taken +wrap 1_u64;
    }
    let regular = kind == 1_u8;
    if regular {
      let status = 0_u8;
      match open_file_from_factory(factory: factory, root: dir, name: names, start: name_at, end: name_end) {
        Ok(value: file) => {
          let outcome = search_file(factory: factory, file: &file, pattern: pattern, pattern_length: pattern_length, path: child, path_length: cursor, out: out);
          set status = iand(outcome, 15_u8);
          let found = iand(outcome, 16_u8);
          if found == 16_u8 {
            set matched = 1_u8;
          }
          close_read(factory: factory, file: move file);
        }
        Err(error: problem) => {
          set status = io_class(error: problem);
        }
      }
      let reportable = status != 0_u8;
      if reportable {
        set failed = 1_u8;
        let report_room = deref(report).len;
        let assembled = assemble_failure(report: report, capacity: report_room, path: child, path_length: cursor, status: status);
        match publish_all(factory: factory, output: err, source: report, length: assembled) {
          Ok(value: published) => {
          }
          Err(error: problem) => {
          }
        }
      }
    }
    let descending = kind == 2_u8;
    if descending {
      let status = 0_u8;
      match open_directory_from_factory(factory: factory, root: dir, name: names, start: name_at, end: name_end) {
        Ok(value: opened) => {
          let outcome = walk(factory: factory, dir: &opened, prefix: child, prefix_length: cursor, pattern: pattern, pattern_length: pattern_length, out: out, err: err);
          let found = iand(outcome, 1_u8);
          let broke = iand(outcome, 2_u8);
          if found == 1_u8 {
            set matched = 1_u8;
          }
          if broke == 2_u8 {
            set failed = 1_u8;
          }
          close_directory(factory: factory, directory: move opened);
        }
        Err(error: problem) => {
          set status = io_class(error: problem);
        }
      }
      let reportable = status != 0_u8;
      if reportable {
        set failed = 1_u8;
        let report_room = deref(report).len;
        let assembled = assemble_failure(report: report, capacity: report_room, path: child, path_length: cursor, status: status);
        match publish_all(factory: factory, output: err, source: report, length: assembled) {
          Ok(value: published) => {
          }
          Err(error: problem) => {
          }
        }
      }
    }
  }
  let matched_bit = if matched == 1_u8 {
    give 1_u8;
  } else {
    give 0_u8;
  }
  let failed_bit = if failed == 1_u8 {
    give 2_u8;
  } else {
    give 0_u8;
  }
  let packed = ior(matched_bit, failed_bit);
  return packed;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> status: own ExitStatus reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Searches one directory tree recursively and publishes `PATH:LINE:TEXT` for the lines holding the literal pattern bytes; 0 matched, 1 none, 2 error. The search is complete only within `walk`'s two remaining fixed bounds: 64 entries per directory, beyond which it truncates and still returns normally, and a thousand-byte display path, beyond which the descent stops and the run exits 2 with nothing on standard error.";
  let pattern_cell = zeroed_bytes(count: 4096_u64);
  let pattern = &pattern_cell.inner[0_u64..4096_u64];
  let root_name_cell = zeroed_bytes(count: 256_u64);
  let root_name = &root_name_cell.inner[0_u64..256_u64];
  let root_path_cell = zeroed_bytes(count: 1024_u64);
  let root_path = &root_path_cell.inner[0_u64..1024_u64];
  let report_cell = zeroed_bytes(count: 1280_u64);
  let report = &report_cell.inner[0_u64..1280_u64];
  let arguments = args_count(args: args);
  let startup = 0_u8;
  let pattern_length = 0_u64;
  let root_length = 0_u64;
  let usable = arguments >= 3_u64;
  if usable {
    match arg_get(args: args, position: 1_u64) {
      Ok(value: text) => {
        let pattern_room = deref(pattern).len;
        match host_copy_bytes(value: &text, destination: pattern, start: 0_u64, end: pattern_room) {
          Ok(value: copied) => {
            set pattern_length = copied;
          }
          Err(error: too_small) => {
            set startup = 2_u8;
          }
        }
      }
      Err(error: absent) => {
        set startup = 1_u8;
      }
    }
    match arg_get(args: args, position: 2_u64) {
      Ok(value: text) => {
        let name_room = deref(root_name).len;
        match host_copy_bytes(value: &text, destination: root_name, start: 0_u64, end: name_room) {
          Ok(value: copied) => {
            set root_length = copied;
          }
          Err(error: too_small) => {
            set startup = 3_u8;
          }
        }
      }
      Err(error: absent) => {
        set startup = 1_u8;
      }
    }
  } else {
    set startup = 1_u8;
  }
  if startup == 0_u8 {
  } else {
    let length = 0_u64;
    let report_room = deref(report).len;
    if startup == 1_u8 {
      let view = &usage_text[0_u64..27_u64];
      set length = append_slice(destination: report, capacity: report_room, filled: length, text: view);
    }
    if startup == 2_u8 {
      let view = &reason_pattern_too_long[0_u64..25_u64];
      set length = append_slice(destination: report, capacity: report_room, filled: length, text: view);
    }
    if startup == 3_u8 {
      let view = &reason_root_too_long[0_u64..29_u64];
      set length = append_slice(destination: report, capacity: report_room, filled: length, text: view);
    }
    match publish_all(factory: files, output: err, source: report, length: length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: 2_u8);
  }
  let root_name_room = deref(root_name).len;
  let root_length_fits = root_length <= root_name_room;
  if root_length_fits {
  } else {
    let length = 0_u64;
    let report_room = deref(report).len;
    let view = &reason_root_too_long[0_u64..29_u64];
    set length = append_slice(destination: report, capacity: report_room, filled: length, text: view);
    match publish_all(factory: files, output: err, source: report, length: length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: 2_u8);
  }
  let copied = 0_u64;
  loop @root_copy_out {
    let name_room = deref(root_name).len;
    let root_room = deref(root_path).len;
    let done = copied >= root_length;
    if done {
      break @root_copy_out;
    }
    let readable = copied < name_room;
    if readable {
    } else {
      break @root_copy_out;
    }
    let writable = copied < root_room;
    if writable {
    } else {
      break @root_copy_out;
    }
    let byte = deref(root_name)[copied];
    set deref(root_path)[copied] = byte;
    set copied = copied +wrap 1_u64;
  }
  let matched = 0_u8;
  let failed = 0_u8;
  let root_status = 0_u8;
  match open_directory(factory: files, root: cwd, name: root_name, start: 0_u64, end: root_length) {
    Ok(value: root) => {
      let outcome = walk(factory: files, dir: &root, prefix: root_path, prefix_length: copied, pattern: pattern, pattern_length: pattern_length, out: out, err: err);
      let found = iand(outcome, 1_u8);
      let broke = iand(outcome, 2_u8);
      if found == 1_u8 {
        set matched = 1_u8;
      }
      if broke == 2_u8 {
        set failed = 1_u8;
      }
      close_directory(factory: files, directory: move root);
    }
    Err(error: problem) => {
      set root_status = io_class(error: problem);
    }
  }
  let directory_refused = root_status != 0_u8;
  if directory_refused {
    let single = 0_u8;
    match arg_get(args: args, position: 2_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            match open_read(factory: files, root: cwd, path: &path) {
              Ok(value: file) => {
                set single = 1_u8;
                let outcome = search_file(factory: files, file: &file, pattern: pattern, pattern_length: pattern_length, path: root_path, path_length: copied, out: out);
                set root_status = iand(outcome, 15_u8);
                let found = iand(outcome, 16_u8);
                if found == 16_u8 {
                  set matched = 1_u8;
                }
                close_read(factory: files, file: move file);
              }
              Err(error: refused) => {
              }
            }
          }
          Err(error: rejected) => {
            set root_status = 5_u8;
          }
        }
      }
      Err(error: absent) => {
      }
    }
  }
  let reportable = root_status != 0_u8;
  if reportable {
    set failed = 1_u8;
    let report_room = deref(report).len;
    let assembled = assemble_failure(report: report, capacity: report_room, path: root_path, path_length: copied, status: root_status);
    match publish_all(factory: files, output: err, source: report, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
  }
  if failed == 0_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  if matched == 0_u8 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
