        let result = scan_line<'line_scan_call, 'a>(input: &'line_scan_call input, available: available, scan: scan, pattern: pattern, pattern_length: pattern_length, first_pattern_byte: first_pattern_byte, empty_pattern: empty_pattern);
        set terminator = result.terminator;
        set hit = result.hit;
        set line_status = result.status;
      }
      if ieq(line_status, 0_u8) {
      } else {
        set status = line_status;
        break @chunks;
      }
      let complete = ilt(terminator, available);
      if complete {
      } else {
        break @lines;
      }
      set line_number = line_number +wrap 1_u64;
      if hit {
        set matched = 1_u8;
        let stop = terminator +wrap 1_u64;
        let span = stop -wrap scan;
        let head = path_length +wrap 24_u64;
        let record = head +wrap span;
        let need = filled +wrap record;
        let overfull = igt(need, 8192_u64);
        if overfull {
          let batch_fits = ile(filled, batch_room);
          if batch_fits {
            region 'batch_write {
              match publish_all<'batch_write, 'batch_write>(output: &uniq 'batch_write deref(out), source: &'batch_write batch, length: filled) {
                Ok(value: published) => {
                }
                Err(error: problem) => {
                  set status = io_class(error: move problem);
                }
              }
            }
          } else {
            set status = 6_u8;
          }
          set filled = 0_u64;
        }
        if ieq(status, 0_u8) {
          region 'emit_path {
            set filled = copy_range<'emit_path, 'emit_path>(destination: &uniq 'emit_path batch, at: filled, source: &'emit_path deref(path), from: 0_u64, to: path_length);
