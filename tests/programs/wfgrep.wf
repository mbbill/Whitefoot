      set scan = terminator +wrap 1_u64;
    }
    if ieq(status, 0_u8) {
    } else {
      break @chunks;
    }
    if ieq(ended, 1_u8) {
      break @chunks;
    }
    let tail = 0_u64;
    let shift_status = 0_u8;
    region 'shift_call {
      let result = shift_input_tail<'shift_call>(input: &uniq 'shift_call input, available: available, scan: scan);
