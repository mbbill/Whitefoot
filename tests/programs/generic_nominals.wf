struct Pair<T: Int> {
  left: T;
  right: T;
}

enum Choice<T: Int> {
  Missing();
  Present(value: T);
}

struct Packet<const n: u64> {
  bytes: array<u8, n>;
}

struct Holder<T> {
  value: T;
}

struct Wrapped<T: Int> {
  value: Option<T>;
}

fn duplicate<T: Int>(value: own T) -> result: own Pair<T> pure {
  return Pair<T>(left: value, right: value);
}

fn present<T: Int>(value: own T) -> result: own Choice<T> pure {
  return Present<T>(value: value);
}

fn checked_sum<T: Int>(left: own T, right: own T) -> result: own Result<T, Overflow> pure {
  return left +checked right;
}

command fn main() -> status: own ExitStatus traps {
  let small = duplicate<u8>(value: 7_u8);
  let wide = duplicate<i64>(value: -9_i64);
  let small_left = small.left;
  let wide_right = wide.right;
  claim small_generic_struct: ieq(small_left, 7_u8) because "small generic struct";
  claim wide_generic_struct: ieq(wide_right, -9_i64) because "wide generic struct";
  let small_choice = present<u8>(value: 3_u8);
  match small_choice {
    Missing() => {
      claim unexpected_small_choice: False() because "unexpected small choice";
    }
    Present(value: observed) => {
      claim small_generic_enum: ieq(observed, 3_u8) because "small generic enum";
    }
  }
  let wide_choice = present<i64>(value: -5_i64);
  match wide_choice {
    Missing() => {
      claim unexpected_wide_choice: False() because "unexpected wide choice";
    }
    Present(value: observed) => {
      claim wide_generic_enum: ieq(observed, -5_i64) because "wide generic enum";
    }
  }
  let sum = checked_sum<u8>(left: 1_u8, right: 2_u8);
  match sum {
    Ok(value: observed) => {
      claim checked_generic_sum: ieq(observed, 3_u8) because "checked generic sum";
    }
    Err(error: overflow) => {
      claim unexpected_checked_overflow: False() because "unexpected checked overflow";
    }
  }
  let overflowed = checked_sum<u8>(left: 255_u8, right: 1_u8);
  match overflowed {
    Ok(value: observed) => {
      claim missing_checked_overflow: False() because "missing checked overflow";
    }
    Err(error: overflow) => {
    }
  }
  let wide_sum = checked_sum<i64>(left: -4_i64, right: 9_i64);
  match wide_sum {
    Ok(value: observed) => {
      claim wide_checked_generic_sum: ieq(observed, 5_i64) because "wide checked generic sum";
    }
    Err(error: overflow) => {
      claim unexpected_wide_overflow: False() because "unexpected wide overflow";
    }
  }
  let optional = Some<u8>(value: 19_u8);
  let wrapped = Wrapped<u8>(value: move optional);
  let recovered_optional = move wrapped.value;
  match recovered_optional {
    None() => {
      claim missing_wrapped_option: False() because "missing wrapped option";
    }
    Some(value: observed) => {
      claim wrapped_generic_option: ieq(observed, 19_u8) because "wrapped generic option";
    }
  }
  let bytes = array_new<u8, 2>(11_u8);
  let packet = Packet<2>(bytes: move bytes);
  let holder = Holder<Packet<2>>(value: move packet);
  let recovered_packet = move holder.value;
  let recovered_bytes = move recovered_packet.bytes;
  let recovered = recovered_bytes[1_u64];
  claim nested_const_generic_nominal: ieq(recovered, 11_u8) because "nested const generic nominal";
  return exit_status(code: 0_u8);
}
