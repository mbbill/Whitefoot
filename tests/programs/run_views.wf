fn view_total(window: own Slice<u8>) -> total: own u64 reads(window) {
  let width = len_of(window);
  let sum = 0_u64;
  let at = 0_u64;
  loop @add {
    let done = at == width;
    if done {
      break @add;
    }
    let inside = at < width;
    if inside {
      let slot = window[at];
      let widened = cvt::<u8, u64>(slot);
      set sum = sum +wrap widened;
      set at = at +wrap 1_u64;
    } else {
      return 0_u64;
    }
  }
  return sum;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 3_u8);
  let two = place_back(vector: move one, value: 4_u8);
  region {
    let window = slice_of(&two);
    let width = len_of(window);
    if width == 2_u64 {
    } else {
      return exit_status(code: 21_u8);
    }
    let total = view_total(window: window);
    let again = view_total(window: window);
    if total == 7_u64 {
    } else {
      return exit_status(code: 22_u8);
    }
    if again == total {
    } else {
      return exit_status(code: 23_u8);
    }
    let three = place_back(vector: move two, value: 5_u8);
    region {
      let after = slice_of(&three);
      let extended = view_total(window: after);
      if extended == 12_u64 {
      } else {
        return exit_status(code: 24_u8);
      }
    }
    let (rest, taken) = take_front(vector: move three);
    let (shorter, next) = take_front(vector: move rest);
    let (drained, last) = take_front(vector: move shorter);
    region {
      let nothing = slice_of(&drained);
      let empty_width = len_of(nothing);
      if empty_width == 0_u64 {
      } else {
        return exit_status(code: 25_u8);
      }
    }
  }
  let table = buffer_new(3_u64, 7_u8);
  region {
    let writer = mut_slice_of(&uniq table);
    set writer[0_u64] = 9_u8;
    let reader = slice_of(&table);
    let seen = reader[0_u64];
    if seen == 9_u8 {
    } else {
      return exit_status(code: 26_u8);
    }
    set writer[1_u64] = 11_u8;
    let written = writer[1_u64];
    if written == 11_u8 {
    } else {
      return exit_status(code: 27_u8);
    }
  }
  return exit_status(code: 0_u8);
}
