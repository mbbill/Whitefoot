fn view_total(window: own Slice<u8>) -> total: own u64 reads(window) {
  let width = len_of(window);
  let sum = 0_u64;
  let at = 0_u64;
  loop @add {
    let done = at == width;
    if done {
      break @add;
    }
    let inside = at < width;
    if inside {
      let slot = window[at];
      let widened = cvt::<u8, u64>(slot);
      set sum = sum +wrap widened;
      set at = at +wrap 1_u64;
    } else {
      return 0_u64;
    }
  }
  return sum;
}

command fn main() -> status: own ExitStatus pure {
  let empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq empty, value: 3_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 4_u8);
  }
  let two = move one;
  region {
    let window = slice_of(&two);
    let width = len_of(window);
    if width == 2_u64 {
    } else {
      return exit_status(code: 21_u8);
    }
    let total = view_total(window: window);
    let again = view_total(window: window);
    if total == 7_u64 {
    } else {
      return exit_status(code: 22_u8);
    }
    if again == total {
    } else {
      return exit_status(code: 23_u8);
    }
    place_back(vector: &uniq two, value: 5_u8);
    let three = move two;
    region {
      let after = slice_of(&three);
      let extended = view_total(window: after);
      if extended == 12_u64 {
      } else {
        return exit_status(code: 24_u8);
      }
    }
    region {
      let taken = take_front(vector: &uniq three);
      let rest = move three;
      region {
        let next = take_front(vector: &uniq rest);
        let shorter = move rest;
        region {
          let last = take_front(vector: &uniq shorter);
          let drained = move shorter;
          region {
            let nothing = slice_of(&drained);
            let empty_width = len_of(nothing);
            if empty_width == 0_u64 {
            } else {
              return exit_status(code: 25_u8);
            }
          }
        }
      }
    }
  }
  region 'a {
    let workspace = arena_frame::<3, 1, 'a>();
    region {
      let table = arena_vector_proved::<u8>(store: &uniq workspace, count: 3_u64);
      region {
        place_back(vector: &uniq table, value: 7_u8);
      }
      region {
        place_back(vector: &uniq table, value: 7_u8);
      }
      region {
        place_back(vector: &uniq table, value: 7_u8);
      }
      region {
        let writer = mut_slice_of(&uniq table);
        set writer[0_u64] = 9_u8;
        let reader = slice_of(&table);
        let seen = reader[0_u64];
        if seen == 9_u8 {
        } else {
          return exit_status(code: 26_u8);
        }
        set writer[1_u64] = 11_u8;
        let written = writer[1_u64];
        if written == 11_u8 {
        } else {
          return exit_status(code: 27_u8);
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
