fn byte_at(store: &Slice<u8>, index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the view does not hold.";
  let room = len_of(deref(store));
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn parse_port(digits: &Slice<u8>, length: own u64) -> result: own u16 reads(digits) {
  doc "Reads one decimal port out of the argument bytes the invocation supplied; a byte that is not a digit ends the number.";
  let port = 0_u16;
  let ended = 0_u8;
  let index = 0_u64;
  loop @scan {
    let more = index < length;
    if more {
    } else {
      break @scan;
    }
    let byte = byte_at(store: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
      let value = byte -wrap 48_u8;
      let widened = cvt::<u8, u16>(value);
      let scaled = port *wrap 10_u16;
      set port = scaled +wrap widened;
    } else {
      set ended = 1_u8;
    }
    if ended == 0_u8 {
      set index = index +wrap 1_u64;
    } else {
      break @scan;
    }
  }
  return port;
}

fn send_all(send: &uniq TcpSend, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(send, source), writes(send) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Sends one prefix of the source view, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    region {
      match send_once(send: &uniq deref(send), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_all(output: &uniq OutputStream, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source view, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(output: &uniq deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

command fn main(command.args as args: own Args, command.stdout as out: own OutputStream, command.handles as handles: own HandleFactory, command.heap as heap: own Heap) -> status: own ExitStatus reads(args, out, handles, heap), writes(out, handles, heap), allocates(heap) {
  doc "Connects to the loopback port named by the invocation, sends eight bytes through the connection's sending direction, and publishes every byte the peer returns through its receiving direction until the peer stops sending [SYS-17, SYS-18]. The argument scratch and the receive chunk are store-resident runs viewed exclusively where they are written and shared where they are read; the eight-byte payload is an inline run whose shared view is all the send needs.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 16_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh_digits) => {
        let digits = move fresh_digits;
        for @fill_digits (
          at in 0_u64..16_u64,
          invariant grown_digits: len_of(digits) >= at,
          invariant spare_digits: room_of(digits) + at >= 16_u64,
          invariant flat_digits: head_of(digits) <= 0_u64
        ) {
          set digits = place_back(vector: move digits, value: 0_u8);
        }
        match heap_vector::<u8>(store: &uniq heap, count: 4096_u64) {
          None() => {
            return exit_status(code: 70_u8);
          }
          Some(value: fresh_chunk) => {
            let chunk = move fresh_chunk;
            for @fill_chunk (
              at in 0_u64..4096_u64,
              invariant grown_chunk: len_of(chunk) >= at,
              invariant spare_chunk: room_of(chunk) + at >= 4096_u64,
              invariant flat_chunk: head_of(chunk) <= 0_u64
            ) {
              set chunk = place_back(vector: move chunk, value: 0_u8);
            }
            let room = len_of(digits);
            let held = len_of(chunk);
            let payload = fixed_vector::<u8, 8>();
            for @fill_payload (
              position in 0_u64..8_u64,
              invariant grown_payload: len_of(payload) >= position,
              invariant spare_payload: room_of(payload) + position >= 8_u64,
              invariant flat_payload: head_of(payload) <= 0_u64
            ) {
              let letter = 65_u8;
              let step = cvt::<u64, u8>(position);
              match step {
                Ok(value: offset) => {
                  set letter = 65_u8 +wrap offset;
                }
                Err(error: problem) => {
                }
              }
              set payload = place_back(vector: move payload, value: letter);
            }
            let carried = 0_u64;
            let port = 0_u16;
            let arguments = 0_u64;
            region {
              set arguments = args_count(args: &args);
            }
            let named = arguments >= 2_u64;
            if named {
            } else {
              return exit_status(code: 1_u8);
            }
            region {
              match arg_get(args: &args, position: 1_u64) {
                Ok(value: text) => {
                  region 'v {
                    region {
                      let window = mut_slice_of(&uniq digits);
                      region {
                        match host_copy_utf8(value: &'v text, destination: &uniq window, start: 0_u64, end: room) {
                          Ok(value: written) => {
                            set carried = written;
                          }
                          Err(error: problem) => {
                            set carried = 0_u64;
                          }
                        }
                      }
                    }
                  }
                }
                Err(error: problem) => {
                  set carried = 0_u64;
                }
              }
            }
            if carried == 0_u64 {
              return exit_status(code: 2_u8);
            }
            region {
              let named_port = slice_of(&digits);
              region {
                set port = parse_port(digits: &named_port, length: carried);
              }
            }
            let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
            let outcome = 0_u8;
            region {
              match reserve_handle(factory: &uniq handles) {
                Ok(value: permit) => {
                  region {
                    match tcp_connect(permit: move permit, address: &address) {
                      Connected(connection: link) => {
                        let refused = 0_u8;
                        region {
                          let greeting = slice_of(&payload);
                          region {
                            match send_all(send: &uniq link.send, source: &greeting, length: 8_u64) {
                              Ok(value: delivered) => {
                              }
                              Err(error: problem) => {
                                set refused = 5_u8;
                              }
                            }
                          }
                        }
                        if refused == 0_u8 {
                          loop @chunks {
                            let available = 0_u64;
                            let ended = 0_u8;
                            region {
                              let sink = mut_slice_of(&uniq chunk);
                              region {
                                match receive_next(receive: &uniq link.receive, destination: &uniq sink, start: 0_u64, end: held) {
                                  ReadBytes(next: endpoint) => {
                                    set available = endpoint;
                                  }
                                  ReadEnd() => {
                                    set ended = 1_u8;
                                  }
                                  ReadFailed(error: problem) => {
                                    set outcome = 6_u8;
                                    set ended = 2_u8;
                                  }
                                }
                              }
                            }
                            if ended == 0_u8 {
                              region {
                                let returned = slice_of(&chunk);
                                region {
                                  match publish_all(output: &uniq out, source: &returned, length: available) {
                                    Ok(value: published) => {
                                    }
                                    Err(error: problem) => {
                                      set outcome = 7_u8;
                                      set ended = 2_u8;
                                    }
                                  }
                                }
                              }
                            }
                            if ended == 0_u8 {
                            } else {
                              break @chunks;
                            }
                          }
                        } else {
                          set outcome = refused;
                        }
                        let credit = close_connection(connection: move link);
                      }
                      ConnectFailed(error: problem, permit: handed_back) => {
                        set outcome = 8_u8;
                      }
                    }
                  }
                }
                Err(error: problem) => {
                  set outcome = 9_u8;
                }
              }
            }
            return exit_status(code: outcome);
          }
        }
      }
    }
  }
}
