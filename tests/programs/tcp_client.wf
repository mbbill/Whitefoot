fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn byte_at(store: &Slice<u8>, index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the view does not hold.";
  let room = len_of(deref(store));
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn parse_port(digits: &Slice<u8>, length: own u64) -> result: own u16 reads(digits) {
  doc "Reads one decimal port out of the argument bytes the invocation supplied; a byte that is not a digit ends the number.";
  let port = 0_u16;
  let ended = 0_u8;
  let index = 0_u64;
  loop @scan {
    let more = index < length;
    if more {
    } else {
      break @scan;
    }
    let byte = byte_at(store: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
      let value = byte -wrap 48_u8;
      let widened = cvt::<u8, u16>(value);
      let scaled = port *wrap 10_u16;
      set port = scaled +wrap widened;
    } else {
      set ended = 1_u8;
    }
    if ended == 0_u8 {
      set index = index +wrap 1_u64;
    } else {
      break @scan;
    }
  }
  return port;
}

fn send_all(send: &uniq TcpSend, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(send, source), writes(send) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Sends one prefix of the source view, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    region {
      match send_once(send: &uniq deref(send), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_all(factory: &uniq HandleFactory, output: &uniq OutputStream, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(factory, output, source), writes(factory, output) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source view, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(factory: &uniq deref(factory), output: &uniq deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "Connects to the loopback port named by the invocation, sends eight bytes through the connection's sending direction, and publishes every byte the peer returns through its receiving direction until the peer stops sending [SYS-17, SYS-18]. The argument scratch and the receive chunk are store-resident runs viewed exclusively where they are written and shared where they are read; the eight-byte payload is an inline run whose shared view is all the send needs.";
  let Inputs(args: args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: handles, stdin: unused_stdin) = move inputs;
  region {
    close_directory(factory: &uniq handles, directory: move unused_cwd);
  }
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 16_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh_digits) => {
        let digits = move fresh_digits;
        for @fill_digits (
          at in 0_u64..16_u64,
          invariant grown_digits: len_of(digits) >= at,
          invariant spare_digits: room_of(digits) + at >= 16_u64,
          invariant flat_digits: head_of(digits) <= 0_u64
        ) {
          place_back(vector: &uniq digits, value: 0_u8);
        }
        match heap_vector::<u8>(store: &uniq heap, count: 4096_u64) {
          None() => {
            return exit_status(code: 70_u8);
          }
          Some(value: fresh_chunk) => {
            let chunk = move fresh_chunk;
            for @fill_chunk (
              at in 0_u64..4096_u64,
              invariant grown_chunk: len_of(chunk) >= at,
              invariant spare_chunk: room_of(chunk) + at >= 4096_u64,
              invariant flat_chunk: head_of(chunk) <= 0_u64
            ) {
              place_back(vector: &uniq chunk, value: 0_u8);
            }
            let room = len_of(digits);
            let held = len_of(chunk);
            let payload = fixed_vector::<u8, 8>();
            for @fill_payload (
              position in 0_u64..8_u64,
              invariant grown_payload: len_of(payload) >= position,
              invariant spare_payload: room_of(payload) + position >= 8_u64,
              invariant flat_payload: head_of(payload) <= 0_u64
            ) {
              let letter = 65_u8;
              let step = cvt::<u64, u8>(position);
              match step {
                Ok(value: offset) => {
                  set letter = 65_u8 +wrap offset;
                }
                Err(error: problem) => {
                }
              }
              place_back(vector: &uniq payload, value: letter);
            }
            let carried = 0_u64;
            let port = 0_u16;
            let arguments = 0_u64;
            region {
              set arguments = args_count(args: &args);
            }
            let named = arguments >= 2_u64;
            if named {
            } else {
              return exit_status(code: 1_u8);
            }
            region {
              match arg_get(args: &args, position: 1_u64) {
                Ok(value: text) => {
                  region {
                    region {
                      let window = mut_slice_of(&uniq digits);
                      region {
                        match host_copy_utf8(value: &text, destination: &uniq window, start: 0_u64, end: room) {
                          Ok(value: written) => {
                            set carried = written;
                          }
                          Err(error: problem) => {
                            set carried = 0_u64;
                          }
                        }
                      }
                    }
                  }
                }
                Err(error: problem) => {
                  set carried = 0_u64;
                }
              }
            }
            if carried == 0_u64 {
              return exit_status(code: 2_u8);
            }
            region {
              let named_port = slice_of(&digits);
              region {
                set port = parse_port(digits: &named_port, length: carried);
              }
            }
            let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
            let outcome = 0_u8;
            region {
              region {
                match tcp_connect(factory: &uniq handles, address: &address) {
                  Connected(connection: link) => {
                    let refused = 0_u8;
                    region {
                      let greeting = slice_of(&payload);
                      region {
                        match send_all(send: &uniq link.send, source: &greeting, length: 8_u64) {
                          Ok(value: delivered) => {
                          }
                          Err(error: problem) => {
                            set refused = 5_u8;
                          }
                        }
                      }
                    }
                    if refused == 0_u8 {
                      loop @chunks {
                        let available = 0_u64;
                        let ended = 0_u8;
                        region {
                          let sink = mut_slice_of(&uniq chunk);
                          region {
                            match receive_next(receive: &uniq link.receive, destination: &uniq sink, start: 0_u64, end: held) {
                              Ok(value: endpoint) => {
                                set available = endpoint;
                              }
                              Err(error: read_stop_3) => {
                                match read_stop_3 {
                                  ReadEnd() => {
                                    set ended = 1_u8;
                                  }
                                  ReadFailed(error: problem) => {
                                    set outcome = 6_u8;
                                    set ended = 2_u8;
                                  }
                                }
                              }
                            }
                          }
                        }
                        if ended == 0_u8 {
                          region {
                            let returned = slice_of(&chunk);
                            region {
                              match publish_all(factory: &uniq handles, output: &uniq out, source: &returned, length: available) {
                                Ok(value: published) => {
                                }
                                Err(error: problem) => {
                                  set outcome = 7_u8;
                                  set ended = 2_u8;
                                }
                              }
                            }
                          }
                        }
                        if ended == 0_u8 {
                        } else {
                          break @chunks;
                        }
                      }
                    } else {
                      set outcome = refused;
                    }
                    let TcpConnection(receive: close_receive_4, send: close_send_4) = move link;
                    close_receive(factory: &uniq handles, receive: move close_receive_4);
                    close_send(factory: &uniq handles, send: move close_send_4);
                  }
                  ConnectFailed(error: problem) => {
                    region {
                      if factory_refusal(error: &problem) {
                        set outcome = 9_u8;
                      } else {
                        set outcome = 8_u8;
                      }
                    }
                  }
                }
              }
            }
            return exit_status(code: outcome);
          }
        }
      }
    }
  }
}
