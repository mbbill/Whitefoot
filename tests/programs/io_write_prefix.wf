fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "One frame-resident array of bytes is published twice through one range reference: an empty request and then a middle prefix, whose absolute accepted endpoint becomes the exit status.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let bytes = array_filled::<u8, 4>(value: 119_u8);
  set bytes[1_u64] = 120_u8;
  set bytes[2_u64] = 121_u8;
  set bytes[3_u64] = 122_u8;
  let window = &bytes[0_u64..4_u64];
  match write_once(factory: &entry_factory, output: &out, source: window, start: 0_u64, end: 0_u64) {
    Ok(value: written) => {
      if written == 0_u64 {
      } else {
        return exit_status(code: 210_u8);
      }
    }
    Err(error: problem) => {
      return exit_status(code: 211_u8);
    }
  }
  match write_once(factory: &entry_factory, output: &out, source: window, start: 1_u64, end: 3_u64) {
    Ok(value: written) => {
      let narrowed = cvt::<u64, u8>(written);
      match narrowed {
        Ok(value: code) => {
          return exit_status(code: code);
        }
        Err(error: overflowed) => {
          return exit_status(code: 200_u8);
        }
      }
    }
    Err(error: problem) => {
      return exit_status(code: 212_u8);
    }
  }
}
