fn append_slice(destination: &uniq MutSlice<u8>, capacity: own u64, filled: own u64, text: own Slice<u8>) -> result: own u64 reads(destination, text), writes(destination) contract {
  requires capacity == len_of(deref(destination));
  requires filled <= capacity;
  ensures result <= capacity;
} {
  doc "Appends as much of one static message as the destination still holds.";
  let spare = len_of(deref(destination));
  let admitted = filled <= spare;
  let length = len_of(text);
  if admitted {
    for @append (at in filled..spare) {
      let taken = at -wrap filled;
      let done = taken >= length;
      if done {
        return at;
      }
      let byte = text[taken];
      set deref(destination)[at] = byte;
    }
    return spare;
  } else {
    return filled;
  }
}

fn copy_range(destination: &uniq MutSlice<u8>, at: own u64, source: own Slice<u8>, from: own u64, to: own u64) -> result: own u64 reads(destination, source), writes(destination) {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = len_of(source);
  let destination_room = len_of(deref(destination));
  let target = at;
  let cursor = from;
  loop @copy {
    let done = cursor >= to;
    if done {
      break @copy;
    }
    let read_ok = cursor < source_room;
    if read_ok {
    } else {
      return target;
    }
    let byte = source[cursor];
    let write_ok = target < destination_room;
    if write_ok {
    } else {
      return target;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  return target;
}

fn inflate_status(error: own InflateError) -> result: own u8 pure {
  doc "Reduces one decode failure to the status the driver reports for it: 5 an early end of stream, 6 a malformed stream, 7 an output buffer too small.";
  match error {
    Truncated() => {
      return 5_u8;
    }
    InvalidStoredLength() => {
      return 6_u8;
    }
    InvalidHuffmanTree() => {
      return 6_u8;
    }
    InvalidHuffmanCode() => {
      return 6_u8;
    }
    InvalidDistance() => {
      return 6_u8;
    }
    InvalidBlockType() => {
      return 6_u8;
    }
    OutputFull() => {
      return 7_u8;
    }
  }
}

fn publish_all(factory: &uniq HandleFactory, output: &uniq OutputStream, source: own Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(factory, output, source), writes(factory, output) contract {
  define source_length = len_of(source);
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source buffer, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(factory: &uniq deref(factory), output: &uniq deref(output), source: &source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn assemble_reason(report: own MutSlice<u8>, capacity: own u64, reason: own u8) -> result: own u64 reads(report), writes(report) contract {
  requires capacity == len_of(report);
  ensures result <= capacity;
} {
  doc "Assembles the static diagnostic that names one boundary outcome and hands its length back; the caller publishes it, because a helper handed a view cannot form the shared child a write_once source needs [VIEW-2].";
  let length = 0_u64;
  let report_capacity = capacity;
  if reason == 1_u8 {
    region {
      let view = slice_of(&usage_text);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 2_u8 {
    region {
      let view = slice_of(&reason_unreadable);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 3_u8 {
    region {
      let view = slice_of(&reason_empty);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 4_u8 {
    region {
      let view = slice_of(&reason_too_large);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 5_u8 {
    region {
      let view = slice_of(&reason_truncated);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 6_u8 {
    region {
      let view = slice_of(&reason_malformed);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 7_u8 {
    region {
      let view = slice_of(&reason_output_full);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 8_u8 {
    region {
      let view = slice_of(&reason_write_failed);
      region {
        set length = append_slice(destination: &uniq report, capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  return length;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &uniq OutputStream, err: &uniq OutputStream, files: &uniq HandleFactory) -> status: own ExitStatus reads(args, cwd, out, err, files), writes(out, err, files) {
  doc "Reads one raw DEFLATE file named on the command line through ordinary read_at calls; every boundary outcome reaches its own status.";
  region 'workspace {
    let workspace = arena_frame::<131072, 1, 'workspace>();
    region {
      let scratch = arena_vector_proved::<u8>(store: &uniq workspace, count: 4097_u64);
      for @reserve_scratch (
        at in 0_u64..4097_u64,
        invariant grown: len_of(scratch) >= at,
        invariant spare: room_of(scratch) + at >= 4097_u64,
        invariant flat: head_of(scratch) <= 0_u64
      ) {
        place_back(vector: &uniq scratch, value: 0_u8);
      }
      let report = arena_vector_proved::<u8>(store: &uniq workspace, count: 128_u64);
      for @reserve_report (
        at in 0_u64..128_u64,
        invariant grown: len_of(report) >= at,
        invariant spare: room_of(report) + at >= 128_u64,
        invariant flat: head_of(report) <= 0_u64
      ) {
        place_back(vector: &uniq report, value: 0_u8);
      }
      let report_room = len_of(report);
      let arguments = 0_u64;
      region {
        set arguments = args_count(args: args);
      }
      let named = arguments >= 2_u64;
      if named {
      } else {
        region {
          let report_window = mut_slice_of(&uniq report);
          let assembled = assemble_reason(report: move report_window, capacity: report_room, reason: 1_u8);
          let publish_view = slice_of(&report);
          region {
            match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: publish_view, length: assembled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
              }
            }
          }
        }
        return exit_status(code: 1_u8);
      }
      let status = 0_u8;
      let filled = 0_u64;
      let file_offset = 0_u64;
      region {
        match arg_get(args: args, position: 1_u64) {
          Ok(value: text) => {
            match relative_path(value: move text) {
              Ok(value: path) => {
                region {
                  match open_read(factory: &uniq deref(files), root: cwd, path: &path) {
                    FileOpened(value: file) => {
                      let ended = 0_u8;
                      region {
                        let scratch_window = mut_slice_of(&uniq scratch);
                        loop @chunks {
                          let within_scratch = filled <= 4097_u64;
                          if within_scratch {
                          } else {
                            set ended = 2_u8;
                            break @chunks;
                          }
                          let spare = 4097_u64 -wrap filled;
                          let full = spare == 0_u64;
                          if full {
                            break @chunks;
                          }
                          region {
                            match read_at(factory: &uniq deref(files), file: &uniq file, destination: &uniq scratch_window, file_offset: file_offset, start: filled, end: 4097_u64) {
                              Ok(value: endpoint) => {
                                let received = endpoint -wrap filled;
                                set file_offset = file_offset +wrap received;
                                set filled = endpoint;
                              }
                              Err(error: read_stop_15) => {
                                match read_stop_15 {
                                  ReadEnd() => {
                                    set ended = 1_u8;
                                  }
                                  ReadFailed(error: problem) => {
                                    set ended = 2_u8;
                                  }
                                }
                              }
                            }
                          }
                          if ended != 0_u8 {
                            break @chunks;
                          }
                        }
                      }
                      if ended == 2_u8 {
                        set status = 2_u8;
                      }
                      close_read(factory: &uniq deref(files), file: move file);
                    }
                    FileOpenFailed(error: problem) => {
                      set status = 2_u8;
                    }
                  }
                }
              }
              Err(error: rejected) => {
                set status = 2_u8;
              }
            }
          }
          Err(error: absent) => {
            set status = 1_u8;
          }
        }
      }
      if status != 0_u8 {
        region {
          let report_window = mut_slice_of(&uniq report);
          let assembled = assemble_reason(report: move report_window, capacity: report_room, reason: status);
          let publish_view = slice_of(&report);
          region {
            match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: publish_view, length: assembled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
              }
            }
          }
        }
        return exit_status(code: status);
      }
      let empty = filled == 0_u64;
      if empty {
        region {
          let report_window = mut_slice_of(&uniq report);
          let assembled = assemble_reason(report: move report_window, capacity: report_room, reason: 3_u8);
          let publish_view = slice_of(&report);
          region {
            match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: publish_view, length: assembled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
              }
            }
          }
        }
        return exit_status(code: 3_u8);
      }
      let too_large = filled > 4096_u64;
      if too_large {
        region {
          let report_window = mut_slice_of(&uniq report);
          let assembled = assemble_reason(report: move report_window, capacity: report_room, reason: 4_u8);
          let publish_view = slice_of(&report);
          region {
            match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: publish_view, length: assembled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
              }
            }
          }
        }
        return exit_status(code: 4_u8);
      }
      let stream = arena_vector_proved::<u8>(store: &uniq workspace, count: 4096_u64);
      for @reserve_stream (
        at in 0_u64..filled,
        invariant made_lo: len_of(stream) >= at,
        invariant made_hi: len_of(stream) <= at,
        invariant spare_lo: room_of(stream) + at >= 4096_u64,
        invariant spare_hi: room_of(stream) + at <= 4096_u64,
        invariant flat: head_of(stream) <= 0_u64
      ) {
        place_back(vector: &uniq stream, value: 0_u8);
      }
      region {
        let scratch_view = slice_of(&scratch);
        let stream_window = mut_slice_of(&uniq stream);
        region {
          let copied = copy_range(destination: &uniq stream_window, at: 0_u64, source: scratch_view, from: 0_u64, to: filled);
        }
      }
      let decoded = arena_vector_proved::<u8>(store: &uniq workspace, count: 65536_u64);
      for @reserve_decoded (
        at in 0_u64..65536_u64,
        invariant grown: len_of(decoded) >= at,
        invariant spare: room_of(decoded) + at >= 65536_u64,
        invariant flat: head_of(decoded) <= 0_u64
      ) {
        place_back(vector: &uniq decoded, value: 0_u8);
      }
      let decoded_length = 0_u64;
      region {
        let stream_view = slice_of(&stream);
        let decoded_window = mut_slice_of(&uniq decoded);
        region {
          match inflate(out: &uniq decoded_window, input: stream_view) {
            Ok(value: produced) => {
              set decoded_length = produced;
            }
            Err(error: failure) => {
              set status = inflate_status(error: failure);
            }
          }
        }
      }
      if status != 0_u8 {
        region {
          let report_window = mut_slice_of(&uniq report);
          let assembled = assemble_reason(report: move report_window, capacity: report_room, reason: status);
          let publish_view = slice_of(&report);
          region {
            match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: publish_view, length: assembled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
              }
            }
          }
        }
        return exit_status(code: status);
      }
      let decoded_room = len_of(decoded);
      let decoded_fits = decoded_length <= decoded_room;
      if decoded_fits {
      } else {
        region {
          let report_window = mut_slice_of(&uniq report);
          let assembled = assemble_reason(report: move report_window, capacity: report_room, reason: 7_u8);
          let publish_view = slice_of(&report);
          region {
            match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: publish_view, length: assembled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
              }
            }
          }
        }
        return exit_status(code: 7_u8);
      }
      region {
        let decoded_view = slice_of(&decoded);
        region {
          match publish_all(factory: &uniq deref(files), output: &uniq deref(out), source: decoded_view, length: decoded_length) {
            Ok(value: published) => {
            }
            Err(error: problem) => {
              set status = 8_u8;
            }
          }
        }
      }
      if status != 0_u8 {
        region {
          let report_window = mut_slice_of(&uniq report);
          let assembled = assemble_reason(report: move report_window, capacity: report_room, reason: status);
          let publish_view = slice_of(&report);
          region {
            match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: publish_view, length: assembled) {
              Ok(value: published) => {
              }
              Err(error: problem) => {
              }
            }
          }
        }
        return exit_status(code: status);
      }
      return exit_status(code: 0_u8);
    }
  }
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, out: &uniq out, err: &uniq err, files: &uniq files);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
