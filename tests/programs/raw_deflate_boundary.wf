fn append_slice(destination: &uniq buffer<u8>, capacity: own u64, filled: own u64, text: own Slice<u8>) -> result: own u64 reads(destination, text), writes(destination) contract {
  requires capacity == len_of(deref(destination));
  requires filled <= capacity;
  ensures result <= capacity;
} {
  doc "Appends as much of one static message as the destination still holds.";
  let spare = len_of(deref(destination));
  let admitted = filled <= spare;
  let length = len_of(text);
  if admitted {
    for @append (at in filled..spare) {
      let taken = at -wrap filled;
      let done = taken >= length;
      if done {
        return at;
      }
      let byte = text[taken];
      set deref(destination)[at] = byte;
    }
    return spare;
  } else {
    return filled;
  }
}

fn copy_range(destination: &uniq buffer<u8>, at: own u64, source: &buffer<u8>, from: own u64, to: own u64) -> result: own u64 reads(destination, source), writes(destination) {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = len_of(deref(source));
  let destination_room = len_of(deref(destination));
  let target = at;
  let cursor = from;
  loop @copy {
    let done = cursor >= to;
    if done {
      break @copy;
    }
    let read_ok = cursor < source_room;
    if read_ok {
    } else {
      return target;
    }
    let byte = deref(source)[cursor];
    let write_ok = target < destination_room;
    if write_ok {
    } else {
      return target;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  return target;
}

fn inflate_status(error: own InflateError) -> result: own u8 pure {
  doc "Reduces one decode failure to the status the driver reports for it: 5 an early end of stream, 6 a malformed stream, 7 an output buffer too small.";
  match error {
    Truncated() => {
      return 5_u8;
    }
    InvalidStoredLength() => {
      return 6_u8;
    }
    InvalidHuffmanTree() => {
      return 6_u8;
    }
    InvalidHuffmanCode() => {
      return 6_u8;
    }
    InvalidDistance() => {
      return 6_u8;
    }
    InvalidBlockType() => {
      return 6_u8;
    }
    OutputFull() => {
      return 7_u8;
    }
  }
}

fn publish_all(output: &uniq Output, source: &buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source buffer, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(output: &uniq deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn publish_reason(err: &uniq Output, report: &uniq buffer<u8>, reason: own u8) -> result: own unit reads(err, report), writes(err, report) {
  doc "Publishes the static diagnostic that names one boundary outcome, selected by the status the outcome carries.";
  let length = 0_u64;
  let report_capacity = len_of(deref(report));
  if reason == 1_u8 {
    region {
      let view = slice_of(&usage_text);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 2_u8 {
    region {
      let view = slice_of(&reason_unreadable);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 3_u8 {
    region {
      let view = slice_of(&reason_empty);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 4_u8 {
    region {
      let view = slice_of(&reason_too_large);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 5_u8 {
    region {
      let view = slice_of(&reason_truncated);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 6_u8 {
    region {
      let view = slice_of(&reason_malformed);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 7_u8 {
    region {
      let view = slice_of(&reason_output_full);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  if reason == 8_u8 {
    region {
      let view = slice_of(&reason_write_failed);
      region {
        set length = append_slice(destination: &uniq deref(report), capacity: report_capacity, filled: length, text: view);
      }
    }
  }
  region {
    match publish_all(output: &uniq deref(err), source: &deref(report), length: length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return unit;
}

command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.stderr as err: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, out, err, files), writes(cwd, out, err, files), allocates(heap) {
  doc "Reads one raw DEFLATE file named on the command line through the system read path; every boundary outcome reaches its own status.";
  let scratch = buffer_new(4097_u64, 0_u8);
  let report = buffer_new(128_u64, 0_u8);
  let arguments = 0_u64;
  region {
    set arguments = args_count(args: &args);
  }
  let named = arguments >= 2_u64;
  if named {
  } else {
    region {
      publish_reason(err: &uniq err, report: &uniq report, reason: 1_u8);
    }
    return exit_status(code: 1_u8);
  }
  let status = 0_u8;
  let filled = 0_u64;
  let file_offset = 0_u64;
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region {
              let permit = reserve_file(factory: &uniq files);
              match open_read(permit: move permit, root: &cwd, path: &path) {
                Ok(value: file) => {
                  let ended = 0_u8;
                  loop @chunks {
                    let within_scratch = filled <= 4097_u64;
                    if within_scratch {
                    } else {
                      set ended = 2_u8;
                      break @chunks;
                    }
                    let spare = 4097_u64 -wrap filled;
                    let full = spare == 0_u64;
                    if full {
                      break @chunks;
                    }
                    region {
                      match read_at(file: &file, destination: &uniq scratch, file_offset: file_offset, start: filled, end: 4097_u64) {
                        ReadBytes(next: endpoint) => {
                          let received = endpoint -wrap filled;
                          set file_offset = file_offset +wrap received;
                          set filled = endpoint;
                        }
                        ReadEnd() => {
                          set ended = 1_u8;
                        }
                        ReadFailed(error: problem) => {
                          set ended = 2_u8;
                        }
                      }
                    }
                    if ended != 0_u8 {
                      break @chunks;
                    }
                  }
                  if ended == 2_u8 {
                    set status = 2_u8;
                  }
                }
                Err(error: problem) => {
                  set status = 2_u8;
                }
              }
            }
          }
          Err(error: rejected) => {
            set status = 2_u8;
          }
        }
      }
      Err(error: absent) => {
        set status = 1_u8;
      }
    }
  }
  if status != 0_u8 {
    region {
      publish_reason(err: &uniq err, report: &uniq report, reason: status);
    }
    return exit_status(code: status);
  }
  let empty = filled == 0_u64;
  if empty {
    region {
      publish_reason(err: &uniq err, report: &uniq report, reason: 3_u8);
    }
    return exit_status(code: 3_u8);
  }
  let too_large = filled > 4096_u64;
  if too_large {
    region {
      publish_reason(err: &uniq err, report: &uniq report, reason: 4_u8);
    }
    return exit_status(code: 4_u8);
  }
  let stream = buffer_new(filled, 0_u8);
  region {
    let copied = copy_range(destination: &uniq stream, at: 0_u64, source: &scratch, from: 0_u64, to: filled);
  }
  let decoded = buffer_new(65536_u64, 0_u8);
  let decoded_length = 0_u64;
  region {
    match inflate(out: &uniq decoded, input: move stream) {
      Ok(value: produced) => {
        set decoded_length = produced;
      }
      Err(error: failure) => {
        set status = inflate_status(error: failure);
      }
    }
  }
  if status != 0_u8 {
    region {
      publish_reason(err: &uniq err, report: &uniq report, reason: status);
    }
    return exit_status(code: status);
  }
  let decoded_room = len_of(decoded);
  let decoded_fits = decoded_length <= decoded_room;
  if decoded_fits {
  } else {
    region {
      publish_reason(err: &uniq err, report: &uniq report, reason: 7_u8);
    }
    return exit_status(code: 7_u8);
  }
  region {
    match publish_all(output: &uniq out, source: &decoded, length: decoded_length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
        set status = 8_u8;
      }
    }
  }
  if status != 0_u8 {
    region {
      publish_reason(err: &uniq err, report: &uniq report, reason: status);
    }
    return exit_status(code: status);
  }
  return exit_status(code: 0_u8);
}
