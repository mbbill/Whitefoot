command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args), allocates(heap) {
  doc "Require one argument's complete target-native code-unit byte sequence to be the exact two bytes selected by the native target fixture, qualifying host_bytes_len and host_copy_bytes together [HOST-2, SYS-9].";
  let bytes = buffer_new(2_u64, 0_u8);
  region 'a {
    match arg_get::<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          let length = host_bytes_len::<'v>(value: &'v text);
          if length == 2_u64 {
          } else {
            return exit_status(code: 10_u8);
          }
          region 'd {
            match host_copy_bytes::<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, start: 0_u64, end: 2_u64) {
              Ok(value: next) => {
                if next == 2_u64 {
                } else {
                  return exit_status(code: 11_u8);
                }
              }
              Err(error: problem) => {
                return exit_status(code: 12_u8);
              }
            }
          }
        }
        let first = bytes[0_u64];
        let second = bytes[1_u64];
        if first == 65_u8 {
          if second == 66_u8 {
            return exit_status(code: 0_u8);
          }
        }
        return exit_status(code: 13_u8);
      }
      Err(error: absent) => {
        return exit_status(code: 14_u8);
      }
    }
  }
}
