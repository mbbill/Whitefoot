enum Chain {
  End();
  Link(value: u64, next: Box<Chain>);
}

fn drain(chain: own Box<Chain>, total: own u64) -> result: own u64 pure {
  doc "Consume a heap-linked sequence without retaining one stack frame per link. Taking inner releases the old cell; the marked transfer owns the next cell.";
  let node = move chain.inner;
  match move node {
    End() => {
      return total;
    }
    Link(value: item, next: rest) => {
      let sum = total +wrap item;
      return musttail drain(chain: move rest, total: sum);
    }
  }
}

fn main() -> status: own ExitStatus pure {
  let empty = End();
  let chain = box_new::<Chain>(value: move empty);
  for (i in 0_u64..100000_u64) {
    let node = Link(value: i, next: move chain);
    set chain = box_new::<Chain>(value: move node);
  }
  let total = drain(chain: move chain, total: 0_u64);
  if total == 4999950000_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
