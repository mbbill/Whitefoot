fn vacant<T, const n: u64>() -> result: own FixedVector<Option<T>, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding None.";
  let built = seq_fixed::<Option<T>, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    let empty = None<T>();
    set built = seq_place(vector: move built, value: move empty);
  }
  return move built;
}

fn filled<const n: u64>(value: own u8) -> result: own FixedVector<u8, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value.";
  let built = seq_fixed::<u8, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = seq_place(vector: move built, value: value);
  }
  return move built;
}

fn take_at<T, const n: u64>(vector: own FixedVector<T, n>, at: own u64) -> (rest: own FixedVector<T, n>, taken: own T) reads(vector), writes(vector) contract {
  requires at + 2_u64 <= len_of(vector);
  ensures len_of(rest) + 1_u64 == len_of(vector);
  ensures room_of(rest) == room_of(vector) + 1_u64;
  ensures head_of(rest) == head_of(vector);
} {
  doc "Removes the element at at, moving the last element into its place.";
  let (short, endv) = seq_take(vector: move vector);
  let old = replace short[at] = move endv;
  return move short, move old;
}

fn try_place<T, const n: u64>(vector: own FixedVector<T, n>, value: own T) -> (rest: own FixedVector<T, n>, unplaced: own Option<T>) reads(vector), writes(vector) contract {
  ensures head_of(rest) == head_of(vector);
  ensures len_of(rest) <= len_of(vector) + 1_u64;
  ensures len_of(rest) >= len_of(vector);
  ensures room_of(rest) <= room_of(vector);
  ensures room_of(rest) + 1_u64 >= room_of(vector);
} {
  doc "Appends one value, handing it back when the run is full.";
  let spare = room_of(vector);
  let fits = spare > 0_u64;
  if fits {
    set vector = seq_place(vector: move vector, value: move value);
    return move vector, None<T>();
  }
  return move vector, Some<T>(value: move value);
}

fn try_take<T, const n: u64>(vector: own FixedVector<T, n>) -> (rest: own FixedVector<T, n>, taken: own Option<T>) reads(vector), writes(vector) contract {
  ensures head_of(rest) == head_of(vector);
  ensures len_of(rest) <= len_of(vector);
  ensures len_of(rest) + 1_u64 >= len_of(vector);
  ensures room_of(rest) >= room_of(vector);
  ensures room_of(rest) <= room_of(vector) + 1_u64;
} {
  doc "Removes one value from the end, or reports that the run is empty.";
  let held = len_of(vector);
  let any = held > 0_u64;
  if any {
    let (shorter, one) = seq_take(vector: move vector);
    return move shorter, Some<T>(value: move one);
  }
  return move vector, None<T>();
}

fn rebase<const n: u64>(vector: own FixedVector<u8, n>, spare: own FixedVector<u8, n>) -> rebased: own FixedVector<u8, n> reads(vector, spare), writes(vector, spare) contract {
  requires len_of(spare) <= 0_u64;
  requires room_of(spare) >= n;
  requires room_of(spare) <= n;
  requires head_of(spare) <= 0_u64;
  ensures len_of(rebased) >= len_of(vector);
  ensures len_of(rebased) <= len_of(vector);
  ensures head_of(rebased) <= 0_u64;
} {
  doc "Moves every element of a wrapped run into a fresh run, in order, so the result does not wrap.";
  let count = len_of(vector);
  let one = 0_u8;
  let built = move spare;
  for @rot (
    at in 0_u64..count,
    invariant left: len_of(vector) + at >= count,
    invariant gone: len_of(vector) + at <= count,
    invariant made_lo: len_of(built) >= at,
    invariant made_hi: len_of(built) <= at,
    invariant spare_lo: room_of(built) + at >= n,
    invariant spare_hi: room_of(built) + at <= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set (vector, one) = seq_take_front(vector: move vector);
    set built = seq_place(vector: move built, value: one);
  }
  return move built;
}

command fn main() -> status: own ExitStatus pure {
  doc "Runs the six fixed-run library functions of the container design: the two constructions, the transposing removal, the two checked boundary forms, and the drain that returns a wrapped window to its origin.";
  let slots = vacant::<u8, 4>();
  let vacant_held = len_of(slots);
  if vacant_held == 4_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let bytes = filled::<4>(value: 7_u8);
  let filled_held = len_of(bytes);
  if filled_held == 4_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let first = bytes[0_u64];
  let last = bytes[3_u64];
  if first == 7_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  if last == 7_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let empty = seq_fixed::<Option<u8>, 4>();
  let a = Some<u8>(value: 1_u8);
  let one = seq_place(vector: move empty, value: move a);
  let b = Some<u8>(value: 2_u8);
  let two = seq_place(vector: move one, value: move b);
  let c = Some<u8>(value: 3_u8);
  let three = seq_place(vector: move two, value: move c);
  let (rest, pulled) = take_at::<Option<u8>, 4>(vector: move three, at: 0_u64);
  let rest_held = len_of(rest);
  if rest_held == 2_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  match pulled {
    Some(value: got) => {
      if got == 1_u8 {
      } else {
        return exit_status(code: 6_u8);
      }
    }
    None() => {
      return exit_status(code: 7_u8);
    }
  }
  let probe = None<u8>();
  let moved = replace rest[0_u64] = move probe;
  match moved {
    Some(value: at_front) => {
      if at_front == 3_u8 {
      } else {
        return exit_status(code: 8_u8);
      }
    }
    None() => {
      return exit_status(code: 9_u8);
    }
  }
  let hole = None<u8>();
  let (grown, unplaced) = try_place::<Option<u8>, 4>(vector: move rest, value: move hole);
  let grown_held = len_of(grown);
  if grown_held == 3_u64 {
  } else {
    return exit_status(code: 10_u8);
  }
  match unplaced {
    None() => {
    }
    Some(value: handed_back) => {
      return exit_status(code: 11_u8);
    }
  }
  let (shrunk, pulled_back) = try_take::<Option<u8>, 4>(vector: move grown);
  let shrunk_held = len_of(shrunk);
  if shrunk_held == 2_u64 {
  } else {
    return exit_status(code: 12_u8);
  }
  match pulled_back {
    Some(value: taken_back) => {
    }
    None() => {
      return exit_status(code: 13_u8);
    }
  }
  let start = seq_fixed::<u8, 4>();
  let s1 = seq_place(vector: move start, value: 11_u8);
  let s2 = seq_place(vector: move s1, value: 12_u8);
  let s3 = seq_place(vector: move s2, value: 13_u8);
  let (after_front, dropped) = seq_take_front(vector: move s3);
  let wrapped = seq_place(vector: move after_front, value: 14_u8);
  let fresh = seq_fixed::<u8, 4>();
  let flat = rebase::<4>(vector: move wrapped, spare: move fresh);
  let flat_held = len_of(flat);
  if flat_held == 3_u64 {
  } else {
    return exit_status(code: 14_u8);
  }
  let flat_head = head_of(flat);
  if flat_head == 0_u64 {
  } else {
    return exit_status(code: 15_u8);
  }
  let f0 = flat[0_u64];
  let f1 = flat[1_u64];
  let f2 = flat[2_u64];
  if f0 == 12_u8 {
  } else {
    return exit_status(code: 16_u8);
  }
  if f1 == 13_u8 {
  } else {
    return exit_status(code: 17_u8);
  }
  if f2 == 14_u8 {
  } else {
    return exit_status(code: 18_u8);
  }
  return exit_status(code: 0_u8);
}
