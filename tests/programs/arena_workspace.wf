command fn main() -> status: own ExitStatus pure {
  doc "Reserves one bump extent in this activation's frame, takes two runs of slots from it, fills one of them, reads the window back, and observes the refusal the extent gives a take it has no room for.";
  region 'a {
    let workspace = arena_frame::<256, 16, 'a>();
    let opened = room_of(workspace);
    if opened == 256_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
    region {
      let built = seq_arena_proved::<u64>(store: &uniq workspace, count: 8_u64);
      let taken = len_of(workspace);
      if taken == 64_u64 {
      } else {
        return exit_status(code: 2_u8);
      }
      let capacity = cap_of(built);
      if capacity == 8_u64 {
      } else {
        return exit_status(code: 3_u8);
      }
      for @fill (
        at in 0_u64..8_u64,
        invariant grown: len_of(built) >= at,
        invariant spare: room_of(built) + at >= 8_u64,
        invariant flat: head_of(built) <= 0_u64
      ) {
        set built = seq_place(vector: move built, value: at);
      }
      let held = len_of(built);
      if held == 8_u64 {
      } else {
        return exit_status(code: 4_u8);
      }
      let last = built[7_u64];
      if last == 7_u64 {
      } else {
        return exit_status(code: 5_u8);
      }
      let second = seq_arena::<u64>(store: &uniq workspace, count: 4_u64);
      match second {
        Some(value: scratch) => {
          let spare = room_of(scratch);
          if spare == 4_u64 {
          } else {
            return exit_status(code: 6_u8);
          }
          let one = seq_place(vector: move scratch, value: 99_u64);
          let front = one[0_u64];
          if front == 99_u64 {
          } else {
            return exit_status(code: 7_u8);
          }
        }
        None() => {
          return exit_status(code: 8_u8);
        }
      }
      let after = len_of(workspace);
      if after == 96_u64 {
      } else {
        return exit_status(code: 9_u8);
      }
      let refused = seq_arena::<u64>(store: &uniq workspace, count: 1024_u64);
      match refused {
        Some(value: impossible) => {
          return exit_status(code: 10_u8);
        }
        None() => {
        }
      }
      let unmoved = len_of(workspace);
      if unmoved == 96_u64 {
      } else {
        return exit_status(code: 11_u8);
      }
      let first = built[0_u64];
      if first == 0_u64 {
      } else {
        return exit_status(code: 12_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
