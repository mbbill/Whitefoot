fn check_fixed_match() -> result: own u8 pure {
  doc "A fixed block whose match repeats one byte fills the destination.";
  region 'fixed_match {
    let workspace = arena_frame::<16, 1, 'fixed_match>();
    region {
      let fixed_match_output = arena_vector_proved::<u8>(store: &uniq workspace, count: 16_u64);
      for @fill_fixed_match_output (
        at in 0_u64..16_u64,
        invariant grown: len_of(fixed_match_output) >= at,
        invariant spare: room_of(fixed_match_output) + at >= 16_u64,
        invariant flat: head_of(fixed_match_output) <= 0_u64
      ) {
        set fixed_match_output = place_back(vector: move fixed_match_output, value: 0_u8);
      }
      region {
        let fixed_match_view = slice_of(&fixed_match_input_bytes);
        let fixed_match_window = mut_slice_of(&uniq fixed_match_output);
        region {
          let fixed_match_result = inflate(out: &uniq fixed_match_window, input: fixed_match_view);
          match move fixed_match_result {
            Ok(value: fixed_match_length) => {
              if fixed_match_length == 16_u64 {
              } else {
                return 1_u8;
              }
            }
            Err(error: fixed_match_error) => {
              if False() {
              } else {
                return 1_u8;
              }
            }
          }
        }
      }
      let fixed_match_output_room = len_of(fixed_match_output);
      if fixed_match_output_room == 16_u64 {
      } else {
        return 1_u8;
      }
      let fixed_match_index = 0_u64;
      loop @check_fixed_match {
        let fixed_match_done = fixed_match_index == 16_u64;
        if fixed_match_done {
          break @check_fixed_match;
        } else {
          let fixed_match_room = len_of(fixed_match_output);
          let fixed_match_ok = fixed_match_index < fixed_match_room;
          if fixed_match_ok {
          } else {
            return 1_u8;
          }
          let fixed_match_byte = fixed_match_output[fixed_match_index];
          if fixed_match_byte == 97_u8 {
          } else {
            return 1_u8;
          }
          set fixed_match_index = fixed_match_index +wrap 1_u64;
        }
      }
    }
  }
  return 0_u8;
}

fn check_fixed_phrase() -> result: own u8 pure {
  doc "A fixed block whose match repeats a phrase decodes to the recorded bytes.";
  region 'fixed_phrase {
    let workspace = arena_frame::<17, 1, 'fixed_phrase>();
    region {
      let fixed_phrase_output = arena_vector_proved::<u8>(store: &uniq workspace, count: 17_u64);
      for @fill_fixed_phrase_output (
        at in 0_u64..17_u64,
        invariant grown: len_of(fixed_phrase_output) >= at,
        invariant spare: room_of(fixed_phrase_output) + at >= 17_u64,
        invariant flat: head_of(fixed_phrase_output) <= 0_u64
      ) {
        set fixed_phrase_output = place_back(vector: move fixed_phrase_output, value: 0_u8);
      }
      region {
        let fixed_phrase_view = slice_of(&fixed_phrase_input_bytes);
        let fixed_phrase_window = mut_slice_of(&uniq fixed_phrase_output);
        region {
          let fixed_phrase_result = inflate(out: &uniq fixed_phrase_window, input: fixed_phrase_view);
          match move fixed_phrase_result {
            Ok(value: fixed_phrase_length) => {
              if fixed_phrase_length == 17_u64 {
              } else {
                return 1_u8;
              }
            }
            Err(error: fixed_phrase_error) => {
              if False() {
              } else {
                return 1_u8;
              }
            }
          }
        }
      }
      let fixed_phrase_output_room = len_of(fixed_phrase_output);
      if fixed_phrase_output_room == 17_u64 {
      } else {
        return 1_u8;
      }
      let fixed_phrase_index = 0_u64;
      loop @check_fixed_phrase {
        let fixed_phrase_done = fixed_phrase_index == 17_u64;
        if fixed_phrase_done {
          break @check_fixed_phrase;
        } else {
          let fixed_phrase_room = len_of(fixed_phrase_output);
          let fixed_phrase_out_ok = fixed_phrase_index < fixed_phrase_room;
          if fixed_phrase_out_ok {
          } else {
            return 1_u8;
          }
          let fixed_phrase_actual = fixed_phrase_output[fixed_phrase_index];
          let fixed_phrase_wanted = fixed_phrase_expected[fixed_phrase_index];
          if fixed_phrase_actual == fixed_phrase_wanted {
          } else {
            return 1_u8;
          }
          set fixed_phrase_index = fixed_phrase_index +wrap 1_u64;
        }
      }
    }
  }
