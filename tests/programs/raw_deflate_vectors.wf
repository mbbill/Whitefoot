fn check_dynamic() -> result: own u8 pure {
  doc "A dynamic block decodes to the recorded hundred bytes.";
  region 'dynamic {
    let workspace = arena_frame::<100, 1, 'dynamic>();
    region {
      let dynamic_output = arena_vector_proved::<u8>(store: &uniq workspace, count: 100_u64);
      for @fill_dynamic_output (
        at in 0_u64..100_u64,
        invariant grown: len_of(dynamic_output) >= at,
        invariant spare: room_of(dynamic_output) + at >= 100_u64,
        invariant flat: head_of(dynamic_output) <= 0_u64
      ) {
        set dynamic_output = place_back(vector: move dynamic_output, value: 0_u8);
      }
      region {
        let dynamic_view = slice_of(&dynamic_input_bytes);
        let dynamic_window = mut_slice_of(&uniq dynamic_output);
        region {
          let dynamic_result = inflate(out: &uniq dynamic_window, input: dynamic_view);
          match move dynamic_result {
            Ok(value: dynamic_length) => {
              if dynamic_length == 100_u64 {
              } else {
                return 1_u8;
              }
            }
            Err(error: dynamic_error) => {
              if False() {
              } else {
                return 1_u8;
              }
            }
          }
        }
      }
      let dynamic_output_room = len_of(dynamic_output);
      if dynamic_output_room == 100_u64 {
      } else {
        return 1_u8;
      }
      let dynamic_output_index = 0_u64;
      loop @check_dynamic_output {
        let dynamic_output_done = dynamic_output_index == 100_u64;
        if dynamic_output_done {
          break @check_dynamic_output;
        } else {
          let dynamic_room = len_of(dynamic_output);
          let dynamic_out_ok = dynamic_output_index < dynamic_room;
          if dynamic_out_ok {
          } else {
            return 1_u8;
          }
          let dynamic_actual = dynamic_output[dynamic_output_index];
          let dynamic_wanted = dynamic_expected_bytes[dynamic_output_index];
          if dynamic_actual == dynamic_wanted {
          } else {
            return 1_u8;
          }
          set dynamic_output_index = dynamic_output_index +wrap 1_u64;
        }
      }
    }
  }
  return 0_u8;
}

