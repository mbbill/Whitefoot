fn error_code(error: own InflateError) -> result: own u8 pure {
  match error {
    Truncated() => {
      return 1_u8;
    }
    InvalidStoredLength() => {
      return 2_u8;
    }
    InvalidHuffmanTree() => {
      return 3_u8;
    }
    InvalidHuffmanCode() => {
      return 4_u8;
