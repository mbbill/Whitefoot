fn error_code(error: own InflateError) -> result: own u8 pure {
  match error {
    Truncated() => {
      return 1_u8;
    }
    InvalidStoredLength() => {
      return 2_u8;
    }
    InvalidHuffmanTree() => {
      return 3_u8;
    }
    InvalidHuffmanCode() => {
      return 4_u8;
    }
    InvalidDistance() => {
      return 5_u8;
    }
    InvalidBlockType() => {
      return 6_u8;
    }
    OutputFull() => {
      return 7_u8;
    }
  }
}

fn check_valid() -> result: own u8 pure {
  doc "Two stored blocks decode to their five bytes.";
  region 'valid {
    let workspace = arena_frame::<5, 1, 'valid>();
    region {
      let valid_output = arena_vector_proved::<u8>(store: &uniq workspace, count: 5_u64);
      for @fill_valid_output (
        at in 0_u64..5_u64,
        invariant grown: len_of(valid_output) >= at,
        invariant spare: room_of(valid_output) + at >= 5_u64,
        invariant flat: head_of(valid_output) <= 0_u64
      ) {
        set valid_output = place_back(vector: move valid_output, value: 0_u8);
      }
      region {
        let valid_view = slice_of(&valid_input_bytes);
        let valid_window = mut_slice_of(&uniq valid_output);
        region {
          let valid_result = inflate(out: &uniq valid_window, input: valid_view);
          match move valid_result {
            Ok(value: valid_length) => {
              if valid_length == 5_u64 {
              } else {
                return 1_u8;
              }
            }
            Err(error: valid_error) => {
              if False() {
              } else {
                return 1_u8;
              }
            }
          }
        }
      }
      let valid_output_room = len_of(valid_output);
      if valid_output_room == 5_u64 {
      } else {
        return 1_u8;
      }
      let valid_zero = valid_output[0_u64];
      let valid_one = valid_output[1_u64];
      let valid_two = valid_output[2_u64];
      let valid_three = valid_output[3_u64];
      let valid_four = valid_output[4_u64];
      if valid_zero == 104_u8 {
      } else {
        return 1_u8;
      }
      if valid_one == 101_u8 {
      } else {
        return 1_u8;
      }
      if valid_two == 108_u8 {
      } else {
        return 1_u8;
      }
      if valid_three == 108_u8 {
      } else {
        return 1_u8;
      }
      if valid_four == 111_u8 {
      } else {
        return 1_u8;
      }
    }
  }
  return 0_u8;
}

fn check_invalid_length() -> result: own u8 pure {
  doc "A stored block whose complement does not match the length is refused and publishes nothing.";
  region 'invalid_length {
    let workspace = arena_frame::<1, 1, 'invalid_length>();
    region {
      let invalid_length_output = arena_vector_proved::<u8>(store: &uniq workspace, count: 1_u64);
      for @fill_invalid_length_output (
        at in 0_u64..1_u64,
        invariant grown: len_of(invalid_length_output) >= at,
        invariant spare: room_of(invalid_length_output) + at >= 1_u64,
        invariant flat: head_of(invalid_length_output) <= 0_u64
      ) {
        set invalid_length_output = place_back(vector: move invalid_length_output, value: 9_u8);
      }
      region {
        let invalid_length_view = slice_of(&invalid_length_input_bytes);
        let invalid_length_window = mut_slice_of(&uniq invalid_length_output);
        region {
          let invalid_length_result = inflate(out: &uniq invalid_length_window, input: invalid_length_view);
          match move invalid_length_result {
            Ok(value: invalid_length_value) => {
              if False() {
              } else {
                return 1_u8;
              }
            }
            Err(error: invalid_length_error) => {
              match invalid_length_error {
                InvalidStoredLength() => {
                }
                Truncated() => {
                  if False() {
                  } else {
                    return 1_u8;
                  }
                }
                OutputFull() => {
                  if False() {
                  } else {
                    return 1_u8;
                  }
                }
                InvalidHuffmanCode() => {
                  if False() {
                  } else {
                    return 1_u8;
                  }
                }
                InvalidHuffmanTree() => {
                  if False() {
                  } else {
                    return 1_u8;
                  }
                }
                InvalidDistance() => {
                  if False() {
                  } else {
                    return 1_u8;
                  }
                }
                InvalidBlockType() => {
                  if False() {
                  } else {
                    return 1_u8;
                  }
                }
              }
            }
          }
        }
      }
      let invalid_length_output_room = len_of(invalid_length_output);
      if invalid_length_output_room == 1_u64 {
      } else {
        return 1_u8;
      }
      let invalid_length_sentinel = invalid_length_output[0_u64];
      if invalid_length_sentinel == 9_u8 {
      } else {
        return 1_u8;
      }
    }
  }
  return 0_u8;
}

