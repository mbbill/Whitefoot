fn store_dynamic_length(literal_lengths: &uniq MutSlice<u8>, distance_lengths: &uniq MutSlice<u8>, literal_count: own u64, position: own u64, value: own u8) -> result: own Result<unit, InflateError> reads(distance_lengths), writes(literal_lengths, distance_lengths) contract {
  define literal_room = len_of(deref(literal_lengths));
  define enough_literals = literal_count <= literal_room;
  requires enough_literals;
} {
  let is_literal = position < literal_count;
  if is_literal {
    set deref(literal_lengths)[position] = value;
  } else {
    let distance_index = position -wrap literal_count;
    let distance_room = len_of(deref(distance_lengths));
    let distance_ok = distance_index < distance_room;
    if distance_ok {
    } else {
      let error = InvalidHuffmanTree();
      return Err<unit, InflateError>(error: error);
    }
    set deref(distance_lengths)[distance_index] = value;
  }
  return Ok<unit, InflateError>(value: unit);
}

fn ordered_code_symbol(index: own u64) -> result: own Result<u64, InflateError> pure {
  let bounded = index % 19_u64;
  let unchanged = bounded == index;
  if unchanged {
  } else {
    let error = InvalidHuffmanTree();
    return Err<u64, InflateError>(error: error);
  }
  let order_ok = bounded < 19_u64;
  if order_ok {
  } else {
    let error = InvalidHuffmanTree();
    return Err<u64, InflateError>(error: error);
  }
  let ordered_symbol_byte = code_length_order[bounded];
  let ordered_symbol = cvt::<u8, u64>(ordered_symbol_byte);
  return Ok<u64, InflateError>(value: ordered_symbol);
}

fn read_dynamic_code_lengths(state: &uniq InflateState, input: &buffer<u8>, code_lengths: &uniq MutSlice<u8>, code_count: own u64) -> result: own Result<unit, InflateError> reads(state.input_offset, state.hold, state.bits, input, code_lengths), writes(state.input_offset, state.hold, state.bits, code_lengths) contract {
  define code_count_fits = code_count <= 19_u64;
  define code_room = len_of(deref(code_lengths));
  define order_fits = 19_u64 <= code_room;
  requires code_count_fits;
  requires order_fits;
} {
  let code_index = 0_u64;
  loop @read_code_lengths {
    let codes_done = code_index == code_count;
    if codes_done {
      break @read_code_lengths;
    } else {
      let ordered_symbol = 0_u64;
      match ordered_code_symbol(index: code_index) {
        Ok(value: symbol) => {
          set ordered_symbol = symbol;
        }
        Err(error: order_error) => {
          return Err<unit, InflateError>(error: order_error);
        }
      }
      let length_bits = 0_u64;
      region {
        match read_bits(state: &uniq deref(state), input: &deref(input), count: 3_u32, mask: 7_u64) {
          Ok(value: read_length) => {
            set length_bits = read_length;
          }
          Err(error: length_error) => {
            return Err<unit, InflateError>(error: length_error);
          }
        }
      }
      match cvt::<u64, u8>(length_bits) {
        Ok(value: length) => {
          let code_room = len_of(deref(code_lengths));
          let ordered_ok = ordered_symbol < code_room;
          if ordered_ok {
            set deref(code_lengths)[ordered_symbol] = length;
          } else {
            let error = InvalidHuffmanTree();
            return Err<unit, InflateError>(error: error);
          }
        }
        Err(error: conversion_error) => {
          let error = InvalidHuffmanTree();
          return Err<unit, InflateError>(error: error);
        }
      }
      set code_index = code_index +wrap 1_u64;
    }
  }
  return Ok<unit, InflateError>(value: unit);
}

fn decode_dynamic(state: &uniq InflateState, input: &buffer<u8>, out: &uniq buffer<u8>) -> result: own Result<unit, InflateError> reads(state.input_offset, state.output_offset, state.hold, state.bits, input, out), writes(state.input_offset, state.output_offset, state.hold, state.bits, out) {
  let literal_count_bits = 0_u64;
  region {
    match read_bits(state: &uniq deref(state), input: &deref(input), count: 5_u32, mask: 31_u64) {
      Ok(value: read_count) => {
        set literal_count_bits = read_count;
      }
      Err(error: count_error) => {
        return Err<unit, InflateError>(error: count_error);
      }
    }
  }
  let literal_count = literal_count_bits +wrap 257_u64;
  let too_many_literals = literal_count > 286_u64;
  if too_many_literals {
    let error = InvalidHuffmanTree();
    return Err<unit, InflateError>(error: error);
  }
  let distance_count_bits = 0_u64;
  region {
    match read_bits(state: &uniq deref(state), input: &deref(input), count: 5_u32, mask: 31_u64) {
      Ok(value: read_count) => {
        set distance_count_bits = read_count;
      }
      Err(error: count_error) => {
        return Err<unit, InflateError>(error: count_error);
      }
    }
  }
  let distance_count = distance_count_bits +wrap 1_u64;
  let code_count_bits = 0_u64;
  region {
    match read_bits(state: &uniq deref(state), input: &deref(input), count: 4_u32, mask: 15_u64) {
      Ok(value: read_count) => {
        set code_count_bits = read_count;
      }
      Err(error: count_error) => {
        return Err<unit, InflateError>(error: count_error);
      }
    }
  }
  let code_count = code_count_bits +wrap 4_u64;
  let code_count_fits = code_count <= 19_u64;
  if code_count_fits {
  } else {
    let error = InvalidHuffmanTree();
    return Err<unit, InflateError>(error: error);
  }
  let code_lengths = buffer_new(19_u64, 0_u8);
  region {
    let code_window = mut_slice_of(&uniq code_lengths);
    region {
      let filled = propagate read_dynamic_code_lengths(state: &uniq deref(state), input: &deref(input), code_lengths: &uniq code_window, code_count: code_count);
    }
  }
  let code_tree_allow_single = False();
  let code_tree_allow_empty = False();
  let code_table = propagate build_huffman_table(lengths: move code_lengths, symbol_count: 19_u64, max_bits: 7_u32, allow_single: code_tree_allow_single, allow_empty: code_tree_allow_empty);
  let literal_lengths = buffer_new(literal_count, 0_u8);
  let distance_lengths = buffer_new(distance_count, 0_u8);
  let total_lengths = literal_count +wrap distance_count;
  let position = 0_u64;
  let previous_length = 0_u8;
  region {
    let literal_window = mut_slice_of(&uniq literal_lengths);
    let distance_window = mut_slice_of(&uniq distance_lengths);
    loop @expand_lengths {
      let lengths_done = position == total_lengths;
      if lengths_done {
        break @expand_lengths;
      } else {
        let length_symbol = 0_u64;
        region {
          match decode_table_symbol(state: &uniq deref(state), input: &deref(input), table: &code_table) {
            Ok(value: decoded_symbol) => {
              set length_symbol = decoded_symbol;
            }
            Err(error: symbol_error) => {
              return Err<unit, InflateError>(error: symbol_error);
            }
          }
        }
        let direct_length = length_symbol <= 15_u64;
        if direct_length {
          match cvt::<u64, u8>(length_symbol) {
            Ok(value: length) => {
              region {
                let stored = propagate store_dynamic_length(literal_lengths: &uniq literal_window, distance_lengths: &uniq distance_window, literal_count: literal_count, position: position, value: length);
              }
              set previous_length = length;
              set position = position +wrap 1_u64;
            }
            Err(error: conversion_error) => {
              let error = InvalidHuffmanTree();
              return Err<unit, InflateError>(error: error);
            }
          }
        } else {
          let repeat_previous = length_symbol == 16_u64;
          if repeat_previous {
            let no_previous = position == 0_u64;
            if no_previous {
              let error = InvalidHuffmanTree();
              return Err<unit, InflateError>(error: error);
            }
            let repeat_bits = 0_u64;
            region {
              match read_bits(state: &uniq deref(state), input: &deref(input), count: 2_u32, mask: 3_u64) {
                Ok(value: read_repeat) => {
                  set repeat_bits = read_repeat;
                }
                Err(error: repeat_error) => {
                  return Err<unit, InflateError>(error: repeat_error);
                }
              }
            }
            let repeat_count = repeat_bits +wrap 3_u64;
            let remaining = total_lengths -wrap position;
            let overrun = repeat_count > remaining;
            if overrun {
              let error = InvalidHuffmanTree();
              return Err<unit, InflateError>(error: error);
            }
            let repeated = 0_u64;
            loop @repeat_previous_length {
              let repeated_all = repeated == repeat_count;
              if repeated_all {
                break @repeat_previous_length;
              } else {
                region {
                  let stored = propagate store_dynamic_length(literal_lengths: &uniq literal_window, distance_lengths: &uniq distance_window, literal_count: literal_count, position: position, value: previous_length);
                }
                set position = position +wrap 1_u64;
                set repeated = repeated +wrap 1_u64;
              }
            }
          } else {
            let short_zero = length_symbol == 17_u64;
            let repeat_bits = 0_u64;
            let repeat_base = 0_u64;
            if short_zero {
              region {
                match read_bits(state: &uniq deref(state), input: &deref(input), count: 3_u32, mask: 7_u64) {
                  Ok(value: read_repeat) => {
                    set repeat_bits = read_repeat;
                  }
                  Err(error: repeat_error) => {
                    return Err<unit, InflateError>(error: repeat_error);
                  }
                }
              }
              set repeat_base = 3_u64;
            } else {
              let long_zero = length_symbol == 18_u64;
              if long_zero {
              } else {
                let error = InvalidHuffmanTree();
                return Err<unit, InflateError>(error: error);
              }
              region {
                match read_bits(state: &uniq deref(state), input: &deref(input), count: 7_u32, mask: 127_u64) {
                  Ok(value: read_repeat) => {
                    set repeat_bits = read_repeat;
                  }
                  Err(error: repeat_error) => {
                    return Err<unit, InflateError>(error: repeat_error);
                  }
                }
              }
              set repeat_base = 11_u64;
            }
            let repeat_count = repeat_bits +wrap repeat_base;
            let remaining = total_lengths -wrap position;
            let overrun = repeat_count > remaining;
            if overrun {
              let error = InvalidHuffmanTree();
              return Err<unit, InflateError>(error: error);
            }
            let repeated = 0_u64;
            loop @repeat_zero_length {
              let repeated_all = repeated == repeat_count;
              if repeated_all {
                break @repeat_zero_length;
              } else {
                region {
                  let stored = propagate store_dynamic_length(literal_lengths: &uniq literal_window, distance_lengths: &uniq distance_window, literal_count: literal_count, position: position, value: 0_u8);
                }
                set position = position +wrap 1_u64;
                set repeated = repeated +wrap 1_u64;
              }
            }
            set previous_length = 0_u8;
          }
        }
      }
    }
  }
  let end_room = len_of(literal_lengths);
  let end_ok = 256_u64 < end_room;
  let end_length = literal_lengths[256_u64];
  let missing_end = end_length == 0_u8;
  if missing_end {
    let error = InvalidHuffmanTree();
    return Err<unit, InflateError>(error: error);
  }
  let literal_distance_allow_single = True();
  let literal_table = propagate build_huffman_table(lengths: move literal_lengths, symbol_count: literal_count, max_bits: 15_u32, allow_single: literal_distance_allow_single, allow_empty: code_tree_allow_empty);
  let distance_allow_empty = True();
  let distance_table = propagate build_huffman_table(lengths: move distance_lengths, symbol_count: distance_count, max_bits: 15_u32, allow_single: literal_distance_allow_single, allow_empty: distance_allow_empty);
  loop @dynamic_codes {
    let symbol = 0_u64;
    region {
      match decode_table_symbol(state: &uniq deref(state), input: &deref(input), table: &literal_table) {
        Ok(value: decoded_symbol) => {
          set symbol = decoded_symbol;
        }
        Err(error: symbol_error) => {
          return Err<unit, InflateError>(error: symbol_error);
        }
      }
    }
    let literal = symbol <= 255_u64;
    if literal {
      match cvt::<u64, u8>(symbol) {
        Ok(value: byte) => {
          region {
            match emit_byte(state: &uniq deref(state), out: &uniq deref(out), value: byte) {
              Ok(value: emitted) => {
              }
              Err(error: emit_error) => {
                return Err<unit, InflateError>(error: emit_error);
              }
            }
          }
        }
        Err(error: conversion_error) => {
          let error = InvalidHuffmanCode();
          return Err<unit, InflateError>(error: error);
        }
      }
    } else {
      let end_of_block = symbol == 256_u64;
      if end_of_block {
        break @dynamic_codes;
      } else {
        let copy_length = 0_u64;
        region {
          match decode_length(state: &uniq deref(state), input: &deref(input), symbol: symbol) {
            Ok(value: decoded_length) => {
              set copy_length = decoded_length;
            }
            Err(error: length_error) => {
              return Err<unit, InflateError>(error: length_error);
            }
          }
        }
        let distance_symbol = 0_u64;
        let distance_tree_empty = distance_table.used_symbols == 0_u64;
        if distance_tree_empty {
          let error = InvalidDistance();
          return Err<unit, InflateError>(error: error);
        }
        region {
          match decode_table_symbol(state: &uniq deref(state), input: &deref(input), table: &distance_table) {
            Ok(value: decoded_distance) => {
              set distance_symbol = decoded_distance;
            }
            Err(error: distance_error) => {
              return Err<unit, InflateError>(error: distance_error);
            }
          }
        }
        region {
          match copy_distance(state: &uniq deref(state), input: &deref(input), out: &uniq deref(out), copy_length: copy_length, distance_symbol: distance_symbol) {
            Ok(value: copied) => {
            }
            Err(error: copy_error) => {
              return Err<unit, InflateError>(error: copy_error);
            }
          }
        }
      }
    }
  }
  return Ok<unit, InflateError>(value: unit);
}
