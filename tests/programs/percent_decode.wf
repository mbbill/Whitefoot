fn decode(out: &uniq buffer<u8>, src: own buffer<u8>) -> result: own u64 reads(src), writes(out) contract {
  define output_length = len_of(deref(out));
  define source_length = len_of(src);
  define sufficient = output_length >= source_length;
  requires sufficient;
} {
  let source_length = len_of(src);
  let consumed_until = 0_u64;
  let output_index = 0_u64;
  for (
    input_index in 0_u64..source_length,
    invariant writes_behind_scan: output_index <= input_index
  ) {
    let already_consumed = input_index < consumed_until;
    if already_consumed {
    } else {
      let byte = src[input_index];
      let is_percent = byte == 37_u8;
      let next_index = input_index +wrap 1_u64;
      let last_index = input_index +wrap 2_u64;
      let high_in_source = next_index < source_length;
      let low_in_source = last_index < source_length;
      let has_pair = band(high_in_source, low_in_source);
      let candidate = band(is_percent, has_pair);
      if candidate {
        let high_byte = src[next_index];
        let low_byte = src[last_index];
        let high_decimal_low = high_byte >= 48_u8;
        let high_decimal_high = high_byte <= 57_u8;
        let high_decimal = band(high_decimal_low, high_decimal_high);
        let high_upper_low = high_byte >= 65_u8;
        let high_upper_high = high_byte <= 70_u8;
        let high_upper = band(high_upper_low, high_upper_high);
        let high_lower_low = high_byte >= 97_u8;
        let high_lower_high = high_byte <= 102_u8;
        let high_lower = band(high_lower_low, high_lower_high);
        let high_alphabetic = bor(high_upper, high_lower);
        let high_valid = bor(high_decimal, high_alphabetic);
        let low_decimal_low = low_byte >= 48_u8;
        let low_decimal_high = low_byte <= 57_u8;
        let low_decimal = band(low_decimal_low, low_decimal_high);
        let low_upper_low = low_byte >= 65_u8;
        let low_upper_high = low_byte <= 70_u8;
        let low_upper = band(low_upper_low, low_upper_high);
        let low_lower_low = low_byte >= 97_u8;
        let low_lower_high = low_byte <= 102_u8;
        let low_lower = band(low_lower_low, low_lower_high);
        let low_alphabetic = bor(low_upper, low_lower);
        let low_valid = bor(low_decimal, low_alphabetic);
        let valid = band(high_valid, low_valid);
        if valid {
          let high_is_decimal = high_byte <= 57_u8;
          let high = if high_is_decimal {
            let value = high_byte -wrap 48_u8;
            give value;
          } else {
            let high_is_upper = high_byte <= 70_u8;
            let value = if high_is_upper {
              let offset = high_byte -wrap 65_u8;
              give offset +wrap 10_u8;
            } else {
              let offset = high_byte -wrap 97_u8;
              give offset +wrap 10_u8;
            }
            give value;
          }
          let low_is_decimal = low_byte <= 57_u8;
          let low = if low_is_decimal {
            let value = low_byte -wrap 48_u8;
            give value;
          } else {
            let low_is_upper = low_byte <= 70_u8;
            let value = if low_is_upper {
              let offset = low_byte -wrap 65_u8;
              give offset +wrap 10_u8;
            } else {
              let offset = low_byte -wrap 97_u8;
              give offset +wrap 10_u8;
            }
            give value;
          }
          let shifted = high *wrap 16_u8;
          let decoded = shifted +wrap low;
          set deref(out)[output_index] = decoded;
          set consumed_until = last_index + 1_u64;
          set output_index = output_index + 1_u64;
        } else {
          set deref(out)[output_index] = byte;
          set consumed_until = input_index + 1_u64;
          set output_index = output_index + 1_u64;
        }
      } else {
        set deref(out)[output_index] = byte;
        set consumed_until = input_index + 1_u64;
        set output_index = output_index + 1_u64;
      }
    }
  }
  return output_index;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(11_u64, 0_u8);
  set input[0_u64] = 65_u8;
  set input[1_u64] = 37_u8;
  set input[2_u64] = 52_u8;
  set input[3_u64] = 50_u8;
  set input[4_u64] = 37_u8;
  set input[5_u64] = 52_u8;
  set input[6_u64] = 97_u8;
  set input[7_u64] = 37_u8;
  set input[8_u64] = 122_u8;
  set input[9_u64] = 122_u8;
  set input[10_u64] = 37_u8;
  let output = buffer_new(11_u64, 204_u8);
  region {
    let produced = decode(out: &uniq output, src: move input);
    if produced == 7_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  let output_zero = output[0_u64];
  let output_one = output[1_u64];
  let output_two = output[2_u64];
  let output_three = output[3_u64];
  let output_four = output[4_u64];
  let output_five = output[5_u64];
  let output_six = output[6_u64];
  let output_tail = output[7_u64];
  if output_zero == 65_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_one == 66_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_two == 74_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_three == 37_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_four == 122_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_five == 122_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_six == 37_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output_tail == 204_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
