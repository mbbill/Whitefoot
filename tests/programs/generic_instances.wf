fn maximum<T: Int>(left: own T, right: own T) -> result: own T pure {
  return imax(left, right);
}

fn preserve<const n: u64>(value: own array<u8, n>) -> result: own array<u8, n> pure {
  let size = len(value);
  return move value;
}

fn forward<const n: u64>(value: own array<u8, n>) -> result: own array<u8, n> pure {
  return preserve<n>(value: move value);
}

fn filled_array<T: Int, const n: u64>(value: own T) -> result: own array<T, n> pure {
  return array_new<T, n>(value);
}

fn filled_buffer<T: Int>(length: own u64, value: own T) -> result: own buffer<T> allocates(heap) contract {
  requires buffer_fits<T>(length);
  requires ile(length, 1152921504606846975_u64);
} {
  return buffer_new(length, value);
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let small_maximum = maximum<u8>(left: 4_u8, right: 9_u8);
  let signed_maximum = maximum<i64>(left: -7_i64, right: -2_i64);
  let short_input = array_new<u8, 2>(7_u8);
  let short = forward<2>(value: move short_input);
  let long_input = array_new<u8, 5>(11_u8);
  let long = forward<5>(value: move long_input);
  let short_value = short[1_u64];
  let long_value = long[4_u64];
  let typed_bytes = filled_array<u8, 2>(value: 13_u8);
  let typed_words = filled_array<i64, 3>(value: -17_i64);
  let typed_byte = typed_bytes[1_u64];
  let typed_word = typed_words[2_u64];
  let storage = filled_buffer<u16>(length: 2_u64, value: 19_u16);
  let storage_room = len(storage);
  let storage_ok = ilt(1_u64, storage_room);
  if storage_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let stored = storage[1_u64];
  if ieq(small_maximum, 9_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(signed_maximum, -2_i64) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(short_value, 7_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(long_value, 11_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(typed_byte, 13_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(typed_word, -17_i64) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(stored, 19_u16) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
