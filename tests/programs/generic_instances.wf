fn maximum<T: Int>(left: own T, right: own T) -> result: own T pure {
  return imax(left, right);
}

fn preserve<const n: u64>(value: own FixedVector<u8, n>) -> result: own FixedVector<u8, n> reads(value) {
  let size = len_of(value);
  return move value;
}

fn forward<const n: u64>(value: own FixedVector<u8, n>) -> result: own FixedVector<u8, n> reads(value) {
  return preserve::<n>(value: move value);
}

fn filled_array<T: Int, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure {
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

fn filled_buffer<T: Int>(store: &uniq Heap, length: own u64, value: own T) -> result: own Option<Vector<T>> reads(store), writes(store), allocates(store) contract {
  requires buffer_fits::<T>(length);
  requires length <= 1152921504606846975_u64;
} {
  region {
    match heap_vector::<T>(store: &uniq deref(store), count: length) {
      None() => {
        return None<Vector<T>>();
      }
      Some(value: fresh) => {
        let built = move fresh;
        for @fill (
          at in 0_u64..length,
          invariant grown: len_of(built) >= at,
          invariant spare: room_of(built) + at >= length,
          invariant flat: head_of(built) <= 0_u64
        ) {
          set built = place_back(vector: move built, value: value);
        }
        return Some<Vector<T>>(value: move built);
      }
    }
  }
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  let small_maximum = maximum::<u8>(left: 4_u8, right: 9_u8);
  let signed_maximum = maximum::<i64>(left: -7_i64, right: -2_i64);
  let short_input = fixed_vector::<u8, 2>();
  set short_input = place_back(vector: move short_input, value: 7_u8);
  set short_input = place_back(vector: move short_input, value: 7_u8);
  let short = forward::<2>(value: move short_input);
  let long_input = fixed_vector::<u8, 5>();
  set long_input = place_back(vector: move long_input, value: 11_u8);
  set long_input = place_back(vector: move long_input, value: 11_u8);
  set long_input = place_back(vector: move long_input, value: 11_u8);
  set long_input = place_back(vector: move long_input, value: 11_u8);
  set long_input = place_back(vector: move long_input, value: 11_u8);
  let long = forward::<5>(value: move long_input);
  let short_room = len_of(short);
  let short_ok = 1_u64 < short_room;
  if short_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let short_value = short[1_u64];
  let long_room = len_of(long);
  let long_ok = 4_u64 < long_room;
  if long_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let long_value = long[4_u64];
  let typed_bytes = filled_array::<u8, 2>(value: 13_u8);
  let typed_words = filled_array::<i64, 3>(value: -17_i64);
  let typed_bytes_room = len_of(typed_bytes);
  let typed_bytes_ok = 1_u64 < typed_bytes_room;
  if typed_bytes_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let typed_byte = typed_bytes[1_u64];
  let typed_words_room = len_of(typed_words);
  let typed_words_ok = 2_u64 < typed_words_room;
  if typed_words_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let typed_word = typed_words[2_u64];
  region {
    match filled_buffer::<u16>(store: &uniq heap, length: 2_u64, value: 19_u16) {
      None() => {
        return exit_status(code: 1_u8);
      }
      Some(value: storage) => {
        let storage_room = len_of(storage);
        let storage_ok = 1_u64 < storage_room;
        if storage_ok {
        } else {
          return exit_status(code: 1_u8);
        }
        let stored = storage[1_u64];
        if small_maximum == 9_u8 {
        } else {
          return exit_status(code: 1_u8);
        }
        if signed_maximum == -2_i64 {
        } else {
          return exit_status(code: 1_u8);
        }
        if short_value == 7_u8 {
        } else {
          return exit_status(code: 1_u8);
        }
        if long_value == 11_u8 {
        } else {
          return exit_status(code: 1_u8);
        }
        if typed_byte == 13_u8 {
        } else {
          return exit_status(code: 1_u8);
        }
        if typed_word == -17_i64 {
        } else {
          return exit_status(code: 1_u8);
        }
        if stored == 19_u16 {
        } else {
          return exit_status(code: 1_u8);
        }
        return exit_status(code: 0_u8);
      }
    }
  }
}
