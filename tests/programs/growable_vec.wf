const appended_bytes: FixedVector<u8, 5> =[33_u8, 33_u8, 33_u8, 33_u8, 33_u8];

enum Grown {
  Grew(value: Vector<u8>);
  Refused(value: Vector<u8>);
}

fn bs_new(heap: &uniq Heap) -> made: own Option<Vector<u8>> reads(heap), writes(heap), allocates(heap) {
  doc "Builds one empty byte string over a zero-length backing run.";
  region {
    return heap_vector::<u8>(store: &uniq deref(heap), count: 0_u64);
  }
}

fn bs_reserve(s: own Vector<u8>, heap: &uniq Heap, total: own u64) -> grown: own Grown reads(s, heap), writes(s, heap), allocates(heap) contract {
  requires total >= len_of(s);
} {
  doc "Grows the backing run to total slots, preserving element order, or reports that the store refused. Growth is the drain-front, append-back walk the growth policy fixes, and the superseded run is disposed before the new one is handed back, which is the difference between a peak of count + total slots and a peak of total. The four measures the policy publishes on the Grew arm are not written here: a variant-routed measure clause is a deferred contract route, so the caller reads them back instead.";
  let count = len_of(s);
  region {
    match heap_vector::<u8>(store: &uniq deref(heap), count: total) {
      None() => {
        return Refused(value: move s);
      }
      Some(value: fresh) => {
        let built = move fresh;
        for @move (
          at in 0_u64..count,
          invariant left: len_of(s) + at >= count,
          invariant gone: len_of(s) + at <= count,
          invariant made_lo: len_of(built) >= at,
          invariant made_hi: len_of(built) <= at,
          invariant spare_lo: room_of(built) + at >= total,
          invariant spare_hi: room_of(built) + at <= total,
          invariant flat: head_of(built) <= 0_u64
        ) {
          set (s, byte) = take_front(vector: move s);
          set built = place_back(vector: move built, value: byte);
        }
        dispose s;
        return Grew(value: move built);
      }
    }
  }
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "The growth policy exercised twice: one string grown to twenty-four slots and filled with twenty bytes, and one grown to eight and filled from a const run.";
  region {
    match bs_new(heap: &uniq heap) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let s = move fresh;
        let start_length = len_of(s);
        if 24_u64 >= start_length {
        } else {
          return exit_status(code: 1_u8);
        }
        region {
          match bs_reserve(s: move s, heap: &uniq heap, total: 24_u64) {
            Refused(value: refused) => {
              return exit_status(code: 71_u8);
            }
            Grew(value: ready) => {
              let grown = move ready;
              let opening = len_of(grown);
              let spare = room_of(grown);
              let flat = head_of(grown);
              if opening == 0_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              if spare >= 24_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              if flat == 0_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              let b = 7_u8;
              for @seed (
                at in 0_u64..20_u64,
                invariant grown_lo: len_of(grown) >= at,
                invariant grown_hi: len_of(grown) <= at,
                invariant spare_left: room_of(grown) + at >= 24_u64,
                invariant flat_run: head_of(grown) <= 0_u64
              ) {
                set grown = place_back(vector: move grown, value: b);
                set b = b +wrap 7_u8;
              }
              let total = len_of(grown);
              if total == 20_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              let cap_now = cap_of(grown);
              if cap_now == 24_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              if 3_u64 < total {
                let third = grown[3_u64];
                if third == 28_u8 {
                } else {
                  return exit_status(code: 1_u8);
                }
              } else {
                return exit_status(code: 1_u8);
              }
            }
          }
        }
      }
    }
  }
  region {
    match bs_new(heap: &uniq heap) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: second_fresh) => {
        let s = move second_fresh;
        let second_start_length = len_of(s);
        if 8_u64 >= second_start_length {
        } else {
          return exit_status(code: 1_u8);
        }
        region {
          match bs_reserve(s: move s, heap: &uniq heap, total: 8_u64) {
            Refused(value: second_refused) => {
              return exit_status(code: 71_u8);
            }
            Grew(value: second_ready) => {
              let held = move second_ready;
              let opening = len_of(held);
              let spare = room_of(held);
              let flat = head_of(held);
              if opening == 0_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              if spare >= 8_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              if flat == 0_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              set held = place_back(vector: move held, value: 65_u8);
              region {
                let source = slice_of(&appended_bytes);
                for @append (
                  at in 0_u64..5_u64,
                  invariant held_lo: len_of(held) >= at + 1_u64,
                  invariant held_hi: len_of(held) <= at + 1_u64,
                  invariant spare_left: room_of(held) + at + 1_u64 >= 8_u64,
                  invariant flat_run: head_of(held) <= 0_u64
                ) {
                  let byte = source[at];
                  set held = place_back(vector: move held, value: byte);
                }
              }
              let stored = len_of(held);
              if stored == 6_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              if 5_u64 < stored {
                let last = held[5_u64];
                if last == 33_u8 {
                } else {
                  return exit_status(code: 1_u8);
                }
                let front = held[0_u64];
                if front == 65_u8 {
                } else {
                  return exit_status(code: 1_u8);
                }
              } else {
                return exit_status(code: 1_u8);
              }
            }
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
