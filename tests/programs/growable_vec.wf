struct ByteVec {
  buf: buffer<u8>;
  fill: u64;
}

fn vec_new() -> result: own ByteVec allocates(heap) {
  let empty = buffer_new(0_u64, 0_u8);
  return ByteVec(buf: move empty, fill: 0_u64);
}

fn vec_push(v: &uniq ByteVec, x: own u8) -> result: own Result<unit, Overflow> reads(v.buf, v.fill), writes(v.buf, v.fill), allocates(heap) {
  let count = deref(v).fill;
  let limit = len(deref(v).buf);
  let full = count >= limit;
  if full {
    let growth_fits = limit <= 1000_u64;
    if growth_fits {
    } else {
      let overflow = Overflow();
      return Err<unit, Overflow>(error: overflow);
    }
    match limit +checked 8_u64 {
      Ok(value: ncap) => {
        let nbuf = buffer_new(ncap, x);
        if limit < ncap {
        } else {
          let overflow = Overflow();
          return Err<unit, Overflow>(error: overflow);
        }
        for @copy (i in 0_u64..limit) {
          let e = deref(v).buf[i];
          set nbuf[i] = e;
        }
        let old = replace deref(v).buf = move nbuf;
        let grown = propagate limit +checked 1_u64;
        set deref(v).fill = grown;
        return Ok<unit, Overflow>(value: unit);
      }
      Err(error: overflow) => {
        return Err<unit, Overflow>(error: overflow);
      }
    }
  }
  set deref(v).buf[count] = x;
  let bumped = propagate count +checked 1_u64;
  set deref(v).fill = bumped;
  return Ok<unit, Overflow>(value: unit);
}

fn bytes_append(dst: &uniq ByteVec, src: &buffer<u8>) -> result: own Result<unit, Overflow> reads(dst.buf, dst.fill, src), writes(dst.buf, dst.fill), allocates(heap) {
  let count = len(deref(src));
  for @append (i in 0_u64..count) {
    let byte = deref(src)[i];
    region {
      let pushed = propagate vec_push(v: &uniq deref(dst), x: byte);
    }
  }
  return Ok<unit, Overflow>(value: unit);
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let v = vec_new();
  let b = 7_u8;
  for @seed (i in 0_u64..20_u64) {
    region {
      match vec_push(v: &uniq v, x: b) {
        Ok(value: pushed) => {
        }
        Err(error: overflow) => {
          return exit_status(code: 1_u8);
        }
      }
    }
    set b = b +wrap 7_u8;
  }
  let total = v.fill;
  if total == 20_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let cap_now = len(v.buf);
  if cap_now == 24_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if 3_u64 < cap_now {
    let third = v.buf[3_u64];
    if third == 28_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  } else {
    return exit_status(code: 1_u8);
  }
  let s = vec_new();
  region {
    match vec_push(v: &uniq s, x: 65_u8) {
      Ok(value: pushed) => {
      }
      Err(error: overflow) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  let raw = buffer_new(5_u64, 33_u8);
  region {
    match bytes_append(dst: &uniq s, src: &raw) {
      Ok(value: appended) => {
      }
      Err(error: overflow) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  let stored = s.fill;
  if stored == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let scap = len(s.buf);
  if 5_u64 < scap {
    let last = s.buf[5_u64];
    if last == 33_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
    let front = s.buf[0_u64];
    if front == 65_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
