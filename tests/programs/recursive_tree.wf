enum Tree {
  Leaf();
  Branch(left: box<Tree>, right: box<Tree>);
}

fn boxed_leaf() -> result: own box<Tree> pure {
  let leaf = Leaf();
  return box_new(move leaf);
}

fn boxed_branch(left: own box<Tree>, right: own box<Tree>) -> result: own box<Tree> pure {
  let branch = Branch(left: move left, right: move right);
  return box_new(move branch);
}

fn count(tree: &box<Tree>) -> result: own Result<u64, Overflow> reads(tree) {
  match deref(deref(tree)) {
    Leaf() => {
      return Ok<u64, Overflow>(value: 1_u64);
    }
    Branch(left: l, right: r) => {
      let left_count = propagate count(tree: l);
      let right_count = propagate count(tree: r);
      let children = propagate left_count +checked right_count;
      return children +checked 1_u64;
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  let leaf0 = boxed_leaf();
  let leaf1 = boxed_leaf();
  let leaf2 = boxed_leaf();
  let leaf3 = boxed_leaf();
  let branch0 = boxed_branch(left: move leaf0, right: move leaf1);
  let branch1 = boxed_branch(left: move leaf2, right: move leaf3);
  let root = boxed_branch(left: move branch0, right: move branch1);
  region {
    match count(tree: &root) {
      Ok(value: nodes) => {
        if nodes == 7_u64 {
        } else {
          return exit_status(code: 1_u8);
        }
      }
      Err(error: overflow) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
