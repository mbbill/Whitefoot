command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own OutputStream, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(args, cwd, out, files), writes(cwd, out, files), allocates(heap) {
  doc "Reads two argument-named files through independent positioned operations and publishes their first bytes in argument order.";
  let data_a = buffer_new(1_u64, 0_u8);
  let data_b = buffer_new(1_u64, 0_u8);
  let pair = buffer_new(2_u64, 0_u8);
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text_a) => {
        match relative_path(value: move text_a) {
          Ok(value: path_a) => {
            region {
              match arg_get(args: &args, position: 2_u64) {
                Ok(value: text_b) => {
                  match relative_path(value: move text_b) {
                    Ok(value: path_b) => {
                      region {
                        match reserve_handle(factory: &uniq files) {
                          Ok(value: permit_a) => {
                            match reserve_handle(factory: &uniq files) {
                              Ok(value: permit_b) => {
                                let opened_a = open_read(permit: move permit_a, root: &cwd, path: &path_a);
                                let opened_b = open_read(permit: move permit_b, root: &cwd, path: &path_b);
                                match move opened_a {
                                  FileOpened(value: file_a) => {
                                    match move opened_b {
                                      FileOpened(value: file_b) => {
                                        region 'files {
                                          region {
                                            let read_a = read_at(file: &'files file_a, destination: &uniq data_a, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                            let read_b = read_at(file: &'files file_b, destination: &uniq data_b, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                            match move read_a {
                                              ReadBytes(next: next_a) => {
                                                if next_a == 1_u64 {
                                                } else {
                                                  return exit_status(code: 7_u8);
                                                }
                                              }
                                              ReadEnd() => {
                                                return exit_status(code: 8_u8);
                                              }
                                              ReadFailed(error: problem_a) => {
                                                return exit_status(code: 9_u8);
                                              }
                                            }
                                            match move read_b {
                                              ReadBytes(next: next_b) => {
                                                if next_b == 1_u64 {
                                                } else {
                                                  return exit_status(code: 10_u8);
                                                }
                                              }
                                              ReadEnd() => {
                                                return exit_status(code: 11_u8);
                                              }
                                              ReadFailed(error: problem_b) => {
                                                return exit_status(code: 12_u8);
                                              }
                                            }
                                          }
                                        }
                                        set pair[0_u64] = data_a[0_u64];
                                        set pair[1_u64] = data_b[0_u64];
                                        region {
                                          match write_once(output: &uniq out, source: &pair, start: 0_u64, end: 2_u64) {
                                            Ok(value: published) => {
                                              if published == 2_u64 {
                                                return exit_status(code: 0_u8);
                                              } else {
                                                return exit_status(code: 13_u8);
                                              }
                                            }
                                            Err(error: problem) => {
                                              return exit_status(code: 14_u8);
                                            }
                                          }
                                        }
                                      }
                                      FileOpenFailed(error: problem_b, permit: refused_b) => {
                                        return exit_status(code: 6_u8);
                                      }
                                    }
                                  }
                                  FileOpenFailed(error: problem_a, permit: refused_a) => {
                                    return exit_status(code: 5_u8);
                                  }
                                }
                              }
                              Err(error: spent) => {
                                return exit_status(code: 16_u8);
                              }
                            }
                          }
                          Err(error: spent) => {
                            return exit_status(code: 15_u8);
                          }
                        }
                      }
                    }
                    Err(error: rejected_b) => {
                      return exit_status(code: 4_u8);
                    }
                  }
                }
                Err(error: absent_b) => {
                  return exit_status(code: 3_u8);
                }
              }
            }
          }
          Err(error: rejected_a) => {
            return exit_status(code: 2_u8);
          }
        }
      }
      Err(error: absent_a) => {
        return exit_status(code: 1_u8);
      }
    }
  }
}
