fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn exercise['heap](args: &Args, cwd: &DirectoryRead, out: &uniq OutputStream, files: &uniq HandleFactory, heap: &uniq Heap<'heap>) -> status: own ExitStatus reads(args, cwd, out, files, heap), writes(out, files, heap), allocates(heap) {
  doc "Reads two argument-named files through independent positioned operations and publishes their first bytes in argument order.";
  region {
    match heap_vector::<u8>(store: &uniq deref(heap), count: 1_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh_data_a) => {
        let data_a = move fresh_data_a;
        for @fill_data_a (
          at in 0_u64..1_u64,
          invariant grown_data_a: len_of(data_a) >= at,
          invariant spare_data_a: room_of(data_a) + at >= 1_u64,
          invariant flat_data_a: head_of(data_a) <= 0_u64
        ) {
          place_back(vector: &uniq data_a, value: 0_u8);
        }
        match heap_vector::<u8>(store: &uniq deref(heap), count: 1_u64) {
          None() => {
            return exit_status(code: 70_u8);
          }
          Some(value: fresh_data_b) => {
            let data_b = move fresh_data_b;
            for @fill_data_b (
              at in 0_u64..1_u64,
              invariant grown_data_b: len_of(data_b) >= at,
              invariant spare_data_b: room_of(data_b) + at >= 1_u64,
              invariant flat_data_b: head_of(data_b) <= 0_u64
            ) {
              place_back(vector: &uniq data_b, value: 0_u8);
            }
            match heap_vector::<u8>(store: &uniq deref(heap), count: 2_u64) {
              None() => {
                return exit_status(code: 70_u8);
              }
              Some(value: fresh_pair) => {
                let pair = move fresh_pair;
                for @fill_pair (
                  at in 0_u64..2_u64,
                  invariant grown_pair: len_of(pair) >= at,
                  invariant spare_pair: room_of(pair) + at >= 2_u64,
                  invariant flat_pair: head_of(pair) <= 0_u64
                ) {
                  place_back(vector: &uniq pair, value: 0_u8);
                }
                region {
                  match arg_get(args: args, position: 1_u64) {
                    Ok(value: text_a) => {
                      match relative_path(value: move text_a) {
                        Ok(value: path_a) => {
                          region {
                            match arg_get(args: args, position: 2_u64) {
                              Ok(value: text_b) => {
                                match relative_path(value: move text_b) {
                                  Ok(value: path_b) => {
                                    region {
                                      let opened_a = open_read(factory: &uniq deref(files), root: cwd, path: &path_a);
                                      let opened_b = open_read(factory: &uniq deref(files), root: cwd, path: &path_b);
                                      match move opened_a {
                                        FileOpened(value: file_a) => {
                                          match move opened_b {
                                            FileOpened(value: file_b) => {
                                              region {
                                                region {
                                                  let view_a = mut_slice_of(&uniq data_a);
                                                  let view_b = mut_slice_of(&uniq data_b);
                                                  region {
                                                    let read_a = read_at(factory: &uniq deref(files), file: &uniq file_a, destination: &uniq view_a, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                                    let read_b = read_at(factory: &uniq deref(files), file: &uniq file_b, destination: &uniq view_b, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                                    match move read_a {
                                                      Ok(value: next_a) => {
                                                        if next_a == 1_u64 {
                                                        } else {
                                                          close_read(factory: &uniq deref(files), file: move file_b);
                                                          close_read(factory: &uniq deref(files), file: move file_a);
                                                          return exit_status(code: 7_u8);
                                                        }
                                                      }
                                                      Err(error: read_stop_5) => {
                                                        match read_stop_5 {
                                                          ReadEnd() => {
                                                            close_read(factory: &uniq deref(files), file: move file_b);
                                                            close_read(factory: &uniq deref(files), file: move file_a);
                                                            return exit_status(code: 8_u8);
                                                          }
                                                          ReadFailed(error: problem_a) => {
                                                            close_read(factory: &uniq deref(files), file: move file_b);
                                                            close_read(factory: &uniq deref(files), file: move file_a);
                                                            return exit_status(code: 9_u8);
                                                          }
                                                        }
                                                      }
                                                    }
                                                    match move read_b {
                                                      Ok(value: next_b) => {
                                                        if next_b == 1_u64 {
                                                        } else {
                                                          close_read(factory: &uniq deref(files), file: move file_b);
                                                          close_read(factory: &uniq deref(files), file: move file_a);
                                                          return exit_status(code: 10_u8);
                                                        }
                                                      }
                                                      Err(error: read_stop_6) => {
                                                        match read_stop_6 {
                                                          ReadEnd() => {
                                                            close_read(factory: &uniq deref(files), file: move file_b);
                                                            close_read(factory: &uniq deref(files), file: move file_a);
                                                            return exit_status(code: 11_u8);
                                                          }
                                                          ReadFailed(error: problem_b) => {
                                                            close_read(factory: &uniq deref(files), file: move file_b);
                                                            close_read(factory: &uniq deref(files), file: move file_a);
                                                            return exit_status(code: 12_u8);
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                              set pair[0_u64] = data_a[0_u64];
                                              set pair[1_u64] = data_b[0_u64];
                                              region {
                                                let payload = slice_of(&pair);
                                                region {
                                                  match write_once(factory: &uniq deref(files), output: &uniq deref(out), source: &payload, start: 0_u64, end: 2_u64) {
                                                    Ok(value: published) => {
                                                      if published == 2_u64 {
                                                        close_read(factory: &uniq deref(files), file: move file_b);
                                                        close_read(factory: &uniq deref(files), file: move file_a);
                                                        return exit_status(code: 0_u8);
                                                      } else {
                                                        close_read(factory: &uniq deref(files), file: move file_b);
                                                        close_read(factory: &uniq deref(files), file: move file_a);
                                                        return exit_status(code: 13_u8);
                                                      }
                                                    }
                                                    Err(error: problem) => {
                                                      close_read(factory: &uniq deref(files), file: move file_b);
                                                      close_read(factory: &uniq deref(files), file: move file_a);
                                                      return exit_status(code: 14_u8);
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            FileOpenFailed(error: problem_b) => {
                                              close_read(factory: &uniq deref(files), file: move file_a);
                                              region {
                                                if factory_refusal(error: &problem_b) {
                                                  return exit_status(code: 16_u8);
                                                }
                                              }
                                              return exit_status(code: 6_u8);
                                            }
                                          }
                                        }
                                        FileOpenFailed(error: problem_a) => {
                                          match move opened_b {
                                            FileOpened(value: file_b) => {
                                              close_read(factory: &uniq deref(files), file: move file_b);
                                            }
                                            FileOpenFailed(error: problem_b) => {
                                            }
                                          }
                                          region {
                                            if factory_refusal(error: &problem_a) {
                                              return exit_status(code: 15_u8);
                                            }
                                          }
                                          return exit_status(code: 5_u8);
                                        }
                                      }
                                    }
                                  }
                                  Err(error: rejected_b) => {
                                    return exit_status(code: 4_u8);
                                  }
                                }
                              }
                              Err(error: absent_b) => {
                                return exit_status(code: 3_u8);
                              }
                            }
                          }
                        }
                        Err(error: rejected_a) => {
                          return exit_status(code: 2_u8);
                        }
                      }
                    }
                    Err(error: absent_a) => {
                      return exit_status(code: 1_u8);
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, out: &uniq out, files: &uniq files, heap: &uniq heap);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
