command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, out, files), writes(cwd, out, files), allocates(heap) {
  doc "Reads one byte through four independent positioned operations. In the Windows test-only two-slot completion runtime, three eligible submissions force the third to return core-capacity status 2; every byte is then published in source order.";
  let published = buffer_new(4_u64, 0_u8);
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region {
              match reserve_file(factory: &uniq files) {
                Ok(value: permit) => {
                  match open_read(permit: move permit, root: &cwd, path: &path) {
                    FileOpened(value: file) => {
                      let bytes0 = buffer_new(1_u64, 0_u8);
                      let bytes1 = buffer_new(1_u64, 0_u8);
                      let bytes2 = buffer_new(1_u64, 0_u8);
                      let bytes3 = buffer_new(1_u64, 0_u8);
                      region 'file {
                        region {
                          let read0 = read_at(file: &'file file, destination: &uniq bytes0, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                          let read1 = read_at(file: &'file file, destination: &uniq bytes1, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                          let read2 = read_at(file: &'file file, destination: &uniq bytes2, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                          let read3 = read_at(file: &'file file, destination: &uniq bytes3, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                        }
                      }
                      set published[0_u64] = bytes0[0_u64];
                      set published[1_u64] = bytes1[0_u64];
                      set published[2_u64] = bytes2[0_u64];
                      set published[3_u64] = bytes3[0_u64];
                      region {
                        match write_once(output: &uniq out, source: &published, start: 0_u64, end: 4_u64) {
                          Ok(value: written) => {
                            if written == 4_u64 {
                              return exit_status(code: 0_u8);
                            } else {
                              return exit_status(code: 5_u8);
                            }
                          }
                          Err(error: problem) => {
                            return exit_status(code: 6_u8);
                          }
                        }
                      }
                    }
                    FileOpenFailed(error: problem, permit: refused) => {
                      return exit_status(code: 4_u8);
                    }
                  }
                }
                Err(error: spent) => {
                  return exit_status(code: 7_u8);
                }
              }
            }
          }
          Err(error: problem) => {
            return exit_status(code: 3_u8);
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 2_u8);
      }
    }
  }
}
