fn publish_all(factory: &uniq HandleFactory, output: &uniq OutputStream, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(factory, output, source), writes(factory, output) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source view, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(factory: &uniq deref(factory), output: &uniq deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "Reads the invocation's standard input to its end with read_next and publishes every byte it observed to standard output through ordinary prelude calls [PRE-1]. The chunk is a store-resident run: the read fills it through an exclusive view of it and the publish reads it back through a shared one, and the two views live in sibling regions because a run is viewed one way at a time [VIEW-2, OWN-5].";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: input) = move inputs;
  region {
    close_directory(factory: &uniq entry_factory, directory: move unused_cwd);
  }
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4096_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh_chunk) => {
        let chunk = move fresh_chunk;
        for @fill (
          at in 0_u64..4096_u64,
          invariant grown: len_of(chunk) >= at,
          invariant spare: room_of(chunk) + at >= 4096_u64,
          invariant flat: head_of(chunk) <= 0_u64
        ) {
          place_back(vector: &uniq chunk, value: 0_u8);
        }
        let held = len_of(chunk);
        let outcome = 0_u8;
        loop @chunks {
          let available = 0_u64;
          let ended = 0_u8;
          region {
            let sink = mut_slice_of(&uniq chunk);
            region {
              match read_next(factory: &uniq entry_factory, input: &uniq input, destination: &uniq sink, start: 0_u64, end: held) {
                Ok(value: endpoint) => {
                  set available = endpoint;
                }
                Err(error: read_stop_14) => {
                  match read_stop_14 {
                    ReadEnd() => {
                      set ended = 1_u8;
                    }
                    ReadFailed(error: problem) => {
                      set outcome = 3_u8;
                      set ended = 2_u8;
                    }
                  }
                }
              }
            }
          }
          if ended == 0_u8 {
            region {
              let payload = slice_of(&chunk);
              region {
                match publish_all(factory: &uniq entry_factory, output: &uniq out, source: &payload, length: available) {
                  Ok(value: published) => {
                  }
                  Err(error: problem) => {
                    set outcome = 4_u8;
                    set ended = 2_u8;
                  }
                }
              }
            }
          }
          if ended == 0_u8 {
          } else {
            break @chunks;
          }
        }
        return exit_status(code: outcome);
      }
    }
  }
}
