const ipv4_header: array<u8, 20> =[69_u8, 0_u8, 0_u8, 84_u8, 0_u8, 0_u8, 64_u8, 0_u8, 64_u8, 1_u8, 0_u8, 0_u8, 192_u8, 168_u8, 0_u8, 1_u8, 192_u8, 168_u8, 0_u8, 199_u8];

fn ipv4_checksum(header: own slice<u8>) -> result: own u16 reads(header) contract {
  define length = len(header);
  define odd = iand(length, 1_u64);
  requires odd == 0_u64;
} {
  let length = len(header);
  let sum = 0_u32;
  for (offset in 0_u64..length) {
    let byte = header[offset];
    let wide = cvt::<u8, u32>(byte);
    let parity = iand(offset, 1_u64);
    if parity == 0_u64 {
      let shifted = ishl.wrap(wide, 8_u32);
      set sum = sum +wrap shifted;
    } else {
      let combined = sum +wrap wide;
      let carry = ishr.wrap(combined, 16_u32);
      let low_sum = iand(combined, 65535_u32);
      set sum = low_sum +wrap carry;
    }
  }
  let inverted = inot(sum);
  let checksum_word = iand(inverted, 65535_u32);
  let narrowed = cvt::<u32, u16>(checksum_word);
  let checksum = match narrowed {
    Ok(value: checksum_value) => {
      give checksum_value;
    }
    Err(error: failure) => {
      give 0_u16;
    }
  }
  return checksum;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  region {
    let view = slice_of(&ipv4_header);
    let view_length = len(view);
    let view_odd = iand(view_length, 1_u64);
    if view_odd == 0_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
    let checksum = ipv4_checksum(header: move view);
    if checksum == 47248_u16 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  let runtime_header = buffer_new(20_u64, 0_u8);
  let offset = 0_u64;
  loop @copy_header {
    let done = offset == 20_u64;
    if done {
      break @copy_header;
    }
    let copy_ok = offset < 20_u64;
    if copy_ok {
    } else {
      return exit_status(code: 2_u8);
    }
    let byte = ipv4_header[offset];
    set runtime_header[offset] = byte;
    set offset = offset +wrap 1_u64;
  }
  region {
    let view = slice_of(&runtime_header);
    let view_length = len(view);
    let view_odd = iand(view_length, 1_u64);
    if view_odd == 0_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
    let checksum = ipv4_checksum(header: move view);
    if checksum == 47248_u16 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
