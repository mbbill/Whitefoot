const ipv4_header: array<u8, 20> =[69_u8, 0_u8, 0_u8, 84_u8, 0_u8, 0_u8, 64_u8, 0_u8, 64_u8, 1_u8, 0_u8, 0_u8, 192_u8, 168_u8, 0_u8, 1_u8, 192_u8, 168_u8, 0_u8, 199_u8];

fn ipv4_checksum['r](header: own slice<'r, u8>) -> own u16 reads('r), traps {
  let length = len(header);
  let odd = iand(length, 1_u64);
  check ieq(odd, 0_u64) else trap "IPv4 header length";
  let offset = 0_u64;
  let sum = 0_u32;
  loop @words {
    let done = ieq(offset, length);
    if done {
      break @words;
    }
    let low_offset = offset +wrap 1_u64;
    let high_ok = ilt(offset, length);
    claim high_in_header: high_ok because "the word walk stops at the even header length";
    let high_byte = header[offset];
    let low_ok = ilt(low_offset, length);
    claim low_in_header: low_ok because "an even header holds the low byte of every word";
    let low_byte = header[low_offset];
    let high_word = cvt<u8, u32>(high_byte);
    let low_word = cvt<u8, u32>(low_byte);
    let shifted_high = ishl.wrap(high_word, 8_u32);
    let word = ior(shifted_high, low_word);
    let combined = sum +wrap word;
    let carry = ishr.wrap(combined, 16_u32);
    let low_sum = iand(combined, 65535_u32);
    let folded = low_sum +wrap carry;
    set sum = folded;
    set offset = offset +wrap 2_u64;
  }
  let inverted = inot(sum);
  let checksum_word = iand(inverted, 65535_u32);
  let narrowed = cvt<u32, u16>(checksum_word);
  let checksum = match narrowed {
    Ok(value: checksum_value) => {
      give checksum_value;
    }
    Err(error: failure) => {
      check False() else trap "checksum narrowing";
      give 0_u16;
    }
  }
  return checksum;
}

fn main() -> own unit allocates(heap), traps {
  region 'static_view {
    let view = slice_of(&'static_view ipv4_header);
    let checksum = ipv4_checksum<'static_view>(header: move view);
    check ieq(checksum, 47248_u16) else trap "static IPv4 checksum";
  }
  let runtime_header = buffer_new(20_u64, 0_u8);
  let offset = 0_u64;
  loop @copy_header {
    let done = ieq(offset, 20_u64);
    if done {
      break @copy_header;
    }
    let copy_ok = ilt(offset, 20_u64);
    claim copy_in_header: copy_ok because "the copy walks 0..20 and breaks at twenty";
    let byte = ipv4_header[offset];
    set runtime_header[offset] = byte;
    set offset = offset +wrap 1_u64;
  }
  region 'runtime_view {
    let view = slice_of(&'runtime_view runtime_header);
    let checksum = ipv4_checksum<'runtime_view>(header: move view);
    check ieq(checksum, 47248_u16) else trap "runtime IPv4 checksum";
  }
  return unit;
}
