const ipv4_header: FixedVector<u8, 20> =[69_u8, 0_u8, 0_u8, 84_u8, 0_u8, 0_u8, 64_u8, 0_u8, 64_u8, 1_u8, 0_u8, 0_u8, 192_u8, 168_u8, 0_u8, 1_u8, 192_u8, 168_u8, 0_u8, 199_u8];

fn ipv4_checksum(header: own Slice<u8>) -> result: own u16 reads(header) contract {
  define length = len_of(header);
  define odd = iand(length, 1_u64);
  requires odd == 0_u64;
} {
  let length = len_of(header);
  let sum = 0_u32;
  for (offset in 0_u64..length) {
    let byte = header[offset];
    let wide = cvt::<u8, u32>(byte);
    let parity = iand(offset, 1_u64);
    if parity == 0_u64 {
      let shifted = ishl.wrap(wide, 8_u32);
      set sum = sum +wrap shifted;
    } else {
      let combined = sum +wrap wide;
      let carry = ishr.wrap(combined, 16_u32);
      let low_sum = iand(combined, 65535_u32);
      set sum = low_sum +wrap carry;
    }
  }
  let inverted = inot(sum);
  let checksum_word = iand(inverted, 65535_u32);
  let narrowed = cvt::<u32, u16>(checksum_word);
  let checksum = match narrowed {
    Ok(value: checksum_value) => {
      give checksum_value;
    }
    Err(error: failure) => {
      give 0_u16;
    }
  }
  return checksum;
}

command fn main() -> status: own ExitStatus pure {
  region {
    let view = slice_of(&ipv4_header);
    let view_length = len_of(view);
    let view_odd = iand(view_length, 1_u64);
    if view_odd == 0_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
    let checksum = ipv4_checksum(header: view);
    if checksum == 47248_u16 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  region 'w {
    let workspace = arena_frame::<20, 1, 'w>();
    region {
      let runtime_header = arena_vector_proved::<u8>(store: &uniq workspace, count: 20_u64);
      for @copy_header (
        at in 0_u64..20_u64,
        invariant grown: len_of(runtime_header) >= at,
        invariant spare: room_of(runtime_header) + at >= 20_u64,
        invariant flat: head_of(runtime_header) <= 0_u64
      ) {
        let byte = ipv4_header[at];
        set runtime_header = place_back(vector: move runtime_header, value: byte);
      }
      region {
        let view = slice_of(&runtime_header);
        let view_length = len_of(view);
        let view_odd = iand(view_length, 1_u64);
        if view_odd == 0_u64 {
        } else {
          return exit_status(code: 1_u8);
        }
        let checksum = ipv4_checksum(header: view);
        if checksum == 47248_u16 {
        } else {
          return exit_status(code: 1_u8);
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
