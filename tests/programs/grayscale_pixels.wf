fn grayscale_value(red: own u8, green: own u8, blue: own u8) -> result: own Result<u8, NarrowError> pure {
  let red_float = cvt<u8, f32>(red);
  let green_float = cvt<u8, f32>(green);
  let blue_float = cvt<u8, f32>(blue);
  let red_green = fadd.strict(red_float, green_float);
  let total = fadd.strict(red_green, blue_float);
  let average = fdiv.strict(total, 3.0_f32);
  let rounded = froundeven(average);
  return cvt<f32, u8>(rounded);
}

fn grayscale['i, 'o](input: &'i buffer<u8>, output: &uniq 'o buffer<u8>) -> result: own Result<unit, NarrowError> reads('i 'o), writes('o), traps contract {
  define input_length = len(deref(input));
  define output_length = len(deref(output));
  requires ige(input_length, 24_u64);
  requires ige(output_length, 8_u64);
} {
  let pixel = 0_u64;
  loop @pixels {
    let done = ieq(pixel, 8_u64);
    if done {
      break @pixels;
    }
    let base = pixel *wrap 3_u64;
    let green_offset = base +wrap 1_u64;
    let blue_offset = base +wrap 2_u64;
    let input_room = len(deref(input));
    let red_ok = ilt(base, input_room);
    claim red_in_input: red_ok because "premises: input has at least twenty-four bytes and pixel walks from zero until eight\nderivation: for a continuing pixel below eight, three times pixel is at most twenty-one and therefore below the input length\nconclusion: base is below input_room\nchecker gap: ENT does not derive the multiplicative ordinary-loop invariant\nconsumers: the following input subscript uses base";
    let red = deref(input)[base];
    let green_ok = ilt(green_offset, input_room);
    claim green_in_input: green_ok because "premises: input has at least twenty-four bytes and a continuing pixel is below eight\nderivation: three times pixel plus one is at most twenty-two and therefore below the input length\nconclusion: green_offset is below input_room\nchecker gap: ENT does not derive the multiplicative ordinary-loop invariant\nconsumers: the following input subscript uses green_offset";
    let green = deref(input)[green_offset];
    let blue_ok = ilt(blue_offset, input_room);
    claim blue_in_input: blue_ok because "premises: input has at least twenty-four bytes and a continuing pixel is below eight\nderivation: three times pixel plus two is at most twenty-three and therefore below the input length\nconclusion: blue_offset is below input_room\nchecker gap: ENT does not derive the multiplicative ordinary-loop invariant\nconsumers: the following input subscript uses blue_offset";
    let blue = deref(input)[blue_offset];
    let value = propagate grayscale_value(red: red, green: green, blue: blue);
    let output_room = len(deref(output));
    let pixel_ok = ilt(pixel, output_room);
    claim pixel_in_output: pixel_ok because "premises: output has at least eight bytes and pixel starts at zero and exits at eight\nderivation: each continuing iteration increments pixel once, so a continuing pixel is one of zero through seven\nconclusion: pixel is below output_room\nchecker gap: ENT does not derive this ordinary-loop induction invariant\nconsumers: the following output subscript uses pixel";
    set deref(output)[pixel] = value;
    set pixel = pixel +wrap 1_u64;
  }
  return Ok<unit, NarrowError>(value: unit);
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let input = buffer_new(24_u64, 0_u8);
  set input[3_u64] = 255_u8;
  set input[4_u64] = 255_u8;
  set input[5_u64] = 255_u8;
  set input[6_u64] = 255_u8;
  set input[10_u64] = 255_u8;
  set input[14_u64] = 255_u8;
  set input[15_u64] = 255_u8;
  set input[16_u64] = 255_u8;
  set input[18_u64] = 1_u8;
  set input[19_u64] = 2_u8;
  set input[20_u64] = 3_u8;
  set input[21_u64] = 254_u8;
  set input[22_u64] = 253_u8;
  set input[23_u64] = 252_u8;
  let output = buffer_new(8_u64, 0_u8);
  region 'image {
    let result = grayscale<'image, 'image>(input: &'image input, output: &uniq 'image output);
    match move result {
      Ok(value: success) => {
      }
      Err(error: failure) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  if ieq(output[0_u64], 0_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(output[1_u64], 255_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(output[2_u64], 85_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(output[3_u64], 85_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(output[4_u64], 85_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(output[5_u64], 170_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(output[6_u64], 2_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(output[7_u64], 253_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
