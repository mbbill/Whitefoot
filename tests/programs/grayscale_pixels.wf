fn grayscale_value(red: own u8, green: own u8, blue: own u8) -> result: own Result<u8, NarrowError> pure {
  let red_float = cvt::<u8, f32>(red);
  let green_float = cvt::<u8, f32>(green);
  let blue_float = cvt::<u8, f32>(blue);
  let red_green = fadd.strict(red_float, green_float);
  let total = fadd.strict(red_green, blue_float);
  let average = fdiv.strict(total, 3.0_f32);
  let rounded = froundeven(average);
  return cvt::<f32, u8>(rounded);
}

fn grayscale(input: &buffer<u8>, output: &uniq buffer<u8>) -> result: own Result<unit, NarrowError> reads(input, output), writes(output) contract {
  define input_length = len(deref(input));
  define output_length = len(deref(output));
  requires input_length >= 24_u64;
  requires output_length >= 8_u64;
} {
  let pixel = 0_u64;
  loop @pixels {
    let done = pixel == 8_u64;
    if done {
      break @pixels;
    }
    let base = pixel *wrap 3_u64;
    let green_offset = base +wrap 1_u64;
    let blue_offset = base +wrap 2_u64;
    let input_room = len(deref(input));
    let red_ok = base < input_room;
    if red_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    let red = deref(input)[base];
    let green_ok = green_offset < input_room;
    if green_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    let green = deref(input)[green_offset];
    let blue_ok = blue_offset < input_room;
    if blue_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    let blue = deref(input)[blue_offset];
    let value = propagate grayscale_value(red: red, green: green, blue: blue);
    let output_room = len(deref(output));
    let pixel_ok = pixel < output_room;
    if pixel_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    set deref(output)[pixel] = value;
    set pixel = pixel +wrap 1_u64;
  }
  return Ok<unit, NarrowError>(value: unit);
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(24_u64, 0_u8);
  set input[3_u64] = 255_u8;
  set input[4_u64] = 255_u8;
  set input[5_u64] = 255_u8;
  set input[6_u64] = 255_u8;
  set input[10_u64] = 255_u8;
  set input[14_u64] = 255_u8;
  set input[15_u64] = 255_u8;
  set input[16_u64] = 255_u8;
  set input[18_u64] = 1_u8;
  set input[19_u64] = 2_u8;
  set input[20_u64] = 3_u8;
  set input[21_u64] = 254_u8;
  set input[22_u64] = 253_u8;
  set input[23_u64] = 252_u8;
  let output = buffer_new(8_u64, 0_u8);
  region {
    let result = grayscale(input: &input, output: &uniq output);
    match move result {
      Ok(value: success) => {
      }
      Err(error: failure) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  if output[0_u64] == 0_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[1_u64] == 255_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[2_u64] == 85_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[3_u64] == 85_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[4_u64] == 85_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[5_u64] == 170_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[6_u64] == 2_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[7_u64] == 253_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
