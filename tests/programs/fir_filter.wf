struct DelayLine {
  samples: array<f64, 8>;
  cursor: u64;
}

struct FirFilter {
  taps: array<f64, 8>;
  delay: DelayLine;
}

fn main() -> own unit traps {
  let taps = array_new<f64, 8>(0.125_f64);
  let samples = array_new<f64, 8>(0.0_f64);
  let delay = DelayLine(samples: move samples, cursor: 0_u64);
  let filter = FirFilter(taps: move taps, delay: move delay);
  let tap_count = len(filter.taps);
  check ieq(tap_count, 8_u64) else trap "FIR tap count";
  let frame = 0_u64;
  let output_sum = 0.0_f64;
  loop @frames {
    let finished = ieq(frame, 64_u64);
    if finished {
      break @frames;
    }
    let first_frame = ieq(frame, 0_u64);
    let sample = if first_frame {
      give 8.0_f64;
    } else {
      give 0.0_f64;
    }
    let write_ok = ilt(filter.delay.cursor, 8_u64);
    claim cursor_in_delay: write_ok because "the ring cursor wraps at seven";
    set filter.delay.samples[filter.delay.cursor] = sample;
    let tap = 0_u64;
    let read_cursor = filter.delay.cursor;
    let output = 0.0_f64;
    loop @taps {
      let taps_finished = ieq(tap, tap_count);
      if taps_finished {
        break @taps;
      }
      let tap_ok = ilt(tap, 8_u64);
      claim tap_in_taps: tap_ok because "the tap walk stops at the eight-tap count";
      let coefficient = filter.taps[tap];
      let read_ok = ilt(read_cursor, 8_u64);
      claim read_cursor_in_delay: read_ok because "the ring read cursor wraps at seven";
      let delayed = filter.delay.samples[read_cursor];
      let contribution = fmul.strict(coefficient, delayed);
      set output = fadd.strict(output, contribution);
      let at_start = ieq(read_cursor, 0_u64);
      let previous_cursor = if at_start {
        give 7_u64;
      } else {
        give read_cursor -wrap 1_u64;
      }
      set read_cursor = previous_cursor;
      set tap = tap +wrap 1_u64;
    }
    set output_sum = fadd.strict(output_sum, output);
    let at_end = ieq(filter.delay.cursor, 7_u64);
    let next_cursor = if at_end {
      give 0_u64;
    } else {
      give filter.delay.cursor +wrap 1_u64;
    }
    set filter.delay.cursor = next_cursor;
    set frame = frame +wrap 1_u64;
  }
  check feq(output_sum, 8.0_f64) else trap "FIR impulse response";
  return unit;
}
