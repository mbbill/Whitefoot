fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn byte_at(store: &Slice<u8>, index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the view does not hold.";
  let room = len_of(deref(store));
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn parse_port(digits: &Slice<u8>, length: own u64) -> result: own u16 reads(digits) {
  doc "Reads one decimal port out of the argument bytes the invocation supplied; a byte that is not a digit ends the number.";
  let port = 0_u16;
  let ended = 0_u8;
  let index = 0_u64;
  loop @scan {
    let more = index < length;
    if more {
    } else {
      break @scan;
    }
    let byte = byte_at(store: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
      let value = byte -wrap 48_u8;
      let widened = cvt::<u8, u16>(value);
      let scaled = port *wrap 10_u16;
      set port = scaled +wrap widened;
    } else {
      set ended = 1_u8;
    }
    if ended == 0_u8 {
      set index = index +wrap 1_u64;
    } else {
      break @scan;
    }
  }
  return port;
}

fn send_all(send: &uniq TcpSend, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(send, source), writes(send) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Sends one prefix of the source run, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    region {
      match send_once(send: &uniq deref(send), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn zero_fill['s: affine](vector: &uniq Vector<'s, u8>) -> result: own unit reads(vector), writes(vector) contract {
  define spare = room_of(deref(vector));
  define start = head_of(deref(vector));
  requires 256_u64 <= spare;
  requires start <= 0_u64;
  ensures len_of(deref(vector)) >= 256_u64;
  ensures head_of(deref(vector)) <= 0_u64;
} {
  doc "Opens a fresh run's whole capacity, so a view formed over it holds the 256 slots one connection's scratch needs. It is a helper rather than a loop written where the run is taken because its contract is what publishes the opened length: a caller reads the exclusive referent's exit length bound off the signature instead of re-deriving it from three loop invariants at every site [FN-9].";
  for @fill_run (
    at in 0_u64..256_u64,
    invariant grown_run: len_of(deref(vector)) >= at,
    invariant spare_run: room_of(deref(vector)) + at >= 256_u64,
    invariant flat_run: head_of(deref(vector)) <= 0_u64
  ) {
    place_back(vector: &uniq deref(vector), value: 0_u8);
  }
  return unit;
}

fn serve_one(listener: &uniq TcpListener, handles: &uniq HandleFactory) -> result: own u8 reads(listener, handles), writes(listener, handles) {
  doc "Accepts one peer through exclusive listener and factory values, echoes its first chunk, and explicitly closes both halves. Its arena scratch belongs to this call and remains alive until every ordinary call returns.";
  let outcome = 0_u8;
  region 'scratch {
    let store = arena_frame::<256, 8, 'scratch>();
    region {
      let fresh = arena_vector_proved::<u8>(store: &uniq store, count: 256_u64);
      region {
        zero_fill(vector: &uniq fresh);
      }
      let scratch = move fresh;
      region {
        match tcp_accept(factory: &uniq deref(handles), listener: &uniq deref(listener)) {
          Accepted(connection: link, peer: from) => {
            let available = 0_u64;
            let refused = 0_u8;
            region {
              let window = mut_slice_of(&uniq scratch);
              region {
                match receive_next(receive: &uniq link.receive, destination: &uniq window, start: 0_u64, end: 256_u64) {
                  Ok(value: endpoint) => {
                    set available = endpoint;
                  }
                  Err(error: read_stop_11) => {
                    match read_stop_11 {
                      ReadEnd() => {
                        set refused = 1_u8;
                      }
                      ReadFailed(error: problem) => {
                        set outcome = 3_u8;
                        set refused = 1_u8;
                      }
                    }
                  }
                }
              }
            }
            if refused == 0_u8 {
              region {
                let returned = slice_of(&scratch);
                region {
                  match send_all(send: &uniq link.send, source: &returned, length: available) {
                    Ok(value: delivered) => {
                    }
                    Err(error: problem) => {
                      set outcome = 4_u8;
                    }
                  }
                }
              }
            }
            let TcpConnection(receive: close_receive_12, send: close_send_12) = move link;
            close_receive(factory: &uniq deref(handles), receive: move close_receive_12);
            close_send(factory: &uniq deref(handles), send: move close_send_12);
          }
          AcceptFailed(error: problem) => {
            region {
              if factory_refusal(error: &problem) {
                set outcome = 6_u8;
              } else {
                set outcome = 5_u8;
              }
            }
          }
        }
      }
    }
  }
  return outcome;
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "Listens on the invocation port and serves four peers in order. Each ordinary call borrows the same listener and factory until return; deleting PAR-3 removes the former staged overlap.";
  let Inputs(args: args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin) = move inputs;
  region {
    close_directory(factory: &uniq handles, directory: move unused_cwd);
  }
  region 'arguments {
    let names = arena_frame::<16, 8, 'arguments>();
    region {
      let digits = arena_vector_proved::<u8>(store: &uniq names, count: 16_u64);
      for @fill_digits (
        at in 0_u64..16_u64,
        invariant grown_digits: len_of(digits) >= at,
        invariant spare_digits: room_of(digits) + at >= 16_u64,
        invariant flat_digits: head_of(digits) <= 0_u64
      ) {
        place_back(vector: &uniq digits, value: 0_u8);
      }
      let room = len_of(digits);
      let port = 0_u16;
      let arguments = 0_u64;
      region {
        set arguments = args_count(args: &args);
      }
      let named = arguments >= 2_u64;
      if named {
      } else {
        return exit_status(code: 1_u8);
      }
      let carried = 0_u64;
      region {
        match arg_get(args: &args, position: 1_u64) {
          Ok(value: text) => {
            region {
              region {
                let window = mut_slice_of(&uniq digits);
                region {
                  match host_copy_utf8(value: &text, destination: &uniq window, start: 0_u64, end: room) {
                    Ok(value: written) => {
                      set carried = written;
                    }
                    Err(error: problem) => {
                      set carried = 0_u64;
                    }
                  }
                }
              }
            }
          }
          Err(error: problem) => {
            set carried = 0_u64;
          }
        }
      }
      if carried == 0_u64 {
        return exit_status(code: 2_u8);
      }
      region {
        let named_port = slice_of(&digits);
        region {
          set port = parse_port(digits: &named_port, length: carried);
        }
      }
      let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
      let outcome = 0_u8;
      region {
        region {
          match tcp_listen(factory: &uniq handles, address: &address) {
            Listening(listener: bound) => {
              for (
                served in 0_u64..4_u64,
                invariant progress: served <= 4_u64
              ) {
                let reported = serve_one(listener: &uniq bound, handles: &uniq handles);
                if reported == 6_u8 {
                  close_listener(factory: &uniq handles, listener: move bound);
                  return exit_status(code: 6_u8);
                }
                if reported == 0_u8 {
                } else {
                  set outcome = reported;
                }
              }
              let listener_credit = close_listener(factory: &uniq handles, listener: move bound);
            }
            ListenFailed(error: problem) => {
              region {
                if factory_refusal(error: &problem) {
                  set outcome = 8_u8;
                } else {
                  set outcome = 7_u8;
                }
              }
            }
          }
        }
      }
      return exit_status(code: outcome);
    }
  }
}
