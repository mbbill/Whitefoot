fn byte_at(store: &Slice<u8>, index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the view does not hold.";
  let room = len_of(deref(store));
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn parse_port(digits: &Slice<u8>, length: own u64) -> result: own u16 reads(digits) {
  doc "Reads one decimal port out of the argument bytes the invocation supplied; a byte that is not a digit ends the number.";
  let port = 0_u16;
  let ended = 0_u8;
  let index = 0_u64;
  loop @scan {
    let more = index < length;
    if more {
    } else {
      break @scan;
    }
    let byte = byte_at(store: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
      let value = byte -wrap 48_u8;
      let widened = cvt::<u8, u16>(value);
      let scaled = port *wrap 10_u16;
      set port = scaled +wrap widened;
    } else {
      set ended = 1_u8;
    }
    if ended == 0_u8 {
      set index = index +wrap 1_u64;
    } else {
      break @scan;
    }
  }
  return port;
}

fn send_all(send: &uniq TcpSend, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(send, source), writes(send) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Sends one prefix of the source run, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    region {
      match send_once(send: &uniq deref(send), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn zero_fill['s: affine](vector: own Vector<'s, u8>) -> result: own Vector<'s, u8> reads(vector), writes(vector) contract {
  define spare = room_of(vector);
  define start = head_of(vector);
  requires 256_u64 <= spare;
  requires start <= 0_u64;
  ensures len_of(result) >= 256_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Opens a fresh run's whole capacity, so a view formed over it holds the 256 slots one connection's scratch needs. The fill is a helper rather than a loop written at the call site because the staged hand-out reads the loop body before its cut as straight-line statements [PAR-3].";
  let run = move vector;
  for @fill_run (
    at in 0_u64..256_u64,
    invariant grown_run: len_of(run) >= at,
    invariant spare_run: room_of(run) + at >= 256_u64,
    invariant flat_run: head_of(run) <= 0_u64
  ) {
    set run = place_back(vector: move run, value: 0_u8);
  }
  return move run;
}

fn serve_one(listener: &TcpListener, permit: own HandlePermit) -> result: own u8 reads(listener, permit), writes(permit) {
  doc "Takes one connection from the listener, returns the first chunk the peer sent, and releases the pair, so the caller's fixed-trip loop serves one peer per iteration [SYS-17, SYS-18]. The scratch is this call's own bump extent rather than the caller's, because on the container surface no iteration-own run can travel from that loop's prologue into its staged call: a borrow of a run is the address of the run's own storage, which pins the run to one frame slot four in-flight iterations cannot share, and an owned run parameter occurring at one position may carry no region name and therefore no affine bound [FORM-8], so its store region is the fail-closed general one and the callee may not release it [PROV-6]. Reserved here, the extent belongs to the activation the lane hands out, and the two system rows read and write it through the views the run hands back [VIEW-1, SYS-8].";
  let outcome = 0_u8;
  region 'scratch {
    let store = arena_frame::<256, 8, 'scratch>();
    region {
      let fresh = arena_vector_proved::<u8>(store: &uniq store, count: 256_u64);
      let scratch = zero_fill(vector: move fresh);
      region {
        match tcp_accept(permit: move permit, listener: listener) {
          Accepted(connection: link, peer: from) => {
            let available = 0_u64;
            let refused = 0_u8;
            region {
              let window = mut_slice_of(&uniq scratch);
              region {
                match receive_next(receive: &uniq link.receive, destination: &uniq window, start: 0_u64, end: 256_u64) {
                  ReadBytes(next: endpoint) => {
                    set available = endpoint;
                  }
                  ReadEnd() => {
                    set refused = 1_u8;
                  }
                  ReadFailed(error: problem) => {
                    set outcome = 3_u8;
                    set refused = 1_u8;
                  }
                }
              }
            }
            if refused == 0_u8 {
              region {
                let returned = slice_of(&scratch);
                region {
                  match send_all(send: &uniq link.send, source: &returned, length: available) {
                    Ok(value: delivered) => {
                    }
                    Err(error: problem) => {
                      set outcome = 4_u8;
                    }
                  }
                }
              }
            }
            let credit = close_connection(connection: move link);
          }
          AcceptFailed(error: problem, permit: handed_back) => {
            set outcome = 5_u8;
          }
        }
      }
    }
  }
  return outcome;
}

command fn main(command.args as args: own Args, command.handles as handles: own HandleFactory) -> status: own ExitStatus reads(args, handles), writes(handles) {
  doc "Listens on the loopback port named by the invocation and serves four connections in a fixed-trip loop the staged permission admits: each iteration takes its own permit before its accept and leaves the loop only from its prologue, so the four accepts may be in flight at once and several peers reach one listener together [PAR-3, SYS-17]. The argument scratch is an arena extent viewed exclusively where the argument is copied into it and shared where the port is read out. The per-connection scratch is not this loop's at all: `serve_one` reserves its own extent, because the container surface has no run an iteration can build here and hand to its staged call, and the reason is written at that function.";
  region 'arguments {
    let names = arena_frame::<16, 8, 'arguments>();
    region {
      let digits = arena_vector_proved::<u8>(store: &uniq names, count: 16_u64);
      for @fill_digits (
        at in 0_u64..16_u64,
        invariant grown_digits: len_of(digits) >= at,
        invariant spare_digits: room_of(digits) + at >= 16_u64,
        invariant flat_digits: head_of(digits) <= 0_u64
      ) {
        set digits = place_back(vector: move digits, value: 0_u8);
      }
      let room = len_of(digits);
      let port = 0_u16;
      let arguments = 0_u64;
      region {
        set arguments = args_count(args: &args);
      }
      let named = arguments >= 2_u64;
      if named {
      } else {
        return exit_status(code: 1_u8);
      }
      let carried = 0_u64;
      region {
        match arg_get(args: &args, position: 1_u64) {
          Ok(value: text) => {
            region 'v {
              region {
                let window = mut_slice_of(&uniq digits);
                region {
                  match host_copy_utf8(value: &'v text, destination: &uniq window, start: 0_u64, end: room) {
                    Ok(value: written) => {
                      set carried = written;
                    }
                    Err(error: problem) => {
                      set carried = 0_u64;
                    }
                  }
                }
              }
            }
          }
          Err(error: problem) => {
            set carried = 0_u64;
          }
        }
      }
      if carried == 0_u64 {
        return exit_status(code: 2_u8);
      }
      region {
        let named_port = slice_of(&digits);
        region {
          set port = parse_port(digits: &named_port, length: carried);
        }
      }
      let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
      let outcome = 0_u8;
      region {
        match reserve_handle(factory: &uniq handles) {
          Ok(value: listen_permit) => {
            region {
              match tcp_listen(permit: move listen_permit, address: &address) {
                Listening(listener: bound) => {
                  for (
                    served in 0_u64..4_u64,
                    invariant progress: served <= 4_u64
                  ) {
                    match reserve_handle(factory: &uniq handles) {
                      Ok(value: accept_permit) => {
                        let reported = serve_one(listener: &bound, permit: move accept_permit);
                        if reported == 0_u8 {
                        } else {
                          set outcome = reported;
                        }
                      }
                      Err(error: problem) => {
                        return exit_status(code: 6_u8);
                      }
                    }
                  }
                  let listener_credit = close_listener(listener: move bound);
                }
                ListenFailed(error: problem, permit: handed_back) => {
                  set outcome = 7_u8;
                }
              }
            }
          }
          Err(error: problem) => {
            set outcome = 8_u8;
          }
        }
      }
      return exit_status(code: outcome);
    }
  }
}
