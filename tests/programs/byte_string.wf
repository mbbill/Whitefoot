const subject_head: FixedVector<u8, 19> =[116_u8, 104_u8, 101_u8, 32_u8, 113_u8, 117_u8, 105_u8, 99_u8, 107_u8, 32_u8, 98_u8, 114_u8, 111_u8, 119_u8, 110_u8, 32_u8, 102_u8, 111_u8, 120_u8];

const subject_tail: FixedVector<u8, 24> =[32_u8, 106_u8, 117_u8, 109_u8, 112_u8, 115_u8, 32_u8, 111_u8, 118_u8, 101_u8, 114_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 108_u8, 97_u8, 122_u8, 121_u8, 32_u8, 100_u8, 111_u8, 103_u8];

const needle_present: FixedVector<u8, 5> =[98_u8, 114_u8, 111_u8, 119_u8, 110_u8];

const needle_absent: FixedVector<u8, 3> =[99_u8, 97_u8, 116_u8];

const label_length: FixedVector<u8, 7> =[108_u8, 101_u8, 110_u8, 103_u8, 116_u8, 104_u8, 61_u8];

const label_present: FixedVector<u8, 7> =[32_u8, 98_u8, 114_u8, 111_u8, 119_u8, 110_u8, 61_u8];

const label_absent: FixedVector<u8, 5> =[32_u8, 99_u8, 97_u8, 116_u8, 61_u8];

const word_none: FixedVector<u8, 4> =[110_u8, 111_u8, 110_u8, 101_u8];

const line_end: FixedVector<u8, 1> =[10_u8];

const digit_glyphs: FixedVector<u8, 10> =[48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8];

enum Grown {
  Grew(value: Vector<u8>);
  Refused(value: Vector<u8>);
}

fn bs_reserve(s: own Vector<u8>, store: &uniq Heap, total: own u64) -> grown: own Grown reads(s, store), writes(s, store), allocates(store) contract {
  requires total >= len_of(s);
} {
  doc "Grows the backing run to total slots, preserving byte order, or reports that the store refused. Growth is the drain-front, append-back walk, and the superseded run is disposed before the wider one is handed back. The four measures the Grew arm carries are not published here: a variant-routed measure clause is a deferred contract route, so the caller reads them back instead.";
  let count = len_of(s);
  region {
    match heap_vector::<u8>(store: &uniq deref(store), count: total) {
      None() => {
        return Refused(value: move s);
      }
      Some(value: fresh) => {
        let built = move fresh;
        for @move (
          at in 0_u64..count,
          invariant left: len_of(s) + at >= count,
          invariant gone: len_of(s) + at <= count,
          invariant made_lo: len_of(built) >= at,
          invariant made_hi: len_of(built) <= at,
          invariant spare_lo: room_of(built) + at >= total,
          invariant spare_hi: room_of(built) + at <= total,
          invariant flat: head_of(built) <= 0_u64
        ) {
          set (s, byte) = take_front(vector: move s);
          set built = place_back(vector: move built, value: byte);
        }
        dispose s;
        return Grew(value: move built);
      }
    }
  }
}

fn bs_len(s: &Vector<u8>) -> result: own u64 reads(s) {
  doc "Reports how many bytes the string holds.";
  return len_of(deref(s));
}

fn bs_byte(s: &Vector<u8>, index: own u64) -> result: own Option<u8> reads(s) {
  doc "Reads one stored byte, delivering None for a position the string does not hold.";
  let stored = len_of(deref(s));
  let within = index < stored;
  if within {
    let value = deref(s)[index];
    return Some<u8>(value: value);
  }
  return None<u8>();
}

fn bs_append_slice(s: own Vector<u8>, text: own Slice<u8>) -> result: own Vector<u8> reads(s, text), writes(s) contract {
  requires head_of(s) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Appends every byte of one static message, and hands the run back unchanged when it has no room for them. The run travels by value because a &uniq parameter whose referent reaches a container nominal is refused, and because only a consumed operand's measure can be published at all.";
  let count = len_of(text);
  let built = move s;
  let start = len_of(built);
  let spare = room_of(built);
  let admitted = spare >= count;
  if admitted {
  } else {
    return move built;
  }
  for @append (
    at in 0_u64..count,
    invariant filled_lo: len_of(built) >= start + at,
    invariant filled_hi: len_of(built) <= start + at,
    invariant spare_lo: room_of(built) + at >= spare,
    invariant spare_hi: room_of(built) + at <= spare,
    invariant flat: head_of(built) <= 0_u64
  ) {
    let byte = text[at];
    set built = place_back(vector: move built, value: byte);
  }
  return move built;
}

fn bs_from(store: &uniq Heap, text: own Slice<u8>) -> made: own Option<Vector<u8>> reads(store, text), writes(store), allocates(store) {
  doc "Builds one byte string holding exactly the bytes of one static message.";
  let count = len_of(text);
  region {
    match heap_vector::<u8>(store: &uniq deref(store), count: count) {
      None() => {
        return None<Vector<u8>>();
      }
      Some(value: fresh) => {
        let built = bs_append_slice(s: move fresh, text: text);
        return Some<Vector<u8>>(value: move built);
      }
    }
  }
}

fn bs_concat(destination: own Vector<u8>, source: &Vector<u8>) -> result: own Vector<u8> reads(destination, source), writes(destination) contract {
  requires head_of(destination) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Appends every byte of one byte string to another, and hands the destination back unchanged when it has no room for them.";
  let count = len_of(deref(source));
  let built = move destination;
  let start = len_of(built);
  let spare = room_of(built);
  let admitted = spare >= count;
  if admitted {
  } else {
    return move built;
  }
  for @concat (
    at in 0_u64..count,
    invariant filled_lo: len_of(built) >= start + at,
    invariant filled_hi: len_of(built) <= start + at,
    invariant spare_lo: room_of(built) + at >= spare,
    invariant spare_hi: room_of(built) + at <= spare,
    invariant flat: head_of(built) <= 0_u64
  ) {
    let byte = deref(source)[at];
    set built = place_back(vector: move built, value: byte);
  }
  return move built;
}

fn bs_find(haystack: &Vector<u8>, needle: &Vector<u8>) -> result: own Option<u64> reads(haystack, needle) {
  doc "Reports the first position where the needle bytes occur, by the naive left-to-right scan.";
  let hay_length = len_of(deref(haystack));
  let needle_length = len_of(deref(needle));
  let longer = needle_length > hay_length;
  if longer {
    return None<u64>();
  }
  let last = hay_length -wrap needle_length;
  let start = 0_u64;
  loop @scan {
    let past = start > last;
    if past {
      break @scan;
    }
    let same = True();
    let offset = 0_u64;
    loop @compare {
      let done = offset >= needle_length;
      if done {
        break @compare;
      }
      let position = start +wrap offset;
      let equal = False();
      region {
        match bs_byte(s: &deref(haystack), index: position) {
          Some(value: left) => {
            region {
              match bs_byte(s: &deref(needle), index: offset) {
                Some(value: right) => {
                  set equal = left == right;
                }
                None() => {
                }
              }
            }
          }
          None() => {
          }
        }
      }
      if equal {
      } else {
        set same = False();
        break @compare;
      }
      set offset = offset +wrap 1_u64;
    }
    if same {
      return Some<u64>(value: start);
    }
    set start = start +wrap 1_u64;
  }
  return None<u64>();
}

fn bs_push_decimal(s: own Vector<u8>, value: own u64) -> result: own Vector<u8> reads(s), writes(s) contract {
  requires head_of(s) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Appends the decimal spelling of one unsigned value, least significant digit extracted first into a fixed scratch run and drained from its back, which is the most significant digit.";
  let scratch = fixed_vector::<u8, 20>();
  let rest = value;
  loop @extract {
    let digit = rest % 10_u64;
    let glyphs = len_of(digit_glyphs);
    let known = digit < glyphs;
    let spare = room_of(scratch);
    let vacant = spare > 0_u64;
    if known {
      if vacant {
        let glyph = digit_glyphs[digit];
        set scratch = place_back(vector: move scratch, value: glyph);
      } else {
        break @extract;
      }
    } else {
      break @extract;
    }
    set rest = rest / 10_u64;
    let finished = rest == 0_u64;
    if finished {
      break @extract;
    }
  }
  let written = len_of(scratch);
  let built = move s;
  let spare = room_of(built);
  let admitted = spare >= written;
  if admitted {
  } else {
    return move built;
  }
  for @emit (
    at in 0_u64..written,
    invariant left_lo: len_of(scratch) + at >= written,
    invariant left_hi: len_of(scratch) + at <= written,
    invariant spare_lo: room_of(built) + at >= spare,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set (scratch, emitted) = take_back(vector: move scratch);
    set built = place_back(vector: move built, value: emitted);
  }
  return move built;
}

fn publish_all(output: &uniq Output, source: own Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define source_length = len_of(source);
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source view, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(output: &uniq deref(output), source: &source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

command fn main(command.stdout as out: own Output, command.heap as heap: own Heap) -> status: own ExitStatus reads(out, heap), writes(out, heap), allocates(heap) {
  doc "Builds one byte string from literals, grows its backing run, concatenates, searches it, and publishes the measured report.";
  region {
    let head_view = slice_of(&subject_head);
    match bs_from(store: &uniq heap, text: head_view) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: head_made) => {
        let opening = move head_made;
        let opening_length = len_of(opening);
        if 43_u64 >= opening_length {
        } else {
          return exit_status(code: 1_u8);
        }
        region {
          match bs_reserve(s: move opening, store: &uniq heap, total: 43_u64) {
            Refused(value: refused) => {
              return exit_status(code: 71_u8);
            }
            Grew(value: ready) => {
              let subject = move ready;
              let flat = head_of(subject);
              if flat == 0_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              region {
                let tail_view = slice_of(&subject_tail);
                match bs_from(store: &uniq heap, text: tail_view) {
                  None() => {
                    return exit_status(code: 70_u8);
                  }
                  Some(value: tail_made) => {
                    let tail = move tail_made;
                    region {
                      set subject = bs_concat(destination: move subject, source: &tail);
                    }
                    let total = 0_u64;
                    region {
                      set total = bs_len(s: &subject);
                    }
                    if total == 43_u64 {
                    } else {
                      return exit_status(code: 1_u8);
                    }
                    region {
                      match bs_byte(s: &subject, index: 10_u64) {
                        Some(value: observed) => {
                          if observed == 98_u8 {
                          } else {
                            return exit_status(code: 1_u8);
                          }
                        }
                        None() => {
                          return exit_status(code: 1_u8);
                        }
                      }
                    }
                    region {
                      match bs_byte(s: &subject, index: 43_u64) {
                        Some(value: observed) => {
                          return exit_status(code: 1_u8);
                        }
                        None() => {
                        }
                      }
                    }
                    region {
                      let present_view = slice_of(&needle_present);
                      match bs_from(store: &uniq heap, text: present_view) {
                        None() => {
                          return exit_status(code: 70_u8);
                        }
                        Some(value: present_made) => {
                          let present = move present_made;
                          region {
                            let absent_view = slice_of(&needle_absent);
                            match bs_from(store: &uniq heap, text: absent_view) {
                              None() => {
                                return exit_status(code: 70_u8);
                              }
                              Some(value: absent_made) => {
                                let absent = move absent_made;
                                let present_at = 0_u64;
                                let present_found = 0_u8;
                                region {
                                  match bs_find(haystack: &subject, needle: &present) {
                                    Some(value: at) => {
                                      set present_at = at;
                                      set present_found = 1_u8;
                                    }
                                    None() => {
                                    }
                                  }
                                }
                                if present_found == 1_u8 {
                                } else {
                                  return exit_status(code: 1_u8);
                                }
                                if present_at == 10_u64 {
                                } else {
                                  return exit_status(code: 1_u8);
                                }
                                let absent_found = 0_u8;
                                region {
                                  match bs_find(haystack: &subject, needle: &absent) {
                                    Some(value: at) => {
                                      set absent_found = 1_u8;
                                    }
                                    None() => {
                                    }
                                  }
                                }
                                if absent_found == 0_u8 {
                                } else {
                                  return exit_status(code: 1_u8);
                                }
                                region {
                                  match heap_vector::<u8>(store: &uniq heap, count: 28_u64) {
                                    None() => {
                                      return exit_status(code: 70_u8);
                                    }
                                    Some(value: report_made) => {
                                      let report = move report_made;
                                      region {
                                        let view = slice_of(&label_length);
                                        set report = bs_append_slice(s: move report, text: view);
                                      }
                                      set report = bs_push_decimal(s: move report, value: total);
                                      region {
                                        let view = slice_of(&label_present);
                                        set report = bs_append_slice(s: move report, text: view);
                                      }
                                      set report = bs_push_decimal(s: move report, value: present_at);
                                      region {
                                        let view = slice_of(&label_absent);
                                        set report = bs_append_slice(s: move report, text: view);
                                      }
                                      if absent_found == 0_u8 {
                                        region {
                                          let view = slice_of(&word_none);
                                          set report = bs_append_slice(s: move report, text: view);
                                        }
                                      } else {
                                        set report = bs_push_decimal(s: move report, value: 0_u64);
                                      }
                                      region {
                                        let view = slice_of(&line_end);
                                        set report = bs_append_slice(s: move report, text: view);
                                      }
                                      let published = len_of(report);
                                      if published == 28_u64 {
                                      } else {
                                        return exit_status(code: 1_u8);
                                      }
                                      region {
                                        let window = slice_of(&report);
                                        let window_length = len_of(window);
                                        let within_window = published <= window_length;
                                        if within_window {
                                          region {
                                            match publish_all(output: &uniq out, source: window, length: published) {
                                              Ok(value: done) => {
                                              }
                                              Err(error: problem) => {
                                                return exit_status(code: 2_u8);
                                              }
                                            }
                                          }
                                        } else {
                                          return exit_status(code: 3_u8);
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
