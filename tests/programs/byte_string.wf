const subject_head: Array<u8, 19> =[116_u8, 104_u8, 101_u8, 32_u8, 113_u8, 117_u8, 105_u8, 99_u8, 107_u8, 32_u8, 98_u8, 114_u8, 111_u8, 119_u8, 110_u8, 32_u8, 102_u8, 111_u8, 120_u8];

const subject_tail: Array<u8, 24> =[32_u8, 106_u8, 117_u8, 109_u8, 112_u8, 115_u8, 32_u8, 111_u8, 118_u8, 101_u8, 114_u8, 32_u8, 116_u8, 104_u8, 101_u8, 32_u8, 108_u8, 97_u8, 122_u8, 121_u8, 32_u8, 100_u8, 111_u8, 103_u8];

const needle_present: Array<u8, 5> =[98_u8, 114_u8, 111_u8, 119_u8, 110_u8];

const needle_absent: Array<u8, 3> =[99_u8, 97_u8, 116_u8];

const label_length: Array<u8, 7> =[108_u8, 101_u8, 110_u8, 103_u8, 116_u8, 104_u8, 61_u8];

const label_present: Array<u8, 7> =[32_u8, 98_u8, 114_u8, 111_u8, 119_u8, 110_u8, 61_u8];

const label_absent: Array<u8, 5> =[32_u8, 99_u8, 97_u8, 116_u8, 61_u8];

const word_none: Array<u8, 4> =[110_u8, 111_u8, 110_u8, 101_u8];

const line_end: Array<u8, 1> =[10_u8];

const digit_glyphs: Array<u8, 10> =[48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8];

fn bs_reserve(s: &Box<Slots<u8>>, total: own u64) -> result: own unit writes(s) contract {
  requires total >= deref(s).inner.cap;
  ensures deref(s).inner.cap == total;
  ensures deref(s).inner.len == deref(entry(s)).inner.len;
} {
  doc "Grows the backing window to total slots, preserving byte order. grow is defined on Box<Slots<T>> alone, remakes the cell's content whole, may reallocate in place, and carries the length across, so there is no superseded run to release and allocation has no failure arm [OP-10, STOR-8].";
  grow(cell: s, capacity: total);
  return unit;
}

fn bs_len(s: &Box<Slots<u8>>) -> result: own u64 reads(s) {
  doc "Reports how many bytes the string holds; a measure read is a place form, not a call [OP-15].";
  return deref(s).inner.len;
}

fn bs_byte(s: &Box<Slots<u8>>, index: own u64) -> result: own Option<u8> reads(s) {
  doc "Reads one stored byte, delivering None for a position the string does not hold.";
  let stored = deref(s).inner.len;
  let within = index < stored;
  if within {
    let value = deref(s).inner[index];
    return Some<u8>(value: value);
  }
  return None<u8>();
}

fn bs_append_range(s: &Box<Slots<u8>>, capacity: own u64, text: &[u8]) -> result: own unit reads(text), writes(s) contract {
  requires deref(s).inner.cap == capacity;
  requires deref(s).inner.len + deref(text).len <= capacity;
  ensures deref(s).inner.cap == capacity;
  ensures deref(s).inner.len == deref(entry(s)).inner.len + deref(text).len;
} {
  doc "Appends every byte of one static message. The message arrives as a range reference, whose one measure is len, and the written capacity is what turns the caller's room proof into place_back's own requirement [REF-4, MSR-2].";
  let count = deref(text).len;
  let start = deref(s).inner.len;
  for @append (
    at in 0_u64..count,
    invariant filled: deref(s).inner.len == start + at,
    invariant kept: deref(s).inner.cap == capacity,
    invariant fits: start + count <= capacity
  ) {
    let byte = deref(text)[at];
    place_back(window: &deref(s).inner, value: byte);
  }
  return unit;
}

fn bs_from(text: &[u8]) -> made: own Box<Slots<u8>> reads(text) contract {
  ensures made.inner.cap == deref(text).len;
  ensures made.inner.len == deref(text).len;
} {
  doc "Builds one byte string holding exactly the bytes of one static message.";
  let count = deref(text).len;
  let made = box_slots_new::<u8>(capacity: count);
  bs_append_range(s: &made, capacity: count, text: text);
  return move made;
}

fn bs_concat(destination: &Box<Slots<u8>>, capacity: own u64, source: &Box<Slots<u8>>) -> result: own unit reads(source), writes(destination) contract {
  requires deref(destination).inner.cap == capacity;
  requires deref(destination).inner.len + deref(source).inner.len <= capacity;
  ensures deref(destination).inner.cap == capacity;
  ensures deref(destination).inner.len == deref(entry(destination)).inner.len + deref(source).inner.len;
} {
  doc "Appends every byte of one byte string to another; the two reference parameters name two different roots, so the call site proves their substituted paths disjoint [EFF-5].";
  let count = deref(source).inner.len;
  let start = deref(destination).inner.len;
  for @concat (
    at in 0_u64..count,
    invariant filled: deref(destination).inner.len == start + at,
    invariant kept: deref(destination).inner.cap == capacity,
    invariant fits: start + count <= capacity
  ) {
    let byte = deref(source).inner[at];
    place_back(window: &deref(destination).inner, value: byte);
  }
  return unit;
}

fn bs_find(haystack: &Box<Slots<u8>>, needle: &Box<Slots<u8>>) -> result: own Option<u64> reads(haystack), reads(needle) {
  doc "Reports the first position where the needle bytes occur, by the naive left-to-right scan. A position found by a search is returned as an index, never as a reference [REF-3].";
  let hay_length = deref(haystack).inner.len;
  let needle_length = deref(needle).inner.len;
  let longer = needle_length > hay_length;
  if longer {
    return None<u64>();
  }
  let last = hay_length -wrap needle_length;
  let start = 0_u64;
  loop @scan {
    let past = start > last;
    if past {
      break @scan;
    }
    let same = True();
    let offset = 0_u64;
    loop @compare {
      let done = offset >= needle_length;
      if done {
        break @compare;
      }
      let position = start +wrap offset;
      let equal = False();
      match bs_byte(s: haystack, index: position) {
        Some(value: left) => {
          match bs_byte(s: needle, index: offset) {
            Some(value: right) => {
              set equal = left == right;
            }
            None() => {
            }
          }
        }
        None() => {
        }
      }
      if equal {
      } else {
        set same = False();
        break @compare;
      }
      set offset = offset +wrap 1_u64;
    }
    if same {
      return Some<u64>(value: start);
    }
    set start = start +wrap 1_u64;
  }
  return None<u64>();
}

fn bs_push_decimal(s: &Box<Slots<u8>>, capacity: own u64, value: own u64, digits: own u64) -> result: own unit writes(s) contract {
  requires digits >= 1_u64;
  requires digits <= 20_u64;
  requires deref(s).inner.cap == capacity;
  requires deref(s).inner.len + digits <= capacity;
  ensures deref(s).inner.cap == capacity;
  ensures deref(s).inner.len == deref(entry(s)).inner.len + digits;
} {
  doc "Appends exactly digits decimal glyphs of value, least significant digit extracted first into a fixed scratch window and drained from its back, which is the most significant digit.";
  let scratch = slots_new::<u8, 20>();
  let rest = value;
  for @extract (
    at in 0_u64..digits,
    invariant grown: scratch.len == at
  ) {
    let digit = rest % 10_u64;
    let glyph = digit_glyphs[digit];
    place_back(window: &scratch, value: glyph);
    set rest = rest / 10_u64;
  }
  let start = deref(s).inner.len;
  for @emit (
    at in 0_u64..digits,
    invariant left: scratch.len + at == digits,
    invariant filled: deref(s).inner.len == start + at,
    invariant kept: deref(s).inner.cap == capacity,
    invariant fits: start + digits <= capacity
  ) {
    let emitted = take_back(window: &scratch);
    place_back(window: &deref(s).inner, value: emitted);
  }
  return unit;
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: own u64) -> result: own Result<unit, IoError> reads(source), writes(factory), writes(output) contract {
  define source_length = deref(source).len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    match write_once(factory: factory, output: output, source: source, start: sent, end: length) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: move problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "Builds one byte string from const runs, grows its backing cell, concatenates, searches it, and publishes the measured report.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let head_view = &subject_head[0_u64..19_u64];
  let subject = bs_from(text: head_view);
  let opening_length = subject.inner.len;
  if 43_u64 >= opening_length {
  } else {
    return exit_status(code: 1_u8);
  }
  bs_reserve(s: &subject, total: 43_u64);
  let tail_view = &subject_tail[0_u64..24_u64];
  let tail = bs_from(text: tail_view);
  bs_concat(destination: &subject, capacity: 43_u64, source: &tail);
  let total = bs_len(s: &subject);
  if total == 43_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  match bs_byte(s: &subject, index: 10_u64) {
    Some(value: observed) => {
      if observed == 98_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    None() => {
      return exit_status(code: 1_u8);
    }
  }
  match bs_byte(s: &subject, index: 43_u64) {
    Some(value: past_end) => {
      return exit_status(code: 1_u8);
    }
    None() => {
    }
  }
  let present_view = &needle_present[0_u64..5_u64];
  let present = bs_from(text: present_view);
  let absent_view = &needle_absent[0_u64..3_u64];
  let absent = bs_from(text: absent_view);
  let present_at = 0_u64;
  let present_found = 0_u8;
  match bs_find(haystack: &subject, needle: &present) {
    Some(value: at) => {
      set present_at = at;
      set present_found = 1_u8;
    }
    None() => {
    }
  }
  if present_found == 1_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if present_at == 10_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let absent_found = 0_u8;
  match bs_find(haystack: &subject, needle: &absent) {
    Some(value: missing_at) => {
      set absent_found = 1_u8;
    }
    None() => {
    }
  }
  if absent_found == 0_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let report = box_slots_new::<u8>(capacity: 28_u64);
  let length_label = &label_length[0_u64..7_u64];
  bs_append_range(s: &report, capacity: 28_u64, text: length_label);
  bs_push_decimal(s: &report, capacity: 28_u64, value: total, digits: 2_u64);
  let present_label = &label_present[0_u64..7_u64];
  bs_append_range(s: &report, capacity: 28_u64, text: present_label);
  bs_push_decimal(s: &report, capacity: 28_u64, value: present_at, digits: 2_u64);
  let absent_label = &label_absent[0_u64..5_u64];
  bs_append_range(s: &report, capacity: 28_u64, text: absent_label);
  if absent_found == 0_u8 {
    let none_word = &word_none[0_u64..4_u64];
    bs_append_range(s: &report, capacity: 28_u64, text: none_word);
  } else {
    bs_push_decimal(s: &report, capacity: 28_u64, value: 0_u64, digits: 4_u64);
  }
  let ending = &line_end[0_u64..1_u64];
  bs_append_range(s: &report, capacity: 28_u64, text: ending);
  let published = report.inner.len;
  if published == 28_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let window = &report.inner[0_u64..28_u64];
  match publish_all(factory: &entry_factory, output: &out, source: window, length: 28_u64) {
    Ok(value: done) => {
    }
    Err(error: problem) => {
      return exit_status(code: 2_u8);
    }
  }
  return exit_status(code: 0_u8);
}
