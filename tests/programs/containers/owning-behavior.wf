struct Seed {
  salt: u64;
}

fn seed_hash(env: &Seed, key: &u64) -> hash: own u64 reads(env.salt), reads(key) {
  let mixed = deref(key) +wrap deref(env).salt;
  return mixed;
}

fn seed_equal(env: &Seed, left: &u64, right: &u64) -> equal: own Bool reads(left), reads(right) {
  let same = deref(left) == deref(right);
  return same;
}

struct Resource {
  id: u64;
  data0: u64;
  data1: u64;
  data2: u64;
  data3: u64;
}

enum Slot<K> {
  Vacant();
  Deleted();
  Occupied(fingerprint: u8, key: K, payload: Box<Resource>);
}

enum Probe {
  Stop();
  Skip();
  Miss();
  Match();
}

enum KeyPut<K> {
  Installed(previous: Slot<K>);
  Rejected(key: K, payload: Box<Resource>);
}

enum PutOutcome {
  Inserted();
  Replaced(previous: Box<Resource>);
  Full(offered: Box<Resource>);
}

struct Progress<K> {
  held: Slot<K>;
  source_next: u64;
  next_probe: u64;
  phase: u8;
}

struct Rehash<K> {
  source: Box<Slots<Slot<K>>>;
  target: Box<Slots<Slot<K>>>;
  progress: Progress<K>;
}

formal Key<K: drop, E> {
  fn hash(env: &E, key: &K) -> hash: own u64 reads(env), reads(key);
  fn equal(env: &E, left: &K, right: &K) -> equal: own Bool reads(env), reads(left), reads(right);
}

struct Map<Key<K, E>> {
  slots: Box<Slots<Slot<K>>>;
}

actual SeedKey : Key<u64, Seed> {
  hash = seed_hash;
  equal = seed_equal;
}

struct Empty {
}

fn word_hash(env: &Empty, key: &u64) -> hash: own u64 reads(key) {
  return deref(key);
}

fn word_equal(env: &Empty, left: &u64, right: &u64) -> equal: own Bool reads(left), reads(right) {
  return deref(left) == deref(right);
}

actual WordKey : Key<u64, Empty> {
  hash = word_hash;
  equal = word_equal;
}

fn fingerprint(key: own u64) -> result: own u8 pure {
  let tag = 0_u8;
  let bit0 = iand(key, 1_u64);
  if bit0 != 0_u64 {
    set tag = ior(tag, 1_u8);
  }
  let bit1 = iand(key, 2_u64);
  if bit1 != 0_u64 {
    set tag = ior(tag, 2_u8);
  }
  let bit2 = iand(key, 4_u64);
  if bit2 != 0_u64 {
    set tag = ior(tag, 4_u8);
  }
  let bit3 = iand(key, 8_u64);
  if bit3 != 0_u64 {
    set tag = ior(tag, 8_u8);
  }
  let bit4 = iand(key, 16_u64);
  if bit4 != 0_u64 {
    set tag = ior(tag, 16_u8);
  }
  let bit5 = iand(key, 32_u64);
  if bit5 != 0_u64 {
    set tag = ior(tag, 32_u8);
  }
  let bit6 = iand(key, 64_u64);
  if bit6 != 0_u64 {
    set tag = ior(tag, 64_u8);
  }
  return tag;
}

fn probe_index(home: own u64, step: own u64, count: own u64) -> index: own u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  let until_end = count - home;
  if step >= until_end {
    let wrapped = step - until_end;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn key_probe<Key<K, E>>(slot: &Slot<K>, tag: own u8, key: &K, env: &E) -> action: own Probe reads(slot), reads(key), reads(env) {
  match deref(slot) {
    Vacant() => {
      return Stop();
    }
    Deleted() => {
      return Skip();
    }
    Occupied(fingerprint: saved, key: present, payload: owner) => {
      if deref(saved) == tag {
        let same = Key::equal(env: env, left: present, right: key);
        if same {
          return Match();
        }
      }
      return Miss();
    }
  }
}

fn key_put<Key<K, E>>(slots: &Box<Slots<Slot<K>>>, key: own K, payload: own Box<Resource>, env: &E) -> outcome: own KeyPut<K> reads(env), writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  doc "The installation is swap: the offered occupant goes into the slot and the binding comes back holding the slot's previous value, so the owning key and payload are never left in a hole.";
  let hash = Key::hash(env: env, key: &key);
  let tag = fingerprint(key: hash);
  let count = deref(slots).inner.len;
  let first_deleted = count;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = probe_index(home: home, step: step, count: count);
    let action = key_probe::<Key<K, E>>(slot: &deref(slots).inner[index], tag: tag, key: &key, env: env);
    match action {
      Match() => {
        let offered = Occupied<K>(fingerprint: tag, key: move key, payload: move payload);
        swap(first: &deref(slots).inner[index], second: &offered);
        return Installed<K>(previous: move offered);
      }
      Skip() => {
        if first_deleted == count {
          set first_deleted = index;
        }
      }
      Stop() => {
        let destination = index;
        if first_deleted < count {
          set destination = first_deleted;
        }
        let offered = Occupied<K>(fingerprint: tag, key: move key, payload: move payload);
        swap(first: &deref(slots).inner[destination], second: &offered);
        return Installed<K>(previous: move offered);
      }
      Miss() => {
      }
    }
  }
  if first_deleted < count {
    let offered = Occupied<K>(fingerprint: tag, key: move key, payload: move payload);
    swap(first: &deref(slots).inner[first_deleted], second: &offered);
    return Installed<K>(previous: move offered);
  }
  return Rejected<K>(key: move key, payload: move payload);
}

fn key_find_index<Key<K, E>>(slots: &Box<Slots<Slot<K>>>, key: &K, env: &E) -> found: own Result<u64, unit> reads(slots), reads(key), reads(env) contract {
  ensures when Ok(value: index): index < deref(slots).inner.len;
} {
  let hash = Key::hash(env: env, key: key);
  let tag = fingerprint(key: hash);
  let count = deref(slots).inner.len;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = probe_index(home: home, step: step, count: count);
    let action = key_probe::<Key<K, E>>(slot: &deref(slots).inner[index], tag: tag, key: key, env: env);
    match action {
      Match() => {
        return Ok<u64, unit>(value: index);
      }
      Stop() => {
        return Err<u64, unit>(error: unit);
      }
      Skip() => {
      }
      Miss() => {
      }
    }
  }
  return Err<u64, unit>(error: unit);
}

fn key_fill<K>(slots: &Box<Slots<Slot<K>>>, count: own u64) -> result: own unit writes(slots) contract {
  requires deref(slots).inner.len == 0_u64;
  requires count <= deref(slots).inner.cap - deref(slots).inner.len;
  ensures deref(slots).inner.len == count;
} {
  doc "One vacant slot per position, under a counted header that carries the length and the remaining free slots.";
  for (
    index in 0_u64..count,
    invariant filled: deref(slots).inner.len >= index,
    invariant bounded: deref(slots).inner.len <= index,
    invariant spare: deref(slots).inner.cap - deref(slots).inner.len + index >= count
  ) {
    let vacant = Vacant<K>();
    place_back(window: &deref(slots).inner, value: move vacant);
  }
  invariant complete_min: deref(slots).inner.len >= count;
  invariant complete_max: deref(slots).inner.len <= count;
  return unit;
}

fn key_occupied<K>(slot: &Slot<K>) -> full: own Bool reads(slot) {
  match deref(slot) {
    Occupied(fingerprint: tag, key: present, payload: owner) => {
      return True();
    }
    Vacant() => {
      return False();
    }
    Deleted() => {
      return False();
    }
  }
}

fn key_slot_hash<Key<K, E>>(slot: &Slot<K>, env: &E) -> hash: own u64 reads(slot), reads(env) {
  match deref(slot) {
    Occupied(fingerprint: tag, key: present, payload: owner) => {
      return Key::hash(env: env, key: present);
    }
    Vacant() => {
      return 0_u64;
    }
    Deleted() => {
      return 0_u64;
    }
  }
}

fn key_create<K>(count: own u64) -> result: own Box<Slots<Slot<K>>> pure contract {
  requires count <= 2097152_u64;
  ensures result.inner.len == count;
} {
  doc "Allocation is total, so the table is created without a refusal arm and the static allocation-size obligation is discharged from the written bound.";
  let spare = box_slots_new::<Slot<K>>(capacity: count);
  key_fill::<K>(slots: &spare, count: count);
  return move spare;
}

fn key_begin<K>(source: own Box<Slots<Slot<K>>>, count: own u64) -> result: own Rehash<K> pure contract {
  requires count <= 2097152_u64;
} {
  let spare = key_create::<K>(count: count);
  let held = Vacant<K>();
  let progress = Progress<K>(held: move held, source_next: 0_u64, next_probe: 0_u64, phase: 0_u8);
  let state = Rehash<K>(source: move source, target: move spare, progress: move progress);
  return move state;
}

fn key_advance<Key<K, E>>(source: &Box<Slots<Slot<K>>>, target: &Box<Slots<Slot<K>>>, progress: &Progress<K>, budget: own u64, env: &E) -> (examined: own u64, moved: own u64) reads(env), writes(source), writes(target), writes(progress.held), writes(progress.source_next), writes(progress.next_probe), writes(progress.phase) {
  doc "Each transfer is two exchanges: the source slot's occupant goes into the held field and the held occupant goes into its target slot, so the displaced vacant value is released by the ordinary scope exit.";
  let source_cursor = deref(progress).source_next;
  let probe_cursor = deref(progress).next_probe;
  let phase = deref(progress).phase;
  let inspected = 0_u64;
  let transfers = 0_u64;
  if phase < 2_u8 {
    for (
      tick in 0_u64..budget,
      invariant work_min: inspected >= tick,
      invariant work_max: inspected <= tick,
      invariant moved_bound: transfers <= inspected
    ) {
      if phase == 0_u8 {
        let count = deref(source).inner.len;
        if source_cursor >= count {
          set phase = 3_u8;
          break;
        }
        let index = source_cursor;
        set source_cursor = source_cursor + 1_u64;
        let full = key_occupied::<K>(slot: &deref(source).inner[index]);
        if full {
          let held_slot = Deleted<K>();
          swap(first: &deref(source).inner[index], second: &held_slot);
          swap(first: &deref(progress).held, second: &held_slot);
          set probe_cursor = 0_u64;
          set phase = 1_u8;
        }
      } else {
        let count = deref(target).inner.len;
        if probe_cursor >= count {
          set phase = 2_u8;
          break;
        }
        let key = key_slot_hash::<Key<K, E>>(slot: &deref(progress).held, env: env);
        let home = key % count;
        let index = probe_index(home: home, step: probe_cursor, count: count);
        set probe_cursor = probe_cursor + 1_u64;
        let full = key_occupied::<K>(slot: &deref(target).inner[index]);
        if full {
        } else {
          let held_slot = Vacant<K>();
          swap(first: &deref(progress).held, second: &held_slot);
          swap(first: &deref(target).inner[index], second: &held_slot);
          set transfers = transfers + 1_u64;
          set phase = 0_u8;
        }
      }
      set inspected = inspected + 1_u64;
    }
    if phase == 0_u8 {
      let source_count = deref(source).inner.len;
      if source_cursor == source_count {
        set phase = 3_u8;
      }
    }
  }
  set deref(progress).source_next = source_cursor;
  set deref(progress).next_probe = probe_cursor;
  set deref(progress).phase = phase;
  return inspected, transfers;
}

fn key_rehash_all<Key<K, E>>(slots: &Box<Slots<Slot<K>>>, count: own u64, env: &E) -> (code: own u8, examined: own u64, moved: own u64) reads(env), writes(slots) contract {
  requires deref(slots).inner.len <= 1048576_u64;
  requires count >= deref(slots).inner.len;
  requires count <= 2097152_u64;
} {
  doc "A complete migration into a fresh cell, committed over the caller's cell so the ordinary assignment releases the emptied source.";
  let target = key_create::<K>(count: count);
  let held = Vacant<K>();
  let progress = Progress<K>(held: move held, source_next: 0_u64, next_probe: 0_u64, phase: 0_u8);
  let (work, moved) = key_advance::<Key<K, E>>(source: slots, target: &target, progress: &progress, budget: 18446744073709551615_u64, env: env);
  let phase = progress.phase;
  set deref(slots) = move target;
  return phase, work, moved;
}

fn key_remove<Key<K, E>>(slots: &Box<Slots<Slot<K>>>, key: &K, env: &E) -> removed: own Slot<K> reads(key), reads(env), writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  match key_find_index::<Key<K, E>>(slots: slots, key: key, env: env) {
    Err(error: absent) => {
      return Vacant<K>();
    }
    Ok(value: index) => {
      let deleted = Deleted<K>();
      swap(first: &deref(slots).inner[index], second: &deleted);
      return move deleted;
    }
  }
}

fn key_inspect<Key<K, E>>(slot: &Slot<K>, tag: own u8, key: &K, env: &E) -> (action: own Probe, id: own u64) reads(slot), reads(key), reads(env) {
  match deref(slot) {
    Vacant() => {
      return Stop(), 0_u64;
    }
    Deleted() => {
      return Skip(), 0_u64;
    }
    Occupied(fingerprint: saved, key: present, payload: owner) => {
      if deref(saved) == tag {
        let same = Key::equal(env: env, left: present, right: key);
        if same {
          return Match(), deref(owner).inner.id;
        }
      }
      return Miss(), 0_u64;
    }
  }
}

fn key_find<Key<K, E>>(slots: &Box<Slots<Slot<K>>>, key: &K, env: &E) -> (found: own Option<u64>, examined: own u64) reads(slots), reads(key), reads(env) {
  let hash = Key::hash(env: env, key: key);
  let tag = fingerprint(key: hash);
  let count = deref(slots).inner.len;
  for (offset in 0_u64..count) {
    let home = hash % count;
    let index = probe_index(home: home, step: offset, count: count);
    let work = offset + 1_u64;
    let (action, id) = key_inspect::<Key<K, E>>(slot: &deref(slots).inner[index], tag: tag, key: key, env: env);
    match action {
      Stop() => {
        return None<u64>(), work;
      }
      Match() => {
        return Some<u64>(value: id), work;
      }
      Skip() => {
      }
      Miss() => {
      }
    }
  }
  return None<u64>(), count;
}

fn put(slots: &Box<Slots<Slot<u64>>>, key: own u64, payload: own Box<Resource>) -> outcome: own PutOutcome writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  let env = Empty();
  match key_put::<WordKey>(slots: slots, key: key, payload: move payload, env: &env) {
    Rejected(key: offered_key, payload: owner) => {
      return Full(offered: move owner);
    }
    Installed(previous: old) => {
      match move old {
        Vacant() => {
          return Inserted();
        }
        Deleted() => {
          return Inserted();
        }
        Occupied(fingerprint: tag, key: old_key, payload: owner) => {
          return Replaced(previous: move owner);
        }
      }
    }
  }
}

fn find(slots: &Box<Slots<Slot<u64>>>, key: own u64) -> (found: own Option<u64>, examined: own u64) reads(slots) {
  let env = Empty();
  let (found, examined) = key_find::<WordKey>(slots: slots, key: &key, env: &env);
  return move found, examined;
}

fn remove(slots: &Box<Slots<Slot<u64>>>, key: own u64) -> removed: own Option<Box<Resource>> writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  let env = Empty();
  let old = key_remove::<WordKey>(slots: slots, key: &key, env: &env);
  match move old {
    Vacant() => {
      return None<Box<Resource>>();
    }
    Deleted() => {
      return None<Box<Resource>>();
    }
    Occupied(fingerprint: tag, key: old_key, payload: owner) => {
      return Some<Box<Resource>>(value: move owner);
    }
  }
}

fn begin(source: own Box<Slots<Slot<u64>>>, count: own u64) -> result: own Rehash<u64> pure contract {
  requires count <= 2097152_u64;
} {
  return key_begin::<u64>(source: move source, count: count);
}

fn advance(source: &Box<Slots<Slot<u64>>>, target: &Box<Slots<Slot<u64>>>, progress: &Progress<u64>, budget: own u64) -> (examined: own u64, moved: own u64) writes(source), writes(target), writes(progress.held), writes(progress.source_next), writes(progress.next_probe), writes(progress.phase) {
  let env = Empty();
  let (examined, moved) = key_advance::<WordKey>(source: source, target: target, progress: progress, budget: budget, env: &env);
  return examined, moved;
}

fn rehash_all(slots: &Box<Slots<Slot<u64>>>, count: own u64) -> (code: own u8, examined: own u64, moved: own u64) writes(slots) contract {
  requires deref(slots).inner.len <= 1048576_u64;
  requires count >= deref(slots).inner.len;
  requires count <= 2097152_u64;
} {
  let env = Empty();
  let (code, examined, moved) = key_rehash_all::<WordKey>(slots: slots, count: count, env: &env);
  return code, examined, moved;
}

fn create_table(count: own u64) -> result: own Box<Slots<Slot<u64>>> pure contract {
  requires count <= 2097152_u64;
  ensures result.inner.len == count;
} {
  let made = key_create::<u64>(count: count);
  return move made;
}

fn read_slot(slot: &Slot<u64>) -> (control: own u8, key: own u64, id: own u64) reads(slot) {
  match deref(slot) {
    Vacant() => {
      return 128_u8, 0_u64, 0_u64;
    }
    Deleted() => {
      return 254_u8, 0_u64, 0_u64;
    }
    Occupied(fingerprint: saved_tag, key: saved_key, payload: owner) => {
      return deref(saved_tag), deref(saved_key), deref(owner).inner.id;
    }
  }
}

fn allocate_put(slots: &Box<Slots<Slot<u64>>>, key: own u64, id: own u64) -> outcome: own PutOutcome writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  doc "Allocation is total, so one owner is built for every offered insertion.";
  let data0 = id *wrap 17_u64;
  let data1 = data0 +wrap 1_u64;
  let data2 = data0 +wrap 2_u64;
  let data3 = data0 +wrap 3_u64;
  let resource = Resource(id: id, data0: data0, data1: data1, data2: data2, data3: data3);
  let owner = box_new::<Resource>(value: move resource);
  let result = put(slots: slots, key: key, payload: move owner);
  return move result;
}

fn check_put(outcome: own PutOutcome, kind: own u64, expected: own u64) -> code: own u8 pure {
  match move outcome {
    Inserted() => {
      if kind != 1_u64 {
        return 1_u8;
      }
      return 0_u8;
    }
    Replaced(previous: old) => {
      if kind != 2_u64 {
        return 2_u8;
      }
      if old.inner.id != expected {
        return 3_u8;
      }
      return 0_u8;
    }
    Full(offered: back) => {
      if kind != 3_u64 {
        return 4_u8;
      }
      if back.inner.id != expected {
        return 5_u8;
      }
      return 0_u8;
    }
  }
}

fn digest(slots: &Box<Slots<Slot<u64>>>) -> result: own u64 reads(slots) {
  let count = deref(slots).inner.len;
  let start = ixor(1469598103934665603_u64, count);
  let hash = start *wrap 1099511628211_u64;
  for (index in 0_u64..count) {
    let (control, key, id) = read_slot(slot: &deref(slots).inner[index]);
    let wide = cvt::<u8, u64>(control);
    let with_tag = ixor(hash, wide);
    set hash = with_tag *wrap 1099511628211_u64;
    if control <= 127_u8 {
      let with_key = ixor(hash, key);
      let keyed = with_key *wrap 1099511628211_u64;
      let with_id = ixor(keyed, id);
      set hash = with_id *wrap 1099511628211_u64;
    }
  }
  return hash;
}

fn cleanup(state: own Rehash<u64>) -> result: own unit pure {
  doc "Early release of an affine value is a move into a consuming function: the state enters by value and its compiler-derived release runs at this scope's exit.";
  return unit;
}

fn checked_insert(slots: &Box<Slots<Slot<u64>>>, key: own u64, id: own u64, kind: own u64, expected: own u64) -> code: own u8 writes(slots) {
  let outcome = allocate_put(slots: slots, key: key, id: id);
  let verdict = check_put(outcome: move outcome, kind: kind, expected: expected);
  return verdict;
}

fn state_hash(state: &Rehash<u64>) -> result: own u64 reads(state.source), reads(state.target), reads(state.progress.held), reads(state.progress.source_next), reads(state.progress.next_probe), reads(state.progress.phase) {
  let source = digest(slots: &deref(state).source);
  let target = digest(slots: &deref(state).target);
  let (control, key, id) = read_slot(slot: &deref(state).progress.held);
  let first = source *wrap 131_u64;
  let second = first +wrap target;
  let third = second *wrap 131_u64;
  let fourth = third +wrap deref(state).progress.source_next;
  let fifth = fourth *wrap 131_u64;
  let sixth = fifth +wrap deref(state).progress.next_probe;
  let phase = cvt::<u8, u64>(deref(state).progress.phase);
  let seventh = sixth *wrap 131_u64;
  let eighth = seventh +wrap phase;
  let ninth = eighth *wrap 131_u64;
  if control <= 127_u8 {
    let tenth = ninth +wrap key;
    let eleventh = tenth *wrap 131_u64;
    return eleventh +wrap id;
  }
  return ninth *wrap 131_u64;
}

fn check_lookup(slots: &Box<Slots<Slot<u64>>>, key: own u64, expected: own u64, work: own u64) -> code: own u8 reads(slots) {
  let (found, examined) = find(slots: slots, key: key);
  if examined != work {
    return 11_u8;
  }
  match move found {
    None() => {
      return 12_u8;
    }
    Some(value: present) => {
      if present != expected {
        return 13_u8;
      }
      return 0_u8;
    }
  }
}

fn map_contract(seed: own u64, scenario: own u64, budget: own u64) -> result: own u64 pure {
  doc "One scenario of the incremental migration contract: fill a table, exercise removal and replacement, begin a migration into a fresh cell, and step it under a budget.";
  let initial = 8_u64;
  let entries = 3_u64;
  if scenario == 0_u64 {
    set entries = 5_u64;
  }
  if scenario >= 3_u64 {
    set initial = 1_u64;
    set entries = 1_u64;
  }
  let base = seed *wrap 100_u64;
  let slots = create_table(count: initial);
  for (ordinal in 0_u64..entries) {
    let key_offset = ordinal *wrap 8_u64;
    let kind = 1_u64;
    let expected = 0_u64;
    if scenario == 0_u64 {
      if ordinal == 2_u64 {
        set key_offset = 8_u64;
        set kind = 2_u64;
        set expected = base +wrap 2_u64;
      }
      if ordinal == 3_u64 {
        let removed = remove(slots: &slots, key: seed);
        match move removed {
          None() => {
            return 14_u64;
          }
          Some(value: owner) => {
            let expected_removed = base +wrap 1_u64;
            if owner.inner.id != expected_removed {
              return 15_u64;
            }
          }
        }
        set key_offset = 8_u64;
        set kind = 2_u64;
        set expected = base +wrap 3_u64;
        let query = seed +wrap 8_u64;
        let query_id = base +wrap 3_u64;
        let checked_lookup = check_lookup(slots: &slots, key: query, expected: query_id, work: 2_u64);
        if checked_lookup != 0_u8 {
          return cvt::<u8, u64>(checked_lookup);
        }
      }
      if ordinal == 4_u64 {
        set key_offset = 16_u64;
      }
    }
    let key = seed +wrap key_offset;
    let index_id = base +wrap ordinal;
    let id = index_id +wrap 1_u64;
    let checked_put = checked_insert(slots: &slots, key: key, id: id, kind: kind, expected: expected);
    if checked_put != 0_u8 {
      return cvt::<u8, u64>(checked_put);
    }
  }
  if scenario == 4_u64 {
    let key = seed +wrap 1_u64;
    let id = base +wrap 2_u64;
    let checked_full = checked_insert(slots: &slots, key: key, id: id, kind: 3_u64, expected: id);
    if checked_full != 0_u8 {
      return cvt::<u8, u64>(checked_full);
    }
    return digest(slots: &slots);
  }
  let target_capacity = 8_u64;
  if scenario == 0_u64 {
    set target_capacity = 16_u64;
  }
  if scenario == 3_u64 {
    set target_capacity = 1_u64;
  }
  let migration = begin(source: move slots, count: target_capacity);
  let total_work = 0_u64;
  let total_moved = 0_u64;
  if scenario == 3_u64 {
    let key = seed +wrap 1_u64;
    let id = base +wrap 2_u64;
    let checked_target = checked_insert(slots: &migration.target, key: key, id: id, kind: 1_u64, expected: 0_u64);
    if checked_target != 0_u8 {
      return cvt::<u8, u64>(checked_target);
    }
  }
  if scenario == 2_u64 {
    for (round in 0_u64..14_u64) {
      let unchanged = state_hash(state: &migration);
      let (idle_work, idle_moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: 0_u64);
      let after_idle = state_hash(state: &migration);
      if unchanged != after_idle {
        return 17_u64;
      }
      if idle_work != 0_u64 {
        return 18_u64;
      }
      if idle_moved != 0_u64 {
        return 19_u64;
      }
      let (work, moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: 1_u64);
      set total_work = total_work +wrap work;
      set total_moved = total_moved +wrap moved;
      if work != 1_u64 {
        return 20_u64;
      }
    }
  } else {
    let (work, moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: budget);
    set total_work = work;
    set total_moved = moved;
    if work > budget {
      return 21_u64;
    }
    if scenario == 3_u64 {
      let unchanged = state_hash(state: &migration);
      let (retry_work, retry_moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: 99_u64);
      let after_retry = state_hash(state: &migration);
      if unchanged != after_retry {
        return 22_u64;
      }
      if retry_work != 0_u64 {
        return 23_u64;
      }
      if retry_moved != 0_u64 {
        return 24_u64;
      }
    }
  }
  let hash = state_hash(state: &migration);
  cleanup(state: move migration);
  let first = hash *wrap 131_u64;
  let second = first +wrap total_work;
  let third = second *wrap 131_u64;
  return third +wrap total_moved;
}

struct Branded {
  value: Box<u64>;
}

fn branded_hash(env: &Seed, key: &Branded) -> hash: own u64 reads(env.salt), reads(key.value) {
  let value = deref(key).value.inner;
  return value +wrap deref(env).salt;
}

fn branded_equal(env: &Seed, left: &Branded, right: &Branded) -> equal: own Bool reads(left.value), reads(right.value) {
  let a = deref(left).value.inner;
  let b = deref(right).value.inner;
  return a == b;
}

actual BrandedKey : Key<Branded, Seed> {
  hash = branded_hash;
  equal = branded_equal;
}

fn never_equal(env: &Empty, left: &u64, right: &u64) -> equal: own Bool pure {
  return False();
}

actual HostileKey : Key<u64, Empty> {
  hash = word_hash;
  equal = never_equal;
}

fn demo_payload(id: own u64) -> result: own Box<Resource> pure {
  doc "Allocation is total, so the payload constructor has no failure arm.";
  let data0 = id *wrap 17_u64;
  let data1 = data0 +wrap 1_u64;
  let data2 = data0 +wrap 2_u64;
  let data3 = data0 +wrap 3_u64;
  let value = Resource(id: id, data0: data0, data1: data1, data2: data2, data3: data3);
  let owner = box_new::<Resource>(value: move value);
  return move owner;
}

fn seed_case() -> code: own u8 pure {
  doc "The stateful hash and equality instantiation: one insertion and one successful lookup.";
  let env = Seed(salt: 8_u64);
  let query = 5_u64;
  let slots = key_create::<u64>(count: 4_u64);
  let map = Map<SeedKey>(slots: move slots);
  let owner = demo_payload(id: 81_u64);
  let outcome = key_put::<SeedKey>(slots: &map.slots, key: 5_u64, payload: move owner, env: &env);
  let (found, examined) = key_find::<SeedKey>(slots: &map.slots, key: &query, env: &env);
  match move found {
    None() => {
      return 1_u8;
    }
    Some(value: id) => {
      if id != 81_u64 {
        return 2_u8;
      }
    }
  }
  return 0_u8;
}

fn branded_case() -> code: own u8 pure {
  doc "The owning-key instantiation: the key itself owns a heap cell and is stored in the slot.";
  let env = Seed(salt: 8_u64);
  let slots = key_create::<Branded>(count: 4_u64);
  let map = Map<BrandedKey>(slots: move slots);
  let key_owner = box_new::<u64>(value: 9_u64);
  let key = Branded(value: move key_owner);
  let query_owner = box_new::<u64>(value: 9_u64);
  let query = Branded(value: move query_owner);
  let owner = demo_payload(id: 81_u64);
  let outcome = key_put::<BrandedKey>(slots: &map.slots, key: move key, payload: move owner, env: &env);
  let (found, examined) = key_find::<BrandedKey>(slots: &map.slots, key: &query, env: &env);
  match move found {
    None() => {
      return 3_u8;
    }
    Some(value: id) => {
      if id != 81_u64 {
        return 4_u8;
      }
    }
  }
  return 0_u8;
}

fn hostile_case() -> code: own u8 pure {
  doc "Repeated identical keys under a non-reflexive equality stay safe: every insertion lands in a vacant slot and every owner is still cleaned up.";
  let env = Empty();
  let query = 5_u64;
  let slots = key_create::<u64>(count: 2_u64);
  let map = Map<HostileKey>(slots: move slots);
  for (ordinal in 0_u64..2_u64) {
    let id = ordinal +wrap 81_u64;
    let owner = demo_payload(id: id);
    let outcome = key_put::<HostileKey>(slots: &map.slots, key: 5_u64, payload: move owner, env: &env);
    match move outcome {
      Rejected(key: offered_key, payload: offered_owner) => {
        return 5_u8;
      }
      Installed(previous: old) => {
        match move old {
          Occupied(fingerprint: tag, key: old_key, payload: old_owner) => {
            return 6_u8;
          }
          Vacant() => {
          }
          Deleted() => {
          }
        }
      }
    }
  }
  let (found, examined) = key_find::<HostileKey>(slots: &map.slots, key: &query, env: &env);
  match move found {
    Some(value: id) => {
      return 7_u8;
    }
    None() => {
      if examined != 2_u64 {
        return 8_u8;
      }
    }
  }
  return 0_u8;
}

fn behavior_contract(variant: own u64) -> code: own u8 pure {
  if variant == 0_u64 {
    return seed_case();
  }
  if variant == 1_u64 {
    return branded_case();
  }
  return hostile_case();
}

fn main() -> status: own ExitStatus pure {
  for (variant in 0_u64..3_u64) {
    let code = behavior_contract(variant: variant);
    if code != 0_u8 {
      return exit_status(code: code);
    }
  }
  let observed = map_contract(seed: 0_u64, scenario: 0_u64, budget: 100_u64);
  if observed <= 70_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
