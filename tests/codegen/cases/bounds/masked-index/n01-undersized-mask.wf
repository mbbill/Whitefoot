const table: array<u8, 8> =[0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8];

fn lookup(x: own u64) -> result: own u8 pure {
  let slot = iand(x, 3_u64);
  return table[slot];
}

command fn main() -> status: own ExitStatus traps {
  let value = lookup(x: 7_u64);
  claim undersized_mask_drift: ieq(value, 3_u8) because "undersized mask drift";
  return exit_status(code: 0_u8);
}
