const first: array<u8, 8> =[1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8];

const second: array<u8, 8> =[11_u8, 12_u8, 13_u8, 14_u8, 15_u8, 16_u8, 17_u8, 18_u8];

fn lookup(x: own u64) -> result: own u8 pure {
  let slot = iand(x, 7_u64);
  let a = first[slot];
  let b = second[slot];
  return a +wrap b;
}

command fn main() -> status: own ExitStatus traps {
  let value = lookup(x: 10_u64);
  claim two_read_drift: value == 16_u8 because "two-read drift";
  return exit_status(code: 0_u8);
}
