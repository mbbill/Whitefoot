const table: array<u8, 16> =[0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8, 9_u8, 10_u8, 11_u8, 12_u8, 13_u8, 14_u8, 15_u8];

fn lookup(x: own u64) -> result: own u8 pure {
  let slot = iand(x, 15_u64);
  return table[slot];
}

command fn main() -> status: own ExitStatus traps {
  let value = lookup(x: 31_u64);
  claim mask_fifteen_drift: value == 15_u8 because "mask fifteen drift";
  return exit_status(code: 0_u8);
}
