const table: array<u8, 4> =[11_u8, 21_u8, 31_u8, 41_u8];

fn lookup(source: own u64) -> result: own u8 pure {
  doc "A documentation statement does not alter the mask proof.";
  let bounded = iand(source, 3_u64);
  return table[bounded];
}

command fn main() -> status: own ExitStatus traps {
  let value = lookup(source: 6_u64);
  claim benign_doc_drift: value == 31_u8 because "benign doc drift";
  return exit_status(code: 0_u8);
}
