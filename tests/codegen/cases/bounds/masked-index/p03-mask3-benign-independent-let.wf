const table: array<u8, 4> =[12_u8, 22_u8, 32_u8, 42_u8];

fn lookup(x: own u64) -> result: own u8 pure {
  let slot = iand(x, 3_u64);
  let independent = x +wrap 9_u64;
  return table[slot];
}

command fn main() -> status: own ExitStatus traps {
  let value = lookup(x: 5_u64);
  claim benign_let_drift: value == 22_u8 because "benign let drift";
  return exit_status(code: 0_u8);
}
