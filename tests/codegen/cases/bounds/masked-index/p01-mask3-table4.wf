const table: array<u8, 4> =[10_u8, 20_u8, 30_u8, 40_u8];

fn lookup(x: u64) -> result: u8 pure {
  let slot = iand(x, 3_u64);
  return table[slot];
}

command fn main() -> status: ExitStatus traps {
  let value = lookup(x: 7_u64);
  claim masked_lookup_drift: value == 40_u8 because "masked lookup drift";
  return exit_status(code: 0_u8);
}
