const table: array<u8, 16> =[0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8, 9_u8, 10_u8, 11_u8, 12_u8, 13_u8, 14_u8, 15_u8];

fn probe(x: own u64) -> result: own u8 pure {
  let masked = iand(x, 15_u64);
  match cvt::<u64, u8>(masked) {
    Ok(value: narrow) => {
      let slot = cvt::<u8, u64>(narrow);
      return table[slot];
    }
    Err(error: problem) => {
      return 0_u8;
    }
  }
}
