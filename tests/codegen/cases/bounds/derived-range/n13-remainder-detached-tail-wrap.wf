fn probe(src: own buffer<u8>) -> result: own u64 pure {
  let n = len(src);
  let i = 18446744073709551615_u64;
  let sum = 0_u64;
  loop @triples {
    let rem = n -wrap i;
    if ilt(rem, 3_u64) {
      break @triples;
    }
    set i = i +wrap 3_u64;
  }
  let tail = n -wrap i;
  if ieq(tail, 1_u64) {
    let x = src[i];
    let wide = cvt<u8, u64>(x);
    set sum = sum +wrap wide;
  }
  return sum;
}
