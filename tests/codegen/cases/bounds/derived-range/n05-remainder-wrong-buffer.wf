fn probe(guarded: own buffer<u8>, target: own buffer<u8>) -> result: own u64 pure {
  let n = len_of(guarded);
  let i = 0_u64;
  let sum = 0_u64;
  loop @triples {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @triples;
    }
    let i2 = i +wrap 2_u64;
    let x = target[i2];
    let wide = cvt::<u8, u64>(x);
    set sum = sum +wrap wide;
    set i = i +wrap 3_u64;
  }
  return sum;
}
