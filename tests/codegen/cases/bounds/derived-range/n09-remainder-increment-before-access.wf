fn probe(src: own buffer<u8>) -> result: own u64 pure {
  doc "The stride update establishes the next-loop invariant, not safety of an access after the update.";
  let n = len(src);
  let i = 0_u64;
  let sum = 0_u64;
  loop @triples {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @triples;
    }
    set i = i +wrap 3_u64;
    let x = src[i];
    let wide = cvt::<u8, u64>(x);
    set sum = sum +wrap wide;
  }
  return sum;
}
