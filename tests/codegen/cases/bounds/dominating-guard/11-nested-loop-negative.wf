fn probe(b: own buffer<u8>) -> result: own u64 pure {
  doc "PROOF-1 negative for v1: nested control is conservatively outside the proof region.";
  let m = len(b);
  let i = 0_u64;
  let sum = 0_u64;
  loop @outer {
    if i >= m {
      break @outer;
    }
    loop @inner {
      let x = b[i];
      let x64 = cvt::<u8, u64>(x);
      set sum = sum +wrap x64;
      break @inner;
    }
    set i = i +wrap 1_u64;
  }
  return sum;
}
