fn probe(b: own buffer<u8>) -> result: own u64 pure {
  doc "PROOF-1 positive: a harmless nested match does not break dominance.";
  let m = len_of(b);
  let i = 0_u64;
  let sum = 0_u64;
  loop @scan {
    if i >= m {
      break @scan;
    }
    if i == i {
      let x = b[i];
      let x64 = cvt::<u8, u64>(x);
      set sum = sum +wrap x64;
    }
    set i = i +wrap 1_u64;
  }
  return sum;
}
