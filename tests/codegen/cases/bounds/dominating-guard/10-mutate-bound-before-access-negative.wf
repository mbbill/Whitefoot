fn probe(b: own buffer<u8>) -> result: own u64 pure {
  doc "PROOF-1 negative: mutating the len-derived bound invalidates its provenance.";
  let m = len(b);
  let i = 0_u64;
  let sum = 0_u64;
  loop @scan {
    if i >= m {
      break @scan;
    }
    set m = m +wrap 1_u64;
    let x = b[i];
    let x64 = cvt::<u8, u64>(x);
    set sum = sum +wrap x64;
    set i = i +wrap 1_u64;
  }
  return sum;
}
