fn probe(b: own buffer<u8>) -> result: own u64 pure {
  doc "PROOF-1 negative: guarding i does not license the derived index i + 1.";
  let m = len(b);
  let i = 0_u64;
  let sum = 0_u64;
  loop @scan {
    if ige(i, m) {
      break @scan;
    }
    let j = i +wrap 1_u64;
    let x = b[j];
    let x64 = cvt<u8, u64>(x);
    set sum = sum +wrap x64;
    set i = i +wrap 1_u64;
  }
  return sum;
}
