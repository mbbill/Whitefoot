struct Wrap {
  out: buffer<u8>;
}

fn probe['r](w: &uniq 'r Wrap, src: own buffer<u8>) -> result: own u64 writes(w.out) {
  let n = len(src);
  let i = 0_u64;
  let o = 0_u64;
  loop @groups {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @groups;
    }
    set deref(w).out[o] = 0_u8;
    set i = i +wrap 3_u64;
    set o = o +wrap 4_u64;
  }
  return o;
}
