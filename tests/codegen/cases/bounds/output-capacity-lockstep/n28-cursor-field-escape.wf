struct Cursor {
  o: u64;
}

fn probe['r](out: &uniq 'r buffer<u8>, src: own buffer<u8>) -> result: own u64 writes('r) {
  let n = len(src);
  let i = 0_u64;
  let c = Cursor(o: 0_u64);
  loop @groups {
    let rem = n -wrap i;
    if ilt(rem, 3_u64) {
      break @groups;
    }
    set deref(out)[c.o] = 0_u8;
    set i = i +wrap 3_u64;
    set c.o = c.o +wrap 4_u64;
  }
  return c.o;
}
