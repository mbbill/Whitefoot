fn put(x: &uniq u8) -> result: own unit writes(x) {
  set deref(x) = 0_u8;
  return unit;
}

fn probe(out: &uniq buffer<u8>, src: own buffer<u8>) -> result: own u64 writes(out) {
  let n = len_of(src);
  let i = 0_u64;
  let o = 0_u64;
  loop @groups {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @groups;
    }
    region {
      put(x: &uniq deref(out)[o]);
    }
    set i = i +wrap 3_u64;
    set o = o +wrap 4_u64;
  }
  return o;
}
