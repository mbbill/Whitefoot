fn probe['r](out: &uniq 'r buffer<u8>, src: own buffer<u8>) -> result: own u64 writes(out), allocates(heap) contract {
  define out_len = len(deref(out));
  define src_len = len(src);
  define groups = ishr.wrap(out_len, 2_u32);
  define covered = groups *wrap 3_u64;
  requires ile(src_len, covered);
} {
  let n = len(src);
  let i = 0_u64;
  let o = 0_u64;
  loop @groups {
    let rem = n -wrap i;
    if ilt(rem, 3_u64) {
      break @groups;
    }
    let scratch_full = buffer_new(18446744073709551615_u64, 0_u64);
    let o1 = o +wrap 1_u64;
    let o2 = o +wrap 2_u64;
    let o3 = o +wrap 3_u64;
    set deref(out)[o] = 0_u8;
    set deref(out)[o1] = 1_u8;
    set deref(out)[o2] = 2_u8;
    set deref(out)[o3] = 3_u8;
    set i = i +wrap 3_u64;
    set o = o +wrap 4_u64;
  }
  let tail = n -wrap i;
  if ieq(tail, 1_u64) {
    let scratch_one = buffer_new(18446744073709551615_u64, 0_u64);
    let a1 = o +wrap 1_u64;
    let a2 = o +wrap 2_u64;
    let a3 = o +wrap 3_u64;
    set deref(out)[o] = 4_u8;
    set deref(out)[a1] = 5_u8;
    set deref(out)[a2] = 6_u8;
    set deref(out)[a3] = 7_u8;
    set o = o +wrap 4_u64;
  }
  if ieq(tail, 2_u64) {
    let scratch_two = buffer_new(18446744073709551615_u64, 0_u64);
    let b1 = o +wrap 1_u64;
    let b2 = o +wrap 2_u64;
    let b3 = o +wrap 3_u64;
    set deref(out)[o] = 8_u8;
    set deref(out)[b1] = 9_u8;
    set deref(out)[b2] = 10_u8;
    set deref(out)[b3] = 11_u8;
    set o = o +wrap 4_u64;
  }
  return o;
}
