fn probe['r, 's](out: &uniq 'r buffer<u8>, aux: &uniq 's buffer<u8>, src: own buffer<u8>) -> result: own u64 writes(out, aux) contract {
  define out_len = len(deref(out));
  define src_len = len(src);
  define groups = ishr.wrap(out_len, 2_u32);
  define covered = groups *wrap 3_u64;
  requires ile(src_len, covered);
} {
  let n = len(src);
  let i = 0_u64;
  let o = 0_u64;
  loop @groups {
    let rem = n -wrap i;
    if ilt(rem, 3_u64) {
      break @groups;
    }
    set deref(out)[o] = 0_u8;
    set deref(aux)[0_u64] = 1_u8;
    set i = i +wrap 3_u64;
    set o = o +wrap 4_u64;
  }
  let tail = n -wrap i;
  if ieq(tail, 1_u64) {
    set o = o +wrap 4_u64;
  }
  if ieq(tail, 2_u64) {
    set o = o +wrap 4_u64;
  }
  return o;
}
