fn main() -> status: own ExitStatus pure {
  doc "[ENT-2] the implicit len = N of an Array<T, N> place holds at every program point. An element read feeding a branch condition puts a join on the path, and the OP-11 swap of the arrays' root bindings then kills every relation supported by those places [ENT-5]. The length equality is a function of the place's type rather than a fact that had to survive, so closure still discharges the later subscripts [ENT-4, OP-4]; the program observes the exchanged values and exits 0.";
  let samples = array_filled::<u32, 4>(value: 1_u32);
  let before = samples[0_u64];
  if before == 1_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let fresh = array_filled::<u32, 4>(value: 9_u32);
  swap(first: &samples, second: &fresh);
  let after = samples[0_u64];
  if after == 9_u32 {
  } else {
    return exit_status(code: 2_u8);
  }
  let restored = fresh[0_u64];
  if restored == 1_u32 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
