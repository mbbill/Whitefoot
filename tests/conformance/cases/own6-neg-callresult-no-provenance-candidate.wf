fn pick['r](a: &uniq 'r i32, b: &uniq 'r i32) -> &uniq 'r i32 pure {
  return &uniq 'r deref(a);
}

fn main() -> own unit pure {
  doc "OWN-6 reborrow extension, the still-illegal form: a call-result borrow is a holder only when the callee signature determines exactly one provenance-candidate parameter. `pick` writes two parameters as uniq borrows in the result's formal region, so no candidate is determined, the result holder would have no single resolved root, and binding it is a hard error citing OWN-6. The restructuring is to give the callee exactly one parameter written as a borrow of the result's mode and region, or to bind the borrow from a direct borrow expression.";
  let v = 1_i32;
  let w = 2_i32;
  region 'a {
    let ha = &uniq 'a v;
    let hb = &uniq 'a w;
    let r = pick<'a>(a: &uniq 'a deref(ha), b: &uniq 'a deref(hb));
  }
  return unit;
}
