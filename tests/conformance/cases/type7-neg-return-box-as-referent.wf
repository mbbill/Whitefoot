fn read(holder: own Box<i32>) -> function_result: own i32 pure {
  doc "TYPE-7: returning a cell where its content type is required is the missing dereference; the mechanical fix is move deref(holder), and transferring the cell itself is a distinct affine move.";
  return move holder;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
