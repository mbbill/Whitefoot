fn get(b: own buffer<u8>, start: own u64) -> result: own u8 pure {
  doc "A fact dies at a `set` commit whose resolved target overlaps the resolved place of any support member [ENT-5](a). The checked branch bounds `offset`, the later `set` to that same binding kills the bound, and no source re-establishes one for a `set` right-hand side, so the subscript is undischarged [OP-4].";
  let room = len(b);
  let offset = 0_u64;
  let inside = ilt(offset, room);
  if inside {
  } else {
    return 0_u8;
  }
  set offset = start;
  return b[offset];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
