fn length(values: &Slots<u8, 8>) -> result: own u64 reads(values) {
  doc "A measure read is a place form that performs no operation [OP-15, MSR-1]; the guarded element read beside it is what exhibits reads(values), and the declared row states exactly that.";
  let n = values.len;
  let guarded = n > 0_u64;
  if guarded {
    let first = values[0_u64];
  }
  return n;
}

fn main() -> status: own ExitStatus pure {
  doc "No construction is needed to exercise the declared row.";
  return exit_status(code: 0_u8);
}
