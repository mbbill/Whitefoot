enum Flag {
  A();
  B();
}

fn main() -> own unit traps {
  doc "OWN-1 copy vs affine: i32 n is reused three times (copy on use); the enum is consumed by exactly one match (affine).";
  let n = 14_i32;
  let s = n + n;
  let t = s + n;
  check ieq(t, 42_i32) else trap "copy drift";
  let f = A();
  match f {
    A() => {
    }
    B() => {
      check ieq(0_i32, 1_i32) else trap "b";
    }
  }
  return unit;
}
