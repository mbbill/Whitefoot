fn exchange(target: &uniq box<u64>, incoming: own box<u64>) -> previous: own box<u64> reads(target), writes(target) {
  let previous = replace deref(target) = move incoming;
  return move previous;
}

fn observe(owner: &uniq box<u64>, incoming: own box<u64>) -> (old: own u64, current: own u64) reads(owner), writes(owner) {
  region {
    let previous = exchange(target: &uniq deref(owner), incoming: move incoming);
    let old = deref(previous);
    let current = deref(deref(owner));
    return old, current;
  }
}

fn tick(value: &uniq u64) -> result: own unit reads(value), writes(value) {
  set deref(value) = deref(value) +wrap 1_u64;
  return unit;
}

fn repeat(value: &uniq u64) -> result: own unit reads(value), writes(value) {
  let index = 0_u64;
  loop @again {
    if index == 2_u64 {
      break @again;
    }
    tick(value: &uniq deref(value));
    set deref(value) = deref(value) +wrap 1_u64;
    set index = index +wrap 1_u64;
  }
  return unit;
}

fn acquire_twice['s](store: &uniq Heap<'s>) -> result: own u64 reads(store), writes(store), allocates(store) {
  region {
    let first = heap_box(store: &uniq deref(store), value: 31_u64);
    let second = heap_box(store: &uniq deref(store), value: 47_u64);
    match first {
      Err(error: back) => {
        return 0_u64;
      }
      Ok(value: left) => {
        match second {
          Err(error: back) => {
            return 0_u64;
          }
          Ok(value: right) => {
            return deref(left) +wrap deref(right);
          }
        }
      }
    }
  }
}

fn main['heap](heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "OWN-6: an argument child uses a local region as its type ceiling, while statement-end retirement permits sequential calls and keeps owned results alive.";
  let owner = box_new(17_u64);
  let incoming = box_new(29_u64);
  region {
    let (old, current) = observe(owner: &uniq owner, incoming: move incoming);
    if old != 17_u64 {
      return exit_status(code: 1_u8);
    }
    if current != 29_u64 {
      return exit_status(code: 2_u8);
    }
  }
  if deref(owner) != 29_u64 {
    return exit_status(code: 3_u8);
  }
  let count = 0_u64;
  region {
    repeat(value: &uniq count);
    let sum = acquire_twice(store: &uniq heap);
    if sum != 78_u64 {
      return exit_status(code: 4_u8);
    }
  }
  if count != 4_u64 {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
