fn passthru['r0](x: &uniq 'r0 i32) -> result: &uniq 'r0 i32 pure {
  return &uniq 'r0 deref(x);
}

fn twice['q0](x: &uniq 'q0 i32) -> result: &uniq 'q0 i32 pure {
  let r = passthru(x: &uniq 'q0 deref(x));
  return &uniq 'q0 deref(r);
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
