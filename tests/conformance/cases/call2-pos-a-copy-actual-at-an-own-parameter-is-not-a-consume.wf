fn get_bounded(window: own Slice<u8>, i: own u64) -> value: own u8 reads(window) contract {
  define spare = len_of(window);
  requires i < spare;
} {
  doc "Reads one element of a view handed over by value.";
  return window[i];
}

command fn main() -> status: own ExitStatus pure {
  doc "[CALL-2] an own argument is a consuming use only where its type is affine or linear. A Slice is copy [OWN-1], so handing it at an own parameter is a duplicate and neither the caller's place nor any fact supported by it dies: the second call proves its own requirement from the same length the formation published, which a consume would have killed. This is the sentence that lets a view-taking helper be called more than once, and it is what a run passed by value does not get.";
  let line = fixed_vector::<u8, 4>();
  set line = place_back(vector: move line, value: 7_u8);
  set line = place_back(vector: move line, value: 9_u8);
  region {
    let window = slice_of(&line);
    let first = get_bounded(window: window, i: 0_u64);
    let second = get_bounded(window: window, i: 1_u64);
    if first == 7_u8 {
    } else {
      return exit_status(code: 201_u8);
    }
    if second == 9_u8 {
    } else {
      return exit_status(code: 202_u8);
    }
  }
  return exit_status(code: 0_u8);
}
