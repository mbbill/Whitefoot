fn component() -> made: own FixedVector<u8, 16> pure contract {
  ensures len_of(made) >= 16_u64;
  ensures room_of(made) <= 0_u64;
  ensures head_of(made) <= 0_u64;
} {
  doc "The destination is hoisted above the loop and the fold reads its whole capacity rather than the prefix the transfer defined, so the bytes beyond the short read are the previous iteration's. PAR-3 denies: the body writes storage the iteration does not introduce and a may-suspend call retains a borrow of it, and this version replicates only storage the body itself constructs. The reported condition is 3 over the view surface as over the buffer one, because the destination view resolves to the run it was formed over [VIEW-1].";
  let built = fixed_vector::<u8, 16>();
  for @fill (
    at in 0_u64..16_u64,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= 16_u64,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: 97_u8);
  }
  return move built;
}

fn fold_prefix(source: own Slice<u8>, produced: own u64, seed: own u64) -> result: own u64 reads(source) {
  doc "Folds one read prefix into a running order-sensitive checksum.";
  let spare = len_of(source);
  let sum = seed;
  let at = 0_u64;
  loop @fold {
    let scanned = at >= produced;
    if scanned {
      break @fold;
    }
    let readable = at < spare;
    if readable {
    } else {
      break @fold;
    }
    let byte = source[at];
    let widened = cvt::<u8, u64>(byte);
    set sum = sum *wrap 31_u64;
    set sum = sum +wrap widened;
    set at = at +wrap 1_u64;
  }
  return sum;
}

command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  doc "The destination is hoisted above the loop and the fold reads its whole capacity rather than the prefix the transfer defined, so the bytes beyond the short read are the previous iteration's. PAR-3 denies: the body writes storage the iteration does not introduce and a may-suspend call retains a borrow of it, and this version replicates only storage the body itself constructs. The reported condition is 3 over the view surface as over the buffer one, because the destination view resolves to the run it was formed over [VIEW-1].";
  region 'w {
    let workspace = arena_frame::<64, 1, 'w>();
    region {
      let data = arena_vector_proved::<u8>(store: &uniq workspace, count: 64_u64);
      for @prime (
        at in 0_u64..64_u64,
        invariant grown: len_of(data) >= at,
        invariant spare: room_of(data) + at >= 64_u64,
        invariant flat: head_of(data) <= 0_u64
      ) {
        set data = place_back(vector: move data, value: 0_u8);
      }
      let name = component();
      let total = 0_u64;
      for @scan (index in 0_u64..4_u64) {
        match reserve_handle(factory: &uniq files) {
          Ok(value: permit) => {
            let window = slice_of(&name);
            region {
              match open_file(permit: move permit, root: &cwd, name: &window, start: 0_u64, end: 4_u64) {
                FileOpened(value: handle) => {
                  region 'h {
                    region {
                      let destination = mut_slice_of(&uniq data);
                      region {
                        match read_at(file: &'h handle, destination: &uniq destination, file_offset: 0_u64, start: 0_u64, end: 64_u64) {
                          ReadBytes(next: produced) => {
                          }
                          ReadEnd() => {
                          }
                          ReadFailed(error: problem) => {
                          }
                        }
                      }
                    }
                    let digest = 0_u64;
                    region {
                      let source = slice_of(&data);
                      set digest = fold_prefix(source: source, produced: 64_u64, seed: 0_u64);
                    }
                    set total = total +wrap digest;
                  }
                }
                FileOpenFailed(error: problem, permit: refused) => {
                }
              }
            }
          }
          Err(error: spent) => {
            return exit_status(code: 1_u8);
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
