fn fold_prefix['b](source: &'b buffer<u8>, produced: own u64, seed: own u64) -> result: own u64 reads(source) {
  doc "Folds one read prefix into a running order-sensitive checksum.";
  let room = len(deref(source));
  let sum = seed;
  let at = 0_u64;
  loop @fold {
    let scanned = ige(at, produced);
    if scanned {
      break @fold;
    }
    let readable = ilt(at, room);
    if readable {
    } else {
      break @fold;
    }
    let byte = deref(source)[at];
    let widened = cvt<u8, u64>(byte);
    set sum = sum *wrap 31_u64;
    set sum = sum +wrap widened;
    set at = at +wrap 1_u64;
  }
  return sum;
}

command fn main(command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files), allocates(heap) {
  doc "The destination is hoisted above the loop and the fold reads its whole capacity rather than the prefix the transfer defined, so the bytes beyond the short read are the previous iteration's. PAR-3 denies: the body writes storage the iteration does not introduce and a may-suspend call retains a borrow of it, and this version replicates only storage the body itself constructs.";
  let name = buffer_new(16_u64, 97_u8);
  let data = buffer_new(64_u64, 0_u8);
  let total = 0_u64;
  for @scan index in 0_u64..4_u64 {
    region 'f {
      let permit = reserve_file<'f>(factory: &uniq 'f files);
      region 'n {
        match open_file<'f, 'n>(permit: move permit, root: &'f cwd, name: &'n name, start: 0_u64, end: 4_u64) {
          Ok(value: handle) => {
            region 'h {
              region 'd {
                match read_at<'h, 'd>(file: &'h handle, destination: &uniq 'd data, file_offset: 0_u64, start: 0_u64, end: 64_u64) {
                  ReadBytes(next: produced) => {
                    let digest = 0_u64;
                    region 'fold {
                      set digest = fold_prefix<'fold>(source: &'fold data, produced: 64_u64, seed: 0_u64);
                    }
                    set total = total +wrap digest;
                  }
                  ReadEnd() => {
                  }
                  ReadFailed(error: problem) => {
                  }
                }
              }
            }
          }
          Err(error: problem) => {
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
