struct Pair {
  left: u64;
  right: u64;
}

formal Touch {
  fn touch(value: &Pair) -> result: own unit reads(value.left), writes(value.right);
}

fn apply(input: &Pair) -> result: own unit writes(input.left) {
  doc "Formal and actual effect paths compare parameter and field ordinals, not binder spelling; selecting another field is a mismatch.";
  let observed = deref(input).left;
  set deref(input).left = observed;
  return unit;
}

actual PairTouch : Touch {
  touch = apply;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
