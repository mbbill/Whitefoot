fn get(b: own buffer<u8>, i: own u64, j: own u64) -> result: own u8 reads(b) {
  doc "Closure rule (1): ordinary executed control establishes i at most j and j below room, from which ENT-4 derives i below room and discharges the subscript [OP-4]. No unchecked conclusion stands in for either caller-dependent branch.";
  let room = len(b);
  let ordered = ile(i, j);
  if ordered {
    let inside = ilt(j, room);
    if inside {
      return b[i];
    }
  }
  return 0_u8;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
