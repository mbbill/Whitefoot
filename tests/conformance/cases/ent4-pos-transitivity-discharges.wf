fn get(b: own buffer<u8>, i: own u64, j: own u64) -> own u8 traps {
  doc "Closure rule (1): from `i - j <= 0` and `j - room <= -1` the least closure derives `i - room <= -1` [ENT-4]. Neither claim states the obligation directly; the derivation is what discharges the subscript [OP-4].";
  let room = len(b);
  let ordered = ile(i, j);
  claim the_offsets_are_out_of_order: ordered because "the offsets are out of order";
  let inside = ilt(j, room);
  claim the_upper_offset_is_out_of_range: inside because "the upper offset is out of range";
  return b[i];
}

fn main() -> own unit pure {
  return unit;
}
