fn choose(b: own Bool) -> own Result<u64, u64> pure {
  let result = if b {
    give Ok<u64, u64>(value: 1_u64);
  } else {
    give Err<u64, u64>(error: 2_u64);
  }
  return move result;
}

fn main() -> own unit traps {
  let true_atom_0001 = True();
  let first = choose(b: true_atom_0001);
  match move first {
    Ok(value: ok_value) => {
      claim wrong_ok_payload: ieq(ok_value, 1_u64) because "wrong Ok payload";
    }
    Err(error: ok_error) => {
      claim expected_ok: False() because "expected Ok";
    }
  }
  let false_atom_0002 = False();
  let second = choose(b: false_atom_0002);
  match move second {
    Ok(value: err_value) => {
      claim expected_err: False() because "expected Err";
    }
    Err(error: err_error) => {
      claim wrong_err_payload: ieq(err_error, 2_u64) because "wrong Err payload";
    }
  }
  return unit;
}
