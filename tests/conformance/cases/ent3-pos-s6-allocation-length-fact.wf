fn main['heap](heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "Source S6: `heap_vector::<T>(store, count)` establishes cap_of(r) = count and room_of(r) = count on its Some continuation [ENT-3, BLK-2], and the copy equality of source S5 carries the literal into count, so each placement discharges its room requirement and a constant offset below the window the placements built discharges [OP-4]. The capacity is a declared allocation property, not a writer statement.";
  let size = 4_u64;
  region {
    match heap_vector::<u8>(store: &uniq heap, count: size) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        region {
          place_back(vector: &uniq fresh, value: 0_u8);
        }
        let one = move fresh;
        region {
          place_back(vector: &uniq one, value: 0_u8);
        }
        let two = move one;
        region {
          place_back(vector: &uniq two, value: 0_u8);
        }
        let b = move two;
        let value = b[2_u64];
        return exit_status(code: 0_u8);
      }
    }
  }
}
