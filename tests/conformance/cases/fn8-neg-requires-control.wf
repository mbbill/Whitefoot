fn control(x: own i32) -> result: own i32 pure contract {
  define permitted = ige(x, 0_i32);
  return x;
  requires permitted;
} {
  doc "Control transfer is forbidden in a requirement clause [FN-8].";
  return x;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
