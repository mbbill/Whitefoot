fn find_byte(input: own Slice<u8>, needle: own u8) -> function_result: own Option<u64> reads(input) {
  let length = len_of(input);
  for (offset in 0_u64..length) {
    let byte = input[offset];
    let found = byte == needle;
    if found {
      return Some<u64>(value: offset);
    }
  }
  return None<u64>();
}

command fn main() -> status: own ExitStatus pure {
  let bytes = fixed_vector::<u8, 6>();
  set bytes = place_back(vector: move bytes, value: 10_u8);
  set bytes = place_back(vector: move bytes, value: 20_u8);
  set bytes = place_back(vector: move bytes, value: 30_u8);
  set bytes = place_back(vector: move bytes, value: 40_u8);
  set bytes = place_back(vector: move bytes, value: 50_u8);
  set bytes = place_back(vector: move bytes, value: 60_u8);
  region {
    let view = slice_of(&bytes);
    let present = find_byte(input: view, needle: 40_u8);
    match move present {
      None() => {
        return exit_status(code: 1_u8);
      }
      Some(value: present_offset) => {
        let expected_offset = present_offset == 3_u64;
        if expected_offset {
        } else {
          return exit_status(code: 2_u8);
        }
      }
    }
    let missing = find_byte(input: view, needle: 99_u8);
    match move missing {
      None() => {
      }
      Some(value: missing_offset) => {
        return exit_status(code: 3_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
