fn find_byte['r](input: &'r buffer<u8>, needle: own u8) -> function_result: own Option<u64> reads('r), traps {
  let length = len(deref(input));
  let offset = 0_u64;
  loop @scan {
    let done = ieq(offset, length);
    if done {
      break @scan;
    } else {
      let room = len(deref(input));
      let in_range = ilt(offset, room);
      claim offset_in_range: in_range because "premises: offset starts at zero, advances by one only after a failed comparison, and this loop branch establishes offset differs from the unchanged input length\nderivation: the loop progression cannot skip the equality boundary, so offset is strictly below room, which is the same unchanged buffer length\nconclusion: in_range is true on every iteration reaching the read\nchecker gap: ENT does not derive the strict loop range from initialization, unit progression, and the equality exit\nconsumers: the following input subscript requires this exact upper Range component";
      let byte = deref(input)[offset];
      let found = ieq(byte, needle);
      if found {
        return Some<u64>(value: offset);
      } else {
        set offset = offset +wrap 1_u64;
      }
    }
  }
  return None<u64>();
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let bytes = buffer_new(6_u64, 0_u8);
  set bytes[0_u64] = 10_u8;
  set bytes[1_u64] = 20_u8;
  set bytes[2_u64] = 30_u8;
  set bytes[3_u64] = 40_u8;
  set bytes[4_u64] = 50_u8;
  set bytes[5_u64] = 60_u8;
  region 'scan_region {
    let view = &'scan_region bytes;
    let present = find_byte<'scan_region>(input: view, needle: 40_u8);
    match move present {
      None() => {
        return exit_status(code: 1_u8);
      }
      Some(value: present_offset) => {
        let expected_offset = ieq(present_offset, 3_u64);
        if expected_offset {
        } else {
          return exit_status(code: 2_u8);
        }
      }
    }
    let missing = find_byte<'scan_region>(input: view, needle: 99_u8);
    match move missing {
      None() => {
      }
      Some(value: missing_offset) => {
        return exit_status(code: 3_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
