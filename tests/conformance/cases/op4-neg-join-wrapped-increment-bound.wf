fn get(b: own Slice<u8>, i: own u64, pick: own Bool) -> result: own u8 reads(b) {
  let spare = len_of(b);
  if pick {
    let stepped = i +wrap 1_u64;
    let inside = spare >= stepped;
    if inside {
    } else {
      return 0_u8;
    }
  } else {
    let inside2 = i < spare;
    if inside2 {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
