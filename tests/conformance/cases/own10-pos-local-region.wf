command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-10: an own binding may be borrowed into a region within its scope.";
  let a = 4_i32;
  region 'r {
    let p = &'r a;
    if ieq(deref(p), 4_i32) {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
