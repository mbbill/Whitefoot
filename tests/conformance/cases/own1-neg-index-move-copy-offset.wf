command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-1 applies inside an index place: a u64 offset is Copy and cannot be written with move.";
  let empty = fixed_vector::<u8, 2>();
  let one = place_back(vector: move empty, value: 0_u8);
  let items = place_back(vector: move one, value: 0_u8);
  let offset = 0_u64;
  let value = items[move offset];
  return exit_status(code: 0_u8);
}
