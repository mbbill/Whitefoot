fn drain(cell: own buffer<u8>) -> code: own u8 pure {
  doc "PROV-6, EFF-2: the same body with the row left `pure`. The scope-exit release of an own parameter carries the empty row and this compiler emits it under none, so `pure` is exactly what the writer would have declared before this statement existed; the early release is refused until the row says so.";
  dispose cell;
  return 4_u8;
}

command fn main() -> status: own ExitStatus pure {
  doc "The caller.";
  let run = buffer_new(4_u64, 0_u8);
  let code = drain(cell: move run);
  return exit_status(code: code);
}
