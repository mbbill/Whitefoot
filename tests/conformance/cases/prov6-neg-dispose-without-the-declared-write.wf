fn drain['s](store: &uniq Heap<'s>, cell: own Vector<'s, u8>) -> code: own u8 pure {
  doc "PROV-6, EFF-2: the same body with the row left `pure`. The scope-exit release of an own parameter carries the empty row and this compiler emits it under none, so `pure` is exactly what the writer would have declared before this statement existed; the early release is refused until the row says so.";
  dispose cell;
  return 4_u8;
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "The caller.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: run) => {
        region {
          let code = drain(store: &uniq heap, cell: move run);
          return exit_status(code: code);
        }
      }
    }
  }
}
