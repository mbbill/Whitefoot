fn filled<T: copy, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

fn probe(taken: own FixedVector<u8, 8>) -> (outcome: own Result<u64, Overflow>, spare: own u64) reads(taken) contract {
  ensures when outcome is Ok(value: reported): reported == len_of(taken);
  ensures spare == len_of(taken);
} {
  doc "One route names the enum ordinal it applies to; the unrouted clause names the other.";
  let measured = len_of(taken);
  return Ok<u64, Overflow>(value: measured), measured;
}

fn needs_eight(bound: own u64) -> ok: own unit pure contract {
  requires 8_u64 <= bound;
} {
  doc "Needs a caller proof about its argument.";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "CALL-4: a route names a result ordinal, an unrouted clause over another ordinal reaches its binder, and both arms of the match on the routed ordinal are written.";
  let run = filled::<u8, 8>(value: 0_u8);
  let (outcome, spare) = probe(taken: move run);
  let confirmed = needs_eight(bound: spare);
  match outcome {
    Ok(value: reported) => {
      return exit_status(code: 0_u8);
    }
    Err(error: failure) => {
      return exit_status(code: 1_u8);
    }
  }
}
