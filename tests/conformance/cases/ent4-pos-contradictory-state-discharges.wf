fn get(b: own buffer<u8>, j: own u64) -> result: own u8 pure {
  doc "The former fixture used a knowingly incompatible claim and branch to reach an explosive state. This replacement admits the subscript only on ordinary executed control that establishes its real bound; claims cannot manufacture unreachable proof authority.";
  let room = len(b);
  let inside = ilt(j, room);
  if inside {
    return b[j];
  }
  return 0_u8;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
