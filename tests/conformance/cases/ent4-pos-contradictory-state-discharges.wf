fn get(b: own buffer<u8>, i: own u64) -> own u8 traps {
  doc "A state is contradictory when `t - t <= -1` is derivable for any t; at a contradictory point every relation is derivable and every obligation is discharged [ENT-4]. Two executed checks that cannot both pass put the continuation there, and the subscript accepts on a path no execution reaches.";
  let room = len(b);
  let above = igt(i, room);
  check above else trap "offset not above the length";
  let below = ilt(i, room);
  check below else trap "offset not below the length";
  return b[i];
}

fn main() -> own unit pure {
  return unit;
}
