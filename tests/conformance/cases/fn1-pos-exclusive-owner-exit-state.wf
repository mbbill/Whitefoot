struct Observed {
  previous: u64;
  current: u64;
}

fn exchange(slot: &Box<u64>, spare: &Box<u64>) -> result: own unit writes(slot), writes(spare) {
  doc "The exchange is `swap`: it moves the two stored owners past each other, consumes neither root, and leaves no program point at which a place holds no owner [OP-11].";
  swap(first: slot, second: spare);
  return unit;
}

fn observe(owner: &Box<u64>, spare: &Box<u64>) -> result: own Observed writes(owner), writes(spare) {
  doc "Reads the owner's content before and after the exchange through ordinary storage places [TYPE-7].";
  let started = deref(owner);
  exchange(slot: owner, spare: spare);
  let current = deref(owner);
  return Observed(previous: started, current: current);
}

fn main() -> status: own ExitStatus pure {
  doc "FN-1, EFF-2, OP-11: a helper exchanges the contents of two cells through references and the caller observes both values. Each cell is released by the compiler-derived scope exit [STOR-3]; there is one heap and no store value to name [STOR-8].";
  let owner = box_new::<u64>(value: 11_u64);
  let incoming = box_new::<u64>(value: 22_u64);
  let seen = observe(owner: &owner, spare: &incoming);
  if seen.previous != 11_u64 {
    return exit_status(code: 1_u8);
  }
  if seen.current != 22_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
