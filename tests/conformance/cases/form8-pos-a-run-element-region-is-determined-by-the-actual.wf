fn width_of['s: affine](blocks: &uniq FixedVector<Vector<'s, u8>, 4>) -> taken: own Option<Vector<'s, u8>> reads(blocks), writes(blocks) contract {
  ensures head_of(deref(blocks)) == head_of(deref(entry(blocks)));
  ensures len_of(deref(blocks)) <= len_of(deref(entry(blocks)));
} {
  doc "Takes one store-backed block off the back of a run of runs, generic over the store.";
  let held = len_of(deref(blocks));
  let any = held > 0_u64;
  if any {
    region {
      let one = take_back(vector: &uniq deref(blocks));
      return Some<Vector<'s, u8>>(value: move one);
    }
  }
  return None<Vector<'s, u8>>();
}

command fn main() -> status: own ExitStatus pure {
  doc "FORM-8: a formal region occupying a parameter position at any depth of its type is determined by the actual and is not written at the call. The lift puts a store region one level down, in a run's element type, and that position determines it exactly as a top-level one does, which is what lets a helper be generic over the store of the runs a run holds.";
  region 'a {
    let workspace = arena_frame::<1024, 16, 'a>();
    region {
      let blocks = fixed_vector::<Vector<'a, u8>, 4>();
      let block = arena_vector_proved::<u8>(store: &uniq workspace, count: 16_u64);
      region {
        place_back(vector: &uniq blocks, value: move block);
      }
      let one = move blocks;
      region {
        let taken = width_of(blocks: &uniq one);
        match taken {
          None() => {
            return exit_status(code: 1_u8);
          }
          Some(value: got) => {
            let width = cap_of(got);
            if width == 16_u64 {
            } else {
              return exit_status(code: 2_u8);
            }
          }
        }
        let left = len_of(one);
        if left == 0_u64 {
        } else {
          return exit_status(code: 3_u8);
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
