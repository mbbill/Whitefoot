command fn main() -> return_value: own ExitStatus pure {
  doc "GRAM-4: let, region, loop, match(stmt), break, set, give(let-match), if, return statements.";
  let i = 0_i32;
  region 'r {
    loop @l {
      if i >= 3_i32 {
        break @l;
      }
      set i = i +wrap 1_i32;
    }
  }
  let d = if i == 3_i32 {
    give 7_i32;
  } else {
    give 0_i32;
  }
  if d == 7_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
