command fn main() -> return_value: own ExitStatus traps {
  doc "GRAM-4: let, region, loop, match(stmt), break, set, give(let-match), claim, return statements.";
  let i = 0_i32;
  region 'r {
    loop @l {
      if ige(i, 3_i32) {
        break @l;
      }
      set i = i +wrap 1_i32;
    }
  }
  let d = if ieq(i, 3_i32) {
    give 7_i32;
  } else {
    give 0_i32;
  }
  claim bad: ieq(d, 7_i32) because "bad";
  return exit_status(code: 0_u8);
}
