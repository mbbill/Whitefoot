fn main() -> own unit traps {
  doc "GRAM-4: let, region, loop, match(stmt), break, set, give(let-match), check, return statements.";
  let i = 0_i32;
  region 'r {
    loop @l {
      if ige(i, 3_i32) {
        break @l;
      }
      set i = i +wrap 1_i32;
    }
  }
  let d = if ieq(i, 3_i32) {
    give 7_i32;
  } else {
    give 0_i32;
  }
  check ieq(d, 7_i32) else trap "bad";
  return unit;
}
