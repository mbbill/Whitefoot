command fn main() -> status: own ExitStatus pure {
  doc "SET-1, BLK-1: a subscript of a run is a set target, and the slot it commits to is the window's, not the array's.";
  let empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq empty, value: 1_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 2_u8);
  }
  let two = move one;
  region {
    place_back(vector: &uniq two, value: 3_u8);
  }
  let three = move two;
  region {
    let taken = take_front(vector: &uniq three);
    let rest = move three;
    region {
      place_back(vector: &uniq rest, value: 4_u8);
    }
    let four = move rest;
    set four[0_u64] = 9_u8;
    let first = four[0_u64];
    if first == 9_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
    let second = four[1_u64];
    if second == 3_u8 {
    } else {
      return exit_status(code: 2_u8);
    }
    let third = four[2_u64];
    if third == 4_u8 {
    } else {
      return exit_status(code: 3_u8);
    }
    let held = len_of(four);
    if held == 3_u64 {
      return exit_status(code: 0_u8);
    }
    return exit_status(code: 4_u8);
  }
}
