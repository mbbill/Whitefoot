struct Bytes['heap] {
  v: Vector<u8>;
}

struct Frame['heap] {
  flags: u64;
  page: Vector<u8>;
}

fn main['heap](heap: own Heap<'heap>) -> status: own ExitStatus pure {
  doc "PROV-1: each nominal field is branded to its enclosing nominal sole declared region, independent of program-start selection.";
  return exit_status(code: 0_u8);
}
