struct BystanderRecord {
  value: u8;
}

fn overwrite_bystander(values: &Array<BystanderRecord, 4>, index: own u64) -> result: own unit writes(values[index]) contract {
  requires index < 4_u64;
} {
  set deref(values)[index] = BystanderRecord(value: 9_u8);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}

fn inspect_join(values: &Array<BystanderRecord, 4>, i: own u64, j: own u64, k: own u64, choose: own Bool) -> result: own u8 reads(values), writes(values[j]) contract {
  requires i < j;
  requires k < j;
  requires j < 4_u64;
} {
  let first = &deref(values)[i].value;
  let second = &deref(values)[j].value;
  let selected = first;
  if choose {
    set selected = &deref(second);
  }
  overwrite_bystander(values: values, index: j);
  return deref(selected);
}
