struct Limits {
  offset: u64;
}

struct Settings {
  limits: Limits;
}

const settings: Settings = Settings(limits: Limits(offset: 1_u64));

fn main() -> status: own ExitStatus pure {
  let values = array_new::<u64, 2>(7_u64);
  let index = settings.limits.offset;
  let successor = index + 1_u64;
  let value = values[index];
  return exit_status(code: 0_u8);
}
