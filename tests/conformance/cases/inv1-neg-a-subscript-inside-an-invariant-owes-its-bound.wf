command fn main() -> status: own ExitStatus pure {
  doc "INV-1, OP-4: an invariant evaluates nothing and reads no storage, but a measure over a place whose subscripts are not all discharged is no term there either. The run below is empty, so the subscript's own `0 < len_of(table)` is underivable at the statement that writes it.";
  let table = fixed_vector::<FixedVector<u8, 4>, 2>();
  invariant flat: len_of(table[0_u64]) <= cap_of(table[0_u64]);
  return exit_status(code: 0_u8);
}
