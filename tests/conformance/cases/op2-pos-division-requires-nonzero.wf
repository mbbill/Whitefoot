fn divide(n: own u64, d: own u64) -> return_value: own u64 pure contract {
  requires d != 0_u64;
} {
  doc "The caller proves the divisor is nonzero before control enters divide. That contract fact discharges the exact division's OP-2 domain obligation.";
  let q = n / d;
  return q;
}

command fn main() -> return_value: own ExitStatus pure {
  let v = divide(n: 84_u64, d: 2_u64);
  if v == 42_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
