fn release_unproved<T: linear, const n: u64>(run: own Slots<T, n>) -> result: own unit pure {
  doc "PROV-6: a window whose element type is linear is itself linear, so no compiler-derived release carries it off the return edge. The route is to take every element out, consume each one, and then call free_empty with the window's zero length established.";
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "The rejection is in the generic template above; this entry point does nothing.";
  return exit_status(code: 0_u8);
}
