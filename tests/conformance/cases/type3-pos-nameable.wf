enum Color {
  Red();
  Green();
  Blue();
}

fn paint['r](x: &'r i32, y: &uniq 'r i32) -> function_result: own Color pure {
  doc "Every mode (own, &'r, &uniq 'r) and type has a written canonical name [TYPE-3].";
  return Red();
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
