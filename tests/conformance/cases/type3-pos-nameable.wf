enum Color {
  Red();
  Green();
  Blue();
}

fn paint(x: &i32, y: &i32) -> function_result: own Color pure {
  doc "Every mode (own and the single reference form) and every type has a written canonical name requiring no compiler execution.";
  return Red();
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
