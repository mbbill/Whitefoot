fn impossible(value: own u8) -> output: own u8 pure contract {
  requires value == 0_u8;
  requires value != 0_u8;
} {
  let values = fixed_vector::<u8, 1>();
  set values = place_back(vector: move values, value: 0_u8);
  return values[7_u64];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
