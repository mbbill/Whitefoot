const b64: array<u8, 64> =[65_u8, 66_u8, 67_u8, 68_u8, 69_u8, 70_u8, 71_u8, 72_u8, 73_u8, 74_u8, 75_u8, 76_u8, 77_u8, 78_u8, 79_u8, 80_u8, 81_u8, 82_u8, 83_u8, 84_u8, 85_u8, 86_u8, 87_u8, 88_u8, 89_u8, 90_u8, 97_u8, 98_u8, 99_u8, 100_u8, 101_u8, 102_u8, 103_u8, 104_u8, 105_u8, 106_u8, 107_u8, 108_u8, 109_u8, 110_u8, 111_u8, 112_u8, 113_u8, 114_u8, 115_u8, 116_u8, 117_u8, 118_u8, 119_u8, 120_u8, 121_u8, 122_u8, 48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8, 43_u8, 47_u8];

fn encode['r](out: &uniq 'r buffer<u8>, input: own buffer<u8>) -> own u64 reads('r), writes('r), traps requires {
  let required_out_length = len(deref(out));
  let required_input_length = len(input);
  let required_out_groups = ishr.wrap(required_out_length, 2_u32);
  let required_covered_input = required_out_groups *wrap 3_u64;
  check required_input_length <= required_covered_input else trap "base64 output capacity";
} {
  let out_room = len(deref(out));
  let input_length = len(input);
  let input_offset = 0_u64;
  let output_offset = 0_u64;
  loop @full_groups {
    let remaining = input_length -wrap input_offset;
    let short_group = ilt(remaining, 3_u64);
    if short_group {
      break @full_groups;
    } else {
      let input_one = input_offset +wrap 1_u64;
      let input_two = input_offset +wrap 2_u64;
      let group_zero_ok = ilt(input_offset, input_length);
      claim group_zero_in_input: group_zero_ok because "a full group leaves at least three input bytes";
      let byte_zero = input[input_offset];
      let group_one_ok = ilt(input_one, input_length);
      claim group_one_in_input: group_one_ok because "a full group leaves at least three input bytes";
      let byte_one = input[input_one];
      let group_two_ok = ilt(input_two, input_length);
      claim group_two_in_input: group_two_ok because "a full group leaves at least three input bytes";
      let byte_two = input[input_two];
      let word_zero = cvt<u8, u32>(byte_zero);
      let word_one = cvt<u8, u32>(byte_one);
      let word_two = cvt<u8, u32>(byte_two);
      let shifted_zero = ishl.wrap(word_zero, 16_u32);
      let shifted_one = ishl.wrap(word_one, 8_u32);
      let combined_prefix = ior(shifted_zero, shifted_one);
      let combined = ior(combined_prefix, word_two);
      let sextet_zero_shifted = ishr.wrap(combined, 18_u32);
      let sextet_zero = iand(sextet_zero_shifted, 63_u32);
      let alphabet_zero = cvt<u32, u64>(sextet_zero);
      let sextet_one_shifted = ishr.wrap(combined, 12_u32);
      let sextet_one = iand(sextet_one_shifted, 63_u32);
      let alphabet_one = cvt<u32, u64>(sextet_one);
      let sextet_two_shifted = ishr.wrap(combined, 6_u32);
      let sextet_two = iand(sextet_two_shifted, 63_u32);
      let alphabet_two = cvt<u32, u64>(sextet_two);
      let sextet_three = iand(combined, 63_u32);
      let alphabet_three = cvt<u32, u64>(sextet_three);
      let alphabet_zero_ok = ilt(alphabet_zero, 64_u64);
      claim alphabet_zero_in_table: alphabet_zero_ok because "a six-bit mask stays below the table length";
      let encoded_zero = b64[alphabet_zero];
      let alphabet_one_ok = ilt(alphabet_one, 64_u64);
      claim alphabet_one_in_table: alphabet_one_ok because "a six-bit mask stays below the table length";
      let encoded_one = b64[alphabet_one];
      let alphabet_two_ok = ilt(alphabet_two, 64_u64);
      claim alphabet_two_in_table: alphabet_two_ok because "a six-bit mask stays below the table length";
      let encoded_two = b64[alphabet_two];
      let alphabet_three_ok = ilt(alphabet_three, 64_u64);
      claim alphabet_three_in_table: alphabet_three_ok because "a six-bit mask stays below the table length";
      let encoded_three = b64[alphabet_three];
      let output_one = output_offset +wrap 1_u64;
      let output_two = output_offset +wrap 2_u64;
      let output_three = output_offset +wrap 3_u64;
      let group_out_zero_ok = ilt(output_offset, out_room);
      claim group_out_zero_in_output: group_out_zero_ok because "the requires clause sizes the output for every group";
      set deref(out)[output_offset] = encoded_zero;
      let group_out_one_ok = ilt(output_one, out_room);
      claim group_out_one_in_output: group_out_one_ok because "the requires clause sizes the output for every group";
      set deref(out)[output_one] = encoded_one;
      let group_out_two_ok = ilt(output_two, out_room);
      claim group_out_two_in_output: group_out_two_ok because "the requires clause sizes the output for every group";
      set deref(out)[output_two] = encoded_two;
      let group_out_three_ok = ilt(output_three, out_room);
      claim group_out_three_in_output: group_out_three_ok because "the requires clause sizes the output for every group";
      set deref(out)[output_three] = encoded_three;
      set input_offset = input_offset +wrap 3_u64;
      set output_offset = output_offset +wrap 4_u64;
    }
  }
  let tail_length = input_length -wrap input_offset;
  let one_byte_tail = tail_length == 1_u64;
  if one_byte_tail {
    let tail_one_in_ok = ilt(input_offset, input_length);
    claim tail_one_in_input: tail_one_in_ok because "a one-byte tail leaves one input byte";
    let tail_one_byte = input[input_offset];
    let tail_one_word = cvt<u8, u32>(tail_one_byte);
    let tail_one_first_shifted = ishr.wrap(tail_one_word, 2_u32);
    let tail_one_first_sextet = iand(tail_one_first_shifted, 63_u32);
    let tail_one_first_index = cvt<u32, u64>(tail_one_first_sextet);
    let tail_one_second_shifted = ishl.wrap(tail_one_word, 4_u32);
    let tail_one_second_sextet = iand(tail_one_second_shifted, 63_u32);
    let tail_one_second_index = cvt<u32, u64>(tail_one_second_sextet);
    let tail_one_first_ok = ilt(tail_one_first_index, 64_u64);
    claim tail_one_first_in_table: tail_one_first_ok because "a six-bit mask stays below the table length";
    let tail_one_first = b64[tail_one_first_index];
    let tail_one_second_ok = ilt(tail_one_second_index, 64_u64);
    claim tail_one_second_in_table: tail_one_second_ok because "a six-bit mask stays below the table length";
    let tail_one_second = b64[tail_one_second_index];
    let tail_one_output_one = output_offset +wrap 1_u64;
    let tail_one_output_two = output_offset +wrap 2_u64;
    let tail_one_output_three = output_offset +wrap 3_u64;
    let tail_one_out_zero_ok = ilt(output_offset, out_room);
    claim tail_one_out_zero_in_output: tail_one_out_zero_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[output_offset] = tail_one_first;
    let tail_one_out_one_ok = ilt(tail_one_output_one, out_room);
    claim tail_one_out_one_in_output: tail_one_out_one_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[tail_one_output_one] = tail_one_second;
    let tail_one_out_two_ok = ilt(tail_one_output_two, out_room);
    claim tail_one_out_two_in_output: tail_one_out_two_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[tail_one_output_two] = 61_u8;
    let tail_one_out_three_ok = ilt(tail_one_output_three, out_room);
    claim tail_one_out_three_in_output: tail_one_out_three_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[tail_one_output_three] = 61_u8;
    set output_offset = output_offset +wrap 4_u64;
  }
  let two_byte_tail = tail_length == 2_u64;
  if two_byte_tail {
    let tail_two_input_one = input_offset +wrap 1_u64;
    let tail_two_in_zero_ok = ilt(input_offset, input_length);
    claim tail_two_in_zero_in_input: tail_two_in_zero_ok because "a two-byte tail leaves two input bytes";
    let tail_two_byte_zero = input[input_offset];
    let tail_two_in_one_ok = ilt(tail_two_input_one, input_length);
    claim tail_two_in_one_in_input: tail_two_in_one_ok because "a two-byte tail leaves two input bytes";
    let tail_two_byte_one = input[tail_two_input_one];
    let tail_two_word_zero = cvt<u8, u32>(tail_two_byte_zero);
    let tail_two_word_one = cvt<u8, u32>(tail_two_byte_one);
    let tail_two_shifted_zero = ishl.wrap(tail_two_word_zero, 8_u32);
    let tail_two_combined = ior(tail_two_shifted_zero, tail_two_word_one);
    let tail_two_first_shifted = ishr.wrap(tail_two_combined, 10_u32);
    let tail_two_first_sextet = iand(tail_two_first_shifted, 63_u32);
    let tail_two_first_index = cvt<u32, u64>(tail_two_first_sextet);
    let tail_two_second_shifted = ishr.wrap(tail_two_combined, 4_u32);
    let tail_two_second_sextet = iand(tail_two_second_shifted, 63_u32);
    let tail_two_second_index = cvt<u32, u64>(tail_two_second_sextet);
    let tail_two_third_shifted = ishl.wrap(tail_two_combined, 2_u32);
    let tail_two_third_sextet = iand(tail_two_third_shifted, 63_u32);
    let tail_two_third_index = cvt<u32, u64>(tail_two_third_sextet);
    let tail_two_first_ok = ilt(tail_two_first_index, 64_u64);
    claim tail_two_first_in_table: tail_two_first_ok because "a six-bit mask stays below the table length";
    let tail_two_first = b64[tail_two_first_index];
    let tail_two_second_ok = ilt(tail_two_second_index, 64_u64);
    claim tail_two_second_in_table: tail_two_second_ok because "a six-bit mask stays below the table length";
    let tail_two_second = b64[tail_two_second_index];
    let tail_two_third_ok = ilt(tail_two_third_index, 64_u64);
    claim tail_two_third_in_table: tail_two_third_ok because "a six-bit mask stays below the table length";
    let tail_two_third = b64[tail_two_third_index];
    let tail_two_output_one = output_offset +wrap 1_u64;
    let tail_two_output_two = output_offset +wrap 2_u64;
    let tail_two_output_three = output_offset +wrap 3_u64;
    let tail_two_out_zero_ok = ilt(output_offset, out_room);
    claim tail_two_out_zero_in_output: tail_two_out_zero_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[output_offset] = tail_two_first;
    let tail_two_out_one_ok = ilt(tail_two_output_one, out_room);
    claim tail_two_out_one_in_output: tail_two_out_one_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[tail_two_output_one] = tail_two_second;
    let tail_two_out_two_ok = ilt(tail_two_output_two, out_room);
    claim tail_two_out_two_in_output: tail_two_out_two_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[tail_two_output_two] = tail_two_third;
    let tail_two_out_three_ok = ilt(tail_two_output_three, out_room);
    claim tail_two_out_three_in_output: tail_two_out_three_ok because "the requires clause sizes the output for the padded tail";
    set deref(out)[tail_two_output_three] = 61_u8;
    set output_offset = output_offset +wrap 4_u64;
  }
  return output_offset;
}

fn main() -> own unit allocates(heap), traps {
  let man_input = buffer_new(3_u64, 0_u8);
  set man_input[0_u64] = 77_u8;
  set man_input[1_u64] = 97_u8;
  set man_input[2_u64] = 110_u8;
  let man_output = buffer_new(4_u64, 0_u8);
  region 'man_region {
    let man_length = encode<'man_region>(out: &uniq 'man_region man_output, input: move man_input);
    check man_length == 4_u64 else trap "Man length drift";
  }
  let man_zero = man_output[0_u64];
  let man_one = man_output[1_u64];
  let man_two = man_output[2_u64];
  let man_three = man_output[3_u64];
  check man_zero == 84_u8 else trap "Man[0] drift";
  check man_one == 87_u8 else trap "Man[1] drift";
  check man_two == 70_u8 else trap "Man[2] drift";
  check man_three == 117_u8 else trap "Man[3] drift";
  let m_input = buffer_new(1_u64, 77_u8);
  let m_output = buffer_new(4_u64, 0_u8);
  region 'm_region {
    let m_length = encode<'m_region>(out: &uniq 'm_region m_output, input: move m_input);
    check m_length == 4_u64 else trap "M length drift";
  }
  let m_zero = m_output[0_u64];
  let m_one = m_output[1_u64];
  let m_two = m_output[2_u64];
  let m_three = m_output[3_u64];
  check m_zero == 84_u8 else trap "M[0] drift";
  check m_one == 81_u8 else trap "M[1] drift";
  check m_two == 61_u8 else trap "M[2] drift";
  check m_three == 61_u8 else trap "M[3] drift";
  let ma_input = buffer_new(2_u64, 0_u8);
  set ma_input[0_u64] = 77_u8;
  set ma_input[1_u64] = 97_u8;
  let ma_output = buffer_new(4_u64, 0_u8);
  region 'ma_region {
    let ma_length = encode<'ma_region>(out: &uniq 'ma_region ma_output, input: move ma_input);
    check ma_length == 4_u64 else trap "Ma length drift";
  }
  let ma_zero = ma_output[0_u64];
  let ma_one = ma_output[1_u64];
  let ma_two = ma_output[2_u64];
  let ma_three = ma_output[3_u64];
  check ma_zero == 84_u8 else trap "Ma[0] drift";
  check ma_one == 87_u8 else trap "Ma[1] drift";
  check ma_two == 69_u8 else trap "Ma[2] drift";
  check ma_three == 61_u8 else trap "Ma[3] drift";
  return unit;
}
