fn main() -> own unit traps {
  let false_value = False();
  let true_value = True();
  let eq00 = eeq(false_value, false_value);
  let ne00 = ene(false_value, false_value);
  claim bool_eeq_diagonal_drift: eq00 because "Bool eeq diagonal drift";
  let not_ne00 = bnot(ne00);
  claim bool_ene_diagonal_drift: not_ne00 because "Bool ene diagonal drift";
  let eq01 = eeq(false_value, true_value);
  let ne01 = ene(false_value, true_value);
  let not_eq01 = bnot(eq01);
  claim bool_eeq_off_diagonal_drift: not_eq01 because "Bool eeq off-diagonal drift";
  claim bool_ene_off_diagonal_drift: ne01 because "Bool ene off-diagonal drift";
  let eq10 = eeq(true_value, false_value);
  let ne10 = ene(true_value, false_value);
  let not_eq10 = bnot(eq10);
  claim bool_eeq_off_diagonal_drift_2: not_eq10 because "Bool eeq off-diagonal drift";
  claim bool_ene_off_diagonal_drift_2: ne10 because "Bool ene off-diagonal drift";
  let eq11 = eeq(true_value, true_value);
  let ne11 = ene(true_value, true_value);
  claim bool_eeq_diagonal_drift_2: eq11 because "Bool eeq diagonal drift";
  let not_ne11 = bnot(ne11);
  claim bool_ene_diagonal_drift_2: not_ne11 because "Bool ene diagonal drift";
  return unit;
}
