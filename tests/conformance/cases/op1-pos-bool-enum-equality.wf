fn main() -> own unit traps {
  let false_value = False();
  let true_value = True();
  let eq00 = eeq(false_value, false_value);
  let ne00 = ene(false_value, false_value);
  check eq00 else trap "Bool eeq diagonal drift";
  let not_ne00 = bnot(ne00);
  check not_ne00 else trap "Bool ene diagonal drift";
  let eq01 = eeq(false_value, true_value);
  let ne01 = ene(false_value, true_value);
  let not_eq01 = bnot(eq01);
  check not_eq01 else trap "Bool eeq off-diagonal drift";
  check ne01 else trap "Bool ene off-diagonal drift";
  let eq10 = eeq(true_value, false_value);
  let ne10 = ene(true_value, false_value);
  let not_eq10 = bnot(eq10);
  check not_eq10 else trap "Bool eeq off-diagonal drift";
  check ne10 else trap "Bool ene off-diagonal drift";
  let eq11 = eeq(true_value, true_value);
  let ne11 = ene(true_value, true_value);
  check eq11 else trap "Bool eeq diagonal drift";
  let not_ne11 = bnot(ne11);
  check not_ne11 else trap "Bool ene diagonal drift";
  return unit;
}
