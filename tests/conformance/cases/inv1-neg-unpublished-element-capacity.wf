fn take_block(free: &Slots<Box<Slots<u8>>, 2>) -> block: own Box<Slots<u8>> writes(free) contract {
  requires deref(free).len > 0_u64;
  ensures deref(free).len + 1_u64 == deref(entry(free)).len;
  ensures deref(free).room == deref(entry(free)).room + 1_u64;
} {
  doc "Takes the last stocked cell out of the pool and publishes what that did to the pool alone.";
  let block = take_back(window: free);
  return move block;
}

fn return_block(free: &Slots<Box<Slots<u8>>, 2>, block: own Box<Slots<u8>>) -> result: own unit writes(free) contract {
  requires deref(free).room > 0_u64;
  ensures deref(free).len == deref(entry(free)).len + 1_u64;
} {
  doc "Puts one cell back into the pool.";
  place_back(window: free, value: move block);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "INV-1: a verified helper exports changes to the pool but no capacity relation for the runtime-capacity window it hands back. Its caller cannot invent a four-slot capacity from the value it originally stored in that slot, so the invariant over the returned cell is the ordinary unproved target.";
  let block = box_slots_new::<u8>(capacity: 4_u64);
  let free = slots_new::<Box<Slots<u8>>, 2>();
  place_back(window: &free, value: move block);
  let taken = take_block(free: &free);
  invariant capacity: taken.inner.cap >= 4_u64;
  return_block(free: &free, block: move taken);
  return exit_status(code: 0_u8);
}
