fn take_block(pool: &Slots<Box<Slots<u8>>, 2>) -> block: own Box<Slots<u8>> writes(pool) contract {
  requires deref(pool).len > 0_u64;
  ensures deref(pool).len + 1_u64 == deref(entry(pool)).len;
  ensures deref(pool).room == deref(entry(pool)).room + 1_u64;
} {
  doc "Takes the last stocked cell out of the pool and publishes what that did to the pool alone.";
  let block = take_back(window: pool);
  return move block;
}

fn return_block(pool: &Slots<Box<Slots<u8>>, 2>, block: own Box<Slots<u8>>) -> result: own unit writes(pool) contract {
  requires deref(pool).room > 0_u64;
  ensures deref(pool).len == deref(entry(pool)).len + 1_u64;
} {
  doc "Puts one cell back into the pool.";
  place_back(window: pool, value: move block);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "INV-1: a verified helper exports changes to the pool but no capacity relation for the runtime-capacity window it hands back. Its caller cannot invent a four-slot capacity from the value it originally stored in that slot, so the invariant over the returned cell is the ordinary unproved target.";
  let block = box_slots_new::<u8>(capacity: 4_u64);
  let pool = slots_new::<Box<Slots<u8>>, 2>();
  place_back(window: &pool, value: move block);
  let taken = take_block(pool: &pool);
  invariant capacity: taken.inner.cap >= 4_u64;
  return_block(pool: &pool, block: move taken);
  return exit_status(code: 0_u8);
}
