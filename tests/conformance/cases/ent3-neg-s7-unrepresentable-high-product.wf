fn at_most(value: u64, limit: u64) -> result: unit pure contract {
  requires value <= limit;
} {
  return unit;
}

fn high_product(first: u64, second: u64) -> result: unit pure {
  let top = imulhi(first, second);
  at_most(value: top, limit: 18446744073709551614_u64);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
