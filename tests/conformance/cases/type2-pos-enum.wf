enum Light {
  Off();
  On();
}

fn main() -> own unit traps {
  doc "enum is a composite type [TYPE-2]: construct and match a value.";
  let s = On();
  match s {
    Off() => {
      return unit;
    }
    On() => {
      claim unreachable: ieq(1_i32, 1_i32) because "unreachable";
    }
  }
  return unit;
}
