command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "SET-2 admits a replace whose target type is affine and region-free. A Box<'s, u64> descriptor is affine and carries no region of its own, so exchanging one owning descriptor for another is accepted, the previous cell is bound as a fresh own binding, and the target root stays live. This is the positive control for the region-bearing rejection: the two targets differ exactly in bearing a region.";
  region {
    match heap_box(store: &uniq heap, value: 1_u64) {
      Err(error: first_back) => {
        return exit_status(code: 70_u8);
      }
      Ok(value: first) => {
        region {
          match heap_box(store: &uniq heap, value: 2_u64) {
            Err(error: second_back) => {
              return exit_status(code: 71_u8);
            }
            Ok(value: second) => {
              let previous = replace first = move second;
              let old = deref(previous);
              if old == 1_u64 {
              } else {
                return exit_status(code: 1_u8);
              }
              let current = deref(first);
              if current == 2_u64 {
              } else {
                return exit_status(code: 2_u8);
              }
              return exit_status(code: 0_u8);
            }
          }
        }
      }
    }
  }
}
