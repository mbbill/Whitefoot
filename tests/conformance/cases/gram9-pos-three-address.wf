command fn main() -> return_value: own ExitStatus traps {
  doc "GRAM-9: flat three-address - each computed value is bound by a let and forwarded by name; no nesting.";
  let a = 3_i32;
  let b = 4_i32;
  let s = a +wrap b;
  let p = s *wrap s;
  claim drift: ieq(p, 49_i32) because "drift";
  return exit_status(code: 0_u8);
}
