fn inspect(value: &u64) -> result: own u64 reads(value) {
  return deref(value);
}

fn decide(value: &uniq u64) -> result: own Option<u64> pure {
  return Some<u64>(value: 7_u64);
}

fn main() -> status: own ExitStatus pure {
  let value = 3_u64;
  let left = 0_u64;
  let right = 0_u64;
  region {
    match decide(value: &uniq value) {
      None() => {
      }
      Some(value: chosen) => {
        set value = chosen;
      }
