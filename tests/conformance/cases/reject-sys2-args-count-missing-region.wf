command fn main(command.args as args: own Args) -> status: own ExitStatus pure {
  doc "Every v0.33 executable unit admits the command system domain. This call supplies the correct borrowed Args value but omits the required region argument, so SYS-2 owns the single fault.";
  region 'a {
    let total = args_count(args: &'a args);
  }
  return exit_status(code: 0_u8);
}
