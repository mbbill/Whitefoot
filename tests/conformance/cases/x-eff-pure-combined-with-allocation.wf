fn f (heap: &uniq Heap, x: own i32) -> function_result: own i32 pure, allocates(heap) {
  doc "pure combined with allocates(heap) [EFF-1]; pure is the empty row.";
  return x;
}

command fn main (command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "Driver.";
  region {
    let a: own i32 = f(heap: &uniq heap, x: 7_i32);
  }
  return exit_status(code: 0_u8);
}
