fn f (x: own i32) -> function_result: own i32 pure, allocates(heap) {
  doc "pure combined with allocates(heap) [EFF-1]; pure is the empty row.";
  return x;
}

command fn main () -> status: own ExitStatus allocates(heap) {
  doc "Driver.";
  let a: own i32 = f(x: 7_i32);
  return exit_status(code: 0_u8);
}
