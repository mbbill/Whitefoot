command fn main(command.args as args: own Args, command.heap as heap: own Heap) -> status: own ExitStatus reads(args, heap), writes(heap), allocates(heap) {
  doc "SYS-8 admits an empty range only when its endpoint lies inside the destination. Here start equals end but end exceeds the buffer length, so the second range goal is refuted statically.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let bytes = move fresh;
        for @scratch (
          at in 0_u64..4_u64,
          invariant grown: len_of(bytes) >= at,
          invariant spare: room_of(bytes) + at >= 4_u64,
          invariant flat: head_of(bytes) <= 0_u64
        ) {
          set bytes = place_back(vector: move bytes, value: 0_u8);
        }
        region {
          let window = mut_slice_of(&uniq bytes);
          region {
            match arg_get(args: &args, position: 1_u64) {
              Ok(value: text) => {
                region 'v {
                  region {
                    match host_copy_bytes(value: &'v text, destination: &uniq window, start: 8_u64, end: 8_u64) {
                      Ok(value: copied) => {
                        return exit_status(code: 10_u8);
                      }
                      Err(error: problem) => {
                        return exit_status(code: 11_u8);
                      }
                    }
                  }
                }
              }
              Err(error: absent) => {
                return exit_status(code: 12_u8);
              }
            }
          }
        }
      }
    }
  }
}
