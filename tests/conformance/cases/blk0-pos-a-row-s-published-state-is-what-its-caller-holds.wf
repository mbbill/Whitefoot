fn main() -> status: own ExitStatus pure {
  doc "The other half of the same sentence. A window operation's own relations are what the caller holds afterwards, so the second placement's requirement is discharged from what the first published rather than from a stale extent, and the room the writer reads back is the room the two placements left.";
  let run = slots_new::<u8, 8>();
  place_back(window: &run, value: 1_u8);
  place_back(window: &run, value: 2_u8);
  let left = run.room;
  if left == 6_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
