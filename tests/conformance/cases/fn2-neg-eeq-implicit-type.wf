struct Held {
  v: i32;
}

fn pick<T>(value: own T) -> own T pure {
  doc "A generic fn declaring one type parameter [FN-2].";
  return move value;
}

fn main() -> own unit pure {
  doc "The call states no instantiation argument; instantiation arguments are always explicit [FN-2].";
  let a = Held(v: 1_i32);
  let b = pick(value: move a);
  return unit;
}
