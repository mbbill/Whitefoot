struct Row {
  left: u64;
  right: u64;
}

fn exchange(values: &uniq FixedVector<Row, 2>, left: own u64, right: own u64) -> result: own unit reads(values), writes(values) contract {
  requires left < len_of(deref(values));
  requires right < len_of(deref(values));
  requires left < right;
  ensures len_of(deref(values)) == len_of(deref(entry(values)));
} {
  set (deref(values)[left], deref(values)[right]) = move deref(values)[right], move deref(values)[left];
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "LIV-2 and OWN-7: a completed strict-order proof at target formation separates two runtime-selected elements, and repeating the same live index bindings on the right reads those affine targets out before the one commit.";
  let values = fixed_vector::<Row, 2>();
  let first = Row(left: 3_u64, right: 4_u64);
  region {
    place_back(vector: &uniq values, value: move first);
  }
  let second = Row(left: 5_u64, right: 6_u64);
  region {
    place_back(vector: &uniq values, value: move second);
  }
  region {
    exchange(values: &uniq values, left: 0_u64, right: 1_u64);
  }
  if values[0_u64].left == 5_u64 {
    if values[1_u64].left == 3_u64 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
