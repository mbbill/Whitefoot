command fn main() -> return_value: own ExitStatus traps {
  doc "OWN-11: a borrow naming a region introduced inside the loop body is allowed.";
  let a = 0_i32;
  loop @l {
    region 's {
      let p = &'s a;
      claim p: ieq(deref(p), 0_i32) because "p";
    }
    break @l;
  }
  return exit_status(code: 0_u8);
}
