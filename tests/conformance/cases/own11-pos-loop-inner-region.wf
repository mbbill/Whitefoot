command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-11: a borrow naming a region introduced inside the loop body is allowed.";
  let a = 0_i32;
  loop @l {
    region 's {
      let p = &'s a;
      if deref(p) == 0_i32 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    break @l;
  }
  return exit_status(code: 0_u8);
}
