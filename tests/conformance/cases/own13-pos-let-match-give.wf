command fn main() -> return_value: own ExitStatus traps {
  doc "OWN-13: let-initializer value-match; the taken arm's own result is moved exactly once.";
  let v = match 40_i32 +checked 2_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 0_u8);
    }
  }
  claim drift: ieq(v, 42_i32) because "drift";
  return exit_status(code: 0_u8);
}
