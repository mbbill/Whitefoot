command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-13: let-initializer value-match; the taken arm's own result is moved exactly once.";
  let v = match 40_i32 +checked 2_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  if ieq(v, 42_i32) {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
