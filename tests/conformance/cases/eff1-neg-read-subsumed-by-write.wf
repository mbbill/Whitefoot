struct Stats {
  count: u64;
}

fn record(stats: &Stats) -> result: unit reads(stats.count), writes(stats.count) {
  doc "EFF-1: writes(p) subsumes reads(p), so the pair is never written for one path; the row declares both for stats.count.";
  let old = deref(stats).count;
  set deref(stats).count = old +wrap 1_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The malformed declaration above is rejected before this entry calls it.";
  let stats = Stats(count: 0_u64);
  record(stats: &stats);
  return exit_status(code: 0_u8);
}
