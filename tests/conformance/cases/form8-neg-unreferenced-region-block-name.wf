command fn main() -> status: own ExitStatus pure {
  doc "Nothing inside the block names `'r` after elision, so [FORM-8] writes the block as `region { ... }`.";
  let a = 40_i32;
  region 'r {
    let p = &a;
    let observed = deref(p);
    if observed == 40_i32 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
