command fn main() -> status: own ExitStatus pure {
  region 'a {
    let workspace = arena_frame::<4, 1, 'a>();
    region {
      let table = arena_vector_proved::<u8>(store: &uniq workspace, count: 4_u64);
      set table = place_back(vector: move table, value: 7_u8);
      set table = place_back(vector: move table, value: 7_u8);
      set table = place_back(vector: move table, value: 7_u8);
      set table = place_back(vector: move table, value: 7_u8);
      region {
        let first = mut_slice_of(&uniq table);
        let second = mut_slice_of(&uniq table);
        set first[0_u64] = 1_u8;
        set second[1_u64] = 2_u8;
      }
    }
  }
  return exit_status(code: 0_u8);
}
