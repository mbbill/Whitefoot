fn main() -> own unit traps {
  doc "A mutable fixed array is filled and folded; the loop claims discharge its indexed writes and reads.";
  let values = array_new<u64, 8>(0_u64);
  let cursor = 0_u64;
  loop @fill {
    if ieq(cursor, 8_u64) {
      break @fill;
    }
    let fill_in_range = ilt(cursor, 8_u64);
    claim fill_cursor_in_range: fill_in_range because "the fill walks 0..8 and breaks at eight";
    set values[cursor] = cursor +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  set cursor = 0_u64;
  let total = 0_u64;
  loop @fold {
    if ieq(cursor, 8_u64) {
      break @fold;
    }
    let fold_in_range = ilt(cursor, 8_u64);
    claim fold_cursor_in_range: fold_in_range because "the fold walks 0..8 and breaks at eight";
    let value = values[cursor];
    set total = total +wrap value;
    set cursor = cursor +wrap 1_u64;
  }
  claim mutable_array_checksum_drift: ieq(total, 36_u64) because "mutable array checksum drift";
  return unit;
}
