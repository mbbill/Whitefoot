command fn main() -> status: own ExitStatus traps {
  doc "A mutable fixed array is filled and folded; the loop claims discharge its indexed writes and reads.";
  let values = array_new<u64, 8>(0_u64);
  let cursor = 0_u64;
  loop @fill {
    if ieq(cursor, 8_u64) {
      break @fill;
    }
    let fill_in_range = ilt(cursor, 8_u64);
    claim fill_cursor_in_range: fill_in_range because "premises: the fill loop starts its cursor at zero, advances by one, and exits at the fixed eight-element extent\nderivation: on every body reach the cursor is strictly below that extent, which is the predicate computed immediately above\nconclusion: fill_in_range is true\nchecker gap: ENT does not derive the strict loop range from the equality exit and loop recurrence\nconsumers: the following fill indexed access needs this upper Range component";
    set values[cursor] = cursor +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  set cursor = 0_u64;
  let total = 0_u64;
  loop @fold {
    if ieq(cursor, 8_u64) {
      break @fold;
    }
    let fold_in_range = ilt(cursor, 8_u64);
    claim fold_cursor_in_range: fold_in_range because "premises: the fold loop starts its cursor at zero, advances by one, and exits at the fixed eight-element extent\nderivation: on every body reach the cursor is strictly below that extent, which is the predicate computed immediately above\nconclusion: fold_in_range is true\nchecker gap: ENT does not derive the strict loop range from the equality exit and loop recurrence\nconsumers: the following fold indexed access needs this upper Range component";
    let value = values[cursor];
    set total = total +wrap value;
    set cursor = cursor +wrap 1_u64;
  }
  if ieq(total, 36_u64) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
