command fn main() -> status: own ExitStatus pure {
  doc "A mutable fixed array is filled and folded; counted-loop range facts discharge its indexed writes and reads.";
  let values = array_new<u64, 8>(0_u64);
  for (
    fill_index in 0_u64..8_u64
  ) {
    set values[fill_index] = fill_index +wrap 1_u64;
  }
  let total = 0_u64;
  for (
    fold_index in 0_u64..8_u64
  ) {
    let value = values[fold_index];
    set total = total +wrap value;
  }
  if ieq(total, 36_u64) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
