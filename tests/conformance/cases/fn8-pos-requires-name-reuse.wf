fn increment(x: own i32) -> result: own i32 pure contract {
  define value = ige(x, 0_i32);
  requires value;
} {
  doc "A requirement local's scope ends with the clause, so its name is fresh again in the body [FN-8/TYPE-6].";
  let value = x +wrap 1_i32;
  return value;
}

command fn main() -> status: own ExitStatus traps {
  let value = increment(x: 7_i32);
  claim requires_scope_drift: ieq(value, 8_i32) because "requires scope drift";
  return exit_status(code: 0_u8);
}
