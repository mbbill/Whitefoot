fn increment(x: own i32) -> own i32 pure requires {
  let value = ige(x, 0_i32);
  check value else trap "x must be nonnegative";
} {
  doc "A requirement local's scope ends with the clause, so its name is fresh again in the body [FN-8/TYPE-6].";
  let value = x +wrap 1_i32;
  return value;
}

fn main() -> own unit traps {
  let value = increment(x: 7_i32);
  check ieq(value, 8_i32) else trap "requires scope drift";
  return unit;
}
