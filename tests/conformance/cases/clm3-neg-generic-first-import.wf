fn clean_identity<T: Int>(value: own T) -> result: own T pure {
  return value;
}

fn need_small(value: own u64) -> result: own unit pure contract {
  requires ilt(value, 4_u64);
} {
  return unit;
}

fn claimed_identity<T: Int>(value: own T, seed: own u64) -> result: own T traps {
  let bounded = seed % 4_u64;
  let inside = ilt(bounded, 4_u64);
  claim generic_claim: inside because "premises: bounded is the remainder of this generic function's ordinary u64 parameter seed divided by 4_u64\nderivation: unsigned remainder by four is one of 0_u64 through 3_u64 and is therefore strictly less than 4_u64\nconclusion: ilt(bounded, 4_u64) is true\nchecker gap: schema ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following FN-8 requirement needs bounded below 4_u64";
  need_small(value: bounded);
  return value;
}

fn claimed_relay<T: Int>(value: own T, seed: own u64) -> result: own T traps {
  let result = claimed_identity<T>(value: value, seed: seed);
  return result;
}

deny_claims command fn main() -> status: own ExitStatus traps {
  let clean = clean_identity<u8>(value: 1_u8);
  let first = claimed_relay<u64>(value: 2_u64, seed: 9_u64);
  let second = claimed_relay<u8>(value: 3_u8, seed: 7_u64);
  return exit_status(code: 0_u8);
}
