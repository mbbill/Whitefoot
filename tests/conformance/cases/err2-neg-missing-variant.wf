enum Color {
  Red();
  Green();
  Blue();
}

fn pick(c: Color) -> result: i32 pure {
  match c {
    Red() => {
      return 1_i32;
    }
    Green() => {
      return 2_i32;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "A match missing the Blue() arm is non-exhaustive [ERR-2]; rejected.";
  let red_atom_0001 = Red();
  let n = pick(c: red_atom_0001);
  return exit_status(code: 0_u8);
}
