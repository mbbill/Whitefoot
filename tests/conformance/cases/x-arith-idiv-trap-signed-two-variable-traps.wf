fn opaque(n: own i32) -> function_result: own i32 pure {
  return n;
}

fn divide(p: own i32, q: own i32) -> function_result: own i32 traps {
  doc "The total /defined query states the complete exact-division domain [OP-2]. Its executed claim is the sole runtime boundary; when true it also discharges the following bare exact division, and when false it aborts before that operation [CLM-1].";
  claim division_defined: p /defined q because "the divisor and signed quotient must be defined";
  let r = p / q;
  return r;
}

command fn main() -> status: own ExitStatus traps {
  doc "The divisor passes through a call so the division claim executes at runtime, and the zero divisor makes that claim abort the process [SCOPE-4].";
  let z = opaque(n: 0_i32);
  let v = divide(p: 10_i32, q: z);
  return exit_status(code: 0_u8);
}
