fn bounded_index(values: own array<u8, 8>, index: own u64) -> output: own u64 pure contract {
  define capacity = len(values);
  requires ilt(index, capacity);
  ensures ilt(output, capacity);
} {
  return index;
}

command fn main() -> status: own ExitStatus pure {
  let values = array_new<u8, 8>(0_u8);
  let output = bounded_index(values: move values, index: 7_u64);
  if ieq(output, 7_u64) {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
