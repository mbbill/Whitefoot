enum Cell {
  Full(v: i32);
  Void();
}

fn main() -> own unit traps {
  doc "Borrow-match a payload enum through &'r: the scrutinee stays live for a second read, and each derived shared payload binder is explicitly dereferenced before its copy value is used [OWN-13, TYPE-7, GIVE-1, GRAM-10, OP-1, SCOPE-3].";
  let c = Full(v: 20_i32);
  region 'r {
    let p = &'r c;
    let a = match deref(p) {
      Full(v: x) => {
        give deref(x) + 1_i32;
      }
      Void() => {
        give 0_i32;
      }
    }
    let q = &'r c;
    let b = match deref(q) {
      Full(v: y) => {
        give deref(y) * 2_i32;
      }
      Void() => {
        give 0_i32;
      }
    }
    let t = a + b;
    check t == 61_i32 else trap "borrow payload drift";
  }
  return unit;
}
