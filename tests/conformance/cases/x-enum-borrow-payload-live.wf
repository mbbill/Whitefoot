enum Cell {
  Full(v: i32);
  Void();
}

command fn main() -> status: own ExitStatus traps {
  doc "Borrow-match a payload enum through &'r: the scrutinee stays live for a second read, and each derived shared payload binder is explicitly dereferenced before its copy value is used [OWN-13, TYPE-7, GIVE-1, GRAM-10, OP-1, SCOPE-3].";
  let c = Full(v: 20_i32);
  region 'r {
    let p = &'r c;
    let a = match deref(p) {
      Full(v: x) => {
        let x_in_range = ile(deref(x), 2147483646_i32);
        claim x_below_max: x_in_range because "premises: the borrowed enum is constructed once as Full with payload 20_i32\nderivation: the copied payload value 20_i32 satisfies the bound i32 maximum minus one\nconclusion: x_in_range is true\nchecker gap: ENT does not publish a nominal payload value through borrow-mode match\nconsumers: the downstream exact payload arithmetic needs this IntegerDomain component";
        give deref(x) + 1_i32;
      }
      Void() => {
        give 0_i32;
      }
    }
    let q = &'r c;
    let b = match deref(q) {
      Full(v: y) => {
        let y_below = ile(deref(y), 1073741823_i32);
        claim y_below_half_max: y_below because "premises: the borrowed enum is constructed once as Full with payload 20_i32\nderivation: the copied payload value 20_i32 satisfies the bound 1073741823_i32\nconclusion: y_below is true\nchecker gap: ENT does not publish a nominal payload value through borrow-mode match\nconsumers: the downstream exact payload arithmetic needs this IntegerDomain component";
        let y_above = ige(deref(y), -1073741824_i32);
        claim y_above_half_min: y_above because "premises: the borrowed enum is constructed once as Full with payload 20_i32\nderivation: the copied payload value 20_i32 satisfies the bound -1073741824_i32\nconclusion: y_above is true\nchecker gap: ENT does not publish a nominal payload value through borrow-mode match\nconsumers: the downstream exact payload arithmetic needs this IntegerDomain component";
        give deref(y) * 2_i32;
      }
      Void() => {
        give 0_i32;
      }
    }
    claim payload_sum_defined: a +defined b because "premises: the sole Full payload is 20_i32, so the first match yields 21_i32 and the second yields 40_i32\nderivation: 21_i32 plus 40_i32 equals 61_i32 and is representable as i32\nconclusion: a +defined b is true\nchecker gap: ENT does not join payload-derived result bounds across the two match expressions\nconsumers: the following exact addition needs the complete IntegerDomain obligation";
    let t = a + b;
    if ieq(t, 61_i32) {
    } else {
      return exit_status(code: 201_u8);
    }
  }
  return exit_status(code: 0_u8);
}
