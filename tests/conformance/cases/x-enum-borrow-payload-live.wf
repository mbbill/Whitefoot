enum Cell {
  Full(v: i32);
  Void();
}

command fn main() -> status: own ExitStatus traps {
  doc "Borrow-match a payload enum through &'r: the scrutinee stays live for a second read, and each derived shared payload binder is explicitly dereferenced before its copy value is used [OWN-13, TYPE-7, GIVE-1, GRAM-10, OP-1, SCOPE-3].";
  let c = Full(v: 20_i32);
  region 'r {
    let p = &'r c;
    let a = match deref(p) {
      Full(v: x) => {
        let x_in_range = ile(deref(x), 2147483646_i32);
        claim x_below_max: x_in_range because "the constructed payload is 20";
        give deref(x) + 1_i32;
      }
      Void() => {
        give 0_i32;
      }
    }
    let q = &'r c;
    let b = match deref(q) {
      Full(v: y) => {
        let y_below = ile(deref(y), 1073741823_i32);
        claim y_below_half_max: y_below because "the constructed payload is 20";
        let y_above = ige(deref(y), -1073741824_i32);
        claim y_above_half_min: y_above because "the constructed payload is 20";
        give deref(y) * 2_i32;
      }
      Void() => {
        give 0_i32;
      }
    }
    claim payload_sum_defined: a +defined b because "both scores come from the constructed payload";
    let t = a + b;
    claim borrow_payload_drift: ieq(t, 61_i32) because "borrow payload drift";
  }
  return exit_status(code: 0_u8);
}
