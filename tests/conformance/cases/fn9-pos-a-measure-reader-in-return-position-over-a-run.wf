fn size_of(taken: own FixedVector<u8, 8>) -> measured: own u64 reads(taken) contract {
  ensures measured == len_of(taken);
} {
  doc "A measure reader over a run in return position is the same [CALL-4] return datum the three flat measures already are: the returned value is that measure of that place, so the declared relation is verified over it directly [FN-9, MSR-1].";
  return len_of(taken);
}

command fn main() -> status: own ExitStatus pure {
  let run = fixed_vector::<u8, 8>();
  set run = place_back(vector: move run, value: 3_u8);
  set run = place_back(vector: move run, value: 4_u8);
  let seen = size_of(taken: move run);
  if seen == 2_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
