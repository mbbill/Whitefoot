command fn main(command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory, command.heap as heap: own Heap) -> status: own ExitStatus reads(cwd, files, heap), writes(cwd, files, heap), allocates(heap) {
  doc "`directory_next` takes an exclusive `DirectorySource` borrow because advancing enumeration changes that source's state. This negative case deliberately requests two simultaneous unique borrows of the same owner, so ordinary OWN-5 exclusivity rejects them.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 1024_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let entries = move fresh;
        for @scratch (
          at in 0_u64..1024_u64,
          invariant grown: len_of(entries) >= at,
          invariant spare: room_of(entries) + at >= 1024_u64,
          invariant flat: head_of(entries) <= 0_u64
        ) {
          set entries = place_back(vector: move entries, value: 0_u8);
        }
        region {
          let window = mut_slice_of(&uniq entries);
          region {
            let permit = reserve_file(factory: &uniq files);
            match open_directory_source(permit: move permit, directory: &cwd) {
              Ok(value: list) => {
                region {
                  let first = &uniq list;
                  let second = &uniq list;
                  match directory_next(source: &uniq deref(first), destination: &uniq window, start: 0_u64, end: 1024_u64) {
                    ListBytes(next: bytes, entries: reported) => {
                      return exit_status(code: 0_u8);
                    }
                    ListEnd() => {
                      return exit_status(code: 0_u8);
                    }
                    ListFailed(error: problem) => {
                      return exit_status(code: 3_u8);
                    }
                  }
                }
              }
              Err(error: problem) => {
                return exit_status(code: 4_u8);
              }
            }
          }
        }
      }
    }
  }
}
