command fn main(command.cwd as cwd: own DirectoryRead) -> status: own ExitStatus allocates(heap), traps {
  doc "`directory_next` itself takes a shared `DirectorySource` borrow, and family-owned Ordered reservations let several calls coexist without exposing the cursor [SYS-14]. This negative case deliberately requests two unnecessary simultaneous unique borrows of that owner; ordinary OWN-5 exclusivity rejects those borrows without implying that the operation requires unique access.";
  let entries = buffer_new(1024_u64, 0_u8);
  region 'c {
    match open_directory_source<'c>(directory: &'c cwd) {
      Ok(value: list) => {
        region 'b {
          let first = &uniq 'b list;
          let second = &uniq 'b list;
          match directory_next<'b, 'b>(source: &'b deref(first), destination: &uniq 'b entries, start: 0_u64, end: 1024_u64) {
            ListBytes(next: bytes, entries: reported) => {
              return exit_status(code: 0_u8);
            }
            ListEnd() => {
              return exit_status(code: 0_u8);
            }
            ListFailed(error: problem) => {
              return exit_status(code: 3_u8);
            }
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 4_u8);
      }
    }
  }
}
