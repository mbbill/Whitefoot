fn push(window: &Slots<u8, 4>, value: own u8) -> result: own unit writes(window.next), writes(window.len) contract {
  requires deref(window).len < deref(window).cap;
} {
  doc "Places one value at the back boundary of a run, declaring exactly the two window parts place_back writes.";
  place_back(window: window, value: value);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "place_back fills the append slot and moves the back boundary by one, and a source helper may declare the same window-part row the built-in record declares. The helper's own requires is what discharges the record's room requirement, which is the one obligation a caller of this operation carries.";
  return exit_status(code: 0_u8);
}
