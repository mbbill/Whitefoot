fn left(value: own i32) -> result: own Result<i32, u8> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  let outcome = right(value: value);
  return outcome;
}

fn right(value: own i32) -> result: own Result<i32, u8> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  return left(value: value);
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
