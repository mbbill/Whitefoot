fn identity(x: own i32) -> result: own i32 pure {
  return x;
}

fn user_call(x: own i32) -> result: own i32 pure contract {
  define copied = identity(x: x);
  define permitted = copied == x;
  requires permitted;
} {
  doc "User-function calls are forbidden in a requirement clause even when the callee is pure [FN-8].";
  return x;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
