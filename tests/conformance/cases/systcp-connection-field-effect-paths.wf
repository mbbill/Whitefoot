fn drain(link: &uniq TcpConnection, scratch: &uniq MutSlice<u8>) -> result: own u8 reads(link.receive, scratch), writes(link.receive, scratch) contract {
  define room = len_of(deref(scratch));
  requires 32_u64 <= room;
} {
  doc "Reads one chunk through the receiving direction only, naming that direction as its effect path.";
  let outcome = 0_u8;
  region {
    match receive_next(receive: &uniq deref(link).receive, destination: &uniq deref(scratch), start: 0_u64, end: 32_u64) {
      ReadBytes(next: endpoint) => {
      }
      ReadEnd() => {
      }
      ReadFailed(error: problem) => {
        set outcome = 2_u8;
      }
    }
  }
  return outcome;
}

command fn main(command.handles as handles: own HandleFactory, command.heap as heap: own Heap) -> status: own ExitStatus reads(handles, heap), writes(handles, heap), allocates(heap) {
  doc "EFF-1, EFF-2, SYS-18: the receiving and sending directions are ordinary struct fields. The helper accesses only `link.receive` and `scratch`, so its exact row names those paths without charging the untouched sending direction. Borrowing the whole connection still grants no simultaneous access to its sending field. The qualified POSIX target admits the TCP operations [QUAL-1].";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 32_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let scratch = move fresh;
        for @fill (
          at in 0_u64..32_u64,
          invariant grown: len_of(scratch) >= at,
          invariant spare: room_of(scratch) + at >= 32_u64,
          invariant flat: head_of(scratch) <= 0_u64
        ) {
          set scratch = place_back(vector: move scratch, value: 0_u8);
        }
        region {
          let window = mut_slice_of(&uniq scratch);
          let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: 9103_u16);
          region {
            match reserve_handle(factory: &uniq handles) {
              Ok(value: permit) => {
                region {
                  match tcp_connect(permit: move permit, address: &address) {
                    Connected(connection: link) => {
                      let outcome = 0_u8;
                      region {
                        set outcome = drain(link: &uniq link, scratch: &uniq window);
                      }
                      let returned = close_connection(connection: move link);
                      return exit_status(code: outcome);
                    }
                    ConnectFailed(error: problem, permit: returned) => {
                      return exit_status(code: 4_u8);
                    }
                  }
                }
              }
              Err(error: problem) => {
                return exit_status(code: 5_u8);
              }
            }
          }
        }
      }
    }
  }
}
