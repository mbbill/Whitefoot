struct Pair {
  left: u64;
  right: u64;
}

formal Touch {
  fn touch(value: &Pair) -> result: own unit reads(value.left), writes(value.right);
}

fn apply(input: &Pair) -> result: own unit reads(input.left), writes(input.right) {
  doc "Formal and actual effect paths compare parameter and field ordinals, not binder spelling; the two field paths here match ordinal for ordinal.";
  let observed = input.left;
  set input.right = observed;
  return unit;
}

actual PairTouch : Touch {
  touch = apply;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
