command fn main() -> status: own ExitStatus pure {
  doc "MSR-3: the LIV-2 set-target placement. A commit whose right-hand side is a bare use of a measured place carries every measure that place had, exactly as the let rebind does: the datum is minted before the statement's own kills and read after them, so place_back's room_of(vector) > 0_u64 is discharged at the new name.";
  let one = fixed_vector::<u8, 4>();
  set two = move one;
  let filled = place_back(vector: move two, value: 5_u8);
  let seen = filled[0_u64];
  if seen == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
