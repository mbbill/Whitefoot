fn bad(a: own u32, n: own u32) -> return_value: own u32 pure {
  doc "A rotate amount is taken modulo width, so rotates are dotless-total [OP-8]; irotl.checked is a well-formed operation token but names no table row and must be rejected under OP-1.";
  return irotl.checked(a, n);
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
