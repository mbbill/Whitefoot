fn bounded(x: own i32) -> result: own i32 pure contract {
  define permitted = ige(x, 0_i32);
  requires permitted;
} {
  return x;
}

fn clamp_three(value: own u64) -> result: own u64 pure {
  return imin(value, 3_u64);
}

fn reviewed_nonnegative(value: own i32) -> result: own i32 pure {
  return imax(value, 0_i32);
}

fn missing_effect() -> result: own unit pure {
  doc "The caller's explicit claim exhibits traps even though the callee requirement is an erased proof goal [EFF-2/FN-8].";
  let x = reviewed_nonnegative(value: -7_i32);
  let permitted = ige(x, 0_i32);
  claim caller_evidence: permitted because "premises: x is returned by reviewed_nonnegative, whose body computes imax(-7_i32, 0_i32)\nderivation: imax returns an operand no smaller than 0_i32\nconclusion: ige(x, 0_i32) is true\nchecker gap: ENT does not publish an uncontracted user-call result bound\nconsumers: the following bounded call requires this exact nonnegative predicate";
  let value = bounded(x: x);
  let values = array_new<u8, 4>(0_u8);
  let right = clamp_three(value: 9_u64);
  let right_inside = ilt(right, 4_u64);
  claim expected: right_inside because "premises: values has length 4 and right is returned by clamp_three, whose body computes imin(9_u64, 3_u64)\nderivation: right is at most 3_u64 and therefore strictly less than 4_u64\nconclusion: ilt(right, 4_u64) is true\nchecker gap: ENT does not publish an uncontracted user-call result bound\nconsumers: the following values[right] subscript requires this exact bound";
  let second = values[right];
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
