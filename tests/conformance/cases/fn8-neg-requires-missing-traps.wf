fn bounded(x: own i32) -> result: own i32 pure contract {
  define permitted = ige(x, 0_i32);
  requires permitted;
} {
  return x;
}

fn missing_effect() -> result: own unit pure {
  doc "The caller's explicit claim exhibits traps even though the callee requirement is an erased proof goal [EFF-2/FN-8].";
  let residue = -7_i32 % 4_i32;
  let x = residue +wrap 4_i32;
  let permitted = ige(x, 0_i32);
  claim caller_evidence: permitted because "premises: residue is -7_i32 remainder 4_i32 in this function and x is residue plus 4_i32 with wrapping semantics\nderivation: residue is between -3_i32 and 0_i32, so x is between 1_i32 and 4_i32 and is nonnegative\nconclusion: ige(x, 0_i32) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range through the wrapping offset\nconsumers: the following bounded call requires this exact nonnegative predicate";
  let value = bounded(x: x);
  let values = array_new<u8, 4>(0_u8);
  let seed = 9_u64;
  let right = seed % 4_u64;
  let right_inside = ilt(right, 4_u64);
  claim expected: right_inside because "premises: values has length 4 and right is seed remainder 4_u64 computed in this function\nderivation: unsigned remainder by 4_u64 is at most 3_u64 and therefore strictly less than the array length\nconclusion: ilt(right, 4_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following values[right] subscript requires this exact bound";
  let second = values[right];
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
