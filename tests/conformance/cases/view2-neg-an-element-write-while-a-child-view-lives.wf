command fn main() -> status: own ExitStatus pure {
  doc "The other half of the child reborrow: while the child lives the parent is frozen. An element write through the exclusive view is refused citing OWN-5 at the target, because the child would otherwise read storage the parent changed under it. Without the refusal the program below writes 9 through the MutSlice and reads 7 back through the Slice, which is the exclusivity OWN-5 states failing at one range.";
  region 'a {
    let workspace = arena_frame::<3, 1, 'a>();
    region {
      let table = arena_vector_proved::<u8>(store: &uniq workspace, count: 3_u64);
      set table = place_back(vector: move table, value: 7_u8);
      set table = place_back(vector: move table, value: 7_u8);
      set table = place_back(vector: move table, value: 7_u8);
      region {
        let writer = mut_slice_of(&uniq table);
        let reader = slice_of(&table);
        set writer[0_u64] = 9_u8;
        let seen = reader[0_u64];
        if seen == 7_u8 {
          return exit_status(code: 0_u8);
        }
      }
    }
  }
  return exit_status(code: 1_u8);
}
