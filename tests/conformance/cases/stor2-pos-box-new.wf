command fn main() -> status: own ExitStatus allocates(heap) {
  doc "Creation: box_new(v) returns own box<T> [STOR-2]; content is read through deref.";
  let b = box_new(5_i32);
  let v = deref(b);
  if ieq(v, 5_i32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
