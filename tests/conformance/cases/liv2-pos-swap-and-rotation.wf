command fn main() -> status: own ExitStatus allocates(heap) {
  doc "D2's swap and its three-target rotation. The value list is evaluated completely before the one commit, so `set (p, q) = move q, move p;` exchanges the two values rather than writing one over the other; the copy pair reports the exchange in the exit code and the run triple exercises the same commit over affine values, each of which is moved exactly once and released exactly once.";
  let low = 3_u8;
  let high = 5_u8;
  set (low, high) = high, low;
  let first = buffer_new(1_u64, 0_u8);
  let second = buffer_new(2_u64, 0_u8);
  let third = buffer_new(3_u64, 0_u8);
  set (first, second, third) = move third, move first, move second;
  return exit_status(code: low);
}
