fn main() -> status: own ExitStatus pure {
  doc "D2's swap and its three-target rotation. The value list is evaluated completely before the one commit, so `set (p, q) = move q, move p;` exchanges the two values rather than writing one over the other; the copy pair reports the exchange in the exit code and the run triple exercises the same commit over affine values, each of which is moved exactly once and released exactly once.";
  let low = 3_u8;
  let high = 5_u8;
  set (low, high) = high, low;
  let first_empty = fixed_vector::<u8, 3>();
  region {
    place_back(vector: &uniq first_empty, value: 0_u8);
  }
  let first = move first_empty;
  let second_empty = fixed_vector::<u8, 3>();
  region {
    place_back(vector: &uniq second_empty, value: 0_u8);
  }
  let second_one = move second_empty;
  region {
    place_back(vector: &uniq second_one, value: 0_u8);
  }
  let second = move second_one;
  let third_empty = fixed_vector::<u8, 3>();
  region {
    place_back(vector: &uniq third_empty, value: 0_u8);
  }
  let third_one = move third_empty;
  region {
    place_back(vector: &uniq third_one, value: 0_u8);
  }
  let third_two = move third_one;
  region {
    place_back(vector: &uniq third_two, value: 0_u8);
  }
  let third = move third_two;
  set (first, second, third) = move third, move first, move second;
  return exit_status(code: low);
}
