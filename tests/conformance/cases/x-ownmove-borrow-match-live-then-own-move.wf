enum Sign {
  Neg();
  Zero();
  Pos();
}

command fn main() -> status: own ExitStatus pure {
  doc "OWN-13 both modes: a shared-borrow match leaves s live; a later own match then moves it exactly once.";
  let s = Pos();
  region 'r {
    let b = &'r s;
    match deref(b) {
      Neg() => {
      }
      Zero() => {
      }
      Pos() => {
      }
    }
  }
  match s {
    Neg() => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  return exit_status(code: 0_u8);
}
