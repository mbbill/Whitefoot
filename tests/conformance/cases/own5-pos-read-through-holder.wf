command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-5: reads and writes through the &uniq holder are permitted while it is live.";
  let a = 3_i32;
  region 'r {
    let u = &uniq 'r a;
    set deref(u) = 10_i32;
    if ieq(deref(u), 10_i32) {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  if ieq(a, 10_i32) {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
