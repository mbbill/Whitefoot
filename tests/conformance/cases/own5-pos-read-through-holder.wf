fn main() -> own unit traps {
  doc "OWN-5: reads and writes through the &uniq holder are permitted while it is live.";
  let a = 3_i32;
  region 'r {
    let u = &uniq 'r a;
    set deref(u) = 10_i32;
    claim rw: ieq(deref(u), 10_i32) because "rw";
  }
  claim after: ieq(a, 10_i32) because "after";
  return unit;
}
