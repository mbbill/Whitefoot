fn indexed_byte(b: own Slice<u8>, flag: own Bool) -> result: own u8 reads(b) contract {
  define spare = len_of(b);
  requires spare == 5_u64;
} {
  let idx = 0_u64;
  if flag {
    set idx = idx +wrap 3_u64;
  } else {
    set idx = idx +wrap 7_u64;
  }
  return b[idx];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
