command fn main() -> return_value: own ExitStatus traps {
  doc "Every computation is a call naming one operation from the table [OP-1]: a wrapping add and an integer compare, nothing overloaded.";
  let x = 20_i32 +wrap 22_i32;
  claim op_drift: ieq(x, 42_i32) because "op drift";
  return exit_status(code: 0_u8);
}
