formal Inspect<T: linear> {
  fn length(values: &T) -> result: own u64 reads(values);
}

fn shorter(values: &Array<u64, 4>) -> result: own u64 reads(values) {
  doc "Parameter mode and exact type agree with the instantiated member, so the binding is admitted before any call exists.";
  return deref(values)[0_u64];
}

actual Narrow : Inspect<Array<u64, 4>> {
  length = shorter;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
