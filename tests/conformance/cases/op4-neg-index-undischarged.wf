fn get(b: own Slice<i32>, i: own u64) -> return_value: own i32 reads(b) {
  doc "An unproven parameter offset is a compile-time rejection under discharge-or-reject [OP-4]: the diagnostic prints the ENT-6 residual `i < len_of(b)` and points to a dominating branch, requirement, invariant, or checked source proof as the repair.";
  return b[i];
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
