fn get(b: &[i32], i: own u64) -> return_value: own i32 reads(b) {
  doc "An unproven parameter offset is a compile-time rejection under discharge-or-reject: the diagnostic prints the ENT-6 residual i < deref(b).len and points to a dominating branch, requirement, invariant, or checked source proof as the repair.";
  return deref(b)[i];
}

fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
