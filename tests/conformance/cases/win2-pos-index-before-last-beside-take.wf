alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn read_then_take(window: &Slots<u64, 8>, i: u64) -> result: u64 reads(window[i]), writes(window.last), writes(window.len) contract {
  requires i < deref(window).len;
} {
  doc "Returns element i plus the last element, which it takes out of the window.";
  let kept = deref(window)[i];
  let last = take_back(window: window);
  let total = kept +wrap last;
  return total;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-5, WIN-2: an element below the last slot never overlaps window.last. The call passes i 0 and its entry state proves window.len equal to 2, so reads(window[0_u64]) is separate from writes(window.last); the program observes the kept element plus the taken one.";
  let window = slots_new::<u64, 8>();
  place_back(window: &window, value: 1_u64);
  place_back(window: &window, value: 2_u64);
  let total = read_then_take(window: &window, i: 0_u64);
  if total == 3_u64 {
    if window.len == 1_u64 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
