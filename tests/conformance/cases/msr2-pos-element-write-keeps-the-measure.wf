fn filled<T: copy, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

command fn main() -> status: own ExitStatus pure {
  doc "[MSR-2] a write at an element position of P overlaps the descriptor storage of the written element and none of P's own, so it kills every measure of that element and no measure of P. An element write of a scalar therefore kills nothing at all, because a scalar has no measures: the set of killed measures is empty rather than excepted. This is the carve-out's removal under test in the half this version's measure table has - no measured type here has a measured element type - and the later subscript still discharges from the length fact taken before the write.";
  let run = filled::<u8, 8>(value: 0_u8);
  let size = len_of(run);
  if 5_u64 < size {
    set run[2_u64] = 7_u8;
    let read = run[5_u64];
    if read == 0_u8 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
