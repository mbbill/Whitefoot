command fn main(command.cwd as cwd: own DirectoryRead) -> own ExitStatus external, blocks {
  doc "`DirectoryList` is release-complete [SYS-5, SYS-14]: the value bound in the Ok arm leaves scope at the arm's end and compiler-derived release is the complete language obligation, so the program needs no terminal operation and declares none. This specification declares no separate explicit-close operation at all.";
  region 'c {
    match open_list<'c>(directory: &'c cwd) {
      Ok(value: list) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return exit_status(code: 0_u8);
}
