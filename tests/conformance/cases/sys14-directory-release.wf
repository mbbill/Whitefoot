command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  doc "`DirectorySource` is release-complete [SYS-5, SYS-14]: the value bound in the Ok arm leaves scope at the arm's end and compiler-derived release is the complete language obligation, so the program needs no terminal operation and declares none. This specification declares no separate explicit-close operation at all.";
  region {
    match reserve_handle(factory: &uniq files) {
      Ok(value: permit) => {
        match open_directory_source(permit: move permit, directory: &cwd) {
          SourceOpened(value: list) => {
          }
          SourceOpenFailed(error: problem, permit: refused) => {
          }
        }
      }
      Err(error: spent) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
