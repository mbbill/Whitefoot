fn reverse(bytes: &[u8]) -> result: own unit writes(bytes) contract {
  requires deref(bytes).len >= 1_u64;
} {
  let count = deref(bytes).len;
  let last_value = count - 1_u64;
  for (i in 0_u64..count) {
    let mirror = last_value - i;
    if i < mirror {
      let front = deref(bytes)[i];
      let back = deref(bytes)[mirror];
      set deref(bytes)[i] = back;
      set deref(bytes)[mirror] = front;
    }
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
