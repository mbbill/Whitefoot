fn selected(data: &[u8], table: own Array<u8, 256>) -> result: own u8 reads(data) {
  let peak = 0_u8;
  let length = data.len;
  for (i in 0_u64..length) {
    let byte = data[i];
    set peak = imax(peak, byte);
  }
  let index = cvt::<u8, u64>(peak);
  return table[index];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
