fn count_low(input: own Slice<u64>) -> result: own u64 reads(input) contract {
  requires len_of(input) <= 16777216_u64;
  ensures result <= len_of(input);
} {
  let count = len_of(input);
  let low = 0_u64;
  for (
    i in 0_u64..count,
    invariant counted: low <= i
  ) {
    let key = input[i];
    let digit = key % 2_u64;
    if digit == 0_u64 {
      set low = low + 1_u64;
    }
  }
  return low;
}

fn scatter(input: own Slice<u64>, output: own MutSlice<u64>, split: own u64) -> result: own u64 reads(input), writes(output) contract {
  requires len_of(input) <= 16777216_u64;
  requires len_of(input) <= len_of(output);
  requires split <= len_of(input);
} {
  doc "This candidate deliberately has an insufficient contract. A bound on split does not relate it to the input's digit counts: split equal to one with a one-element odd input would write beyond the output. The retained OP-4 rejection identifies that missing relation, not an incorrect checker verdict or an impossibility result for every scatter representation.";
  let count = len_of(input);
  let low = 0_u64;
  for (
    i in 0_u64..count,
    invariant counted: low <= i
  ) {
    let key = input[i];
    let digit = key % 2_u64;
    if digit == 0_u64 {
      set output[low] = input[i];
      set low = low + 1_u64;
    } else {
      let skipped = i - low;
      let high = split + skipped;
      set output[high] = input[i];
    }
  }
  return count;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
