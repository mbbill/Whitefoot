enum Sign {
  Neg();
  Zero();
  Pos();
}

fn id(x: own i32) -> own i32 pure {
  return x;
}

fn main() -> own unit traps {
  doc "GRAM-1: IDENT-headed place versus user call uses two-token lookahead; construction, table-op, statement-match, and value-match positions stay distinct; one parse each.";
  let a = id(x: 20_i32);
  let b = a +wrap 22_i32;
  let s = Neg();
  let c = if ilt(b, 100_i32) {
    give b;
  } else {
    give a;
  }
  match s {
    Neg() => {
      check ieq(c, 42_i32) else trap "drift";
    }
    Zero() => {
      return unit;
    }
    Pos() => {
      return unit;
    }
  }
  return unit;
}
