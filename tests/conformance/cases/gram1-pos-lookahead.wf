enum Sign {
  Neg();
  Zero();
  Pos();
}

fn id(x: own i32) -> return_value: own i32 pure {
  return x;
}

command fn main() -> return_value: own ExitStatus pure {
  doc "GRAM-1: IDENT-headed place versus user call uses two-token lookahead; construction, table-op, statement-match, and value-match positions stay distinct; one parse each.";
  let a = id(x: 20_i32);
  let b = a +wrap 22_i32;
  let s = Neg();
  let c = if b < 100_i32 {
    give b;
  } else {
    give a;
  }
  match s {
    Neg() => {
      if c == 42_i32 {
      } else {
        return exit_status(code: 201_u8);
      }
    }
    Zero() => {
      return exit_status(code: 0_u8);
    }
    Pos() => {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 0_u8);
}
