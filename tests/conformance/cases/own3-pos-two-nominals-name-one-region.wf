struct Lease['s] {
  run: Vector<'s, u8>;
}

struct BlockPool['s] {
  free: FixedVector<Vector<'s, u8>, 8>;
}

command fn main() -> status: own ExitStatus pure {
  doc "OWN-3: a region identifier is unique within the declaration that introduces it, so two nominals of one unit may each write 's. A nominal's region parameters are its own exactly as a function's are, and the second declaration is neither a repeated region nor a TYPE-6 redeclaration of the first's.";
  return exit_status(code: 0_u8);
}
