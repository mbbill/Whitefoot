struct Columns {
  left: buffer<u64>;
  right: buffer<u64>;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "Parallel runtime-length columns are filled, folded, and released through one struct owner; counted-loop range facts discharge the indexing.";
  let left = buffer_new(6_u64, 0_u64);
  let right = buffer_new(6_u64, 0_u64);
  let columns = Columns(left: move left, right: move right);
  let length = len(columns.left);
  for (fill_index in 0_u64..length) {
    set columns.left[fill_index] = fill_index;
    let doubled = fill_index *wrap 2_u64;
    let right_room = len(columns.right);
    let fill_right_ok = fill_index < right_room;
    if fill_right_ok {
      set columns.right[fill_index] = doubled;
    } else {
      return exit_status(code: 202_u8);
    }
  }
  let total = 0_u64;
  for (fold_index in 0_u64..length) {
    let left_value = columns.left[fold_index];
    let right_room = len(columns.right);
    let fold_right_ok = fold_index < right_room;
    if fold_right_ok {
      let right_value = columns.right[fold_index];
      set total = total +wrap left_value;
      set total = total +wrap right_value;
    } else {
      return exit_status(code: 203_u8);
    }
  }
  if total == 45_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
