struct Columns {
  left: buffer<u64>;
  right: buffer<u64>;
}

fn main() -> own unit allocates(heap), traps {
  doc "Parallel runtime-length columns are filled, folded, and released through one struct owner; loop claims discharge the indexing.";
  let left = buffer_new(6_u64, 0_u64);
  let right = buffer_new(6_u64, 0_u64);
  let columns = Columns(left: move left, right: move right);
  let length = len(columns.left);
  let cursor = 0_u64;
  loop @fill {
    if ieq(cursor, length) {
      break @fill;
    }
    let fill_left_ok = ilt(cursor, length);
    claim fill_left_in_range: fill_left_ok because "the fill walks 0..length over the left column";
    set columns.left[cursor] = cursor;
    let doubled = cursor *wrap 2_u64;
    let right_room = len(columns.right);
    let fill_right_ok = ilt(cursor, right_room);
    claim fill_right_in_range: fill_right_ok because "both columns are allocated with six slots";
    set columns.right[cursor] = doubled;
    set cursor = cursor +wrap 1_u64;
  }
  set cursor = 0_u64;
  let total = 0_u64;
  loop @fold {
    if ieq(cursor, length) {
      break @fold;
    }
    let fold_left_ok = ilt(cursor, length);
    claim fold_left_in_range: fold_left_ok because "the fold walks 0..length over the left column";
    let left_value = columns.left[cursor];
    let right_room = len(columns.right);
    let fold_right_ok = ilt(cursor, right_room);
    claim fold_right_in_range: fold_right_ok because "both columns are allocated with six slots";
    let right_value = columns.right[cursor];
    set total = total +wrap left_value;
    set total = total +wrap right_value;
    set cursor = cursor +wrap 1_u64;
  }
  claim struct_of_buffers_checksum_drift: ieq(total, 45_u64) because "struct-of-buffers checksum drift";
  return unit;
}
