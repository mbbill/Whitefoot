struct Counter {
  value: u64;
}

fn write_byte(out: &uniq MutSlice<u8>) -> function_result: own unit writes(out) contract {
  define spare = len_of(deref(out));
  requires 0_u64 < spare;
} {
  set deref(out)[0_u64] = 7_u8;
  return unit;
}

fn proxy_byte(out: own MutSlice<u8>) -> function_result: own unit writes(out) contract {
  define spare = len_of(out);
  requires 1_u64 < spare;
} {
  region {
    write_byte(out: &uniq out);
  }
  set out[1_u64] = 9_u8;
  return unit;
}

fn bump_counter(counter: &uniq Counter) -> function_result: own unit reads(counter.value), writes(counter.value) {
  let next = deref(counter).value +wrap 1_u64;
  set deref(counter).value = next;
  return unit;
}

fn proxy_counter(counter: &uniq Counter) -> function_result: own unit reads(counter.value), writes(counter.value) {
  region {
    bump_counter(counter: &uniq deref(counter));
  }
  set deref(counter).value = deref(counter).value +wrap 1_u64;
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  let counter = Counter(value: 40_u64);
  region 'w {
    let workspace = arena_frame::<2, 1, 'w>();
    region {
      let output = arena_vector_proved::<u8>(store: &uniq workspace, count: 2_u64);
      set output = place_back(vector: move output, value: 0_u8);
      set output = place_back(vector: move output, value: 0_u8);
      region {
        let window = mut_slice_of(&uniq output);
        proxy_byte(out: move window);
      }
      region {
        proxy_counter(counter: &uniq counter);
      }
      let first = output[0_u64];
      let second = output[1_u64];
      if first == 7_u8 {
      } else {
        return exit_status(code: 201_u8);
      }
      if second == 9_u8 {
      } else {
        return exit_status(code: 202_u8);
      }
      if counter.value == 42_u64 {
      } else {
        return exit_status(code: 203_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
