fn main() -> status: own ExitStatus pure {
  doc "LIV-2 condition 2: two subscripted places overlap unless some step of their common prefix provably selects two different storages. These two agree at every step, so the commit order would decide the result and the second target is refused.";
  region 'a {
    let workspace = arena_frame::<8192, 16, 'a>();
    region {
      match arena_vector::<u8>(store: &uniq workspace, count: 8_u64) {
        None() => {
          return exit_status(code: 1_u8);
        }
        Some(value: first) => {
          match arena_vector::<u8>(store: &uniq workspace, count: 8_u64) {
            None() => {
              return exit_status(code: 6_u8);
            }
            Some(value: second) => {
              let left_room = room_of(first);
              let right_room = room_of(second);
              if left_room >= 2_u64 {
                if right_room >= 2_u64 {
                  region {
                    place_back(vector: &uniq first, value: 1_u8);
                  }
                  let a0 = move first;
                  region {
                    place_back(vector: &uniq a0, value: 2_u8);
                  }
                  let a1 = move a0;
                  region {
                    place_back(vector: &uniq second, value: 3_u8);
                  }
                  let b0 = move second;
                  region {
                    place_back(vector: &uniq b0, value: 4_u8);
                  }
                  let b1 = move b0;
                  let table = fixed_vector::<Vector<'a, u8>, 2>();
                  region {
                    place_back(vector: &uniq table, value: move a1);
                  }
                  let row0 = move table;
                  region {
                    place_back(vector: &uniq row0, value: move b1);
                  }
                  let grid = move row0;
                  let rows = len_of(grid);
                  if rows == 2_u64 {
                    let left = len_of(grid[0_u64]);
                    let right = len_of(grid[1_u64]);
                    if left == 2_u64 {
                      if right == 2_u64 {
                        set (grid[0_u64][1_u64], grid[0_u64][1_u64]) = 9_u8, 8_u8;
                        let seen_left = grid[0_u64][1_u64];
                        let seen_right = grid[1_u64][1_u64];
                        if seen_left == 9_u8 {
                          if seen_right == 8_u8 {
                            return exit_status(code: 0_u8);
                          }
                        }
                        return exit_status(code: 4_u8);
                      }
                    }
                    return exit_status(code: 2_u8);
                  }
                  return exit_status(code: 3_u8);
                }
              }
              return exit_status(code: 5_u8);
            }
          }
        }
      }
    }
  }
}
