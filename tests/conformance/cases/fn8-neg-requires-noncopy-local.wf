fn bounded(a: own u64) -> result: own u64 pure contract {
  define xs = fixed_vector::<u64, 4>();
  requires a < 8_u64;
} {
  doc "A requirement local is a fresh own copy value, so an aggregate-typed local is rejected even though fixed_vector is a pure, total row [FN-8].";
  return a;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
