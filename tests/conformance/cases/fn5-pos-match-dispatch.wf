enum Op {
  Inc();
  Dec();
}

fn apply(op: own Op, x: own i32) -> result: own i32 pure {
  doc "Closed-set dispatch is match, not a function value [FN-5]. Explicit wrapping arithmetic keeps both arms total so this case isolates dispatch.";
  match op {
    Inc() => {
      return x +wrap 1_i32;
    }
    Dec() => {
      return x -wrap 1_i32;
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  let inc_atom_0001 = Inc();
  let r = apply(op: inc_atom_0001, x: 41_i32);
  if r == 42_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
