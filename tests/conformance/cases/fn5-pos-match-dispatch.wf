enum Op {
  Inc();
  Dec();
}

fn apply(op: own Op, x: own i32) -> own i32 traps {
  doc "Closed-set dispatch is match, not a function value [FN-5].";
  match op {
    Inc() => {
      return x + 1_i32;
    }
    Dec() => {
      return x - 1_i32;
    }
  }
}

fn main() -> own unit traps {
  let inc_atom_0001 = Inc();
  let r = apply(op: inc_atom_0001, x: 41_i32);
  check r == 42_i32 else trap "dispatch drift";
  return unit;
}
