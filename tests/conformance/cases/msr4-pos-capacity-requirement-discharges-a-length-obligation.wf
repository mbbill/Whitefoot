fn fetch_at(run: own buffer<u8>, index: own u64) -> value: own u8 reads(run) contract {
  requires index < cap_of(run);
} {
  doc "The subscript bound is discharged from the capacity identity.";
  return run[index];
}

command fn main() -> status: own ExitStatus pure {
  doc "[MSR-4, MSR-2] every consumer submits its normalized goal to one ordered disposition. The callee's requirement is stated over `cap_of(run)` and the subscript's [OP-4] obligation is stated over `len_of(run)` in logical coordinates, and nothing between them relates the two except [MSR-2]'s standing facts: `len_of(P) + room_of(P) = cap_of(P)` with `room` fixed at zero by this version's measure table, appended to the automatic affine-premise sequence with the empty support every standing fact has. The disposition discharges the obligation from that identity, and the caller discharges the requirement from the allocation length.";
  let run = buffer_new(8_u64, 0_u8);
  let value = fetch_at(run: move run, index: 3_u64);
  if value == 0_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
