fn release_read_file(factory: &uniq HandleFactory, file: own ReadFile) -> result: own unit reads(factory, file), writes(factory, file) {
  doc "PRE-1 and EFF-2: close is an explicit ordinary consuming function call. The opaque drop performs no native release.";
  region {
    let closed = close_read(factory: &uniq deref(factory), file: move file);
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
