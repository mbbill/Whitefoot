command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-11: a loop body is its own region, so a borrow written directly in it needs no region block.";
  let a = 0_i32;
  loop @l {
    let p = &a;
    if deref(p) == 0_i32 {
    } else {
      return exit_status(code: 1_u8);
    }
    break @l;
  }
  return exit_status(code: 0_u8);
}
