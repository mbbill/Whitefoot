struct InnerProjection {
  value: i32;
}

struct OuterProjection {
  inner: InnerProjection;
}

fn read_projection(outer: &OuterProjection) -> return_value: own i32 reads(outer.inner.value) {
  doc "A place rooted at a reference parameter resolves to the path that reference names, and the field suffixes follow it [REF-1].";
  return outer.inner.value;
}

fn main() -> return_value: own ExitStatus pure {
  doc "GRAM-5: a structural place base can be followed by multiple field suffixes, each denoting one field projection; no `deref` appears, because that step belongs to Box content alone [TYPE-7].";
  let inner = InnerProjection(value: 42_i32);
  let outer = OuterProjection(inner: move inner);
  let result = read_projection(outer: &outer);
  if result == 42_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
