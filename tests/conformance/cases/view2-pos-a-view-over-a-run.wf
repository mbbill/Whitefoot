command fn main() -> status: own ExitStatus pure {
  doc "VIEW-2 widens the viewed domain to the two runs, and the formation row's own requirement head_of(vector) <= room_of(vector) is what makes the viewed window one contiguous range. This run has never had a front removal, so the requirement is discharged from the standing head_of = 0. Two shared views of the one run are formed, which OWN-5 admits without limit, and the program reads the viewed length through one and the elements back through both.";
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 3_u8);
  let two = place_back(vector: move one, value: 4_u8);
  region {
    let window = slice_of(&two);
    let width = len_of(window);
    if width == 2_u64 {
    } else {
      return exit_status(code: 21_u8);
    }
    let second_view = slice_of(&two);
    let first = window[0_u64];
    let second = second_view[1_u64];
    let agreed = second_view[0_u64];
    if agreed == first {
    } else {
      return exit_status(code: 24_u8);
    }
    if first == 3_u8 {
    } else {
      return exit_status(code: 22_u8);
    }
    if second == 4_u8 {
    } else {
      return exit_status(code: 23_u8);
    }
  }
  return exit_status(code: 0_u8);
}
