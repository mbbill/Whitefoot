fn main() -> own unit traps {
  doc "Loop, break, mutable locals, and a give value-match: sum 0..4 == 10.";
  let i = 0_i32;
  let sum = 0_i32;
  loop @l {
    if i >= 5_i32 {
      break @l;
    }
    set sum = sum + i;
    set i = i + 1_i32;
  }
  check sum == 10_i32 else trap "sum drift";
  let doubled = match sum *checked 2_i32 {
    Ok(value: d) => {
      give d;
    }
    Err(error: e) => {
      return unit;
    }
  }
  check doubled == 20_i32 else trap "double drift";
  return unit;
}
