fn stamp['b](slot: &uniq 'b buffer<u8>, index: own u64) -> result: own unit reads(slot), writes(slot) {
  doc "Writes one marker byte on odd indices only, so its written extent is not a fact of the signature.";
  let room = len(deref(slot));
  let sized = 0_u64 < room;
  if sized {
    let parity = index % 2_u64;
    let odd = parity == 1_u64;
    if odd {
      set deref(slot)[0_u64] = 7_u8;
    }
  }
  return unit;
}

fn first_byte['b](source: &'b buffer<u8>) -> result: own u64 reads(source) {
  doc "Reports the first byte of a buffer, or zero when it has none.";
  let room = len(deref(source));
  let sized = 0_u64 < room;
  if sized {
  } else {
    return 0_u64;
  }
  let byte = deref(source)[0_u64];
  return cvt::<u8, u64>(byte);
}

command fn main(command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files), allocates(heap) {
  doc "The marker byte one iteration writes into the hoisted scratch survives into the next, because stamp writes it only on odd indices. Executing the prologue in index order preserves that carried byte, but the remainder reads the same storage, so no single segment serializes it and PAR-3 denies with condition 5. Whole-place write-before-read would admit this program and publish a different total.";
  let scratch = buffer_new(1_u64, 0_u8);
  let name = buffer_new(16_u64, 97_u8);
  let total = 0_u64;
  for @scan (index in 0_u64..4_u64) {
    region 's {
      let stamped = stamp::<'s>(slot: &uniq 's scratch, index: index);
    }
    region 'f {
      let permit = reserve_file::<'f>(factory: &uniq 'f files);
      region 'n {
        match open_file::<'f, 'n>(permit: move permit, root: &'f cwd, name: &'n name, start: 0_u64, end: 4_u64) {
          Ok(value: handle) => {
            let seen = 0_u64;
            region 'r {
              set seen = first_byte::<'r>(source: &'r scratch);
            }
            set total = total +wrap seen;
          }
          Err(error: problem) => {
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
