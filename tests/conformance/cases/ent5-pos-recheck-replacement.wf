fn guarded_local(x: own u8, w: own u8) -> result: own u8 pure contract {
  requires x <= 5_u8;
} {
  set x = w;
  let ok = x <= 5_u8;
  if ok {
    let z = x + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

struct Cell {
  v: u8;
}

fn guarded_field(b: own Cell, w: own u8) -> result: own u8 reads(b.v), writes(b.v) {
  let old = b.v;
  let bounded = old <= 5_u8;
  if bounded {
    set b.v = w;
    let ok = b.v <= 5_u8;
    if ok {
      let z = b.v + 250_u8;
      return z;
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

fn guarded_element(buf: &uniq MutSlice<u8>, i: own u64, w: own u8) -> result: own u8 reads(buf), writes(buf) {
  let limit = len_of(deref(buf));
  let in_range = i < limit;
  if in_range {
    let old = deref(buf)[i];
    let bounded = old <= 5_u8;
    if bounded {
      set deref(buf)[i] = w;
      let cur = deref(buf)[i];
      let ok = cur <= 5_u8;
      if ok {
        let z = cur + 250_u8;
        return z;
      } else {
        return 0_u8;
      }
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

fn second_or_zero(values: own FixedVector<u32, 6>, idx: own u64) -> result: own u32 reads(values) contract {
  requires len_of(values) >= 6_u64;
} {
  let in_range = idx < 6_u64;
  if in_range {
  } else {
    return 0_u32;
  }
  let first = values[idx];
  let bumped = idx +wrap 1_u64;
  set idx = bumped;
  let still_in_range = idx < 6_u64;
  if still_in_range {
  } else {
    return first;
  }
  let second = values[idx];
  return second;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
