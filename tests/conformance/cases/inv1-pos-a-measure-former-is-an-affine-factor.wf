fn filled<T: copy, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

fn headroom(run: own FixedVector<u8, 8>) -> total: own u64 reads(run) contract {
  requires 8_u64 <= len_of(run);
} {
  doc "A header invariant states a relation over a measure of the run it scans.";
  let seen = 0_u64;
  for (
    at in 0_u64..4_u64,
    invariant reserved: seen + 4_u64 <= len_of(run)
  ) {
    let byte = run[at];
  }
  return seen;
}

command fn main() -> status: own ExitStatus pure {
  doc "[INV-1, MSR-1, MSR-5] a measure former is an affine factor of a header invariant. The relation the writer states is the one a contract clause already states, in the same spelling, and the checker proves it at the loop base and at every backedge over the same [ENT-2] measure term the automatic derivation of a numeric goal already carries an atom for.";
  let run = filled::<u8, 8>(value: 0_u8);
  let total = headroom(run: move run);
  if total == 0_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
