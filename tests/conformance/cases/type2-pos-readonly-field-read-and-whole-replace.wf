struct Packet {
  readonly id: u64;
  size: u64;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-2: a readonly field takes its value at construction and is read like any field; an ordinary field beside it is assignable, and a whole-value assignment replaces the readonly field together with its owner.";
  let p = Packet(id: 7_u64, size: 1_u64);
  set p.size = 2_u64;
  let first = p.id;
  set p = Packet(id: 9_u64, size: 3_u64);
  let second = p.id;
  if first == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if second == 9_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
