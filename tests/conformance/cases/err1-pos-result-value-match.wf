fn main() -> own unit traps {
  doc "Recoverable error is a value: a `Result` dispatched by `match` arms [ERR-1].";
  let v = match 40_i32 +checked 2_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return unit;
    }
  }
  claim x: ieq(v, 42_i32) because "x";
  return unit;
}
