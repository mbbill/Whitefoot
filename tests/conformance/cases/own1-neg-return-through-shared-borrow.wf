struct Pair {
  left: i32;
  right: i32;
}

fn steal['r](holder: &'r Pair) -> return_value: own Pair pure {
  doc "OWN-1: contextual affine return cannot move the Pair referent through a shared borrow.";
  return deref(holder);
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
