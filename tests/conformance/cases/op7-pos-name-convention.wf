command fn main() -> return_value: own ExitStatus traps {
  doc "Op names carry a domain prefix and a .mode suffix iff on a mode axis [OP-7]: ineg.checked (i-prefix, checked mode) and dotless ieq.";
  let r = match 40_i32 +checked 2_i32 {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      return exit_status(code: 0_u8);
    }
  }
  claim name_drift: ieq(r, 42_i32) because "name drift";
  return exit_status(code: 0_u8);
}
