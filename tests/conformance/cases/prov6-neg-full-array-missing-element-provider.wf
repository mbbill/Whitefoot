fn abandon['heap](values: own array<Box<'heap, u64>, 1>) -> result: own unit pure {
  doc "PROV-6 reaches the general-store cell through the full array element. This helper holds no Heap provider, so it cannot derive the array's element release at its return edge.";
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
