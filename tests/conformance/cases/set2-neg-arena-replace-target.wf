command fn main() -> status: own ExitStatus pure {
  doc "SET-2 requires the target's final selected type to be region-free under STOR-5, and an Arena<'s, bytes, align> provider is region-bearing exactly as a slice is. Replacing one provider descriptor with another is therefore a hard error citing SET-2 at the complete target place: an extent's confinement is fixed at its reservation and a new extent is bound under a new let.";
  region 'r {
    let first = arena_frame::<8, 8, 'r>();
    region 's {
      let second = arena_frame::<8, 8, 's>();
      let previous = replace first = move second;
    }
  }
  return exit_status(code: 0_u8);
}
