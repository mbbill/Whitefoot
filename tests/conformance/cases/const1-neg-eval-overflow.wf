fn doubled<const n: u64>(fill: own u64) -> own array<u64, n * 2> pure {
  return array_new<u64, n * 2>(fill);
}

fn main() -> own unit pure {
  doc "CONST-1 const evaluation is exact in the unsigned 64-bit domain under the const-eval overflow policy named const-reject. This instantiation makes `n * 2` leave that domain, which is a compile-time rejection citing CONST-1 at the complete const node. const-reject is disjoint from the runtime arithmetic modes: an accepted const-expression executes no runtime check and cannot trap.";
  let cells = doubled<9223372036854775808>(fill: 7_u64);
  return unit;
}
