struct Columns {
  left: Box<Slots<u64>>;
  right: Box<Slots<u64>>;
}

fn fill(left: &Box<Slots<u64>>, right: &Box<Slots<u64>>, value: own u64) -> function_result: own unit reads(left), reads(right) contract {
  requires deref(left).inner.len < deref(left).inner.cap;
  requires deref(right).inner.len < deref(right).inner.cap;
} {
  doc "Places one element in each column while declaring only reads of them, so the writes the body exhibits are missing from the row.";
  place_back(window: &deref(left).inner, value: value);
  place_back(window: &deref(right).inner, value: value);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "Deleting an exhibited write from a column function's declaration is an effect-row mismatch: the row is checked both ways against the complete exhibited set, and undeclared-but-exhibited is an EFF-2 error.";
  let left = box_slots_new::<u64>(capacity: 4_u64);
  let right = box_slots_new::<u64>(capacity: 4_u64);
  let columns = Columns(left: move left, right: move right);
  fill(left: &columns.left, right: &columns.right, value: 1_u64);
  return exit_status(code: 0_u8);
}
