fn preserve<T: affine>(value: own T) -> result: own T pure {
  return move value;
}

fn invalid(part: &[u8]) -> result: own u64 pure {
  doc "A range reference may be a directly written parameter, as `part` is, but never a generic type argument: a reference kind is not a value type [TYPE-8], so FN-2 refuses the complete `targ` and names the restructuring `make the reference a direct written parameter instead of a generic argument`.";
  let kept = preserve::<&[u8]>(value: part);
  return deref(part).len;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
