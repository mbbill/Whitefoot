fn preserve<T: affine>(value: own T) -> result: own T pure {
  return move value;
}

fn invalid['r](value: own Slice<'r, u8>) -> result: own Slice<'r, u8> pure {
  return preserve::<Slice<u8>>(value: move value);
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
