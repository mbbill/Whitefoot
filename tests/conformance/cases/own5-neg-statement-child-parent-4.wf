struct Pair {
  left: buffer<u8>;
  right: buffer<u8>;
}

fn change(value: &uniq buffer<u8>) -> result: own u64 reads(value), writes(value) {
  let size = len_of(deref(value));
  let available = size != 0_u64;
  if available {
    set deref(value)[0_u64] = 9_u8;
  }
  return 7_u64;
}

fn sink(value: &uniq Pair) -> result: own u64 pure {
  return 11_u64;
}

fn main() -> status: own ExitStatus pure {
  let first = buffer_new(1_u64, 3_u8);
  let second = buffer_new(1_u64, 5_u8);
  let pair = Pair(left: move first, right: move second);
  let left = 0_u64;
  let right = 0_u64;
  region {
    let holder = &uniq pair;
    region {
      set (left, right) = change(value: &uniq deref(holder).left), change(value: &uniq deref(holder).left);
    }
    region {
      let resumed = change(value: &uniq deref(holder).left);
    }
  }
  return exit_status(code: 0_u8);
}
