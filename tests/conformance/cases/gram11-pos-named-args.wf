fn add2(x: own i32, y: own i32) -> return_value: own i32 pure {
  return x +wrap y;
}

command fn main() -> return_value: own ExitStatus pure {
  doc "GRAM-11: a user-fn call names its arguments in declared parameter order.";
  let r = add2(x: 40_i32, y: 2_i32);
  if ieq(r, 42_i32) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
