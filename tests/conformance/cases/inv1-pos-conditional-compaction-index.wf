fn compact(buf: &uniq MutSlice<u8>) -> result: own u64 reads(buf), writes(buf) {
  let n = len_of(deref(buf));
  let sum = 0_u64;
  for (
    i in 0_u64..n,
    invariant sum_bound: sum <= i
  ) {
    let byte = deref(buf)[i];
    let keep = byte >= 128_u8;
    if keep {
      set deref(buf)[sum] = byte;
      set sum = sum + 1_u64;
    }
  }
  return sum;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
