fn inspect<const n: u64>(source: &FixedVector<u8, n>, i: own u64) -> seen: own u8 reads(source) contract {
  define spare = len_of(deref(source));
  requires i < spare;
} {
  doc "Reads one element through a shared borrow and writes nothing.";
  return deref(source)[i];
}

command fn main() -> status: own ExitStatus pure {
  doc "[CALL-1] a call is a kill event for no fact supported by a shared-borrow actual's place. [OWN-5] admits no write through a shared holder, so a body can exhibit none and [EFF-2]'s both-ways row check admits none in the declared row; no writes occurrence therefore projects onto line and no [MSR-2] kill fires. The length the two placements established survives the call, so the second call proves its own requirement from the same fact and the subscript inside the callee is discharged.";
  let line = fixed_vector::<u8, 4>();
  set line = place_back(vector: move line, value: 7_u8);
  set line = place_back(vector: move line, value: 9_u8);
  region {
    let first = inspect::<4>(source: &line, i: 0_u64);
    let second = inspect::<4>(source: &line, i: 1_u64);
    if first == 7_u8 {
    } else {
      return exit_status(code: 201_u8);
    }
    if second == 9_u8 {
    } else {
      return exit_status(code: 202_u8);
    }
  }
  return exit_status(code: 0_u8);
}
