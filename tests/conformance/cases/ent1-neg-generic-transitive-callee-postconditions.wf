const lookup: FixedVector<u8, 8> =[0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];

fn clamp(value: own u64) -> result: own u64 pure contract {
  ensures result <= 8_u64;
} {
  if value <= 7_u64 {
    return value;
  }
  return 7_u64;
}

fn relay(value: own u64) -> result: own u64 pure contract {
  ensures result <= 7_u64;
} {
  let clamped = clamp(value: value);
  return clamped;
}

fn select<T: Int>(value: own T, index: own u64) -> result: own u8 pure {
  let bounded = relay(value: index);
  return lookup[bounded];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
