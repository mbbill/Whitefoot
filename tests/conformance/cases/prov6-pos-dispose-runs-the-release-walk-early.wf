command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "PROV-6: `dispose p;` runs at the point it is written exactly the release walk the scope exit would have run for `p`. The run is reclaimed before the entry's own exit edge, which is the difference between a peak of one run and a peak of two.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let run = move fresh;
        let size = len_of(run);
        dispose run;
        region {
          match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
            None() => {
              return exit_status(code: 71_u8);
            }
            Some(value: next) => {
              let second = move next;
              dispose second;
              return exit_status(code: 0_u8);
            }
          }
        }
      }
    }
  }
}
