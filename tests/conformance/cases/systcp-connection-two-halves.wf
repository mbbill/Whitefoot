fn pump(receive: &uniq TcpReceive, send: &uniq TcpSend, scratch: &uniq MutSlice<u8>) -> result: own u8 reads(receive, send, scratch), writes(receive, send, scratch) contract {
  define room = len_of(deref(scratch));
  requires 64_u64 <= room;
} {
  doc "Reads one chunk from the receiving direction and sends it back through the sending direction, holding both directions at once.";
  let outcome = 0_u8;
  region {
    match receive_next(receive: &uniq deref(receive), destination: &uniq deref(scratch), start: 0_u64, end: 64_u64) {
      ReadBytes(next: endpoint) => {
        region {
          let sent = slice_of(&deref(scratch));
          region {
            match send_once(send: &uniq deref(send), source: &sent, start: 0_u64, end: endpoint) {
              Ok(value: accepted) => {
              }
              Err(error: problem) => {
                set outcome = 2_u8;
              }
            }
          }
        }
      }
      ReadEnd() => {
      }
      ReadFailed(error: problem) => {
        set outcome = 3_u8;
      }
    }
  }
  return outcome;
}

command fn main(command.handles as handles: own HandleFactory, command.heap as heap: own Heap) -> status: own ExitStatus reads(handles, heap), writes(handles, heap), allocates(heap) {
  doc "SYS-18: the two directions of one connection are two field places, so `&uniq link.receive` and `&uniq link.send` are two exclusive loans on disjoint fields and coexist [OWN-5]; full duplex is two overlapping places and needs nothing beyond the rules a source struct already has. The checker admits this program and lowering lowers it; the target has no approved row for a TCP submission in this version, so it stops at target qualification, which is not a source-language rejection [QUAL-1].";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 64_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let scratch = move fresh;
        for @fill (
          at in 0_u64..64_u64,
          invariant grown: len_of(scratch) >= at,
          invariant spare: room_of(scratch) + at >= 64_u64,
          invariant flat: head_of(scratch) <= 0_u64
        ) {
          set scratch = place_back(vector: move scratch, value: 0_u8);
        }
        region {
          let window = mut_slice_of(&uniq scratch);
          let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: 9101_u16);
          region {
            match reserve_handle(factory: &uniq handles) {
              Ok(value: permit) => {
                region {
                  match tcp_connect(permit: move permit, address: &address) {
                    Connected(connection: link) => {
                      let outcome = 0_u8;
                      region {
                        set outcome = pump(receive: &uniq link.receive, send: &uniq link.send, scratch: &uniq window);
                      }
                      let returned = close_connection(connection: move link);
                      return exit_status(code: outcome);
                    }
                    ConnectFailed(error: problem, permit: returned) => {
                      return exit_status(code: 4_u8);
                    }
                  }
                }
              }
              Err(error: problem) => {
                return exit_status(code: 5_u8);
              }
            }
          }
        }
      }
    }
  }
}
