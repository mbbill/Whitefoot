fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn pump(receive: &uniq TcpReceive, send: &uniq TcpSend, scratch: &uniq MutSlice<u8>) -> result: own u8 reads(receive, send, scratch), writes(receive, send, scratch) contract {
  define room = len_of(deref(scratch));
  requires 64_u64 <= room;
} {
  doc "Reads one chunk from the receiving direction and sends it back through the sending direction, holding both directions at once.";
  let outcome = 0_u8;
  region {
    match receive_next(receive: &uniq deref(receive), destination: &uniq deref(scratch), start: 0_u64, end: 64_u64) {
      Ok(value: endpoint) => {
        region {
          let sent = slice_of(&deref(scratch));
          region {
            match send_once(send: &uniq deref(send), source: &sent, start: 0_u64, end: endpoint) {
              Ok(value: accepted) => {
              }
              Err(error: problem) => {
                set outcome = 2_u8;
              }
            }
          }
        }
      }
      Err(error: read_stop_3) => {
        match read_stop_3 {
          ReadEnd() => {
          }
          ReadFailed(error: problem) => {
            set outcome = 3_u8;
          }
        }
      }
    }
  }
  return outcome;
}

fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "The ordinary TcpConnection receive and send fields are disjoint places. Two exclusive loans coexist under OWN-5/OWN-7 and the directional calls use normal effects and loans through return; no target classification authorizes overlap.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin) = move inputs;
  region {
    close_directory(factory: &uniq handles, directory: move unused_cwd);
  }
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 64_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let scratch = move fresh;
        for @fill (
          at in 0_u64..64_u64,
          invariant grown: len_of(scratch) >= at,
          invariant spare: room_of(scratch) + at >= 64_u64,
          invariant flat: head_of(scratch) <= 0_u64
        ) {
          place_back(vector: &uniq scratch, value: 0_u8);
        }
        region {
          let window = mut_slice_of(&uniq scratch);
          let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: 9101_u16);
          region {
            region {
              match tcp_connect(factory: &uniq handles, address: &address) {
                Connected(connection: link) => {
                  let outcome = 0_u8;
                  region {
                    set outcome = pump(receive: &uniq link.receive, send: &uniq link.send, scratch: &uniq window);
                  }
                  let TcpConnection(receive: close_receive_4, send: close_send_4) = move link;
                  close_receive(factory: &uniq handles, receive: move close_receive_4);
                  close_send(factory: &uniq handles, send: move close_send_4);
                  return exit_status(code: outcome);
                }
                ConnectFailed(error: problem) => {
                  region {
                    if factory_refusal(error: &problem) {
                      return exit_status(code: 5_u8);
                    }
                  }
                  return exit_status(code: 4_u8);
                }
              }
            }
          }
        }
      }
    }
  }
}
