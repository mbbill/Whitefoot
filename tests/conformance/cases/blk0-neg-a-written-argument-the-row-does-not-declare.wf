fn append(vector: &uniq FixedVector<u8, 4>, value: own u8) -> result: own unit reads(vector), writes(vector) contract {
  requires room_of(deref(vector)) > 0_u64;
} {
  doc "The vector operand supplies T, so BLK-0's per-argument criterion requires no written argument here.";
  region {
    place_back::<u8>(vector: &uniq deref(vector), value: value);
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "BLK-0: written arguments are decided per argument; one the criterion does not require is a hard error naming the operation.";
  return exit_status(code: 0_u8);
}
