fn copy_host['v, 'd](value: &'v HostString, destination: &uniq 'd buffer<u8>) -> return_value: own u64 reads('v 'd), writes('d) contract {
  define capacity = len(deref(destination));
  requires ile(4_u64, capacity);
} {
  region 'c {
    match host_copy_bytes<'v, 'c>(value: value, destination: &uniq 'c deref(destination), start: 0_u64, end: 4_u64) {
      Ok(value: copied) => {
        return copied;
      }
      Err(error: problem) => {
        return 0_u64;
      }
    }
  }
}

command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap), traps {
  doc "A selected place read joins every explicit subscript offset, so a boundary-selected internal stored value remains boundary-derived when reused as a protected offset.";
  let source = buffer_new(4_u64, 0_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 0_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            let copied = copy_host<'v, 'd>(value: &'v text, destination: &uniq 'd source);
          }
        }
      }
      Err(error: absent) => {
      }
    }
  }
  let raw = source[0_u64];
  let widened = cvt<u8, u64>(raw);
  let external_offset = widened % 4_u64;
  let offsets = buffer_new(4_u64, 0_u64);
  let offset_count = len(offsets);
  let selectable = ilt(external_offset, offset_count);
  if selectable {
    let derived_offset = offsets[external_offset];
    let bytes = buffer_new(1_u64, 0_u8);
    let room = len(bytes);
    let inside = ilt(derived_offset, room);
    claim derived_index_in_bytes: inside because "premises: offsets has length 4 and every element is initialized to 0_u64, while the preceding branch admits the selected read and bytes has length 1\nderivation: every selectable offsets element is 0_u64, which is strictly less than the one-byte room\nconclusion: ilt(derived_offset, room) is true\nchecker gap: ENT does not track a buffer initializer value through a selected subscript result\nconsumers: the following bytes[derived_offset] subscript requires this exact bound";
    let value = bytes[derived_offset];
    return exit_status(code: value);
  } else {
    return exit_status(code: 0_u8);
  }
}
