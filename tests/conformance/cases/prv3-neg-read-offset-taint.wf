command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap), traps {
  doc "A selected place read joins every explicit subscript offset, so an externally selected internal stored value remains external when reused as a protected offset.";
  region 'a {
    let external_offset = args_count<'a>(args: &'a args);
    let offsets = buffer_new(4_u64, 0_u64);
    let offset_count = len(offsets);
    let selectable = ilt(external_offset, offset_count);
    if selectable {
      let derived_offset = offsets[external_offset];
      let bytes = buffer_new(1_u64, 0_u8);
      let room = len(bytes);
      let inside = ilt(derived_offset, room);
      claim derived_index_in_bytes: inside because "premises: offsets has length 4 and every element is initialized to 0_u64, while the preceding branch admits the selected read and bytes has length 1\nderivation: every selectable offsets element is 0_u64, which is strictly less than the one-byte room\nconclusion: ilt(derived_offset, room) is true\nchecker gap: ENT does not track a buffer initializer value through an externally selected subscript result\nconsumers: the following bytes[derived_offset] subscript requires this exact bound";
      let value = bytes[derived_offset];
      return exit_status(code: 0_u8);
    } else {
      return exit_status(code: 0_u8);
    }
  }
}
