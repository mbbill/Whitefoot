command fn main(command.args as args: own Args) -> return_value: own ExitStatus reads(args), allocates(heap), traps {
  doc "External provenance in a buffer length is handled by ordinary control. A genuine residual constrains only a same-function offset, and the two facts jointly protect the external-length subscript.";
  region 'a {
    let external_length = args_count<'a>(args: &'a args);
    let bytes = buffer_new(external_length, 0_u8);
    let raw_index = 0_u64;
    let index = raw_index % 1_u64;
    let index_below_one = ilt(index, 1_u64);
    claim local_index: index_below_one because "premises: index is raw_index remainder 1_u64 computed in this function\nderivation: unsigned remainder by 1_u64 is 0_u64 and therefore strictly less than 1_u64\nconclusion: ilt(index, 1_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: together with the later ordinary room_nonempty branch, this bound discharges the bytes[index] subscript";
    let room = len(bytes);
    let room_nonempty = ile(1_u64, room);
    if room_nonempty {
      let value = bytes[index];
      return exit_status(code: 0_u8);
    } else {
      return exit_status(code: 1_u8);
    }
  }
}
