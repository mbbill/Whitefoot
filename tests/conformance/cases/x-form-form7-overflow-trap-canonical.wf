fn main() -> own unit traps {
  doc "The bare + overflows i32 max by one and traps [FORM-7]. Both operands are bound terms, so this is the retained two-non-constant trapping form OP-2's constant-operand class does not reach.";
  let a = 2147483647_i32;
  let one = 1_i32;
  let b = a + one;
  return unit;
}
