enum LeftEq {
  LeftFirst();
  LeftSecond();
}

enum RightEq {
  RightFirst();
  RightSecond();
}

fn compare(left: own LeftEq, right: own RightEq) -> return_value: own Bool pure {
  return eeq(left, right);
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
