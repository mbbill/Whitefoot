command fn main() -> status: own ExitStatus pure {
  doc "[MSR-2] a write to P's own descriptor storage kills every measure of P. The [SET-2] replace exchanges the whole run for a two-slot allocation, which overlaps the descriptor storage the length fact is supported by, so `len_of(run) = 10` does not survive it and the later subscript of offset nine has nothing to discharge against. This is the other side of the element-position sentence: descriptor storage and element storage are disjoint parts of one value, and a write kills exactly the measures whose support it overlaps.";
  let run = buffer_new(10_u64, 0_u8);
  let smaller = buffer_new(2_u64, 0_u8);
  let old = replace run = move smaller;
  let tail = run[9_u64];
  return exit_status(code: 0_u8);
}
