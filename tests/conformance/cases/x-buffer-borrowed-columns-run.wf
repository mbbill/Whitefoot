struct Columns {
  left: buffer<u64>;
  right: buffer<u64>;
}

fn fill['r](left: &uniq 'r buffer<u64>, right: &uniq 'r buffer<u64>, length: own u64) -> function_result: own unit writes(left, right) contract {
  define left_length = len(deref(left));
  define right_length = len(deref(right));
  requires length <= left_length;
  requires length <= right_length;
} {
  for (index_value in 0_u64..length) {
    set deref(left)[index_value] = index_value;
    let shifted = index_value +wrap 10_u64;
    set deref(right)[index_value] = shifted;
  }
  return unit;
}

fn fold['r](left: &'r buffer<u64>, right: &'r buffer<u64>, length: own u64) -> function_result: own u64 reads(left, right) contract {
  define left_length = len(deref(left));
  define right_length = len(deref(right));
  requires length <= left_length;
  requires length <= right_length;
} {
  let total = 0_u64;
  for (index_value in 0_u64..length) {
    let left_value = deref(left)[index_value];
    let right_value = deref(right)[index_value];
    set total = total +wrap left_value;
    set total = total +wrap right_value;
  }
  return total;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let length = 4_u64;
  let left = buffer_new(length, 0_u64);
  let right = buffer_new(length, 0_u64);
  let columns = Columns(left: move left, right: move right);
  let fill_left_length = len(columns.left);
  if length <= fill_left_length {
  } else {
    return exit_status(code: 202_u8);
  }
  let fill_right_length = len(columns.right);
  if length <= fill_right_length {
  } else {
    return exit_status(code: 203_u8);
  }
  region {
    let left_out = &uniq columns.left;
    let right_out = &uniq columns.right;
    fill(left: move left_out, right: move right_out, length: length);
  }
  let fold_left_length = len(columns.left);
  if length <= fold_left_length {
  } else {
    return exit_status(code: 204_u8);
  }
  let fold_right_length = len(columns.right);
  if length <= fold_right_length {
  } else {
    return exit_status(code: 205_u8);
  }
  region {
    let left_in = &columns.left;
    let right_in = &columns.right;
    let total = fold(left: left_in, right: right_in, length: length);
    if total == 52_u64 {
    } else {
      return exit_status(code: 201_u8);
    }
  }
  return exit_status(code: 0_u8);
}
