struct Columns {
  left: buffer<u64>;
  right: buffer<u64>;
}

fn fill['r](left: &uniq 'r buffer<u64>, right: &uniq 'r buffer<u64>, length: own u64) -> own unit reads('r), writes('r), traps {
  let left_room = len(deref(left));
  let right_room = len(deref(right));
  let index_value = 0_u64;
  loop @fill {
    let done = index_value == length;
    if done {
      break @fill;
    } else {
      let in_left = ilt(index_value, left_room);
      claim left_in_range: in_left because "fill walks 0..length and callers size the left column to length";
      set deref(left)[index_value] = index_value;
      let shifted = index_value +wrap 10_u64;
      let in_right = ilt(index_value, right_room);
      claim right_in_range: in_right because "fill walks 0..length and callers size the right column to length";
      set deref(right)[index_value] = shifted;
      set index_value = index_value +wrap 1_u64;
    }
  }
  return unit;
}

fn fold['r](left: &'r buffer<u64>, right: &'r buffer<u64>, length: own u64) -> own u64 reads('r), traps {
  let left_room = len(deref(left));
  let right_room = len(deref(right));
  let index_value = 0_u64;
  let total = 0_u64;
  loop @fold {
    let done = index_value == length;
    if done {
      break @fold;
    } else {
      let in_left = ilt(index_value, left_room);
      claim left_in_range: in_left because "fold walks 0..length over columns sized to length";
      let left_value = deref(left)[index_value];
      let in_right = ilt(index_value, right_room);
      claim right_in_range: in_right because "fold walks 0..length over columns sized to length";
      let right_value = deref(right)[index_value];
      set total = total +wrap left_value;
      set total = total +wrap right_value;
      set index_value = index_value +wrap 1_u64;
    }
  }
  return total;
}

fn main() -> own unit allocates(heap), traps {
  let length = 4_u64;
  let left = buffer_new(length, 0_u64);
  let right = buffer_new(length, 0_u64);
  let columns = Columns(left: move left, right: move right);
  region 'fill_region {
    let left_out = &uniq 'fill_region columns.left;
    let right_out = &uniq 'fill_region columns.right;
    fill<'fill_region>(left: move left_out, right: move right_out, length: length);
  }
  region 'fold_region {
    let left_in = &'fold_region columns.left;
    let right_in = &'fold_region columns.right;
    let total = fold<'fold_region>(left: left_in, right: right_in, length: length);
    check total == 52_u64 else trap "borrowed columns";
  }
  return unit;
}
