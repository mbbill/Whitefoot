struct Columns {
  left: Box<Slots<u64>>;
  right: Box<Slots<u64>>;
}

fn fill(left: &[u64], right: &[u64], length: own u64) -> function_result: own unit writes(left), writes(right) contract {
  define left_length = left.len;
  define right_length = right.len;
  requires length <= left_length;
  requires length <= right_length;
} {
  doc "Writes both ranges; the two declared write paths have different roots, so the call site proves them disjoint [EFF-5].";
  for (index_value in 0_u64..length) {
    set left[index_value] = index_value;
    let shifted = index_value +wrap 10_u64;
    set right[index_value] = shifted;
  }
  return unit;
}

fn fold(left: &[u64], right: &[u64], length: own u64) -> function_result: own u64 reads(left), reads(right) contract {
  define left_length = left.len;
  define right_length = right.len;
  requires length <= left_length;
  requires length <= right_length;
} {
  doc "Reads both ranges and returns their combined total.";
  let total = 0_u64;
  for (index_value in 0_u64..length) {
    let left_value = left[index_value];
    let right_value = right[index_value];
    set total = total +wrap left_value;
    set total = total +wrap right_value;
  }
  return total;
}

fn main() -> status: own ExitStatus pure {
  doc "Two heap-resident runs held in one struct are written and read through range references over their fields. Two field selections of different fields never overlap [OWN-7], so both calls are admitted, and the caller keeps both window lengths across these element-only calls.";
  let length = 4_u64;
  let left = box_slots_new::<u64>(capacity: 4_u64);
  for @fill_left (
    at in 0_u64..4_u64,
    invariant grown_left: deref(left).len >= at,
    invariant spare_left: deref(left).room + at >= 4_u64
  ) {
    place_back(window: &deref(left), value: 0_u64);
  }
  let right = box_slots_new::<u64>(capacity: 4_u64);
  for @fill_right (
    at in 0_u64..4_u64,
    invariant grown_right: deref(right).len >= at,
    invariant spare_right: deref(right).room + at >= 4_u64
  ) {
    place_back(window: &deref(right), value: 0_u64);
  }
  let columns = Columns(left: move left, right: move right);
  let fill_left_length = deref(columns.left).len;
  if length <= fill_left_length {
  } else {
    return exit_status(code: 202_u8);
  }
  let fill_right_length = deref(columns.right).len;
  if length <= fill_right_length {
  } else {
    return exit_status(code: 203_u8);
  }
  let left_out = &deref(columns.left)[0_u64..fill_left_length];
  let right_out = &deref(columns.right)[0_u64..fill_right_length];
  fill(left: left_out, right: right_out, length: length);
  let fold_left_length = deref(columns.left).len;
  if length <= fold_left_length {
  } else {
    return exit_status(code: 204_u8);
  }
  let fold_right_length = deref(columns.right).len;
  if length <= fold_right_length {
  } else {
    return exit_status(code: 205_u8);
  }
  let left_in = &deref(columns.left)[0_u64..fold_left_length];
  let right_in = &deref(columns.right)[0_u64..fold_right_length];
  let total = fold(left: left_in, right: right_in, length: length);
  if total == 52_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
