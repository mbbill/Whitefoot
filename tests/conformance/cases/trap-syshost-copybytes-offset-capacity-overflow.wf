command fn main(command.args as args: own Args) -> own ExitStatus allocates(heap), traps {
  doc "SYS-8: range validation precedes every other action. Overflow of the mathematical sum of the two range values in u64 traps under the OP-4 bounds semantics before any host transfer, before any read of the source value, and before any write of the destination. A trap aborts the whole process and produces no status [TRAP-1], so nothing after it observes the buffer.";
  let bytes = buffer_new(4_u64, 0_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_bytes<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, offset: 18446744073709551615_u64, capacity: 1_u64) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                return exit_status(code: 11_u8);
              }
            }
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 12_u8);
      }
    }
  }
}
