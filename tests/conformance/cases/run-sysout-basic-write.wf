command fn main(command.stdout as out: own Output) -> own ExitStatus allocates(heap), external, blocks, traps {
  doc "SYS-8: the positive baseline of the output half. One write_once makes at most one host output attempt and its Ok payload is the exact accepted length; the target adds no hidden userspace buffering, so the count the host accepted is the count source sees [SYS-12].";
  let bytes: own buffer<u8> = buffer_new<u8>(5_u64, 65_u8);
  region 'o {
    region 's {
      match write_once<'o, 's>(output: &uniq 'o out, source: &'s bytes, offset: 0_u64, count: 5_u64) {
        Ok(value: written) => {
          let complete: own Bool = ieq<u64>(written, 5_u64);
          match complete {
            True() => {
              return exit_status(code: 0_u8);
            }
            False() => {
              return exit_status(code: 10_u8);
            }
          }
        }
        Err(error: problem) => {
          return exit_status(code: 11_u8);
        }
      }
    }
  }
}
