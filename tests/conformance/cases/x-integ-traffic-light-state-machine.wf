enum Light {
  Red();
  Green();
  Yellow();
}

fn main() -> own unit traps {
  doc "A traffic-light state machine advanced by value-matches: each match moves the own state and gives its own successor, so after three transitions the light returns to Red [OWN-13, GIVE-1, OP-1, SCOPE-3].";
  let s0 = Red();
  let s1 = match s0 {
    Red() => {
      give Green();
    }
    Green() => {
      give Yellow();
    }
    Yellow() => {
      give Red();
    }
  }
  let s2 = match s1 {
    Red() => {
      give Green();
    }
    Green() => {
      give Yellow();
    }
    Yellow() => {
      give Red();
    }
  }
  let s3 = match s2 {
    Red() => {
      give Green();
    }
    Green() => {
      give Yellow();
    }
    Yellow() => {
      give Red();
    }
  }
  let code = match s3 {
    Red() => {
      give 0_i32;
    }
    Green() => {
      give 1_i32;
    }
    Yellow() => {
      give 2_i32;
    }
  }
  claim cycle_did_not_return_to_red: ieq(code, 0_i32) because "cycle did not return to Red";
  return unit;
}
