fn relay<T: Int>(value: own T) -> result: own T pure contract {
  ensures ieq(result, value);
} {
  return value;
}

fn accept_bound(value: own u64, limit: own u64) -> result: own u64 pure contract {
  define admitted = ile(value, limit);
  requires admitted;
} {
  return value;
}

fn cycle_left(remaining: own u64) -> result: own u64 pure {
  let done = ieq(remaining, 0_u64);
  if done {
    return 0_u64;
  } else {
    let next = remaining -wrap 1_u64;
    let result = cycle_right(remaining: next);
    return result;
  }
}

fn cycle_right(remaining: own u64) -> result: own u64 pure {
  let done = ieq(remaining, 0_u64);
  if done {
    return 1_u64;
  } else {
    let next = remaining -wrap 1_u64;
    let result = cycle_left(remaining: next);
    return result;
  }
}

deny_claims command fn main() -> status: own ExitStatus pure {
  let candidate_length = 7_u64;
  let prior_length = 0_u64;
  let capacity = 8_u64;
  let candidate_fits = ile(candidate_length, capacity);
  let bounded_length = if candidate_fits {
    give candidate_length;
  } else {
    give prior_length;
  }
  let relayed_length = relay<u64>(value: bounded_length);
  let accepted_length = accept_bound(value: relayed_length, limit: capacity);
  let cycle_result = cycle_left(remaining: 2_u64);
  let cycle_holds = ieq(cycle_result, 0_u64);
  if cycle_holds {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
