struct Cell {
  v: u8;
}

fn h3(b: &uniq Cell, w: own u8) -> result: own u8 reads(b.v), writes(b.v) {
  let old = deref(b).v;
  let bounded = old <= 5_u8;
  if bounded {
    set deref(b).v = w;
    let cur = deref(b).v;
    let z = cur + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
