fn pass['r](value: &i32) -> result: &'r i32 pure {
  doc "Eliding the parameter's region makes it a region of its own, distinct from the written result region, and a borrow in that distinct region does not outlive the written result region, so the return is rejected [OWN-4].";
  return value;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
