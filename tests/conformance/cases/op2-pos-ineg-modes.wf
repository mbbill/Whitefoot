command fn main() -> return_value: own ExitStatus traps {
  doc "OP-2: integer negation has exact, wrap, and checked rows; the exact row is admitted only when its ineg.defined obligation is proved.";
  let wrapped = ineg.wrap(-128_i8);
  claim wrapped_negation_drift: ieq(wrapped, -128_i8) because "wrapped negation drift";
  let exact = ineg(-42_i8);
  claim exact_negation_drift: ieq(exact, 42_i8) because "exact negation drift";
  let checked_minimum = ineg.checked(-128_i8);
  match move checked_minimum {
    Ok(value: unexpected_value) => {
      claim checked_minimum_negation_took_ok: False() because "checked minimum negation took Ok";
    }
    Err(error: overflow_error) => {
    }
  }
  return exit_status(code: 0_u8);
}
