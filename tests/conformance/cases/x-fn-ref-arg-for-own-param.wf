fn takesown(n: own i32) -> function_result: own i32 pure {
  doc "Parameter n is an own i32 [FN-1].";
  return n;
}

command fn main() -> status: own ExitStatus pure {
  doc "Caller passes a shared borrow where the signature declares an own value [FN-1].";
  let a = 5_i32;
  region {
    let b = &a;
    let r = takesown(n: b);
  }
  return exit_status(code: 0_u8);
}
