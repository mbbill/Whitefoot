fn takesown(n: own i32) -> function_result: own i32 pure {
  doc "Parameter n is an own i32 [FN-1].";
  return n;
}

fn main() -> status: own ExitStatus pure {
  doc "The caller writes a reference where the signature declares an own value. A reference is a name for a path [REF-1], so the argument resolves to that path and is read bare at the own parameter; this is the admitted half of the mode pair whose other half, an own value at a reference parameter, stays a TYPE-5 mismatch. v0.59 rejected this spelling under TYPE-7.";
  let a = 5_i32;
  let b = &a;
  let r = takesown(n: b);
  return exit_status(code: 0_u8);
}
