fn main() -> status: own ExitStatus pure {
  doc "TYPE-10: len, cap, room and head are read-only pseudo-fields of a measured place; a program reads them like fields and only the window and construction operations change them.";
  let r = ring_new::<u64, 4>();
  let before = r.len;
  place_back(window: &r, value: 1_u64);
  let after = r.len;
  let capacity = r.cap;
  let spare = r.room;
  let origin = r.head;
  if before == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if after == 1_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  if capacity == 4_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  if spare == 3_u64 {
  } else {
    return exit_status(code: 4_u8);
  }
  if origin == 0_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
