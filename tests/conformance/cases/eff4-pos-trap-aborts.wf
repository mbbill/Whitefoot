fn positive_divisor(value: own u64) -> result: own u64 pure {
  return imax(value, 1_u64);
}

command fn main() -> status: own ExitStatus traps {
  doc "The source claim is a true, load-bearing residual and therefore runs normally. EFF-4's abort-without-cleanup behavior is exercised by typed-IR fault injection after source acceptance.";
  let injection_false = False();
  let divisor = positive_divisor(value: 0_u64);
  let nonzero = ine(divisor, 0_u64);
  claim reviewed_divisor: nonzero because "premises: divisor is returned by positive_divisor, whose body computes imax(value, 1_u64)\nderivation: imax with 1_u64 is at least 1_u64 and therefore cannot equal 0_u64\nconclusion: ine(divisor, 0_u64) is true\nchecker gap: ENT does not publish the result bound of an uncontracted user call\nconsumers: the following exact 84_u64 / divisor operation requires this nonzero fact";
  let quotient = 84_u64 / divisor;
  if injection_false {
    return exit_status(code: 1_u8);
  }
  let expected = ieq(quotient, 84_u64);
  if expected {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
