command fn main() -> status: own ExitStatus traps {
  doc "The source claim is a true, load-bearing residual and therefore runs normally. EFF-4's abort-without-cleanup behavior is exercised by typed-IR fault injection after source acceptance.";
  let injection_false = False();
  let seed = 0_u64;
  let residue = seed % 2_u64;
  let divisor = residue +wrap 1_u64;
  let nonzero = ine(divisor, 0_u64);
  claim reviewed_divisor: nonzero because "premises: residue is seed remainder 2_u64 in this function and divisor is residue plus 1_u64 with wrapping semantics\nderivation: unsigned remainder by 2_u64 is 0_u64 or 1_u64, so divisor is 1_u64 or 2_u64 and cannot equal 0_u64\nconclusion: ine(divisor, 0_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range through the wrapping offset\nconsumers: the following exact 84_u64 / divisor operation requires this nonzero fact";
  let quotient = 84_u64 / divisor;
  if injection_false {
    return exit_status(code: 1_u8);
  }
  let expected = ieq(quotient, 84_u64);
  if expected {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
