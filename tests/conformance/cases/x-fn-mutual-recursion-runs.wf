fn iseven(n: own i32) -> function_result: own i32 pure {
  doc "Mutually recursive with isodd; returns 1 when n is even [FN-1, FN-6]. The guard is `ile` so the else arm establishes n > 0, discharging the OP-2 overflow obligation on the class site `n - 1_i32`; a discharged class site exhibits no `traps`, so the row is `pure`.";
  if ile(n, 0_i32) {
    return 1_i32;
  } else {
    let m = n - 1_i32;
    return isodd(n: m);
  }
}

fn isodd(n: own i32) -> function_result: own i32 pure {
  doc "Mutually recursive with iseven; returns 0 when n is even [FN-1, FN-6]. The guard is `ile` so the else arm establishes n > 0, discharging the OP-2 overflow obligation on the class site `n - 1_i32`; a discharged class site exhibits no `traps`, so the row is `pure`.";
  if ile(n, 0_i32) {
    return 0_i32;
  } else {
    let m = n - 1_i32;
    return iseven(n: m);
  }
}

command fn main() -> status: own ExitStatus traps {
  doc "Mutual recursion resolves across two signatures; forward reference is legal [FN-1].";
  let r = iseven(n: 8_i32);
  claim c_8_is_even: ieq(r, 1_i32) because "8 is even";
  return exit_status(code: 0_u8);
}
