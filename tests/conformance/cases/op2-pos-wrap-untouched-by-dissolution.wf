fn fold(x: own u64) -> return_value: own u64 pure {
  doc "The arithmetic-mode dissolution attaches obligations to the bare `+`, `-`, `*` constant-operand class only. `.wrap` is total by definition, carries no overflow obligation, needs no discharge, and contributes nothing to the effect row, so an unbounded operand is valid and the row stays `pure`.";
  let y = x *wrap 3_u64;
  return y;
}

command fn main() -> return_value: own ExitStatus pure {
  let folded = fold(x: 24_u64);
  if folded == 72_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
