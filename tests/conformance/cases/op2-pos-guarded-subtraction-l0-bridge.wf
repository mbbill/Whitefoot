fn distance(upper: own u64, lower: own u64) -> result: own u64 pure {
  let ordered = ile(lower, upper);
  if ordered {
    let difference = upper - lower;
    return difference;
  } else {
    return 0_u64;
  }
}

command fn main() -> status: own ExitStatus pure {
  let result = distance(upper: 9_u64, lower: 4_u64);
  if ieq(result, 5_u64) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
