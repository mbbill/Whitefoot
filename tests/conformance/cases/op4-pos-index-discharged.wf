fn get(b: own buffer<i32>, i: own u64) -> own i32 traps {
  doc "The identical unproven subscript accepts once a named claim dominates it: the passed predicate enters the fact state [CLM-1, ENT-3] and the discharged subscript compiles with no runtime bounds branch [OP-4].";
  let n: own u64 = len<i32>(b);
  let ok: own Bool = ilt<u64>(i, n);
  claim offset_in_bounds: ok because "callers index below the buffer length";
  return b[i];
}

fn main() -> own unit pure {
  return unit;
}
