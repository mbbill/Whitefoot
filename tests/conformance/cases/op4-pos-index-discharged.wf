const values: array<i32, 4> =[10_i32, 20_i32, 30_i32, 40_i32];

fn get(i: own u64) -> result: own i32 traps {
  doc "A reviewed theorem outside ENT states the exact subscript bound [CLM-1, CLM-2]. The retained claim is necessary for the following proof-required subscript [OP-4].";
  let bounded = i % 4_u64;
  let inside = ilt(bounded, 4_u64);
  claim offset_in_bounds: inside because "premises: values has length four and bounded is i remainder 4_u64 computed in this function\nderivation: unsigned remainder by 4_u64 is at most 3_u64 and therefore strictly less than the array length\nconclusion: ilt(bounded, 4_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following values[bounded] subscript requires this exact bound";
  return values[bounded];
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
