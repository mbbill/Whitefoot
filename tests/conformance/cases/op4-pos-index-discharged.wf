const values: array<i32, 4> =[10_i32, 20_i32, 30_i32, 40_i32];

fn clamp_three(value: own u64) -> result: own u64 pure {
  return imin(value, 3_u64);
}

fn get(i: own u64) -> result: own i32 traps {
  doc "A reviewed theorem outside ENT states the exact subscript bound [CLM-1, CLM-2]. The retained claim is necessary for the following proof-required subscript [OP-4].";
  let bounded = clamp_three(value: i);
  let inside = ilt(bounded, 4_u64);
  claim offset_in_bounds: inside because "premises: values has length four and bounded is returned by clamp_three, whose body computes imin(i, 3_u64)\nderivation: imin is no greater than 3_u64, which is strictly less than 4_u64\nconclusion: ilt(bounded, 4_u64) is true\nchecker gap: ENT does not publish the result bound of an uncontracted user call\nconsumers: the following values[bounded] subscript requires this exact bound";
  return values[bounded];
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
