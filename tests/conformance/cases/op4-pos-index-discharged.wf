const values: FixedVector<i32, 4> =[10_i32, 20_i32, 30_i32, 40_i32];

fn get(i: own u64) -> result: own i32 pure {
  doc "The deterministic remainder rule derives 0 <= bounded < 4, which discharges the following const-run subscript obligation [OP-4].";
  let bounded = i % 4_u64;
  return values[bounded];
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
