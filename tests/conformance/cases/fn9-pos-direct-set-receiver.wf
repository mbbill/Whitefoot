fn choose(ignored: own i32, value: own i32) -> own i32 pure ensures result {
  check ieq(result, value) else trap "choose postcondition";
} {
  return value;
}

fn relay(slot: own i32, replacement: own i32) -> own i32 pure ensures result {
  check ieq(result, replacement) else trap "relay postcondition";
} {
  set slot = choose(ignored: slot, value: replacement);
  return slot;
}

fn main() -> own unit pure {
  return unit;
}
