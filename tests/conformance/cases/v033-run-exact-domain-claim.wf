command fn main() -> status: own ExitStatus traps {
  let left_seed = 40_i32;
  let right_seed = 2_i32;
  let left = left_seed % 41_i32;
  let right = right_seed % 3_i32;
  claim addition_is_defined: left +defined right because "premises: left and right are same-function signed remainders by 41_i32 and 3_i32 respectively\nderivation: left is between -40_i32 and 40_i32 and right is between -2_i32 and 2_i32, so their sum is between -42_i32 and 42_i32 and is representable as i32\nconclusion: left +defined right is true\nchecker gap: ENT proves both remainder operation domains but does not publish either result range\nconsumers: the following exact addition needs the complete IntegerDomain obligation";
  let sum = left + right;
  if ieq(sum, 42_i32) {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
