command fn main['qw, 'dhw, 'dw, 'fw, 'rhw, 'rcw](command.args as args: own Args, command.cwd as cwd: own DirectoryRead<'qw, 'dhw, 'dw, 'fw>) -> status: own ExitStatus reads('dhw 'dw 'fw 'rhw), writes('qw 'dhw 'rhw 'rcw), allocates(heap) {
  doc "SYS-8: a file larger than the buffer needs repeated calls, each ReadBytes payload is the absolute endpoint of that call's changed prefix, and the source cursor advances by next - start. On the final short read exactly [start, next) may have changed while every other byte of the reused buffer is unchanged. Repetition and accumulation are ordinary source loops, not a read-exact primitive.";
  let page = buffer_new(8_u64, 0_u8);
  let total = 0_u64;
  let chunks = 0_u64;
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region 'c {
              region 'p {
                match open_read<'c, 'p, 'qw, 'dhw, 'dw, 'fw, 'rhw, 'rcw>(root: &'c cwd, path: &'p path) {
                  Ok(value: file) => {
                    loop @scan {
                      let failed = False();
                      region 'f {
                        region 'd {
                          match read_once<'f, 'd, 'qw, 'rhw, 'rcw, 'fw>(file: &uniq 'f file, destination: &uniq 'd page, start: 0_u64, end: 8_u64) {
                            ReadBytes(next: n) => {
                              set total = total +wrap n;
                              set chunks = chunks +wrap 1_u64;
                            }
                            ReadEnd() => {
                              set failed = True();
                            }
                            ReadFailed(error: problem) => {
                              return exit_status(code: 10_u8);
                            }
                          }
                        }
                      }
                      if failed {
                        break @scan;
                      }
                    }
                    let counted = ieq(total, 20_u64);
                    if counted {
                    } else {
                      return exit_status(code: 11_u8);
                    }
                    let repeated = ieq(chunks, 3_u64);
                    if repeated {
                    } else {
                      return exit_status(code: 12_u8);
                    }
                    let last_first = page[0_u64];
                    let wrote_prefix = ieq(last_first, 103_u8);
                    if wrote_prefix {
                    } else {
                      return exit_status(code: 13_u8);
                    }
                    let last_fourth = page[3_u64];
                    let wrote_end = ieq(last_fourth, 106_u8);
                    if wrote_end {
                    } else {
                      return exit_status(code: 14_u8);
                    }
                    let carried = page[4_u64];
                    let untouched = ieq(carried, 99_u8);
                    if untouched {
                    } else {
                      return exit_status(code: 15_u8);
                    }
                    let carried_last = page[7_u64];
                    let untouched_last = ieq(carried_last, 102_u8);
                    if untouched_last {
                      return exit_status(code: 0_u8);
                    } else {
                      return exit_status(code: 16_u8);
                    }
                  }
                  Err(error: problem) => {
                    return exit_status(code: 17_u8);
                  }
                }
              }
            }
          }
          Err(error: rejected) => {
            return exit_status(code: 18_u8);
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 19_u8);
      }
    }
  }
}
