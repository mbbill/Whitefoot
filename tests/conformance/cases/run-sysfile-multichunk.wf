command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, files), writes(cwd, files), allocates(heap) {
  doc "SYS-8: a file larger than the buffer needs repeated calls, each ReadBytes payload is the absolute endpoint of that call's changed prefix, and source code advances the explicit file offset by next - start. On the final short read exactly [start, next) may have changed while every other byte of the reused buffer is unchanged. Repetition and accumulation are ordinary source loops, not a read-exact primitive.";
  let page = buffer_new(8_u64, 0_u8);
  let total = 0_u64;
  let chunks = 0_u64;
  let file_offset = 0_u64;
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region 'c {
              region {
                let permit = reserve_file(factory: &uniq 'c files);
                match open_read(permit: move permit, root: &'c cwd, path: &path) {
                  Ok(value: file) => {
                    loop @scan {
                      let failed = False();
                      region 'f {
                        region {
                          match read_at(file: &'f file, destination: &uniq page, file_offset: file_offset, start: 0_u64, end: 8_u64) {
                            ReadBytes(next: n) => {
                              set total = total +wrap n;
                              set chunks = chunks +wrap 1_u64;
                              set file_offset = file_offset +wrap n;
                            }
                            ReadEnd() => {
                              set failed = True();
                            }
                            ReadFailed(error: problem) => {
                              return exit_status(code: 10_u8);
                            }
                          }
                        }
                      }
                      if failed {
                        break @scan;
                      }
                    }
                    let counted = total == 20_u64;
                    if counted {
                    } else {
                      return exit_status(code: 11_u8);
                    }
                    let repeated = chunks == 3_u64;
                    if repeated {
                    } else {
                      return exit_status(code: 12_u8);
                    }
                    let last_first = page[0_u64];
                    let wrote_prefix = last_first == 103_u8;
                    if wrote_prefix {
                    } else {
                      return exit_status(code: 13_u8);
                    }
                    let last_fourth = page[3_u64];
                    let wrote_end = last_fourth == 106_u8;
                    if wrote_end {
                    } else {
                      return exit_status(code: 14_u8);
                    }
                    let carried = page[4_u64];
                    let untouched = carried == 99_u8;
                    if untouched {
                    } else {
                      return exit_status(code: 15_u8);
                    }
                    let carried_last = page[7_u64];
                    let untouched_last = carried_last == 102_u8;
                    if untouched_last {
                      return exit_status(code: 0_u8);
                    } else {
                      return exit_status(code: 16_u8);
                    }
                  }
                  Err(error: problem) => {
                    return exit_status(code: 17_u8);
                  }
                }
              }
            }
          }
          Err(error: rejected) => {
            return exit_status(code: 18_u8);
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 19_u8);
      }
    }
  }
}
