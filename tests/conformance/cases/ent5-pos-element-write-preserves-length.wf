fn main() -> own unit allocates(heap), traps {
  doc "The support of a length term is the root binding of the place, not the place's element storage, so an element write never kills a length fact [ENT-5] -- a buffer's length is fixed at allocation. The write through the first subscript leaves len(b) = 4 standing, and the later subscript still discharges [OP-4].";
  let b: own buffer<u8> = buffer_new<u8>(4_u64, 0_u8);
  set b[0_u64] = 1_u8;
  let value: own u8 = b[2_u64];
  return unit;
}
