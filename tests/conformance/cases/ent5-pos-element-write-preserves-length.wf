fn main() -> status: own ExitStatus pure {
  doc "The support of a length term is the descriptor storage of the place, not the place's element storage, so an element write never kills a length fact [ENT-5] -- a run's window is moved only by an operation that moves a boundary. The write through the first subscript leaves len_of(b) = 4 standing, and the later subscript still discharges [OP-4].";
  let empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq empty, value: 0_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 0_u8);
  }
  let two = move one;
  region {
    place_back(vector: &uniq two, value: 0_u8);
  }
  let three = move two;
  region {
    place_back(vector: &uniq three, value: 0_u8);
  }
  let b = move three;
  set b[0_u64] = 1_u8;
  let value = b[2_u64];
  return exit_status(code: 0_u8);
}
