enum State {
  Ready();
}

enum Wrapper {
  Wrapped(state: State);
}

fn inspect(wrapper: own Wrapper) -> return_value: own unit pure {
  doc "OWN-1: a concrete tag-only payload binder remains Copy and may be matched repeatedly.";
  match wrapper {
    Wrapped(state: inner) => {
      match inner {
        Ready() => {
        }
      }
      match inner {
        Ready() => {
        }
      }
    }
  }
  return unit;
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
