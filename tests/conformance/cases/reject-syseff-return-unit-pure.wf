fn release_read_file['q, 'h, 'c, 'f](file: own ReadFile<'q, 'h, 'c, 'f>) -> function_result: own unit pure {
  doc "The omission direction of the EFF-2 canonical case: the body has no syntactic effect at all, but the owned ReadFile's release contributes `writes('q 'h)` on the return edge, so declaring `pure` is an undeclared-but-exhibited rejection at the effects node.";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
