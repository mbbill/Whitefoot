fn release_read_file(file: own ReadFile) -> own unit pure {
  doc "The omission direction of the EFF-2 canonical case: the body has no syntactic effect at all, but the owned ReadFile's release contributes `external, blocks` on the return edge, so declaring `pure` is an undeclared-but-exhibited rejection at the effects node.";
  return unit;
}

command fn main() -> own ExitStatus pure {
  return exit_status(code: 0_u8);
}
