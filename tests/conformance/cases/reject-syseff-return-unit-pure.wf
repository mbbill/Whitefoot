fn release_read_file(file: own ReadFile) -> function_result: own unit pure {
  doc "The omission direction of the EFF-2 canonical case: the owned ReadFile's release contributes writes(file), so declaring pure is rejected at the effects node.";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
