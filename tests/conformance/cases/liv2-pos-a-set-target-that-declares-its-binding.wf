fn split(value: own u64) -> (low: own u64, high: own u64) pure {
  doc "Two declared results, so one commit has two ordinals.";
  let half = value /checked 2_u64;
  match half {
    Ok(value: quotient) => {
      return quotient, value;
    }
    Err(error: divided) => {
      return 0_u64, value;
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "LIV-2: a target identifier that resolves to no binding declares one exactly as a `let` binder does - a fresh declaration of the enclosing block, visible after the complete `set` statement and not inside it, with the mode and type of its own ordinal.";
  let start = 8_u64;
  set (low, high) = split(value: start);
  if low == 4_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if high == 8_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
