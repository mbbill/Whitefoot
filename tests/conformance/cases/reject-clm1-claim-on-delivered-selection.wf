fn hidden_true() -> result: own Bool pure {
  return True();
}

fn read(values: own array<u8, 4>, unused: own u64) -> result: own u8 traps {
  let condition = hidden_true();
  let picked = if condition {
    give 0_u64;
  } else {
    give 1_u64;
  }
  claim reviewed_delivery: ilt(picked, 4_u64) because "premises: picked is the value this value_if delivered\nderivation: both arms deliver a literal below 4_u64, so the delivered value is below 4_u64 whichever arm ran\nconclusion: ilt(picked, 4_u64) is true\nchecker gap: a value_if delivers the value its selector chose, and this selector is a call result, so CLM-1 must refuse the claim whatever the arms deliver\nconsumers: the following values[picked] subscript would otherwise consume this assertion";
  return values[picked];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
