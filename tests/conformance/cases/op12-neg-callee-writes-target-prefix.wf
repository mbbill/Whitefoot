struct Counter {
  value: u64;
}

fn recomputed(current: own u64, holder: &Box<Counter>) -> result: own u64 writes(deref(holder)) {
  doc "OP-12 refuses this callee at the update site: its declared row writes a proper prefix of the target place.";
  set deref(holder) = Counter(value: 0_u64);
  return current;
}

fn main() -> status: own ExitStatus pure {
  doc "OP-12: f's declared row must not write, move out of, or free any prefix of the target place; a row that does is a hard error at the complete call.";
  let start = Counter(value: 1_u64);
  let cell = box_new::<Counter>(value: move start);
  set deref(cell).value = recomputed(current: deref(cell).value, holder: &cell);
  let seen = deref(cell).value;
  if seen == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
