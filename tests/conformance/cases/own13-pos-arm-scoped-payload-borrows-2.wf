enum Packet {
  Data(value: i32);
  Idle();
}

fn main() -> status: own ExitStatus pure {
  doc "Repeated matches through one reference each derive their own arm-scoped payload binder, and the scrutinee stays live between them.";
  let packet = Data(value: 4_i32);
  let holder = &packet;
  match deref(holder) {
    Data(value: payload) => {
      let saved = deref(payload);
    }
    Idle() => {
    }
  }
  match deref(holder) {
    Data(value: payload) => {
      let again = deref(payload);
    }
    Idle() => {
    }
  }
  return exit_status(code: 0_u8);
}
