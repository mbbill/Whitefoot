fn get(b: own buffer<u8>, i: own u64, pick: own Bool) -> own u8 traps {
  doc "The join keeps the weakest (largest-constant) bound held by all joined states [ENT-5]. One arm establishes `i - room <= -1` and the other only `i - room <= 0`, so the continuation carries the non-strict bound and the subscript after the match is undischarged [OP-4].";
  let room: own u64 = len<u8>(b);
  match pick {
    True() => {
      let inside: own Bool = ilt<u64>(i, room);
      check inside else trap "offset out of range";
    }
    False() => {
      let within: own Bool = ile<u64>(i, room);
      check within else trap "offset past the length";
    }
  }
  return b[i];
}

fn main() -> own unit pure {
  return unit;
}
