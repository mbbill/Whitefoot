fn get(b: own buffer<u8>, i: own u64, pick: own Bool) -> result: own u8 pure {
  doc "The join keeps the weakest (largest-constant) bound held by all joined states [ENT-5]. One arm establishes `i - room <= -1` and the other only `i - room <= 0`, so the continuation carries the non-strict bound and the subscript after the match is undischarged [OP-4].";
  let room = len(b);
  if pick {
    let inside = ilt(i, room);
    if inside {
    } else {
      return 0_u8;
    }
  } else {
    let within = ile(i, room);
    if within {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
