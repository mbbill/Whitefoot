fn clamp_three(value: own u64) -> return_value: own u64 pure {
  return imin(value, 3_u64);
}

fn recursive_read(bytes: own buffer<u8>, index: own u64, remaining: own u64) -> return_value: own u8 traps {
  let finished = ieq(remaining, 0_u64);
  if finished {
    let room = len(bytes);
    let inside = ilt(index, room);
    claim recursive_index_in_bytes: inside because "premises: the entry caller passes index returned by clamp_three, recursive calls preserve index unchanged, and bytes has length 4\nderivation: clamp_three returns at most 3_u64, so index is strictly less than room at the finished branch\nconclusion: ilt(index, room) is true\nchecker gap: ENT does not publish an uncontracted caller result bound through recursive calls\nconsumers: the following bytes[index] subscript requires this exact bound";
    return bytes[index];
  } else {
    let next = remaining -wrap 1_u64;
    let value = recursive_read(bytes: move bytes, index: index, remaining: next);
    return value;
  }
}

command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap), traps {
  doc "A recursive demand fixed point terminates and preserves the protected-leaf demand until the boundary-derived actual at the entry call is rejected under PRV-2.";
  region 'a {
    let raw_index = args_count<'a>(args: &'a args);
    let index = clamp_three(value: raw_index);
    let bytes = buffer_new(4_u64, 0_u8);
    let value = recursive_read(bytes: move bytes, index: index, remaining: 0_u64);
    return exit_status(code: 0_u8);
  }
}
