struct Row {
  left: u64;
  right: u64;
}

struct Table {
  rows: Array<Row, 1>;
}

fn main() -> status: own ExitStatus pure {
  doc "A field-index-field path distinguishes disjoint scalar siblings inside one element, so the write to the sibling leaves the reference to the first field valid.";
  let seed = Row(left: 3_u64, right: 4_u64);
  let rows = array_filled::<Row, 1>(value: seed);
  let table = Table(rows: move rows);
  let left = &table.rows[0_u64].left;
  set table.rows[0_u64].right = 9_u64;
  let observed = deref(left);
  return exit_status(code: 0_u8);
}
