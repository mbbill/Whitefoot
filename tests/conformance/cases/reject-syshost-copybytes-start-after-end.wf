command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args), allocates(heap) {
  doc "SYS-8 rejects start greater than end statically. The first range goal is refuted before lowering, so no host call, source read, destination write, or runtime fallback exists.";
  let bytes = buffer_new(4_u64, 0_u8);
  region 'a {
    match arg_get::<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_bytes::<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, start: 18446744073709551615_u64, end: 0_u64) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                return exit_status(code: 11_u8);
              }
            }
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 12_u8);
      }
    }
  }
}
