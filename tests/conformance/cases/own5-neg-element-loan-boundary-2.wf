struct Row {
  left: u64;
  right: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "Moving the owner is now an ordinary consuming use; it invalidates every reference formed from it, and the later use of that reference is the rejection.";
  let seed = Row(left: 3_u64, right: 4_u64);
  let rows = array_filled::<Row, 4>(value: seed);
  let saved = &rows[0_u64];
  let moved = move rows;
  let observed = saved.left;
  return exit_status(code: 0_u8);
}
