fn main() -> own unit traps {
  doc "Distinct value names and a break to a lexically enclosing loop [TYPE-6].";
  let i = 0_i32;
  let total = 0_i32;
  loop @l {
    if ige(i, 3_i32) {
      break @l;
    }
    set total = total + i;
    set i = i + 1_i32;
  }
  claim sum_drift: ieq(total, 3_i32) because "sum drift";
  return unit;
}
