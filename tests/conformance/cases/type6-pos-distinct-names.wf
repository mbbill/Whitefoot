command fn main() -> status: own ExitStatus traps {
  doc "Distinct value names and a break to a lexically enclosing loop [TYPE-6].";
  let i = 0_i32;
  let total = 0_i32;
  loop @l {
    if ige(i, 3_i32) {
      break @l;
    }
    claim total_step_defined: total +defined i because "premises: the loop reaches this site only for i from 0_i32 through 2_i32 and total is the accumulated prefix\nderivation: the largest reached total plus i is 1_i32 plus 2_i32, which is representable as i32\nconclusion: total +defined i is true\nchecker gap: ENT does not derive this coupled loop recurrence for total and i\nconsumers: the following exact addition needs the complete IntegerDomain obligation";
    set total = total + i;
    set i = i + 1_i32;
  }
  if ieq(total, 3_i32) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
