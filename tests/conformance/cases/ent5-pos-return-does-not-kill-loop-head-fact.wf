fn get(b: own Slice<u8>, stop: own Bool, done: own Bool) -> result: own u8 reads(b) {
  doc "An ordinary branch establishes the zero offset's bound before the loop. A return edge inside the loop cannot reach a later iteration front, so its scope-exit kills do not remove that real pre-loop fact [ENT-5, OP-4].";
  let spare = len_of(b);
  let offset = 0_u64;
  let inside = offset < spare;
  if inside {
    let sample = 0_u8;
    loop @walk {
      set sample = b[offset];
      if stop {
        return sample;
      }
      if done {
        break @walk;
      }
    }
    return sample;
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
