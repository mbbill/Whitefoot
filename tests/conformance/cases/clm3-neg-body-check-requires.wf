fn required(value: own u64, limit: own u64) -> result: own unit pure contract {
  define allowed = ilt(value, limit);
  requires allowed;
} {
  return unit;
}

deny_claims fn checked_forward(value: own u64, limit: own u64) -> result: own unit traps {
  let bounded = value % 4_u64;
  let allowed = ilt(bounded, 4_u64);
  claim caller_check: allowed because "premises: bounded is the remainder of the current function parameter value divided by 4_u64\nderivation: unsigned remainder by four is one of 0_u64 through 3_u64 and is therefore strictly less than 4_u64\nconclusion: ilt(bounded, 4_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following required call needs this exact bound";
  required(value: bounded, limit: 4_u64);
  return unit;
}

command fn main() -> status: own ExitStatus traps {
  checked_forward(value: 0_u64, limit: 1_u64);
  return exit_status(code: 0_u8);
}
