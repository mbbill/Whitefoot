fn bucket_of<const n_values: u64>(values: own Slots<u8, n_values>, n: own u64) -> found: own u8 pure contract {
  define spare = values.len;
  requires spare == 10_u64;
  requires n < 101_u64;
} {
  let idx = n / 10_u64;
  let byte = values[idx];
  return byte;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
