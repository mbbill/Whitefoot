fn wider['s: affine](left: &'s u64, right: &'s u64) -> larger: own u64 reads(left, right) {
  doc "PROV-6, S32: a region parameter written `'s: affine` is bounded rather than unconstrained, so the declaration obligation is checked once against the bound instead of fail-closed. Every store a region names in this version is reclaimed by its own region release, so this declaration is accepted and no region argument fails the bound.";
  let a = deref(left);
  let b = deref(right);
  let ordered = a >= b;
  if ordered {
    return a;
  } else {
    return b;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "The caller.";
  let a = 1_u64;
  let b = 2_u64;
  region {
    let top = wider(left: &a, right: &b);
  }
  return exit_status(code: 0_u8);
}
