struct Row {
  left: u64;
  right: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "Different literal indices provably select different storages, so two references into one array name disjoint elements and a write through one leaves the other valid.";
  let seed = Row(left: 3_u64, right: 4_u64);
  let rows = array_filled::<Row, 4>(value: seed);
  let left = &rows[0_u64];
  let right = &rows[1_u64];
  let value = left.left;
  set right.right = value;
  let observed = left.left;
  return exit_status(code: 0_u8);
}
