fn read_at_index(bytes: own buffer<u8>, index: own u64) -> result: own u8 reads(bytes) contract {
  define room = len(bytes);
  requires ilt(index, room);
} {
  return bytes[index];
}

command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args), allocates(heap) {
  region 'a {
    let index = args_count<'a>(args: &'a args);
    let bytes = buffer_new(4_u64, 0_u8);
    let value = read_at_index(bytes: move bytes, index: index);
    return exit_status(code: value);
  }
}
