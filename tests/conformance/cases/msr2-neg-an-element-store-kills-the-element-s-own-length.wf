command fn main() -> status: own ExitStatus pure {
  doc "MSR-2: a write at an element position of P overlaps the descriptor storage of P[i] and none of P's own. The replace at grid[0] therefore kills every measure of grid[0] and no measure of grid, which is exactly what the residual below names: the outer subscript is still discharged from len_of(grid), and the inner one has nothing left to stand on.";
  region 'a {
    let workspace = arena_frame::<8192, 16, 'a>();
    region {
      match arena_vector::<u8>(store: &uniq workspace, count: 32_u64) {
        None() => {
          return exit_status(code: 1_u8);
        }
        Some(value: inner) => {
          match arena_vector::<u8>(store: &uniq workspace, count: 32_u64) {
            None() => {
              return exit_status(code: 6_u8);
            }
            Some(value: fresh) => {
              let spare = room_of(inner);
              if spare == 0_u64 {
                return exit_status(code: 5_u8);
              }
              let filled = place_back(vector: move inner, value: 5_u8);
              let table = fixed_vector::<Vector<'a, u8>, 4>();
              let grid = place_back(vector: move table, value: move filled);
              let rows = len_of(grid);
              if rows == 1_u64 {
                let width = len_of(grid[0_u64]);
                if width == 1_u64 {
                  let old = replace grid[0_u64] = move fresh;
                  let cell = grid[0_u64][0_u64];
                  if cell == 5_u8 {
                    return exit_status(code: 0_u8);
                  }
                  return exit_status(code: 4_u8);
                }
                return exit_status(code: 2_u8);
              }
              return exit_status(code: 3_u8);
            }
          }
        }
      }
    }
  }
}
