fn h2(buf: &uniq MutSlice<u8>, i: own u64, w: own u8) -> result: own u8 reads(buf), writes(buf) {
  let limit = len_of(deref(buf));
  let in_range = i < limit;
  if in_range {
    let old = deref(buf)[i];
    let bounded = old <= 5_u8;
    if bounded {
      set deref(buf)[i] = w;
      let cur = deref(buf)[i];
      let z = cur + 250_u8;
      return z;
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
