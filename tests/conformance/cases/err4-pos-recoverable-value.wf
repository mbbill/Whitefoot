fn main() -> own unit traps {
  doc "Overflow via `.checked` is classified recoverable: delivered as a value (Err), not a trap [ERR-4].";
  let v = match 2147483647_i32 +checked 1_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      give 0_i32;
    }
  }
  check ieq(v, 0_i32) else trap "x";
  return unit;
}
