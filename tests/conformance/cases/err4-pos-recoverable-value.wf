command fn main() -> status: own ExitStatus pure {
  doc "Overflow via `.checked` is classified recoverable and delivered as a typed Err value [ERR-4].";
  let v = match 2147483647_i32 +checked 1_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      give 0_i32;
    }
  }
  if ieq(v, 0_i32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
