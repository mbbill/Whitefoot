enum Packet {
  Data(left: i32, right: u64, ready: Bool);
  Empty();
}

fn score(packet: own Packet) -> own i32 traps {
  match move packet {
    Data(left: left_value, right: right_value, ready: ready_value) => {
      claim left_payload_drift: ieq(left_value, 20_i32) because "left payload drift";
      claim right_payload_drift: ieq(right_value, 22_u64) because "right payload drift";
      claim bool_payload_drift: ready_value because "Bool payload drift";
      return left_value + 22_i32;
    }
    Empty() => {
      return 0_i32;
    }
  }
}

fn main() -> own unit traps {
  doc "Construct, pass, destructure, and validate every field of one mixed-width payload variant [GRAM-8, GRAM-10, OWN-13].";
  let ready = True();
  let packet = Data(left: 20_i32, right: 22_u64, ready: ready);
  let result = score(packet: move packet);
  claim multi_field_payload_drift: ieq(result, 42_i32) because "multi-field payload drift";
  return unit;
}
