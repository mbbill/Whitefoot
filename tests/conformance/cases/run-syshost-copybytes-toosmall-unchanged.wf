command fn main(command.args as args: own Args) -> own ExitStatus allocates(heap), traps {
  doc "SYS-8: on a recoverable failure of a copy operation the whole buffer is unchanged. CopyTooSmall states the exact length the destination range must have for the same call to succeed [SYS-6], and the sentinel prefill witnesses the no-write half, which stays observable because the program keeps running.";
  let bytes: own buffer<u8> = buffer_new<u8>(4_u64, 90_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_bytes<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, offset: 0_u64, capacity: 4_u64) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                match problem {
                  CopyTooSmall(required: needed) => {
                    let exact: own Bool = ieq<u64>(needed, 6_u64);
                    match exact {
                      True() => {
                      }
                      False() => {
                        return exit_status(code: 11_u8);
                      }
                    }
                  }
                }
              }
            }
          }
        }
        let offset: own u64 = 0_u64;
        loop @sentinel {
          let done: own Bool = ieq<u64>(offset, 4_u64);
          match done {
            True() => {
              break @sentinel;
            }
            False() => {
              let byte: own u8 = bytes[offset];
              let intact: own Bool = ieq<u8>(byte, 90_u8);
              match intact {
                True() => {
                }
                False() => {
                  return exit_status(code: 12_u8);
                }
              }
              set offset = iadd.wrap<u64>(offset, 1_u64);
            }
          }
        }
        return exit_status(code: 0_u8);
      }
      Err(error: absent) => {
        return exit_status(code: 13_u8);
      }
    }
  }
}
