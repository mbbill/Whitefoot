fn sentinel_status['b](bytes: &'b buffer<u8>, failure: own u8) -> result: own u8 reads('b), traps {
  let offset = 0_u64;
  let room = len(deref(bytes));
  loop @sentinel {
    let done = ieq(offset, room);
    if done {
      break @sentinel;
    } else {
      let scan_ok = ilt(offset, room);
      claim offset_in_bytes: scan_ok because "premises: offset starts at zero, room is the byte-buffer length, the loop exits when offset equals room, and every continuing iteration increments offset by one\nderivation: the recurrence enumerates exactly the offsets from zero through room minus one before the equality exit\nconclusion: scan_ok is true\nchecker gap: ENT does not derive this strict loop range from the equality exit and one-step recurrence\nconsumers: the following sentinel-buffer subscript needs this upper Range component";
      let byte = deref(bytes)[offset];
      let intact = ieq(byte, 90_u8);
      if intact {
      } else {
        return failure;
      }
      set offset = offset +wrap 1_u64;
    }
  }
  return 0_u8;
}

command fn main(command.args as args: own Args) -> status: own ExitStatus allocates(heap), traps {
  doc "SYS-8: on a recoverable failure of a copy operation the whole buffer is unchanged. CopyTooSmall states the exact length the destination range must have for the same call to succeed [SYS-6], and the sentinel prefill witnesses the no-write half, which stays observable because the program keeps running.";
  let bytes = buffer_new(4_u64, 90_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_bytes<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, start: 0_u64, end: 4_u64) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                match problem {
                  CopyTooSmall(required: needed) => {
                    let exact = ieq(needed, 6_u64);
                    if exact {
                    } else {
                      return exit_status(code: 11_u8);
                    }
                  }
                }
              }
            }
          }
        }
        region 's {
          let observed = sentinel_status<'s>(bytes: &'s bytes, failure: 12_u8);
          let intact = ieq(observed, 0_u8);
          if intact {
          } else {
            return exit_status(code: observed);
          }
        }
        return exit_status(code: 0_u8);
      }
      Err(error: absent) => {
        return exit_status(code: 13_u8);
      }
    }
  }
}
