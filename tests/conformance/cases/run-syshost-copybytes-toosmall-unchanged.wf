fn sentinel_status(bytes: &buffer<u8>, failure: own u8) -> result: own u8 reads(bytes) {
  let spare = len_of(deref(bytes));
  for (offset in 0_u64..spare) {
    let byte = deref(bytes)[offset];
    let intact = byte == 90_u8;
    if intact {
    } else {
      return failure;
    }
  }
  return 0_u8;
}

command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args), allocates(heap) {
  doc "SYS-8: on a recoverable failure of a copy operation the whole buffer is unchanged. CopyTooSmall states the exact length the destination range must have for the same call to succeed [SYS-6], and the sentinel prefill witnesses the no-write half, which stays observable because the program keeps running.";
  let bytes = buffer_new(4_u64, 90_u8);
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region {
            match host_copy_bytes(value: &'v text, destination: &uniq bytes, start: 0_u64, end: 4_u64) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                match problem {
                  CopyTooSmall(required: needed) => {
                    let exact = needed == 6_u64;
                    if exact {
                    } else {
                      return exit_status(code: 11_u8);
                    }
                  }
                }
              }
            }
          }
        }
        region {
          let observed = sentinel_status(bytes: &bytes, failure: 12_u8);
          let intact = observed == 0_u8;
          if intact {
          } else {
            return exit_status(code: observed);
          }
        }
        return exit_status(code: 0_u8);
      }
      Err(error: absent) => {
        return exit_status(code: 13_u8);
      }
    }
  }
}
