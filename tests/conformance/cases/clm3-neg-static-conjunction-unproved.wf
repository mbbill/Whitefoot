fn guarded(first: own Bool, second: own Bool) -> result: own unit pure contract {
  define together = band(first, second);
  requires together;
} {
  return unit;
}

deny_claims command fn main() -> status: own ExitStatus pure {
  let first = ilt(0_u64, 1_u64);
  let second = ilt(1_u64, 2_u64);
  guarded(first: first, second: second);
  return exit_status(code: 0_u8);
}
