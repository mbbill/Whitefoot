struct Chunk['s] {
  page: Vector<'s, u8>;
}

command fn main() -> status: own ExitStatus pure {
  doc "FORM-8: a construct writes a region argument only for a region parameter no field of the constructor it names determines. `Chunk`'s one field brands the store, so the operand fixes the instance and the construct writes nothing; the instance the field determined is the one the later read measures.";
  region 'a {
    let workspace = arena_frame::<4096, 16, 'a>();
    region {
      let page = arena_vector_proved::<u8>(store: &uniq workspace, count: 256_u64);
      let held = Chunk(page: move page);
      let width = room_of(held.page);
      if width == 256_u64 {
        return exit_status(code: 0_u8);
      }
    }
  }
  return exit_status(code: 1_u8);
}
