fn make(n: own u64) -> return_value: own buffer<i32> allocates(heap) contract {
  requires buffer_fits<i32>(n);
} {
  doc "buffer_new(n, v) allocates and fills a flat runtime-length buffer only after its buffer_fits<T>(n) obligation is proved [OP-9].";
  return buffer_new(n, 0_i32);
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
