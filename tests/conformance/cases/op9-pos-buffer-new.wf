fn make['s](store: &uniq Heap<'s>, n: own u64) -> made: own Option<Vector<'s, i32>> reads(store), writes(store), allocates(store) contract {
  requires n <= 1024_u64;
  requires buffer_fits::<i32>(n);
} {
  doc "heap_vector::<T>(store, count) takes a runtime-length run from the general store only after its source allocation bound and selected-target byte bound are both proved [OP-9, STOR-6].";
  region {
    return heap_vector::<i32>(store: &uniq deref(store), count: n);
  }
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
