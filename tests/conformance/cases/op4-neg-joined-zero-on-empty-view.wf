enum Pick {
  Zero();
  Wide();
}

fn get(b: own Slice<u8>, i: own u64, choice: own Pick) -> result: own u8 reads(b) {
  let spare = len_of(b);
  let cursor = i;
  match choice {
    Zero() => {
      set cursor = 0_u64;
    }
    Wide() => {
      let inside = i < spare;
      if inside {
      } else {
        return 0_u8;
      }
    }
  }
  return b[cursor];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
