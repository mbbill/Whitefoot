fn fill(grid: own MutSlice<u64>) -> result: own unit writes(grid) contract {
  requires len_of(grid) >= 12_u64;
} {
  for (row in 0_u64..3_u64) {
    for (col in 0_u64..4_u64) {
      let base = row * 4_u64;
      let flat = base + col;
      set grid[flat] = flat;
    }
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
