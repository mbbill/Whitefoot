struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn inspect(first: &Node, second: &Node) -> result: own u64 reads(first), writes(second) {
  let a = first;
  let b = first;
  let c = second;
  for (i in 0_u64..8_u64) {
    set a = b;
    set b = c;
    match deref(c).next {
      Some(value: child) => {
        set c = &deref(child).inner;
      }
      None() => {
      }
    }
  }
  set deref(second).next = None<Box<Node>>();
  return deref(a).value;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
