enum Sign {
  Neg();
  Zero();
  Pos();
}

fn twice(s: &Sign) -> return_value: own i32 reads(s) {
  doc "OWN-13: matching through a reference leaves the scrutinee live; s is matched again after the first match.";
  match s {
    Neg() => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  match s {
    Neg() => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  return 0_i32;
}

fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
