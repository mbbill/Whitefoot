enum Sign {
  Neg();
  Zero();
  Pos();
}

fn twice['r](s: &'r Sign) -> return_value: own i32 reads('r) {
  doc "OWN-13: matching through &'r leaves the scrutinee live; s is matched again after.";
  match deref(s) {
    Neg() => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  match deref(s) {
    Neg() => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  return 0_i32;
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
