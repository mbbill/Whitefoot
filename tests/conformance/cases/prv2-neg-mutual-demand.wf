fn mutual_left(bytes: own buffer<u8>, index: own u64, remaining: own u64) -> own u8 traps {
  let finished = ieq(remaining, 0_u64);
  if finished {
    let room = len(bytes);
    let inside = ilt(index, room);
    claim mutual_index_in_bytes: inside because "the seed in this strongly connected component is assertion-backed";
    return bytes[index];
  } else {
    let next = remaining -wrap 1_u64;
    let value = mutual_right(bytes: move bytes, index: index, remaining: next);
    return value;
  }
}

fn mutual_right(bytes: own buffer<u8>, index: own u64, remaining: own u64) -> own u8 traps {
  let value = mutual_left(bytes: move bytes, index: index, remaining: remaining);
  return value;
}

command fn main(command.args as args: own Args) -> own ExitStatus allocates(heap), traps {
  doc "A protected-leaf seed in one member of a mutually recursive component reaches the other member and rejects its external entry actual under PRV-2.";
  region 'a {
    let index = args_count<'a>(args: &'a args);
    let bytes = buffer_new(4_u64, 0_u8);
    let value = mutual_right(bytes: move bytes, index: index, remaining: 0_u64);
    return exit_status(code: 0_u8);
  }
}
