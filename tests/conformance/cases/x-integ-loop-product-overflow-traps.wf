fn main() -> own unit traps {
  doc "A running product overflows i32 mid-loop; the bare * turns the overflow into a deterministic trap rather than UB, and the seed is bound from a checked op via give [OP-1, GIVE-1, SCOPE-3].";
  let prod = match 1_i32 +checked 0_i32 {
    Ok(value: seed) => {
      give seed;
    }
    Err(error: e) => {
      return unit;
    }
  }
  let i = 2_i32;
  loop @l {
    if igt(i, 20_i32) {
      break @l;
    }
    set prod = prod * i;
    set i = i + 1_i32;
  }
  claim unreachable_product_overflowed_first: igt(prod, 0_i32) because "unreachable: product overflowed first";
  return unit;
}
