fn get(b: own buffer<u8>, i: own u64, pick: own Bool) -> result: own u8 traps {
  doc "The join keeps, for each ordered term pair, the weakest bound held by all joined states [ENT-5]. Both arms establish the same `i - room <= -1`, so the continuation keeps it and the subscript after the match discharges [OP-4].";
  let room = len(b);
  if pick {
    let inside = ilt(i, room);
    claim offset_out_of_range_on_the_taken_arm: inside because "offset out of range on the taken arm";
  } else {
    let inside = ilt(i, room);
    claim offset_out_of_range_on_the_other_arm: inside because "offset out of range on the other arm";
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
