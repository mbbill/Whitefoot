fn main() -> own unit traps {
  doc "A loop folds a running product with the bare * [OP-1]; the accumulator overflows i32 before the comparison-driven break bound is reached, so the trapping multiply aborts the process [SCOPE-4]. Both multiply operands are bound terms, so this is the retained two-non-constant trapping form OP-2's constant-operand class does not reach; the counter increment beside it is a class site the break branch discharges.";
  let i = 0_i32;
  let acc = 1_i32;
  let factor = 7_i32;
  loop @l {
    if ige(i, 20_i32) {
      break @l;
    }
    set acc = acc * factor;
    set i = i + 1_i32;
  }
  check igt(acc, 0_i32) else trap "unreachable after overflow";
  return unit;
}
