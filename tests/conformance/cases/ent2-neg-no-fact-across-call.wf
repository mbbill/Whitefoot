fn identity(n: own u64) -> own u64 pure {
  return n;
}

fn get(b: own buffer<u8>) -> own u8 traps {
  doc "No fact crosses a call boundary [ENT-2]. The checked comparison bounds `probe`, but the value returned by `identity` is a fresh term carrying no relation to it, so the subscript is undischarged [OP-4] and the residual names the returned binding.";
  let room = len(b);
  let probe = 0_u64;
  let inside = ilt(probe, room);
  claim the_buffer_is_empty: inside because "the buffer is empty";
  let echoed = identity(n: probe);
  return b[echoed];
}

fn main() -> own unit pure {
  return unit;
}
