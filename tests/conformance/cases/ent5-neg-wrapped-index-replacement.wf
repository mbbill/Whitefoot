fn scan_pair_bad(data: own Array<i16, 8>, start: own u64) -> result: own i16 pure contract {
  requires start < 8_u64;
} {
  doc "A valid initial array index is replaced by its total wrapping image. The old requirement does not constrain the replacement, so the second subscript is rejected [ENT-5, OP-4].";
  let first = data[start];
  let jumped = start +wrap 3_u64;
  set start = jumped;
  let second = data[start];
  return first +wrap second;
}

fn main() -> status: own ExitStatus pure {
  doc "No construction is needed to exercise the replacement kill.";
  return exit_status(code: 0_u8);
}
