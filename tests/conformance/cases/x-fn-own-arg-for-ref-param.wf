fn takesref(x: &i32) -> function_result: own i32 reads(x) {
  doc "Parameter x is a shared borrow &'r i32 [FN-1].";
  return deref(x);
}

command fn main() -> status: own ExitStatus pure {
  doc "Caller passes an own value where the signature declares a shared borrow [FN-1].";
  let a = 5_i32;
  region {
    let r = takesref(x: a);
  }
  return exit_status(code: 0_u8);
}
