fn main() -> status: own ExitStatus pure {
  doc "A subscript of a run is a swap place, which is what carries an affine element out of a slot and its successor in at one commit. At every program point the slot holds exactly one valid owner, so the window stays the run's complete typestate.";
  let run = slots_new::<Option<u8>, 4>();
  let a = Some<u8>(value: 1_u8);
  place_back(window: &run, value: move a);
  let b = Some<u8>(value: 2_u8);
  place_back(window: &run, value: move b);
  let fresh = Some<u8>(value: 9_u8);
  swap(first: &run[0_u64], second: &fresh);
  match fresh {
    Some(value: was) => {
      if was == 1_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    None() => {
      return exit_status(code: 2_u8);
    }
  }
  let again = Some<u8>(value: 8_u8);
  swap(first: &run[0_u64], second: &again);
  match again {
    Some(value: got) => {
      if got == 9_u8 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 3_u8);
    }
    None() => {
      return exit_status(code: 4_u8);
    }
  }
}
