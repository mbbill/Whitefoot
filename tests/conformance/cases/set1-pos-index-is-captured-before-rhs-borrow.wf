fn change(index: &uniq u64) -> result: own u64 writes(index) {
  set deref(index) = 1_u64;
  return 41_u64;
}

command fn main() -> status: own ExitStatus pure {
  let empty = fixed_vector::<u64, 2>();
  let prefix = place_back(vector: move empty, value: 3_u64);
  let rows = place_back(vector: move prefix, value: 5_u64);
  let index = 0_u64;
  invariant bounded: index < len_of(rows);
  region {
    set rows[index] = change(index: &uniq index);
  }
  if rows[0_u64] != 41_u64 {
    return exit_status(code: 1_u8);
  }
  if rows[1_u64] != 5_u64 {
    return exit_status(code: 2_u8);
  }
  if index != 1_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
