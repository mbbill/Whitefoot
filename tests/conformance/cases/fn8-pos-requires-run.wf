fn bounded(x: own i32) -> result: own i32 pure contract {
  define permitted = ige(x, 0_i32);
  requires permitted;
} {
  doc "A Bool-valued, pure-total static requirement is one complete goal that every ordinary caller proves before the function body [FN-8].";
  return x;
}

command fn main() -> status: own ExitStatus traps {
  let value = bounded(x: 7_i32);
  claim requires_result_drift: ieq(value, 7_i32) because "requires result drift";
  return exit_status(code: 0_u8);
}
