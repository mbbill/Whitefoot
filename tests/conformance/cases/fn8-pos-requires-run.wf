fn bounded(x: own i32) -> own i32 pure requires {
  let permitted = ige(x, 0_i32);
  check permitted else trap "x must be nonnegative";
} {
  doc "A checked, Bool-valued, pure-total requirement is one complete goal that every ordinary caller proves before the function body [FN-8].";
  return x;
}

fn main() -> own unit traps {
  let value = bounded(x: 7_i32);
  claim requires_result_drift: ieq(value, 7_i32) because "requires result drift";
  return unit;
}
