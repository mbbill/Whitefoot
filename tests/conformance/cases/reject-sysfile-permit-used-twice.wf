command fn main(command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  doc "FilePermit is an ordinary affine own value. The first open consumes it on every outcome, so the second move is use after move and rejects under OWN-1 without any I/O-specific identity rule.";
  region 'state {
    let permit = reserve_file::<'state>(factory: &uniq 'state files);
    let first = open_directory_source::<'state>(permit: move permit, directory: &'state cwd);
    let second = open_directory_source::<'state>(permit: move permit, directory: &'state cwd);
  }
  return exit_status(code: 0_u8);
}
