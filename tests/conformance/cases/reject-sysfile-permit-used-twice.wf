command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  doc "HandlePermit is an ordinary affine own value. The first open consumes it on every outcome, so the second move is use after move and rejects under OWN-1 without any I/O-specific identity rule.";
  region {
    match reserve_handle(factory: &uniq files) {
      Ok(value: permit) => {
        let first = open_directory_source(permit: move permit, directory: &cwd);
        let second = open_directory_source(permit: move permit, directory: &cwd);
      }
      Err(error: spent) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
