fn close_twice(factory: &uniq HandleFactory, file: own ReadFile) -> result: own unit reads(factory, file), writes(factory, file) {
  doc "HandlePermit is retired. The migrated witness duplicates consumption of an ordinary linear acquired owner and must still reject OWN-1; factory state is borrowed, not consumed or duplicated.";
  region {
    close_read(factory: &uniq deref(factory), file: move file);
    close_read(factory: &uniq deref(factory), file: move file);
  }
  return unit;
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: factory, stdin: input) = move inputs;
  region {
    close_directory(factory: &uniq factory, directory: move cwd);
  }
  return exit_status(code: 0_u8);
}
