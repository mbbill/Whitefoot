fn probe<const n: u64>(table: own FixedVector<u8, n>, idx: own u64, limit: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires idx < limit;
  requires limit <= spare;
} {
  let spare = len_of(table);
  invariant in_range: idx < spare;
  set idx = 255_u64;
  let byte = table[idx];
  return byte;
}

fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq table, value: 0_u8);
  }
  region {
    place_back(vector: &uniq table, value: 0_u8);
  }
  region {
    place_back(vector: &uniq table, value: 0_u8);
  }
  region {
    place_back(vector: &uniq table, value: 0_u8);
  }
  let found = probe::<4>(table: move table, idx: 1_u64, limit: 4_u64);
  return exit_status(code: found);
}
