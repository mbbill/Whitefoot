struct Mark['s] {
  value: u64;
}

fn carry['s](loan: &'s u64, marker: own Mark<'s>) -> result: own Mark<'s> pure {
  return move marker;
}

fn main() -> status: own ExitStatus pure {
  let number = 9_u64;
  region 'outer {
    region 'inner {
      let marker = Mark<'inner>(value: 7_u64);
      let result = carry(loan: &'outer number, marker: move marker);
    }
  }
  return exit_status(code: 0_u8);
}
