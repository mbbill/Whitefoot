enum ClauseEq {
  ClauseFirst();
  ClauseSecond();
  ClauseThird();
}

fn guarded(left: own ClauseEq, right: own ClauseEq) -> result: own unit pure contract {
  define same = eeq(left, right);
  requires same;
} {
  return unit;
}

command fn main() -> status: own ExitStatus traps {
  let left = ClauseSecond();
  let right = ClauseSecond();
  let same = eeq(left, right);
  claim guarded_equality: same because "the exact enum equality goal holds before the call";
  guarded(left: left, right: right);
  return exit_status(code: 0_u8);
}
