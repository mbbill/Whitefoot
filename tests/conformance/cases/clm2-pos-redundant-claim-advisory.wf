fn get(b: own buffer<i32>, i: own u64) -> result: own i32 traps {
  doc "A claim the closed fact state already derives is redundant [CLM-2]: the program remains accepted, the claim still executes, and a conforming implementation reports one non-rejecting advisory. The first claim's passed fact [ENT-3 S3] is what derives the second.";
  let room = len(b);
  let inside = ilt(i, room);
  claim offset_in_bounds: inside because "callers index below the buffer length";
  let again = ilt(i, room);
  claim offset_still_in_bounds: again because "restating a fact the state already carries";
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
