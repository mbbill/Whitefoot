fn open_two(first_permit: own HandlePermit, second_permit: own HandlePermit, directory: &DirectoryRead) -> result: own unit reads(first_permit, second_permit, directory), writes(first_permit, second_permit) {
  let first = open_directory_source(permit: move first_permit, directory: directory);
  let second = open_directory_source(permit: move second_permit, directory: directory);
  return unit;
}

command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  doc "Two short exclusive factory loans produce two independent ordinary permit owners. Once each inline reservation returns, both opens use only their moved permit and shared loans of one DirectoryRead, so no long factory or exclusive directory loan remains.";
  region {
    match reserve_handle(factory: &uniq files) {
      Ok(value: first_permit) => {
        match reserve_handle(factory: &uniq files) {
          Ok(value: second_permit) => {
            open_two(first_permit: move first_permit, second_permit: move second_permit, directory: &cwd);
          }
          Err(error: spent) => {
            return exit_status(code: 2_u8);
          }
        }
      }
      Err(error: spent) => {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
