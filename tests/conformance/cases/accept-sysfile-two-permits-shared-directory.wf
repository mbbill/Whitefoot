fn open_two(factory: &uniq HandleFactory, directory: &DirectoryRead) -> result: own unit reads(factory, directory), writes(factory) {
  doc "PRE-1 opens use two successive short exclusive loans of the same ordinary factory and shared loans of one directory; each resulting linear source is explicitly closed.";
  region {
    let first = open_directory_source(factory: &uniq deref(factory), directory: directory);
    let second = open_directory_source(factory: &uniq deref(factory), directory: directory);
    match first {
      SourceOpened(value: source) => {
        close_directory_source(factory: &uniq deref(factory), source: move source);
      }
      SourceOpenFailed(error: problem) => {
      }
    }
    match second {
      SourceOpened(value: source) => {
        close_directory_source(factory: &uniq deref(factory), source: move source);
      }
      SourceOpenFailed(error: problem) => {
      }
    }
  }
  return unit;
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: factory, stdin: input) = move inputs;
  region {
    open_two(factory: &uniq factory, directory: &cwd);
    close_directory(factory: &uniq factory, directory: move cwd);
  }
  return exit_status(code: 0_u8);
}
