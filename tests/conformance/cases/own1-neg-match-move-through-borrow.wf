enum Packet {
  Data(value: i32);
}

fn inspect(holder: &Packet) -> return_value: own unit pure {
  doc "OWN-1: move deref(holder) cannot steal a borrowed enum; bare match deref(holder) derives borrowed payload binders.";
  match move deref(holder) {
    Data(value: payload) => {
      let saved = deref(payload);
    }
  }
  return unit;
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
