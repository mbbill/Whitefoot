enum Packet {
  Data(value: i32);
}

fn inspect(holder: &Packet) -> return_value: own unit reads(holder) {
  doc "A move requires a place rooted in a live own-mode binding, so it cannot steal the referent a reference names; a bare match through the reference leaves the scrutinee live and binds the payload as a reference [OWN-13].";
  match move deref(holder) {
    Data(value: payload) => {
      let saved = payload;
    }
  }
  return unit;
}

fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
