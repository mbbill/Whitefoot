command fn main() -> status: own ExitStatus pure {
  doc "BLK-0, CALL-6: a row's published relations may narrow what its caller derives and may never make everything derivable. The take below writes the store, so the store's own pre-call measures die at the call boundary and what the caller holds afterwards is exactly what the row published; the run read is judged against its own length and is refused.";
  region 'a {
    let workspace = arena_frame::<8192, 16, 'a>();
    let empty = fixed_vector::<u8, 4>();
    let t1 = place_back(vector: move empty, value: 0_u8);
    let t2 = place_back(vector: move t1, value: 0_u8);
    let t3 = place_back(vector: move t2, value: 0_u8);
    let table = place_back(vector: move t3, value: 0_u8);
    region {
      let first = arena_vector_proved::<u8>(store: &uniq workspace, count: 8_u64);
      let seen = table[9_u64];
      if seen == 0_u8 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 2_u8);
    }
  }
}
