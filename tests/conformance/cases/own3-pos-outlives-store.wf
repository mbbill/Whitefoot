command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-3: an enclosing region outlives an inner one; a 'r borrow satisfies an 's destination.";
  let a = 7_i32;
  region 'r {
    region 's {
      let q = &'r a;
      if deref(q) == 7_i32 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
