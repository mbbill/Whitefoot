enum Packet {
  Data(value: i32);
}

fn main() -> status: own ExitStatus pure {
  let packet = Data(value: 4_i32);
  region {
    let holder = &uniq packet;
    match deref(holder) {
      Data(value: payload) => {
        let saved = deref(payload);
      }
    }
  }
  return exit_status(code: 0_u8);
}
