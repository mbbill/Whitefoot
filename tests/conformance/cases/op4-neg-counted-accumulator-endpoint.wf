fn select(data: own Slice<u8>) -> result: own u8 reads(data) {
  let count = 0_u64;
  let length = len_of(data);
  for (
    i in 0_u64..length,
    invariant bound: count <= i
  ) {
    let byte = data[i];
    if byte == 7_u8 {
      set count = count + 1_u64;
    }
  }
  return data[count];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
