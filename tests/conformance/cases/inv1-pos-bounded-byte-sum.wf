fn byte_sum(bytes: own Slice<u8>) -> result: own u32 reads(bytes) contract {
  requires len_of(bytes) <= 16_u64;
} {
  let count = len_of(bytes);
  let sum = 0_u32;
  for (
    i in 0_u64..count,
    invariant per_byte: sum <= 255_u32 * i
  ) {
    let sample = bytes[i];
    let wide = cvt::<u8, u32>(sample);
    set sum = sum + wide;
  }
  return sum;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
