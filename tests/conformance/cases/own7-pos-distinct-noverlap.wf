fn main() -> own unit traps {
  doc "OWN-7: borrows of distinct roots do not overlap; two uniq borrows coexist.";
  let a = 1_i32;
  let b = 2_i32;
  region 'r {
    let ua = &uniq 'r a;
    let ub = &uniq 'r b;
    set deref(ua) = 5_i32;
    set deref(ub) = 6_i32;
  }
  claim a: ieq(a, 5_i32) because "a";
  claim b: ieq(b, 6_i32) because "b";
  return unit;
}
