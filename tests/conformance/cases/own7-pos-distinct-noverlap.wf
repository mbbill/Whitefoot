command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-7: borrows of distinct roots do not overlap; two uniq borrows coexist.";
  let a = 1_i32;
  let b = 2_i32;
  region 'r {
    let ua = &uniq 'r a;
    let ub = &uniq 'r b;
    set deref(ua) = 5_i32;
    set deref(ub) = 6_i32;
  }
  if ieq(a, 5_i32) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(b, 6_i32) {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
