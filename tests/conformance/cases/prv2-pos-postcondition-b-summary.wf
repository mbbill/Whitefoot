fn bounded(value: own u64) -> own u64 pure ensures result {
  check ilt(result, 4_u64) else trap "bounded postcondition";
} {
  let masked = iand(value, 3_u64);
  return masked;
}

fn protected_read(values: own array<u8, 4>, index: own u64) -> own u8 pure requires {
  let room = len(values);
  check ilt(index, room) else trap "index bound";
} {
  return values[index];
}

command fn main(command.args as args: own Args) -> own ExitStatus pure {
  let values = array_new<u8, 4>(0_u8);
  region 'a {
    let source_count = args_count<'a>(args: &'a args);
    let index = bounded(value: source_count);
    let selected = protected_read(values: move values, index: index);
  }
  return exit_status(code: 0_u8);
}
