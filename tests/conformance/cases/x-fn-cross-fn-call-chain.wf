fn dbl(x: own i32) -> function_result: own i32 pure {
  doc "Leaf of the chain: doubles its argument with the total wrapping family [FN-1, OP-1].";
  return x +wrap x;
}

fn quad(x: own i32) -> function_result: own i32 pure {
  doc "Middle of the chain: calls dbl twice through a temporary [FN-1].";
  let d = dbl(x: x);
  return dbl(x: d);
}

command fn main() -> status: own ExitStatus pure {
  doc "Three-deep call chain; each caller relies only on the callee signature [FN-1].";
  let q = quad(x: 5_i32);
  if q == 20_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
