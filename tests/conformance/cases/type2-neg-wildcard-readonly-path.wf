struct Node {
  value: u64;
  readonly next: Option<Box<Node>>;
}

fn inspect(root: &Node) -> result: u64 writes(root) {
  let cursor = root;
  for (i in 0_u64..2_u64) {
    match deref(cursor).next {
      Some(value: child) => {
        set cursor = &deref(child).inner;
      }
      None() => {
        break;
      }
    }
  }
  set deref(cursor).value = 3_u64;
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "Widening retains readonly restrictions of every possible formation path.";
  return exit_status(code: 0_u8);
}
