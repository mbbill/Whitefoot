fn room(values: own Slots<u64, 16>, extra: own u64, limit: own u64) -> result: own u64 pure contract {
  requires values.len <= 16_u64;
  requires extra <= 16_u64;
  requires values.len + extra <= limit;
} {
  doc "Replacing the whole measured binding kills the current length image [ENT-5]. The requirement named the body-entry image, so a fresh length read cannot inherit the former length-plus-extra bound and the subtraction's domain is unproved [OP-2].";
  let replacement = slots_new::<u64, 16>();
  set values = move replacement;
  let current = values.len;
  let total = current + extra;
  let remaining = limit - total;
  return remaining;
}

fn main() -> status: own ExitStatus pure {
  doc "No construction is needed to exercise the replacement kill.";
  return exit_status(code: 0_u8);
}
