struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn inspect(root: own Node) -> result: own u64 pure {
  doc "Moving an ultimate owner invalidates descendant cursors instead of rerooting them.";
  let cursor = &root;
  for (i in 0_u64..2_u64) {
    match deref(cursor).next {
      Some(value: child) => {
        set cursor = &deref(child).inner;
      }
      None() => {
        break;
      }
    }
  }
  let transferred = move root;
  return deref(cursor).value;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
