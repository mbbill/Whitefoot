fn mix(word: own u32) -> return_value: own u32 pure {
  doc "OP-8: a checksum-style scalar mix uses the general bitwise, rotate, and wrapping paths.";
  let rotated = irotl(word, 5_u32);
  let mixed = ixor(rotated, word);
  let biased = mixed +wrap 2654435769_u32;
  return biased;
}

command fn main() -> return_value: own ExitStatus traps {
  doc "OP-8: the extended integer family supports binary-data kernels through the normal compiler path.";
  let mixed = mix(word: 305419896_u32);
  let bits = ipopcount(mixed);
  let bounded = imin(bits, 32_u32);
  claim integer_family_drift: ile(bounded, 32_u32) because "integer family drift";
  return exit_status(code: 0_u8);
}
