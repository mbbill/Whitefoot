command fn main() -> status: own ExitStatus pure {
  doc "Forming a shared Slice over a place a live MutSlice views is that view's shared child reborrow of a unique loan, which OWN-6 already admits for places. The child carries the parent's range, the parent may not write the elements it views while the child lives, and the parent resumes where the child's own liveness ends. The program forms the child, reads through it, then writes through the parent after the child's last use and reads that write back through the parent.";
  let table = buffer_new(3_u64, 7_u8);
  region {
    let writer = mut_slice_of(&uniq table);
    let reader = slice_of(&table);
    let seen = reader[0_u64];
    if seen == 7_u8 {
    } else {
      return exit_status(code: 21_u8);
    }
    set writer[0_u64] = 9_u8;
    let written = writer[0_u64];
    if written == 9_u8 {
    } else {
      return exit_status(code: 22_u8);
    }
  }
  return exit_status(code: 0_u8);
}
