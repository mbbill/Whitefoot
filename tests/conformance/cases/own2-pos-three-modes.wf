command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-2: the three modes own / shared / uniq borrow are always written.";
  let a = 5_i32;
  region {
    let s = &a;
    if deref(s) == 5_i32 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  region {
    let u = &uniq a;
    set deref(u) = 9_i32;
  }
  if a == 9_i32 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
