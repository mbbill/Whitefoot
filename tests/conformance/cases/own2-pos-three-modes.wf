fn main() -> own unit traps {
  doc "OWN-2: the three modes own / shared / uniq borrow are always written.";
  let a = 5_i32;
  region 'r {
    let s = &'r a;
    check ieq(deref(s), 5_i32) else trap "read";
  }
  region 'q {
    let u = &uniq 'q a;
    set deref(u) = 9_i32;
  }
  check ieq(a, 9_i32) else trap "write";
  return unit;
}
