command fn main() -> return_value: own ExitStatus traps {
  doc "OWN-2: the three modes own / shared / uniq borrow are always written.";
  let a = 5_i32;
  region 'r {
    let s = &'r a;
    claim read: ieq(deref(s), 5_i32) because "read";
  }
  region 'q {
    let u = &uniq 'q a;
    set deref(u) = 9_i32;
  }
  claim write: ieq(a, 9_i32) because "write";
  return exit_status(code: 0_u8);
}
