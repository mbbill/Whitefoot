fn first(start: own u64, end: own u64) -> result: own u64 pure contract {
  requires start <= end;
  requires end <= 8_u64;
} {
  let values = buffer_new(8_u64, 0_u64);
  for (i in 0_u64..8_u64) {
    set values[i] = i;
  }
  region {
    let view = slice_of(&values, start, end);
    set start = end;
    let count = len_of(view);
    let empty = slice_of(&view, count, count);
    let empty_count = len_of(empty);
    if empty_count != 0_u64 {
      return 99_u64;
    }
    if count == 0_u64 {
      return 0_u64;
    }
    return view[0_u64];
  }
}

command fn main() -> status: own ExitStatus pure {
  let middle = first(start: 2_u64, end: 5_u64);
  let tail = first(start: 8_u64, end: 8_u64);
  if middle != 2_u64 {
    return exit_status(code: 1_u8);
  }
  if tail != 0_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
