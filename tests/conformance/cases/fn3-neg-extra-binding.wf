contract Single {
  fn value() -> result: own i32 pure;
}

conform i32: Single {
  value = make_value;
  extra = make_extra;
}

fn make_value() -> result: own i32 pure {
  return 1_i32;
}

fn make_extra() -> result: own i32 pure {
  return 2_i32;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
