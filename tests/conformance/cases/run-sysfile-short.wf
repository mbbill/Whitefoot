command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead) -> own ExitStatus allocates(heap), external, blocks, traps {
  doc "SYS-8: a short success is not end of input. A file shorter than the requested range yields ReadBytes(n) with n below the capacity, and only the next call, which observes no available byte, states ReadEnd. Exactly the first n bytes of the range may have changed and the rest of the buffer is unchanged.";
  let page: own buffer<u8> = buffer_new<u8>(8_u64, 90_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region 'c {
              region 'p {
                match open_read<'c, 'p>(root: &'c cwd, path: &'p path) {
                  Ok(value: file) => {
                    region 'f {
                      region 'd {
                        match read_once<'f, 'd>(file: &uniq 'f file, destination: &uniq 'd page, offset: 0_u64, capacity: 8_u64) {
                          ReadBytes(count: n) => {
                            let short: own Bool = ieq<u64>(n, 3_u64);
                            match short {
                              True() => {
                              }
                              False() => {
                                return exit_status(code: 10_u8);
                              }
                            }
                          }
                          ReadEnd() => {
                            return exit_status(code: 11_u8);
                          }
                          ReadFailed(error: problem) => {
                            return exit_status(code: 12_u8);
                          }
                        }
                      }
                    }
                    let beyond: own u8 = page[3_u64];
                    let intact: own Bool = ieq<u8>(beyond, 90_u8);
                    match intact {
                      True() => {
                      }
                      False() => {
                        return exit_status(code: 13_u8);
                      }
                    }
                    region 'g {
                      region 'e {
                        match read_once<'g, 'e>(file: &uniq 'g file, destination: &uniq 'e page, offset: 0_u64, capacity: 8_u64) {
                          ReadBytes(count: more) => {
                            return exit_status(code: 14_u8);
                          }
                          ReadEnd() => {
                            return exit_status(code: 0_u8);
                          }
                          ReadFailed(error: problem) => {
                            return exit_status(code: 15_u8);
                          }
                        }
                      }
                    }
                  }
                  Err(error: problem) => {
                    return exit_status(code: 16_u8);
                  }
                }
              }
            }
          }
          Err(error: rejected) => {
            return exit_status(code: 17_u8);
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 18_u8);
      }
    }
  }
}
