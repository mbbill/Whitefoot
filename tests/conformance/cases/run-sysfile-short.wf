command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, files), writes(cwd, files) {
  doc "SYS-8: a short success is not end of input. A file shorter than the requested range yields ReadBytes(next) with start < next < end, and only the next call, which observes no available byte, states ReadEnd. Exactly [start, next) may have changed and the rest of the buffer is unchanged.";
  let page = buffer_new(8_u64, 90_u8);
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region 'c {
              region {
                let permit = reserve_file(factory: &uniq 'c files);
                match open_read(permit: move permit, root: &'c cwd, path: &path) {
                  Ok(value: file) => {
                    region 'f {
                      region {
                        match read_at(file: &'f file, destination: &uniq page, file_offset: 0_u64, start: 0_u64, end: 8_u64) {
                          ReadBytes(next: n) => {
                            let short = n == 3_u64;
                            if short {
                            } else {
                              return exit_status(code: 10_u8);
                            }
                          }
                          ReadEnd() => {
                            return exit_status(code: 11_u8);
                          }
                          ReadFailed(error: problem) => {
                            return exit_status(code: 12_u8);
                          }
                        }
                      }
                    }
                    let beyond = page[3_u64];
                    let intact = beyond == 90_u8;
                    if intact {
                    } else {
                      return exit_status(code: 13_u8);
                    }
                    region 'g {
                      region {
                        match read_at(file: &'g file, destination: &uniq page, file_offset: 3_u64, start: 0_u64, end: 8_u64) {
                          ReadBytes(next: more) => {
                            return exit_status(code: 14_u8);
                          }
                          ReadEnd() => {
                            return exit_status(code: 0_u8);
                          }
                          ReadFailed(error: problem) => {
                            return exit_status(code: 15_u8);
                          }
                        }
                      }
                    }
                  }
                  Err(error: problem) => {
                    return exit_status(code: 16_u8);
                  }
                }
              }
            }
          }
          Err(error: rejected) => {
            return exit_status(code: 17_u8);
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 18_u8);
      }
    }
  }
}
