fn main() -> status: ExitStatus pure {
  doc "Exact domain boundaries are observed without host rounding: inexact large integers, float integer endpoints, fractional and nonfinite inputs, cross-format NaN canonicalization and signed zero.";
  if cvt.defined::<u32, f32>(16777217_u32) {
    return exit_status(code: 1_u8);
  }
  match cvt.checked::<u32, f32>(16777217_u32) {
    Ok(value: value) => {
      return exit_status(code: 2_u8);
    }
    Err(error: error) => {
    }
  }
  if cvt.defined::<u64, f64>(18446744073709551615_u64) {
    return exit_status(code: 3_u8);
  }
  if cvt.defined::<i64, f64>(9223372036854775807_i64) {
    return exit_status(code: 4_u8);
  }
  if cvt.defined::<f64, i64>(9223372036854775808.0_f64) {
    return exit_status(code: 5_u8);
  }
  match cvt.checked::<f64, i64>(9223372036854775808.0_f64) {
    Ok(value: value) => {
      return exit_status(code: 6_u8);
    }
    Err(error: error) => {
    }
  }
  let predecessor = cvt::<f64, i64>(9223372036854774784.0_f64);
  let minimum = cvt::<f64, i64>(-9223372036854775808.0_f64);
  if predecessor != 9223372036854774784_i64 {
    return exit_status(code: 7_u8);
  }
  if minimum != -9223372036854775808_i64 {
    return exit_status(code: 8_u8);
  }
  if cvt.defined::<f64, u8>(1.5_f64) {
    return exit_status(code: 9_u8);
  }
  let infinity = finf::<f64>();
  if cvt.defined::<f64, u64>(infinity) {
    return exit_status(code: 10_u8);
  }
  let nan = reinterpret::<u64, f64>(0xfff8123456789abc_u64);
  if cvt.defined::<f64, i64>(nan) {
    return exit_status(code: 11_u8);
  }
  if cvt.defined::<f64, f32>(nan) {
    let narrowed_nan = cvt::<f64, f32>(nan);
    let narrowed_bits = reinterpret::<f32, u32>(narrowed_nan);
    let canonical_nan = fnan::<f32>();
    let canonical_bits = reinterpret::<f32, u32>(canonical_nan);
    if narrowed_bits != canonical_bits {
      return exit_status(code: 12_u8);
    }
  } else {
    return exit_status(code: 13_u8);
  }
  let negative_zero = reinterpret::<u32, f32>(0x80000000_u32);
  let wide_zero = cvt::<f32, f64>(negative_zero);
  let wide_zero_bits = reinterpret::<f64, u64>(wide_zero);
  if wide_zero_bits != 0x8000000000000000_u64 {
    return exit_status(code: 14_u8);
  }
  if cvt.defined::<f32, i32>(negative_zero) {
    let integer_zero = cvt::<f32, i32>(negative_zero);
    if integer_zero != 0_i32 {
      return exit_status(code: 15_u8);
    }
  } else {
    return exit_status(code: 16_u8);
  }
  let positive_zero = cvt::<i32, f32>(0_i32);
  let positive_zero_bits = reinterpret::<f32, u32>(positive_zero);
  if positive_zero_bits != 0_u32 {
    return exit_status(code: 17_u8);
  }
  return exit_status(code: 0_u8);
}
