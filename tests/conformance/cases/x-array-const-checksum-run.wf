const input: array<u64, 8> =[3_u64, 5_u64, 8_u64, 13_u64, 21_u64, 34_u64, 55_u64, 89_u64];

fn checksum() -> function_result: own u64 pure {
  let total = 0_u64;
  for cursor in 0_u64..8_u64 {
    let value = input[cursor];
    set total = total +wrap value;
  }
  return total;
}

command fn main() -> status: own ExitStatus pure {
  doc "A static fixed array feeds a counted-loop checksum whose range facts discharge indexing.";
  let result = checksum();
  if ieq(result, 228_u64) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
