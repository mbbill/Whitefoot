const input: array<u64, 8> =[3_u64, 5_u64, 8_u64, 13_u64, 21_u64, 34_u64, 55_u64, 89_u64];

fn checksum() -> function_result: own u64 traps {
  let cursor = 0_u64;
  let total = 0_u64;
  loop @scan {
    if ieq(cursor, 8_u64) {
      break @scan;
    }
    let in_range = ilt(cursor, 8_u64);
    claim cursor_in_range: in_range because "the scan walks 0..8 and breaks at eight";
    let value = input[cursor];
    set total = total +wrap value;
    set cursor = cursor +wrap 1_u64;
  }
  return total;
}

command fn main() -> status: own ExitStatus traps {
  doc "A static fixed array feeds a loop-carried checksum; the loop claim discharges its indexing.";
  let result = checksum();
  claim array_checksum_drift: ieq(result, 228_u64) because "array checksum drift";
  return exit_status(code: 0_u8);
}
