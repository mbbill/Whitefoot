contract CheckedMember {
  fn apply(x: own i32) -> result: own i32 pure;
}

fn checked_apply(x: own i32) -> result: own i32 pure contract {
  define valid = ige(x, 0_i32);
  requires valid;
} {
  return x;
}

conform i32: CheckedMember {
  apply = checked_apply;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
