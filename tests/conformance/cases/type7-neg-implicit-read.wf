fn takes(value: own i32) -> function_result: own unit pure {
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "A reference is read bare [TYPE-7]: it is a name for a path [REF-1], so writing it where a value of the referent type is declared reads that path. The same spelling was the v0.59 implicit-read rejection; v0.60 admits it, deref being the Box-content step alone.";
  let a = 1_i32;
  let p = &a;
  takes(value: p);
  return exit_status(code: 0_u8);
}
