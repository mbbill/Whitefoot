fn fill_and_publish['r](destination: &uniq MutSlice<'r, u8>, value: own u8) -> filled: own Slice<'r, u8> writes(destination) contract {
  requires 2_u64 <= len_of(deref(destination));
} {
  doc "Fills the destination it was handed and publishes the shared child of that view.";
  set deref(destination)[0_u64] = value;
  set deref(destination)[1_u64] = value;
  return slice_of(&'r deref(destination));
}

command fn main() -> status: own ExitStatus pure {
  doc "[VIEW-6] the fill-and-publish helper. `slice_of(&'r deref(destination))` over a `&uniq MutSlice<'r, u8>` parameter is [OWN-6]'s shared child reborrow with a view as the parent: the child carries the parent's origin set and range under the narrower loan, so the parameter's formal-view origin is inside the result ceiling and the child is the helper's own result. The caller reads back through the published child what the helper wrote through its destination.";
  region 'a {
    let workspace = arena_frame::<4, 1, 'a>();
    region {
      let table = arena_vector_proved::<u8>(store: &uniq workspace, count: 4_u64);
      set table = place_back(vector: move table, value: 3_u8);
      set table = place_back(vector: move table, value: 3_u8);
      region {
        let window = mut_slice_of(&uniq table);
        region {
          let published = fill_and_publish(destination: &uniq window, value: 200_u8);
          let seen = len_of(published);
          if seen == 2_u64 {
          } else {
            return exit_status(code: 201_u8);
          }
          let first = published[0_u64];
          if first == 200_u8 {
          } else {
            return exit_status(code: 202_u8);
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
