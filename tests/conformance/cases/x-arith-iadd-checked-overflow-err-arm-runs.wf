fn main() -> own unit traps {
  doc "+checked returns Result<T, Overflow> [OP-1]; i32::MAX + 1 yields Err, so the Err arm runs and the Ok arm's guard would trap if overflow went undetected [OP-5].";
  let hi = 2147483647_i32;
  match hi +checked 1_i32 {
    Ok(value: v) => {
      claim overflow_was_not_detected: ilt(v, 0_i32) because "overflow was not detected";
      return unit;
    }
    Err(error: e) => {
      return unit;
    }
  }
}
