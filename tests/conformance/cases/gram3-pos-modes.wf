fn use3(a: own i32, b: &i32, part: &[i32]) -> return_value: own i32 reads(b), reads(part) contract {
  requires 0_u64 < part.len;
} {
  doc "GRAM-3: the two modes `own` and `&` written on i32 parameters, beside the parameter-only range-reference kind `&[i32]` [GRAM-2, REF-4]. There is no third mode and no qualifier on the reference; write authority is the row's [EFF-1].";
  let first = part[0_u64];
  let x = a +wrap b;
  return x +wrap first;
}

fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
