fn dbl(x: own i32) -> result: own i32 pure {
  doc "A genuinely `pure` body: total `.wrap` addition and no reads, writes, or allocation [EFF-3].";
  let r = x +wrap x;
  return r;
}

command fn main() -> status: own ExitStatus pure {
  let a = dbl(x: 21_i32);
  if ieq(a, 42_i32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
