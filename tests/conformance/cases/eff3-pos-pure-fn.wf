fn dbl(x: own i32) -> result: own i32 pure {
  doc "A genuinely `pure` body: `.wrap` add, no traps/reads/writes/allocates [EFF-3].";
  let r = x +wrap x;
  return r;
}

command fn main() -> status: own ExitStatus traps {
  let a = dbl(x: 21_i32);
  claim x: ieq(a, 42_i32) because "x";
  return exit_status(code: 0_u8);
}
