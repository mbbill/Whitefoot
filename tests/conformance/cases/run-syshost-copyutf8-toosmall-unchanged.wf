fn sentinel_status(bytes: &buffer<u8>, failure: own u8) -> result: own u8 reads(bytes) {
  let spare = len_of(deref(bytes));
  for (offset in 0_u64..spare) {
    let byte = deref(bytes)[offset];
    let intact = byte == 90_u8;
    if intact {
    } else {
      return failure;
    }
  }
  return 0_u8;
}

command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args) {
  doc "SYS-8: the other refusal of the text route. Valid text too long for the destination range reports the exact encoded length through Utf8CopyTooSmall and writes nothing, so the sentinel survives; the two refusals are kept as separate cases because one is a validation failure and the other a capacity failure [SYS-6].";
  let bytes = buffer_new(4_u64, 90_u8);
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region {
            match host_copy_utf8(value: &'v text, destination: &uniq bytes, start: 0_u64, end: 4_u64) {
              Ok(value: encoded) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                match problem {
                  Utf8CopyTooSmall(required: needed) => {
                    let exact = needed == 6_u64;
                    if exact {
                    } else {
                      return exit_status(code: 11_u8);
                    }
                  }
                  Utf8CopyInvalid() => {
                    return exit_status(code: 12_u8);
                  }
                }
              }
            }
          }
        }
        region {
          let observed = sentinel_status(bytes: &bytes, failure: 13_u8);
          let intact = observed == 0_u8;
          if intact {
          } else {
            return exit_status(code: observed);
          }
        }
        return exit_status(code: 0_u8);
      }
      Err(error: absent) => {
        return exit_status(code: 14_u8);
      }
    }
  }
}
