command fn main(command.args as args: own Args) -> status: own ExitStatus allocates(heap), traps {
  doc "SYS-8: the other refusal of the text route. Valid text too long for the destination range reports the exact encoded length through Utf8CopyTooSmall and writes nothing, so the sentinel survives; the two refusals are kept as separate cases because one is a validation failure and the other a capacity failure [SYS-6].";
  let bytes = buffer_new(4_u64, 90_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_utf8<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, start: 0_u64, end: 4_u64) {
              Ok(value: encoded) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                match problem {
                  Utf8CopyTooSmall(required: needed) => {
                    let exact = ieq(needed, 6_u64);
                    if exact {
                    } else {
                      return exit_status(code: 11_u8);
                    }
                  }
                  Utf8CopyInvalid() => {
                    return exit_status(code: 12_u8);
                  }
                }
              }
            }
          }
        }
        let offset = 0_u64;
        loop @sentinel {
          let done = ieq(offset, 4_u64);
          if done {
            break @sentinel;
          } else {
            let room = len(bytes);
            let scan_ok = ilt(offset, room);
            claim offset_in_bytes: scan_ok because "premises: the sentinel loop starts at zero, advances by one, and exits when offset reaches the four-byte buffer length\nderivation: every body reach therefore has offset strictly below the four-byte buffer length recorded by scan_ok\nconclusion: scan_ok is true\nchecker gap: ENT does not derive the strict loop range from the equality exit and recurrence\nconsumers: the following sentinel-buffer subscript needs this upper Range component";
            let byte = bytes[offset];
            let intact = ieq(byte, 90_u8);
            if intact {
            } else {
              return exit_status(code: 13_u8);
            }
            set offset = offset +wrap 1_u64;
          }
        }
        return exit_status(code: 0_u8);
      }
      Err(error: absent) => {
        return exit_status(code: 14_u8);
      }
    }
  }
}
