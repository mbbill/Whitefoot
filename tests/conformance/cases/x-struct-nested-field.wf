struct Inner {
  v: i32;
}

struct Outer {
  inner: Inner;
  k: i32;
}

command fn main() -> status: own ExitStatus traps {
  doc "TYPE-2: a nested struct field (a struct-typed field); read the inner field through the outer.";
  let inner_atom_0001 = Inner(v: 10_i32);
  let o = Outer(inner: move inner_atom_0001, k: 5_i32);
  claim nested_sum_defined: o.inner.v +defined o.k because "the constructed field values are small";
  let s = o.inner.v + o.k;
  claim nested_field_drift: ieq(s, 15_i32) because "nested field drift";
  return exit_status(code: 0_u8);
}
