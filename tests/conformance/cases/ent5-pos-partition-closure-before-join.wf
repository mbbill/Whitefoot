fn get(b: own Slice<u8>, i: own u64, half: own u64) -> result: own u8 reads(b) {
  let spare = len_of(b);
  let half_ok = half <= spare;
  if half_ok {
  } else {
    return 0_u8;
  }
  let lower = i < half;
  if lower {
  } else {
    let upper_start = i >= half;
    if upper_start {
      let upper_end = i < spare;
      if upper_end {
      } else {
        return 0_u8;
      }
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
