command fn main() -> status: own ExitStatus pure {
  doc "BLK-1: after a front removal and two back placements the window wraps, head is nonzero, and a subscript is still a logical offset whose obligation is against len.";
  let empty = fixed_vector::<u8, 3>();
  region {
    place_back(vector: &uniq empty, value: 10_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 20_u8);
  }
  let two = move one;
  region {
    place_back(vector: &uniq two, value: 30_u8);
  }
  let three = move two;
  region {
    let dropped = take_front(vector: &uniq three);
    let rest = move three;
    if dropped == 10_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
    region {
      place_back(vector: &uniq rest, value: 40_u8);
    }
    let wrapped = move rest;
    let at_zero = wrapped[0_u64];
    if at_zero == 20_u8 {
    } else {
      return exit_status(code: 2_u8);
    }
    let at_two = wrapped[2_u64];
    if at_two == 40_u8 {
    } else {
      return exit_status(code: 3_u8);
    }
    return exit_status(code: 0_u8);
  }
}
