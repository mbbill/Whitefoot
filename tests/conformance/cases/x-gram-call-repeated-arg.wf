fn add2(x: own i32, y: own i32) -> function_result: own i32 pure {
  return x +wrap y;
}

command fn main() -> status: own ExitStatus pure {
  doc "GRAM-11: a call to add2 repeating parameter x (x, x) is rejected - the second slot must be y; a repeat is never a reordering license.";
  let r = add2(x: 1_i32, x: 2_i32);
  return exit_status(code: 0_u8);
}
