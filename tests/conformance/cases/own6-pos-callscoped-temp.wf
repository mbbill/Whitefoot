fn bump(n: &uniq i32) -> return_value: own unit pure {
  return unit;
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-6: an unbound borrow is a call-scoped temporary, dead at statement end.";
  let a = 5_i32;
  region {
    bump(n: &uniq a);
    bump(n: &uniq a);
  }
  return exit_status(code: 0_u8);
}
