fn cross_index<const n_small: u64, const n_big: u64>(small: own Slots<u8, n_small>, big: own Slots<u8, n_big>, n: own u64) -> found: own u8 pure contract {
  define big_room = big.len;
  requires big_room > 0_u64;
} {
  let modulus = big.len;
  let bounded = n % modulus;
  let byte = small[bounded];
  return byte;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
