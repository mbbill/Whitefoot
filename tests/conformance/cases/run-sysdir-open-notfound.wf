fn exercise(args: &Args, cwd: &DirectoryRead, files: &uniq HandleFactory) -> status: own ExitStatus reads(args, cwd, files), writes(files) {
  doc "The ordinary open_read implementation returns NotFound for a name absent from the supplied DirectoryRead selector. IoError class matching is ordinary exhaustive enum control flow; failed allocation leaves the factory available.";
  region {
    match arg_get(args: args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region {
              region {
                match open_read(factory: &uniq deref(files), root: cwd, path: &path) {
                  FileOpened(value: file) => {
                    close_read(factory: &uniq deref(files), file: move file);
                    return exit_status(code: 10_u8);
                  }
                  FileOpenFailed(error: problem) => {
                    match problem {
                      NotFound(code: c, origin: o) => {
                        return exit_status(code: 0_u8);
                      }
                      PermissionDenied(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      AlreadyExists(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      NotDirectory(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      IsDirectory(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      DirectoryNotEmpty(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      ReadOnly(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      ResourceBusy(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      InvalidInput(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      InvalidPath(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      Unsupported(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      TimedOut(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      BrokenPipe(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      WriteZero(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      UnexpectedEnd(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      ConnectionRefused(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      ConnectionReset(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      ConnectionAborted(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      NotConnected(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      AddressInUse(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      AddressUnavailable(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      ResourceExhausted(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      FileTooLarge(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      NoSpace(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      QuotaExceeded(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      CrossDevice(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      DeviceFailure(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                      Other(code: c, origin: o) => {
                        return exit_status(code: 11_u8);
                      }
                    }
                  }
                }
              }
            }
          }
          Err(error: rejected) => {
            return exit_status(code: 12_u8);
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 13_u8);
      }
    }
  }
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, files: &uniq files);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
