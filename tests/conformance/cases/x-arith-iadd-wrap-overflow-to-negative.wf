command fn main() -> status: own ExitStatus traps {
  doc "+wrap wraps two's-complement on overflow [OP-1]; i32::MAX + 1 wraps to a negative value, confirmed on the dominated path by a claim that holds [CLM-1].";
  let hi = 2147483647_i32;
  let w = hi +wrap 1_i32;
  claim wrap_did_not_overflow_to_negative: ilt(w, 0_i32) because "wrap did not overflow to negative";
  return exit_status(code: 0_u8);
}
