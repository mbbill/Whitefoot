fn main() -> own unit traps {
  doc "+wrap wraps two's-complement on overflow [OP-1]; i32::MAX + 1 wraps to a negative value, confirmed on the dominated path by a passed check [OP-5].";
  let hi = 2147483647_i32;
  let w = hi +wrap 1_i32;
  check ilt(w, 0_i32) else trap "wrap did not overflow to negative";
  return unit;
}
