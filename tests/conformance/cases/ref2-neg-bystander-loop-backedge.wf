struct BystanderRecord {
  value: u8;
}

fn overwrite_bystander(values: &Array<BystanderRecord, 4>, index: own u64) -> result: own unit writes(values[index]) contract {
  requires index < 4_u64;
} {
  set deref(values)[index] = BystanderRecord(value: 9_u8);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}

fn inspect_loop(values: &Array<BystanderRecord, 4>, i: own u64, j: own u64) -> result: own unit reads(values), writes(values[j]) contract {
  requires i < 4_u64;
  requires j < 4_u64;
} {
  let selected = &deref(values)[i].value;
  let alias = selected;
  for (round in 0_u64..2_u64) {
    let observed = deref(alias);
    overwrite_bystander(values: values, index: j);
  }
  return unit;
}
