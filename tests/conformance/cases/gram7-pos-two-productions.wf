enum Sign {
  Neg();
  Zero();
  Pos();
}

fn classify(x: own i32) -> return_value: own Sign pure {
  return Pos();
}

command fn main() -> return_value: own ExitStatus traps {
  doc "GRAM-7: match as a let-initializer (value, give) AND as a statement (effect); one arm shape, two distinct node kinds.";
  let v = 21_i32;
  let d = if igt(v, 0_i32) {
    give 42_i32;
  } else {
    give 0_i32;
  }
  let s = classify(x: d);
  match s {
    Neg() => {
      return exit_status(code: 0_u8);
    }
    Zero() => {
      return exit_status(code: 0_u8);
    }
    Pos() => {
      claim drift: ieq(d, 42_i32) because "drift";
    }
  }
  return exit_status(code: 0_u8);
}
