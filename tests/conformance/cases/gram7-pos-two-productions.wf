enum Sign {
  Neg();
  Zero();
  Pos();
}

fn classify(x: own i32) -> own Sign pure {
  return Pos();
}

fn main() -> own unit traps {
  doc "GRAM-7: match as a let-initializer (value, give) AND as a statement (effect); one arm shape, two distinct node kinds.";
  let v = 21_i32;
  let d = if igt(v, 0_i32) {
    give 42_i32;
  } else {
    give 0_i32;
  }
  let s = classify(x: d);
  match s {
    Neg() => {
      return unit;
    }
    Zero() => {
      return unit;
    }
    Pos() => {
      check ieq(d, 42_i32) else trap "drift";
    }
  }
  return unit;
}
