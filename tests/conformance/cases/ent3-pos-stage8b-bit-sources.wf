const earlier_one: u32 = 1_u32;

fn require_bound(value: own u32, operand: own u32) -> own unit pure requires {
  check ile(value, operand) else trap "bit-and bound";
} {
  return unit;
}

fn require_nonzero(value: own u32) -> own unit pure requires {
  check ine(value, 0_u32) else trap "shift nonzero";
} {
  return unit;
}

fn sources(left: own u32, right: own u32, count: own u32) -> own unit pure {
  let masked = iand(left, right);
  require_bound(value: masked, operand: left);
  require_bound(value: masked, operand: right);
  let shifted_literal = ishl.wrap(1_u32, count);
  require_nonzero(value: shifted_literal);
  let shifted_named = ishl.wrap(earlier_one, count);
  require_nonzero(value: shifted_named);
  return unit;
}

fn main() -> own unit pure {
  sources(left: 7_u32, right: 3_u32, count: 2_u32);
  return unit;
}
