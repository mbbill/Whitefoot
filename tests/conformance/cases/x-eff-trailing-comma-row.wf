fn f ['heap](heap: &uniq Heap<'heap>, x: own i32) -> function_result: own i32 allocates(heap), {
  doc "A trailing comma after allocates(heap) is rejected because EFF-1 permits commas only between effects.";
  return x;
}

fn main ['heap](heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "Driver.";
  region {
    let a: own i32 = f(heap: &uniq heap, x: 7_i32);
  }
  return exit_status(code: 0_u8);
}
