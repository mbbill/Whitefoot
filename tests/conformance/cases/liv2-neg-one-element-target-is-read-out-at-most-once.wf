command fn main() -> status: own ExitStatus pure {
  doc "LIV-2: one target is read out at most once, because after its read-out the target is dead for the remainder of the evaluation. The second `move grid[1_u64]` is therefore an ordinary use of what the first read-out consumed, and an ordinary affine subscript read is TYPE-2's rejection.";
  region 'a {
    let workspace = arena_frame::<65536, 16, 'a>();
    region {
      let empty = fixed_vector::<Vector<'a, u8>, 2>();
      let small = arena_vector_proved::<u8>(store: &uniq workspace, count: 256_u64);
      let one = place_back(vector: move empty, value: move small);
      let large = arena_vector_proved::<u8>(store: &uniq workspace, count: 512_u64);
      let grid = place_back(vector: move one, value: move large);
      set (grid[0_u64], grid[1_u64]) = move grid[1_u64], move grid[1_u64];
      let held = len_of(grid);
      if held == 2_u64 {
        return exit_status(code: 0_u8);
      }
    }
  }
  return exit_status(code: 1_u8);
}
