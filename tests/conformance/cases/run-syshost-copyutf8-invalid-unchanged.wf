command fn main(command.args as args: own Args) -> status: own ExitStatus allocates(heap), traps {
  doc "SYS-8: host_copy_utf8 validates and measures the encoding first and returns Utf8CopyInvalid without writing any byte. The destination is large enough, so only the validation can have refused the transfer, and the sentinel prefill witnesses that no partial encoding was written [HOST-2].";
  let bytes = buffer_new(8_u64, 90_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_utf8<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, start: 0_u64, end: 8_u64) {
              Ok(value: encoded) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                match problem {
                  Utf8CopyTooSmall(required: needed) => {
                    return exit_status(code: 11_u8);
                  }
                  Utf8CopyInvalid() => {
                  }
                }
              }
            }
          }
        }
        let offset = 0_u64;
        loop @sentinel {
          let done = ieq(offset, 8_u64);
          if done {
            break @sentinel;
          } else {
            let room = len(bytes);
            let scan_ok = ilt(offset, room);
            claim offset_in_bytes: scan_ok because "premises: the sentinel loop starts at zero, advances by one, and exits when offset reaches the eight-byte buffer length\nderivation: every body reach therefore has offset strictly below the eight-byte buffer length recorded by scan_ok\nconclusion: scan_ok is true\nchecker gap: ENT does not derive the strict loop range from the equality exit and recurrence\nconsumers: the following sentinel-buffer subscript needs this upper Range component";
            let byte = bytes[offset];
            let intact = ieq(byte, 90_u8);
            if intact {
            } else {
              return exit_status(code: 12_u8);
            }
            set offset = offset +wrap 1_u64;
          }
        }
        return exit_status(code: 0_u8);
      }
      Err(error: absent) => {
        return exit_status(code: 13_u8);
      }
    }
  }
}
