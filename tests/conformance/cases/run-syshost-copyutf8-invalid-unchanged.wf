fn sentinel_status(bytes: &MutSlice<u8>, failure: own u8) -> result: own u8 reads(bytes) {
  let spare = len_of(deref(bytes));
  for (offset in 0_u64..spare) {
    let byte = deref(bytes)[offset];
    let intact = byte == 90_u8;
    if intact {
    } else {
      return failure;
    }
  }
  return 0_u8;
}

command fn main(command.args as args: own Args, command.heap as heap: own Heap) -> status: own ExitStatus reads(args, heap), writes(heap), allocates(heap) {
  doc "SYS-8: host_copy_utf8 validates and measures the encoding first and returns Utf8CopyInvalid without writing any byte. The destination is large enough, so only the validation can have refused the transfer, and the sentinel prefill witnesses that no partial encoding was written [HOST-2].";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 8_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let bytes = move fresh;
        for @scratch (
          at in 0_u64..8_u64,
          invariant grown: len_of(bytes) >= at,
          invariant spare: room_of(bytes) + at >= 8_u64,
          invariant flat: head_of(bytes) <= 0_u64
        ) {
          set bytes = place_back(vector: move bytes, value: 90_u8);
        }
        region {
          let window = mut_slice_of(&uniq bytes);
          region {
            match arg_get(args: &args, position: 1_u64) {
              Ok(value: text) => {
                region 'v {
                  region {
                    match host_copy_utf8(value: &'v text, destination: &uniq window, start: 0_u64, end: 8_u64) {
                      Ok(value: encoded) => {
                        return exit_status(code: 10_u8);
                      }
                      Err(error: problem) => {
                        match problem {
                          Utf8CopyTooSmall(required: needed) => {
                            return exit_status(code: 11_u8);
                          }
                          Utf8CopyInvalid() => {
                          }
                        }
                      }
                    }
                  }
                }
                region {
                  let observed = sentinel_status(bytes: &window, failure: 12_u8);
                  let intact = observed == 0_u8;
                  if intact {
                  } else {
                    return exit_status(code: observed);
                  }
                }
                return exit_status(code: 0_u8);
              }
              Err(error: absent) => {
                return exit_status(code: 13_u8);
              }
            }
          }
        }
      }
    }
  }
}
