struct Chunk<T: linear> {
  page: Box<Slots<T>>;
}

fn chunk_room<T: linear>(held: own Chunk<T>) -> (rest: own Chunk<T>, width: own u64) pure {
  doc "Reads one chunk's own capacity and hands the chunk back.";
  let spare = deref(held.page).room;
  return move held, spare;
}

fn main() -> status: own ExitStatus pure {
  doc "A nominal's type argument is a component of its type name, so an instance is fixed by that argument and a value of it is built by the ordinary construction. The helper is generic over the element type on the terms every other type is: its parameter type names the argument, and the written instantiation determines it at the call.";
  let page = box_slots_new::<u8>(capacity: 256_u64);
  let held = Chunk<u8>(page: move page);
  let (rest, width) = chunk_room::<u8>(held: move held);
  if width == 256_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
