contract PureMember {
  fn apply(x: own i32) -> result: own i32 pure;
}

fn trapping_apply(x: own i32) -> result: own i32 traps {
  claim retained_explicit_claim: ieq(x, x) because "retained explicit claim";
  return x;
}

conform i32: PureMember {
  apply = trapping_apply;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
