contract PureMember {
  fn apply(x: own i32) -> result: own i32 pure;
}

fn allocating_apply(x: own i32) -> result: own i32 pure {
  let scratch = buffer_new(1_u64, 0_u8);
  return x;
}

conform i32: PureMember {
  apply = allocating_apply;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
