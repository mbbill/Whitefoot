contract PureMember {
  fn apply(x: own i32) -> own i32 pure;
}

fn trapping_apply(x: own i32) -> own i32 traps {
  claim retained_explicit_check: ieq(x, x) because "retained explicit check";
  return x;
}

conform i32: PureMember {
  apply = trapping_apply;
}

fn main() -> own unit pure {
  return unit;
}
