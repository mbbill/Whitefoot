command fn main() -> status: own ExitStatus allocates(heap) {
  doc "[INV-1] the one call an affine factor admits is a measure former over an admitted measure place. Any other call in that position is refused at the call node, carrying the four formers as what the position admits, so widening the production admits one closed set of factors rather than every runtime expression.";
  let run = buffer_new(8_u64, 0_u8);
  let seen = 0_u64;
  let limit = 4_u64;
  for (
    at in 0_u64..4_u64,
    invariant bounded: seen <= imin(limit, limit)
  ) {
    let byte = run[at];
  }
  return exit_status(code: 0_u8);
}
