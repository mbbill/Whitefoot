fn probe(room: own u64, i: own u64) -> result: own unit traps {
  doc "A non-contradictory fact state that derives a claim predicate's exact negation rejects the program citing CLM-2, carrying the claim name, the predicate, and the derived negation: a claim proven to trap on every execution reaching it is a compile-time defect.";
  let beyond = ige(i, room);
  if beyond {
  } else {
    return unit;
  }
  let inside = ilt(i, room);
  claim offset_below_room: inside because "premises: the only path reaching this statement passed the preceding i-at-or-past-room branch\nderivation: i greater than or equal to room is the exact negation of i strictly below room\nconclusion: inside is false on every path reaching this statement\nchecker gap: none; ordinary entailment derives the exact negative predicate and CLM-2 must reject it\nconsumers: no terminal consumer is reachable because this negative fixture tests refuted-claim rejection";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
