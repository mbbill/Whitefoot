fn main() -> status: own ExitStatus pure {
  doc "WIN-1: an Array has no window; every slot always holds a value and a.len == a.cap.";
  let a = array_filled::<u64, 5>(value: 2_u64);
  let n = a.len;
  let c = a.cap;
  if n == c {
  } else {
    return exit_status(code: 1_u8);
  }
  if c == 5_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
