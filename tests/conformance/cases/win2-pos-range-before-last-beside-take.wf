alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn count_then_take(window: &Slots<u64, 8>, lo: u64, hi: u64) -> result: u64 reads(window[lo..hi]), writes(window.last), writes(window.len) contract {
  requires lo <= hi;
  requires hi <= deref(window).len;
  requires 0_u64 < deref(window).len;
} {
  doc "Returns the length of the run window[lo..hi] plus the last element, which it takes out of the window.";
  let run = &deref(window)[lo..hi];
  let count = deref(run).len;
  let last = take_back(window: window);
  let total = count +wrap last;
  return total;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-5, WIN-2: a run of a window that ends below window.len never overlaps window.last. The call passes hi 1 and its entry state proves window.len equal to 2, so reads(window[0_u64..1_u64]) is separate from writes(window.last); the program observes the run length plus the taken element.";
  let window = slots_new::<u64, 8>();
  place_back(window: &window, value: 1_u64);
  place_back(window: &window, value: 2_u64);
  let total = count_then_take(window: &window, lo: 0_u64, hi: 1_u64);
  if total == 3_u64 {
    if window.len == 1_u64 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
