fn consume_images(quotient: own u64, doubled: own u64, count: own u64) -> result: own unit pure contract {
  requires ile(quotient, count);
  requires ile(doubled, count);
} {
  return unit;
}

fn doubled_floor(count: own u64) -> result: own u64 pure contract {
  ensures ile(result, count);
} {
  let quotient = count / 2_u64;
  let doubled = quotient * 2_u64;
  let consumed = consume_images(quotient: quotient, doubled: doubled, count: count);
  return doubled;
}

command fn main() -> status: own ExitStatus pure {
  let result = doubled_floor(count: 9_u64);
  if ieq(result, 8_u64) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
