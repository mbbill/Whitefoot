fn main() -> own unit traps {
  doc "GRAM-6: v0.25 has fixed infix operators, Bool if, and one counted for form, but no general precedence, while form, or iterator protocol.";
  let n = 4_i32;
  let acc = 0_i32;
  loop @l {
    if ieq(n, 0_i32) {
      break @l;
    }
    set acc = acc +wrap n;
    set n = n -wrap 1_i32;
  }
  claim sum_drift: ieq(acc, 10_i32) because "sum drift";
  return unit;
}
