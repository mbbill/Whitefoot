fn main() -> own unit traps {
  doc "GRAM-6: no operators/if/while/for - arithmetic is named ops, conditional is match, iteration is loop+break.";
  let n = 4_i32;
  let acc = 0_i32;
  loop @l {
    if n == 0_i32 {
      break @l;
    }
    set acc = acc +wrap n;
    set n = n -wrap 1_i32;
  }
  check acc == 10_i32 else trap "sum drift";
  return unit;
}
