fn divide(n: own u64, d: own u64) -> own u64 traps {
  doc "The claim backstop for a divisor-class site [OP-2, ENT-6]: a dominating `claim` of the residual discharges the obligation exactly as a branch does, but the claim itself is the retained runtime check and the `traps` contributor [CLM-1, EFF-2], so the row is `traps` rather than `pure`.";
  claim nonzero: ine(d, 0_u64) because "the caller passes a nonzero divisor";
  let q = n / d;
  return q;
}

fn main() -> own unit traps {
  let v = divide(n: 84_u64, d: 2_u64);
  claim quotient: ieq(v, 42_u64) because "84 divided by 2 is 42";
  return unit;
}
