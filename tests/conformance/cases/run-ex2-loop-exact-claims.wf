command fn main() -> status: own ExitStatus traps {
  doc "Loop, break, mutable locals, and claim-discharged exact arithmetic: sum 0..4 == 10.";
  let i = 0_i32;
  let sum = 0_i32;
  loop @l {
    if ige(i, 5_i32) {
      break @l;
    }
    claim sum_step_defined: sum +defined i because "premises: the loop reaches this site only for i from 0_i32 through 4_i32 and sum is the accumulated prefix from those values\nderivation: the largest reached sum plus i is 6_i32 plus 4_i32, which is representable as i32\nconclusion: sum +defined i is true\nchecker gap: ENT does not derive this coupled loop recurrence for sum and i\nconsumers: the following exact addition needs the complete IntegerDomain obligation";
    set sum = sum + i;
    set i = i + 1_i32;
  }
  if ieq(sum, 10_i32) {
  } else {
    return exit_status(code: 201_u8);
  }
  let doubled = match sum *checked 2_i32 {
    Ok(value: d) => {
      give d;
    }
    Err(error: e) => {
      return exit_status(code: 0_u8);
    }
  }
  if ieq(doubled, 20_i32) {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
