command fn main(command.stdin as input: own InputStream) -> status: own ExitStatus reads(input), writes(input), allocates(heap) {
  doc "SYS-8: an empty range makes no host transfer and is never reported as the end. `read_next` on `[start, start)` answers `ReadBytes(start)` and advances no position, so the following nonempty read still observes the stream's first byte.";
  let chunk = buffer_new(4_u64, 0_u8);
  let outcome = 0_u8;
  region {
    match read_next(input: &uniq input, destination: &uniq chunk, start: 2_u64, end: 2_u64) {
      ReadBytes(next: endpoint) => {
        let unmoved = endpoint == 2_u64;
        if unmoved {
        } else {
          set outcome = 6_u8;
        }
      }
      ReadEnd() => {
        set outcome = 7_u8;
      }
      ReadFailed(error: problem) => {
        set outcome = 8_u8;
      }
    }
  }
  if outcome == 0_u8 {
    region {
      match read_next(input: &uniq input, destination: &uniq chunk, start: 0_u64, end: 4_u64) {
        ReadBytes(next: endpoint) => {
          let first = chunk[0_u64];
          let expected = first == 65_u8;
          if expected {
          } else {
            set outcome = 9_u8;
          }
        }
        ReadEnd() => {
          set outcome = 10_u8;
        }
        ReadFailed(error: problem) => {
          set outcome = 11_u8;
        }
      }
    }
  }
  return exit_status(code: outcome);
}
