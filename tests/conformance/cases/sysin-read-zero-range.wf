command fn main(command.stdin as input: own InputStream, command.heap as heap: own Heap) -> status: own ExitStatus reads(input, heap), writes(input, heap), allocates(heap) {
  doc "SYS-8: an empty range makes no host transfer and is never reported as the end. `read_next` on `[start, start)` answers `ReadBytes(start)` and advances no position, so the following nonempty read still observes the stream's first byte.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let chunk = move fresh;
        for @scratch (
          at in 0_u64..4_u64,
          invariant grown: len_of(chunk) >= at,
          invariant spare: room_of(chunk) + at >= 4_u64,
          invariant flat: head_of(chunk) <= 0_u64
        ) {
          set chunk = place_back(vector: move chunk, value: 0_u8);
        }
        let outcome = 0_u8;
        region {
          let window = mut_slice_of(&uniq chunk);
          region {
            match read_next(input: &uniq input, destination: &uniq window, start: 2_u64, end: 2_u64) {
              ReadBytes(next: endpoint) => {
                let unmoved = endpoint == 2_u64;
                if unmoved {
                } else {
                  set outcome = 6_u8;
                }
              }
              ReadEnd() => {
                set outcome = 7_u8;
              }
              ReadFailed(error: problem) => {
                set outcome = 8_u8;
              }
            }
          }
        }
        if outcome == 0_u8 {
          region {
            let window = mut_slice_of(&uniq chunk);
            region {
              match read_next(input: &uniq input, destination: &uniq window, start: 0_u64, end: 4_u64) {
                ReadBytes(next: endpoint) => {
                }
                ReadEnd() => {
                  set outcome = 10_u8;
                }
                ReadFailed(error: problem) => {
                  set outcome = 11_u8;
                }
              }
            }
          }
        }
        if outcome == 0_u8 {
          let first = chunk[0_u64];
          let expected = first == 65_u8;
          if expected {
          } else {
            set outcome = 9_u8;
          }
        }
        return exit_status(code: outcome);
      }
    }
  }
}
