fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "The ordinary read_next implementation returns Ok(start) without transfer for an empty range. The following nonempty read still observes the first arranged byte.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: input) = move inputs;
  region {
    close_directory(factory: &uniq entry_factory, directory: move unused_cwd);
  }
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let chunk = move fresh;
        for @scratch (
          at in 0_u64..4_u64,
          invariant grown: len_of(chunk) >= at,
          invariant spare: room_of(chunk) + at >= 4_u64,
          invariant flat: head_of(chunk) <= 0_u64
        ) {
          place_back(vector: &uniq chunk, value: 0_u8);
        }
        let outcome = 0_u8;
        region {
          let window = mut_slice_of(&uniq chunk);
          region {
            match read_next(factory: &uniq entry_factory, input: &uniq input, destination: &uniq window, start: 2_u64, end: 2_u64) {
              Ok(value: endpoint) => {
                let unmoved = endpoint == 2_u64;
                if unmoved {
                } else {
                  set outcome = 6_u8;
                }
              }
              Err(error: read_stop_24) => {
                match read_stop_24 {
                  ReadEnd() => {
                    set outcome = 7_u8;
                  }
                  ReadFailed(error: problem) => {
                    set outcome = 8_u8;
                  }
                }
              }
            }
          }
        }
        if outcome == 0_u8 {
          region {
            let window = mut_slice_of(&uniq chunk);
            region {
              match read_next(factory: &uniq entry_factory, input: &uniq input, destination: &uniq window, start: 0_u64, end: 4_u64) {
                Ok(value: endpoint) => {
                }
                Err(error: read_stop_25) => {
                  match read_stop_25 {
                    ReadEnd() => {
                      set outcome = 10_u8;
                    }
                    ReadFailed(error: problem) => {
                      set outcome = 11_u8;
                    }
                  }
                }
              }
            }
          }
        }
        if outcome == 0_u8 {
          let first = chunk[0_u64];
          let expected = first == 65_u8;
          if expected {
          } else {
            set outcome = 9_u8;
          }
        }
        return exit_status(code: outcome);
      }
    }
  }
}
