fn f (x: own i32) -> function_result: own i32 writes {
  doc "writes effect with no region list [EFF-1].";
  return x;
}

command fn main () -> status: own ExitStatus traps {
  doc "Driver.";
  let a: own i32 = f(x: 7_i32);
  claim x: ieq<i32>(a, 7_i32) because "x";
  return exit_status(code: 0_u8);
}
