fn drain['s](store: &uniq Heap<'s>, cell: own Vector<'s, u8>) -> code: own u8 writes(cell, store) {
  doc "PROV-6: the statement exhibits one write of `p`'s ultimate storage origin beside the store it returns the run to, so a release a writer chooses appears in the row. The same function without the statement releases the same run at its scope exit and names only the store, which is what the early release makes visible.";
  dispose cell;
  return 4_u8;
}

fn keep['s](store: &uniq Heap<'s>, cell: own Vector<'s, u8>) -> code: own u8 writes(store) {
  doc "The control: the compiler-derived release at this scope's exit names the store the run goes back to and nothing of the run's own storage [STOR-3], so the operand does not appear in the row and the reclamation point is invisible in the signature.";
  return 5_u8;
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "The caller runs both and reports the sum of what they returned.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: first) => {
        match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
          None() => {
            return exit_status(code: 70_u8);
          }
          Some(value: second) => {
            let early = drain(store: &uniq heap, cell: move first);
            let late = keep(store: &uniq heap, cell: move second);
            let total = early +wrap late;
            return exit_status(code: total);
          }
        }
      }
    }
  }
}
