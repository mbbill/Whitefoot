fn drain(cell: own buffer<u8>) -> code: own u8 writes(cell) {
  doc "PROV-6: the statement exhibits one write of `p`'s ultimate storage origin, so a release a writer chooses appears in the row. The same function without the statement declares `pure` and releases the same run at its scope exit under no effect at all, which is what the early release makes visible.";
  dispose cell;
  return 4_u8;
}

fn keep(cell: own buffer<u8>) -> code: own u8 pure {
  doc "The control: the compiler-derived release at this scope's exit carries the empty row [STOR-3], so this declaration is `pure` and the reclamation is invisible in the signature.";
  return 5_u8;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "The caller runs both and reports the sum of what they returned.";
  let first = buffer_new(4_u64, 0_u8);
  let second = buffer_new(4_u64, 0_u8);
  let early = drain(cell: move first);
  let late = keep(cell: move second);
  let total = early +wrap late;
  return exit_status(code: total);
}
