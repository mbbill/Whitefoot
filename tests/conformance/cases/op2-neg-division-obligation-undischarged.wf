fn divide(n: own u64, d: own u64) -> return_value: own u64 pure {
  doc "The same unsigned divisor-class site with nothing proving the divisor nonzero. The complete fact state does not discharge the obligation, so OP-2 rejects at the `infix` node carrying the residual [ENT-6]; no runtime trap is substituted for the missing proof.";
  let q = n / d;
  return q;
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
