fn inner(p: own i64, k: own i64, j: own i64, n: own i64) -> at: own i64 pure contract {
  requires n <= 1000_i64;
  requires k <= 1000_i64;
  requires p < k;
  requires j < n;
} {
  doc "A signed multiplicity could scale a premise by a negative number, which reverses it.";
  let span = n * k;
  let base = n * p;
  let at = base + j;
  invariant fits: base + j < span {
    use n times (p < k);
    use (j < n);
  }
  return at;
}

command fn main() -> status: own ExitStatus pure {
  let at = inner(p: 1_i64, k: 2_i64, j: 3_i64, n: 4_i64);
  return exit_status(code: 0_u8);
}
