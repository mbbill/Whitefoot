fn hidden_true() -> result: own Bool pure {
  return True();
}

fn read(values: own array<u8, 4>, unused: own u64) -> result: own u8 traps {
  let cursor = 3_u64;
  let condition = hidden_true();
  if condition {
    set cursor = 0_u64;
  } else {
    let untouched = 0_u8;
  }
  claim reviewed_written: ilt(cursor, 4_u64) because "premises: cursor is either the literal 3_u64 this function wrote before the branch or the literal 0_u64 the selected arm wrote\nderivation: both literals are below 4_u64, so cursor is below 4_u64 whichever definition reached this point\nconclusion: ilt(cursor, 4_u64) is true\nchecker gap: the two incoming reaching definitions differ, so the call result chose which one arrives and CLM-1 must refuse the claim\nconsumers: the following values[cursor] subscript would otherwise consume this assertion";
  return values[cursor];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
