fn divide(n: own u64, d: own u64) -> result: own u64 pure {
  doc "The exact division domain is discharged statically [EFF-2, OP-2, ENT-6], so the operation has no runtime fallback and exhibits no `traps`; `pure` is the exact row.";
  if igt(d, 0_u64) {
    let q = n / d;
    return q;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  let v = divide(n: 84_u64, d: 2_u64);
  if ieq(v, 42_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
