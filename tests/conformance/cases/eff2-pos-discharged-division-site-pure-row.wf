fn divide(n: own u64, d: own u64) -> own u64 pure {
  doc "The newly accepted class [EFF-2, OP-2, ENT-6]: a discharged divisor-class site exhibits no `traps`, so the narrower `pure` row is the correct one and a divisor-class function may declare a traps-free row for the first time.";
  if igt(d, 0_u64) {
    let q = n / d;
    return q;
  }
  return 0_u64;
}

fn main() -> own unit traps {
  let v = divide(n: 84_u64, d: 2_u64);
  claim quotient: ieq(v, 42_u64) because "84 divided by 2 is 42";
  return unit;
}
