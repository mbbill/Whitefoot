fn fill(output: own MutSlice<u64>) -> result: own u64 reads(output), writes(output) {
  let count = len_of(output);
  for (i in 0_u64..count) {
    set output[i] = 7_u64;
  }
  return count;
}

fn rows(width: own u64) -> result: own buffer<u64> pure contract {
  requires width <= 32_u64;
} {
  let cells = 3_u64 * width;
  let values = buffer_new(cells, 0_u64);
  for (i in 0_u64..3_u64) {
    let start = i * width;
    let end = start + width;
    invariant bounded: end <= cells {
      use width times (i + 1_u64 <= 3_u64);
    }
    region {
      let row = mut_slice_of(&uniq values, start, end);
      let filled = fill(output: move row);
    }
  }
  return move values;
}

command fn main() -> status: own ExitStatus pure {
  let values = rows(width: 5_u64);
  let count = len_of(values);
  if count != 15_u64 {
    return exit_status(code: 1_u8);
  }
  for (i in 0_u64..count) {
    if values[i] != 7_u64 {
      return exit_status(code: 2_u8);
    }
  }
  let empty = rows(width: 0_u64);
  let zero = len_of(empty);
  if zero != 0_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
