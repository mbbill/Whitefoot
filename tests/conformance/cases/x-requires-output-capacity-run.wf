fn copy_bytes(out: &uniq buffer<u8>, source: own buffer<u8>) -> function_result: own u64 reads(source), writes(out) contract {
  define out_length = len(deref(out));
  define source_length = len(source);
  requires source_length <= out_length;
} {
  let length = len(source);
  for (offset in 0_u64..length) {
    let value = source[offset];
    set deref(out)[offset] = value;
  }
  return length;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let length = 4_u64;
  let source = buffer_new(length, 7_u8);
  let output = buffer_new(length, 0_u8);
  region {
    let destination = &uniq output;
    let written = copy_bytes(out: move destination, source: move source);
    if written == length {
    } else {
      return exit_status(code: 201_u8);
    }
  }
  let last = output[3_u64];
  if last == 7_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
