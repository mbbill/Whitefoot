alias kinds = pkg::kinds;
alias Entry = pkg::kinds::Entry;

fn bounded(entries: &Array<Entry, 4>, i: u64, n: u64) -> result: u64 reads(entries) contract {
  requires deref(entries)[i].weight <= n;
} {
  return n;
}

fn main() -> status: ExitStatus pure {
  doc "The requirement alone exercises the admission; no call is needed.";
  return exit_status(code: 0_u8);
}
