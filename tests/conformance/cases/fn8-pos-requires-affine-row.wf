fn scaled(out: &[u8], src: &[u8]) -> written: own u64 pure contract {
  define capacity = out.len;
  define count = src.len;
  define needed = count * 2_u64;
  requires capacity >= needed;
} {
  doc "The exact affine rows are read mathematically in a clause, so an expansion function states its own size precondition over a measure and a literal factor; the caller proves it from the lengths it allocated. The definition binder is no longer spelled `room`, which is reserved from every declaration role [FORM-3, TYPE-10].";
  return 0_u64;
}

fn main() -> status: own ExitStatus pure {
  doc "A range reference carries its own exact `len`, equal to its written endpoints [REF-4, MSR-1], so the two lengths reach the clause without a descriptor read or a caller branch; the affine requirement is discharged from them directly.";
  let src_run = array_filled::<u8, 4>(value: 0_u8);
  let out_run = array_filled::<u8, 8>(value: 0_u8);
  let window = &out_run[0_u64..8_u64];
  let view = &src_run[0_u64..4_u64];
  let n = scaled(out: window, src: view);
  return exit_status(code: 0_u8);
}
