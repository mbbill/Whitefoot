enum Inner {
  Leaf(value: i32);
}

enum Outer {
  Wrap(inner: Inner);
}

fn main() -> status: own ExitStatus pure {
  doc "A nested match through a reference extends the payload path one step further, and each arm's refinement fact keeps its own binder valid.";
  let leaf = Leaf(value: 7_i32);
  let packet = Wrap(inner: move leaf);
  let holder = &packet;
  match holder {
    Wrap(inner: nested) => {
      match nested {
        Leaf(value: payload) => {
          let saved = payload;
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
