fn rebuild(vector: own FixedVector<u8, 4>) -> result: own FixedVector<u8, 4> reads(vector), writes(vector) contract {
  requires len_of(vector) == 1_u64;
  ensures len_of(result) == len_of(vector) + 1_u64;
} {
  doc "Constructs a new run and installs it in the incoming owner's local binding before return.";
  let fresh = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq fresh, value: 7_u8);
    place_back(vector: &uniq fresh, value: 9_u8);
  }
  let old = replace vector = move fresh;
  return move vector;
}

fn main() -> status: own ExitStatus pure {
  doc "MSR-3: an own parameter's measure in ensures keeps its entry datum even after a freshly constructed value replaces that local binding.";
  let input = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq input, value: 3_u8);
  }
  let rebuilt = rebuild(vector: move input);
  invariant complete: len_of(rebuilt) >= 2_u64;
  let value = rebuilt[1_u64];
  if value == 9_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
