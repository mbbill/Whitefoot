fn scan(data: &[u8]) -> result: own unit reads(data) {
  let count = deref(data).len;
  let cursor = 0_u64;
  loop (
    invariant bounded: cursor <= count
  ) {
    let byte = deref(data)[cursor];
    if cursor >= count {
      break;
    }
    set cursor = cursor + 1_u64;
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
