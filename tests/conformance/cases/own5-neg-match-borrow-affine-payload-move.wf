struct Pair {
  left: i32;
  right: i32;
}

enum Packet {
  Data(item: Pair);
  Empty();
}

fn steal['r](packet: &'r Packet) -> return_value: own unit pure {
  doc "OWN-5: a payload binder derived from a shared match is non-owning and cannot move its affine referent.";
  match deref(packet) {
    Data(item: element) => {
      let stolen = move deref(element);
    }
    Empty() => {
    }
  }
  return unit;
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
