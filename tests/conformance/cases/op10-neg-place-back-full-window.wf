fn main() -> status: own ExitStatus pure {
  doc "OP-10: the window operations' contracts are the prelude records, so place_back into a window with no room leaves its requires window.room > 0_u64 undischarged.";
  let r = slots_new::<u64, 2>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  place_back(window: &r, value: 3_u64);
  let n = r.len;
  if n == 3_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
