fn second_of(run: own FixedVector<u8, 4>) -> got: own u8 reads(run) contract {
  requires len_of(run) >= 2_u64;
} {
  doc "Reads the element at logical offset one.";
  return run[1_u64];
}

command fn main() -> status: own ExitStatus pure {
  doc "MSR-2: a write at an element position overlaps the descriptor storage of that element and none of the run's own, so it kills every measure of the element and no measure of the run; the run's length bound survives the store and discharges the callee's requirement.";
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 1_u8);
  let two = place_back(vector: move one, value: 2_u8);
  set two[0_u64] = 7_u8;
  let got = second_of(run: move two);
  if got == 2_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
