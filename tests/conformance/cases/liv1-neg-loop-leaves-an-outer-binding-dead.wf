fn measure(cell: own FixedVector<u8, 4>) -> size: own u64 reads(cell) {
  doc "Consumes the run it is handed and reports its length.";
  let n = len_of(cell);
  return n;
}

command fn main() -> status: own ExitStatus pure {
  doc "OWN-11: the body consumes an outer binding and does not commit a value back into it, so the backedge disagrees with the entering edge.";
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 0_u8);
  let two = place_back(vector: move one, value: 0_u8);
  let three = place_back(vector: move two, value: 0_u8);
  let c = place_back(vector: move three, value: 0_u8);
  for (i in 0_u64..2_u64) {
    let taken = measure(cell: move c);
  }
  return exit_status(code: 0_u8);
}
