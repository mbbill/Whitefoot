enum Val {
  Small(a: i32);
  Big(b: u64);
  Bare();
}

fn classify(v: own Val) -> function_result: own i32 traps {
  doc "Match each variant of an enum whose payload slot is sized to the widest variant (u64); each payload is copied out at its own declared width [TYPE-2, TYPE-6, GRAM-10].";
  match v {
    Small(a: n) => {
      let bounded = n % 2147483647_i32;
      let bounded_below_max = ile(bounded, 2147483646_i32);
      claim small_below_max: bounded_below_max because "premises: bounded is n remainder positive 2147483647_i32 computed in this function\nderivation: signed remainder by 2147483647_i32 is at most 2147483646_i32\nconclusion: ile(bounded, 2147483646_i32) is true for every n\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following exact increment needs its upper IntegerDomain component";
      return bounded + 1_i32;
    }
    Big(b: m) => {
      if ige(m, 1000000000_u64) {
        return 2_i32;
      } else {
        return 3_i32;
      }
    }
    Bare() => {
      return 9_i32;
    }
  }
}

command fn main() -> status: own ExitStatus traps {
  doc "Construct all three variants and dispatch each through a by-value cross-fn match; the pinned sum proves every payload width round-trips.";
  let small_atom_0001 = Small(a: 40_i32);
  let a = classify(v: move small_atom_0001);
  let big_atom_0002 = Big(b: 5000000000_u64);
  let b = classify(v: move big_atom_0002);
  let bare_atom_0003 = Bare();
  let c = classify(v: move bare_atom_0003);
  if a +defined b {
  } else {
    return exit_status(code: 201_u8);
  }
  let s0 = a + b;
  if s0 +defined c {
  } else {
    return exit_status(code: 202_u8);
  }
  let s1 = s0 + c;
  if ieq(s1, 52_i32) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
