enum Val {
  Small(a: i32);
  Big(b: u64);
  Bare();
}

fn classify(v: own Val) -> function_result: own i32 traps {
  doc "Match each variant of an enum whose payload slot is sized to the widest variant (u64); each payload is copied out at its own declared width [TYPE-2, TYPE-6, GRAM-10].";
  match v {
    Small(a: n) => {
      let n_in_range = ile(n, 2147483646_i32);
      claim small_below_max: n_in_range because "premises: the only Small value passed to classify carries 40_i32\nderivation: 40_i32 is at most i32 maximum minus one\nconclusion: n_in_range is true\nchecker gap: ENT does not publish a nominal payload value through an uncontracted call and match\nconsumers: the following exact increment needs its upper IntegerDomain component";
      return n + 1_i32;
    }
    Big(b: m) => {
      if ige(m, 1000000000_u64) {
        return 2_i32;
      } else {
        return 3_i32;
      }
    }
    Bare() => {
      return 9_i32;
    }
  }
}

command fn main() -> status: own ExitStatus traps {
  doc "Construct all three variants and dispatch each through a by-value cross-fn match; the pinned sum proves every payload width round-trips.";
  let small_atom_0001 = Small(a: 40_i32);
  let a = classify(v: move small_atom_0001);
  let big_atom_0002 = Big(b: 5000000000_u64);
  let b = classify(v: move big_atom_0002);
  let bare_atom_0003 = Bare();
  let c = classify(v: move bare_atom_0003);
  claim first_sum_defined: a +defined b because "premises: the closed calls yield a equal to 41_i32 and b equal to 2_i32\nderivation: their sum is 43_i32 and is representable as i32\nconclusion: a +defined b is true\nchecker gap: ENT does not publish match-derived user-call results\nconsumers: the following exact addition needs the complete IntegerDomain obligation";
  let s0 = a + b;
  claim second_sum_defined: s0 +defined c because "premises: s0 is 43_i32 and the Bare call yields c equal to 9_i32\nderivation: their sum is 52_i32 and is representable as i32\nconclusion: s0 +defined c is true\nchecker gap: ENT does not publish match-derived user-call results through the prior sum\nconsumers: the following exact addition needs the complete IntegerDomain obligation";
  let s1 = s0 + c;
  if ieq(s1, 52_i32) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
