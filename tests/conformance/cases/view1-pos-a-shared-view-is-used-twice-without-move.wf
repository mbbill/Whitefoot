fn first_byte(window: own Slice<u8>) -> byte: own u8 reads(window) {
  let width = len_of(window);
  let empty = width == 0_u64;
  if empty {
    return 0_u8;
  }
  let inside = 0_u64 < width;
  if inside {
    let slot = window[0_u64];
    return slot;
  }
  return 0_u8;
}

command fn main() -> status: own ExitStatus pure {
  doc "VIEW-1 makes Slice copy, so a shared view is used bare and every use is a second shared loan on the same range, which OWN-5 admits without limit. The program forms one view, hands it to a helper twice with no move, reads its own length after both calls, and observes the same byte each time.";
  let data = fixed_vector::<u8, 2>();
  set data = place_back(vector: move data, value: 13_u8);
  set data = place_back(vector: move data, value: 13_u8);
  region {
    let window = slice_of(&data);
    let once = first_byte(window: window);
    let twice = first_byte(window: window);
    let width = len_of(window);
    if width == 2_u64 {
    } else {
      return exit_status(code: 21_u8);
    }
    if once == 13_u8 {
    } else {
      return exit_status(code: 22_u8);
    }
    if twice == once {
    } else {
      return exit_status(code: 23_u8);
    }
  }
  return exit_status(code: 0_u8);
}
