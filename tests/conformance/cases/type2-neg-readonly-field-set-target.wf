struct Packet {
  readonly id: u64;
  size: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "TYPE-2: a path that ends at a readonly field is never a set target, in a source struct exactly as in a prelude one.";
  let p = Packet(id: 7_u64, size: 1_u64);
  set p.id = 8_u64;
  return exit_status(code: 0_u8);
}
