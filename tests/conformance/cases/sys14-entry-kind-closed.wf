fn exercise['heap](cwd: &DirectoryRead, files: &uniq HandleFactory, heap: &uniq Heap<'heap>) -> status: own ExitStatus reads(cwd, files, heap), writes(files, heap), allocates(heap) {
  doc "The ordinary enumeration library emits records with one kind byte, a little-endian u16 name length and the name bytes. The program checks the selected record format, kind range and announced entry count without a special language operand class.";
  region {
    match heap_vector::<u8>(store: &uniq deref(heap), count: 4096_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let entries = move fresh;
        for @scratch (
          at in 0_u64..4096_u64,
          invariant grown: len_of(entries) >= at,
          invariant spare: room_of(entries) + at >= 4096_u64,
          invariant flat: head_of(entries) <= 0_u64
        ) {
          place_back(vector: &uniq entries, value: 0_u8);
        }
        let spare = len_of(entries);
        let status = 0_u8;
        region {
          match open_directory_source(factory: &uniq deref(files), directory: cwd) {
            SourceOpened(value: list) => {
              let produced = 0_u64;
              let announced = 0_u64;
              region {
                let window = mut_slice_of(&uniq entries);
                region {
                  let (list_result_26, reported) = directory_next(source: &uniq list, destination: &uniq window, start: 0_u64, end: 4096_u64);
                  match list_result_26 {
                    Ok(value: bytes) => {
                      set produced = bytes;
                      set announced = reported;
                    }
                    Err(error: list_stop_26) => {
                      match list_stop_26 {
                        ListEnd() => {
                        }
                        ListFailed(error: problem) => {
                          set status = 3_u8;
                        }
                      }
                    }
                  }
                }
              }
              let at = 0_u64;
              let seen = 0_u64;
              loop @stored_entry {
                let header_end = at +wrap 3_u64;
                let complete = header_end <= produced;
                if complete {
                } else {
                  break @stored_entry;
                }
                let kind_readable = at < spare;
                if kind_readable {
                } else {
                  break @stored_entry;
                }
                let kind = entries[at];
                let closed = kind <= 4_u8;
                if closed {
                } else {
                  set status = 9_u8;
                  break @stored_entry;
                }
                let length_low_at = at +wrap 1_u64;
                let length_low_readable = length_low_at < spare;
                if length_low_readable {
                } else {
                  break @stored_entry;
                }
                let length_high_at = at +wrap 2_u64;
                let length_high_readable = length_high_at < spare;
                if length_high_readable {
                } else {
                  break @stored_entry;
                }
                let length_low = entries[length_low_at];
                let length_high = entries[length_high_at];
                let length_low_wide = cvt::<u8, u64>(length_low);
                let length_high_wide = cvt::<u8, u64>(length_high);
                let length_high_shifted = ishl.wrap(length_high_wide, 8_u32);
                let name_count = ior(length_low_wide, length_high_shifted);
                let named = name_count > 0_u64;
                if named {
                } else {
                  set status = 10_u8;
                  break @stored_entry;
                }
                let name_at = at +wrap 3_u64;
                let name_end = name_at +wrap name_count;
                let bounded = name_end <= produced;
                if bounded {
                } else {
                  break @stored_entry;
                }
                set at = name_end;
                set seen = seen +wrap 1_u64;
              }
              let counted = seen == announced;
              if counted {
              } else {
                set status = 12_u8;
              }
              close_directory_source(factory: &uniq deref(files), source: move list);
            }
            SourceOpenFailed(error: problem) => {
              set status = 4_u8;
            }
          }
        }
        return exit_status(code: status);
      }
    }
  }
}

fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: unused_args, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  region {
    let outcome = exercise(cwd: &cwd, files: &uniq files, heap: &uniq heap);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
