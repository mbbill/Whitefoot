fn checked_sum(weights: own Slice<u8>) -> result: own u64 reads(weights) contract {
  define bound = len_of(weights);
  requires bound <= 100_u64;
} {
  let count = len_of(weights);
  let sum = 0_u64;
  for (
    i in 0_u64..count,
    invariant per_step: sum <= 510_u64 * i
  ) {
    let w = weights[i];
    let wide = cvt::<u8, u64>(w);
    let parity = iand(i, 1_u64);
    let is_even = parity == 0_u64;
    if is_even {
      set sum = sum + wide;
    } else {
      let boosted = wide + 255_u64;
      set sum = sum + boosted;
    }
  }
  return sum;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
