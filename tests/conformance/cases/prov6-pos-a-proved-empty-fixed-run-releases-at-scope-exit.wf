fn release_empty_fixed<T: linear, const n: u64>(run: own FixedVector<T, n>) -> result: own unit pure contract {
  requires len_of(run) <= 0_u64;
} {
  doc "PROV-6: a proved-empty FixedVector can take the compiler-derived release route even when its symbolic element is linear. Its frame-resident backing has no capability action, and the absent window has no element action.";
  return unit;
}

fn main() -> status: own ExitStatus pure {
  let empty = fixed_vector::<u64, 4>();
  region {
    let done = release_empty_fixed::<u64, 4>(run: move empty);
  }
  return exit_status(code: 0_u8);
}
