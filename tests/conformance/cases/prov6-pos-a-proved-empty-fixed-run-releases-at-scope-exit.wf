fn release_empty_fixed<T: linear, const n: u64>(run: own Slots<T, n>) -> result: own unit pure contract {
  requires run.len == 0_u64;
} {
  doc "OP-14: a window whose element type is linear is itself linear, and the one route that consumes its storage is free_empty. This function's own requirement discharges free_empty's; the type stays linear and the proof is about the runtime length.";
  free_empty(window: move run);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "A constant-capacity window starts empty, so its zero length is exact at the call and there is nothing for an element walk to visit.";
  let empty = slots_new::<u64, 4>();
  release_empty_fixed::<u64, 4>(run: move empty);
  return exit_status(code: 0_u8);
}
