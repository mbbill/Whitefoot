fn filled<T: copy, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

fn first_or_length(taken: own FixedVector<u8, 8>) -> outcome: own Result<u64, Overflow> reads(taken) contract {
  ensures when Ok(value: reported): reported == len_of(taken);
} {
  doc "A routed relation names a consumed own operand's measure.";
  let reported = len_of(taken);
  return Ok<u64, Overflow>(value: reported);
}

fn needs_eight(bound: own u64) -> ok: own unit pure contract {
  requires 8_u64 <= bound;
} {
  doc "Needs a caller proof about its argument.";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "CALL-6: a routed relation is instantiated at the call over the call datum and established at its arm.";
  let run = filled::<u8, 8>(value: 0_u8);
  match first_or_length(taken: move run) {
    Ok(value: reported) => {
      let confirmed = needs_eight(bound: reported);
    }
    Err(error: failure) => {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
