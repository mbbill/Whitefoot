command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files), allocates(heap) {
  doc "An uncounted loop with its exit and its carried index written before the submission. PAR-3's unit is the iteration the statement graph gives, so a loop_stmt is admitted on the same terms as a for_stmt; the break lies in the prologue, and the short unique factory loan that reserve_handle takes is serialized by index-ordered prologues rather than replicated.";
  let opened = 0_u64;
  let index = 0_u64;
  loop @scan {
    let done = index >= 4_u64;
    if done {
      break @scan;
    }
    set index = index +wrap 1_u64;
    let name = buffer_new(16_u64, 97_u8);
    region 'f {
      match reserve_handle(factory: &uniq files) {
        Ok(value: permit) => {
          region {
            match open_file(permit: move permit, root: &'f cwd, name: &name, start: 0_u64, end: 4_u64) {
              FileOpened(value: handle) => {
                set opened = opened +wrap 1_u64;
              }
              FileOpenFailed(error: problem, permit: refused) => {
              }
            }
          }
        }
        Err(error: spent) => {
          return exit_status(code: 1_u8);
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
