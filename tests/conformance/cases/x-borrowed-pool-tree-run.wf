struct Pool {
  left: buffer<u64>;
  right: buffer<u64>;
  count: u64;
}

enum PoolError {
  LeftOutOfBounds();
  RightOutOfBounds();
  ArithmeticOverflow();
}

fn build(pool: &uniq Pool, depth: own u32) -> function_result: own Result<u64, PoolError> reads(pool.left, pool.right, pool.count), writes(pool.left, pool.right, pool.count) {
  doc "Build a complete tree bottom-up in two parallel buffers; index zero is the null sentinel.";
  let leaves = ishl.wrap(1_u64, depth);
  let start = deref(pool).count;
  let index_value = 0_u64;
  loop @leaves {
    let done = index_value >= leaves;
    if done {
      break @leaves;
    } else {
      let slot = deref(pool).count;
      let left_room = len(deref(pool).left);
      let left_ok = slot < left_room;
      if left_ok {
      } else {
        let error = LeftOutOfBounds();
        return Err<u64, PoolError>(error: error);
      }
      set deref(pool).left[slot] = 0_u64;
      let right_room = len(deref(pool).right);
      let right_ok = slot < right_room;
      if right_ok {
      } else {
        let error = RightOutOfBounds();
        return Err<u64, PoolError>(error: error);
      }
      set deref(pool).right[slot] = 0_u64;
      set deref(pool).count = slot + 1_u64;
      set index_value = index_value + 1_u64;
    }
  }
  let width = leaves;
  loop @levels {
    let complete = width <= 1_u64;
    if complete {
      break @levels;
    } else {
      let half = ishr.wrap(width, 1_u32);
      let next_start = deref(pool).count;
      let parent = 0_u64;
      loop @parents {
        let parents_done = parent >= half;
        if parents_done {
          break @parents;
        } else {
          let parent_halvable = parent <= 9223372036854775807_u64;
          if parent_halvable {
          } else {
            let error = ArithmeticOverflow();
            return Err<u64, PoolError>(error: error);
          }
          let doubled = parent * 2_u64;
          let left_child_defined = start +defined doubled;
          let left_child = if left_child_defined {
            give start + doubled;
          } else {
            let error = ArithmeticOverflow();
            return Err<u64, PoolError>(error: error);
          }
          let left_child_incrementable = left_child <= 18446744073709551614_u64;
          if left_child_incrementable {
          } else {
            let error = ArithmeticOverflow();
            return Err<u64, PoolError>(error: error);
          }
          let right_child = left_child + 1_u64;
          let slot = deref(pool).count;
          let left_room = len(deref(pool).left);
          let left_ok = slot < left_room;
          if left_ok {
          } else {
            let error = LeftOutOfBounds();
            return Err<u64, PoolError>(error: error);
          }
          set deref(pool).left[slot] = left_child;
          let right_room = len(deref(pool).right);
          let right_ok = slot < right_room;
          if right_ok {
          } else {
            let error = RightOutOfBounds();
            return Err<u64, PoolError>(error: error);
          }
          set deref(pool).right[slot] = right_child;
          set deref(pool).count = slot + 1_u64;
          set parent = parent + 1_u64;
        }
      }
      set start = next_start;
      set width = half;
    }
  }
  return Ok<u64, PoolError>(value: start);
}

fn checksum(pool: &Pool, root: own u64) -> function_result: own Result<u64, PoolError> reads(pool.left, pool.right) {
  let left_room = len(deref(pool).left);
  let left_ok = root < left_room;
  if left_ok {
  } else {
    let error = LeftOutOfBounds();
    return Err<u64, PoolError>(error: error);
  }
  let left_child = deref(pool).left[root];
  let leaf = left_child == 0_u64;
  if leaf {
    return Ok<u64, PoolError>(value: 1_u64);
  }
  let right_room = len(deref(pool).right);
  let right_ok = root < right_room;
  if right_ok {
  } else {
    let error = RightOutOfBounds();
    return Err<u64, PoolError>(error: error);
  }
  let right_child = deref(pool).right[root];
  let left_count = propagate checksum(pool: pool, root: left_child);
  let right_count = propagate checksum(pool: pool, root: right_child);
  let child_sum_defined = left_count +defined right_count;
  let children = if child_sum_defined {
    give left_count + right_count;
  } else {
    let error = ArithmeticOverflow();
    return Err<u64, PoolError>(error: error);
  }
  let children_countable = children <= 18446744073709551614_u64;
  let total = if children_countable {
    give children + 1_u64;
  } else {
    let error = ArithmeticOverflow();
    return Err<u64, PoolError>(error: error);
  }
  return Ok<u64, PoolError>(value: total);
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let capacity = 64_u64;
  let left = buffer_new(capacity, 0_u64);
  let right = buffer_new(capacity, 0_u64);
  let pool = Pool(left: move left, right: move right, count: 1_u64);
  let depth = 5_u32;
  region {
    let built = build(pool: &uniq pool, depth: depth);
    match move built {
      Ok(value: root) => {
        let checksum_result = checksum(pool: &pool, root: root);
        match move checksum_result {
          Ok(value: nodes) => {
            if nodes == 63_u64 {
            } else {
              return exit_status(code: 201_u8);
            }
          }
          Err(error: checksum_error) => {
            return exit_status(code: 204_u8);
          }
        }
      }
      Err(error: build_error) => {
        return exit_status(code: 203_u8);
      }
    }
  }
  let used = pool.count;
  if used == 64_u64 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
