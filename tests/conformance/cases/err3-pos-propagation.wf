fn half_checked(x: own i64) -> own Result<i64, Overflow> pure {
  let d = x +checked x;
  let v = propagate d;
  let r = v +checked 1_i64;
  return move r;
}

fn main() -> own unit traps {
  let big = 4611686018427387904_i64;
  let a = half_checked(x: 20_i64);
  match a {
    Ok(value: v) => {
      check ieq(v, 41_i64) else trap "ok path drift";
    }
    Err(error: e) => {
      check ieq(0_i64, 1_i64) else trap "unexpected err";
    }
  }
  let b = half_checked(x: big);
  match b {
    Ok(value: v) => {
      check ieq(0_i64, 1_i64) else trap "expected err";
    }
    Err(error: e) => {
    }
  }
  return unit;
}
