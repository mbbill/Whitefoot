fn half_checked(x: own i64) -> result: own Result<i64, Overflow> pure {
  let d = x +checked x;
  let v = propagate d;
  let r = v +checked 1_i64;
  return move r;
}

command fn main() -> status: own ExitStatus traps {
  let big = 4611686018427387904_i64;
  let a = half_checked(x: 20_i64);
  match a {
    Ok(value: v) => {
      claim ok_path_drift: ieq(v, 41_i64) because "ok path drift";
    }
    Err(error: e) => {
      claim unexpected_err: False() because "unexpected err";
    }
  }
  let b = half_checked(x: big);
  match b {
    Ok(value: v) => {
      claim expected_err: False() because "expected err";
    }
    Err(error: e) => {
    }
  }
  return exit_status(code: 0_u8);
}
