fn open_read(root: own u64, path: own u64) -> own u64 pure {
  doc "In a system-admitted unit a source declaration spelled like an inventory entry in the same domain is a collision; neither declaration resolves and the unit is rejected [SYS-1] at declaration-inventory rank 5, citing TYPE-6.";
  return root;
}

command fn main() -> own ExitStatus pure {
  return exit_status(code: 0_u8);
}
