fn probe<const n: u64>(table: own Slots<u8, n>, lo: own u64, hi: own u64) -> found: own u8 pure contract {
  define spare = table.len;
  requires lo < hi;
  requires hi <= spare;
} {
  doc "The upper-biased midpoint hi - (hi - lo) / 2 equals hi when the span is one, so a half-open window does not admit that subscript.";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = hi - half;
  let byte = table[mid];
  return byte;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
