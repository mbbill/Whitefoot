command fn main(command.cwd as cwd: own DirectoryRead) -> status: own ExitStatus allocates(heap), traps {
  doc "A `DirectorySource` is an ordinary affine owner [OWN-1, SYS-14]: shareable operation borrows do not make the owner copyable. Moving the source out of its binding ends that binding's ownership, so the later shared borrow of the moved-from name is rejected before ordered traversal semantics is consulted.";
  let entries = buffer_new(1024_u64, 0_u8);
  region 'c {
    match open_directory_source<'c>(directory: &'c cwd) {
      Ok(value: list) => {
        let held = move list;
        region 'b {
          match directory_next<'b, 'b>(source: &'b list, destination: &uniq 'b entries, start: 0_u64, end: 1024_u64) {
            ListBytes(next: bytes, entries: reported) => {
              return exit_status(code: 0_u8);
            }
            ListEnd() => {
              return exit_status(code: 0_u8);
            }
            ListFailed(error: problem) => {
              return exit_status(code: 3_u8);
            }
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 4_u8);
      }
    }
  }
}
