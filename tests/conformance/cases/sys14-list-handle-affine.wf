command fn main(command.cwd as cwd: own DirectoryRead) -> own ExitStatus allocates(heap), external, blocks, traps {
  doc "A `DirectoryList` is an ordinary affine owner [OWN-1, SYS-14]: nothing about a stateful system resource exempts it. Moving the handle out of its binding ends that binding's ownership, so the later unique borrow of the moved-from name is rejected before any traversal semantics is consulted.";
  let entries = buffer_new(1024_u64, 0_u8);
  region 'c {
    match open_list<'c>(directory: &'c cwd) {
      Ok(value: list) => {
        let held = move list;
        region 'b {
          match list_once<'b, 'b>(list: &uniq 'b list, destination: &uniq 'b entries, offset: 0_u64, capacity: 1024_u64) {
            ListBytes(count: bytes, entries: reported) => {
              return exit_status(code: 0_u8);
            }
            ListEnd() => {
              return exit_status(code: 0_u8);
            }
            ListFailed(error: problem) => {
              return exit_status(code: 3_u8);
            }
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 4_u8);
      }
    }
  }
}
