enum Sign {
  Neg();
  Zero();
  Pos();
}

command fn main() -> status: own ExitStatus pure {
  doc "OWN-13 owned temporary: a non-place scrutinee construction is moved into the match. The two unexpected arms return distinct nonzero statuses, while the Pos arm reaches the final zero status.";
  match Pos() {
    Neg() => {
      return exit_status(code: 1_u8);
    }
    Zero() => {
      return exit_status(code: 2_u8);
    }
    Pos() => {
    }
  }
  return exit_status(code: 0_u8);
}
