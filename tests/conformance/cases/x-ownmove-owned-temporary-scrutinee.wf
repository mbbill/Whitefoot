enum Sign {
  Neg();
  Zero();
  Pos();
}

command fn main() -> status: own ExitStatus pure {
  doc "OWN-13 owned temporary: a non-place scrutinee (a construction) is an owned temporary moved into the match. The two arms no execution takes carry a constructed-Bool claim, which CLM-2 neither proves nor refutes, so the tripwire survives compilation and would trap if its arm ran.";
  match Pos() {
    Neg() => {
      return exit_status(code: 1_u8);
    }
    Zero() => {
      return exit_status(code: 2_u8);
    }
    Pos() => {
    }
  }
  return exit_status(code: 0_u8);
}
