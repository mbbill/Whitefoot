fn tail_byte['d](data: &'d buffer<u8>) -> result: own u8 reads(data) {
  doc "A direct-place set commit publishes its finite S5 post-write image only after facts about the old target value die.";
  let n = len(deref(data));
  let have_room = ige(n, 8_u64);
  let start = 0_u64;
  let out = 0_u8;
  if have_room {
    let back = n -wrap 8_u64;
    set start = back;
    let byte = deref(data)[start];
    set out = byte;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
