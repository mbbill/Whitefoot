enum ScanState {
  InSpace();
  InWord();
}

fn flip(s: own ScanState) -> function_result: own ScanState pure {
  let out = match s {
    InSpace() => {
      give InWord();
    }
    InWord() => {
      give InSpace();
    }
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  doc "A 2-variant tag-only enum is Bool-isomorphic: copy semantics, matched twice, loop-carried and set-mutated; lowers as i1. The unexpected final arm returns a nonzero status, making the runtime observation explicit without a claim.";
  let st = InSpace();
  let i = 0_u64;
  loop @l {
    if ige(i, 5_u64) {
      break @l;
    }
    let nx = flip(s: st);
    set st = nx;
    set i = i +wrap 1_u64;
  }
  match st {
    InSpace() => {
      return exit_status(code: 1_u8);
    }
    InWord() => {
    }
  }
  return exit_status(code: 0_u8);
}
