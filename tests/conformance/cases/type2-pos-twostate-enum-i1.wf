enum ScanState {
  InSpace();
  InWord();
}

fn flip(s: own ScanState) -> own ScanState pure {
  let out = match s {
    InSpace() => {
      give InWord();
    }
    InWord() => {
      give InSpace();
    }
  }
  return out;
}

fn main() -> own unit traps {
  doc "A 2-variant tag-only enum is Bool-isomorphic: copy semantics, matched twice, loop-carried and set-mutated; lowers as i1.";
  let st = InSpace();
  let i = 0_u64;
  loop @l {
    if i >= 5_u64 {
      break @l;
    }
    let nx = flip(s: st);
    set st = nx;
    set i = i +wrap 1_u64;
  }
  match st {
    InSpace() => {
      check 0_u64 == 1_u64 else trap "odd flips must land InWord";
    }
    InWord() => {
    }
  }
  return unit;
}
