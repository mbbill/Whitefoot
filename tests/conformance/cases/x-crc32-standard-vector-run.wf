fn crc32<const n: u64>(bytes: own FixedVector<u8, n>) -> function_result: own u32 reads(bytes) {
  let crc = 4294967295_u32;
  let length = len_of(bytes);
  for (offset in 0_u64..length) {
    let byte = bytes[offset];
    let word = cvt::<u8, u32>(byte);
    set crc = ixor(crc, word);
    for (bit in 0_u64..8_u64) {
      let low_bit = iand(crc, 1_u32);
      let shifted = ishr.wrap(crc, 1_u32);
      let low_bit_set = low_bit == 1_u32;
      if low_bit_set {
        set crc = ixor(shifted, 3988292384_u32);
      } else {
        set crc = shifted;
      }
    }
  }
  return ixor(crc, 4294967295_u32);
}

command fn main() -> status: own ExitStatus pure {
  let bytes = fixed_vector::<u8, 9>();
  set bytes = place_back(vector: move bytes, value: 49_u8);
  set bytes = place_back(vector: move bytes, value: 50_u8);
  set bytes = place_back(vector: move bytes, value: 51_u8);
  set bytes = place_back(vector: move bytes, value: 52_u8);
  set bytes = place_back(vector: move bytes, value: 53_u8);
  set bytes = place_back(vector: move bytes, value: 54_u8);
  set bytes = place_back(vector: move bytes, value: 55_u8);
  set bytes = place_back(vector: move bytes, value: 56_u8);
  set bytes = place_back(vector: move bytes, value: 57_u8);
  let checksum = crc32::<9>(bytes: move bytes);
  if checksum == 3421780262_u32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
