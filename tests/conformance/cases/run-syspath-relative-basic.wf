command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args) {
  doc "PATH-1: construction from one host string succeeds when the complete code-unit sequence contains no NUL code unit and begins with no target-root prefix. Success retypes the same inline lease with no allocation and no code-unit change, and the released path is a logical consume [SYS-5].";
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            return exit_status(code: 0_u8);
          }
          Err(error: rejected) => {
            return exit_status(code: 10_u8);
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 11_u8);
      }
    }
  }
}
