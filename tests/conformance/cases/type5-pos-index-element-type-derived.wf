fn first(b: own buffer<u8>, i: own u64) -> own u8 traps {
  doc "TYPE-5: a subscript states no element type; the selected type derives from the base place's buffer<u8>, so the binder's stated own u8 is the only type that matches.";
  let value: own u8 = b[i];
  return value;
}

fn main() -> own unit pure {
  return unit;
}
