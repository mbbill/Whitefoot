fn first(b: own array<u8, 4>, i: own u64) -> function_result: own u8 pure {
  doc "TYPE-5: a subscript states no element type; the selected own u8 type derives from the array base. The deterministic remainder rule discharges the exact bound [OP-4].";
  let bounded = i % 4_u64;
  let value = b[bounded];
  return value;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
