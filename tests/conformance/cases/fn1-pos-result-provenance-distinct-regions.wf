fn pick['r, 's](a: &uniq 'r i32, b: &uniq 's i32) -> result: &uniq 'r i32 pure {
  doc "The accepted repair FN-1 names: give the source parameter its own region so exactly one parameter shares the result's region and kind. The result's debtor is `a`, the caller's holder resolves to the place `a` was borrowed from, and a write through the result reaches that place.";
  return &uniq 'r deref(a);
}

command fn main() -> status: own ExitStatus pure {
  let v = 1_i32;
  let w = 2_i32;
  region 'a {
    region 'b {
      let r = pick<'a, 'b>(a: &uniq 'a v, b: &uniq 'b w);
      set deref(r) = 7_i32;
    }
  }
  if ieq(v, 7_i32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
