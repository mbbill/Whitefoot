struct Cell {
  tag: u64;
  weight: u64;
}

fn invalid(i: own u64, k: own u64) -> result: own unit pure contract {
  requires i < 2_u64;
  requires k < 2_u64;
  requires i < k;
} {
  doc "Index separation never keeps a later subscript live: one consuming use kills the whole binding that roots the place, so even a proved distinct candidate pair leaves the second read rooted in a dead binding.";
  let seed = Cell(tag: 0_u64, weight: 0_u64);
  let cells = array_filled::<Cell, 2>(value: seed);
  let first = cells[i].tag;
  let taken = move cells;
  let observed = cells[k].tag;
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
