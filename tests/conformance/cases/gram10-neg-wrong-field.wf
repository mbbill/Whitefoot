command fn main() -> return_value: own ExitStatus pure {
  doc "GRAM-10: a misspelled binder field name is a hard error citing GRAM-10.";
  let a = 40_i32;
  let v = match a +checked 2_i32 {
    Ok(val: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 0_u8);
}
