formal Inspect<T: linear> {
  fn length(values: &T) -> result: own u64 reads(values);
}

fn shorter(values: &Array<u64, 4>) -> result: own u64 reads(values) {
  doc "The instantiated member takes a reference to an eight-slot array; this actual takes a four-slot one.";
  return values[0_u64];
}

actual Narrow : Inspect<Array<u64, 8>> {
  length = shorter;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
