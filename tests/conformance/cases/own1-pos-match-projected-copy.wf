enum State {
  Ready();
  Done();
}

struct Holder {
  state: State;
}

fn main() -> own unit allocates(heap), traps {
  doc "OWN-1: projected Copy reads do not consume their affine struct or buffer owner.";
  let state = Ready();
  let holder = Holder(state: state);
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  let saved_holder = move holder;
  let items = buffer_new(2_u64, 7_u8);
  let first = items[0_u64];
  let second = items[1_u64];
  check ieq(first, 7_u8) else trap "first indexed copy";
  check ieq(second, 7_u8) else trap "second indexed copy";
  let saved_items = move items;
  return unit;
}
