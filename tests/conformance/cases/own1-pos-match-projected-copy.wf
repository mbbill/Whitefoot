enum State {
  Ready();
  Done();
}

struct Holder {
  state: State;
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-1: projected Copy reads do not consume their affine struct or run owner.";
  let state = Ready();
  let holder = Holder(state: state);
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  let saved_holder = move holder;
  let empty = fixed_vector::<u8, 2>();
  region {
    place_back(vector: &uniq empty, value: 7_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 7_u8);
  }
  let items = move one;
  let first = items[0_u64];
  let second = items[1_u64];
  if first == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if second == 7_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let saved_items = move items;
  return exit_status(code: 0_u8);
}
