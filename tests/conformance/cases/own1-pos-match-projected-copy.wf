enum State {
  Ready();
  Done();
}

struct Holder {
  state: State;
}

command fn main() -> return_value: own ExitStatus allocates(heap) {
  doc "OWN-1: projected Copy reads do not consume their affine struct or buffer owner.";
  let state = Ready();
  let holder = Holder(state: state);
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  let saved_holder = move holder;
  let items = buffer_new(2_u64, 7_u8);
  let first = items[0_u64];
  let second = items[1_u64];
  if ieq(first, 7_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(second, 7_u8) {
  } else {
    return exit_status(code: 2_u8);
  }
  let saved_items = move items;
  return exit_status(code: 0_u8);
}
