enum DecodeError {
  ZeroByte();
}

fn transform(input: own buffer<u8>) -> own Result<buffer<u8>, DecodeError> allocates(heap), traps {
  let length = len(input);
  let output = buffer_new(length, 0_u8);
  let offset = 0_u64;
  loop @transform {
    let done = ieq(offset, length);
    if done {
      break @transform;
    } else {
      let input_room = len(input);
      let read_ok = ilt(offset, input_room);
      claim offset_in_input: read_ok because "the walk stops at the input length";
      let byte = input[offset];
      let zero = ieq(byte, 0_u8);
      if zero {
        let error = ZeroByte();
        return Err<buffer<u8>, DecodeError>(error: error);
      } else {
        let transformed = byte +wrap 1_u8;
        let output_room = len(output);
        let write_ok = ilt(offset, output_room);
        claim offset_in_output: write_ok because "the output was allocated with the input length";
        set output[offset] = transformed;
        set offset = offset +wrap 1_u64;
      }
    }
  }
  return Ok<buffer<u8>, DecodeError>(value: move output);
}

fn abandon(result: own Result<buffer<u8>, DecodeError>) -> own unit pure {
  return unit;
}

fn main() -> own unit allocates(heap), traps {
  let success_input = buffer_new(3_u64, 1_u8);
  set success_input[1_u64] = 4_u8;
  let success = transform(input: move success_input);
  match move success {
    Ok(value: transformed) => {
      let length = len(transformed);
      let first_ok = ilt(0_u64, length);
      claim first_in_transformed: first_ok because "a three-byte input transforms to three bytes";
      let first = transformed[0_u64];
      let middle_ok = ilt(1_u64, length);
      claim middle_in_transformed: middle_ok because "a three-byte input transforms to three bytes";
      let middle = transformed[1_u64];
      claim success_length: ieq(length, 3_u64) because "success length";
      claim success_first_byte: ieq(first, 2_u8) because "success first byte";
      claim success_middle_byte: ieq(middle, 5_u8) because "success middle byte";
    }
    Err(error: success_error) => {
      claim success_became_error: False() because "success became error";
    }
  }
  let failure_input = buffer_new(2_u64, 8_u8);
  set failure_input[1_u64] = 0_u8;
  let failure = transform(input: move failure_input);
  match move failure {
    Ok(value: failure_value) => {
      claim zero_byte_succeeded: False() because "zero byte succeeded";
    }
    Err(error: failure_error) => {
      match failure_error {
        ZeroByte() => {
        }
      }
    }
  }
  let abandoned_input = buffer_new(1_u64, 6_u8);
  let abandoned = transform(input: move abandoned_input);
  abandon(result: move abandoned);
  let abandoned_error_input = buffer_new(1_u64, 0_u8);
  let abandoned_error = transform(input: move abandoned_error_input);
  abandon(result: move abandoned_error);
  return unit;
}
