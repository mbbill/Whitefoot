fn dispose_open_outcome(factory: &uniq HandleFactory, outcome: own Result<ReadFile, IoError>) -> result: own unit reads(factory), writes(factory) {
  doc "EFF-2: the explicit close occurs only in Ok, but its factory access contributes to the complete body row. The moved payload is local storage.";
  match outcome {
    Ok(value: file) => {
      region {
        let closed = close_read(factory: &uniq deref(factory), file: move file);
      }
      return unit;
    }
    Err(error: problem) => {
      return unit;
    }
  }
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
