enum Sign {
  Neg();
  Zero();
  Pos();
}

command fn main() -> status: own ExitStatus pure {
  doc "IDENT, TYPEID, REGIONID, LABEL, and OPNAME lexical classes [FORM-3].";
  let a = 3_i32;
  region 'r {
    let p = &'r a;
    loop @l {
      break @l;
    }
    let v = match deref(p) +checked 1_i32 {
      Ok(value: w) => {
        give w;
      }
      Err(error: e) => {
        return exit_status(code: 1_u8);
      }
    }
    if ieq(v, 4_i32) {
    } else {
      return exit_status(code: 2_u8);
    }
  }
  return exit_status(code: 0_u8);
}
