enum Sign {
  Neg();
  Zero();
  Pos();
}

fn main() -> own unit traps {
  doc "IDENT, TYPEID, REGIONID, LABEL, and OPNAME lexical classes [FORM-3].";
  let a = 3_i32;
  region 'r {
    let p = &'r a;
    loop @l {
      break @l;
    }
    let v = match deref(p) +checked 1_i32 {
      Ok(value: w) => {
        give w;
      }
      Err(error: e) => {
        return unit;
      }
    }
    check v == 4_i32 else trap "drift";
  }
  return unit;
}
