fn make(count: own u64) -> result: own Box<Slots<u64>> pure {
  doc "OP-13: each runtime-capacity construction carries the static allocation-size obligation on its own count, and an unbounded runtime count leaves it unproved.";
  return box_slots_new::<u64>(capacity: count);
}

fn main() -> status: own ExitStatus pure {
  doc "OP-13: the caller of a runtime-capacity construction whose count carries no bound.";
  let b = make(count: 4_u64);
  let n = deref(b).len;
  if n == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
