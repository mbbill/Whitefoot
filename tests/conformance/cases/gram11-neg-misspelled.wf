fn add2(x: own i32, y: own i32) -> return_value: own i32 pure {
  return x +wrap y;
}

command fn main() -> return_value: own ExitStatus pure {
  doc "GRAM-11: a misspelled parameter name in a call is a hard error citing GRAM-11.";
  let r = add2(x: 40_i32, z: 2_i32);
  return exit_status(code: 0_u8);
}
