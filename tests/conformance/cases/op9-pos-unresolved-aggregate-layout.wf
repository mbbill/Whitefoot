struct Envelope<T> {
  payload: T;
  tag: u8;
}

fn allocate<T>(count: own u64) -> result: own u64 pure contract {
  requires count <= 1_u64;
  ensures result == count;
} {
  let cells = box_slots_new::<Envelope<T>>(capacity: count);
  let capacity = cells.inner.cap;
  free_empty(window: move cells);
  return capacity;
}

fn relay<U>(count: own u64) -> result: own u64 pure contract {
  requires count <= 1_u64;
  ensures result == count;
} {
  let capacity = allocate::<U>(count: count);
  return capacity;
}

fn main() -> status: own ExitStatus pure {
  let scalar = relay::<u64>(count: 1_u64);
  let pointer = relay::<Box<u8>>(count: 1_u64);
  return exit_status(code: 0_u8);
}
