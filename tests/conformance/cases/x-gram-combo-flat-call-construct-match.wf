enum Parity {
  Even(n: i32);
  Odd(n: i32);
}

fn double(x: own i32) -> function_result: own i32 pure {
  return x *wrap 2_i32;
}

command fn main() -> status: own ExitStatus pure {
  doc "Combination: a GRAM-9 three-address chain feeds a GRAM-11 named call whose result fills a GRAM-8 named construct, then a GRAM-10 match selects the arm; runs to exit 0.";
  let a = 3_i32;
  let b = 4_i32;
  let s = a +wrap b;
  let d = double(x: s);
  let p = Even(n: d);
  match p {
    Even(n: v) => {
      if d == 14_i32 {
      } else {
        return exit_status(code: 201_u8);
      }
    }
    Odd(n: v) => {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 0_u8);
}
