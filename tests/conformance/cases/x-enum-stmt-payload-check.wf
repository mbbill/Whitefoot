enum Tagged {
  Num(n: i32);
  Nil();
}

fn main() -> own unit traps {
  doc "Statement-position match over an owned payload enum: the moved scrutinee's payload is copied into the arm as a fresh local and gates a check [TYPE-2, GRAM-10, OWN-13, OP-1].";
  let t = Num(n: 21_i32);
  match t {
    Num(n: v) => {
      let v_below = ile(v, 1073741823_i32);
      claim payload_below_half_max: v_below because "the constructed payload is 21";
      let v_above = ige(v, -1073741824_i32);
      claim payload_above_half_min: v_above because "the constructed payload is 21";
      let d = v * 2_i32;
      check ieq(d, 42_i32) else trap "num payload drift";
    }
    Nil() => {
      check ieq(0_i32, 1_i32) else trap "nil";
    }
  }
  return unit;
}
