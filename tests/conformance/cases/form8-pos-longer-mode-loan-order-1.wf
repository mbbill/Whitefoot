struct Mark['s] {
  value: u64;
}

fn carry['s](marker: own Mark<'s>, loan: &'s u64) -> result: own Mark<'s> pure {
  return move marker;
}

fn main() -> status: own ExitStatus pure {
  let number = 9_u64;
  region 'outer {
    region 'inner {
      let marker = Mark<'inner>(value: 7_u64);
      let result = carry(marker: move marker, loan: &'outer number);
    }
  }
  return exit_status(code: 0_u8);
}
