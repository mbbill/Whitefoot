fn required_read(bytes: own buffer<u8>, index: own u64) -> return_value: own u8 pure contract {
  define room = len(bytes);
  define inside = ilt(index, room);
  requires inside;
} {
  return bytes[index];
}

fn clamp_three(value: own u64) -> return_value: own u64 pure {
  return imin(value, 3_u64);
}

command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap), traps {
  doc "A command-entry claim proves the full call goal but disappears from the claim-blinded caller state, so an external system-result actual cannot launder the callee's protected leaf through S4.";
  region 'a {
    let raw_index = args_count<'a>(args: &'a args);
    let index = clamp_three(value: raw_index);
    let bytes = buffer_new(4_u64, 0_u8);
    let room = len(bytes);
    let inside = ilt(index, room);
    claim entry_call_precondition: inside because "premises: index is returned by clamp_three, whose body computes imin(raw_index, 3_u64), and bytes has length 4\nderivation: index is at most 3_u64 and therefore strictly less than room\nconclusion: ilt(index, room) is true\nchecker gap: ENT does not publish an uncontracted user-call result bound\nconsumers: the following required_read call requires this exact bound";
    let value = required_read(bytes: move bytes, index: index);
    return exit_status(code: 0_u8);
  }
}
