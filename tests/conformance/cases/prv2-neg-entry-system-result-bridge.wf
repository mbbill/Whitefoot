fn required_read(bytes: own buffer<u8>, index: own u64) -> return_value: own u8 pure contract {
  define room = len(bytes);
  define inside = ilt(index, room);
  requires inside;
} {
  return bytes[index];
}

fn entry_bridge(raw_index: own u64) -> return_value: own u8 allocates(heap), traps {
  let index = raw_index % 4_u64;
  let bytes = buffer_new(4_u64, 0_u8);
  let room = len(bytes);
  let inside = ilt(index, room);
  claim entry_call_precondition: inside because "premises: index is raw_index remainder 4_u64 computed in this function and bytes has length 4\nderivation: unsigned remainder by 4_u64 is at most 3_u64 and therefore strictly less than room\nconclusion: ilt(index, room) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following required_read call requires this exact bound";
  let value = required_read(bytes: move bytes, index: index);
  return value;
}

command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap), traps {
  doc "A command-entry actual crosses into a local residual claim that proves the full call goal but disappears from the claim-blinded state, so the external system result cannot launder the protected leaf through S4.";
  region 'a {
    let raw_index = args_count<'a>(args: &'a args);
    let value = entry_bridge(raw_index: raw_index);
  }
  return exit_status(code: 0_u8);
}
