enum PrvChoice {
  PrvExternal(value: u64);
  PrvInternal(value: u64);
}

command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap), traps {
  doc "A boundary-derived enum payload seeds only its direct projection. The unseeded sibling binder stays internal and may carry a genuine same-function remainder residual to protect its subscript.";
  region 'a {
    let external_value = args_count<'a>(args: &'a args);
    let choice = PrvExternal(value: external_value);
    match choice {
      PrvExternal(value: selected_external) => {
        return exit_status(code: 0_u8);
      }
      PrvInternal(value: selected_internal) => {
        let bounded = selected_internal % 1_u64;
        let bytes = buffer_new(1_u64, 0_u8);
        let room = len(bytes);
        let inside = ilt(bounded, room);
        claim sibling_index_in_bytes: inside because "premises: bounded is selected_internal remainder 1_u64 computed in this function and bytes has length 1_u64\nderivation: unsigned remainder by 1_u64 is 0_u64 and therefore strictly less than room\nconclusion: ilt(bounded, room) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following bytes[bounded] subscript requires this exact bound";
        let value = bytes[bounded];
        return exit_status(code: 0_u8);
      }
    }
  }
}
