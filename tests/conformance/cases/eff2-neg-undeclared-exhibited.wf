command fn main() -> status: own ExitStatus pure {
  doc "Body exhibits traps (a `claim`) but declares `pure` [EFF-2] undeclared-but-exhibited.";
  let values = array_new<u8, 4>(0_u8);
  let seed = 9_u64;
  let bounded = seed % 4_u64;
  let inside = ilt(bounded, 4_u64);
  claim bounded_index: inside because "premises: values has length 4 and bounded is seed remainder 4_u64 computed in this function\nderivation: unsigned remainder by 4_u64 is at most 3_u64 and therefore strictly less than the array length\nconclusion: ilt(bounded, 4_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following values[bounded] subscript requires this exact bound";
  let selected = values[bounded];
  return exit_status(code: 0_u8);
}
