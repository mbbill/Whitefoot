fn fill(target: &Slots<u8, 4>) -> result: own unit pure contract {
  requires deref(target).room > 0_u64;
} {
  doc "The body places one value into the window behind its reference parameter, which exhibits writes(target.next) and writes(target.len), and declares the empty row instead [EFF-2, OP-10].";
  place_back(window: target, value: 7_u8);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "Builds an empty window whose room is its whole capacity and hands it to the helper.";
  let block = slots_new::<u8, 4>();
  fill(target: &block);
  return exit_status(code: 0_u8);
}
