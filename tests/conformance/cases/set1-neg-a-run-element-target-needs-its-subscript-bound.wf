command fn main() -> status: own ExitStatus pure {
  doc "SET-1, OP-4: the subscript of an element-position store is judged at the target place exactly as in read position, so an offset the program has not bounded against len_of is refused.";
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 1_u8);
  set one[3_u64] = 9_u8;
  return exit_status(code: 0_u8);
}
