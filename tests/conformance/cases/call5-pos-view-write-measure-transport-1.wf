fn fill(destination: &[u8], at: own u64) -> result: own u64 writes(destination) {
  doc "Writes one byte through the range reference and returns the next position.";
  let spare = deref(destination).len;
  let inside = at < spare;
  if inside {
    set deref(destination)[at] = 65_u8;
  }
  let advanced = at +wrap 1_u64;
  return advanced;
}

fn emit(source: &[u8], length: own u64) -> result: own u64 reads(source) contract {
  define capacity = deref(source).len;
  requires length <= capacity;
} {
  doc "Reads a prefix whose length the caller has proved.";
  let present = 0_u64 < length;
  if present {
    let lead = deref(source)[0_u64];
  }
  return length;
}

fn main() -> status: own ExitStatus pure {
  doc "A write through a range reference preserves the caller's saved length image: the projected write reaches the range's element storage and kills no measure over the origin place, so the bound established before the write still discharges the later requirement. An unproved prefix or a whole-window write through an ordinary reference parameter would not.";
  let line = slots_new::<u8, 64>();
  for (
    i in 0_u64..64_u64,
    invariant h: line.len == i
  ) {
    place_back(window: &line, value: 0_u8);
  }
  let spare = line.len;
  let window = &line[0_u64..64_u64];
  let end = fill(destination: window, at: 0_u64);
  let fits = end <= spare;
  if fits {
    let view = &line[0_u64..64_u64];
    let sent = emit(source: view, length: end);
  }
  return exit_status(code: 0_u8);
}
