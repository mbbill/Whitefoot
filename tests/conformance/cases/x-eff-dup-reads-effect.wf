fn f['r, 's](x: own i32) -> function_result: own i32 reads('r), reads('s) {
  doc "Two separate reads effects duplicate the reads kind [EFF-1]; canonical is reads('r 's).";
  return x;
}

command fn main() -> status: own ExitStatus traps {
  doc "Driver.";
  let a = f(x: 7_i32);
  return exit_status(code: 0_u8);
}
