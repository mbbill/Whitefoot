struct CopyToken {
}

nocopy struct AffineToken {
}

fn mint_copy() -> result: CopyToken pure {
  return CopyToken();
}

fn mint_affine() -> result: AffineToken pure {
  return AffineToken();
}

fn main() -> status: ExitStatus pure {
  mint_copy();
  mint_affine();
  return exit_status(code: 0_u8);
}
