fn only<T: affine>(value: own T) -> made: own FixedVector<T, 4> pure contract {
  ensures len_of(made) >= 1_u64;
} {
  doc "Builds a run of one element at an unbounded element type.";
  let empty = fixed_vector::<T, 4>();
  let built = place_back(vector: move empty, value: move value);
  return move built;
}

command fn main() -> status: own ExitStatus pure {
  doc "BLK-1: a run's element type is any nameable type, an unbounded type parameter included, which FN-2 resolves at every concrete instance; neither run inherits the flat-element restriction TYPE-2 states for a buffer.";
  let payload = Some<u8>(value: 5_u8);
  let run = only::<Option<u8>>(value: move payload);
  let held = len_of(run);
  if held == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let (rest, taken) = take_back(vector: move run);
  match taken {
    Some(value: got) => {
      if got == 5_u8 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 2_u8);
    }
    None() => {
      return exit_status(code: 3_u8);
    }
  }
}
