contract Disposer {
  fn dispose(file: own ReadFile) -> function_result: own unit pure;
}

conform u64: Disposer {
  dispose = release_read_file;
}

fn release_read_file(file: own ReadFile) -> function_result: own unit external, blocks {
  doc "A fn_sig has no body and no compiler-derived release, so it declares these categories without an EFF-2 judgment of its own; a `pure` member cannot bind a function that exhibits a category only through release, and the mismatch is an FN-3 rejection rather than an EFF-2 one.";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
