contract Pair {
  fn first() -> result: own i32 pure;
  fn second() -> result: own i32 pure;
}

conform i32: Pair {
  first = make_first;
}

fn make_first() -> result: own i32 pure {
  return 1_i32;
}

fn make_second() -> result: own i32 pure {
  return 2_i32;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
