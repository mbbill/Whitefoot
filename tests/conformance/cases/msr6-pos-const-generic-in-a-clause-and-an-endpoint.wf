fn filled<T: copy, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

fn walk_bound<const n: u64>(source: own FixedVector<u8, 8>) -> last: own u8 reads(source) contract {
  requires n < len_of(source);
} {
  doc "A const generic as a clause operand and as a counted range endpoint.";
  for (at in 0_u64..n) {
    let seen = at;
  }
  return source[n];
}

command fn main() -> status: own ExitStatus pure {
  doc "[MSR-6] the `pbase` admission carries the const generic into the two other positions a named const already reaches: the `for_stmt` endpoint [ENT-2] and the clause operand [MSR-5]. The requirement is stated over the parameter, the counted loop's upper endpoint is the same parameter, and the subscript at that offset discharges from the requirement after instantiation folds the parameter to its mathematical constant.";
  let run = filled::<u8, 8>(value: 0_u8);
  let last = walk_bound::<4>(source: move run);
  if last == 0_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
