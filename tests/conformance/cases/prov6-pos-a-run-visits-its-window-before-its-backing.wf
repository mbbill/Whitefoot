struct Holder {
  data: buffer<u8>;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "PROV-6: a container's elements are visited before its backing is released. The run's own backing is its owner's frame and reclaims nothing, and its window holds elements that each own one heap allocation, so the derived release is exactly the window walk in ascending logical order and the storage every element owns is freed once.";
  let empty = fixed_vector::<Holder, 4>();
  let first_bytes = buffer_new(2_u64, 3_u8);
  let first = Holder(data: move first_bytes);
  let one = place_back(vector: move empty, value: move first);
  let second_bytes = buffer_new(2_u64, 5_u8);
  let second = Holder(data: move second_bytes);
  let two = place_back(vector: move one, value: move second);
  let held = len_of(two);
  if held == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let (rest, back) = take_front(vector: move two);
  let width = len_of(back.data);
  if width == 2_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let left = len_of(rest);
  if left == 1_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
