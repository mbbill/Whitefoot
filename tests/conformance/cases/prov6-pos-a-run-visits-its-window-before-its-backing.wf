struct Holder['s] {
  data: Vector<'s, u8>;
}

fn hold['s](store: &uniq Heap<'s>, value: own u8) -> made: own Option<Holder<'s>> reads(store), writes(store), allocates(store) {
  doc "Takes one run of two slots from the store the caller's provider names, fills it, and wraps it in the nominal that carries that store's region.";
  region {
    match heap_vector::<u8>(store: &uniq deref(store), count: 2_u64) {
      None() => {
        return None<Holder<'s>>();
      }
      Some(value: fresh) => {
        region {
          place_back(vector: &uniq fresh, value: value);
        }
        let one = move fresh;
        region {
          place_back(vector: &uniq one, value: value);
        }
        let two = move one;
        let wrapped = Holder(data: move two);
        return Some<Holder<'s>>(value: move wrapped);
      }
    }
  }
}

fn walk['s](store: &uniq Heap<'s>, first: own Holder<'s>) -> code: own u8 reads(store, first.data), writes(store, first.data), allocates(store) {
  doc "PROV-6: a container's elements are visited before its backing is released. The fixed run's own backing is this activation's frame and reclaims nothing, and its window holds elements that each own one run of the general store, so the derived release is exactly the window walk in ascending logical order and the storage every element owns is freed once.";
  let empty = fixed_vector::<Holder<'s>, 4>();
  region {
    place_back(vector: &uniq empty, value: move first);
  }
  let one = move empty;
  region {
    match hold(store: &uniq deref(store), value: 5_u8) {
      None() => {
        return 70_u8;
      }
      Some(value: second) => {
        place_back(vector: &uniq one, value: move second);
        let two = move one;
        let held = len_of(two);
        if held == 2_u64 {
        } else {
          return 1_u8;
        }
        region {
          let back = take_front(vector: &uniq two);
          let rest = move two;
          let width = len_of(back.data);
          if width == 2_u64 {
          } else {
            return 2_u8;
          }
          let left = len_of(rest);
          if left == 1_u64 {
          } else {
            return 3_u8;
          }
          return 0_u8;
        }
      }
    }
  }
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "The entry hands the general store's provider to the walk, whose own region parameter names the store the run's elements live in.";
  region {
    match hold(store: &uniq heap, value: 3_u8) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: first) => {
        region {
          let code = walk(store: &uniq heap, first: move first);
          return exit_status(code: code);
        }
      }
    }
  }
}
