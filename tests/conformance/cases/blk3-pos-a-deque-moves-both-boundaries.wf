command fn main() -> status: own ExitStatus pure {
  doc "BLK-3: place_front moves the front boundary backwards and take_back moves the back one, so all four boundary operations are exercised over one run.";
  let empty = fixed_vector::<u8, 4>();
  region {
    place_front(vector: &uniq empty, value: 1_u8);
  }
  let one = move empty;
  region {
    place_front(vector: &uniq one, value: 2_u8);
  }
  let two = move one;
  region {
    place_front(vector: &uniq two, value: 3_u8);
  }
  let three = move two;
  let front = three[0_u64];
  if front == 3_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  region {
    let last = take_back(vector: &uniq three);
    let rest0 = move three;
    if last == 1_u8 {
    } else {
      return exit_status(code: 2_u8);
    }
    region {
      let next = take_back(vector: &uniq rest0);
      let rest1 = move rest0;
      if next == 2_u8 {
      } else {
        return exit_status(code: 3_u8);
      }
      region {
        let only = take_front(vector: &uniq rest1);
        let rest2 = move rest1;
        if only == 3_u8 {
        } else {
          return exit_status(code: 4_u8);
        }
        let left = len_of(rest2);
        if left == 0_u64 {
        } else {
          return exit_status(code: 5_u8);
        }
        return exit_status(code: 0_u8);
      }
    }
  }
}
