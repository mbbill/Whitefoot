command fn main() -> status: own ExitStatus pure {
  doc "BLK-3: place_front moves the front boundary backwards and take_back moves the back one, so all four boundary operations are exercised over one run.";
  let empty = fixed_vector::<u8, 4>();
  let one = place_front(vector: move empty, value: 1_u8);
  let two = place_front(vector: move one, value: 2_u8);
  let three = place_front(vector: move two, value: 3_u8);
  let front = three[0_u64];
  if front == 3_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let (rest0, last) = take_back(vector: move three);
  if last == 1_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let (rest1, next) = take_back(vector: move rest0);
  if next == 2_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  let (rest2, only) = take_front(vector: move rest1);
  if only == 3_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let left = len_of(rest2);
  if left == 0_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
