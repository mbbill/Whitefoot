fn f(heap: &uniq Heap, x: own i32) -> result: own i32 allocates(heap) {
  doc "Declares `allocates(heap)` over its provider parameter but the body reaches no allocation [EFF-2].";
  return x;
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  region {
    let a = f(heap: &uniq heap, x: 7_i32);
  }
  return exit_status(code: 0_u8);
}
