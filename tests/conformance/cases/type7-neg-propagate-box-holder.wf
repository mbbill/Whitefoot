enum StepError {
  Failed();
}

fn forward(holder: own Box<Result<i32, StepError>>) -> function_result: own Result<i32, StepError> pure {
  doc "TYPE-7: propagate cannot implicitly read a Result out of a cell holder; write deref(holder), and the holder diagnostic wins before ERR-3 shape checking.";
  let value = propagate holder;
  return Ok<i32, StepError>(value: value);
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
