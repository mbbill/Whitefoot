fn record['s](destination: &uniq Arena<'s, 4, 1>) -> available: own u64 reads(destination) contract {
  ensures available == room_of(deref(destination));
} {
  return room_of(deref(destination));
}

command fn main() -> status: own ExitStatus pure {
  region 'w {
    let workspace = arena_frame::<4, 1, 'w>();
    region {
      let available = record(destination: &uniq workspace);
      if available != 4_u64 {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
