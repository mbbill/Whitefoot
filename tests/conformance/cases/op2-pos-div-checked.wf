fn classify(x: own i32, y: own i32) -> return_value: own i32 pure {
  doc "/checked yields Result<T, DivError> [OP-2]: Err(DivideByZero()) for a zero divisor, Err(DivOverflow()) for signed iK::MIN/-1, else Ok.";
  match x /checked y {
    Ok(value: q) => {
      return q;
    }
    Err(error: e) => {
      return 0_i32;
    }
  }
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
