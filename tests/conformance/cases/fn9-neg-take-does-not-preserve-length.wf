fn take_wrong['s: affine](free: &uniq FixedVector<Vector<'s, u8>, 2>) -> block: own Vector<'s, u8> reads(free), writes(free) contract {
  requires len_of(deref(free)) > 0_u64;
  ensures len_of(deref(free)) == len_of(deref(entry(free)));
} {
  region {
    let block = take_back(vector: &uniq deref(free));
    return move block;
  }
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
