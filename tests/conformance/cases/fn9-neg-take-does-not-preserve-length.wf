fn take_wrong(storage: &Slots<Box<Slots<u8>>, 2>) -> block: own Box<Slots<u8>> writes(storage.last), writes(storage.len) contract {
  requires deref(storage).len > 0_u64;
  ensures deref(storage).len == deref(entry(storage)).len;
} {
  doc "Taking one element off the back moves the window boundary down by one [OP-10], so a postcondition claiming the length equals the entry length is refuted independently of the remaining capacity or room.";
  return take_back(window: storage);
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
