enum ErrA {
  A();
}

enum ErrB {
  B();
}

fn step(x: own i32) -> result: own Result<i32, ErrA> pure {
  return Ok<i32, ErrA>(value: x);
}

fn forward(x: own i32) -> result: own Result<i32, ErrB> pure {
  doc "`propagate` requires inner and outer E to match (no conversions) [ERR-3]; ErrA != ErrB.";
  let y = propagate step(x: x);
  return Ok<i32, ErrB>(value: y);
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
