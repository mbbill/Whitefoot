fn hidden_true() -> result: own Bool pure {
  return True();
}

fn read(values: own array<u8, 4>, cursor: own u64) -> result: own u8 traps {
  let condition = hidden_true();
  if condition {
    let position = cursor % 4_u64;
    claim reviewed_arm_local: ilt(position, 4_u64) because "premises: position is cursor modulo the literal 4_u64 and cursor is an ordinary parameter of this function\nderivation: a remainder by 4_u64 is below 4_u64, and the call result reached only the branch this statement stands in, never an operand of position\nconclusion: ilt(position, 4_u64) is true\nchecker gap: the entailment state carries no residue for a remainder by a literal, so the bound is left to this executed check\nconsumers: the following values[position] subscript consumes the predicate established at this exact point";
    return values[position];
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
