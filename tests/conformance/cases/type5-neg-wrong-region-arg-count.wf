fn takes_one['p](x: &'p i32) -> function_result: own unit pure {
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "A call stating two region arguments to a fn declaring one region parameter is a region-arg arity mismatch [TYPE-5].";
  let v = 3_i32;
  region 'r {
    let b = &'r v;
    takes_one<'r, 'r>(x: b);
  }
  return exit_status(code: 0_u8);
}
