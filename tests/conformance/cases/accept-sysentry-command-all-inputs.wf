command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own OutputStream, command.stderr as err: own OutputStream, command.handles as handles: own HandleFactory, command.stdin as input: own InputStream) -> status: own ExitStatus writes(cwd) {
  doc "A command entry selecting every standard input row in table-ordinal order [FN-7]; `command.stdout` and `command.stderr` are two distinct inputs of one type [SYS-12], `command.handles` supplies the ordinary handle factory [SYS-10], `command.stdin` supplies the readable stream at ordinal 5 [SYS-15], and the declared row is exactly the release contribution of the DirectoryRead close attempt because HandleFactory releases by logical consume and InputStream by logical source detach [SYS-5, SYS-15, EFF-2].";
  return exit_status(code: 0_u8);
}
