fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus pure {
  doc "PRE-1: the invocation arrives as one ordinary Inputs struct and an ordinary separately branded Heap parameter. Its linear directory is explicitly closed; unused affine fields need no release operation.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: factory, stdin: input) = move inputs;
  region {
    close_directory(factory: &uniq factory, directory: move cwd);
  }
  return exit_status(code: 0_u8);
}
