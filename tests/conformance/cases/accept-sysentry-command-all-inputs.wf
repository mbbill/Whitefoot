fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1: the invocation arrives as one ordinary Inputs struct. Whole destructuring exposes ordinary fields; cwd is explicitly consumed through close_directory. There is no heap value to hand in, no input-label order and no implicit native release.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: factory, stdin: input) = move inputs;
  close_directory(factory: &factory, directory: move cwd);
  return exit_status(code: 0_u8);
}
