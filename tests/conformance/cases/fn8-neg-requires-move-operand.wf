fn guarded(left: own u32, right: own u32) -> result: own unit pure contract {
  define same = ieq(move left, move right);
  requires same;
} {
  doc "FN-8 names move in its own prohibition list, so a moved operand is rejected even where the operation, the domain, and the clause shape are all legal; the same clause without move is accepted.";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
