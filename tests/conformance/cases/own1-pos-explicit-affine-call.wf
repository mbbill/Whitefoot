fn consume(buf: own FixedVector<u8, 1>) -> return_value: own unit pure {
  return unit;
}

command fn main() -> return_value: own ExitStatus pure {
  let empty = fixed_vector::<u8, 1>();
  region {
    place_back(vector: &uniq empty, value: 0_u8);
  }
  let b = move empty;
  consume(buf: move b);
  return exit_status(code: 0_u8);
}
