const fixed_bytes: array<u8, 3> =[7_u8, 13_u8, 19_u8];

fn fixed_view['r]() -> result: own slice<'r, u8> pure {
  let view = slice_of(&'r fixed_bytes);
  return move view;
}

command fn main() -> status: own ExitStatus traps {
  region 'view {
    let view = fixed_view<'view>();
    let view_room = len(view);
    let view_ok = ilt(1_u64, view_room);
    claim view_sized: view_ok because "fixed_view returns the three-byte constant view";
    let observed = view[1_u64];
    claim returned_const_slice: ieq(observed, 13_u8) because "returned const slice";
  }
  return exit_status(code: 0_u8);
}
