const fixed_bytes: array<u8, 3> =[7_u8, 13_u8, 19_u8];

fn fixed_view['r]() -> result: own Slice<'r, u8> pure {
  let view = slice_of(&'r fixed_bytes);
  return view;
}

command fn main() -> status: own ExitStatus pure {
  region 'view {
    let view = fixed_view::<'view>();
    let view_room = len_of(view);
    let view_ok = 1_u64 < view_room;
    if view_ok {
    } else {
      return exit_status(code: 211_u8);
    }
    let observed = view[1_u64];
    if observed == 13_u8 {
    } else {
      return exit_status(code: 201_u8);
    }
  }
  return exit_status(code: 0_u8);
}
