command fn main() -> status: own ExitStatus traps {
  doc "A claim is a runtime check in all build modes, never elided [CLM-1]; the wrapped i32::MAX + 1 is negative, so an `igt 0` invariant is violated and the process traps and aborts [SCOPE-4]. The predicate is computed from a wrapping add, so no fact reaches it and CLM-2 neither proves nor refutes it.";
  let hi = 2147483647_i32;
  let w = hi +wrap 1_i32;
  claim wrapped_value_is_not_positive: igt(w, 0_i32) because "wrapped value is not positive";
  return exit_status(code: 0_u8);
}
