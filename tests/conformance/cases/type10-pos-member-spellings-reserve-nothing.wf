struct Node {
  len: u64;
  next: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "TYPE-10: the window-part spellings and the measure field names reserve nothing. They are selected by the type of the place they follow, so a struct of another type declares fields named len and next, and bindings are named filled and last.";
  let node = Node(len: 3_u64, next: 4_u64);
  let filled = node.len;
  let last = node.next;
  if filled == 3_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if last == 4_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
