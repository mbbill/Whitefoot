fn last_written(xs: own Slice<u8>) -> value: own u8 reads(xs) contract {
  define n0 = len_of(xs);
  requires n0 >= 1_u64;
} {
  let n = len_of(xs);
  let idx = 0_u64;
  for (i in 0_u64..n) {
    let cur = xs[i];
    let nonzero = cur != 0_u8;
    if nonzero {
      set idx = i;
    }
  }
  return xs[idx];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
