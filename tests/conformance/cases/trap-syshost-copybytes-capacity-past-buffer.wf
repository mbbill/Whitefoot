command fn main(command.args as args: own Args) -> status: own ExitStatus allocates(heap), traps {
  doc "SYS-8: the third range failure. The offset is inside the buffer and the sum does not overflow, but the range extends past the buffer's runtime length, which traps before any host transfer exactly as the other two do.";
  let bytes = buffer_new(4_u64, 0_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_bytes<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, offset: 2_u64, capacity: 4_u64) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                return exit_status(code: 11_u8);
              }
            }
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 12_u8);
      }
    }
  }
}
