formal Disposer {
  fn release(factory: &uniq HandleFactory, file: own ReadFile) -> function_result: own unit pure;
}

actual First : Disposer {
  release = release_read_file;
}

fn release_read_file(factory: &uniq HandleFactory, file: own ReadFile) -> function_result: own unit reads(factory, file), writes(factory, file) {
  doc "FN-4: the explicit ordinary close has effects exceeding the formal's pure row. No implicit finalizer supplies the difference.";
  region {
    let closed = close_read(factory: &uniq deref(factory), file: move file);
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
