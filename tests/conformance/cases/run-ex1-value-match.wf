enum Sign {
  Neg();
  Zero();
  Pos();
}

fn sign_of(x: own i32) -> function_result: own Sign pure {
  doc "Conditional value produced by returning from arms (return-position match).";
  if ilt(x, 0_i32) {
    return Neg();
  } else if ieq(x, 0_i32) {
    return Zero();
  } else {
    return Pos();
  }
}

command fn main() -> status: own ExitStatus traps {
  doc "let-initializer match with give, named construction, named user-fn call.";
  let a = 40_i32;
  region 'r {
    let p = &'r a;
    let v = match deref(p) +checked 2_i32 {
      Ok(value: w) => {
        give w;
      }
      Err(error: e) => {
        return exit_status(code: 0_u8);
      }
    }
    claim arithmetic_drift: ieq(v, 42_i32) because "arithmetic drift";
    let sg = sign_of(x: v);
    match sg {
      Neg() => {
        return exit_status(code: 0_u8);
      }
      Zero() => {
        return exit_status(code: 0_u8);
      }
      Pos() => {
        claim sign_drift: ieq(v, 42_i32) because "sign drift";
      }
    }
  }
  return exit_status(code: 0_u8);
}
