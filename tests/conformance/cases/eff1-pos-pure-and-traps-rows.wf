fn inc(x: own i32) -> result: own i32 pure {
  doc "Empty-row `pure` spelling [EFF-1].";
  return x +wrap 1_i32;
}

command fn main() -> status: own ExitStatus traps {
  doc "Canonical effect rows: `pure` (empty row) and `traps`; the latter retains one same-function arithmetic residual and its exact consumer [EFF-1, CLM-1, CLM-2].";
  let a = inc(x: 41_i32);
  let left_seed = 10_i32;
  let right_seed = 1_i32;
  let left = left_seed % 11_i32;
  let right = right_seed % 2_i32;
  let addition_defined = left +defined right;
  claim drift: addition_defined because "premises: left and right are same-function signed remainders by 11_i32 and 2_i32 respectively\nderivation: left is between -10_i32 and 10_i32 and right is between -1_i32 and 1_i32, so their sum is between -11_i32 and 11_i32 and is representable as i32\nconclusion: left +defined right is true\nchecker gap: ENT proves both remainder operation domains but does not publish either result range\nconsumers: the following exact addition requires both signed sum bounds";
  let next = left + right;
  return exit_status(code: 0_u8);
}
