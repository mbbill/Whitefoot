command fn main(command.args as args: own Args) -> status: own ExitStatus allocates(heap), traps {
  region 'arguments {
    let position = args_count<'arguments>(args: &'arguments args);
    let values = buffer_new(4_u64, 0_u8);
    let room = len(values);
    let inside = ilt(position, room);
    claim reviewed_position: inside because "premises: position is the result returned by args_count and room is four\nderivation: this fixture deliberately asserts that the environment supplied fewer than four arguments\nconclusion: ilt(position, room) is true\nchecker gap: a claim cannot invent an unstated property of a system-call result\nconsumers: the following values[position] subscript would otherwise consume this system-result assertion";
    let selected = values[position];
  }
  return exit_status(code: 0_u8);
}
