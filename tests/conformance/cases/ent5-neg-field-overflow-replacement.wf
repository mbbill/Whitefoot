struct Cell {
  v: u8;
}

fn h(b: own Cell, w: own u8) -> result: own u8 pure contract {
  requires b.v <= 5_u8;
} {
  doc "The entering bound names the old Cell.v image. Replacing that own field with an arbitrary byte cannot make its later addition representable [ENT-5, OP-2].";
  set b.v = w;
  let z = b.v + 250_u8;
  return z;
}

fn main() -> status: own ExitStatus pure {
  doc "No construction is needed to exercise the field kill.";
  return exit_status(code: 0_u8);
}
