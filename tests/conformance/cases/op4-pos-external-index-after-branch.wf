command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args) {
  region {
    let index = args_count(args: &args);
    let empty = fixed_vector::<u8, 4>();
    let one = place_back(vector: move empty, value: 0_u8);
    let two = place_back(vector: move one, value: 0_u8);
    let three = place_back(vector: move two, value: 0_u8);
    let bytes = place_back(vector: move three, value: 0_u8);
    let spare = len_of(bytes);
    if index < spare {
      let value = bytes[index];
      return exit_status(code: value);
    } else {
      return exit_status(code: 0_u8);
    }
  }
}
