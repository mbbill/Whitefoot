command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.stderr as err: own Output) -> own ExitStatus allocates(heap), external, blocks, traps {
  doc "EFF-5 and SYS-12: the standard output and standard error bindings are two separate affine owners, and sequential calls across either owner preserve source order by the ordering rule that governs every external call, not by any aliasing analysis. Redirection may make the two owners one sink; the program reads that sink back through its own directory capability, so the combined bytes witness the order.";
  let first: own buffer<u8> = buffer_new<u8>(2_u64, 65_u8);
  let second: own buffer<u8> = buffer_new<u8>(2_u64, 66_u8);
  let page: own buffer<u8> = buffer_new<u8>(8_u64, 0_u8);
  region 'o {
    region 's {
      match write_once<'o, 's>(output: &uniq 'o out, source: &'s first, offset: 0_u64, count: 2_u64) {
        Ok(value: written) => {
        }
        Err(error: problem) => {
          return exit_status(code: 10_u8);
        }
      }
    }
  }
  region 'e {
    region 't {
      match write_once<'e, 't>(output: &uniq 'e err, source: &'t second, offset: 0_u64, count: 2_u64) {
        Ok(value: written) => {
        }
        Err(error: problem) => {
          return exit_status(code: 11_u8);
        }
      }
    }
  }
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region 'c {
              region 'p {
                match open_read<'c, 'p>(root: &'c cwd, path: &'p path) {
                  Ok(value: file) => {
                    region 'f {
                      region 'd {
                        match read_once<'f, 'd>(file: &uniq 'f file, destination: &uniq 'd page, offset: 0_u64, capacity: 8_u64) {
                          ReadBytes(count: n) => {
                            let combined: own Bool = ieq<u64>(n, 4_u64);
                            match combined {
                              True() => {
                              }
                              False() => {
                                return exit_status(code: 12_u8);
                              }
                            }
                          }
                          ReadEnd() => {
                            return exit_status(code: 13_u8);
                          }
                          ReadFailed(error: problem) => {
                            return exit_status(code: 14_u8);
                          }
                        }
                      }
                    }
                    let byte0: own u8 = page[0_u64];
                    let byte1: own u8 = page[1_u64];
                    let byte2: own u8 = page[2_u64];
                    let byte3: own u8 = page[3_u64];
                    let head0: own Bool = ieq<u8>(byte0, 65_u8);
                    match head0 {
                      True() => {
                      }
                      False() => {
                        return exit_status(code: 15_u8);
                      }
                    }
                    let head1: own Bool = ieq<u8>(byte1, 65_u8);
                    match head1 {
                      True() => {
                      }
                      False() => {
                        return exit_status(code: 16_u8);
                      }
                    }
                    let tail0: own Bool = ieq<u8>(byte2, 66_u8);
                    match tail0 {
                      True() => {
                      }
                      False() => {
                        return exit_status(code: 17_u8);
                      }
                    }
                    let tail1: own Bool = ieq<u8>(byte3, 66_u8);
                    match tail1 {
                      True() => {
                        return exit_status(code: 0_u8);
                      }
                      False() => {
                        return exit_status(code: 18_u8);
                      }
                    }
                  }
                  Err(error: problem) => {
                    return exit_status(code: 19_u8);
                  }
                }
              }
            }
          }
          Err(error: rejected) => {
            return exit_status(code: 20_u8);
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 21_u8);
      }
    }
  }
}
