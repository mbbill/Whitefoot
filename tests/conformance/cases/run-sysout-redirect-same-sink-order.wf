fn exercise['heap](args: &Args, cwd: &DirectoryRead, out: &uniq OutputStream, err: &uniq OutputStream, files: &uniq HandleFactory, heap: &uniq Heap<'heap>) -> status: own ExitStatus reads(args, cwd, out, err, files, heap), writes(out, err, files, heap), allocates(heap) {
  doc "Output calls and the later file read explicitly borrow the same HandleFactory state. Ordinary EFF-2/PAR-1 interference preserves the arranged shared sink order, including independently named aliased output streams; the readback observes the combined bytes.";
  let first = fixed_vector::<u8, 2>();
  region {
    place_back(vector: &uniq first, value: 65_u8);
  }
  region {
    place_back(vector: &uniq first, value: 65_u8);
  }
  let second = fixed_vector::<u8, 2>();
  region {
    place_back(vector: &uniq second, value: 66_u8);
  }
  region {
    place_back(vector: &uniq second, value: 66_u8);
  }
  region {
    match heap_vector::<u8>(store: &uniq deref(heap), count: 8_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let page = move fresh;
        for @scratch (
          at in 0_u64..8_u64,
          invariant grown: len_of(page) >= at,
          invariant spare: room_of(page) + at >= 8_u64,
          invariant flat: head_of(page) <= 0_u64
        ) {
          place_back(vector: &uniq page, value: 0_u8);
        }
        region {
          let head = slice_of(&first);
          region {
            match write_once(factory: &uniq deref(files), output: &uniq deref(out), source: &head, start: 0_u64, end: 2_u64) {
              Ok(value: written) => {
              }
              Err(error: problem) => {
                return exit_status(code: 10_u8);
              }
            }
          }
        }
        region {
          let tail = slice_of(&second);
          region {
            match write_once(factory: &uniq deref(files), output: &uniq deref(err), source: &tail, start: 0_u64, end: 2_u64) {
              Ok(value: written) => {
              }
              Err(error: problem) => {
                return exit_status(code: 11_u8);
              }
            }
          }
        }
        region {
          match arg_get(args: args, position: 1_u64) {
            Ok(value: text) => {
              match relative_path(value: move text) {
                Ok(value: path) => {
                  region {
                    region {
                      match open_read(factory: &uniq deref(files), root: cwd, path: &path) {
                        FileOpened(value: file) => {
                          region {
                            region {
                              let window = mut_slice_of(&uniq page);
                              region {
                                match read_at(factory: &uniq deref(files), file: &uniq file, destination: &uniq window, file_offset: 0_u64, start: 0_u64, end: 8_u64) {
                                  Ok(value: n) => {
                                    let combined = n == 4_u64;
                                    if combined {
                                    } else {
                                      close_read(factory: &uniq deref(files), file: move file);
                                      return exit_status(code: 12_u8);
                                    }
                                  }
                                  Err(error: read_stop_32) => {
                                    match read_stop_32 {
                                      ReadEnd() => {
                                        close_read(factory: &uniq deref(files), file: move file);
                                        return exit_status(code: 13_u8);
                                      }
                                      ReadFailed(error: problem) => {
                                        close_read(factory: &uniq deref(files), file: move file);
                                        return exit_status(code: 14_u8);
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                          let byte0 = page[0_u64];
                          let byte1 = page[1_u64];
                          let byte2 = page[2_u64];
                          let byte3 = page[3_u64];
                          let head0 = byte0 == 65_u8;
                          if head0 {
                          } else {
                            close_read(factory: &uniq deref(files), file: move file);
                            return exit_status(code: 15_u8);
                          }
                          let head1 = byte1 == 65_u8;
                          if head1 {
                          } else {
                            close_read(factory: &uniq deref(files), file: move file);
                            return exit_status(code: 16_u8);
                          }
                          let tail0 = byte2 == 66_u8;
                          if tail0 {
                          } else {
                            close_read(factory: &uniq deref(files), file: move file);
                            return exit_status(code: 17_u8);
                          }
                          let tail1 = byte3 == 66_u8;
                          if tail1 {
                            close_read(factory: &uniq deref(files), file: move file);
                            return exit_status(code: 0_u8);
                          } else {
                            close_read(factory: &uniq deref(files), file: move file);
                            return exit_status(code: 18_u8);
                          }
                        }
                        FileOpenFailed(error: problem) => {
                          return exit_status(code: 19_u8);
                        }
                      }
                    }
                  }
                }
                Err(error: rejected) => {
                  return exit_status(code: 20_u8);
                }
              }
            }
            Err(error: absent) => {
              return exit_status(code: 21_u8);
            }
          }
        }
      }
    }
  }
}

fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, out: &uniq out, err: &uniq err, files: &uniq files, heap: &uniq heap);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
