enum Sign {
  Neg(mag: i32);
  Zero();
  Pos();
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-11: a binding declared outside a loop may not be moved inside it.";
  let s = Pos();
  loop @l {
    match s {
      Neg(mag: m) => {
      }
      Zero() => {
      }
      Pos() => {
      }
    }
    break @l;
  }
  return exit_status(code: 0_u8);
}
