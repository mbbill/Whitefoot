struct Resource {
  id: u64;
  data0: u64;
  data1: u64;
  data2: u64;
  data3: u64;
}

enum Slot['s] {
  Vacant();
  Deleted();
  Occupied(fingerprint: u8, key: u64, payload: Box<'s, Resource>);
}

enum Probe {
  Stop();
  Skip();
  Miss();
  Match();
}

enum PutOutcome['s] {
  Inserted();
  Replaced(previous: Box<'s, Resource>);
  Full(offered: Box<'s, Resource>);
  AllocationRefused();
}

fn fingerprint(key: own u64) -> result: own u8 pure {
  let tag = 0_u8;
  let bit0 = iand(key, 1_u64);
  if bit0 != 0_u64 {
    set tag = ior(tag, 1_u8);
  }
  let bit1 = iand(key, 2_u64);
  if bit1 != 0_u64 {
    set tag = ior(tag, 2_u8);
  }
  let bit2 = iand(key, 4_u64);
  if bit2 != 0_u64 {
    set tag = ior(tag, 4_u8);
  }
  let bit3 = iand(key, 8_u64);
  if bit3 != 0_u64 {
    set tag = ior(tag, 8_u8);
  }
  let bit4 = iand(key, 16_u64);
  if bit4 != 0_u64 {
    set tag = ior(tag, 16_u8);
  }
  let bit5 = iand(key, 32_u64);
  if bit5 != 0_u64 {
    set tag = ior(tag, 32_u8);
  }
  let bit6 = iand(key, 64_u64);
  if bit6 != 0_u64 {
    set tag = ior(tag, 64_u8);
  }
  return tag;
}

fn probe_index(home: own u64, step: own u64, count: own u64) -> index: own u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  let until_end = count - home;
  if step >= until_end {
    let wrapped = step - until_end;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn probe['s](slot: &Slot<'s>, key: own u64) -> result: own Probe reads(slot) {
  match deref(slot) {
    Vacant() => {
      return Stop();
    }
    Deleted() => {
      return Skip();
    }
    Occupied(fingerprint: saved, key: present, payload: owner) => {
      if deref(present) == key {
        return Match();
      }
      return Miss();
    }
  }
}

fn fill_slots['s](slots: &uniq Vector<'s, Slot<'s>>, count: own u64) -> result: own unit reads(slots), writes(slots) contract {
  requires len_of(deref(slots)) == 0_u64;
  requires head_of(deref(slots)) <= 0_u64;
  requires room_of(deref(slots)) >= count;
  ensures len_of(deref(slots)) == count;
  ensures head_of(deref(slots)) <= 0_u64;
} {
  for (
    index in 0_u64..count,
    invariant filled: len_of(deref(slots)) >= index,
    invariant bounded: len_of(deref(slots)) <= index,
    invariant spare: room_of(deref(slots)) + index >= count,
    invariant flat: head_of(deref(slots)) <= 0_u64
  ) {
    let vacant = Vacant<'s>();
    region {
      place_back(vector: &uniq deref(slots), value: move vacant);
    }
  }
  invariant complete_min: len_of(deref(slots)) >= count;
  invariant complete_max: len_of(deref(slots)) <= count;
  return unit;
}

fn put['s](slots: &uniq Vector<'s, Slot<'s>>, key: own u64, payload: own Box<'s, Resource>) -> outcome: own PutOutcome<'s> reads(slots), writes(slots) contract {
  ensures len_of(deref(slots)) == len_of(deref(entry(slots)));
  ensures head_of(deref(slots)) == head_of(deref(entry(slots)));
} {
  let count = len_of(deref(slots));
  let first_deleted = count;
  for (step in 0_u64..count) {
    let home = key % count;
    let index = probe_index(home: home, step: step, count: count);
    region {
      let action = probe(slot: &deref(slots)[index], key: key);
      match action {
        Match() => {
          let tag = fingerprint(key: key);
          let replacement = Occupied(fingerprint: tag, key: key, payload: move payload);
          let previous = replace deref(slots)[index] = move replacement;
          match move previous {
            Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
              return Replaced(previous: move old_payload);
            }
            Vacant() => {
              return Inserted<'s>();
            }
            Deleted() => {
              return Inserted<'s>();
            }
          }
        }
        Skip() => {
          if first_deleted == count {
            set first_deleted = index;
          }
        }
        Stop() => {
          let destination = index;
          if first_deleted < count {
            set destination = first_deleted;
          }
          let tag = fingerprint(key: key);
          let replacement = Occupied(fingerprint: tag, key: key, payload: move payload);
          let previous = replace deref(slots)[destination] = move replacement;
          match move previous {
            Vacant() => {
              return Inserted<'s>();
            }
            Deleted() => {
              return Inserted<'s>();
            }
            Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
              return Replaced(previous: move old_payload);
            }
          }
        }
        Miss() => {
        }
      }
    }
  }
  if first_deleted < count {
    let tag = fingerprint(key: key);
    let replacement = Occupied(fingerprint: tag, key: key, payload: move payload);
    let previous = replace deref(slots)[first_deleted] = move replacement;
    match move previous {
      Vacant() => {
        return Inserted<'s>();
      }
      Deleted() => {
        return Inserted<'s>();
      }
      Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
        return Replaced(previous: move old_payload);
      }
    }
  }
  return Full(offered: move payload);
}

fn allocate_put['s](store: &uniq Heap<'s>, slots: &uniq Vector<'s, Slot<'s>>, key: own u64, id: own u64) -> outcome: own PutOutcome<'s> reads(store, slots), writes(store, slots), allocates(store) contract {
  ensures len_of(deref(slots)) == len_of(deref(entry(slots)));
  ensures head_of(deref(slots)) == head_of(deref(entry(slots)));
} {
  let data0 = id *wrap 17_u64;
  let data1 = data0 +wrap 1_u64;
  let data2 = data0 +wrap 2_u64;
  let data3 = data0 +wrap 3_u64;
  let resource = Resource(id: id, data0: data0, data1: data1, data2: data2, data3: data3);
  region {
    match heap_box(store: &uniq deref(store), value: move resource) {
      Err(error: back) => {
        return AllocationRefused<'s>();
      }
      Ok(value: owner) => {
        let result = put(slots: &uniq deref(slots), key: key, payload: move owner);
        return move result;
      }
    }
  }
}

fn check_put['s](store: &uniq Heap<'s>, outcome: own PutOutcome<'s>, kind: own u64, expected: own u64) -> code: own u8 reads(outcome), writes(store) {
  match move outcome {
    Inserted() => {
      if kind != 1_u64 {
        return 1_u8;
      }
      return 0_u8;
    }
    Replaced(previous: old) => {
      if kind != 2_u64 {
        return 2_u8;
      }
      if deref(old).id != expected {
        return 3_u8;
      }
      return 0_u8;
    }
    Full(offered: back) => {
      if kind != 3_u64 {
        return 4_u8;
      }
      if deref(back).id != expected {
        return 5_u8;
      }
      return 0_u8;
    }
    AllocationRefused() => {
      return 70_u8;
    }
  }
}

fn exercise['s](store: &uniq Heap<'s>) -> status: own ExitStatus reads(store), writes(store), allocates(store) {
  region {
    match heap_vector::<Slot<'s>>(store: &uniq deref(store), count: 2_u64) {
      None() => {
        return exit_status(code: 0_u8);
      }
      Some(value: slots) => {
        region {
          fill_slots(slots: &uniq slots, count: 2_u64);
          let outcome0 = allocate_put(store: &uniq deref(store), slots: &uniq slots, key: 1_u64, id: 11_u64);
          let checked0 = check_put(store: &uniq deref(store), outcome: move outcome0, kind: 1_u64, expected: 0_u64);
          if checked0 == 70_u8 {
            return exit_status(code: 0_u8);
          }
          if checked0 != 0_u8 {
            return exit_status(code: 1_u8);
          }
          invariant preserved0_min: len_of(slots) >= 2_u64;
          invariant preserved0_max: len_of(slots) <= 2_u64;
          let outcome1 = allocate_put(store: &uniq deref(store), slots: &uniq slots, key: 3_u64, id: 22_u64);
          let checked1 = check_put(store: &uniq deref(store), outcome: move outcome1, kind: 1_u64, expected: 0_u64);
          if checked1 == 70_u8 {
            return exit_status(code: 0_u8);
          }
          if checked1 != 0_u8 {
            return exit_status(code: 2_u8);
          }
          invariant preserved1_min: len_of(slots) >= 2_u64;
          invariant preserved1_max: len_of(slots) <= 2_u64;
          let outcome2 = allocate_put(store: &uniq deref(store), slots: &uniq slots, key: 1_u64, id: 33_u64);
          let checked2 = check_put(store: &uniq deref(store), outcome: move outcome2, kind: 2_u64, expected: 11_u64);
          if checked2 == 70_u8 {
            return exit_status(code: 0_u8);
          }
          if checked2 != 0_u8 {
            return exit_status(code: 3_u8);
          }
          invariant preserved2_min: len_of(slots) >= 2_u64;
          invariant preserved2_max: len_of(slots) <= 2_u64;
          return exit_status(code: 0_u8);
        }
      }
    }
  }
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  region {
    return exercise(store: &uniq heap);
  }
}
