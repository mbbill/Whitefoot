fn selected(value: own i32) -> result: own Result<i32, Overflow> pure contract {
  ensures when Ok(value: result): ieq(result, value);
} {
  return Ok<i32, Overflow>(value: value);
}

fn guard(left: own i32, right: own i32) -> result: own unit pure contract {
  requires ieq(left, right);
} {
  return unit;
}

fn named(value: own i32) -> result: own unit pure {
  let outcome = selected(value: value);
  match outcome {
    Ok(value: payload) => {
      guard(left: payload, right: value);
    }
    Err(error: problem) => {
    }
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
