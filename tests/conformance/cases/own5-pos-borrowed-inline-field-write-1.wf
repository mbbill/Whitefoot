struct Row {
  left: u64;
  right: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "A write of one field invalidates no reference to its disjoint sibling: the two field selections never overlap, so the live reference is still valid at its later read.";
  let seed = Row(left: 3_u64, right: 4_u64);
  let rows = array_filled::<Row, 4>(value: seed);
  let saved = &rows[0_u64].left;
  set rows[0_u64].right = 9_u64;
  let observed = saved;
  return exit_status(code: 0_u8);
}
