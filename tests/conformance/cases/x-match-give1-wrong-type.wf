enum Choice {
  First();
  Second();
}

fn main() -> own unit pure {
  doc "A binder's mode and type are derived by agreement over the closed delivery set, so two arms delivering different types are rejected at the later give [GIVE-1].";
  let c = First();
  let v = match c {
    First() => {
      give 1_i32;
    }
    Second() => {
      give True();
    }
  }
  return unit;
}
