fn endpoint(value: own u64) -> result: own u64 pure {
  return imin(value, 2_u64);
}

fn read(values: own array<u8, 4>, input: own u64) -> result: own u8 traps {
  let upper = endpoint(value: input);
  let cursor = 0_u64;
  for @steps step in 0_u64..upper {
    set cursor = 1_u64;
  }
  claim reviewed_carried: ilt(cursor, 4_u64) because "premises: cursor is either the literal 0_u64 written before the loop or the literal 1_u64 an iteration wrote\nderivation: both literals are below 4_u64, so cursor is below 4_u64 whichever definition reached this point\nconclusion: ilt(cursor, 4_u64) is true\nchecker gap: the loop endpoint is a call result and it chose between two different reaching definitions of cursor, so CLM-1 must refuse the claim\nconsumers: the following values[cursor] subscript would otherwise consume this assertion";
  return values[cursor];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
