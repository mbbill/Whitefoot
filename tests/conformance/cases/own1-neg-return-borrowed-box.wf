enum State {
  Ready();
}

fn steal['heap](holder: &Box<'heap, State>) -> return_value: own Box<'heap, State> pure {
  doc "OWN-1: one dereference exposes the borrowed box value, which remains non-owning even though State is Copy.";
  return deref(holder);
}

fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
