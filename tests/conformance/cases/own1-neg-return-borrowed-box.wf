enum State {
  Ready();
}

fn steal['r](holder: &'r box<State>) -> return_value: own box<State> pure {
  doc "OWN-1: one dereference exposes the borrowed box value, which remains non-owning even though State is Copy.";
  return deref(holder);
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
