fn fill(destination: &uniq MutSlice<u8>, value: own u8) -> result: own unit writes(destination) contract {
  requires 2_u64 <= len_of(deref(destination));
} {
  doc "Writes two elements through the view it was handed.";
  set deref(destination)[0_u64] = value;
  set deref(destination)[1_u64] = value;
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "The writer forms two exclusive views of one run and hands one to each member of a two-call window, so both members would write one storage. The program never reaches a permission judgment: a view holds an exclusive loan on the range it was formed over [VIEW-1], and two exclusive loans on one range are what [OWN-5] refuses, so the second formation is the rejection. What [PAR-1] would have said about the pair, that one written footprint overlaps the other's with both resolved to `run`, is the same fact one rule earlier.";
  region 'a {
    let workspace = arena_frame::<8, 1, 'a>();
    region {
      let run = arena_vector_proved::<u8>(store: &uniq workspace, count: 2_u64);
      for @prime (
        at in 0_u64..2_u64,
        invariant grown: len_of(run) >= at,
        invariant spare: room_of(run) + at >= 2_u64,
        invariant flat: head_of(run) <= 0_u64
      ) {
        set run = place_back(vector: move run, value: 0_u8);
      }
      region {
        let first_window = mut_slice_of(&uniq run);
        let second_window = mut_slice_of(&uniq run);
        region {
          let wrote_first = fill(destination: &uniq first_window, value: 3_u8);
          let wrote_second = fill(destination: &uniq second_window, value: 5_u8);
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
