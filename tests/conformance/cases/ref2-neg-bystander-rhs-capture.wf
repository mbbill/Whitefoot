struct BystanderRecord {
  value: u8;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}

fn replace_bystander_index(index: &u64, replacement: own u64) -> result: own BystanderRecord writes(index) {
  set deref(index) = replacement;
  return BystanderRecord(value: 9_u8);
}

fn inspect_rhs_capture(values: &Array<BystanderRecord, 4>) -> result: own u8 writes(values) {
  let selected = &deref(values)[0_u64].value;
  let index = 0_u64;
  set deref(values)[index] = replace_bystander_index(index: &index, replacement: 1_u64);
  return deref(selected);
}
