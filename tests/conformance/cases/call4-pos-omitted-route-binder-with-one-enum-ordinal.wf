fn filled<T: copy, const n: u64>(value: own T) -> result: own Slots<T, n> pure contract {
  ensures result.len == n;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let block = array_filled::<T, n>(value: value);
  let built = slots_from_array::<T, n>(values: move block);
  return move built;
}

fn probe(taken: own Slots<u8, 8>) -> (outcome: own Result<u64, Overflow>, spare: own u64) pure contract {
  ensures when Ok(value: reported): reported == taken.len;
} {
  doc "Exactly one ordinal has the route's enum type, so the ordinal binder is omitted.";
  let measured = taken.len;
  return Ok<u64, Overflow>(value: measured), measured;
}

fn main() -> status: own ExitStatus pure {
  doc "A route omits its ordinal binder where exactly one declared result ordinal has the route's enum type. That is the one case the omission is admitted in, and it is what keeps a single-result declaration writing no ordinal binder.";
  let run = filled::<u8, 8>(value: 0_u8);
  let (outcome, spare) = probe(taken: move run);
  match outcome {
    Ok(value: reported) => {
      return exit_status(code: 0_u8);
    }
    Err(error: failure) => {
      return exit_status(code: 1_u8);
    }
  }
}
