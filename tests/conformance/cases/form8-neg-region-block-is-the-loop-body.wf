command fn main() -> return_value: own ExitStatus pure {
  doc "FORM-8: a region block that is a loop body's only statement restates the region that body already introduces.";
  let a = 0_i32;
  for @scan (step in 0_u64..2_u64) {
    region {
      let p = &a;
      if deref(p) == 0_i32 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
