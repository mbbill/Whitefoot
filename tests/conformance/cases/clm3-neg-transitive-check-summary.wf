fn checked_leaf(values: own array<u8, 4>, index: own u64) -> result: own u8 traps {
  let room = len(values);
  let bounded = index % 4_u64;
  let inside = ilt(bounded, room);
  claim checked_leaf: inside because "premises: values has length 4 and bounded is the remainder of the current function parameter index divided by 4_u64\nderivation: unsigned remainder by four is one of 0_u64 through 3_u64 and is therefore strictly less than room\nconclusion: ilt(bounded, room) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following values[bounded] subscript requires this exact bound";
  return values[bounded];
}

deny_claims fn strict_root(values: own array<u8, 4>, index: own u64) -> result: own u8 traps {
  let selected = checked_leaf(values: move values, index: index);
  return selected;
}

command fn main() -> status: own ExitStatus traps {
  let values = array_new<u8, 4>(7_u8);
  let selected = strict_root(values: move values, index: 0_u64);
  return exit_status(code: 0_u8);
}
