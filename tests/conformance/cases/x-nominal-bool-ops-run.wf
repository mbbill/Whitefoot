command fn main() -> status: own ExitStatus traps {
  doc "Exercise every Boolean table operation through normal source compilation and host execution [OP-1, OP-8].";
  let yes = True();
  let no = False();
  let both = band(yes, no);
  let not_both = bnot(both);
  claim band_drift: not_both because "band drift";
  let either = bor(no, yes);
  claim bor_drift: either because "bor drift";
  let different = bxor(yes, no);
  claim bxor_off_diagonal_drift: different because "bxor off-diagonal drift";
  let same = bxor(yes, yes);
  let not_same = bnot(same);
  claim bxor_diagonal_drift: not_same because "bxor diagonal drift";
  return exit_status(code: 0_u8);
}
