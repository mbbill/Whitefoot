fn pass_slice['r](value: own slice<'r, u8>) -> result: own slice<'r, u8> pure {
  return move value;
}

fn choose_slice['r](take_left: own Bool, left: own slice<'r, u8>, right: own slice<'r, u8>) -> result: own slice<'r, u8> pure {
  if take_left {
    return move left;
  } else {
    return move right;
  }
}

command fn main() -> status: own ExitStatus pure {
  let left = array_new::<u8, 2>(11_u8);
  let right = array_new::<u8, 2>(29_u8);
  region {
    let pass_source = slice_of(&left);
    let passed = pass_slice(value: move pass_source);
    let passed_room = len_of(passed);
    let passed_ok = 0_u64 < passed_room;
    if passed_ok {
    } else {
      return exit_status(code: 211_u8);
    }
    let passed_value = passed[0_u64];
    if passed_value == 11_u8 {
    } else {
      return exit_status(code: 201_u8);
    }
    let left_source = slice_of(&left);
    let right_source = slice_of(&right);
    let take_left = False();
    let selected = choose_slice(take_left: take_left, left: move left_source, right: move right_source);
    let selected_room = len_of(selected);
    let selected_ok = 0_u64 < selected_room;
    if selected_ok {
    } else {
      return exit_status(code: 212_u8);
    }
    let selected_value = selected[0_u64];
    if selected_value == 29_u8 {
    } else {
      return exit_status(code: 202_u8);
    }
  }
  return exit_status(code: 0_u8);
}
