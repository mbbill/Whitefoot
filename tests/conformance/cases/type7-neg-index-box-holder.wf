fn read['heap](holder: own Box<'heap, FixedVector<u8, 4>>) -> function_result: own u8 pure {
  doc "TYPE-7: a subscript cannot implicitly read through a cell holder; write deref(holder)[offset].";
  return holder[0_u64];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
