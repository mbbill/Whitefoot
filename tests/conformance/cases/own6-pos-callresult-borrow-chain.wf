fn passthru['r0](x: &uniq 'r0 i32) -> return_value: &uniq 'r0 i32 pure {
  return &uniq 'r0 deref(x);
}

fn bump(n: &uniq i32) -> return_value: own unit writes(n) {
  set deref(n) = 42_i32;
  return unit;
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-6 reborrow extension: `passthru` determines one provenance-candidate parameter, so binding its borrow-mode result makes `r` an ordinary borrow holder whose resolved place is the candidate actual's. The child fed to it in candidate position may take a caller-supplied region, and `r` is itself reborrowable, composing a grandchild chain of depth two. Creating the candidate-position child suspends `h` for the remainder of its life, so no point sees two usable uniq paths to `v`.";
  let v = 1_i32;
  region {
    let h = &uniq v;
    let r = passthru(x: &uniq deref(h));
    region {
      bump(n: &uniq deref(r));
    }
  }
  if v == 42_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
