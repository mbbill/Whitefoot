enum Color {
  Red();
  Green();
  Blue();
}

fn pick(c: own Color) -> result: own i32 pure {
  match c {
    Red() => {
      return 1_i32;
    }
    Green() => {
      return 2_i32;
    }
    Blue() => {
      return 3_i32;
    }
  }
}

command fn main() -> status: own ExitStatus traps {
  doc "An exhaustive match over all declared variants is accepted [ERR-2].";
  let green_atom_0001 = Green();
  let n = pick(c: green_atom_0001);
  claim x: ieq(n, 2_i32) because "x";
  return exit_status(code: 0_u8);
}
