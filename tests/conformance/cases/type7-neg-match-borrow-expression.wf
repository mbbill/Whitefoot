enum State {
  Ready();
}

command fn main() -> status: own ExitStatus pure {
  doc "TYPE-7: a borrow expression is a reference value, not an enum value; bind it and match deref(holder).";
  let state = Ready();
  region 'r {
    match &'r state {
      Ready() => {
        set state = Ready();
      }
    }
  }
  return exit_status(code: 0_u8);
}
