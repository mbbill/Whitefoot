command fn main() -> status: own ExitStatus allocates(heap) {
  let table = buffer_new(4_u64, 7_u8);
  region {
    let writer = mut_slice_of(&uniq table);
    let reader = slice_of(&table);
    set writer[0_u64] = 9_u8;
    let seen = reader[0_u64];
    if seen == 7_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
