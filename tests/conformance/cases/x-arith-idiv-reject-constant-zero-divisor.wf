command fn main() -> status: own ExitStatus pure {
  doc "A signed bare `/` with one constant operand is in the divisor class [OP-2], so it carries the division obligation instead of a runtime test [ENT-6]. The constant divisor is zero, a ground false conjunct rejected at every non-contradictory point: there is no accepted always-trapping bare spelling, and what was a runtime abort here is now a compile-time rejection.";
  let x = 10_i32;
  let q = x / 0_i32;
  return exit_status(code: 0_u8);
}
