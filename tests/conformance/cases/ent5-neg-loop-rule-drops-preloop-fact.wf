fn get(b: own buffer<u8>, start: own u64) -> result: own u8 reads(b) {
  doc "Loops carry no induction: the fact state at each iteration front removes every fact a continuing kill event may kill [ENT-5]. The `set` later in the body kills the branch-established bound and an else-free false edge can carry that kill to the next front, so the subscript is undischarged [OP-4] even on the first iteration, where the checked branch still dominates it.";
  let spare = len(b);
  let offset = 0_u64;
  let inside = offset < spare;
  if inside {
  } else {
    return 0_u8;
  }
  let sample = 0_u8;
  loop @walk {
    set sample = b[offset];
    set offset = start;
    if inside {
      break @walk;
    }
  }
  return sample;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
