enum State {
  Ready();
}

fn view['r](state: &'r State) -> function_result: &'r State pure {
  return state;
}

fn inspect['r](state: &'r State) -> function_result: own unit pure {
  doc "TYPE-7: a reference-returning call is still a reference value and cannot be matched without an explicit holder and dereference.";
  match view<'r>(state: state) {
    Ready() => {
    }
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
