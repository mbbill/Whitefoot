enum State {
  Ready();
}

fn make() -> result: own Box<State> pure {
  doc "Hands back the cell itself, references never being returned [REF-3].";
  let state = Ready();
  let cell = box_new::<State>(value: state);
  return move cell;
}

fn inspect() -> function_result: own unit pure {
  doc "TYPE-7: a cell-returning call yields an owned holder temporary, not the enclosed enum, so it cannot be matched directly; the result must be bound and reached with deref(holder).";
  match make() {
    Ready() => {
    }
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
