enum Inner {
  InnerValue();
}

enum Outer {
  OuterValue(value: Inner);
}

command fn main () -> return_value: own ExitStatus pure {
  doc "GRAM-9: a constructor in a constructor-field atom position does not derive; bind the inner constructed value with a preceding let.";
  let outer = OuterValue(value: InnerValue());
  return exit_status(code: 0_u8);
}
