const values: array<u8, 4> =[10_u8, 20_u8, 30_u8, 40_u8];

command fn main() -> status: own ExitStatus traps {
  doc "The accepted source carries one true, load-bearing residual and runs normally. DIAG-3 runtime failure is covered separately by the compiler's test-only typed-IR fault-injection path on an independently accepted true residual.";
  let injection_false = False();
  let seed = 7_u64;
  let bounded = seed % 4_u64;
  let inside = ilt(bounded, 4_u64);
  claim reviewed_index: inside because "premises: values has length four and bounded is seed remainder 4_u64 computed in this function\nderivation: unsigned remainder by 4_u64 is at most 3_u64 and therefore strictly less than the array length\nconclusion: ilt(bounded, 4_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following values[bounded] subscript requires this exact bound";
  let selected = values[bounded];
  if injection_false {
    return exit_status(code: 1_u8);
  }
  let expected = ieq(selected, 40_u8);
  if expected {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
