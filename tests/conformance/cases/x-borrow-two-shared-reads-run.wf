command fn main() -> status: own ExitStatus traps {
  doc "OWN-5: two shared borrows of one place coexist and are both read - shared reads never conflict.";
  let a = 7_i32;
  region 'r {
    let s1 = &'r a;
    let s2 = &'r a;
    claim eq: ieq(deref(s1), deref(s2)) because "eq";
  }
  return exit_status(code: 0_u8);
}
