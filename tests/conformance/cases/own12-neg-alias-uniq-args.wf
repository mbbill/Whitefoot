fn two['r](a: &uniq 'r i32, b: &uniq 'r i32) -> return_value: own unit pure {
  return unit;
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-12: two &uniq call arguments over the same place alias - rejected.";
  let x = 0_i32;
  region {
    two(a: &uniq x, b: &uniq x);
  }
  return exit_status(code: 0_u8);
}
