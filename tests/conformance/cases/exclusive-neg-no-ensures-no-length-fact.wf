fn push(values: &Slots<u64, 4>, value: own u64) -> result: own unit writes(values.next), writes(values.len) contract {
  requires values.room > 0_u64;
} {
  doc "Declares a write of the window's boundary and publishes no exit relation about it.";
  place_back(window: values, value: value);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "The exact write effect kills the old length facts [ENT-5]; with no ensures the caller obtains no replacement fact from the mere presence of a written reference parameter [CALL-5, FN-9], so the first stated invariant is unproved [INV-1].";
  let values = slots_new::<u64, 4>();
  push(values: &values, value: 7_u64);
  invariant upper: values.len <= 1_u64;
  invariant lower: values.len >= 1_u64;
  let last_taken = take_back(window: &values);
  invariant empty: values.len <= 0_u64;
  return exit_status(code: 0_u8);
}
