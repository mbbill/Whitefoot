fn main() -> status: own ExitStatus pure {
  doc "Reaching Box content is explicit via deref(place) [TYPE-7]; reads 42 back out of the cell and runs to exit 0.";
  let cell = box_new::<i32>(value: 42_i32);
  let v = deref(cell);
  if v == 42_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
