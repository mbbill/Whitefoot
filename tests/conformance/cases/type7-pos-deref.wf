command fn main() -> status: own ExitStatus pure {
  doc "Reading through a reference is explicit via deref(place) [TYPE-7].";
  let a = 42_i32;
  region 'r {
    let p = &'r a;
    let v = deref(p);
    if v == 42_i32 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
