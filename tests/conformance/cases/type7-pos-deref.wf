command fn main() -> status: own ExitStatus traps {
  doc "Reading through a reference is explicit via deref(place) [TYPE-7].";
  let a = 42_i32;
  region 'r {
    let p = &'r a;
    let v = deref(p);
    claim deref_drift: ieq(v, 42_i32) because "deref drift";
  }
  return exit_status(code: 0_u8);
}
