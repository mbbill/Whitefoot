fn filled_slots<const n: u64>(value: own u8) -> result: own Slots<u8, n> pure contract {
  ensures result.len >= n;
  ensures result.room <= 0_u64;
} {
  doc "Fills a window of n slots, stating its own capacity bound as the const generic itself rather than as a bound local.";
  let built = slots_new::<u8, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.room + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn main() -> status: own ExitStatus pure {
  doc "MSR-6: the loop invariant names the const generic directly, which is the fourth position in which a const generic is a value.";
  let bytes = filled_slots::<4>(value: 7_u8);
  let held = bytes.len;
  if held == 4_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
