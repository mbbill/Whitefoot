fn filled<const n: u64>(value: own u8) -> result: own FixedVector<u8, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
} {
  doc "Fills a run of n slots, stating its own capacity bound as the const generic itself rather than as a bound local.";
  let built = fixed_vector::<u8, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

command fn main() -> status: own ExitStatus pure {
  doc "MSR-6: the loop invariant names the const generic directly, which is the fourth position in which a const generic is a value.";
  let bytes = filled::<4>(value: 7_u8);
  let held = len_of(bytes);
  if held == 4_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
