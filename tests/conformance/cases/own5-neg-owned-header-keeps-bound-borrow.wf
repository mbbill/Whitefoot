fn choose(value: &u64) -> result: own Option<u64> pure {
  return Some<u64>(value: 7_u64);
}

command fn main() -> status: own ExitStatus pure {
  let value = 3_u64;
  region {
    let holder = &value;
    match choose(value: holder) {
      None() => {
      }
      Some(value: chosen) => {
        set value = chosen;
        let observed = deref(holder);
      }
    }
  }
  return exit_status(code: 0_u8);
}
