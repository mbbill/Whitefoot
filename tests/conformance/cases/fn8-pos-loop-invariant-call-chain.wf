fn scaled(value: own u64, limit: own u64) -> result: own u64 pure contract {
  requires value <= limit;
  ensures result <= limit;
} {
  return value;
}

fn clamp_walk(count: own u64, limit: own u64) -> final_value: own u64 pure {
  doc "The result binder is no longer spelled `last`, which is reserved from every declaration role [FORM-3, TYPE-10].";
  let cursor = 0_u64;
  for (
    i in 0_u64..count,
    invariant bounded: cursor <= limit
  ) {
    let picked = scaled(value: cursor, limit: limit);
    set cursor = picked;
  }
  return cursor;
}

fn main() -> status: own ExitStatus pure {
  let final_value = clamp_walk(count: 4_u64, limit: 0_u64);
  if final_value == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
