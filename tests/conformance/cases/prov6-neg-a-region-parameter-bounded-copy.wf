nodrop enum Flag {
  On();
  Off();
}

fn main() -> status: own ExitStatus pure {
  doc "PROV-6: the linear modifier is admitted only on a nominal OWN-1 classifies as affine. A tag-only enum is copy, so the obligation the modifier exists to create has no carrier, and the refusal is at the enum_decl itself rather than at any instantiation.";
  return exit_status(code: 0_u8);
}
