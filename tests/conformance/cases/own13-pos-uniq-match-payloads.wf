enum Packet {
  Data(value: i32);
}

fn main() -> own unit pure {
  doc "OWN-13: a local exclusive borrow match derives an &uniq payload binder that reads through its parent provenance.";
  let packet = Data(value: 4_i32);
  region 'r {
    let holder = &uniq 'r packet;
    match deref(holder) {
      Data(value: payload) => {
        let saved = deref(payload);
      }
    }
  }
  return unit;
}
