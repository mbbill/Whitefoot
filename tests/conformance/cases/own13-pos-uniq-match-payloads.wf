enum Packet {
  Data(value: i32);
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-13: a local exclusive borrow match derives an &uniq payload binder that reads through its parent provenance.";
  let packet = Data(value: 4_i32);
  region {
    let holder = &uniq packet;
    match deref(holder) {
      Data(value: payload) => {
        let saved = deref(payload);
      }
    }
  }
  return exit_status(code: 0_u8);
}
