fn positive_divisor(value: own i32) -> result: own i32 pure {
  return imax(value, 1_i32);
}

fn divide(p: own i32, q: own i32) -> result: own i32 pure {
  doc "The claim that establishes an exact division domain is now the sole trap contributor, so a pure row is wrong.";
  let divisor = positive_divisor(value: q);
  let division_defined = p /defined divisor;
  claim division_domain: division_defined because "premises: divisor is returned by positive_divisor, whose body computes imax(q, 1_i32)\nderivation: divisor is at least 1_i32, so it is nonzero and cannot be -1_i32, making signed division defined for every p\nconclusion: p /defined divisor is true\nchecker gap: ENT does not publish the range of an uncontracted user-call result\nconsumers: the following exact signed division requires this complete domain predicate";
  let r = p / divisor;
  return r;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
