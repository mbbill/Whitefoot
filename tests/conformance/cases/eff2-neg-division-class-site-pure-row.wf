fn divide(p: own i32, q: own i32) -> result: own i32 pure {
  doc "The claim that establishes an exact division domain is now the sole trap contributor, so a pure row is wrong.";
  let division_defined = p /defined q;
  claim division_domain: division_defined because "exact division requires its explicit domain";
  let r = p / q;
  return r;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
