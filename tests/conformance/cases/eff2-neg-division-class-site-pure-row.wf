fn divide(p: own i32, q: own i32) -> result: own i32 pure {
  doc "The claim that establishes an exact division domain is now the sole trap contributor, so a pure row is wrong.";
  let residue = q % 2_i32;
  let divisor = residue +wrap 2_i32;
  let division_defined = p /defined divisor;
  claim division_domain: division_defined because "premises: residue is q remainder 2_i32 in the current function and divisor is residue plus 2_i32 with wrapping semantics\nderivation: signed remainder by two is -1_i32, 0_i32, or 1_i32, so divisor is 1_i32 through 3_i32 and signed division by it is defined for every p\nconclusion: p /defined divisor is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range through the wrapping offset\nconsumers: the following exact signed division requires this complete domain predicate";
  let r = p / divisor;
  return r;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
