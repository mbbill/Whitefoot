fn room(a: own u64, b: own u64, limit: own u64) -> result: own u64 pure contract {
  requires a + b <= limit;
  requires a <= 16_u64;
  requires b <= 16_u64;
} {
  let total = b + a;
  let remaining = limit - total;
  return remaining;
}

command fn main() -> status: own ExitStatus pure {
  let value = room(a: 3_u64, b: 5_u64, limit: 11_u64);
  if value != 3_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
