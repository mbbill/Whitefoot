linear enum Ticket {
  Open();
  Closed();
}

command fn main() -> status: own ExitStatus pure {
  doc "PROV-6: the modifier is admitted only on a nominal [OWN-1] classifies as affine. A tag-only enum is copy, so the modifier would mark a value the language duplicates on every use and the obligation could not be discharged once.";
  return exit_status(code: 0_u8);
}
