command fn main() -> status: own ExitStatus pure {
  doc "PROV-6: the operand's root type must not be loan-bearing and its release graph must contain no loan-bearing node. A view owns nothing, contributes no release-graph node, and therefore has no release action of its own to run early.";
  let empty = fixed_vector::<u8, 4>();
  let r1 = place_back(vector: move empty, value: 0_u8);
  let r2 = place_back(vector: move r1, value: 0_u8);
  let r3 = place_back(vector: move r2, value: 0_u8);
  let run = place_back(vector: move r3, value: 0_u8);
  region {
    let window = slice_of(&run);
    dispose window;
  }
  return exit_status(code: 0_u8);
}
