enum State {
  Ready();
  Done();
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-1: an explicit move in a match scrutinee cannot consume a copy tag-only enum; copy values are matched bare.";
  let state = Ready();
  match move state {
    Ready() => {
    }
    Done() => {
    }
  }
  return exit_status(code: 0_u8);
}
