fn two_bytes(bound: own u64) -> (low: own u8, high: own u8) pure {
  doc "Two results from one call.";
  return 1_u8, 2_u8;
}

command fn main() -> status: own ExitStatus pure {
  doc "LIV-2's second condition: two subscripts of one run whose offsets are not both literals with unequal values overlap [OWN-7], and the commit order would decide the result, so the second target is the rejection.";
  let empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq empty, value: 0_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 0_u8);
  }
  let two = move one;
  region {
    place_back(vector: &uniq two, value: 0_u8);
  }
  let three = move two;
  region {
    place_back(vector: &uniq three, value: 0_u8);
  }
  let v = move three;
  let i = 0_u64;
  let j = 1_u64;
  set (v[i], v[j]) = two_bytes(bound: 4_u64);
  return exit_status(code: 0_u8);
}
