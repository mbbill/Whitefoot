enum Box {
  Item(n: i32);
  Empty();
}

fn main() -> own unit traps {
  doc "A payload-carrying variant is constructed, matched, and its bound payload feeds arithmetic delivered by give; the value-match round-trips the payload through codegen [TYPE-2, GRAM-8, GRAM-10, GIVE-1].";
  let b = Item(n: 7_i32);
  let r = match b {
    Item(n: v) => {
      let v_in_range = ile(v, 2147483612_i32);
      claim payload_below_max: v_in_range because "the constructed payload is 7";
      give v + 35_i32;
    }
    Empty() => {
      give 0_i32;
    }
  }
  check ieq(r, 42_i32) else trap "payload drift";
  return unit;
}
