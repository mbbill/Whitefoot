command fn main(command.args as args: own Args) -> own ExitStatus allocates(heap), traps {
  doc "SYS-8: an offset beyond the buffer's runtime length traps even when the requested capacity is zero, so the offset check is a check of its own rather than a consequence of the sum exceeding the length.";
  let bytes = buffer_new(4_u64, 0_u8);
  region 'a {
    match arg_get<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            match host_copy_bytes<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, offset: 8_u64, capacity: 0_u64) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                return exit_status(code: 11_u8);
              }
            }
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 12_u8);
      }
    }
  }
}
