fn headroom(a: own u64, b: own u64, limit: own u64) -> result: own u64 pure contract {
  define sum = a + b;
  define overflow = sum > limit;
  define excluded = a > 16_u64;
  define either = bor(overflow, excluded);
  requires bnot(either);
  requires a <= 16_u64;
  requires b <= 16_u64;
} {
  doc "Body-entry signed decomposition establishes both negative disjuncts, and the affine image of not(sum > limit) supplies sum <= limit. The binder is no longer spelled `room`, which is reserved from every declaration role [FORM-3, TYPE-10].";
  let total = a + b;
  let remaining = limit - total;
  return remaining;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
