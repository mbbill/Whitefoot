command fn main(command.heap as heap: own Heap) -> return_value: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "heap_vector takes a runtime-length run from the general store after its statically discharged allocation-fit obligation [OP-9].";
  region {
    match heap_vector::<i32>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: b) => {
        return exit_status(code: 0_u8);
      }
    }
  }
}
