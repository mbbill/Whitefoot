fn main() -> status: own ExitStatus pure {
  doc "FORM-3: v0.22 releases index from the fixed grammar atoms, so it is an ordinary IDENT, declarable as a binding and usable as a subscript offset.";
  let index = 1_u64;
  let empty = fixed_vector::<u8, 2>();
  region {
    place_back(vector: &uniq empty, value: 7_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 7_u8);
  }
  let items = move one;
  let value = items[index];
  return exit_status(code: 0_u8);
}
