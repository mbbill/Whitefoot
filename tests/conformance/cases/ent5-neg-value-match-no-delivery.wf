enum Choice {
  Narrow();
  Wide();
}

fn guard(value: own i32) -> result: own unit pure contract {
  requires ilt(value, 128_i32);
} {
  return unit;
}

fn matched(value: own i32, choice: own Choice) -> result: own i32 pure {
  let picked = match choice {
    Narrow() => {
      let narrow_bound = ilt(value, 8_i32);
      if narrow_bound {
      } else {
        return value;
      }
      give value;
    }
    Wide() => {
      let wide_bound = ilt(value, 128_i32);
      if wide_bound {
      } else {
        return value;
      }
      give value;
    }
  }
  guard(value: picked);
  return picked;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
