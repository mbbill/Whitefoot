enum Choice {
  Narrow();
  Wide();
}

fn guard(value: own i32) -> result: own unit pure contract {
  requires ilt(value, 128_i32);
} {
  return unit;
}

fn matched(value: own i32, choice: own Choice) -> result: own i32 traps {
  let picked = match choice {
    Narrow() => {
      claim narrow_bound: ilt(value, 8_i32) because "narrow bound";
      give value;
    }
    Wide() => {
      claim wide_bound: ilt(value, 128_i32) because "wide bound";
      give value;
    }
  }
  guard(value: picked);
  return picked;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
