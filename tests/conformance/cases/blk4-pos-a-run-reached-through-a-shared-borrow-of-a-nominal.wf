struct Source {
  bytes: FixedVector<u8, 5>;
}

fn head(input: &Source) -> byte: own u8 reads(input.bytes) {
  doc "A run field reached through a shared borrow of its owner: the subscript is the same measured place, so its [OP-4] obligation is discharged from the measure read through the same holder.";
  let size = len_of(deref(input).bytes);
  let ok = 0_u64 < size;
  if ok {
    return deref(input).bytes[0_u64];
  }
  return 0_u8;
}

command fn main() -> status: own ExitStatus pure {
  let bytes = fixed_vector::<u8, 5>();
  set bytes = place_back(vector: move bytes, value: 43_u8);
  let input = Source(bytes: move bytes);
  region {
    let window = &input;
    let seen = head(input: window);
    if seen == 43_u8 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
