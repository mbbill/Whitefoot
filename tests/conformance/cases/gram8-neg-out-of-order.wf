enum Pair {
  P(a: i32, b: i32);
}

fn make() -> return_value: own Pair pure {
  doc "GRAM-8: out-of-order field names are rejected; declared order is the one legal byte sequence.";
  return P(b: 2_i32, a: 1_i32);
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
