enum Color {
  Red();
  Green();
  Blue();
}

fn pick(x: own i32) -> return_value: own Color pure {
  return Red();
}

command fn main() -> return_value: own ExitStatus pure {
  doc "GRAM-2: a program is item* - two fn_decl items and one enum_decl item.";
  let c = pick(x: 1_i32);
  return exit_status(code: 0_u8);
}
