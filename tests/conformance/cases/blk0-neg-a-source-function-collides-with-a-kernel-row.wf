fn place_back(vector: own u64, value: own u64) -> result: own u64 pure {
  doc "Declares a function whose spelling is a PRE-1 window operation's.";
  return vector;
}

fn main() -> status: own ExitStatus pure {
  doc "PRE-1 window-operation records occupy the ordinary callable name domain. A same-spelled source function is the ordinary TYPE-6 collision.";
  return exit_status(code: 0_u8);
}
