enum State {
  Ready();
  Done();
}

command fn main() -> status: own ExitStatus pure {
  doc "TYPE-7 applies to match scrutinees: a reference holder requires explicit deref(.) before matching its referent.";
  let state = Ready();
  region {
    let holder = &state;
    match holder {
      Ready() => {
      }
      Done() => {
      }
    }
  }
  return exit_status(code: 0_u8);
}
