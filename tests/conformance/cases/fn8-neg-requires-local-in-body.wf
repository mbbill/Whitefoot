fn hidden_local(x: own i32) -> result: own Bool pure contract {
  define permitted = x >= 0_i32;
  requires permitted;
} {
  doc "Requirement locals do not enter the function-body scope [FN-8/TYPE-5].";
  return permitted;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
