command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files), allocates(heap) {
  doc "`directory_next` carries SYS-8's two static range goals. End 4104 exceeds this 4096-byte destination, so compilation rejects the call before any host enumeration or runtime fallback.";
  let entries = buffer_new(4096_u64, 0_u8);
  region {
    match reserve_handle(factory: &uniq files) {
      Ok(value: permit) => {
        match open_directory_source(permit: move permit, directory: &cwd) {
          SourceOpened(value: list) => {
            region {
              match directory_next(source: &uniq list, destination: &uniq entries, start: 8_u64, end: 4104_u64) {
                ListBytes(next: bytes, entries: reported) => {
                  return exit_status(code: 5_u8);
                }
                ListEnd() => {
                  return exit_status(code: 6_u8);
                }
                ListFailed(error: problem) => {
                  return exit_status(code: 3_u8);
                }
              }
            }
          }
          SourceOpenFailed(error: problem, permit: refused) => {
            return exit_status(code: 4_u8);
          }
        }
      }
      Err(error: spent) => {
        return exit_status(code: 7_u8);
      }
    }
  }
}
