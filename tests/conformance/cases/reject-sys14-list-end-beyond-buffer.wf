command fn main(command.cwd as cwd: own DirectoryRead) -> status: own ExitStatus allocates(heap), external, blocks {
  doc "`list_once` carries SYS-8's two static range goals. End 4104 exceeds this 4096-byte destination, so compilation rejects the call before any host enumeration or runtime trap.";
  let entries = buffer_new(4096_u64, 0_u8);
  region 'c {
    match open_list<'c>(directory: &'c cwd) {
      Ok(value: list) => {
        region 'b {
          match list_once<'b, 'b>(list: &uniq 'b list, destination: &uniq 'b entries, start: 8_u64, end: 4104_u64) {
            ListBytes(next: bytes, entries: reported) => {
              return exit_status(code: 5_u8);
            }
            ListEnd() => {
              return exit_status(code: 6_u8);
            }
            ListFailed(error: problem) => {
              return exit_status(code: 3_u8);
            }
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 4_u8);
      }
    }
  }
}
