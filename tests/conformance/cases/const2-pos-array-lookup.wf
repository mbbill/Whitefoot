const table: array<u8, 4> =[10_u8, 20_u8, 30_u8, 40_u8];

fn main() -> own unit traps {
  doc "A const array is read-only static rodata, indexed with copy-out [CONST-2].";
  let v = table[2_u64];
  check v == 30_u8 else trap "const table drift";
  let n = len(table);
  check n == 4_u64 else trap "const len drift";
  return unit;
}
