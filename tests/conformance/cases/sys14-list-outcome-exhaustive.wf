command fn main(command.cwd as cwd: own DirectoryRead) -> own ExitStatus allocates(heap), external, blocks, traps {
  doc "`ListOutcome` is a closed three-constructor outcome type [SYS-6, SYS-14]: `ListBytes` carrying the transferred byte count and the exact number of entry records that prefix holds, `ListEnd`, and `ListFailed`. A match naming all three is exhaustive [ERR-2] and needs no default arm, because the portable class set is the sole discriminator. Each arm exits with its own code over a directory that holds entries, so exit 0 is reached only through `ListBytes`.";
  let entries = buffer_new(1024_u64, 0_u8);
  region 'c {
    match open_list<'c>(directory: &'c cwd) {
      Ok(value: list) => {
        region 'b {
          match list_once<'b, 'b>(list: &uniq 'b list, destination: &uniq 'b entries, offset: 0_u64, capacity: 1024_u64) {
            ListBytes(count: bytes, entries: reported) => {
              return exit_status(code: 0_u8);
            }
            ListEnd() => {
              return exit_status(code: 5_u8);
            }
            ListFailed(error: problem) => {
              return exit_status(code: 3_u8);
            }
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 4_u8);
      }
    }
  }
}
