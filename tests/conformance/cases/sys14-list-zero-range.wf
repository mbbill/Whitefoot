command fn main(command.cwd as cwd: own DirectoryRead) -> own ExitStatus allocates(heap), external, blocks, traps {
  doc "A zero-length destination range is a well-formed request that transfers nothing [SYS-8, SYS-14]: it yields `ListBytes(count: 0, entries: 0)`, never `ListEnd`. End of enumeration is a separate outcome from an empty transfer, exactly as a full buffer is a separate outcome from end of input, so a program cannot read a zero count as exhaustion.";
  let entries = buffer_new(1024_u64, 0_u8);
  region 'c {
    match open_list<'c>(directory: &'c cwd) {
      Ok(value: list) => {
        region 'b {
          match list_once<'b, 'b>(list: &uniq 'b list, destination: &uniq 'b entries, offset: 0_u64, capacity: 0_u64) {
            ListBytes(count: bytes, entries: reported) => {
              if ieq(bytes, 0_u64) {
                if ieq(reported, 0_u64) {
                  return exit_status(code: 0_u8);
                }
              }
              return exit_status(code: 5_u8);
            }
            ListEnd() => {
              return exit_status(code: 6_u8);
            }
            ListFailed(error: problem) => {
              return exit_status(code: 3_u8);
            }
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 4_u8);
      }
    }
  }
}
