deny_claims fn checked_read(values: own array<u8, 4>, index: own u64) -> result: own u8 traps {
  let room = len(values);
  let inside = ilt(index, room);
  claim checked_read: inside because "checked read";
  return values[index];
}

command fn main() -> status: own ExitStatus traps {
  let values = array_new<u8, 4>(7_u8);
  let selected = checked_read(values: move values, index: 0_u64);
  return exit_status(code: 0_u8);
}
