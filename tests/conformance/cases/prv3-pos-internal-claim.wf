fn hide_index(value: own u64) -> return_value: own u64 pure {
  return value;
}

command fn main() -> return_value: own ExitStatus allocates(heap), traps {
  doc "A genuine residual may discharge a protected leaf when the constrained subject is internal; provenance independently narrows claim use for external subjects.";
  let index = hide_index(value: 1_u64);
  let bytes = buffer_new(4_u64, 0_u8);
  let room = len(bytes);
  let inside = ilt(index, room);
  claim index_in_bytes: inside because "premises: hide_index returns its value parameter unchanged, it is called with 1_u64, and bytes has length 4_u64\nderivation: index is 1_u64 and therefore strictly less than room, which is 4_u64\nconclusion: ilt(index, room) is true\nchecker gap: ENT does not publish the result equality of an uncontracted user call\nconsumers: the following bytes[index] subscript requires this exact bound";
  let value = bytes[index];
  return exit_status(code: 0_u8);
}
