command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "PROV-6: the early release. `dispose` runs the same walk the scope exit would run, at the point it is written, and it spends the resolved provider of the store the run names.";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let one = place_back(vector: move fresh, value: 5_u8);
        let read = one[0_u64];
        dispose one;
        return exit_status(code: read);
      }
    }
  }
}
