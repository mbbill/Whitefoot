fn read_allocated(bytes: own buffer<u8>, index: own u64) -> own u8 pure requires {
  let room = len(bytes);
  let inside = ilt(index, room);
  check inside else trap "index must be in the allocated buffer";
} {
  return bytes[index];
}

fn main() -> own unit allocates(heap), traps {
  doc "S5 and S6 allocation equalities prove an exact ordinary-call requirement in the unasserted caller state, so the requirement bridge ends without a PRV-2 event.";
  let size = 4_u64;
  let bytes = buffer_new(size, 0_u8);
  let index = 1_u64;
  let value = read_allocated(bytes: move bytes, index: index);
  return unit;
}
