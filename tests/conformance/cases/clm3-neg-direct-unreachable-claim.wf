deny_claims command fn main() -> status: own ExitStatus traps {
  let values = array_new<u8, 4>(0_u8);
  let cursor = 0_u64;
  loop @scan {
    let inside = ilt(cursor, 4_u64);
    claim reachable_claim: inside because "premises: cursor starts at 0_u64, every continuing iteration increments it by one, and the iteration at 2_u64 returns\nderivation: induction over reached scan bodies limits cursor to 0_u64 through 2_u64, all strictly below 4_u64\nconclusion: ilt(cursor, 4_u64) is true\nchecker gap: ENT does not derive this ordinary-loop induction across the backedge\nconsumers: the following values[cursor] subscript requires this exact bound";
    let selected = values[cursor];
    let done = ieq(cursor, 2_u64);
    if done {
      break @scan;
    } else {
      set cursor = cursor +wrap 1_u64;
    }
  }
  return exit_status(code: 0_u8);
}
