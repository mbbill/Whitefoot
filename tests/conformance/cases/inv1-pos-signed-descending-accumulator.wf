fn accumulate_descending(count: own u64) -> result: own i32 pure contract {
  requires count <= 40_u64;
} {
  let sum = 0_i32;
  for (
    i in 0_u64..count,
    invariant lower_bound: sum >= -3_i32 * i
  ) {
    set sum = sum - 3_i32;
  }
  return sum;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
