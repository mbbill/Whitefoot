fn component() -> made: own FixedVector<u8, 16> pure contract {
  ensures len_of(made) >= 16_u64;
  ensures room_of(made) <= 0_u64;
  ensures head_of(made) <= 0_u64;
} {
  doc "Each iteration constructs the name, the extent and the destination it uses, so the only storage outside the loop the body reaches is the factory it reserves through, the directory it reads, and the total it commits. This is the shape PAR-3 is meant to grant: read-only cwd, prologue-serialized files, remainder-serialized total, and per-iteration storage nothing outside the iteration names. The judgment grants it: a view is a claim on the storage it was formed over [VIEW-1], so the per-iteration destination resolves to the extent-reserved run, and that run is storage the iteration introduces [BLK-2].";
  let built = fixed_vector::<u8, 16>();
  for @fill (
    at in 0_u64..16_u64,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= 16_u64,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: 97_u8);
  }
  return move built;
}

command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  doc "Each iteration constructs the name, the extent and the destination it uses, so the only storage outside the loop the body reaches is the factory it reserves through, the directory it reads, and the total it commits. This is the shape PAR-3 is meant to grant: read-only cwd, prologue-serialized files, remainder-serialized total, and per-iteration storage nothing outside the iteration names.";
  let total = 0_u64;
  for @scan (index in 0_u64..4_u64) {
    let name = component();
    region 'w {
      let workspace = arena_frame::<64, 1, 'w>();
      region {
        let data = arena_vector_proved::<u8>(store: &uniq workspace, count: 64_u64);
        for @prime (
          at in 0_u64..64_u64,
          invariant grown: len_of(data) >= at,
          invariant spare: room_of(data) + at >= 64_u64,
          invariant flat: head_of(data) <= 0_u64
        ) {
          set data = place_back(vector: move data, value: 0_u8);
        }
        region 'f {
          match reserve_handle(factory: &uniq files) {
            Ok(value: permit) => {
              let window = slice_of(&name);
              region {
                match open_file(permit: move permit, root: &'f cwd, name: &window, start: 0_u64, end: 4_u64) {
                  FileOpened(value: handle) => {
                    region 'h {
                      region {
                        let destination = mut_slice_of(&uniq data);
                        region {
                          match read_at(file: &'h handle, destination: &uniq destination, file_offset: 0_u64, start: 0_u64, end: 64_u64) {
                            ReadBytes(next: produced) => {
                              set total = total +wrap produced;
                            }
                            ReadEnd() => {
                            }
                            ReadFailed(error: problem) => {
                            }
                          }
                        }
                      }
                    }
                  }
                  FileOpenFailed(error: problem, permit: refused) => {
                  }
                }
              }
            }
            Err(error: spent) => {
              return exit_status(code: 1_u8);
            }
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
