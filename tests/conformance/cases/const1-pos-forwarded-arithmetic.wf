fn doubled<const n: u64>(fill: own u64) -> own array<u64, n * 2> pure {
  doc "CONST-1 one-operation const arithmetic: a const-expression is at most one operation over two terms, exactly the shape GRAM-6 fixes for expressions. `n * 2` is usable as an array<T, N> size and forwardable as a const targ, and each concrete instantiation evaluates it to one u64 value at monomorphization.";
  return array_new<u64, n * 2>(fill);
}

fn main() -> own unit traps {
  let cells = doubled<3>(fill: 7_u64);
  let count = len(cells);
  claim doubled_array_length: ieq(count, 6_u64) because "doubled array length";
  let last = cells[5_u64];
  claim doubled_array_fill: ieq(last, 7_u64) because "doubled array fill";
  return unit;
}
