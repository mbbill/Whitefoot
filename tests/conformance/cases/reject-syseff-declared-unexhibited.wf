fn count_arguments['q, 'o](args: own Args, output: own Output<'q, 'o>) -> function_result: own u64 writes('o) {
  doc "Args is immutable and Output release is a logical detach with no world access [SYS-5, SYS-9, SYS-12], while args_count is memory-only, so declaring the well-bound but unexhibited `writes('o)` is rejected citing EFF-2.";
  region 'a {
    let total = args_count<'a>(args: &'a args);
    return total;
  }
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
