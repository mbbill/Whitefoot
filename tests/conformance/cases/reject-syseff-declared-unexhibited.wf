fn count_arguments(args: own Args) -> function_result: own u64 pure {
  doc "args_count reads the explicit Args capability, so omitting reads(args) is an undeclared capability effect rejected by EFF-2.";
  region 'a {
    let total = args_count<'a>(args: &'a args);
    return total;
  }
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
