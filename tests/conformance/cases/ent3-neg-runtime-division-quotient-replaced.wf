fn changed(count: u64, divisor: u64, choose: Bool) -> result: u64 pure contract {
  requires count <= 4096_u64;
  requires 1_u64 <= divisor;
  requires divisor <= 64_u64;
} {
  let quotient = count / divisor;
  if choose {
    set quotient = count;
  }
  let product = quotient * divisor;
  invariant bounded: product <= count;
  return product;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
