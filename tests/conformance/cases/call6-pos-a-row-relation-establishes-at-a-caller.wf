fn two_in_a_row(vector: &uniq FixedVector<u8, 4>) -> result: own unit reads(vector), writes(vector) contract {
  requires room_of(deref(vector)) > 1_u64;
} {
  doc "The first placement publishes its exit room relative to its entry room, supplying the second placement's requirement.";
  region {
    place_back(vector: &uniq deref(vector), value: 1_u8);
    place_back(vector: &uniq deref(vector), value: 2_u8);
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "CALL-6: a kernel-domain row's declared relation is instantiated at the call and established on its continuation, exactly as a source contract's is.";
  return exit_status(code: 0_u8);
}
