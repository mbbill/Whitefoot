fn filled_four(value: own u32) -> result: own FixedVector<u32, 4> pure contract {
  ensures len_of(result) >= 4_u64;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "One full run of four slots, built by the ordinary counted fill.";
  let built = fixed_vector::<u32, 4>();
  for @fill (
    at in 0_u64..4_u64,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= 4_u64,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

command fn main() -> status: own ExitStatus pure {
  doc "[ENT-2] the implicit `cap_of(P) = n` of a `FixedVector<T, n>` place holds at every program point. An element read feeding a branch condition puts a join on the path, and the SET-2 replace of the run's root binding then kills every relation supported by that place [ENT-5]. The capacity equality is a function of the place's type rather than a fact that had to survive, so it still reads back on both sides of the exchange [ENT-4]; the honest difference from the retiring array is that `len_of` is a descriptor word rather than a type constant, so the length does not survive the replace and the subscripts stand before it.";
  let samples = filled_four(value: 1_u32);
  let before = samples[0_u64];
  if before == 1_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let fresh = filled_four(value: 9_u32);
  let previous = replace samples = move fresh;
  let capacity = cap_of(samples);
  if capacity == 4_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let carried = cap_of(previous);
  if carried == 4_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
