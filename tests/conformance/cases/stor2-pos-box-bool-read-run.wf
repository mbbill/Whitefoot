fn main() -> status: own ExitStatus pure {
  doc "A cell constructed from Bool yields the original value through deref. Normal exit is observed; this case does not count deallocations.";
  let flag = True();
  let owner = box_new::<Bool>(value: flag);
  let loaded = deref(owner);
  if loaded {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
