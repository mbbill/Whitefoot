struct Point {
  x: i32;
  y: i32;
}

fn takes_i32(value: own i32) -> function_result: own unit pure {
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "A reference formed over a field names that field's path [REF-1], so writing it at a call argument whose parameter is own i32 reads that path. v0.59 called this the forgotten-deref read at a call-argument site; v0.60 admits the bare spelling, there being no deref on a reference at all [TYPE-7].";
  let p = Point(x: 7_i32, y: 9_i32);
  let r = &p.x;
  let a = takes_i32(value: r);
  return exit_status(code: 0_u8);
}
