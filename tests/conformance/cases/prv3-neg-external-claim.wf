fn clamp_three(value: own u64) -> return_value: own u64 pure {
  return imin(value, 3_u64);
}

command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap), traps {
  doc "A true reviewed residual remains a runtime boundary, not authority to admit an externally derived constrained subject under PRV-3.";
  region 'a {
    let raw_index = args_count<'a>(args: &'a args);
    let index = clamp_three(value: raw_index);
    let bytes = buffer_new(4_u64, 0_u8);
    let room = len(bytes);
    let inside = ilt(index, room);
    claim index_in_bytes: inside because "premises: index is returned by clamp_three, whose body computes imin(raw_index, 3_u64), and bytes has length 4\nderivation: index is at most 3_u64 and therefore strictly less than room\nconclusion: ilt(index, room) is true\nchecker gap: ENT does not publish an uncontracted user-call result bound\nconsumers: the following bytes[index] subscript requires this exact bound";
    let value = bytes[index];
    return exit_status(code: 0_u8);
  }
}
