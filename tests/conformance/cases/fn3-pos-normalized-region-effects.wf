struct Cell {
  value: u64;
}

formal BorrowedSum {
  fn sum(x: &Cell, y: &Cell) -> result: own u64 reads(x.value), reads(y.value);
}

actual First : BorrowedSum {
  sum = add_borrowed;
}

fn add_borrowed(first: &Cell, second: &Cell) -> total: own u64 reads(first.value), reads(second.value) {
  doc "FN-3 and EFF-1: formal and actual rows compare by parameter ordinal and path, never by binder spelling, so renaming both inputs preserves the boundary. The entries themselves stay in canonical order, every `reads` before every `writes` and each in written argument order.";
  return first.value +wrap second.value;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
