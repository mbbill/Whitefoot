contract BorrowedSum {
  fn sum(x: &buffer<u8>, y: &buffer<u8>) -> result: own u64 reads(x, y);
}

conform buffer<u8>: BorrowedSum {
  sum = add_borrowed;
}

fn add_borrowed(x: &buffer<u8>, y: &buffer<u8>) -> result: own u64 reads(y, x) {
  let x_length = len_of(deref(x));
  let y_length = len_of(deref(y));
  return x_length +wrap y_length;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
