contract BorrowedSum {
  fn sum(x: own Slice<u8>, y: own Slice<u8>) -> result: own u64 reads(x, y);
}

conform Slice<u8>: BorrowedSum {
  sum = add_borrowed;
}

fn add_borrowed(x: own Slice<u8>, y: own Slice<u8>) -> result: own u64 reads(y, x) {
  let x_length = len_of(x);
  let y_length = len_of(y);
  return x_length +wrap y_length;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
