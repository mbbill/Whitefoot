contract BorrowedSum {
  fn sum['left, 'right](x: &'left buffer<u8>, y: &'right buffer<u8>) -> result: own u64 reads('left 'right);
}

conform buffer<u8>: BorrowedSum {
  sum = add_borrowed;
}

fn add_borrowed['a, 'b](x: &'a buffer<u8>, y: &'b buffer<u8>) -> result: own u64 reads('b 'a) {
  let x_length = len(deref(x));
  let y_length = len(deref(y));
  return x_length +wrap y_length;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
