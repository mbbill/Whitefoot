fn exercise['heap](args: &Args, cwd: &DirectoryRead, files: &uniq HandleFactory, heap: &uniq Heap<'heap>) -> status: own ExitStatus reads(args, cwd, files, heap), writes(files, heap), allocates(heap) {
  doc "Explicit close_read consumes a linear file and restores the ordinary factory credit; the next open through that same factory succeeds and reads the original byte. The old returned HandlePermit assertion is retired.";
  region {
    match heap_vector::<u8>(store: &uniq deref(heap), count: 1_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let page = move fresh;
        for @scratch (
          at in 0_u64..1_u64,
          invariant grown: len_of(page) >= at,
          invariant spare: room_of(page) + at >= 1_u64,
          invariant flat: head_of(page) <= 0_u64
        ) {
          place_back(vector: &uniq page, value: 0_u8);
        }
        region {
          let window = mut_slice_of(&uniq page);
          region {
            match arg_get(args: args, position: 1_u64) {
              Ok(value: text) => {
                match relative_path(value: move text) {
                  Ok(value: path) => {
                    region {
                      region {
                        match open_read(factory: &uniq deref(files), root: cwd, path: &path) {
                          FileOpened(value: file) => {
                            let returned = close_read(factory: &uniq deref(files), file: move file);
                            match open_read(factory: &uniq deref(files), root: cwd, path: &path) {
                              FileOpened(value: again) => {
                                region {
                                  region {
                                    match read_at(factory: &uniq deref(files), file: &uniq again, destination: &uniq window, file_offset: 0_u64, start: 0_u64, end: 1_u64) {
                                      Ok(value: n) => {
                                        close_read(factory: &uniq deref(files), file: move again);
                                        return exit_status(code: 0_u8);
                                      }
                                      Err(error: read_stop_11) => {
                                        match read_stop_11 {
                                          ReadEnd() => {
                                            close_read(factory: &uniq deref(files), file: move again);
                                            return exit_status(code: 10_u8);
                                          }
                                          ReadFailed(error: problem) => {
                                            close_read(factory: &uniq deref(files), file: move again);
                                            return exit_status(code: 11_u8);
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                              FileOpenFailed(error: problem) => {
                                return exit_status(code: 16_u8);
                              }
                            }
                          }
                          FileOpenFailed(error: problem) => {
                            return exit_status(code: 12_u8);
                          }
                        }
                      }
                    }
                  }
                  Err(error: rejected) => {
                    return exit_status(code: 13_u8);
                  }
                }
              }
              Err(error: absent) => {
                return exit_status(code: 14_u8);
              }
            }
          }
        }
      }
    }
  }
}

fn main['heap](inputs: own Inputs, heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, files: &uniq files, heap: &uniq heap);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
