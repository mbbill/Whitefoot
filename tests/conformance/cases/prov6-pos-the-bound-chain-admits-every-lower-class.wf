linear struct Lease {
  slot: u8;
}

fn hold<T: linear>(value: own T) -> back: own T pure {
  doc "A body written for the linear class: it consumes its value exactly once, by handing it back.";
  return move value;
}

fn keep<T: affine>(value: own T) -> back: own T pure {
  doc "A body written for the affine class.";
  return move value;
}

command fn main() -> status: own ExitStatus pure {
  doc "PROV-6, S37: satisfaction is the chain copy < affine < linear read left to right, so a `linear` bound accepts copy, affine and linear arguments and an `affine` bound accepts copy and affine ones. The three classes are read off each argument's own release graph in this scope, never off a name.";
  let held = hold::<u64>(value: 4_u64);
  let payload = Some<u8>(value: 3_u8);
  let boxed = hold::<Option<u8>>(value: move payload);
  let ticket = Lease(slot: 5_u8);
  let leased = hold::<Lease>(value: move ticket);
  let Lease(slot: back) = move leased;
  let plain = keep::<u8>(value: 7_u8);
  let other = Some<u8>(value: 9_u8);
  let kept = keep::<Option<u8>>(value: move other);
  match boxed {
    Some(value: got) => {
      match kept {
        Some(value: also) => {
          if back == 5_u8 {
            if held == 4_u64 {
              if plain == 7_u8 {
                return exit_status(code: 0_u8);
              }
            }
          }
          return exit_status(code: 1_u8);
        }
        None() => {
          return exit_status(code: 2_u8);
        }
      }
    }
    None() => {
      return exit_status(code: 3_u8);
    }
  }
}
