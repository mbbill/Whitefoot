fn count_arguments(args: own Args) -> result: own u64 reads(args) {
  doc "Args is immutable, so its snapshot-read fragment is Free, but args_count still reads the explicit logical capability. The exact row is reads(args), independent of the borrow lifetime.";
  region 'a {
    let total = args_count<'a>(args: &'a args);
    return total;
  }
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
