fn main() -> status: own ExitStatus pure {
  doc "TYPE-9: each compiler-owned nominal contributes one constructor entry that exists to be refused, so a constructor call admitting one is a hard error at the complete constructor call; the restructuring is to build it with a construction function.";
  let s = Slots<u64, 4>();
  let n = s.len;
  if n == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
