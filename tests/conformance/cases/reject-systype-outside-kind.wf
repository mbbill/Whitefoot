fn take_args(args: own Args) -> function_result: own unit pure {
  doc "The command unit admits Args, and the helper requires that exact own type. Passing unit at the call boundary is an exact argument-type mismatch rejected by TYPE-5.";
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  take_args(args: unit);
  return exit_status(code: 0_u8);
}
