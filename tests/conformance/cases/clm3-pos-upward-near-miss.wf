deny_claims fn strict_identity<T: Int>(value: own T) -> own T pure {
  return value;
}

fn ordinary_claiming_caller() -> own u64 traps {
  let asserted = True();
  claim caller_only: asserted because "this ordinary caller is outside the strict root's outgoing closure";
  let small = strict_identity<u8>(value: 3_u8);
  let accepted = strict_identity<u64>(value: 4_u64);
  return accepted;
}

fn main() -> own unit traps {
  let value = ordinary_claiming_caller();
  return unit;
}
