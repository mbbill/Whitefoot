deny_claims fn strict_identity<T: Int>(value: own T) -> result: own T pure {
  return value;
}

fn ordinary_claiming_caller() -> result: own u64 traps {
  let asserted = True();
  claim caller_only: asserted because "this ordinary caller is outside the strict root's outgoing closure";
  let small = strict_identity<u8>(value: 3_u8);
  let accepted = strict_identity<u64>(value: 4_u64);
  return accepted;
}

command fn main() -> status: own ExitStatus traps {
  let value = ordinary_claiming_caller();
  return exit_status(code: 0_u8);
}
