struct Block {
  bytes: Slots<u8, 4>;
}

fn pass_block(block: own Block) -> result: own Block pure contract {
  ensures result.bytes.cap == block.bytes.cap;
  ensures result.bytes.len == block.bytes.len;
} {
  doc "FN-9 admits its specified whole-result forms and the explicit Result route; a nominal field such as `result.bytes` is not a selectable aggregate result datum.";
  return move block;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
