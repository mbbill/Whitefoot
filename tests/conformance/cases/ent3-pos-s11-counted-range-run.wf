const values: array<u8, 4> =[10_u8, 20_u8, 30_u8, 40_u8];

fn main() -> own unit traps {
  doc "S11 proves each counted binder is below the captured upper endpoint, discharging the array subscript; the run also fixes half-open exhaustion, a zero-trip range, and a break naming the counted loop [ENT-3, OP-4, FN-1].";
  let total = 0_u8;
  for @full i in 0_u64..4_u64 {
    let value = values[i];
    set total = total +wrap value;
  }
  for @empty i in 4_u64..4_u64 {
    set total = total +wrap 1_u8;
  }
  for @local i in 0_u64..4_u64 {
    let value = values[i];
    set total = total +wrap value;
    break @local;
  }
  claim counted_range_conformance_drift: ieq(total, 110_u8) because "counted range conformance drift";
  return unit;
}
