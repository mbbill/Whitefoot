const values: FixedVector<u8, 4> =[0_u8, 0_u8, 0_u8, 0_u8];

struct Pair {
  token: HostString;
  left: u64;
  right: u64;
}

fn write_left(pair: &uniq Pair, value: own u64) -> result: own unit writes(pair.left) {
  set deref(pair).left = value;
  return unit;
}

fn preserve_right(pair: own Pair) -> result: own u8 reads(pair.right), writes(pair.left) contract {
  define spare = len_of(values);
  requires pair.right < spare;
} {
  region {
    write_left(pair: &uniq pair, value: 0_u64);
  }
  return values[pair.right];
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
