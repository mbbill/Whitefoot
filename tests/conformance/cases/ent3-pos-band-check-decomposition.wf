fn read_pair(table: own array<u8, 8>, low: own u64, high: own u64) -> result: own u8 traps {
  doc "ENT-3 signed Boolean decomposition [O11], the positive-sign half: a passed `claim` establishes the positive sign of its goal, and decomp of a positive `band(A, B)` is {+A, +B}. The claim therefore establishes +ilt(low, 8) and +ilt(high, 8) with their comparison projections, and both subscript obligations discharge from the one conjoined claim. Each member's ENT-5 support is the ordinary support of its own subtree, so kills, scope exits, and joins need no new machinery.";
  let low_ok = ilt(low, 8_u64);
  let high_ok = ilt(high, 8_u64);
  let both = band(low_ok, high_ok);
  claim pair_out_of_range: both because "premises: low_ok and high_ok compare the two caller-supplied indices with the eight-element table length, and both is their conjunction\nderivation: the closed caller supplies low 1_u64 and high 2_u64, so each comparison and therefore both are true\nconclusion: both is true\nchecker gap: ENT does not publish the closed caller arguments through read_pair\nconsumers: the following two table subscripts need the two decomposed upper Range components";
  let first = table[low];
  let second = table[high];
  return second;
}

command fn main() -> status: own ExitStatus traps {
  let table = array_new<u8, 8>(3_u8);
  let value = read_pair(table: move table, low: 1_u64, high: 2_u64);
  if ieq(value, 3_u8) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
