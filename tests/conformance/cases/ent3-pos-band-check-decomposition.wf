fn read_pair(table: own array<u8, 8>, low: own u64, high: own u64) -> result: own u8 pure {
  doc "ENT-3 signed Boolean decomposition: the true edge of band(low_ok, high_ok) establishes both positive operands. Their comparison projections discharge both array subscript obligations.";
  let low_ok = ilt(low, 8_u64);
  let high_ok = ilt(high, 8_u64);
  let both = band(low_ok, high_ok);
  if both {
    let first = table[low];
    let second = table[high];
    return second;
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  let table = array_new<u8, 8>(3_u8);
  let value = read_pair(table: move table, low: 1_u64, high: 2_u64);
  if ieq(value, 3_u8) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
