fn free_unproved<T, const n: u64>(run: own Slots<T, n>) -> result: own unit pure {
  doc "OP-14: free_empty consumes a window whose element type is linear under the contract requires window.len == 0_u64, submitted at the call. A type argument or an unused capacity does not establish that current-state fact, so the requirement stays undischarged.";
  free_empty(window: move run);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "The rejection is in the generic template above; this entry point does nothing.";
  return exit_status(code: 0_u8);
}
