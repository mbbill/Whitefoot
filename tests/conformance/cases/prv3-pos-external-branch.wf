command fn main(command.args as args: own Args) -> return_value: own ExitStatus allocates(heap) {
  doc "A real branch may establish the bounds relation for a boundary-derived constrained subject; PRV-3 removes claim evidence, not S1 branch facts.";
  region 'a {
    let index = args_count<'a>(args: &'a args);
    let bytes = buffer_new(4_u64, 0_u8);
    let room = len(bytes);
    let inside = ilt(index, room);
    if inside {
      let value = bytes[index];
    } else {
      return exit_status(code: 0_u8);
    }
    return exit_status(code: 0_u8);
  }
}
