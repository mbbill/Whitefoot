struct Packet {
  readonly id: u64;
  size: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "TYPE-2: an argument naming a readonly field at a reference parameter whose callee row writes that parameter is refused; swap writes both of its parameters.";
  let p = Packet(id: 7_u64, size: 1_u64);
  let other = 8_u64;
  swap(first: &p.id, second: &other);
  return exit_status(code: 0_u8);
}
