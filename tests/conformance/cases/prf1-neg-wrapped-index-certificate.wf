fn probe<const n: u64>(table: own FixedVector<u8, n>, a: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires a <= spare;
} {
  let idx = a -wrap 1_u64;
  let bound_room = len_of(table);
  invariant bound: idx < bound_room {
    use (a <= bound_room);
  }
  let byte = table[idx];
  return byte;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
