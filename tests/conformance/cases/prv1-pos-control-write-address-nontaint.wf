command fn main(command.args as args: own Args) -> own ExitStatus allocates(heap), traps {
  doc "External control and a write target address add no provenance edge: only the internal right-hand side reaches storage, so a later internally selected value may protect a subscript by claim.";
  region 'a {
    let external_offset = args_count<'a>(args: &'a args);
    let offsets = buffer_new(8_u64, 0_u64);
    let offset_count = len(offsets);
    let writable = ilt(external_offset, offset_count);
    if writable {
      set offsets[external_offset] = 0_u64;
      let internal_offset = offsets[0_u64];
      let bytes = buffer_new(1_u64, 0_u8);
      let room = len(bytes);
      let inside = ilt(internal_offset, room);
      claim internal_index_in_bytes: inside because "control and target-address choices do not taint the stored value";
      let value = bytes[internal_offset];
      return exit_status(code: 0_u8);
    } else {
      return exit_status(code: 0_u8);
    }
  }
}
