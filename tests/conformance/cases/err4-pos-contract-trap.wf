fn main() -> own unit traps {
  doc "Overflow via `.trap` is classified a contract violation: it aborts [ERR-4, SCOPE-4]; fixed by op table, not call site. Both operands are bound terms, so this is the retained two-non-constant trapping form: OP-2's constant-operand class does not reach it, no overflow obligation attaches, and the executed overflow still aborts.";
  let v = 0_i32;
  let peak = 2147483647_i32;
  let step = 1_i32;
  set v = peak + step;
  check ige(v, 0_i32) else trap "x";
  return unit;
}
