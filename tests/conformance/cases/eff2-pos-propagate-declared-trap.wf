fn risky_checked(x: own i32) -> result: own Result<i32, Overflow> traps {
  doc "A claim behind a Result surface; the row declares the claim-only runtime trap capability.";
  claim admitted: True() because "the callee retains the claim-only runtime trap capability";
  let step = 1_i32;
  let bumped = x +wrap step;
  return Ok<i32, Overflow>(value: bumped);
}

fn g(x: own i32) -> result: own Result<i32, Overflow> traps {
  doc "EFF-2: the propagate-scrutinee callee claim capability is declared; row and body agree.";
  let r = propagate risky_checked(x: x);
  return Ok<i32, Overflow>(value: r);
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
