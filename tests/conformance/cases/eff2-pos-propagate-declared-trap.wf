fn risky_checked(x: own i32) -> own Result<i32, Overflow> traps {
  doc "A trapping increment behind a Result surface; the row declares traps.";
  let bumped = x + 1_i32;
  return Ok<i32, Overflow>(value: bumped);
}

fn g(x: own i32) -> own Result<i32, Overflow> traps {
  doc "EFF-2: the propagate-scrutinee callee trap is declared; row and body agree.";
  let r = propagate risky_checked(x: x);
  return Ok<i32, Overflow>(value: r);
}

fn main() -> own unit pure {
  return unit;
}
