fn risky_checked(x: own i32) -> result: own Result<i32, Overflow> traps {
  doc "A genuine claim residual sits behind a Result surface; its exact arithmetic consumer makes the retained claim necessary and the row declares its claim-only runtime trap capability.";
  let residue = x % 2_i32;
  let divisor = residue +wrap 2_i32;
  let positive = igt(divisor, 0_i32);
  claim admitted_divisor: positive because "premises: residue is x remainder 2_i32 in this function and divisor is residue plus 2_i32 with wrapping semantics\nderivation: signed remainder by 2_i32 is -1_i32, 0_i32, or 1_i32, so divisor is 1_i32 through 3_i32 and is strictly positive\nconclusion: igt(divisor, 0_i32) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range through the wrapping offset\nconsumers: the following exact 84_i32 / divisor operation uses this positive bound to exclude both signed-division failure cases";
  let quotient = 84_i32 / divisor;
  return Ok<i32, Overflow>(value: quotient);
}

fn g(x: own i32) -> result: own Result<i32, Overflow> traps {
  doc "EFF-2: the propagate-scrutinee callee claim capability is declared; row and body agree.";
  let r = propagate risky_checked(x: x);
  return Ok<i32, Overflow>(value: r);
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
