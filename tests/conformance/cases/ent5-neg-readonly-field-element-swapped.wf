nocopy struct Entry {
  readonly width: u64;
  weight: u64;
}

fn main() -> status: ExitStatus pure {
  doc "ENT-5, OP-11: the swap writes both element places, and rows[0] contains the readonly field the guard bounded, so the bound dies; the exchanged element is the wide one and the cell read owes an unproved c < cells.len.";
  let rows = slots_new::<Entry, 4>();
  let narrow = Entry(width: 3_u64, weight: 1_u64);
  let wide = Entry(width: 8_u64, weight: 1_u64);
  place_back(window: &rows, value: move narrow);
  place_back(window: &rows, value: move wide);
  let cells = array_filled::<u8, 3>(value: 7_u8);
  let total = 0_u64;
  if rows.len == 2_u64 {
    if rows[0_u64].width <= cells.len {
      swap(first: &rows[0_u64], second: &rows[1_u64]);
      for (c in 0_u64..rows[0_u64].width) {
        let cell = cells[c];
        let widened = cvt::<u8, u64>(cell);
        set total = total +wrap widened;
      }
    }
  }
  return exit_status(code: 0_u8);
}
