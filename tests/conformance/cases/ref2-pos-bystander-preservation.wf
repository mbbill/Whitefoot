struct BystanderRecord {
  value: u8;
}

fn overwrite_bystander(values: &Array<BystanderRecord, 4>, index: u64) -> result: unit writes(values[index]) contract {
  requires index < 4_u64;
} {
  set deref(values)[index] = BystanderRecord(value: 9_u8);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}

fn inspect_requirement(values: &Array<BystanderRecord, 4>, i: u64, j: u64) -> result: u8 reads(values), writes(values[j]) contract {
  requires i < j;
  requires j < 4_u64;
} {
  let selected = &deref(values)[i].value;
  overwrite_bystander(values: values, index: j);
  return deref(selected);
}

fn inspect_guard(values: &Array<BystanderRecord, 4>, i: u64, j: u64) -> result: u8 reads(values), writes(values[j]) {
  if j < 4_u64 {
    if i < j {
      let selected = &deref(values)[i].value;
      overwrite_bystander(values: values, index: j);
      return deref(selected);
    }
  }
  return 0_u8;
}

fn inspect_capture(values: &Array<BystanderRecord, 4>, i: u64, j: u64) -> result: u8 reads(values), writes(values[j]) contract {
  requires i < j;
  requires j < 4_u64;
} {
  let selected = &deref(values)[i].value;
  set i = j;
  overwrite_bystander(values: values, index: j);
  return deref(selected);
}

fn inspect_unused(values: &Array<BystanderRecord, 4>, i: u64, j: u64) -> result: unit writes(values[j]) contract {
  requires i < 4_u64;
  requires j < 4_u64;
} {
  let selected = &deref(values)[i].value;
  overwrite_bystander(values: values, index: j);
  return unit;
}

fn inspect_join(values: &Array<BystanderRecord, 4>, i: u64, j: u64, k: u64, choose: Bool) -> result: u8 reads(values), writes(values[j]) contract {
  requires i < j;
  requires k < j;
  requires j < 4_u64;
} {
  let first = &deref(values)[i].value;
  let second = &deref(values)[k].value;
  let selected = first;
  if choose {
    set selected = &deref(second);
  }
  overwrite_bystander(values: values, index: j);
  return deref(selected);
}

fn inspect_loop(values: &Array<BystanderRecord, 4>, i: u64, j: u64) -> result: unit reads(values), writes(values[j]) contract {
  requires i < 4_u64;
  requires j < 4_u64;
  requires i < j;
} {
  let selected = &deref(values)[i].value;
  let alias = selected;
  for (round in 0_u64..2_u64) {
    let observed = deref(alias);
    overwrite_bystander(values: values, index: j);
  }
  return unit;
}

fn inspect_direct_write(values: &Array<BystanderRecord, 4>, i: u64, j: u64) -> result: u8 reads(values), writes(values[j]) contract {
  requires i < 4_u64;
  requires j < 4_u64;
  requires i < j;
} {
  let selected = &deref(values)[i].value;
  set deref(values)[j] = BystanderRecord(value: 9_u8);
  return deref(selected);
}

fn replace_bystander_index(index: &u64, replacement: u64) -> result: BystanderRecord writes(index) {
  set deref(index) = replacement;
  return BystanderRecord(value: 9_u8);
}

fn inspect_rhs_capture(values: &Array<BystanderRecord, 4>, j: u64) -> result: u8 writes(values) contract {
  requires 0_u64 < j;
  requires j < 4_u64;
} {
  let selected = &deref(values)[0_u64].value;
  let index = j;
  set deref(values)[index] = replace_bystander_index(index: &index, replacement: 0_u64);
  return deref(selected);
}
