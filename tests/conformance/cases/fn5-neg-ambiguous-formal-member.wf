interface Reader<T: copy> {
  fn read(value: own T) -> result: own u64 pure;
}

fn select<interface Reader<A>, interface Reader<B>>(first: own A, second: own B) -> result: own u64 pure {
  return Reader::read(value: first);
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
