fn bump(x: own i32) -> function_result: own i32 pure {
  doc "A pure helper with no claim and no traps-effect callee.";
  return x +wrap 1_i32;
}

fn f(x: own i32) -> function_result: own i32 traps {
  doc "Declares traps but its body only calls a pure fn [EFF-2] declared-but-unexhibited.";
  let a = bump(x: x);
  return a;
}

command fn main() -> status: own ExitStatus traps {
  doc "Driver.";
  let a = f(x: 7_i32);
  return exit_status(code: 0_u8);
}
