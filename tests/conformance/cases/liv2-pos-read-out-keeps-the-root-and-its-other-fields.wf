struct Frame {
  tag: u8;
  run: FixedVector<u8, 4>;
}

fn refresh(old: own FixedVector<u8, 4>) -> fresher: own FixedVector<u8, 4> reads(old) {
  doc "Consumes the run it is handed and hands back another.";
  let seen = len_of(old);
  let fresh = fixed_vector::<u8, 4>();
  return move fresh;
}

command fn main() -> status: own ExitStatus pure {
  doc "LIV-2's read-out sentence: a `move` of a sub-place of a target place is that target's read-out and is not the partial consume that kills the root. The struct's other field is read after the commit, which no dead root admits, and the exit code reports it.";
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 0_u8);
  let two = place_back(vector: move one, value: 0_u8);
  let three = place_back(vector: move two, value: 0_u8);
  let run = place_back(vector: move three, value: 0_u8);
  let frame = Frame(tag: 3_u8, run: move run);
  set frame.run = refresh(old: move frame.run);
  let tag = frame.tag;
  return exit_status(code: tag);
}
