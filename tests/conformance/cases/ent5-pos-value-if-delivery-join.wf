fn guard(value: own i32) -> own unit pure requires {
  check ilt(value, 128_i32) else trap "guard bound";
} {
  return unit;
}

fn choose(value: own i32, narrow: own Bool) -> own i32 traps {
  let picked = if narrow {
    check ilt(value, 8_i32) else trap "narrow bound";
    give value;
  } else {
    check ilt(value, 128_i32) else trap "wide bound";
    give value;
  }
  guard(value: picked);
  return picked;
}

fn main() -> own unit traps {
  let take_narrow = True();
  let narrow = choose(value: 7_i32, narrow: take_narrow);
  check ieq(narrow, 7_i32) else trap "narrow delivery drift";
  let take_wide = False();
  let wide = choose(value: 127_i32, narrow: take_wide);
  check ieq(wide, 127_i32) else trap "wide delivery drift";
  return unit;
}
