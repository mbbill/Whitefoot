fn guard(value: own i32) -> result: own unit pure contract {
  requires ilt(value, 128_i32);
} {
  return unit;
}

fn choose(value: own i32, narrow: own Bool) -> result: own i32 traps {
  let picked = if narrow {
    claim narrow_bound: ilt(value, 8_i32) because "narrow bound";
    give value;
  } else {
    claim wide_bound: ilt(value, 128_i32) because "wide bound";
    give value;
  }
  guard(value: picked);
  return picked;
}

command fn main() -> status: own ExitStatus traps {
  let take_narrow = True();
  let narrow = choose(value: 7_i32, narrow: take_narrow);
  claim narrow_delivery_drift: ieq(narrow, 7_i32) because "narrow delivery drift";
  let take_wide = False();
  let wide = choose(value: 127_i32, narrow: take_wide);
  claim wide_delivery_drift: ieq(wide, 127_i32) because "wide delivery drift";
  return exit_status(code: 0_u8);
}
