enum Flag {
  First();
  Second();
}

fn make_ok(value: own u64) -> own Result<u64, Flag> pure {
  return Ok<u64, Flag>(value: value);
}

fn make_err(second: own Bool) -> own Result<u64, Flag> pure {
  if second {
    let second_atom_0001 = Second();
    return Err<u64, Flag>(error: second_atom_0001);
  } else {
    let first_atom_0002 = First();
    return Err<u64, Flag>(error: first_atom_0002);
  }
}

fn result_code(result: own Result<u64, Flag>) -> own u64 pure {
  match result {
    Ok(value: ok_value) => {
      return ok_value;
    }
    Err(error: result_error) => {
      match result_error {
        First() => {
          return 10_u64;
        }
        Second() => {
          return 20_u64;
        }
      }
    }
  }
}

fn make_some(second: own Bool) -> own Option<Flag> pure {
  if second {
    let second_atom_0003 = Second();
    return Some<Flag>(value: second_atom_0003);
  } else {
    let first_atom_0004 = First();
    return Some<Flag>(value: first_atom_0004);
  }
}

fn make_none() -> own Option<Flag> pure {
  return None<Flag>();
}

fn option_code(option: own Option<Flag>) -> own u64 pure {
  match option {
    None() => {
      return 30_u64;
    }
    Some(value: option_value) => {
      match option_value {
        First() => {
          return 40_u64;
        }
        Second() => {
          return 50_u64;
        }
      }
    }
  }
}

fn main() -> own unit traps {
  let ok = make_ok(value: 7_u64);
  let ok_code = result_code(result: move ok);
  claim ok_payload_drift: ieq(ok_code, 7_u64) because "Ok payload drift";
  let false_atom_0005 = False();
  let first_error = make_err(second: false_atom_0005);
  let first_code = result_code(result: move first_error);
  claim first_payload_drift: ieq(first_code, 10_u64) because "First payload drift";
  let true_atom_0006 = True();
  let second_error = make_err(second: true_atom_0006);
  let second_code = result_code(result: move second_error);
  claim second_payload_drift: ieq(second_code, 20_u64) because "Second payload drift";
  let false_atom_0007 = False();
  let some_first = make_some(second: false_atom_0007);
  let some_first_code = option_code(option: move some_first);
  claim some_first_payload_drift: ieq(some_first_code, 40_u64) because "Some First payload drift";
  let true_atom_0008 = True();
  let some_second = make_some(second: true_atom_0008);
  let some_second_code = option_code(option: move some_second);
  claim some_second_payload_drift: ieq(some_second_code, 50_u64) because "Some Second payload drift";
  let none = make_none();
  let none_code = option_code(option: move none);
  claim none_drift: ieq(none_code, 30_u64) because "None drift";
  return unit;
}
