fn dispose_open_outcome(factory: &uniq HandleFactory, outcome: own Result<ReadFile, IoError>) -> result: own unit pure {
  doc "EFF-2: an explicit conditional close accesses factory, so omitting that ordinary call effect is rejected.";
  match outcome {
    Ok(value: file) => {
      region {
        let closed = close_read(factory: &uniq deref(factory), file: move file);
      }
      return unit;
    }
    Err(error: problem) => {
      return unit;
    }
  }
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
