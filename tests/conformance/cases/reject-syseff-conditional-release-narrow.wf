fn dispose_open_outcome(outcome: own Result<ReadFile, IoError>) -> function_result: own unit pure {
  doc "The near-miss a writer argues is correct because only one branch releases: running on only some paths never weakens writes(outcome), so omitting it is an undeclared effect rejected by EFF-2.";
  match outcome {
    Ok(value: file) => {
      return unit;
    }
    Err(error: problem) => {
      return unit;
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
