fn make['s](store: &uniq Heap<'s>, length: own u64) -> values: own Option<Vector<'s, i64>> reads(store), writes(store), allocates(store) {
  region {
    return heap_vector::<i64>(store: &uniq deref(store), count: length);
  }
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
