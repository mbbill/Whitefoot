enum Sign {
  Neg();
  Zero();
  Pos();
}

command fn main() -> return_value: own ExitStatus traps {
  doc "GRAM-5: literal atom, place atom, borrow_expr atom, deref place, call, construct.";
  let a = 5_i32;
  region 'r {
    let p = &'r a;
    let b = deref(p) +wrap a;
    let s = Zero();
    claim drift: ieq(b, 10_i32) because "drift";
  }
  return exit_status(code: 0_u8);
}
