enum Sign {
  Neg();
  Zero();
  Pos();
}

fn main() -> own unit traps {
  doc "GRAM-5: literal atom, place atom, borrow_expr atom, deref place, call, construct.";
  let a = 5_i32;
  region 'r {
    let p = &'r a;
    let b = deref(p) +wrap a;
    let s = Zero();
    check ieq(b, 10_i32) else trap "drift";
  }
  return unit;
}
