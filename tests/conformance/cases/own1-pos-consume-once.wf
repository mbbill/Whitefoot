enum Sign {
  Neg();
  Zero();
  Pos();
}

command fn main() -> return_value: own ExitStatus pure {
  doc "OWN-1: an affine value (own enum) is consumed by exactly one match-move.";
  let s = Pos();
  match s {
    Neg() => {
      return exit_status(code: 0_u8);
    }
    Zero() => {
      return exit_status(code: 0_u8);
    }
    Pos() => {
      return exit_status(code: 0_u8);
    }
  }
}
