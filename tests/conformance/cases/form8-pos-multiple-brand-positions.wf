struct Marker<T: linear> {
  value: u64;
}

struct Pair<A: linear, B: linear> {
  first: Marker<A>;
  second: Marker<B>;
}

struct Wrapped<A: linear, B: linear> {
  pair: Pair<A, B>;
}

fn second_value(wrapped: &Wrapped<Slots<u8, 1>, Slots<u8, 2>>) -> value: own u64 reads(wrapped.pair.second.value) {
  doc "The reader's parameter type writes both arguments and the place reaches the field by ordinary field steps [GRAM-5, REF-1].";
  return wrapped.pair.second.value;
}

fn main() -> status: own ExitStatus pure {
  doc "FN-2 and TYPE-5: every instantiation argument is written at every nesting depth; there is no position at which an operand supplies one silently.";
  let first = Marker<Slots<u8, 1>>(value: 7_u64);
  let second = Marker<Slots<u8, 2>>(value: 9_u64);
  let pair = Pair<Slots<u8, 1>, Slots<u8, 2>>(first: move first, second: move second);
  let wrapped = Wrapped<Slots<u8, 1>, Slots<u8, 2>>(pair: move pair);
  let value = second_value(wrapped: &wrapped);
  if value == 9_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
