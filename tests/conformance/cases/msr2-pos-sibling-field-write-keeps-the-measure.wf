fn filled<T: copy, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

struct Frame {
  flags: u64;
  tail: FixedVector<u8, 8>;
}

command fn main() -> status: own ExitStatus pure {
  doc "[MSR-2] the support of a measure term over P is P's descriptor storage, not P's root binding. `frame.flags` and `frame.tail` are two disjoint parts of one struct, so a [SET-1] commit to the sibling field overlaps neither the descriptor storage of `frame.tail` nor any holder reached to it, and `len_of(frame.tail)` survives the write. The subscript after the write therefore still discharges against that fact. Under the root-granular reading this rule replaces, the same program was an [OP-4] rejection with the residual 3_u64 < len_of(frame.tail).";
  let body = filled::<u8, 8>(value: 0_u8);
  let frame = Frame(flags: 0_u64, tail: move body);
  let size = len_of(frame.tail);
  if 3_u64 < size {
    set frame.flags = 1_u64;
    let byte = frame.tail[3_u64];
    if byte == 1_u8 {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
