struct Frame {
  flags: u64;
  tail: buffer<u8>;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "[MSR-2] the support of a measure term over P is P's descriptor storage, not P's root binding. `frame.flags` and `frame.tail` are two disjoint parts of one struct, so a [SET-1] commit to the sibling field overlaps neither the descriptor storage of `frame.tail` nor any holder reached to it, and `len(frame.tail)` survives the write. The subscript after the write therefore still discharges against that fact. Under the root-granular reading this rule replaces, the same program was an [OP-4] rejection with the residual 3_u64 < len(frame.tail).";
  let body = buffer_new(8_u64, 0_u8);
  let frame = Frame(flags: 0_u64, tail: move body);
  let size = len(frame.tail);
  if 3_u64 < size {
    set frame.flags = 1_u64;
    let byte = frame.tail[3_u64];
    if byte == 1_u8 {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
