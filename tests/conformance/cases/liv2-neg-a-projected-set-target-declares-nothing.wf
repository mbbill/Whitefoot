struct Frame {
  count: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "SET-1: a set target must resolve to a binding already in scope. A projected target selects one component of a value that must already exist, so a set whose target name resolves to nothing declares nothing and is refused with the restructuring that names let.";
  set absent.count = 4_u64;
  return exit_status(code: 0_u8);
}
