fn need_small(value: own u64) -> function_result: own unit pure contract {
  requires ilt(value, 4_u64);
} {
  return unit;
}

fn guarded(x: own i32) -> function_result: own i32 traps {
  doc "Declares traps and exhibits a claim.";
  let bounded = x % 11_i32;
  let product_defined = bounded *defined 2_i32;
  claim range: product_defined because "premises: bounded is x remainder 11_i32 computed in the current function\nderivation: signed remainder by eleven is between -10_i32 and 10_i32, so multiplying by 2_i32 produces a representable i32\nconclusion: bounded *defined 2_i32 is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following exact multiplication requires both signed product bounds";
  let doubled = bounded * 2_i32;
  return x;
}

fn f(x: own i32) -> function_result: own i32 pure {
  doc "Declares pure but calls a traps fn [EFF-2] undeclared-but-exhibited.";
  let a = guarded(x: x);
  return a;
}

command fn main() -> status: own ExitStatus traps {
  doc "Driver.";
  let a = f(x: 7_i32);
  let seed = 7_u64;
  let bounded = seed % 4_u64;
  let expected = ilt(bounded, 4_u64);
  claim local_bound: expected because "premises: bounded is seed remainder 4_u64 computed in this function\nderivation: unsigned remainder by 4_u64 is at most 3_u64 and therefore strictly less than 4_u64\nconclusion: ilt(bounded, 4_u64) is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following need_small call requires this exact bound";
  need_small(value: bounded);
  return exit_status(code: 0_u8);
}
