fn probe(table: own FixedVector<u8, 4>, lo: own u64, hi: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires lo < hi;
  requires hi <= spare;
} {
  doc "The written certificate sums lo < hi and the published division image 2*half <= span into 2*(mid - hi) <= -1. Over the integers that halves to mid < hi, which with hi <= spare discharges the subscript below [PRF-1, ENT-6, OP-4].";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = lo + half;
  invariant inside: mid < hi {
    use (lo < hi);
    use (2_u64 * half <= span);
  }
  let byte = table[mid];
  return byte;
}

fn main() -> status: own ExitStatus pure {
  let empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq empty, value: 0_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 0_u8);
  }
  let two = move one;
  region {
    place_back(vector: &uniq two, value: 0_u8);
  }
  let three = move two;
  region {
    place_back(vector: &uniq three, value: 0_u8);
  }
  let table = move three;
  let found = probe(table: move table, lo: 0_u64, hi: 4_u64);
  return exit_status(code: found);
}
