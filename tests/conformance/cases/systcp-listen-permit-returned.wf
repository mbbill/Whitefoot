command fn main(command.handles as handles: own HandleFactory) -> status: own ExitStatus reads(handles), writes(handles) {
  doc "SYS-10, SYS-17: `tcp_listen` consumes one `HandlePermit` and, when the host refuses the bind, hands that very permit back inside `ListenFailed` beside the host's error, because no handle was taken. The returned permit is an ordinary owner and binds again; on success `close_listener` returns the credit the listen spent. The checker admits this program and lowering lowers it; the target has no approved row for a TCP submission in this version, so it stops at target qualification, which is not a source-language rejection [QUAL-1].";
  let first = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: 9104_u16);
  let second = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: 9105_u16);
  region {
    match reserve_handle(factory: &uniq handles) {
      Ok(value: permit) => {
        region {
          match tcp_listen(permit: move permit, address: &first) {
            Listening(listener: bound) => {
              let credit = close_listener(listener: move bound);
              return exit_status(code: 0_u8);
            }
            ListenFailed(error: problem, permit: handed_back) => {
              region {
                match tcp_listen(permit: move handed_back, address: &second) {
                  Listening(listener: retry) => {
                    let credit = close_listener(listener: move retry);
                    return exit_status(code: 0_u8);
                  }
                  ListenFailed(error: second_problem, permit: spent) => {
                    return exit_status(code: 3_u8);
                  }
                }
              }
            }
          }
        }
      }
      Err(error: problem) => {
        return exit_status(code: 4_u8);
      }
    }
  }
}
