fn g['r](buf: &'r buffer<i32>, i: own u64) -> own Result<i32, Overflow> reads('r) {
  doc "EFF-2: a bounds-checked index inside a propagate scrutinee exhibits traps; the row omits it.";
  let r: own i32 = propagate iadd.checked<i32>(deref(buf)[i], 1_i32);
  return Ok(value: r);
}

fn main() -> own unit pure {
  return unit;
}
