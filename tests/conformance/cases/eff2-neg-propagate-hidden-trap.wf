fn reviewed_small(value: own i32) -> result: own i32 pure {
  let lower = imax(value, -10_i32);
  return imin(lower, 10_i32);
}

fn risky_checked(x: own i32) -> result: own Result<i32, Overflow> traps {
  doc "A claim behind a Result surface; the row declares traps.";
  let bounded = reviewed_small(value: x);
  let addition_defined = bounded +defined 1_i32;
  claim admitted: addition_defined because "premises: bounded is returned by reviewed_small, whose body clamps x to the closed interval -10_i32 through 10_i32\nderivation: adding 1_i32 produces a value in -9_i32 through 11_i32, which is representable by i32\nconclusion: bounded +defined 1_i32 is true\nchecker gap: ENT does not publish the range of an uncontracted user-call result\nconsumers: the following exact addition requires both signed sum bounds";
  let bumped = bounded + 1_i32;
  return Ok<i32, Overflow>(value: bumped);
}

fn g(x: own i32) -> result: own Result<i32, Overflow> pure {
  doc "EFF-2: a claim-bearing callee as the propagate scrutinee exhibits traps; the row omits it.";
  let r = propagate risky_checked(x: x);
  return Ok<i32, Overflow>(value: r);
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
