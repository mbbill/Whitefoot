fn risky_checked(x: own i32) -> result: own Result<i32, Overflow> traps {
  doc "A claim behind a Result surface; the row declares traps.";
  let bounded = x % 11_i32;
  let addition_defined = bounded +defined 1_i32;
  claim admitted: addition_defined because "premises: bounded is x remainder 11_i32 computed in the current function\nderivation: signed remainder by eleven is between -10_i32 and 10_i32, so adding 1_i32 produces a representable i32\nconclusion: bounded +defined 1_i32 is true\nchecker gap: ENT proves the remainder operation domain but does not publish its result range\nconsumers: the following exact addition requires both signed sum bounds";
  let bumped = bounded + 1_i32;
  return Ok<i32, Overflow>(value: bumped);
}

fn g(x: own i32) -> result: own Result<i32, Overflow> pure {
  doc "EFF-2: a claim-bearing callee as the propagate scrutinee exhibits traps; the row omits it.";
  let r = propagate risky_checked(x: x);
  return Ok<i32, Overflow>(value: r);
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
