fn risky_checked(x: own i32) -> own Result<i32, Overflow> traps {
  doc "A trapping increment behind a Result surface; the row declares traps.";
  let bumped: own i32 = iadd.trap<i32>(x, 1_i32);
  return Ok(value: bumped);
}

fn g(x: own i32) -> own Result<i32, Overflow> pure {
  doc "EFF-2: a trapping callee as the propagate scrutinee exhibits traps; the row omits it.";
  let r: own i32 = propagate risky_checked(x: x);
  return Ok(value: r);
}

fn main() -> own unit pure {
  return unit;
}
