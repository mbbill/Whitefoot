enum State {
  Ready();
}

fn inspect(holder: own Box<State>) -> function_result: own unit pure {
  doc "TYPE-7: a cell holder cannot be matched as its enclosed enum without the explicit deref(holder) place spelling.";
  match holder {
    Ready() => {
    }
  }
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
