enum State {
  Ready();
}

fn inspect(holder: own box<State>) -> function_result: own unit pure {
  doc "TYPE-7: match requires the enum inside a box holder, written match deref(holder).";
  match holder {
    Ready() => {
    }
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
