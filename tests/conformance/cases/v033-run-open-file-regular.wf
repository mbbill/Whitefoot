command fn main(command.cwd as cwd: own DirectoryRead, command.handles as files: own HandleFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  let name = fixed_vector::<u8, 4>();
  set name = place_back(vector: move name, value: 105_u8);
  set name = place_back(vector: move name, value: 116_u8);
  set name = place_back(vector: move name, value: 101_u8);
  set name = place_back(vector: move name, value: 109_u8);
  region 'c {
    let component = slice_of(&name);
    region {
      match reserve_handle(factory: &uniq 'c files) {
        Ok(value: permit) => {
          match open_file(permit: move permit, root: &'c cwd, name: &component, start: 0_u64, end: 4_u64) {
            FileOpened(value: file) => {
              return exit_status(code: 0_u8);
            }
            FileOpenFailed(error: problem, permit: refused) => {
              return exit_status(code: 1_u8);
            }
          }
        }
        Err(error: spent) => {
          return exit_status(code: 2_u8);
        }
      }
    }
  }
}
