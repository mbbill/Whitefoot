command fn main['qw, 'dhw, 'dw, 'fw, 'rhw, 'rcw](command.cwd as cwd: own DirectoryRead<'qw, 'dhw, 'dw, 'fw>) -> status: own ExitStatus reads('dhw 'dw 'fw), writes('qw 'dhw 'rhw 'rcw), allocates(heap) {
  let name = buffer_new(4_u64, 0_u8);
  set name[0_u64] = 105_u8;
  set name[1_u64] = 116_u8;
  set name[2_u64] = 101_u8;
  set name[3_u64] = 109_u8;
  region 'c {
    region 'n {
      match open_file<'c, 'n, 'qw, 'dhw, 'dw, 'fw, 'rhw, 'rcw>(root: &'c cwd, name: &'n name, start: 0_u64, end: 4_u64) {
        Ok(value: file) => {
          return exit_status(code: 0_u8);
        }
        Err(error: problem) => {
          return exit_status(code: 1_u8);
        }
      }
    }
  }
}
