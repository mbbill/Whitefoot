command fn main(command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files) {
  let name = buffer_new(4_u64, 0_u8);
  set name[0_u64] = 105_u8;
  set name[1_u64] = 116_u8;
  set name[2_u64] = 101_u8;
  set name[3_u64] = 109_u8;
  region 'c {
    region {
      let permit = reserve_file(factory: &uniq 'c files);
      match open_file(permit: move permit, root: &'c cwd, name: &name, start: 0_u64, end: 4_u64) {
        Ok(value: file) => {
          return exit_status(code: 0_u8);
        }
        Err(error: problem) => {
          return exit_status(code: 1_u8);
        }
      }
    }
  }
}
