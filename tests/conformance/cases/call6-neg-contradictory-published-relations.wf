fn measure(taken: own FixedVector<u8, 4>) -> measured: own u64 reads(taken) contract {
  ensures measured <= len_of(taken);
  ensures len_of(taken) < measured;
} {
  doc "The two published relations cannot hold together, so every caller goal would discharge from the contradiction alone.";
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "CALL-6: a contract whose published relations instantiate to a contradiction is refused at the declaration.";
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 0_u8);
  let two = place_back(vector: move one, value: 0_u8);
  let three = place_back(vector: move two, value: 0_u8);
  let run = place_back(vector: move three, value: 0_u8);
  let measured = measure(taken: move run);
  return exit_status(code: 0_u8);
}
