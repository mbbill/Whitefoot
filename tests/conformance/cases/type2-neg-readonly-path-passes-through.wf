struct Header {
  version: u64;
}

struct Frame {
  readonly header: Header;
  size: u64;
}

fn main() -> status: own ExitStatus pure {
  doc "TYPE-2: a set target whose path passes through a readonly field is refused as well, because writing below the field changes the field's value.";
  let h = Header(version: 1_u64);
  let f = Frame(header: h, size: 0_u64);
  set f.header.version = 2_u64;
  return exit_status(code: 0_u8);
}
