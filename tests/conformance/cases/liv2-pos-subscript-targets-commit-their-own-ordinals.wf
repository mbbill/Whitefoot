fn two_bytes(bound: own u64) -> (small: own u8, large: own u8) pure {
  doc "Two results from one call.";
  return 1_u8, 2_u8;
}

command fn main() -> status: own ExitStatus pure {
  doc "LIV-2 admits a subscript in a target list: every target's offset is evaluated before the commit, and ordinal i lands at target i. The two runs are non-overlapping places, so the second condition admits the pair; the exit code reports the byte the second target received.";
  let left_empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq left_empty, value: 0_u8);
  }
  let left_one = move left_empty;
  region {
    place_back(vector: &uniq left_one, value: 0_u8);
  }
  let left_two = move left_one;
  region {
    place_back(vector: &uniq left_two, value: 0_u8);
  }
  let left_three = move left_two;
  region {
    place_back(vector: &uniq left_three, value: 0_u8);
  }
  let left = move left_three;
  let right_empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq right_empty, value: 0_u8);
  }
  let right_one = move right_empty;
  region {
    place_back(vector: &uniq right_one, value: 0_u8);
  }
  let right_two = move right_one;
  region {
    place_back(vector: &uniq right_two, value: 0_u8);
  }
  let right_three = move right_two;
  region {
    place_back(vector: &uniq right_three, value: 0_u8);
  }
  let right = move right_three;
  set (left[0_u64], right[0_u64]) = two_bytes(bound: 4_u64);
  let seen = right[0_u64];
  return exit_status(code: seen);
}
