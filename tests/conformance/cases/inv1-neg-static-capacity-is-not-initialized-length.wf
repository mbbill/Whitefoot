struct StaticBlock {
  bytes: Slots<u8, 4>;
}

fn take_static(free: &Slots<StaticBlock, 2>) -> block: own StaticBlock writes(free) contract {
  requires deref(free).len > 0_u64;
  ensures deref(free).len + 1_u64 == deref(entry(free)).len;
  ensures deref(free).room == deref(entry(free)).room + 1_u64;
} {
  doc "Takes the last stocked block out of the pool and publishes what that did to the pool alone.";
  let block = take_back(window: free);
  return move block;
}

fn return_static(free: &Slots<StaticBlock, 2>, block: own StaticBlock) -> result: own unit writes(free) contract {
  requires deref(free).room > 0_u64;
  ensures deref(free).len == deref(entry(free)).len + 1_u64;
} {
  doc "Puts one block back into the pool.";
  place_back(window: free, value: move block);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  doc "INV-1: the constant extent of Slots<u8, 4> fixes capacity, not initialized length. The helper publishes the pool's own measures and nothing about the block it hands back, and a window operation carries no measure through the slot it writes, so the caller cannot recover that the four slots are initialized even though it stocked a full window itself.";
  let bytes = array_filled::<u8, 4>(value: 0_u8);
  let payload = slots_from_array::<u8, 4>(values: move bytes);
  let record = StaticBlock(bytes: move payload);
  let free = slots_new::<StaticBlock, 2>();
  place_back(window: &free, value: move record);
  let block = take_static(free: &free);
  invariant initialized: block.bytes.len >= 4_u64;
  let length = block.bytes.len;
  let sum = 0_u8;
  for (at in 0_u64..length) {
    let byte = block.bytes[at];
    set sum = sum +wrap byte;
  }
  return_static(free: &free, block: move block);
  return exit_status(code: sum);
}
