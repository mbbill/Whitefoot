fn negate(n: own i32) -> return_value: own i32 pure {
  doc "The same `-1` divisor with a dominating branch bounding the dividend above i32::MIN [ENT-3]. Both conjuncts of the division obligation discharge in the complete state [ENT-6], so the site keeps no runtime test and the row stays `pure`.";
  if n > -2147483648_i32 {
    let m = n / -1_i32;
    return m;
  }
  return 0_i32;
}

command fn main() -> return_value: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
