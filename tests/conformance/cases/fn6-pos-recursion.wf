fn sumto(n: own i32) -> own i32 traps {
  doc "Recursion is permitted [FN-6].";
  if ieq(n, 0_i32) {
    return 0_i32;
  } else {
    let m = n - 1_i32;
    let r = sumto(n: m);
    return n + r;
  }
}

fn main() -> own unit traps {
  let s = sumto(n: 4_i32);
  check ieq(s, 10_i32) else trap "recursion drift";
  return unit;
}
