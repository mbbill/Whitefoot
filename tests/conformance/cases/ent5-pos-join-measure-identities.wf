fn get(b: own Slice<u8>, i: own u64, pick: own Bool) -> result: own u8 reads(b) {
  if pick {
    let room_a = len_of(b);
    let inside_a = i < room_a;
    if inside_a {
    } else {
      return 0_u8;
    }
  } else {
    let room_b = len_of(b);
    let inside_b = i < room_b;
    if inside_b {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

fn store_byte(out: &uniq MutSlice<u8>, i: own u64, value: own u8, pick: own Bool) -> result: own unit reads(out), writes(out) {
  let spare = len_of(deref(out));
  if pick {
    let direct_bound = i < spare;
    if direct_bound {
    } else {
      return unit;
    }
  } else {
    let reversed_bound = spare > i;
    if reversed_bound {
    } else {
      return unit;
    }
  }
  set deref(out)[i] = value;
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
