fn shrink(handle: &uniq buffer<u8>) -> discarded: own buffer<u8> reads(handle), writes(handle) {
  doc "Replaces the whole referent and hands the old run back.";
  let smaller = buffer_new(2_u64, 0_u8);
  let old = replace deref(handle) = move smaller;
  return move old;
}

command fn main() -> status: own ExitStatus pure {
  doc "[CALL-5] no transport reads the actual's spelling. This is the D1 program with the borrow bound to a name and moved into the call rather than written at the argument position, which is a different checked argument shape reaching the same declared parameter. The two spellings differ in nothing a transport may read, so this program reaches the same [OP-4] rejection with the residual 9_u64 < len_of(line) that the directly spelled one does: the classification belongs to the callee's declaration and the caller's borrow form moves nothing.";
  let line = buffer_new(10_u64, 0_u8);
  region {
    let handle = &uniq line;
    let dropped = shrink(handle: move handle);
  }
  let tail = line[9_u64];
  return exit_status(code: 0_u8);
}
