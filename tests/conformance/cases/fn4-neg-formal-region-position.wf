struct Cell {
  value: u8;
}

interface FirstValue {
  fn read(x: &Cell, y: &Cell) -> result: own u8 reads(x.value);
}

fn second_value(first: &Cell, second: &Cell) -> result: own u8 reads(second.value) {
  doc "The row names the second parameter ordinal where the formal names the first.";
  return deref(second).value;
}

binding Wrong : FirstValue {
  read = second_value;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
