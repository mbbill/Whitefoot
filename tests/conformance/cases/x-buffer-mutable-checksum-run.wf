fn main() -> own unit allocates(heap), traps {
  doc "A runtime-length buffer is allocated, filled, folded, and released; loop claims discharge its indexed access.";
  let values = buffer_new(8_u64, 0_u64);
  let length = len(values);
  let cursor = 0_u64;
  loop @fill {
    if ieq(cursor, length) {
      break @fill;
    }
    let fill_in_range = ilt(cursor, length);
    claim fill_cursor_in_range: fill_in_range because "the fill walks 0..length and breaks at length";
    set values[cursor] = cursor +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  set cursor = 0_u64;
  let total = 0_u64;
  loop @fold {
    if ieq(cursor, length) {
      break @fold;
    }
    let fold_in_range = ilt(cursor, length);
    claim fold_cursor_in_range: fold_in_range because "the fold walks 0..length and breaks at length";
    let value = values[cursor];
    set total = total +wrap value;
    set cursor = cursor +wrap 1_u64;
  }
  claim mutable_buffer_checksum_drift: ieq(total, 36_u64) because "mutable buffer checksum drift";
  return unit;
}
