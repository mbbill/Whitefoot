command fn main() -> status: own ExitStatus pure {
  doc "A runtime-length buffer is allocated, filled, folded, and released; counted-loop range facts discharge every indexed access.";
  let values = buffer_new(8_u64, 0_u64);
  let length = len_of(values);
  for (fill_index in 0_u64..length) {
    set values[fill_index] = fill_index +wrap 1_u64;
  }
  let total = 0_u64;
  for (fold_index in 0_u64..length) {
    let value = values[fold_index];
    set total = total +wrap value;
  }
  if total == 36_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
