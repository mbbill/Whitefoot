fn get(b: own buffer<u8>, pick: own Bool) -> result: own u8 traps {
  doc "Facts attach to terms, not to spellings. The arm-local `offset` is bounded by a claim, but that fact dies on the edge leaving its scope [ENT-5](d) before any join, and the later binding of the same spelling is a different term inheriting nothing [ENT-2], so its subscript is undischarged [OP-4].";
  let room = len(b);
  if pick {
    let offset = 0_u64;
    let inside = ilt(offset, room);
    claim the_buffer_is_empty: inside because "the buffer is empty";
  }
  let offset = 0_u64;
  return b[offset];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
