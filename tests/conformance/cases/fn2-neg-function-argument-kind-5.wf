formal Inspect<T: linear> {
  fn inspect(value: &T) -> result: own unit pure;
}

fn ignore['s](value: &Box<'s, u64>) -> result: own unit pure {
  return unit;
}

actual Bound['s] : Inspect<Box<'s, u64>> {
  inspect = ignore;
}

fn spare() -> result: own unit pure {
  return unit;
}

struct Holder<Inspect<T>> {
  value: T;
}

fn inspect(value: &Holder<Bound<fn spare>>) -> result: own unit pure {
  return unit;
}

fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
