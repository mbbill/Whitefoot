command fn main() -> status: own ExitStatus allocates(heap) {
  doc "[MSR-1] the four measures are one quantity read two ways, a term and an [OP-1] reader. This version's measure table gives every cell of every measured type an exact value: an array's len and cap are its N, a buffer's and a slice's cap is its own extent, and room and head are zero everywhere because each of the three is completely initialized over its whole capacity at its formation. The program reads all four over a buffer, an array and a slice and observes those values.";
  let run = buffer_new(8_u64, 0_u8);
  let fixed = array_new::<u8, 4>(0_u8);
  let run_length = len_of(run);
  let run_capacity = cap_of(run);
  let run_room = room_of(run);
  let run_head = head_of(run);
  let fixed_length = len_of(fixed);
  let fixed_capacity = cap_of(fixed);
  let fixed_room = room_of(fixed);
  let fixed_head = head_of(fixed);
  region {
    let view = slice_of(&run);
    let view_length = len_of(view);
    let view_capacity = cap_of(view);
    let view_room = room_of(view);
    let view_head = head_of(view);
    if view_length == 8_u64 {
      if view_capacity == 8_u64 {
        if view_room == 0_u64 {
          if view_head == 0_u64 {
          } else {
            return exit_status(code: 4_u8);
          }
        } else {
          return exit_status(code: 3_u8);
        }
      } else {
        return exit_status(code: 2_u8);
      }
    } else {
      return exit_status(code: 1_u8);
    }
  }
  if run_length == 8_u64 {
    if run_capacity == 8_u64 {
      if run_room == 0_u64 {
        if run_head == 0_u64 {
          if fixed_length == 4_u64 {
            if fixed_capacity == 4_u64 {
              if fixed_room == 0_u64 {
                if fixed_head == 0_u64 {
                  return exit_status(code: 0_u8);
                }
              }
            }
          }
        }
      }
    }
  }
  return exit_status(code: 5_u8);
}
