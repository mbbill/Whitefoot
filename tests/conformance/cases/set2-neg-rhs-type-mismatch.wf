struct Item {
  value: u64;
}

struct Replacement {
  tag: u64;
}

struct Slot {
  item: Item;
}

fn main() -> status: own ExitStatus pure {
  doc "swap exchanges the values at two owned places of one type, and both places receive the same exact type judgment TYPE-5 states. An own Replacement place for an own Item place has no mode coercion, conversion, or target-selected overload, so the exchange is a hard error citing TYPE-5.";
  let first = Item(value: 1_u64);
  let slot = Slot(item: move first);
  let wrong = Replacement(tag: 2_u64);
  swap(first: &slot.item, second: &wrong);
  return exit_status(code: 0_u8);
}
