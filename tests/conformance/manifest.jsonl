{"id": "fn8-neg-external-actual-without-fact", "rules": ["FN-8", "OP-4", "ENT-6", "SYS-2"], "expect": {"kind": "reject", "rule": "FN-8"}, "status": "runnable", "doc": "Passing a system-derived index to a requires-protected callee without a caller fact leaves the instantiated requirement unproved. The callee requirement cannot bootstrap its own caller proof."}
{"id": "fn8-pos-external-actual-after-branch", "rules": ["FN-8", "OP-4", "ENT-3", "ENT-6", "SYS-2"], "expect": {"kind": "run", "exit": 0}, "status": "runnable", "doc": "A real caller branch proves the instantiated requirement for a system-derived index. The verified requirement then enters the callee body and discharges its subscript, with no provenance side channel or runtime fallback."}
