{"id": "type5-pos-index-element-type-derived", "rules": ["TYPE-5", "OP-4"], "expect": {"kind": "accept"}, "status": "runnable", "doc": "The subscript element type derives from its array base, while the deterministic unsigned-remainder range supplies the exact bound [TYPE-5, OP-4]."}
{"id": "type7-neg-index-box-holder", "rules": ["TYPE-7", "OP-4"], "expect": {"kind": "reject", "rule": "TYPE-7"}, "status": "runnable", "doc": "Indexing through a box holder requires explicit deref before the indexed buffer place."}
