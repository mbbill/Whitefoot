fn pair_sum(first: own u64, first_limit: own u64, second: own u64, second_limit: own u64) -> result: own unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
} {
  doc "Expect REJECT [PRF-1 redundant use block]: the outer target is already discharged by AUTO's coefficient-one pair rule (two distinct premises, coefficient one each) without any use block, so the nonempty use block below naming the very same two premises is redundant.";
  invariant pair_bound: first + second <= first_limit + second_limit {
    use first <= first_limit;
    use second <= second_limit;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
