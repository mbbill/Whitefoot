fn triple_sum(a: own u8, a_limit: own u8, b: own u8, b_limit: own u8, c: own u8, c_limit: own u8) -> result: own unit pure contract {
  requires ile(a, a_limit);
  requires ile(b, b_limit);
  requires ile(c, c_limit);
} {
  doc "expect ACCEPT: three premises combined with explicit factor 1 each; sum is exact and true.";
  invariant total_bound: ile(a + b + c, a_limit + b_limit + c_limit) {
    use ile(a, a_limit);
    use ile(b, b_limit);
    use ile(c, c_limit);
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
