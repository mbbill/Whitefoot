fn triple_use(a: own u8, a_limit: own u8, b: own u8, b_limit: own u8, c: own u8, c_limit: own u8) -> result: own unit pure contract {
  requires ile(a, a_limit);
  requires ile(b, b_limit);
  requires ile(c, c_limit);
} {
  doc "expect REJECT PRF-1 RepeatedUse: the same named premise is used three times instead of one combined factor of 3.";
  invariant sum_bound: ile(a + b + c, a_limit + b_limit + c_limit) {
    use ile(a, a_limit);
    use ile(b, b_limit);
    use ile(c, c_limit);
  }
  invariant scaled_bound: ile(3_u8 * a + 3_u8 * b + 3_u8 * c, 3_u8 * a_limit + 3_u8 * b_limit + 3_u8 * c_limit) {
    use sum_bound;
    use sum_bound;
    use sum_bound;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
