fn chain_then_kill(first: own u8, first_limit: own u8, second: own u8, second_limit: own u8, replacement: own u8) -> result: own unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
} {
  doc "Expect REJECT: invariant `chained` is proven from `pair_bound` via a certificate, publishing a fact; `first` is then overwritten, and a third invariant tries to `use chained` again as if it still held for the new value of `first` -- the published fact must be killed by the write.";
  invariant pair_bound: first + second <= first_limit + second_limit;
  invariant chained: 3_u8 * first + 3_u8 * second <= 3_u8 * first_limit + 3_u8 * second_limit {
    use 3 * pair_bound;
  }
  set first = replacement;
  invariant reused: 9_u8 * first + 9_u8 * second <= 9_u8 * first_limit + 9_u8 * second_limit {
    use 3 * chained;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
