fn scale_zero(first: own u64, first_limit: own u64, second: own u64, second_limit: own u64) -> result: own unit pure contract {
  requires ile(first, first_limit);
  requires ile(second, second_limit);
} {
  doc "expect REJECT: an explicit use factor of zero drops the premise entirely and cannot combine to the target.";
  invariant pair_bound: ile(first + second, first_limit + second_limit);
  invariant scaled_bound: ile(3_u64 * first + 3_u64 * second, 3_u64 * first_limit + 3_u64 * second_limit) {
    use 0 * pair_bound;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
