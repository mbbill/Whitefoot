fn use_then_write(first: own u8, first_limit: own u8, second: own u8, second_limit: own u8, replacement: own u8) -> result: own u8 pure contract {
  requires ile(first, first_limit);
  requires ile(second, second_limit);
} {
  doc "Expect ACCEPT: the use block cites pair_bound and proves scaled_bound BEFORE the write to `first`; the later `set first = replacement;` must not retroactively invalidate the already-proven invariant.";
  invariant pair_bound: ile(first + second, first_limit + second_limit);
  invariant scaled_bound: ile(3_u8 * first + 3_u8 * second, 3_u8 * first_limit + 3_u8 * second_limit) {
    use 3 * pair_bound;
  }
  set first = replacement;
  return second;
}

command fn main() -> status: own ExitStatus pure {
  let result = use_then_write(first: 1_u8, first_limit: 4_u8, second: 2_u8, second_limit: 4_u8, replacement: 9_u8);
  return exit_status(code: result);
}
