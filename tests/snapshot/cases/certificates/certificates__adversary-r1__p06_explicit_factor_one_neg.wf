fn identity_scale(x: own u64, limit: own u64) -> result: own unit pure contract {
  requires x <= limit;
} {
  doc "expect REJECT PRF-1 InvalidSourceProof: an explicitly written multiplicity of one on a use is not canonical.";
  invariant bound_a: x <= limit;
  invariant bound_b: x <= limit {
    use 1 times bound_a;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
