fn identity_scale(x: own u64, limit: own u64) -> result: own unit pure contract {
  requires ile(x, limit);
} {
  doc "expect REJECT PRF-1 InvalidSourceProof: explicit 1 * multiplier on a use is not canonical.";
  invariant bound_a: ile(x, limit);
  invariant bound_b: ile(x, limit) {
    use 1 * bound_a;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
