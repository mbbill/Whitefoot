fn mismatched(first: own u8, first_limit: own u8, second: own u8, second_limit: own u8, third: own u8, third_limit: own u8) -> result: own unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
  requires third <= third_limit;
  requires first_limit <= 20_u8;
  requires second_limit <= 20_u8;
  requires third_limit <= 20_u8;
} {
  doc "Expect REJECT: three named premises combined with explicit factors 2,3,5 whose weighted sum (2p+3q+5r style bound) does not match the target's uniform-2 coefficients; the combination is arithmetically inexact and must not be discharged by the certificate.";
  invariant first_bound: first <= first_limit;
  invariant second_bound: second <= second_limit;
  invariant third_bound: third <= third_limit;
  invariant total_bound: 2_u8 * first + 2_u8 * second + 2_u8 * third <= 2_u8 * first_limit + 2_u8 * second_limit + 2_u8 * third_limit {
    use 2 * first_bound;
    use 3 * second_bound;
    use 5 * third_bound;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
