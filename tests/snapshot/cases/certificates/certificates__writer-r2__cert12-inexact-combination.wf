fn narrow(x: own u16, mid: own u16) -> result: own u16 pure contract {
  requires ile(x, mid);
  requires ile(mid, 60000_u16);
} {
  doc "REJECT [PRF-1]: the summed premises only bound x by 60000, two above too_tight's stated 59998, so DIRECT(T - S) cannot succeed.";
  invariant too_tight: ile(x, 59998_u16) {
    use ile(x, mid);
    use ile(mid, 60000_u16);
  }
  return x;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
