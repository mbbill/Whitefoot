fn triple_cite(first: own u64, first_limit: own u64, second: own u64, second_limit: own u64) -> result: own unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
} {
  doc "Expect REJECT [PRF-1 duplicate premise]: same named earlier invariant cited three times (once bare, twice with explicit factor) in one use-block.";
  invariant pair_bound: first + second <= first_limit + second_limit;
  invariant scaled_bound: 5_u64 * first + 5_u64 * second <= 5_u64 * first_limit + 5_u64 * second_limit {
    use pair_bound;
    use 2 times pair_bound;
    use 2 times pair_bound;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
