fn probe<const n: u64>(table: own FixedVector<u8, n>, lo: own u64, hi: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires lo < hi;
  requires hi <= spare;
} {
  doc "expect ACCEPT: invariant certificate combines a define-derived fact (spare = len_of(table)) with a named division-bound invariant and a requires premise, matching the midpoint-subscript pattern with an extra layer.";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = lo + half;
  invariant half_bound: 2_u64 * half <= span;
  invariant inside: mid < hi {
    use (lo < hi);
    use half_bound;
  }
  let byte = table[mid];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 4>();
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  let found = probe::<4>(table: move table, lo: 0_u64, hi: 4_u64);
  return exit_status(code: found);
}
