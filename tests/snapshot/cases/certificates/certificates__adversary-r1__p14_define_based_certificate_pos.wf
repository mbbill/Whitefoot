fn probe(table: own buffer<u8>, lo: own u64, hi: own u64) -> found: own u8 reads(table) contract {
  define room = len(table);
  requires lo < hi;
  requires hi <= room;
} {
  doc "expect ACCEPT: invariant certificate combines a define-derived fact (room = len(table)) with a named division-bound invariant and a requires premise, matching the midpoint-subscript pattern with an extra layer.";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = lo + half;
  invariant half_bound: 2_u64 * half <= span;
  invariant inside: mid < hi {
    use lo < hi;
    use half_bound;
  }
  let byte = table[mid];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let table = buffer_new(4_u64, 0_u8);
  let found = probe(table: move table, lo: 0_u64, hi: 4_u64);
  return exit_status(code: found);
}
