fn probe(table: own buffer<u8>, idx: own u64, limit: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires idx < limit;
  requires limit <= spare;
} {
  doc "expect REJECT fact killed by write: bound_a is proved for the pre-write value of idx; idx is then overwritten to 255 and bound_b explicitly uses bound_a to justify table[idx]. idx=255 against a 4-byte table is an out-of-bounds read if this stale reuse is accepted.";
  let spare = len_of(table);
  invariant bound_a: idx < spare;
  set idx = 255_u64;
  invariant bound_b: idx < spare {
    use bound_a;
  }
  let byte = table[idx];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let table = buffer_new(4_u64, 0_u8);
  let found = probe(table: move table, idx: 1_u64, limit: 4_u64);
  return exit_status(code: found);
}
