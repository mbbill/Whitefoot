fn mixed_forms(first: own u8, first_limit: own u8, second: own u8, second_limit: own u8, third: own u8, third_limit: own u8) -> result: own unit pure contract {
  requires ile(first, first_limit);
  requires ile(second, second_limit);
  requires ile(third, third_limit);
  requires ile(first_limit, 40_u8);
  requires ile(second_limit, 40_u8);
  requires ile(third_limit, 40_u8);
} {
  doc "SNAPSHOT REJECT [PRF-1]: the finder expected ACCEPT for a mixed named-and-relation use block, but AUTO already proves the weakened target from the same entering context, so the block is redundant and PRF-1 rejects it.";
  invariant pair_bound: ile(first + second, first_limit + second_limit);
  invariant combined: ile(2_u8 * first + 2_u8 * second + third, 2_u8 * first_limit + 2_u8 * second_limit + third_limit + 3_u8) {
    use 2 * pair_bound;
    use ile(third, third_limit);
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
