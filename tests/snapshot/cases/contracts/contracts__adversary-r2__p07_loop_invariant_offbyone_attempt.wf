fn get_bounded<const n: u64>(b: own FixedVector<u8, n>, i: own u64) -> (rest: own FixedVector<u8, n>, value: own u8) reads(b) contract {
  define spare = len_of(b);
  requires i < spare;
  ensures len_of(rest) == spare;
} {
  let value = b[i];
  return move b, value;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: the header invariant only proves i <= n (i may equal n), which is too weak to discharge get_bounded's requires i < spare at i == n; if this is accepted, concrete state buf has len 5 and the last loop iterate calls get_bounded with i = 5, reading one past the end.";
  let buf = fixed_vector::<u8, 5>();
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  let n = len_of(buf);
  let acc = 0_u64;
  let past_end = n +wrap 1_u64;
  for (
    i in 0_u64..past_end,
    invariant bounded: i <= n,
    invariant kept: len_of(buf) >= n
  ) {
    set (buf, byte) = get_bounded::<5>(b: move buf, i: i);
    let widened = cvt::<u8, u64>(byte);
    set acc = acc +wrap widened;
  }
  if acc == 15_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
