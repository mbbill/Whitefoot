fn get_bounded['r](b: &'r buffer<u8>, i: own u64) -> value: own u8 reads(b) contract {
  define room = len(deref(b));
  requires ilt(i, room);
} {
  return deref(b)[i];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "EXPECT REJECT: the header invariant only proves ile(i, n) (i may equal n), which is too weak to discharge get_bounded's requires ilt(i, room) at i == n; if this is accepted, concrete state buf has len 5 and the last loop iterate calls get_bounded with i = 5, reading one past the end.";
  let buf = buffer_new(5_u64, 3_u8);
  let n = len(buf);
  let acc = 0_u64;
  let past_end = n +wrap 1_u64;
  region 'r {
    let p = &'r buf;
    for (
      i in 0_u64..past_end,
      invariant bounded: ile(i, n)
    ) {
      let byte = get_bounded<'r>(b: p, i: i);
      let widened = cvt<u8, u64>(byte);
      set acc = acc +wrap widened;
    }
  }
  if ieq(acc, 15_u64) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
