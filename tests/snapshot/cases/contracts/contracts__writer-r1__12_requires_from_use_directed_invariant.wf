fn combined_probe<const n: u64>(table: own FixedVector<u8, n>, first: own u64, first_limit: own u64, second: own u64, second_limit: own u64, third: own u64, third_limit: own u64) -> byte: own u8 reads(table) contract {
  define spare = len_of(table);
  requires first <= first_limit;
  requires second <= second_limit;
  requires third <= third_limit;
  requires first_limit <= 3_u64;
  requires second_limit <= 3_u64;
  requires third_limit <= 3_u64;
  requires spare >= 10_u64;
} {
  invariant component_sum: first + second + third <= first_limit + second_limit + third_limit {
    use (first <= first_limit);
    use (second <= second_limit);
    use (third <= third_limit);
  }
  invariant limit_sum: first_limit + second_limit + third_limit <= 9_u64;
  invariant total_bound: first + second + third <= 9_u64;
  let first_two = first + second;
  let sum = first_two + third;
  let byte = table[sum];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: an explicit use directed local invariant combines three published premises to establish a subscript's domain obligation.";
  let table = fixed_vector::<u8, 12>();
  for (
    at_table in 0_u64..12_u64,
    invariant grown_table: len_of(table) >= at_table,
    invariant spare_table: room_of(table) + at_table >= 12_u64,
    invariant flat_table: head_of(table) <= 0_u64
  ) {
    set table = place_back(vector: move table, value: 3_u8);
  }
  let byte = combined_probe::<12>(table: move table, first: 2_u64, first_limit: 3_u64, second: 3_u64, second_limit: 3_u64, third: 3_u64, third_limit: 3_u64);
  if byte == 3_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
