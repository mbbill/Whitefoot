fn store_at(out: &uniq buffer<u8>, offset: own u64, value: own u8) -> result: own unit writes(out) contract {
  define spare = len_of(deref(out));
  requires offset < spare;
} {
  set deref(out)[offset] = value;
  return unit;
}

fn fill_all(out: &uniq buffer<u8>, value: own u8) -> result: own unit reads(out), writes(out) {
  let spare = len_of(deref(out));
  for (i in 0_u64..spare) {
    store_at(out: &uniq deref(out), offset: i, value: value);
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: a header invariant on the write cursor establishes the store requires on every reborrowed call.";
  let target = buffer_new(4_u64, 0_u8);
  region {
    let handle = &uniq target;
    fill_all(out: move handle, value: 5_u8);
  }
  let last = target[3_u64];
  if last == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
