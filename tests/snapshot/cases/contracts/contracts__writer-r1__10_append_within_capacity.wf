fn store_at['r](out: &uniq 'r buffer<u8>, offset: own u64, value: own u8) -> result: own unit writes(out) contract {
  define room = len(deref(out));
  requires ilt(offset, room);
} {
  set deref(out)[offset] = value;
  return unit;
}

fn fill_all['r](out: &uniq 'r buffer<u8>, value: own u8) -> result: own unit reads(out), writes(out) {
  let room = len(deref(out));
  for (i in 0_u64..room) {
    region 'store_child {
      store_at<'store_child>(out: &uniq 'store_child deref(out), offset: i, value: value);
    }
  }
  return unit;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "ACCEPT: a header invariant on the write cursor establishes the store requires on every reborrowed call.";
  let target = buffer_new(4_u64, 0_u8);
  region 'fill_region {
    let handle = &uniq 'fill_region target;
    fill_all<'fill_region>(out: move handle, value: 5_u8);
  }
  let last = target[3_u64];
  if ieq(last, 5_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
