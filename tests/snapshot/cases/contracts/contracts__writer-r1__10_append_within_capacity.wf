fn store_at(out: &uniq MutSlice<u8>, offset: own u64, value: own u8) -> result: own unit writes(out) contract {
  define spare = len_of(deref(out));
  requires offset < spare;
} {
  set deref(out)[offset] = value;
  return unit;
}

fn fill_all(out: &uniq MutSlice<u8>, value: own u8) -> result: own unit reads(out), writes(out) {
  let spare = len_of(deref(out));
  for (i in 0_u64..spare) {
    store_at(out: &uniq deref(out), offset: i, value: value);
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: a header invariant on the write cursor establishes the store requires on every reborrowed call.";
  region 'w {
    let workspace = arena_frame::<4, 1, 'w>();
    region {
      let target = arena_vector_proved::<u8>(store: &uniq workspace, count: 4_u64);
      for @fill_target (
        at in 0_u64..4_u64,
        invariant grown_target: len_of(target) >= at,
        invariant spare_target: room_of(target) + at >= 4_u64,
        invariant flat_target: head_of(target) <= 0_u64
      ) {
        set target = place_back(vector: move target, value: 0_u8);
      }
      region {
        let view_target = mut_slice_of(&uniq target);
        region {
          let handle = &uniq view_target;
          fill_all(out: move handle, value: 5_u8);
        }
      }
      let last = target[3_u64];
      if last == 5_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
      return exit_status(code: 0_u8);
    }
  }
}
