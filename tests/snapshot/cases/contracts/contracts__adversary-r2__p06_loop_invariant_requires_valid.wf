fn get_bounded<const n: u64>(b: own FixedVector<u8, n>, i: own u64) -> (rest: own FixedVector<u8, n>, value: own u8) reads(b) contract {
  define spare = len_of(b);
  requires i < spare;
  ensures len_of(rest) == spare;
} {
  let value = b[i];
  return move b, value;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: inside the for loop the header invariant i <= n with the loop guard i < n proves each call's requires i < spare where spare == n, so get_bounded never needs a per-call written certificate.";
  let buf = fixed_vector::<u8, 5>();
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  let n = len_of(buf);
  let acc = 0_u64;
  for (
    i in 0_u64..n,
    invariant bounded: i <= n,
    invariant kept: len_of(buf) >= n
  ) {
    set (buf, byte) = get_bounded::<5>(b: move buf, i: i);
    let widened = cvt::<u8, u64>(byte);
    set acc = acc +wrap widened;
  }
  if acc == 15_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
