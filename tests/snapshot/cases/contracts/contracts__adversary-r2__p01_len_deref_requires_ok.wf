fn get_bounded(b: own buffer<u8>, i: own u64) -> value: own u8 reads(b) contract {
  define room = len(b);
  requires i < room;
} {
  return b[i];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "EXPECT ACCEPT: requires uses define room = len(b); caller proves index 3 < len 8 statically.";
  let buf = buffer_new(8_u64, 0_u8);
  let value = get_bounded(b: move buf, i: 3_u64);
  if value == 0_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
