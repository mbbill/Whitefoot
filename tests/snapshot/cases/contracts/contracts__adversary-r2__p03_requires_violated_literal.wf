fn get_bounded(b: own buffer<u8>, i: own u64) -> value: own u8 reads(b) contract {
  define spare = len(b);
  requires i < spare;
} {
  return b[i];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "EXPECT REJECT: caller passes i = 8 against a buffer of len 8, so 8 < 8 is false; requires is unproved.";
  let buf = buffer_new(8_u64, 0_u8);
  let value = get_bounded(b: move buf, i: 8_u64);
  if value == 0_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
