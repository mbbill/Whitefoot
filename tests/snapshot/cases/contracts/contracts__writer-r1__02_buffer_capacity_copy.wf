fn fill_prefix(out: &uniq buffer<u8>, source: own buffer<u8>) -> written: own u64 reads(source), writes(out) contract {
  define spare = len_of(deref(out));
  define amount = len_of(source);
  requires amount <= spare;
} {
  let amount = len_of(source);
  for (offset in 0_u64..amount) {
    let value = source[offset];
    set deref(out)[offset] = value;
  }
  return amount;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: requires uses a len_of(deref(out)) definition to bound the write loop.";
  let source = buffer_new(3_u64, 9_u8);
  let target = buffer_new(5_u64, 0_u8);
  region {
    let handle = &uniq target;
    let written = fill_prefix(out: move handle, source: move source);
    if written == 3_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  let last = target[2_u64];
  if last == 9_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
