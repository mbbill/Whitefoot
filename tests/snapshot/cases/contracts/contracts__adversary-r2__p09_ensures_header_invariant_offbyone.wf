fn count_to_strict(limit: own u64) -> count: own u64 pure contract {
  ensures count < limit;
} {
  let cursor = 0_u64;
  for (
    i in 0_u64..limit,
    invariant bounded: cursor <= i
  ) {
    set cursor = cursor + 1_u64;
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: ensures claims count < limit (strict), but on normal exhaustion cursor == limit, so for limit = 4 the claimed postcondition 4 < 4 is false and unprovable.";
  let observed = count_to_strict(limit: 4_u64);
  if observed == 4_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
