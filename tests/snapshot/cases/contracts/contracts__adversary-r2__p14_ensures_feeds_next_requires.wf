fn clamp_index(raw: own u64, limit: own u64) -> safe: own u64 pure contract {
  requires limit > 0_u64;
  ensures safe < limit;
} {
  let inside = raw < limit;
  if inside {
    return raw;
  } else {
    return 0_u64;
  }
}

fn get_bounded(b: own buffer<u8>, i: own u64) -> value: own u8 reads(b) contract {
  define spare = len(b);
  requires i < spare;
} {
  return b[i];
}

fn safe_read(b: own buffer<u8>, raw: own u64) -> value: own u8 reads(b) {
  let spare = len(b);
  let nonempty = spare > 0_u64;
  if nonempty {
    let safe = clamp_index(raw: raw, limit: spare);
    let value = get_bounded(b: move b, i: safe);
    return value;
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "EXPECT ACCEPT: after the nonempty branch guards limit > 0, clamp_index's ensures safe < limit with limit bound to spare is consumed directly as the callee requires i < spare of get_bounded, so raw = 99 against a 4-byte buffer clamps to 0 and reads in-bounds.";
  let buf = buffer_new(4_u64, 6_u8);
  let value = safe_read(b: move buf, raw: 99_u64);
  if value == 6_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
