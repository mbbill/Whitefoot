fn get_borrowed(holder: own Slice<u8>, i: own u64) -> value: own u8 reads(holder) contract {
  define spare = len_of(holder);
  requires i < spare;
} {
  return holder[i];
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: requires uses define spare = len_of(deref(holder)); index 5 is within len 6.";
  let buf = fixed_vector::<u8, 6>();
  set buf = place_back(vector: move buf, value: 9_u8);
  set buf = place_back(vector: move buf, value: 9_u8);
  set buf = place_back(vector: move buf, value: 9_u8);
  set buf = place_back(vector: move buf, value: 9_u8);
  set buf = place_back(vector: move buf, value: 9_u8);
  set buf = place_back(vector: move buf, value: 9_u8);
  region {
    let p = slice_of(&buf);
    let value = get_borrowed(holder: p, i: 5_u64);
    if value == 9_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
