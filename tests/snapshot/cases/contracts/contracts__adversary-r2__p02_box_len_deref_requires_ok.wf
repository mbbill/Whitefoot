fn get_borrowed(holder: &buffer<u8>, i: own u64) -> value: own u8 reads(holder) contract {
  define spare = len(deref(holder));
  requires i < spare;
} {
  return deref(holder)[i];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "EXPECT ACCEPT: requires uses define spare = len(deref(holder)); index 5 is within len 6.";
  let buf = buffer_new(6_u64, 9_u8);
  region {
    let p = &buf;
    let value = get_borrowed(holder: p, i: 5_u64);
    if value == 9_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
