fn fold_pair['r](left: &'r buffer<u64>, right: &'r buffer<u64>, length: own u64) -> total: own u64 reads(left, right) contract {
  define left_length = len(deref(left));
  define right_length = len(deref(right));
  requires ile(length, left_length);
  requires ile(length, right_length);
} {
  let acc = 0_u64;
  for (
    i in 0_u64..length,
    invariant bounded: ile(i, length)
  ) {
    let l = deref(left)[i];
    let r = deref(right)[i];
    set acc = acc +wrap l;
    set acc = acc +wrap r;
  }
  return acc;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "EXPECT ACCEPT: requires uses two independent defines (left_length, right_length) each from len(deref(.)); length 3 satisfies both against buffers of len 4 and 5.";
  let left = buffer_new(4_u64, 2_u64);
  let right = buffer_new(5_u64, 3_u64);
  region 'r {
    let lp = &'r left;
    let rp = &'r right;
    let total = fold_pair<'r>(left: lp, right: rp, length: 3_u64);
    if ieq(total, 15_u64) {
    } else {
      return exit_status(code: 201_u8);
    }
  }
  return exit_status(code: 0_u8);
}
