fn fold_pair['r](left: own Slice<'r, u64>, right: own Slice<'r, u64>, length: own u64) -> total: own u64 reads(left, right) contract {
  define left_length = len_of(left);
  define right_length = len_of(right);
  requires length <= left_length;
  requires length <= right_length;
} {
  let acc = 0_u64;
  for (
    i in 0_u64..length,
    invariant bounded: i <= length
  ) {
    let l = left[i];
    let r = right[i];
    set acc = acc +wrap l;
    set acc = acc +wrap r;
  }
  return acc;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: requires uses two independent defines (left_length, right_length) each from len_of(deref(.)); length 3 satisfies both against buffers of len 4 and 5.";
  let left = fixed_vector::<u64, 4>();
  set left = place_back(vector: move left, value: 2_u64);
  set left = place_back(vector: move left, value: 2_u64);
  set left = place_back(vector: move left, value: 2_u64);
  set left = place_back(vector: move left, value: 2_u64);
  let right = fixed_vector::<u64, 5>();
  set right = place_back(vector: move right, value: 3_u64);
  set right = place_back(vector: move right, value: 3_u64);
  set right = place_back(vector: move right, value: 3_u64);
  set right = place_back(vector: move right, value: 3_u64);
  set right = place_back(vector: move right, value: 3_u64);
  region {
    let lp = slice_of(&left);
    let rp = slice_of(&right);
    let total = fold_pair(left: lp, right: rp, length: 3_u64);
    if total == 15_u64 {
    } else {
      return exit_status(code: 201_u8);
    }
  }
  return exit_status(code: 0_u8);
}
