fn scaled(value: own u64, limit: own u64) -> result: own u64 pure contract {
  requires value <= limit;
  ensures result <= limit;
} {
  return value;
}

fn clamp_walk(count: own u64, limit: own u64) -> last: own u64 pure {
  let cursor = 0_u64;
  for (
    i in 0_u64..count,
    invariant bounded: cursor <= limit
  ) {
    let picked = scaled(value: cursor, limit: limit);
    set cursor = picked;
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: the caller loop header invariant establishes the callee requires at each call site.";
  let last = clamp_walk(count: 4_u64, limit: 0_u64);
  if last == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
