fn get_bounded['r](b: &'r buffer<u8>, i: own u64) -> value: own u8 reads(b) contract {
  define room = len(deref(b));
  requires i < room;
} {
  return deref(b)[i];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "EXPECT REJECT: a requires fact proved for the 8-byte buffer wide (index 7 valid there) must not be reused to justify the same index against the unrelated 4-byte buffer narrow; if this is accepted, concrete state narrow has len 4 and the second call reads narrow[7], four bytes past its end.";
  let wide = buffer_new(8_u64, 1_u8);
  let narrow = buffer_new(4_u64, 2_u8);
  region 'r {
    let wp = &'r wide;
    let first = get_bounded::<'r>(b: wp, i: 7_u64);
    if first == 1_u8 {
    } else {
      return exit_status(code: 201_u8);
    }
    let np = &'r narrow;
    let second = get_bounded::<'r>(b: np, i: 7_u64);
    if second == 2_u8 {
    } else {
      return exit_status(code: 202_u8);
    }
  }
  return exit_status(code: 0_u8);
}
