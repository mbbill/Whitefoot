fn get_bounded(b: own Slice<u8>, i: own u64) -> value: own u8 reads(b) contract {
  define spare = len_of(b);
  requires i < spare;
} {
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: a requires fact proved for the 8-byte buffer wide (index 7 valid there) must not be reused to justify the same index against the unrelated 4-byte buffer narrow; if this is accepted, concrete state narrow has len 4 and the second call reads narrow[7], four bytes past its end.";
  let wide = fixed_vector::<u8, 8>();
  set wide = place_back(vector: move wide, value: 1_u8);
  set wide = place_back(vector: move wide, value: 1_u8);
  set wide = place_back(vector: move wide, value: 1_u8);
  set wide = place_back(vector: move wide, value: 1_u8);
  set wide = place_back(vector: move wide, value: 1_u8);
  set wide = place_back(vector: move wide, value: 1_u8);
  set wide = place_back(vector: move wide, value: 1_u8);
  set wide = place_back(vector: move wide, value: 1_u8);
  let narrow = fixed_vector::<u8, 4>();
  set narrow = place_back(vector: move narrow, value: 2_u8);
  set narrow = place_back(vector: move narrow, value: 2_u8);
  set narrow = place_back(vector: move narrow, value: 2_u8);
  set narrow = place_back(vector: move narrow, value: 2_u8);
  region {
    let wp = slice_of(&wide);
    let first = get_bounded(b: wp, i: 7_u64);
    if first == 1_u8 {
    } else {
      return exit_status(code: 201_u8);
    }
    let np = slice_of(&narrow);
    let second = get_bounded(b: np, i: 7_u64);
    if second == 2_u8 {
    } else {
      return exit_status(code: 202_u8);
    }
  }
  return exit_status(code: 0_u8);
}
