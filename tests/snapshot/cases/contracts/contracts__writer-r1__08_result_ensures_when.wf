fn checked_identity(value: own u32) -> result: own Result<u32, Overflow> pure contract {
  requires value <= 5000_u32;
  ensures when Ok(value: result): result == value;
} {
  return Ok<u32, Overflow>(value: value);
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: requires bounds the input and ensures is stated only on the Ok outcome via `ensures when`.";
  match checked_identity(value: 8_u32) {
    Ok(value: found) => {
      if found == 8_u32 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: problem) => {
      return exit_status(code: 2_u8);
    }
  }
  return exit_status(code: 0_u8);
}
