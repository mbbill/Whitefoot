command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- averages eight byte-scale fixed-point samples with a checker-proved sum bound, no wraparound";
  let samples = array_new<u8, 8>(1_u8);
  set samples[0_u64] = 2_u8;
  set samples[1_u64] = 1_u8;
  set samples[2_u64] = 3_u8;
  set samples[3_u64] = 1_u8;
  set samples[4_u64] = 1_u8;
  set samples[5_u64] = 1_u8;
  set samples[6_u64] = 1_u8;
  set samples[7_u64] = 1_u8;
  let sample_count = len(samples);
  let sum = 0_u32;
  for (
    i in 0_u64..sample_count,
    invariant sum_bound: ile(sum, 255_u32 * i)
  ) {
    let sample = samples[i];
    let wide = cvt<u8, u32>(sample);
    set sum = sum + wide;
  }
  let count_wide = match cvt<u64, u32>(sample_count) {
    Ok(value: c) => {
      give c;
    }
    Err(error: e) => {
      return exit_status(code: 4_u8);
    }
  }
  let average = match sum /checked count_wide {
    Ok(value: quotient) => {
      give quotient;
    }
    Err(error: e) => {
      return exit_status(code: 2_u8);
    }
  }
  if ieq(average, 1_u32) {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
