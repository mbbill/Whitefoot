command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: ACCEPT -- splits a byte buffer on LF into line lengths recorded in an output buffer with bounds checks";
  let input = buffer_new(11_u64, 0_u8);
  set input[0_u64] = 97_u8;
  set input[1_u64] = 98_u8;
  set input[2_u64] = 99_u8;
  set input[3_u64] = 10_u8;
  set input[4_u64] = 100_u8;
  set input[5_u64] = 10_u8;
  set input[6_u64] = 101_u8;
  set input[7_u64] = 102_u8;
  set input[8_u64] = 103_u8;
  set input[9_u64] = 104_u8;
  set input[10_u64] = 10_u8;
  let input_length = len(input);
  let lengths = buffer_new(3_u64, 0_u64);
  let lengths_room = len(lengths);
  let line_count = 0_u64;
  let current_length = 0_u64;
  for (i in 0_u64..input_length) {
    let byte = input[i];
    let is_newline = ieq(byte, 10_u8);
    if is_newline {
      let slot_ok = ilt(line_count, lengths_room);
      if slot_ok {
      } else {
        return exit_status(code: 1_u8);
      }
      set lengths[line_count] = current_length;
      set line_count = line_count +wrap 1_u64;
      set current_length = 0_u64;
    } else {
      set current_length = current_length +wrap 1_u64;
    }
  }
  if ieq(line_count, 3_u64) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(lengths[0_u64], 3_u64) {
  } else {
    return exit_status(code: 3_u8);
  }
  if ieq(lengths[1_u64], 1_u64) {
  } else {
    return exit_status(code: 3_u8);
  }
  if ieq(lengths[2_u64], 4_u64) {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
