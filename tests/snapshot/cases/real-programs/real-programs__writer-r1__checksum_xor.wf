command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: ACCEPT -- computes a running XOR checksum over a byte buffer, wraparound is the intended group operation";
  let message = buffer_new(5_u64, 0_u8);
  set message[0_u64] = 0_u8;
  set message[1_u64] = 15_u8;
  set message[2_u64] = 240_u8;
  set message[3_u64] = 170_u8;
  set message[4_u64] = 85_u8;
  let message_length = len(message);
  let checksum = 0_u8;
  for (i in 0_u64..message_length) {
    let byte = message[i];
    set checksum = ixor(checksum, byte);
  }
  if ieq(checksum, 0_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
