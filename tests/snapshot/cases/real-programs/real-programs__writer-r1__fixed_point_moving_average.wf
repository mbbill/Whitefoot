struct MovingWindow {
  history: array<u32, 4>;
  cursor: u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- maintains a 4-slot fixed-point moving-average window over a struct field with a proved cursor bound";
  let history = array_new::<u32, 4>(0_u32);
  let window = MovingWindow(history: move history, cursor: 0_u64);
  let inputs = array_new::<u32, 6>(400_u32);
  let last_average = 0_u32;
  for (frame in 0_u64..6_u64) {
    let sample = inputs[frame];
    let write_ok = window.cursor < 4_u64;
    if write_ok {
    } else {
      return exit_status(code: 1_u8);
    }
    set window.history[window.cursor] = sample;
    let total = 0_u32;
    for (slot in 0_u64..4_u64) {
      let value = window.history[slot];
      set total = total +wrap value;
    }
    let average = match total /checked 4_u32 {
      Ok(value: quotient) => {
        give quotient;
      }
      Err(error: e) => {
        return exit_status(code: 3_u8);
      }
    }
    set last_average = average;
    let at_end = window.cursor == 3_u64;
    let next_cursor = if at_end {
      give 0_u64;
    } else {
      give window.cursor +wrap 1_u64;
    }
    set window.cursor = next_cursor;
  }
  if last_average == 400_u32 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
