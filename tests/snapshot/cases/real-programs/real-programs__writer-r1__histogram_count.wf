command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: ACCEPT -- tallies a byte histogram over 4 buckets keyed by the top two bits with bounds-checked writes";
  let input = buffer_new(8_u64, 0_u8);
  set input[0_u64] = 3_u8;
  set input[1_u64] = 200_u8;
  set input[2_u64] = 5_u8;
  set input[3_u64] = 130_u8;
  set input[4_u64] = 64_u8;
  set input[5_u64] = 1_u8;
  set input[6_u64] = 192_u8;
  set input[7_u64] = 65_u8;
  let input_length = len(input);
  let buckets = buffer_new(4_u64, 0_u64);
  let bucket_room = len(buckets);
  for (i in 0_u64..input_length) {
    let byte = input[i];
    let top_bits = ishr.wrap(byte, 6_u32);
    let bucket_index = cvt<u8, u64>(top_bits);
    let bucket_ok = ilt(bucket_index, bucket_room);
    if bucket_ok {
    } else {
      return exit_status(code: 1_u8);
    }
    let current = buckets[bucket_index];
    set buckets[bucket_index] = current +wrap 1_u64;
  }
  if ieq(buckets[0_u64], 3_u64) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(buckets[1_u64], 2_u64) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(buckets[2_u64], 1_u64) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(buckets[3_u64], 2_u64) {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
