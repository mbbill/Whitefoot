command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: ACCEPT -- reverses a byte buffer in place, mirror index proved from the counted loop bound and a checked length";
  let data = buffer_new(7_u64, 0_u8);
  set data[0_u64] = 1_u8;
  set data[1_u64] = 2_u8;
  set data[2_u64] = 3_u8;
  set data[3_u64] = 4_u8;
  set data[4_u64] = 5_u8;
  set data[5_u64] = 6_u8;
  set data[6_u64] = 7_u8;
  let data_length = len(data);
  let count_ok = ige(data_length, 1_u64);
  if count_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let last = data_length - 1_u64;
  for (i in 0_u64..data_length) {
    let mirror = last - i;
    let should_swap = ilt(i, mirror);
    if should_swap {
      let front_value = data[i];
      let back_value = data[mirror];
      set data[i] = back_value;
      set data[mirror] = front_value;
    }
  }
  if ieq(data[0_u64], 7_u8) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(data[6_u64], 1_u8) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(data[3_u64], 4_u8) {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
