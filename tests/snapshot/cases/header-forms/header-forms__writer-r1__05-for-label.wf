const values: array<u8, 4> =[10_u8, 20_u8, 30_u8, 40_u8];

command fn main() -> status: own ExitStatus pure {
  doc "SNAPSHOT REJECT [TYPE-5]: the finder expected ACCEPT for the labeled counted header form, but set total = total +wrap value mixes own u64 with own u8, which is an ordinary type mismatch.";
  let total = 0_u64;
  for @scan (i in 0_u64..4_u64) {
    let value = values[i];
    set total = total +wrap value;
    if ieq(i, 2_u64) {
      break @scan;
    }
  }
  if ieq(total, 60_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
