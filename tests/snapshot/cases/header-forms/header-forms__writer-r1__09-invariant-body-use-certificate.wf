fn preserve_pair_bounds(first: own u64, first_limit: own u64, second: own u64, second_limit: own u64) -> result: own u64 pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
} {
  let combined = 0_u64;
  invariant pair_bound: first + second <= first_limit + second_limit;
  invariant explicit: first + second <= first_limit + second_limit {
    use pair_bound;
  }
  set combined = first + second;
  return combined;
}

command fn main() -> status: own ExitStatus pure {
  doc "SNAPSHOT REJECT [PRF-1]: the finder expected ACCEPT for certifying a body invariant by naming an earlier one, but AUTO already proves that target from the same entering context, so the use block is redundant.";
  let combined = preserve_pair_bounds(first: 3_u64, first_limit: 5_u64, second: 7_u64, second_limit: 9_u64);
  if combined <= 14_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
