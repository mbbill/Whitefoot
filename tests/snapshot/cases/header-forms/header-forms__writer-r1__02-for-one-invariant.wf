command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: a counted for loop with exactly one header invariant breaks after '(' and renders the binder then the invariant on their own lines [FORM-2].";
  let sum = 0_u64;
  for (
    i in 0_u64..5_u64,
    invariant sum_bound: sum <= 5_u64 * i
  ) {
    set sum = sum + i;
  }
  if sum == 10_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
