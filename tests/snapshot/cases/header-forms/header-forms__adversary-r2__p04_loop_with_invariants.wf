command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: ordinary loop-stmt (no counted binder) with a single header invariant, exits via break.";
  let cursor = 0_u64;
  loop (
    invariant bounded: cursor <= 4_u64
  ) {
    let remaining = cursor < 4_u64;
    if remaining {
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  let correct = cursor == 4_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
