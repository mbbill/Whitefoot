fn count_to(limit: own u64) -> reached: own u64 pure {
  let cursor = 0_u64;
  loop (
    invariant bounded: ile(cursor, limit)
  ) {
    let remaining = ilt(cursor, limit);
    if remaining {
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: an ordinary loop with one header invariant and no counted binder, guarded by an internal break [GRAM-4, INV-1].";
  let reached = count_to(limit: 4_u64);
  if ieq(reached, 4_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
