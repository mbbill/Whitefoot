fn count_to(limit: own u64) -> reached: own u64 pure {
  let cursor = 0_u64;
  loop @counting (
    invariant bounded: cursor <= limit
  ) {
    let remaining = cursor < limit;
    if remaining {
      set cursor = cursor + 1_u64;
    } else {
      break @counting;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- ordinary loop carries both a LABEL and a header invariant [INV-1].";
  let reached = count_to(limit: 4_u64);
  if reached == 4_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
