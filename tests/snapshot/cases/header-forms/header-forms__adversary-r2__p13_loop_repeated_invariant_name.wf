command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: ordinary loop-stmt header repeats the invariant name 'bounded' twice; all names in one header must be distinct.";
  let cursor = 0_u64;
  loop (
    invariant bounded: ile(cursor, 4_u64),
    invariant bounded: ile(cursor, 4_u64)
  ) {
    let remaining = ilt(cursor, 4_u64);
    if remaining {
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  return exit_status(code: 0_u8);
}
