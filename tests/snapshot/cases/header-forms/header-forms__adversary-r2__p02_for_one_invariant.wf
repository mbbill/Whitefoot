command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: for-loop with exactly one invariant uses the multi-line header with a single header_invariant clause.";
  let cursor = 0_u64;
  for (
    i in 0_u64..4_u64,
    invariant bounded: cursor <= i
  ) {
    set cursor = cursor + 1_u64;
  }
  let correct = cursor == 4_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
