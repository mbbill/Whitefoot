command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: header invariant name 'bounded' is referenced after the loop closes; INV-1 says it does not escape the body.";
  let cursor = 0_u64;
  for (
    i in 0_u64..4_u64,
    invariant bounded: cursor <= i
  ) {
    set cursor = cursor + 1_u64;
  }
  invariant after_loop: cursor <= 4_u64 {
    use bounded;
  }
  return exit_status(code: 0_u8);
}
