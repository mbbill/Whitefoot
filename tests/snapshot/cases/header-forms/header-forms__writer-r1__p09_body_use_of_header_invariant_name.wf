fn scaled_bound(limit: own u64) -> total: own u64 pure {
  let sum = 0_u64;
  for (
    i in 0_u64..limit,
    invariant sum_bound: ile(sum, i)
  ) {
    invariant tripled_bound: ile(3_u64 * sum, 3_u64 * i) {
      use 3 * sum_bound;
    }
    set sum = sum + 1_u64;
  }
  return sum;
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- a local invariant inside the loop body names the header invariant in its certificate [PRF-1].";
  let total = scaled_bound(limit: 5_u64);
  if ieq(total, 5_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
