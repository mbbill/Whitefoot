fn sum_to(limit: own u64) -> total: own u64 pure {
  let sum = 0_u64;
  for (i in 0_u64..limit) {
    set sum = sum +wrap 1_u64;
  }
  return sum;
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- zero-invariant counted for uses the one-line header form [P11].";
  let total = sum_to(limit: 6_u64);
  if ieq(total, 6_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
