fn sum_and_count(count: own u64) -> total: own u64 pure {
  let total = 0_u64;
  for (
    i in 0_u64..count,
    invariant sum_bound: ile(total, i),
    invariant index_bound: ile(i, count)
  ) {
    set total = total + 1_u64;
  }
  return total;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: counted for with two comma-separated header invariants, no trailing comma [GRAM-4].";
  let total = sum_and_count(count: 4_u64);
  if ieq(total, 4_u64) {
  } else {
    let failed = exit_status(code: 1_u8);
    return move failed;
  }
  let success = exit_status(code: 0_u8);
  return move success;
}
