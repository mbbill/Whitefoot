command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: an inner for-loop reuses the label '@walk' while the enclosing outer loop of the same label is still live (not disjoint scopes).";
  let total = 0_u64;
  for @walk (i in 0_u64..2_u64) {
    for @walk (j in 0_u64..2_u64) {
      set total = total + 1_u64;
    }
  }
  return exit_status(code: 0_u8);
}
