fn count_bounded(limit: own u64) -> reached: own u64 pure {
  let cursor = 0_u64;
  loop @walk (
    invariant bounded: cursor <= limit
  ) {
    let remaining = cursor < limit;
    if remaining {
      set cursor = cursor + 1_u64;
    } else {
      break @walk;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: labeled ordinary loop combined with a one-item header invariant [GRAM-4, FORM-2].";
  let reached = count_bounded(limit: 5_u64);
  if reached == 5_u64 {
  } else {
    let failed = exit_status(code: 1_u8);
    return move failed;
  }
  let success = exit_status(code: 0_u8);
  return move success;
}
