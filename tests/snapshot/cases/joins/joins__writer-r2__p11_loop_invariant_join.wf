fn compact['a](buf: &uniq 'a buffer<u8>) -> result: own u64 reads(buf), writes(buf) {
  doc "expected ACCEPT: an in-place two-pointer compaction. The else-free if inside the loop body either bumps sum and re-proves ile(sum, i+1) directly, or leaves sum unchanged so the header invariant weakens across i to i+1; both joined edges maintain the same header invariant, which then discharges every write's subscript.";
  let n = len(deref(buf));
  let sum = 0_u64;
  for (
    i in 0_u64..n,
    invariant sum_bound: ile(sum, i)
  ) {
    let byte = deref(buf)[i];
    let keep = ige(byte, 128_u8);
    if keep {
      set deref(buf)[sum] = byte;
      set sum = sum + 1_u64;
    }
  }
  return sum;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let buf = buffer_new(4_u64, 0_u8);
  region 'r {
    let kept = compact<'r>(buf: &uniq 'r buf);
    if ieq(kept, 0_u64) {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
