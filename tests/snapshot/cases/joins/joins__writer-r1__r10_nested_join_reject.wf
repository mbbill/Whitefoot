fn pick_byte(b: own buffer<u8>, i: own u64, outer: own Bool, inner: own Bool) -> result: own u8 reads(b) {
  doc "REJECT: three of the four flattened leaves prove i < spare but the final else-branch proves only the non-strict i <= spare, so the outer ENT-5 join keeps the weakest bound and the trailing subscript's OP-4 is undischarged.";
  let spare = len(b);
  if outer {
    if inner {
      let a_bound = i < spare;
      if a_bound {
      } else {
        return 0_u8;
      }
    } else {
      let b_bound = i < spare;
      if b_bound {
      } else {
        return 0_u8;
      }
    }
  } else if inner {
    let c_bound = i < spare;
    if c_bound {
    } else {
      return 0_u8;
    }
  } else {
    let d_bound = i <= spare;
    if d_bound {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
