enum Kind {
  Head();
  Tail();
}

fn fetch(b: own buffer<u8>, i: own u64, wide: own Bool, kind: own Kind) -> result: own u8 reads(b) {
  doc "expected ACCEPT: the wide arm nests a two-variant match, each of whose arms proves ilt(i, room) from a different derivation, so a match_stmt nested inside an if arm must deliver through the last-statement recursion before the outer if/else join reaches the shared subscript.";
  let room = len(b);
  if wide {
    match kind {
      Head() => {
        let direct = ilt(i, room);
        if direct {
        } else {
          return 0_u8;
        }
      }
      Tail() => {
        let far = ige(i, room);
        if far {
          return 0_u8;
        }
      }
    }
  } else {
    let narrow_bound = ilt(i, room);
    if narrow_bound {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
