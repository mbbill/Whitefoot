enum Pick {
  Narrow();
  Wide();
}

fn get(b: own buffer<u8>, i: own u64, choice: own Pick) -> result: own u8 reads(b) {
  doc "expect ACCEPT: both match arms independently establish i < spare before falling through, so the join keeps that common strict bound and b[i] discharges.";
  let spare = len(b);
  match choice {
    Narrow() => {
      let inside_n = i < spare;
      if inside_n {
      } else {
        return 0_u8;
      }
    }
    Wide() => {
      let inside_w = i < spare;
      if inside_w {
      } else {
        return 0_u8;
      }
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
