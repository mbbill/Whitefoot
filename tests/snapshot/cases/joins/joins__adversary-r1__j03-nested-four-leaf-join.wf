enum Combo {
  BothTrue();
  FirstTrue();
  SecondTrue();
  BothFalse();
}

fn get(b: own buffer<u8>, i: own u64, combo: own Combo) -> result: own u8 reads(b) {
  doc "expect ACCEPT: a four-variant match stands in for a nested if/if join; every one of the four leaves independently checks i < spare before falling through, so the join keeps the common bound and b[i] discharges.";
  let spare = len(b);
  match combo {
    BothTrue() => {
      let inside_a = i < spare;
      if inside_a {
      } else {
        return 0_u8;
      }
    }
    FirstTrue() => {
      let inside_b = i < spare;
      if inside_b {
      } else {
        return 0_u8;
      }
    }
    SecondTrue() => {
      let inside_c = i < spare;
      if inside_c {
      } else {
        return 0_u8;
      }
    }
    BothFalse() => {
      let inside_d = i < spare;
      if inside_d {
      } else {
        return 0_u8;
      }
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
