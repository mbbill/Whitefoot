enum Kind {
  Exact();
  Margin();
}

fn fetch(b: own buffer<u8>, i: own u64, kind: own Kind, safe: own Bool) -> result: own u8 reads(b) {
  doc "expected ACCEPT: the Margin arm nests an if/else that proves i < room from two different derivations, so an if_stmt nested inside a match arm must deliver through the last-statement recursion before the outer match/if join reaches the shared subscript.";
  let room = len(b);
  match kind {
    Exact() => {
      let inside = i < room;
      if inside {
      } else {
        return 0_u8;
      }
    }
    Margin() => {
      if safe {
        let direct = i < room;
        if direct {
        } else {
          return 0_u8;
        }
      } else {
        let far = i >= room;
        if far {
          return 0_u8;
        }
      }
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
