fn fetch(b: own Slice<u8>, i: own u64, wide: own Bool) -> result: own u8 reads(b) {
  doc "expected ACCEPT: if/else arms establish i < spare from different comparisons; ENT-5 keeps the common bound so the subscript is proved.";
  let spare = len_of(b);
  if wide {
    let cmp_a = i < spare;
    if cmp_a {
    } else {
      return 0_u8;
    }
  } else {
    let cmp_b = i < spare;
    if cmp_b {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
