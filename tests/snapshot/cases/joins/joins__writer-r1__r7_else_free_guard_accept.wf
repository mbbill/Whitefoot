fn pick_byte(b: own buffer<u8>, i: own u64) -> result: own u8 reads(b) {
  doc "ACCEPT: the single else-free if returns on the out-of-range edge, so the true edge never reaches the join and the fallthrough continuation carries the negated fact i < spare, discharging the subscript's OP-4.";
  let spare = len_of(b);
  let out_of_range = i >= spare;
  if out_of_range {
    return 0_u8;
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
