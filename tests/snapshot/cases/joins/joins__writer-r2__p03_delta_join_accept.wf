fn fetch_shifted(b: own buffer<u8>, i: own u64, wide: own Bool) -> result: own u8 reads(b) {
  doc "expected ACCEPT: if/else arms write the same result variable via different wrapping deltas, each independently proving its own in-bounds fact before the shared subscript.";
  let spare = len(b);
  let idx = if wide {
    let idx1 = i +wrap 2_u64;
    let inside1 = idx1 < spare;
    if inside1 {
    } else {
      return 0_u8;
    }
    give idx1;
  } else {
    let idx2 = i +wrap 1_u64;
    let inside2 = idx2 < spare;
    if inside2 {
    } else {
      return 0_u8;
    }
    give idx2;
  }
  return b[idx];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
