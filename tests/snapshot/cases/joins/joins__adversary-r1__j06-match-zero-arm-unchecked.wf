enum Pick {
  Zero();
  Wide();
}

fn get(b: own Slice<u8>, i: own u64, choice: own Pick) -> result: own u8 reads(b) {
  doc "expect REJECT: the Zero() arm rebinds i to 0 without ever checking spare > 0, so it does not establish i < spare; with an empty buffer (spare = 0) and choice = Zero, b[i] is out of range even though i looks like a safe constant.";
  let spare = len_of(b);
  let cursor = i;
  match choice {
    Zero() => {
      set cursor = 0_u64;
    }
    Wide() => {
      let inside = i < spare;
      if inside {
      } else {
        return 0_u8;
      }
    }
  }
  return b[cursor];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
