fn store_byte(out: &uniq MutSlice<u8>, i: own u64, value: own u8, pick: own Bool) -> result: own unit reads(out), writes(out) {
  doc "ACCEPT: both arms of the if/else independently prove i < spare via different routes before the join, and ENT-5 carries the common bound into the write subscript, discharging OP-4 for the store just as it would for a read.";
  let spare = len_of(deref(out));
  if pick {
    let direct_bound = i < spare;
    if direct_bound {
    } else {
      return unit;
    }
  } else {
    let reversed_bound = spare > i;
    if reversed_bound {
    } else {
      return unit;
    }
  }
  set deref(out)[i] = value;
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  region 'w {
    let workspace = arena_frame::<8, 1, 'w>();
    region {
      let scratch = arena_vector_proved::<u8>(store: &uniq workspace, count: 8_u64);
      for @fill_scratch (
        at in 0_u64..8_u64,
        invariant grown_scratch: len_of(scratch) >= at,
        invariant spare_scratch: room_of(scratch) + at >= 8_u64,
        invariant flat_scratch: head_of(scratch) <= 0_u64
      ) {
        set scratch = place_back(vector: move scratch, value: 0_u8);
      }
      let take_direct = True();
      let take_reversed = False();
      region {
        let view_scratch = mut_slice_of(&uniq scratch);
        region {
          store_byte(out: &uniq view_scratch, i: 3_u64, value: 42_u8, pick: take_direct);
        }
      }
      region {
        let view_scratch = mut_slice_of(&uniq scratch);
        region {
          store_byte(out: &uniq view_scratch, i: 5_u64, value: 9_u8, pick: take_reversed);
        }
      }
      let observed = scratch[3_u64];
      if observed == 42_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
      return exit_status(code: 0_u8);
    }
  }
}
