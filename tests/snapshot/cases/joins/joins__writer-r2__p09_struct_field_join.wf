struct Cursor {
  buf: buffer<u8>;
  pos: u64;
}

fn cursor_read(c: &Cursor, wide: own Bool) -> result: own u8 reads(c.buf, c.pos) {
  doc "expected ACCEPT: the index and length are read once from struct fields through a shared borrow, then if/else arms establish pos < room from two different derivations before the join reaches the shared subscript.";
  let room = len(deref(c).buf);
  let pos = deref(c).pos;
  if wide {
    let direct = pos < room;
    if direct {
    } else {
      return 0_u8;
    }
  } else {
    let far = pos >= room;
    if far {
      return 0_u8;
    }
  }
  return deref(c).buf[pos];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
