enum Pick {
  Narrow();
  Wide();
}

fn get(b: own Slice<u8>, i: own u64, choice: own Pick) -> result: own u8 reads(b) {
  doc "expect REJECT: Narrow() proves i < spare (strict) but Wide() only proves i <= spare (non-strict); the match join must keep the weakest common bound, so b[i] stays undischarged for i = spare = len_of(b) taking the Wide() arm.";
  let spare = len_of(b);
  match choice {
    Narrow() => {
      let inside = i < spare;
      if inside {
      } else {
        return 0_u8;
      }
    }
    Wide() => {
      let within = i <= spare;
      if within {
      } else {
        return 0_u8;
      }
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
