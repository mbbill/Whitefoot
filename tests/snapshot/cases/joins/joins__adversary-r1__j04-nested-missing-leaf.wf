enum Combo {
  BothTrue();
  FirstTrue();
  SecondTrue();
  BothFalse();
}

fn get(b: own Slice<u8>, i: own u64, combo: own Combo) -> result: own u8 reads(b) {
  doc "expect REJECT: three of the four match leaves check i < spare, but BothFalse() falls through unchecked, so b[i] must not discharge for i = spare = len_of(b) taking BothFalse().";
  let spare = len_of(b);
  match combo {
    BothTrue() => {
      let inside_a = i < spare;
      if inside_a {
      } else {
        return 0_u8;
      }
    }
    FirstTrue() => {
      let inside_b = i < spare;
      if inside_b {
      } else {
        return 0_u8;
      }
    }
    SecondTrue() => {
      let inside_c = i < spare;
      if inside_c {
      } else {
        return 0_u8;
      }
    }
    BothFalse() => {
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
