fn pick_byte(b: own buffer<u8>, i: own u64, pick: own Bool) -> result: own u8 reads(b) {
  doc "ACCEPT: the two arms prove the same relation from different comparisons (ilt vs igt), and ENT-5's join carries ilt(i, room) to the shared subscript, discharging OP-4.";
  let room = len(b);
  if pick {
    let direct_bound = ilt(i, room);
    if direct_bound {
    } else {
      return 0_u8;
    }
  } else {
    let reversed_bound = igt(room, i);
    if reversed_bound {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
