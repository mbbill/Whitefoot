fn get(b: own buffer<u8>, i: own u64, pick: own Bool) -> result: own u8 reads(b) {
  doc "expect ACCEPT: both arms call len_of(b) independently (same pure argument) and check i < that_len; the two lens are equal so the join keeps a common bound and b[i] discharges.";
  if pick {
    let room_a = len_of(b);
    let inside_a = i < room_a;
    if inside_a {
    } else {
      return 0_u8;
    }
  } else {
    let room_b = len_of(b);
    let inside_b = i < room_b;
    if inside_b {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
