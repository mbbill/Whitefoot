fn get(b: own buffer<u8>, i: own u64, pick: own Bool) -> result: own u8 reads(b) {
  doc "expect ACCEPT: both arms call len(b) independently (same pure argument) and check ilt(i, that_len); the two lens are equal so the join keeps a common bound and b[i] discharges.";
  if pick {
    let room_a = len(b);
    let inside_a = ilt(i, room_a);
    if inside_a {
    } else {
      return 0_u8;
    }
  } else {
    let room_b = len(b);
    let inside_b = ilt(i, room_b);
    if inside_b {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
