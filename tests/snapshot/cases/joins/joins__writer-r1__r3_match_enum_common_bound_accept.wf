enum Zone {
  Head();
  Mid();
  Tail();
}

fn pick_byte(b: own buffer<u8>, i: own u64, zone: own Zone) -> result: own u8 reads(b) {
  doc "ACCEPT: every match arm independently proves i < room before the shared subscript, so ENT-5's all-predecessor join carries the common bound out of the exhaustive match.";
  let room = len(b);
  match zone {
    Head() => {
      let head_bound = i < room;
      if head_bound {
      } else {
        return 0_u8;
      }
    }
    Mid() => {
      let mid_bound = i < room;
      if mid_bound {
      } else {
        return 0_u8;
      }
    }
    Tail() => {
      let tail_bound = i < room;
      if tail_bound {
      } else {
        return 0_u8;
      }
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
