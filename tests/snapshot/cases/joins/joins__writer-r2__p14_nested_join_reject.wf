fn fetch(b: own buffer<u8>, i: own u64, outer: own Bool, inner: own Bool) -> result: own u8 reads(b) {
  doc "expected REJECT [OP-4]: the outer true arm nests an if/else whose two leaves prove `<` and `<=` respectively, so the inner join already keeps only the weaker i <= spare; joining that with the outer false arm's tight i < spare still keeps the weakest `<=`, leaving the trailing subscript's strict obligation undischarged.";
  let spare = len_of(b);
  if outer {
    if inner {
      let tight = i < spare;
      if tight {
      } else {
        return 0_u8;
      }
    } else {
      let loose = i <= spare;
      if loose {
      } else {
        return 0_u8;
      }
    }
  } else {
    let tight2 = i < spare;
    if tight2 {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
