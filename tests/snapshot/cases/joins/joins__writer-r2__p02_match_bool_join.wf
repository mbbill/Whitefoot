enum Selector {
  First();
  Second();
}

fn fetch(b: own buffer<u8>, i: own u64, pick: own Selector) -> result: own u8 reads(b) {
  doc "expected ACCEPT: match on a two-variant enum has arms that each establish i < spare from a different derivation before the shared subscript.";
  let spare = len_of(b);
  match pick {
    First() => {
      let direct = i < spare;
      if direct {
      } else {
        return 0_u8;
      }
    }
    Second() => {
      let too_far = i >= spare;
      if too_far {
        return 0_u8;
      }
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
