fn classify(table: own buffer<u8>, x: own u64, thresh: own u64) -> result: own u8 reads(table) {
  doc "expected ACCEPT: a three-way else-if chain has each terminal leaf establish x < spare from a different comparison against thresh, and the joined bound alone discharges the trailing subscript's [OP-4] obligation.";
  let spare = len_of(table);
  let small = x <= thresh;
  if small {
    let small_bound = x < spare;
    if small_bound {
    } else {
      return 0_u8;
    }
  } else {
    let mid_wide = thresh < spare;
    if mid_wide {
      let mid_bound = x < spare;
      if mid_bound {
      } else {
        return 0_u8;
      }
    } else {
      let far_bound = x < spare;
      if far_bound {
      } else {
        return 0_u8;
      }
    }
  }
  return table[x];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
