fn fetch(b: own buffer<u8>, i: own u64, outer: own Bool, inner: own Bool) -> result: own u8 reads(b) {
  doc "expected ACCEPT: the outer true arm nests its own if/else join, so ilt(i, room) must survive an inner join before it can survive the outer join that reaches the subscript.";
  let room = len(b);
  if outer {
    if inner {
      let a = ilt(i, room);
      if a {
      } else {
        return 0_u8;
      }
    } else {
      let far = ige(i, room);
      if far {
        return 0_u8;
      }
    }
  } else {
    let d = ilt(i, room);
    if d {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
