fn fetch(b: own Slice<u8>, i: own u64, outer: own Bool, inner: own Bool) -> result: own u8 reads(b) {
  doc "expected ACCEPT: the outer true arm nests its own if/else join, so i < spare must survive an inner join before it can survive the outer join that reaches the subscript.";
  let spare = len_of(b);
  if outer {
    if inner {
      let a = i < spare;
      if a {
      } else {
        return 0_u8;
      }
    } else {
      let far = i >= spare;
      if far {
        return 0_u8;
      }
    }
  } else {
    let d = i < spare;
    if d {
    } else {
      return 0_u8;
    }
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
