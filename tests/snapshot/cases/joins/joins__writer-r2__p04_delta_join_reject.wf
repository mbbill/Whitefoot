fn fetch_shifted(b: own buffer<u8>, i: own u64, wide: own Bool) -> result: own u8 reads(b) {
  doc "expected REJECT [OP-4]: the wide arm proves the strict idx1 < spare but the narrow arm only proves the non-strict idx2 <= spare; ENT-5 keeps the weaker joined bound on idx, so the final subscript's strict obligation is undischarged.";
  let spare = len(b);
  let idx = if wide {
    let idx1 = i +wrap 2_u64;
    let inside1 = idx1 < spare;
    if inside1 {
    } else {
      return 0_u8;
    }
    give idx1;
  } else {
    let idx2 = i +wrap 1_u64;
    let within2 = idx2 <= spare;
    if within2 {
    } else {
      return 0_u8;
    }
    give idx2;
  }
  return b[idx];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
