fn pick_byte(b: own buffer<u8>, i: own u64, adjust: own Bool) -> result: own u8 reads(b) {
  doc "REJECT: the else-free if only conditionally records an unrelated adjustment and never returns or narrows i, so the join after it carries no bound on i at all and the subscript's OP-4 is undischarged.";
  let spare = len_of(b);
  let scratch = 0_u64;
  if adjust {
    set scratch = scratch +wrap 1_u64;
  }
  return b[i];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
