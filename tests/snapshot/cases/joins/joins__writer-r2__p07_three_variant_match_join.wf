enum Mode {
  Zero();
  Plus1();
  Plus2();
}

fn fetch(b: own buffer<u8>, i: own u64, mode: own Mode) -> result: own u8 reads(b) {
  doc "expected REJECT [OP-4]: a `let idx = match mode {...}` is a value_match, and PostconditionDeliveryJoin only forms a delivery root for bounded value_if; a value_match publishes no joined relation for its delivered value even though every arm locally proves its own bound, so the tail subscript on idx is undischarged.";
  let room = len(b);
  let idx = match mode {
    Zero() => {
      let inside = i < room;
      if inside {
      } else {
        return 0_u8;
      }
      give i;
    }
    Plus1() => {
      match i +checked 1_u64 {
        Ok(value: idx1) => {
          let inside1 = idx1 < room;
          if inside1 {
          } else {
            return 0_u8;
          }
          give idx1;
        }
        Err(error: overflow) => {
          return 0_u8;
        }
      }
    }
    Plus2() => {
      match i +checked 2_u64 {
        Ok(value: idx2) => {
          let inside2 = idx2 < room;
          if inside2 {
          } else {
            return 0_u8;
          }
          give idx2;
        }
        Err(error: overflow) => {
          return 0_u8;
        }
      }
    }
  }
  return b[idx];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
