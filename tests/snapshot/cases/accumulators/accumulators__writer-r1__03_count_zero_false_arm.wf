command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected ACCEPT: mirror of the true-arm case, bumping the accumulator only in the else branch.";
  let data = buffer_new(6_u64, 0_u8);
  set data[1_u64] = 5_u8;
  set data[3_u64] = 7_u8;
  set data[4_u64] = 9_u8;
  let zero_count = 0_u64;
  for (
    i in 0_u64..6_u64,
    invariant count_bound: ile(zero_count, i)
  ) {
    let byte = data[i];
    let is_nonzero = ige(byte, 1_u8);
    if is_nonzero {
    } else {
      set zero_count = zero_count + 1_u64;
    }
  }
  if ieq(zero_count, 3_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
