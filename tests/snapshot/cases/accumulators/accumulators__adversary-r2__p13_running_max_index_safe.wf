command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- peak tracks the running imax of the scanned u8 bytes, so peak can never exceed u8::MAX=255; table has length 256, so table[cvt::<u8,u64>(peak)] (max index 255) is always in bounds.";
  let data = fixed_vector::<u8, 4>();
  set data = place_back(vector: move data, value: 10_u8);
  set data = place_back(vector: move data, value: 10_u8);
  set data = place_back(vector: move data, value: 10_u8);
  set data = place_back(vector: move data, value: 10_u8);
  set data[2_u64] = 250_u8;
  let table = fixed_vector::<u8, 256>();
  for (
    at_table in 0_u64..256_u64,
    invariant grown_table: len_of(table) >= at_table,
    invariant spare_table: room_of(table) + at_table >= 256_u64,
    invariant flat_table: head_of(table) <= 0_u64
  ) {
    set table = place_back(vector: move table, value: 0_u8);
  }
  let peak = 0_u8;
  for (
    i in 0_u64..4_u64,
    invariant bound: peak <= 255_u8
  ) {
    let byte = data[i];
    set peak = imax(peak, byte);
  }
  let peak_index = cvt::<u8, u64>(peak);
  let value = table[peak_index];
  return exit_status(code: 0_u8);
}
