command fn main() -> status: own ExitStatus pure {
  doc "expected: REJECT [OP-4] -- peak tracks the running imax of the scanned u8 bytes and can reach u8::MAX=255, but table has length 255 (valid indices 0..254); concrete violating trace: data contains a 255 byte, so peak=255 and table[255] indexes past a length-255 buffer.";
  let data = buffer_new(4_u64, 10_u8);
  set data[2_u64] = 255_u8;
  let table = buffer_new(255_u64, 0_u8);
  let peak = 0_u8;
  for (
    i in 0_u64..4_u64,
    invariant bound: peak <= 255_u8
  ) {
    let byte = data[i];
    set peak = imax(peak, byte);
  }
  let peak_index = cvt::<u8, u64>(peak);
  let value = table[peak_index];
  return exit_status(code: 0_u8);
}
