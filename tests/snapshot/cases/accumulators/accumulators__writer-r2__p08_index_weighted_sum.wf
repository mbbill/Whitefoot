fn small_sum(buf: own buffer<u8>) -> total: own u32 reads(buf) contract {
  define spare = len_of(buf);
  requires spare <= 4_u64;
} {
  doc "ACCEPT: a contract-bounded buffer length lets the per-iteration invariant use the same small constant factor regardless of the actual spare.";
  let length = len_of(buf);
  let sum = 0_u32;
  for (
    i in 0_u64..length,
    invariant per_byte: sum <= 255_u32 * i
  ) {
    let byte = buf[i];
    let wide = cvt::<u8, u32>(byte);
    set sum = sum + wide;
  }
  return sum;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let data = buffer_new(4_u64, 0_u8);
  set data[0_u64] = 2_u8;
  set data[1_u64] = 2_u8;
  set data[2_u64] = 2_u8;
  set data[3_u64] = 2_u8;
  let total = small_sum(buf: move data);
  if total == 8_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
