const codes: array<u8, 8> =[3_u8, 7_u8, 3_u8, 3_u8, 9_u8, 1_u8, 3_u8, 0_u8];

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: counts bytes equal to 3, conditional accumulation only in the true arm, bounded by the header invariant.";
  let count = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant per_step: ile(count, i)
  ) {
    let byte = codes[i];
    let is_target = ieq(byte, 3_u8);
    if is_target {
      set count = count + 1_u64;
    }
  }
  if ieq(count, 4_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
