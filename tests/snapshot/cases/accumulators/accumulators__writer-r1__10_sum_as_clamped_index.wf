command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected ACCEPT: an accumulated sum drives a table lookup only after a real branch proves it in range.";
  let data = buffer_new(4_u64, 1_u8);
  let table = buffer_new(8_u64, 0_u8);
  set table[4_u64] = 42_u8;
  let sum = 0_u64;
  for (
    i in 0_u64..4_u64,
    invariant sum_bound: ile(sum, 255_u64 * i)
  ) {
    let byte = data[i];
    let wide = cvt<u8, u64>(byte);
    set sum = sum + wide;
  }
  let room = len(table);
  let lookup_ok = ilt(sum, room);
  if lookup_ok {
    let value = table[sum];
    if ieq(value, 42_u8) {
    } else {
      return exit_status(code: 2_u8);
    }
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
