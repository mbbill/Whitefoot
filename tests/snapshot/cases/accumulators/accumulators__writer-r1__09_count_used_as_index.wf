command fn main() -> status: own ExitStatus pure {
  doc "expected ACCEPT: the bounded match count from the loop is used afterward as a write index into a marker buffer.";
  let data = buffer_new(6_u64, 0_u8);
  set data[1_u64] = 1_u8;
  set data[2_u64] = 1_u8;
  set data[4_u64] = 1_u8;
  let marks = buffer_new(6_u64, 0_u8);
  let count = 0_u64;
  for (
    i in 0_u64..6_u64,
    invariant count_bound: count <= i
  ) {
    let byte = data[i];
    let is_set = byte == 1_u8;
    if is_set {
      set count = count + 1_u64;
    }
  }
  let spare = len_of(marks);
  let in_bounds = count < spare;
  if in_bounds {
    set marks[count] = 9_u8;
  } else {
    return exit_status(code: 1_u8);
  }
  let placed = marks[count];
  if placed == 9_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
