command fn main() -> status: own ExitStatus pure {
  doc "expected: REJECT [OP-2] -- count is a match counter that can legitimately be zero (no byte equals 9); dividing the fixed total by count is unproved for a zero divisor, and it is genuinely false for the concrete trace where data is all 3s: count=0, so total / count divides by zero.";
  let data = buffer_new(5_u64, 3_u8);
  let count = 0_u64;
  for (
    i in 0_u64..5_u64,
    invariant bound: count <= i
  ) {
    let byte = data[i];
    let matches = byte == 9_u8;
    if matches {
      set count = count + 1_u64;
    }
  }
  let total = 100_u64;
  let average = total / count;
  return exit_status(code: 0_u8);
}
