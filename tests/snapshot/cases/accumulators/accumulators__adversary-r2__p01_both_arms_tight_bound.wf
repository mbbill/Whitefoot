command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: ACCEPT -- both if and else arms accumulate (2 when the byte equals 9, else 1), so sum after i iterations is at most 2*i; the invariant ile(sum, 2*i) is provably true on every path since 1 <= 2 as well.";
  let data = buffer_new(6_u64, 9_u8);
  set data[2_u64] = 0_u8;
  let sum = 0_u64;
  for (
    i in 0_u64..6_u64,
    invariant bound: ile(sum, 2_u64 * i)
  ) {
    let byte = data[i];
    let matches = ieq(byte, 9_u8);
    if matches {
      set sum = sum + 2_u64;
    } else {
      set sum = sum + 1_u64;
    }
  }
  if ieq(sum, 11_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
