command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: REJECT [OP-4] -- data has length 5 and every byte equals 7, so count can reach 5 (all match); data[count] then indexes the one-past-end slot 5, which is out of bounds. Concrete violating trace: after the loop count=5, len_of(data)=5, so data[5] reads past the buffer.";
  let data = buffer_new(5_u64, 7_u8);
  let count = 0_u64;
  for (
    i in 0_u64..5_u64,
    invariant bound: count <= i
  ) {
    let byte = data[i];
    let matches = byte == 7_u8;
    if matches {
      set count = count + 1_u64;
    }
  }
  let value = data[count];
  return exit_status(code: 0_u8);
}
