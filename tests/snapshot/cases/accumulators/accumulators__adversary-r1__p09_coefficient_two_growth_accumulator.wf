command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- sum grows by exactly 2 every iteration unconditionally; ile(sum, 2*i) is the exact coefficient-two bound, a single coefficient-one premise on the induction variable side that AUTO/DIRECT discharge at base and backedge.";
  let sum = 0_u64;
  for (
    i in 0_u64..10_u64,
    invariant bound: ile(sum, 2_u64 * i)
  ) {
    set sum = sum + 2_u64;
  }
  if ieq(sum, 20_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
