command fn main() -> status: own ExitStatus pure {
  doc "expected: REJECT [OP-2] -- count_a and count_b are independent match counters over different buffers with no proved relation between them; the checked `count_a - count_b` is genuinely false for the concrete trace where first is all 1s (count_a=0) and second is all 9s (count_b=3), since 0 - 3 underflows u64.";
  let first = fixed_vector::<u8, 4>();
  set first = place_back(vector: move first, value: 1_u8);
  set first = place_back(vector: move first, value: 1_u8);
  set first = place_back(vector: move first, value: 1_u8);
  set first = place_back(vector: move first, value: 1_u8);
  let second = fixed_vector::<u8, 3>();
  set second = place_back(vector: move second, value: 9_u8);
  set second = place_back(vector: move second, value: 9_u8);
  set second = place_back(vector: move second, value: 9_u8);
  let count_a = 0_u64;
  for (
    i in 0_u64..4_u64,
    invariant bound_a: count_a <= i
  ) {
    let byte = first[i];
    let matches = byte == 9_u8;
    if matches {
      set count_a = count_a + 1_u64;
    }
  }
  let count_b = 0_u64;
  for (
    j in 0_u64..3_u64,
    invariant bound_b: count_b <= j
  ) {
    let byte = second[j];
    let matches = byte == 9_u8;
    if matches {
      set count_b = count_b + 1_u64;
    }
  }
  let diff = count_a - count_b;
  return exit_status(code: 0_u8);
}
