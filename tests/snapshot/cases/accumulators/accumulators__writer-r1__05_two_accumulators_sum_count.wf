command fn main() -> status: own ExitStatus pure {
  doc "expected ACCEPT: sum and count are maintained together, each with its own header invariant.";
  let data = buffer_new(5_u64, 4_u8);
  let sum = 0_u64;
  let count = 0_u64;
  for (
    i in 0_u64..5_u64,
    invariant sum_bound: sum <= 255_u64 * i,
    invariant count_bound: count <= i
  ) {
    let byte = data[i];
    let wide = cvt::<u8, u64>(byte);
    set sum = sum + wide;
    set count = count + 1_u64;
  }
  if sum == 20_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if count == 5_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
