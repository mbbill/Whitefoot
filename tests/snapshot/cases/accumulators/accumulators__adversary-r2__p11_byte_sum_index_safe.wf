command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- idx accumulates the widened byte values over 3 iterations, so idx is provably at most 3*255=765; table has length 766, so table[idx] (max index 765) is always in bounds, discharged by the explicit dominating in_bounds check.";
  let data = fixed_vector::<u8, 3>();
  set data = place_back(vector: move data, value: 100_u8);
  set data = place_back(vector: move data, value: 100_u8);
  set data = place_back(vector: move data, value: 100_u8);
  let table = fixed_vector::<u8, 766>();
  for (
    at_table in 0_u64..766_u64,
    invariant grown_table: len_of(table) >= at_table,
    invariant spare_table: room_of(table) + at_table >= 766_u64,
    invariant flat_table: head_of(table) <= 0_u64
  ) {
    set table = place_back(vector: move table, value: 0_u8);
  }
  let idx = 0_u64;
  for (
    i in 0_u64..3_u64,
    invariant bound: idx <= 255_u64 * i
  ) {
    let byte = data[i];
    let wide = cvt::<u8, u64>(byte);
    set idx = idx + wide;
  }
  let table_len = len_of(table);
  let in_bounds = idx < table_len;
  if in_bounds {
  } else {
    return exit_status(code: 2_u8);
  }
  let value = table[idx];
  return exit_status(code: 0_u8);
}
