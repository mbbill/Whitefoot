command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected ACCEPT: nonzero counts from two separate buffers are each bounded, then added once after both loops.";
  let first = buffer_new(4_u64, 0_u8);
  set first[0_u64] = 1_u8;
  set first[2_u64] = 1_u8;
  let second = buffer_new(5_u64, 0_u8);
  set second[1_u64] = 1_u8;
  set second[3_u64] = 1_u8;
  set second[4_u64] = 1_u8;
  let first_count = 0_u64;
  for (
    i in 0_u64..4_u64,
    invariant first_bound: ile(first_count, i)
  ) {
    let byte = first[i];
    let is_nonzero = ige(byte, 1_u8);
    if is_nonzero {
      set first_count = first_count + 1_u64;
    }
  }
  let second_count = 0_u64;
  for (
    j in 0_u64..5_u64,
    invariant second_bound: ile(second_count, j)
  ) {
    let byte = second[j];
    let is_nonzero = ige(byte, 1_u8);
    if is_nonzero {
      set second_count = second_count + 1_u64;
    }
  }
  let total = first_count + second_count;
  if ieq(total, 5_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
