command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected ACCEPT: two accumulators, each bumped in exactly one arm of the same branch.";
  let data = buffer_new(6_u64, 0_u8);
  set data[0_u64] = 1_u8;
  set data[2_u64] = 1_u8;
  set data[5_u64] = 1_u8;
  let set_count = 0_u64;
  let clear_count = 0_u64;
  for (
    i in 0_u64..6_u64,
    invariant set_bound: set_count <= i,
    invariant clear_bound: clear_count <= i
  ) {
    let byte = data[i];
    let is_set = byte == 1_u8;
    if is_set {
      set set_count = set_count + 1_u64;
    } else {
      set clear_count = clear_count + 1_u64;
    }
  }
  if set_count == 3_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if clear_count == 3_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
