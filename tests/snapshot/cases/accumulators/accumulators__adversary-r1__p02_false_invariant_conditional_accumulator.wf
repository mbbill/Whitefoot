command fn main() -> status: own ExitStatus pure {
  doc "expected: REJECT [INV-1] -- the even branch adds 2 each hit, so count can reach 2*ceil(i/2) which exceeds the stated bound ile(count, i) at the very first even step (i=0 -> count=2 > 0); the backedge obligation ile(count, i+1) is genuinely false.";
  let count = 0_u64;
  for (
    i in 0_u64..10_u64,
    invariant bound: ile(count, i)
  ) {
    let parity = iand(i, 1_u64);
    let is_even = ieq(parity, 0_u64);
    if is_even {
      set count = count + 2_u64;
    }
  }
  if ieq(count, 10_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
