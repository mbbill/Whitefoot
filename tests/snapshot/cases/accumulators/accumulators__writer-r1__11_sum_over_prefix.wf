command fn main() -> status: own ExitStatus pure {
  doc "expected ACCEPT: the loop walks only a computed prefix of the buffer, and the bound tracks that shorter span.";
  let data = fixed_vector::<u8, 10>();
  for (
    at_data in 0_u64..10_u64,
    invariant grown_data: len_of(data) >= at_data,
    invariant spare_data: room_of(data) + at_data >= 10_u64,
    invariant flat_data: head_of(data) <= 0_u64
  ) {
    set data = place_back(vector: move data, value: 6_u8);
  }
  let spare = len_of(data);
  let half = spare / 2_u64;
  let sum = 0_u64;
  for (
    i in 0_u64..half,
    invariant per_byte: sum <= 255_u64 * i
  ) {
    let byte = data[i];
    let wide = cvt::<u8, u64>(byte);
    set sum = sum + wide;
  }
  if sum == 30_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
