const samples: array<u8, 6> =[10_u8, 20_u8, 5_u8, 0_u8, 40_u8, 15_u8];

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: byte sum widened to u32 with a per-byte header invariant discharges the OP-2 overflow obligation.";
  let sum = 0_u32;
  for (
    i in 0_u64..6_u64,
    invariant per_byte: sum <= 255_u32 * i
  ) {
    let byte = samples[i];
    let wide = cvt::<u8, u32>(byte);
    set sum = sum + wide;
  }
  if sum == 90_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
