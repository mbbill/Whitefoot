command fn main() -> status: own ExitStatus pure {
  doc "expected ACCEPT: per-byte bound sum over a small buffer, proved by header invariant sum <= 255*i.";
  let data = fixed_vector::<u8, 8>();
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  let sum = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant per_byte: sum <= 255_u64 * i
  ) {
    let byte = data[i];
    let wide = cvt::<u8, u64>(byte);
    set sum = sum + wide;
  }
  if sum == 24_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
