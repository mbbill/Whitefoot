command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: REJECT [OP-4] -- count_a is bounded by 3 and count_b by 4, so combined can reach 7, but target has length 7 (valid indices 0..6); concrete violating trace: first and second are all 5s, so count_a=3, count_b=4, combined=7, and target[7] indexes one past the end of a length-7 buffer.";
  let first = buffer_new(3_u64, 5_u8);
  let second = buffer_new(4_u64, 5_u8);
  let count_a = 0_u64;
  for (
    i in 0_u64..3_u64,
    invariant bound_a: count_a <= i
  ) {
    let byte = first[i];
    let matches = byte == 5_u8;
    if matches {
      set count_a = count_a + 1_u64;
    }
  }
  let count_b = 0_u64;
  for (
    j in 0_u64..4_u64,
    invariant bound_b: count_b <= j
  ) {
    let byte = second[j];
    let matches = byte == 5_u8;
    if matches {
      set count_b = count_b + 1_u64;
    }
  }
  let combined = count_a + count_b;
  let target = buffer_new(7_u64, 0_u8);
  set target[combined] = 1_u8;
  return exit_status(code: 0_u8);
}
