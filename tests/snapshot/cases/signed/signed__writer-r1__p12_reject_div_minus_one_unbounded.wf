fn negate(n: own i32) -> result: own i32 pure {
  doc "REJECT: dividing an unconstrained i32 by the constant -1 divisor leaves the signed-overflow conjunct undischarged at i32::MIN [OP-2, ENT-6].";
  let m = n / -1_i32;
  return m;
}

command fn main() -> status: own ExitStatus pure {
  let sample = 5_i32;
  let is_positive = igt(sample, 0_i32);
  if is_positive {
  } else {
    return exit_status(code: 4_u8);
  }
  let a = negate(n: sample);
  if ieq(a, -5_i32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
