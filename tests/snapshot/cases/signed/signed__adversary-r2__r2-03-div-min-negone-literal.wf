fn safe_div_by_neg_one(n: own i32) -> result: own i32 pure {
  doc "A dominating guard against MIN(i32) [ENT-3] makes n / -1 discharge normally.";
  if igt(n, -2147483648_i32) {
    return n / -1_i32;
  }
  return 0_i32;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT: exact -2147483648_i32 / -1_i32 is the excluded signed MIN(T),-1 pair [OP-2].";
  let guarded = safe_div_by_neg_one(n: 10_i32);
  if ieq(guarded, -10_i32) {
  } else {
    return exit_status(code: 2_u8);
  }
  let bad = -2147483648_i32 / -1_i32;
  if ieq(bad, 0_i32) {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
