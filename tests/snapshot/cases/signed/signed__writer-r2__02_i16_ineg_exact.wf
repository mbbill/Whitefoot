fn negate_guarded(x: own i16) -> negated: own i16 pure {
  doc "ACCEPT: exact ineg on i16 is admitted once a dominating branch excludes MIN(i16).";
  let is_min = x == -32768_i16;
  if is_min {
    return 32767_i16;
  } else {
    return ineg(x);
  }
}

command fn main() -> status: own ExitStatus pure {
  let a = negate_guarded(x: 300_i16);
  let b = negate_guarded(x: -32768_i16);
  if a == -300_i16 {
  } else {
    return exit_status(code: 1_u8);
  }
  if b == 32767_i16 {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 2_u8);
  }
}
