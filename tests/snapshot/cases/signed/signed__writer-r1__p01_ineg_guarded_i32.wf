fn negate(n: own i32) -> result: own i32 pure {
  doc "ACCEPT: exact ineg on i32 guarded off i32::MIN by a dominating branch [OP-1, ENT-3]; the domain excludes only MIN(T).";
  if igt(n, -2147483648_i32) {
    return ineg(n);
  }
  return 0_i32;
}

command fn main() -> status: own ExitStatus pure {
  let a = negate(n: 7_i32);
  let b = negate(n: -7_i32);
  if ieq(a, -7_i32) {
  } else {
    return exit_status(code: 1_u8);
  }
  if ieq(b, 7_i32) {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
