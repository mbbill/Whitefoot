fn negate_checked(n: own i64) -> result: own i64 pure {
  doc "ACCEPT: ineg.checked never needs a domain proof; it returns Result<i64, Overflow>, Err only at i64::MIN [OP-2].";
  match ineg.checked(n) {
    Ok(value: v) => {
      return v;
    }
    Err(error: e) => {
      return 0_i64;
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  let a = negate_checked(n: -9223372036854775808_i64);
  let b = negate_checked(n: 100_i64);
  if a == 0_i64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if b == -100_i64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
