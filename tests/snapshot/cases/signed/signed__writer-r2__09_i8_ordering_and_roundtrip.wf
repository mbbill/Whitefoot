command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: signed comparison ordering on i8 and an i8->i32->i8 cvt round trip both hold.";
  let a = -100_i8;
  let b = -1_i8;
  let below = ilt(a, b);
  if below {
  } else {
    return exit_status(code: 1_u8);
  }
  let widened = cvt<i8, i32>(a);
  match cvt<i32, i8>(widened) {
    Ok(value: narrowed) => {
      if ieq(narrowed, a) {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 2_u8);
      }
    }
    Err(error: e) => {
      return exit_status(code: 3_u8);
    }
  }
}
