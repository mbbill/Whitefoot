fn shifted_read(buf: own buffer<u8>, base: own u64, delta: own u64) -> value: own u8 reads(buf) contract {
  define spare = len_of(buf);
  requires spare <= 4294967296_u64;
  requires base < spare;
  requires delta < spare;
} {
  doc "expect ACCEPT: base < spare and delta < spare, plus a ceiling on spare, let AUTO prove base +defined delta and combine both bounds to show base + delta stays inside 2 * spare; the caller further picks base, delta so the exact sum lands inside spare itself";
  let spare = len_of(buf);
  let offset = base + delta;
  invariant offset_double_bounded: offset < 2_u64 * spare;
  let too_far = offset >= spare;
  if too_far {
    return buf[0_u64];
  } else {
    let value = buf[offset];
    return value;
  }
}

command fn main() -> status: own ExitStatus pure {
  let buf = buffer_new(8_u64, 5_u8);
  let value = shifted_read(buf: move buf, base: 2_u64, delta: 3_u64);
  if value == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
