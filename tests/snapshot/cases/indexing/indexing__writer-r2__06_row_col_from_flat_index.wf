fn pixel_at(grid: &buffer<u8>, width: own u64, height: own u64, row: own u64, col: own u64) -> value: own u8 reads(grid) {
  let area = len_of(deref(grid));
  if width *defined height {
  } else {
    return 0_u8;
  }
  let capacity = width * height;
  if area == capacity {
  } else {
    return 0_u8;
  }
  if row < height {
  } else {
    return 0_u8;
  }
  if col < width {
  } else {
    return 0_u8;
  }
  if row *defined width {
  } else {
    return 0_u8;
  }
  let row_width = row * width;
  if row_width +defined col {
  } else {
    return 0_u8;
  }
  let flat = row_width + col;
  if flat < area {
  } else {
    return 0_u8;
  }
  let byte = deref(grid)[flat];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "ACCEPT: every partial arithmetic step (width*height, row*width, the +col) is guarded by its own dominating .defined branch, and the flattened row*width+col subscript is guarded by its own direct flat < area branch [OP-2, OP-4].";
  let grid = buffer_new(12_u64, 0_u8);
  set grid[7_u64] = 42_u8;
  region {
    let value = pixel_at(grid: &grid, width: 4_u64, height: 3_u64, row: 1_u64, col: 3_u64);
    if value == 42_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
