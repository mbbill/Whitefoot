fn window_max(data: own buffer<u8>, start: own u64, end: own u64) -> peak: own u8 reads(data) contract {
  define capacity = len_of(data);
  requires start < end;
  requires end <= capacity;
} {
  doc "ACCEPT: scans one nonempty start..end window for its largest byte; the counted range keeps every subscript inside the proved endpoints.";
  let best = data[start];
  for (i in start..end) {
    let byte = data[i];
    let larger = byte > best;
    if larger {
      set best = byte;
    }
  }
  return best;
}

command fn main() -> status: own ExitStatus pure {
  let data = buffer_new(8_u64, 1_u8);
  set data[2_u64] = 9_u8;
  set data[3_u64] = 4_u8;
  set data[4_u64] = 12_u8;
  set data[5_u64] = 3_u8;
  let peak = window_max(data: move data, start: 2_u64, end: 6_u64);
  if peak == 12_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
