fn sum_all(left: own buffer<u8>, right: own buffer<u8>) -> total: own u64 reads(left, right) {
  doc "expect ACCEPT: two independent cursor loops, one per buffer, each cursor bounded by its own buffer's length via its own loop invariant";
  let left_len = len_of(left);
  let i = 0_u64;
  let total = 0_u64;
  loop (
    invariant i_bounded: i <= left_len
  ) {
    let i_more = i < left_len;
    if i_more {
      let left_val = left[i];
      let widened = cvt::<u8, u64>(left_val);
      set total = total +wrap widened;
      set i = i + 1_u64;
    } else {
      break;
    }
  }
  let right_len = len_of(right);
  let j = 0_u64;
  loop (
    invariant j_bounded: j <= right_len
  ) {
    let j_more = j < right_len;
    if j_more {
      let right_val = right[j];
      let widened = cvt::<u8, u64>(right_val);
      set total = total +wrap widened;
      set j = j + 1_u64;
    } else {
      break;
    }
  }
  return total;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let left = buffer_new(3_u64, 2_u8);
  let right = buffer_new(2_u64, 5_u8);
  let total = sum_all(left: move left, right: move right);
  if total == 16_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
