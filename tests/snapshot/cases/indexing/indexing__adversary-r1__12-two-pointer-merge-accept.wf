fn sum_all<const n_left: u64, const n_right: u64>(left: own FixedVector<u8, n_left>, right: own FixedVector<u8, n_right>) -> total: own u64 reads(left, right) {
  doc "expect ACCEPT: two independent cursor loops, one per buffer, each cursor bounded by its own buffer's length via its own loop invariant";
  let left_len = len_of(left);
  let i = 0_u64;
  let total = 0_u64;
  loop (
    invariant i_bounded: i <= left_len
  ) {
    let i_more = i < left_len;
    if i_more {
      let left_val = left[i];
      let widened = cvt::<u8, u64>(left_val);
      set total = total +wrap widened;
      set i = i + 1_u64;
    } else {
      break;
    }
  }
  let right_len = len_of(right);
  let j = 0_u64;
  loop (
    invariant j_bounded: j <= right_len
  ) {
    let j_more = j < right_len;
    if j_more {
      let right_val = right[j];
      let widened = cvt::<u8, u64>(right_val);
      set total = total +wrap widened;
      set j = j + 1_u64;
    } else {
      break;
    }
  }
  return total;
}

command fn main() -> status: own ExitStatus pure {
  let left = fixed_vector::<u8, 3>();
  set left = place_back(vector: move left, value: 2_u8);
  set left = place_back(vector: move left, value: 2_u8);
  set left = place_back(vector: move left, value: 2_u8);
  let right = fixed_vector::<u8, 2>();
  set right = place_back(vector: move right, value: 5_u8);
  set right = place_back(vector: move right, value: 5_u8);
  let total = sum_all::<3, 2>(left: move left, right: move right);
  if total == 16_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
