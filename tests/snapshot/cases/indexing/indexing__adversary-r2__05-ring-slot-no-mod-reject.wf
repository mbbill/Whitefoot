fn ring_slot(buf: own buffer<u8>, front: own u64, used: own u64) -> found: own u8 reads(buf) contract {
  define limit = len_of(buf);
  requires limit > 0_u64;
  requires front < limit;
  requires used < limit;
} {
  doc "expect REJECT: slot=front+wrap used has no reduction, so slot can reach 2*limit-2; front=5,used=6,limit=8 gives slot=11, out of buf";
  let slot = front +wrap used;
  let byte = buf[slot];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let buf = buffer_new(8_u64, 0_u8);
  let found = ring_slot(buf: move buf, front: 5_u64, used: 6_u64);
  return exit_status(code: found);
}
