fn bucket_offset<const n_buckets: u64>(buckets: own FixedVector<u8, n_buckets>, n: own u64) -> value: own Option<u8> reads(buckets) {
  doc "ACCEPT: n/4 selects the bucket and n%4 the offset inside it; the two are recombined with checked arithmetic and tested against the real buffer length before the load.";
  let bucket = n / 4_u64;
  let offset = n % 4_u64;
  match bucket *checked 4_u64 {
    Ok(value: bucket_start) => {
      match bucket_start +checked offset {
        Ok(value: at) => {
          let capacity = len_of(buckets);
          let fits = at < capacity;
          if fits {
          } else {
            return None<u8>();
          }
          let byte = buckets[at];
          return Some<u8>(value: byte);
        }
        Err(error: overflow) => {
          return None<u8>();
        }
      }
    }
    Err(error: overflow) => {
      return None<u8>();
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  let buckets = fixed_vector::<u8, 12>();
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets = place_back(vector: move buckets, value: 0_u8);
  set buckets[9_u64] = 77_u8;
  let found = bucket_offset::<12>(buckets: move buckets, n: 9_u64);
  match found {
    Some(value: byte) => {
      if byte == 77_u8 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 1_u8);
      }
    }
    None() => {
      return exit_status(code: 2_u8);
    }
  }
}
