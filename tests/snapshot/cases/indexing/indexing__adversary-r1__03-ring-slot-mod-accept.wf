fn ring_slot(buf: own buffer<u8>, front: own u64, used: own u64) -> value: own u8 reads(buf) contract {
  define capacity = len_of(buf);
  requires capacity > 0_u64;
} {
  doc "expect ACCEPT: ring-buffer slot = (front + used) % capacity is always < capacity by the definition of % for a positive divisor";
  let capacity = len_of(buf);
  let raw = front +wrap used;
  let slot = raw % capacity;
  let value = buf[slot];
  return value;
}

command fn main() -> status: own ExitStatus pure {
  let buf = buffer_new(4_u64, 9_u8);
  let value = ring_slot(buf: move buf, front: 3_u64, used: 5_u64);
  if value == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
