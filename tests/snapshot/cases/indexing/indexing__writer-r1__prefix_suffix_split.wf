fn head_sum<const n: u64>(data: own FixedVector<u8, n>, split: own u64) -> total: own u32 reads(data) contract {
  define capacity = len_of(data);
  requires split <= capacity;
} {
  doc "ACCEPT: sums the [0, split) prefix window; the split parameter is proved no larger than the buffer before the walk.";
  let sum = 0_u32;
  for (i in 0_u64..split) {
    let byte = data[i];
    let wide = cvt::<u8, u32>(byte);
    set sum = sum +wrap wide;
  }
  return sum;
}

fn tail_sum<const n: u64>(data: own FixedVector<u8, n>, split: own u64) -> total: own u32 reads(data) contract {
  define capacity = len_of(data);
  requires split <= capacity;
} {
  doc "ACCEPT: sums the [split, capacity) suffix window that head_sum leaves out, using the same split..capacity endpoint proof shape.";
  let capacity = len_of(data);
  let sum = 0_u32;
  for (i in split..capacity) {
    let byte = data[i];
    let wide = cvt::<u8, u32>(byte);
    set sum = sum +wrap wide;
  }
  return sum;
}

command fn main() -> status: own ExitStatus pure {
  let data = fixed_vector::<u8, 6>();
  set data = place_back(vector: move data, value: 2_u8);
  set data = place_back(vector: move data, value: 2_u8);
  set data = place_back(vector: move data, value: 2_u8);
  set data = place_back(vector: move data, value: 2_u8);
  set data = place_back(vector: move data, value: 2_u8);
  set data = place_back(vector: move data, value: 2_u8);
  let data2 = fixed_vector::<u8, 6>();
  set data2 = place_back(vector: move data2, value: 2_u8);
  set data2 = place_back(vector: move data2, value: 2_u8);
  set data2 = place_back(vector: move data2, value: 2_u8);
  set data2 = place_back(vector: move data2, value: 2_u8);
  set data2 = place_back(vector: move data2, value: 2_u8);
  set data2 = place_back(vector: move data2, value: 2_u8);
  let prefix = head_sum::<6>(data: move data, split: 2_u64);
  let suffix = tail_sum::<6>(data: move data2, split: 2_u64);
  if prefix == 4_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if suffix == 8_u32 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
