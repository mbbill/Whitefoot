fn drain_into(ring: own Slice<u8>, start: own u64, count: own u64, out: &uniq MutSlice<u8>) -> result: own unit reads(ring), writes(out) contract {
  define capacity = len_of(ring);
  define out_room = len_of(deref(out));
  requires capacity > 0_u64;
  requires start < capacity;
  requires count <= out_room;
} {
  let capacity = len_of(ring);
  for (i in 0_u64..count) {
    if start +defined i {
    } else {
      return unit;
    }
    let advanced = start + i;
    let slot = advanced % capacity;
    let byte = ring[slot];
    set deref(out)[i] = byte;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: the wrap index (start+i) % capacity is always inside [0, capacity) under [OP-2]'s remainder domain once capacity > 0; the for-loop's automatic i < count fact discharges the out[i] write [OP-4].";
  region 'w {
    let workspace = arena_frame::<9, 1, 'w>();
    region {
      let ring = arena_vector_proved::<u8>(store: &uniq workspace, count: 4_u64);
      for @fill_ring (
        at in 0_u64..4_u64,
        invariant grown_ring: len_of(ring) >= at,
        invariant spare_ring: room_of(ring) + at >= 4_u64,
        invariant flat_ring: head_of(ring) <= 0_u64
      ) {
        set ring = place_back(vector: move ring, value: 0_u8);
      }
      set ring[0_u64] = 10_u8;
      set ring[1_u64] = 11_u8;
      set ring[2_u64] = 12_u8;
      set ring[3_u64] = 13_u8;
      let out = arena_vector_proved::<u8>(store: &uniq workspace, count: 5_u64);
      for @fill_out (
        at in 0_u64..5_u64,
        invariant grown_out: len_of(out) >= at,
        invariant spare_out: room_of(out) + at >= 5_u64,
        invariant flat_out: head_of(out) <= 0_u64
      ) {
        set out = place_back(vector: move out, value: 0_u8);
      }
      region {
        let view_out = mut_slice_of(&uniq out);
        let read_ring = slice_of(&ring);
        region {
          drain_into(ring: read_ring, start: 2_u64, count: 5_u64, out: &uniq view_out);
        }
      }
      let first = out[0_u64];
      if first == 12_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
      let wrapped = out[2_u64];
      if wrapped == 10_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
      return exit_status(code: 0_u8);
    }
  }
}
