fn drain_into['r, 'd](ring: &'r buffer<u8>, start: own u64, count: own u64, out: &uniq 'd buffer<u8>) -> result: own unit reads(ring), writes(out) contract {
  define capacity = len(deref(ring));
  define out_room = len(deref(out));
  requires igt(capacity, 0_u64);
  requires ilt(start, capacity);
  requires ile(count, out_room);
} {
  let capacity = len(deref(ring));
  for (i in 0_u64..count) {
    if start +defined i {
    } else {
      return unit;
    }
    let advanced = start + i;
    let slot = advanced % capacity;
    let byte = deref(ring)[slot];
    set deref(out)[i] = byte;
  }
  return unit;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "ACCEPT: the wrap index (start+i) % capacity is always inside [0, capacity) under [OP-2]'s remainder domain once capacity > 0; the for-loop's automatic i < count fact discharges the out[i] write [OP-4].";
  let ring = buffer_new(4_u64, 0_u8);
  set ring[0_u64] = 10_u8;
  set ring[1_u64] = 11_u8;
  set ring[2_u64] = 12_u8;
  set ring[3_u64] = 13_u8;
  let out = buffer_new(5_u64, 0_u8);
  region 'r {
    drain_into<'r, 'r>(ring: &'r ring, start: 2_u64, count: 5_u64, out: &uniq 'r out);
  }
  let first = out[0_u64];
  if ieq(first, 12_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  let wrapped = out[2_u64];
  if ieq(wrapped, 10_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
