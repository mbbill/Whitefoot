fn probe(table: own buffer<u8>, idx: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires idx < spare;
} {
  doc "expect ACCEPT: requires idx < spare is the correct strict bound for table[idx]";
  let byte = table[idx];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let table = buffer_new(4_u64, 0_u8);
  let found = probe(table: move table, idx: 3_u64);
  return exit_status(code: found);
}
