fn fold_chunks(data: own Slice<u8>, chunk_size: own u64) -> result: own u32 reads(data) contract {
  requires chunk_size > 0_u64;
} {
  let length = len_of(data);
  let total = 0_u32;
  let carry = 0_u32;
  let pos_in_chunk = 0_u64;
  for (i in 0_u64..length) {
    let byte = data[i];
    let wide = cvt::<u8, u32>(byte);
    set carry = carry +wrap wide;
    set pos_in_chunk = pos_in_chunk +wrap 1_u64;
    let boundary = pos_in_chunk == chunk_size;
    if boundary {
      set total = total +wrap carry;
      set carry = 0_u32;
      set pos_in_chunk = 0_u64;
    }
  }
  let final_total = total +wrap carry;
  return final_total;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: the buffer subscript is discharged by the for-loop's automatic i < length fact (length is the same len_of(deref(data)) expression), and every accumulator step uses +wrap so no arithmetic domain obligation remains open.";
  let data = fixed_vector::<u8, 6>();
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  set data = place_back(vector: move data, value: 3_u8);
  region {
    let data_view = slice_of(&data);
    let folded = fold_chunks(data: data_view, chunk_size: 3_u64);
    if folded == 18_u32 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
