fn window_sum(buf: own buffer<u8>, offset: own u64, length: own u64) -> total: own u64 reads(buf) {
  doc "expect ACCEPT: only end<=spare is checked, offset<=end is NOT checked; offset=u64::MAX-2,length=5 wraps end to 2, but the for-range offset..end is empty since offset>end so the body never runs, remaining sound";
  let spare = len_of(buf);
  let end = offset +wrap length;
  let fits = end <= spare;
  let sum = 0_u64;
  if fits {
    for (
      i in offset..end,
      invariant within: end <= spare
    ) {
      let byte = buf[i];
      let widened = cvt::<u8, u64>(byte);
      set sum = sum +wrap widened;
    }
  }
  return sum;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let buf = buffer_new(10_u64, 3_u8);
  let total = window_sum(buf: move buf, offset: 18446744073709551613_u64, length: 5_u64);
  return exit_status(code: 0_u8);
}
