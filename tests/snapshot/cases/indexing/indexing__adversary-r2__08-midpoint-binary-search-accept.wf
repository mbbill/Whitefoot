fn probe<const n: u64>(table: own FixedVector<u8, n>, lo: own u64, hi: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires lo < hi;
  requires hi <= spare;
} {
  doc "expect ACCEPT: mid is the midpoint of [lo,hi), the OP-4 automatic division-image proof discharges table[mid]";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = lo + half;
  invariant inside: 2_u64 * mid + 1_u64 <= 2_u64 * hi;
  let byte = table[mid];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 10>();
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  let found = probe::<10>(table: move table, lo: 0_u64, hi: 10_u64);
  return exit_status(code: found);
}
