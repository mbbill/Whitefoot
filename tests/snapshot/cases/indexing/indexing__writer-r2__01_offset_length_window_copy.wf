fn copy_window['s, 'd](src: &'s buffer<u8>, dst: &uniq 'd buffer<u8>, start: own u64, end: own u64) -> result: own unit reads(src), writes(dst) contract {
  define room = len(deref(src));
  define out_room = len(deref(dst));
  requires ilt(start, end);
  requires ile(end, room);
  requires ile(end, out_room);
} {
  for (i in start..end) {
    let byte = deref(src)[i];
    set deref(dst)[i] = byte;
  }
  return unit;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "ACCEPT: window [start, end) is proved inside both buffers by contract; end <= room composes with the for-loop's automatic i < end fact under [OP-4]'s two-premise automatic rule.";
  let src = buffer_new(8_u64, 5_u8);
  let dst = buffer_new(8_u64, 0_u8);
  region 'r {
    copy_window<'r, 'r>(src: &'r src, dst: &uniq 'r dst, start: 2_u64, end: 5_u64);
  }
  let touched = dst[2_u64];
  if ieq(touched, 5_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  let untouched = dst[0_u64];
  if ieq(untouched, 0_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
