fn copy_window(src: own Slice<u8>, dst: &uniq MutSlice<u8>, start: own u64, end: own u64) -> result: own unit reads(src), writes(dst) contract {
  define spare = len_of(src);
  define out_room = len_of(deref(dst));
  requires start < end;
  requires end <= spare;
  requires end <= out_room;
} {
  for (i in start..end) {
    let byte = src[i];
    set deref(dst)[i] = byte;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: window [start, end) is proved inside both buffers by contract; end <= spare composes with the for-loop's automatic i < end fact under [OP-4]'s two-premise automatic rule.";
  region 'w {
    let workspace = arena_frame::<16, 1, 'w>();
    region {
      let src = arena_vector_proved::<u8>(store: &uniq workspace, count: 8_u64);
      for @fill_src (
        at in 0_u64..8_u64,
        invariant grown_src: len_of(src) >= at,
        invariant spare_src: room_of(src) + at >= 8_u64,
        invariant flat_src: head_of(src) <= 0_u64
      ) {
        set src = place_back(vector: move src, value: 5_u8);
      }
      let dst = arena_vector_proved::<u8>(store: &uniq workspace, count: 8_u64);
      for @fill_dst (
        at in 0_u64..8_u64,
        invariant grown_dst: len_of(dst) >= at,
        invariant spare_dst: room_of(dst) + at >= 8_u64,
        invariant flat_dst: head_of(dst) <= 0_u64
      ) {
        set dst = place_back(vector: move dst, value: 0_u8);
      }
      region {
        let view_dst = mut_slice_of(&uniq dst);
        let read_src = slice_of(&src);
        region {
          copy_window(src: read_src, dst: &uniq view_dst, start: 2_u64, end: 5_u64);
        }
      }
      let touched = dst[2_u64];
      if touched == 5_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
      let untouched = dst[0_u64];
      if untouched == 0_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
      return exit_status(code: 0_u8);
    }
  }
}
