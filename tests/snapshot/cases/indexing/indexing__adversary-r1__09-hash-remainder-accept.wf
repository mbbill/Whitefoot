fn bucket_of(table: own buffer<u8>, key: own u64) -> value: own u8 reads(table) contract {
  define table_size = len(table);
  requires table_size > 0_u64;
} {
  doc "expect ACCEPT: table index = key % table_size is always < table_size for any u64 key when table_size > 0";
  let table_size = len(table);
  let slot = key % table_size;
  invariant slot_in_range: slot < table_size;
  let value = table[slot];
  return value;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let table = buffer_new(7_u64, 0_u8);
  set table[5_u64] = 42_u8;
  let value = bucket_of(table: move table, key: 12_u64);
  if value == 42_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
