fn bucket_of<const n: u64>(table: own FixedVector<u8, n>, key: own u64) -> value: own u8 reads(table) contract {
  define table_size = len_of(table);
  requires table_size > 0_u64;
} {
  doc "expect ACCEPT: table index = key % table_size is always < table_size for any u64 key when table_size > 0";
  let table_size = len_of(table);
  let slot = key % table_size;
  invariant slot_in_range: slot < table_size;
  let value = table[slot];
  return value;
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 7>();
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table[5_u64] = 42_u8;
  let value = bucket_of::<7>(table: move table, key: 12_u64);
  if value == 42_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
