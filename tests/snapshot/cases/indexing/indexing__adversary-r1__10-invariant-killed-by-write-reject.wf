fn shifted_read<const n: u64>(buf: own FixedVector<u8, n>, offset: own u64, shift: own u64) -> value: own u8 reads(buf) contract {
  define spare = len_of(buf);
  requires offset < spare;
  requires shift < spare;
} {
  doc "expect REJECT (OP-2/OP-4): offset is proven in range before it is overwritten by a set that adds shift; the requires facts about the old offset must not carry to the new value used in the subscript";
  let spare = len_of(buf);
  invariant offset_in_range: offset < spare;
  set offset = offset + shift;
  let value = buf[offset];
  return value;
}

command fn main() -> status: own ExitStatus pure {
  let buf = fixed_vector::<u8, 4>();
  set buf = place_back(vector: move buf, value: 7_u8);
  set buf = place_back(vector: move buf, value: 7_u8);
  set buf = place_back(vector: move buf, value: 7_u8);
  set buf = place_back(vector: move buf, value: 7_u8);
  let value = shifted_read::<4>(buf: move buf, offset: 3_u64, shift: 3_u64);
  if value == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
