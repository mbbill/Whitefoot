fn scan_with_carry<const n: u64>(buf: own FixedVector<u8, n>, start_carry: own u64) -> total: own u64 reads(buf) {
  doc "expect REJECT (OP-2): carry can exceed cursor on the first iteration (cursor=0, carry=1), so cursor - carry underflows u64 before any bound on carry < cursor is established";
  let spare = len_of(buf);
  let cursor = 0_u64;
  let carry = start_carry;
  let total = 0_u64;
  loop (
    invariant cursor_bounded: cursor <= spare
  ) {
    let more = cursor < spare;
    if more {
      let back_index = cursor - carry;
      let value = buf[back_index];
      let widened = cvt::<u8, u64>(value);
      set total = total +wrap widened;
      set carry = 1_u64;
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  return total;
}

command fn main() -> status: own ExitStatus pure {
  let buf = fixed_vector::<u8, 5>();
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  let total = scan_with_carry::<5>(buf: move buf, start_carry: 1_u64);
  if total == 10_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
