fn circular_read(table: own FixedVector<u8, 6>, base: own u64, steps: own u64) -> value: own Option<u8> reads(table) contract {
  requires len_of(table) >= 6_u64;
} {
  doc "ACCEPT: reads one slot at (base+steps) mod 6 in a fixed 6-slot circular table; the remainder is always strictly below the fixed literal divisor, so the subscript needs no written certificate once the checked advance succeeds.";
  match base +checked steps {
    Ok(value: advanced) => {
      let slot = advanced % 6_u64;
      let byte = table[slot];
      return Some<u8>(value: byte);
    }
    Err(error: overflow) => {
      return None<u8>();
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 6>();
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  let found = circular_read(table: move table, base: 4_u64, steps: 9_u64);
  match found {
    Some(value: byte) => {
      if byte == 0_u8 {
        return exit_status(code: 0_u8);
      } else {
        return exit_status(code: 1_u8);
      }
    }
    None() => {
      return exit_status(code: 2_u8);
    }
  }
}
