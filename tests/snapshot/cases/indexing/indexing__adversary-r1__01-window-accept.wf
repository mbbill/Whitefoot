fn window_last(buf: own buffer<u8>, start: own u64, end: own u64) -> value: own u8 reads(buf) contract {
  define spare = len_of(buf);
  requires start < end;
  requires end <= spare;
} {
  doc "expect ACCEPT: start < end <= len_of(buf), so end - 1 (the window's last position) is a valid buffer index";
  let last_index = end - 1_u64;
  let value = buf[last_index];
  return value;
}

command fn main() -> status: own ExitStatus pure {
  let buf = buffer_new(8_u64, 5_u8);
  let value = window_last(buf: move buf, start: 2_u64, end: 5_u64);
  if value == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
