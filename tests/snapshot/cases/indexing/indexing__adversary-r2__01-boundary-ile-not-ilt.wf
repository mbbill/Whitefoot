fn probe(table: own buffer<u8>, idx: own u64) -> found: own u8 reads(table) contract {
  define room = len(table);
  requires idx <= room;
} {
  doc "expect REJECT: requires idx <= room admits idx == room, out of bounds for table[idx]; idx=4,room=4 would read table[4] on a length-4 buffer";
  let byte = table[idx];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let table = buffer_new(4_u64, 0_u8);
  let found = probe(table: move table, idx: 4_u64);
  return exit_status(code: found);
}
