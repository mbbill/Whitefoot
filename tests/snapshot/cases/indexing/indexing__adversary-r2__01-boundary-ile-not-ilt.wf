fn probe<const n: u64>(table: own FixedVector<u8, n>, idx: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires idx <= spare;
} {
  doc "expect REJECT: requires idx <= spare admits idx == spare, out of bounds for table[idx]; idx=4,spare=4 would read table[4] on a length-4 buffer";
  let byte = table[idx];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 4>();
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  set table = place_back(vector: move table, value: 0_u8);
  let found = probe::<4>(table: move table, idx: 4_u64);
  return exit_status(code: found);
}
