fn ring_slot_sub(buf: own buffer<u8>, front: own u64, used: own u64) -> value: own u8 reads(buf) contract {
  define capacity = len_of(buf);
  requires front < capacity;
  requires used < capacity;
  requires capacity <= 4294967296_u64;
} {
  doc "expect ACCEPT: manual wraparound (front + used, then subtract capacity once if too big) proves slot < capacity given front < capacity, used < capacity, and a capacity ceiling that keeps front + used from overflowing u64";
  let capacity = len_of(buf);
  let raw = front + used;
  let too_big = raw >= capacity;
  let value = if too_big {
    let wrapped = raw - capacity;
    invariant wrapped_ok: wrapped < capacity;
    let byte = buf[wrapped];
    give byte;
  } else {
    invariant raw_ok: raw < capacity;
    let byte = buf[raw];
    give byte;
  }
  return value;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let buf = buffer_new(4_u64, 9_u8);
  let value = ring_slot_sub(buf: move buf, front: 3_u64, used: 3_u64);
  if value == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
