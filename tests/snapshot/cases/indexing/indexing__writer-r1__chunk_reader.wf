struct ChunkReader {
  buf: buffer<u8>;
  pos: u64;
}

fn reader_new(buf: own buffer<u8>) -> result: own ChunkReader pure {
  return ChunkReader(buf: move buf, pos: 0_u64);
}

fn reader_next_chunk['a](r: &uniq 'a ChunkReader, chunk_size: own u64) -> result: own Option<u64> reads(r.buf, r.pos), writes(r.pos) {
  doc "ACCEPT: advances a chunk reader by a fixed stride, carrying the tail short chunk as a smaller final read instead of an out-of-range one.";
  let capacity = len(deref(r).buf);
  let pos = deref(r).pos;
  let exhausted = pos >= capacity;
  if exhausted {
    return None<u64>();
  }
  let remaining = capacity - pos;
  let short = remaining < chunk_size;
  if short {
    set deref(r).pos = capacity;
    return Some<u64>(value: remaining);
  }
  let next_pos = pos + chunk_size;
  set deref(r).pos = next_pos;
  return Some<u64>(value: chunk_size);
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let buf = buffer_new(10_u64, 7_u8);
  let reader = reader_new(buf: move buf);
  region 'r {
    let first = reader_next_chunk::<'r>(r: &uniq 'r reader, chunk_size: 4_u64);
    match first {
      Some(value: n) => {
        if n == 4_u64 {
        } else {
          return exit_status(code: 1_u8);
        }
      }
      None() => {
        return exit_status(code: 2_u8);
      }
    }
    let second = reader_next_chunk::<'r>(r: &uniq 'r reader, chunk_size: 4_u64);
    let third = reader_next_chunk::<'r>(r: &uniq 'r reader, chunk_size: 4_u64);
    match third {
      Some(value: n) => {
        if n == 2_u64 {
        } else {
          return exit_status(code: 3_u8);
        }
      }
      None() => {
        return exit_status(code: 4_u8);
      }
    }
    let fourth = reader_next_chunk::<'r>(r: &uniq 'r reader, chunk_size: 4_u64);
    match fourth {
      Some(value: n) => {
        return exit_status(code: 5_u8);
      }
      None() => {
        return exit_status(code: 0_u8);
      }
    }
  }
}
