fn block_checksum(data: own buffer<u8>, block_size: own u64) -> total: own u32 reads(data) contract {
  requires igt(block_size, 0_u64);
} {
  doc "ACCEPT: sums a buffer in fixed-size blocks with a short final block; the checked stride is tested against the real length before every step, so a full block and the trailing remainder both stay in range without a written certificate.";
  let capacity = len(data);
  let pos = 0_u64;
  let sum = 0_u32;
  loop @blocks (
    invariant progress: ile(pos, capacity)
  ) {
    let has_more = ilt(pos, capacity);
    if has_more {
    } else {
      break @blocks;
    }
    match pos +checked block_size {
      Ok(value: would_be) => {
        let fits = ile(would_be, capacity);
        if fits {
          let stop = would_be;
          for (i in pos..stop) {
            let byte = data[i];
            let wide = cvt<u8, u32>(byte);
            set sum = sum +wrap wide;
          }
          set pos = stop;
        } else {
          for (i in pos..capacity) {
            let byte = data[i];
            let wide = cvt<u8, u32>(byte);
            set sum = sum +wrap wide;
          }
          set pos = capacity;
        }
      }
      Err(error: overflow) => {
        for (i in pos..capacity) {
          let byte = data[i];
          let wide = cvt<u8, u32>(byte);
          set sum = sum +wrap wide;
        }
        set pos = capacity;
      }
    }
  }
  return sum;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let data = buffer_new(10_u64, 1_u8);
  let total = block_checksum(data: move data, block_size: 4_u64);
  if ieq(total, 10_u32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
