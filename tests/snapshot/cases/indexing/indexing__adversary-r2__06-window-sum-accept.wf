fn window_sum<const n: u64>(buf: own FixedVector<u8, n>, offset: own u64, length: own u64) -> total: own u64 reads(buf) {
  doc "expect ACCEPT: runtime-checked offset+length within spare, so every i in offset..end is < spare and buf[i] is in bounds";
  let spare = len_of(buf);
  let end = offset +wrap length;
  let fits = end <= spare;
  let ordered = offset <= end;
  let sum = 0_u64;
  if fits {
    if ordered {
      for (
        i in offset..end,
        invariant within: end <= spare
      ) {
        let byte = buf[i];
        let widened = cvt::<u8, u64>(byte);
        set sum = sum +wrap widened;
      }
    }
  }
  return sum;
}

command fn main() -> status: own ExitStatus pure {
  let buf = fixed_vector::<u8, 10>();
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  set buf = place_back(vector: move buf, value: 3_u8);
  let total = window_sum::<10>(buf: move buf, offset: 2_u64, length: 5_u64);
  if total == 15_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
