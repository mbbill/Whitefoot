fn probe(table: own buffer<u8>, lo: own u64, hi: own u64) -> found: own u8 reads(table) contract {
  define spare = len_of(table);
  requires lo < hi;
  requires hi <= spare;
} {
  doc "expect ACCEPT: AUTO proves the doubled midpoint relation from the division image and lo < hi, so mid = lo + (hi - lo) / 2 needs no written certificate to index table [OP-4]";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = lo + half;
  invariant inside: 2_u64 * mid + 1_u64 <= 2_u64 * hi;
  let byte = table[mid];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let table = buffer_new(8_u64, 0_u8);
  set table[0_u64] = 1_u8;
  set table[1_u64] = 3_u8;
  set table[2_u64] = 5_u8;
  set table[3_u64] = 7_u8;
  set table[4_u64] = 9_u8;
  set table[5_u64] = 11_u8;
  set table[6_u64] = 13_u8;
  set table[7_u64] = 15_u8;
  let first_mid = probe(table: move table, lo: 0_u64, hi: 8_u64);
  if first_mid == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let table2 = buffer_new(8_u64, 0_u8);
  set table2[0_u64] = 1_u8;
  set table2[1_u64] = 3_u8;
  set table2[2_u64] = 5_u8;
  set table2[3_u64] = 7_u8;
  set table2[4_u64] = 9_u8;
  set table2[5_u64] = 11_u8;
  set table2[6_u64] = 13_u8;
  set table2[7_u64] = 15_u8;
  let second_mid = probe(table: move table2, lo: 4_u64, hi: 8_u64);
  if second_mid == 13_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
