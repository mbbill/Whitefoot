fn bucket_of(values: own buffer<u8>, n: own u64) -> found: own u8 reads(values) {
  doc "expect ACCEPT: idx = n/10 is runtime-checked idx < spare before the subscript, so the access is always in bounds";
  let spare = len_of(values);
  let idx = n / 10_u64;
  let safe = idx < spare;
  let byte = 0_u8;
  if safe {
    set byte = values[idx];
  }
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let values = buffer_new(10_u64, 4_u8);
  let found = bucket_of(values: move values, n: 99_u64);
  return exit_status(code: found);
}
