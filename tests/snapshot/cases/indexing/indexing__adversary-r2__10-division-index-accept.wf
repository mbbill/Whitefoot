fn bucket_of<const n_values: u64>(values: own FixedVector<u8, n_values>, n: own u64) -> found: own u8 reads(values) {
  doc "expect ACCEPT: idx = n/10 is runtime-checked idx < spare before the subscript, so the access is always in bounds";
  let spare = len_of(values);
  let idx = n / 10_u64;
  let safe = idx < spare;
  let byte = 0_u8;
  if safe {
    set byte = values[idx];
  }
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let values = fixed_vector::<u8, 10>();
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  set values = place_back(vector: move values, value: 4_u8);
  let found = bucket_of::<10>(values: move values, n: 99_u64);
  return exit_status(code: found);
}
