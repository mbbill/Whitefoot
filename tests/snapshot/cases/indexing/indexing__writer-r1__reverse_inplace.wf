fn reverse_bytes<const n: u64>(buf: own FixedVector<u8, n>) -> out: own FixedVector<u8, n> reads(buf), writes(buf) {
  doc "ACCEPT: in-place reversal by two-pointer swap; a rising index and a falling mirror index are each proved inside the buffer independently, so the swap needs no written certificate.";
  let work = move buf;
  let capacity = len_of(work);
  let lo = 0_u64;
  let hi = capacity;
  loop @rev (
    invariant lo_bound: lo <= capacity,
    invariant hi_bound: hi <= capacity
  ) {
    let has_more = lo < hi;
    if has_more {
    } else {
      break @rev;
    }
    let mirror = hi - 1_u64;
    let left = work[lo];
    let right = work[mirror];
    set work[lo] = right;
    set work[mirror] = left;
    set lo = lo + 1_u64;
    set hi = mirror;
  }
  return move work;
}

command fn main() -> status: own ExitStatus pure {
  let buf = fixed_vector::<u8, 5>();
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf[0_u64] = 1_u8;
  set buf[1_u64] = 2_u8;
  set buf[2_u64] = 3_u8;
  set buf[3_u64] = 4_u8;
  set buf[4_u64] = 5_u8;
  let reversed = reverse_bytes::<5>(buf: move buf);
  let width = len_of(reversed);
  if width == 5_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  let first = reversed[0_u64];
  let last = reversed[4_u64];
  if first == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if last == 1_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
