fn probe(table: own buffer<u8>, lo: own u64, hi: own u64) -> found: own u8 reads(table) contract {
  define room = len(table);
  requires lo < hi;
  requires hi <= room;
} {
  doc "expect REJECT: ceiling midpoint mid=hi-(hi-lo)/2 reaches mid=hi when hi-lo=1; lo=9,hi=10,room=10 gives mid=10, table[10] is out of bounds";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = hi - half;
  let byte = table[mid];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let table = buffer_new(10_u64, 7_u8);
  let found = probe(table: move table, lo: 9_u64, hi: 10_u64);
  return exit_status(code: found);
}
