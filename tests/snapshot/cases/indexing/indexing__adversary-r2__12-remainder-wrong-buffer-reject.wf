fn cross_index<const n_small: u64, const n_big: u64>(small: own FixedVector<u8, n_small>, big: own FixedVector<u8, n_big>, n: own u64) -> found: own u8 reads(small, big) contract {
  define big_room = len_of(big);
  requires big_room > 0_u64;
} {
  doc "expect REJECT: bounded is reduced mod len_of(big), not mod len_of(small); small has 4 slots, big has 20, so bounded=15 (n=15,big_room=20) is out of range for small[bounded]";
  let big_room = len_of(big);
  let bounded = n % big_room;
  let byte = small[bounded];
  return byte;
}

command fn main() -> status: own ExitStatus pure {
  let small = fixed_vector::<u8, 4>();
  set small = place_back(vector: move small, value: 1_u8);
  set small = place_back(vector: move small, value: 1_u8);
  set small = place_back(vector: move small, value: 1_u8);
  set small = place_back(vector: move small, value: 1_u8);
  let big = fixed_vector::<u8, 20>();
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  set big = place_back(vector: move big, value: 2_u8);
  let found = cross_index::<4, 20>(small: move small, big: move big, n: 15_u64);
  return exit_status(code: found);
}
