fn cross_index(small: own buffer<u8>, big: own buffer<u8>, n: own u64) -> found: own u8 reads(small, big) contract {
  define big_room = len(big);
  requires igt(big_room, 0_u64);
} {
  doc "expect REJECT: bounded is reduced mod len(big), not mod len(small); small has 4 slots, big has 20, so bounded=15 (n=15,big_room=20) is out of range for small[bounded]";
  let big_room = len(big);
  let bounded = n % big_room;
  let byte = small[bounded];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let small = buffer_new(4_u64, 1_u8);
  let big = buffer_new(20_u64, 2_u8);
  let found = cross_index(small: move small, big: move big, n: 15_u64);
  return exit_status(code: found);
}
