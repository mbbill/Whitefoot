struct Ring {
  slots: buffer<u8>;
  front: u64;
  used: u64;
}

fn push_slot(r: &uniq Ring, value: own u8) -> result: own unit reads(r.slots, r.front, r.used), writes(r.slots) contract {
  define capacity = len_of(deref(r).slots);
  requires capacity > 0_u64;
  requires deref(r).front < capacity;
  requires deref(r).used < capacity;
} {
  let capacity = len_of(deref(r).slots);
  let front = deref(r).front;
  let used = deref(r).used;
  if front +defined used {
  } else {
    return unit;
  }
  let sum = front + used;
  let slot = sum % capacity;
  set deref(r).slots[slot] = value;
  return unit;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "ACCEPT: the ring-buffer slot front+used, wrapped by %capacity, always lands inside the fixed-size backing buffer under [OP-4] and [OP-2]'s remainder domain.";
  let backing = buffer_new(4_u64, 0_u8);
  let ring = Ring(slots: move backing, front: 1_u64, used: 2_u64);
  let capacity = len_of(ring.slots);
  let head_ok = ring.front < capacity;
  let used_ok = ring.used < capacity;
  if capacity > 0_u64 {
    if head_ok {
      if used_ok {
        region {
          push_slot(r: &uniq ring, value: 9_u8);
        }
      } else {
        return exit_status(code: 1_u8);
      }
    } else {
      return exit_status(code: 1_u8);
    }
  } else {
    return exit_status(code: 1_u8);
  }
  let final_room = len_of(ring.slots);
  if 3_u64 < final_room {
    let written = ring.slots[3_u64];
    if written == 9_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
