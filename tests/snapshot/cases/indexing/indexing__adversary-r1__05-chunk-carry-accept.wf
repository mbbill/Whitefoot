fn sum_chunks<const n: u64>(buf: own FixedVector<u8, n>, chunk_size: own u64) -> total: own u64 reads(buf) contract {
  define spare = len_of(buf);
  requires chunk_size > 0_u64;
  requires chunk_size <= 2147483648_u64;
  requires spare <= 2147483648_u64;
} {
  doc "expect ACCEPT: chunk reader walks buf in fixed-size chunks; the loop only reads a chunk after proving cursor + chunk_size <= len_of(buf)";
  let spare = len_of(buf);
  let cursor = 0_u64;
  let total = 0_u64;
  loop (
    invariant cursor_in_range: cursor <= spare
  ) {
    let chunk_end = cursor + chunk_size;
    let has_full_chunk = chunk_end <= spare;
    if has_full_chunk {
      let first = buf[cursor];
      let widened = cvt::<u8, u64>(first);
      set total = total +wrap widened;
      set cursor = chunk_end;
    } else {
      break;
    }
  }
  return total;
}

command fn main() -> status: own ExitStatus pure {
  let buf = fixed_vector::<u8, 9>();
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  set buf = place_back(vector: move buf, value: 2_u8);
  let total = sum_chunks::<9>(buf: move buf, chunk_size: 3_u64);
  if total == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
