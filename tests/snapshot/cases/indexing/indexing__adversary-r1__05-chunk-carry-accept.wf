fn sum_chunks(buf: own buffer<u8>, chunk_size: own u64) -> total: own u64 reads(buf) contract {
  define room = len(buf);
  requires chunk_size > 0_u64;
  requires chunk_size <= 2147483648_u64;
  requires room <= 2147483648_u64;
} {
  doc "expect ACCEPT: chunk reader walks buf in fixed-size chunks; the loop only reads a chunk after proving cursor + chunk_size <= len(buf)";
  let room = len(buf);
  let cursor = 0_u64;
  let total = 0_u64;
  loop (
    invariant cursor_in_range: cursor <= room
  ) {
    let chunk_end = cursor + chunk_size;
    let has_full_chunk = chunk_end <= room;
    if has_full_chunk {
      let first = buf[cursor];
      let widened = cvt::<u8, u64>(first);
      set total = total +wrap widened;
      set cursor = chunk_end;
    } else {
      break;
    }
  }
  return total;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let buf = buffer_new(9_u64, 2_u8);
  let total = sum_chunks(buf: move buf, chunk_size: 3_u64);
  if total == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
