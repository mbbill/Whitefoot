command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT: the body attempts to set the counted for-loop binder i directly, which the counted header does not carry as a mutable identity and must be rejected rather than silently accepted as a way to widen its proven range";
  let data = fixed_vector::<u8, 5>();
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data[0_u64] = 1_u8;
  set data[1_u64] = 2_u8;
  set data[2_u64] = 3_u8;
  set data[3_u64] = 4_u8;
  set data[4_u64] = 5_u8;
  let total = 0_u8;
  for (i in 0_u64..5_u64) {
    set i = i +wrap 100_u64;
    let value = data[i];
    set total = total +wrap value;
  }
  let correct = total == 15_u8;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
