fn count_to(limit: own u64) -> reached: own u64 pure {
  let cursor = 0_u64;
  loop (
    invariant bounded: ile(cursor, limit)
  ) {
    let more = ilt(cursor, limit);
    if more {
      invariant guarded: ilt(cursor, limit);
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: ordinary loop guarded increment stays in [0,limit], no OOB";
  let reached = count_to(limit: 6_u64);
  let correct = ieq(reached, 6_u64);
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
