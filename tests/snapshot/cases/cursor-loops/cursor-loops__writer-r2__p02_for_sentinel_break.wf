const data: array<u64, 6> =[3_u64, 7_u64, 0_u64, 9_u64, 2_u64, 5_u64];

fn find_sentinel(values: own Slice<u64>) -> found: own u64 reads(values) {
  doc "ACCEPT: counted for cursor scans a slice and breaks on the first sentinel value it meets.";
  let length = len_of(values);
  let found = length;
  for (i in 0_u64..length) {
    let value = values[i];
    let hit = value == 0_u64;
    if hit {
      set found = i;
      break;
    }
  }
  return found;
}

command fn main() -> status: own ExitStatus pure {
  region {
    let view = slice_of(&data);
    let found = find_sentinel(values: view);
    let correct = found == 2_u64;
    if correct {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
