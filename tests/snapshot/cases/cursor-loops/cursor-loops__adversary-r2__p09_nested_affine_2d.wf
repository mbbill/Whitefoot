command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: nested counted loops over a 3x4 flat array with affine index row*4+col stay in bounds";
  let grid = array_new::<u64, 12>(0_u64);
  let total = 0_u64;
  for (
    row in 0_u64..3_u64,
    invariant total_nonneg: total >= 0_u64
  ) {
    for (
      col in 0_u64..4_u64,
      invariant row_bound: row < 3_u64
    ) {
      let base = row * 4_u64;
      let flat = base + col;
      set grid[flat] = flat;
    }
  }
  for (k in 0_u64..12_u64) {
    let value = grid[k];
    set total = total +wrap value;
  }
  let correct = total == 66_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
