command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: a source cursor advances every iteration while a destination cursor advances only when a nonzero guard passes, compacting nonzero bytes toward the front of an array with the header invariant that the destination cursor never runs ahead of the source.";
  let source = fixed_vector::<u8, 6>();
  set source = place_back(vector: move source, value: 0_u8);
  set source = place_back(vector: move source, value: 0_u8);
  set source = place_back(vector: move source, value: 0_u8);
  set source = place_back(vector: move source, value: 0_u8);
  set source = place_back(vector: move source, value: 0_u8);
  set source = place_back(vector: move source, value: 0_u8);
  set source[0_u64] = 0_u8;
  set source[1_u64] = 7_u8;
  set source[2_u64] = 0_u8;
  set source[3_u64] = 3_u8;
  set source[4_u64] = 0_u8;
  set source[5_u64] = 9_u8;
  let dest = fixed_vector::<u8, 6>();
  set dest = place_back(vector: move dest, value: 0_u8);
  set dest = place_back(vector: move dest, value: 0_u8);
  set dest = place_back(vector: move dest, value: 0_u8);
  set dest = place_back(vector: move dest, value: 0_u8);
  set dest = place_back(vector: move dest, value: 0_u8);
  set dest = place_back(vector: move dest, value: 0_u8);
  let dest_cursor = 0_u64;
  for (
    src_cursor in 0_u64..6_u64,
    invariant dest_behind_src: dest_cursor <= src_cursor
  ) {
    let value = source[src_cursor];
    let keep = value > 0_u8;
    if keep {
      set dest[dest_cursor] = value;
      set dest_cursor = dest_cursor + 1_u64;
    }
  }
  if dest_cursor == 3_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let first = dest[0_u64];
  if first == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
