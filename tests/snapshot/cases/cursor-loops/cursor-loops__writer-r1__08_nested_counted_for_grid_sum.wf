command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: two nested counted for loops walk a fixed grid row by row and column by column, guarding each addend against a diagonal skip before accumulating a wrapped total.";
  let grid = fixed_vector::<u32, 9>();
  for (
    at_grid in 0_u64..9_u64,
    invariant grown_grid: len_of(grid) >= at_grid,
    invariant spare_grid: room_of(grid) + at_grid >= 9_u64,
    invariant flat_grid: head_of(grid) <= 0_u64
  ) {
    set grid = place_back(vector: move grid, value: 1_u32);
  }
  let total = 0_u32;
  for (row in 0_u64..3_u64) {
    for (col in 0_u64..3_u64) {
      let on_diagonal = row == col;
      if on_diagonal {
      } else {
        let index = row * 3_u64;
        let flat = index + col;
        let flat_in_bounds = flat < 9_u64;
        if flat_in_bounds {
        } else {
          return exit_status(code: 1_u8);
        }
        let cell = grid[flat];
        set total = total +wrap cell;
      }
    }
  }
  if total == 6_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
