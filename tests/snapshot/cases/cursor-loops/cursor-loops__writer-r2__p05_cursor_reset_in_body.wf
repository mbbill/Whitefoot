fn fill_ring(capacity: own u64, steps: own u64) -> last_cursor: own u64 pure {
  doc "ACCEPT: an ordinary loop's write cursor resets to zero inside the body whenever it reaches the ring capacity.";
  let cursor = 0_u64;
  let taken = 0_u64;
  loop (
    invariant bounded: cursor <= capacity,
    invariant progress: taken <= steps
  ) {
    let pending = taken < steps;
    if pending {
      let wrapped = cursor >= capacity;
      if wrapped {
        set cursor = 0_u64;
      }
      let spare = cursor < capacity;
      if spare {
        set cursor = cursor + 1_u64;
      }
      set taken = taken + 1_u64;
    } else {
      break;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  let last = fill_ring(capacity: 4_u64, steps: 10_u64);
  let correct = last == 2_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
