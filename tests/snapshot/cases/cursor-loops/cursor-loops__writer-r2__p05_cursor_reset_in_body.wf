fn fill_ring(capacity: own u64, steps: own u64) -> last_cursor: own u64 pure {
  doc "ACCEPT: an ordinary loop's write cursor resets to zero inside the body whenever it reaches the ring capacity.";
  let cursor = 0_u64;
  let taken = 0_u64;
  loop (
    invariant bounded: ile(cursor, capacity),
    invariant progress: ile(taken, steps)
  ) {
    let pending = ilt(taken, steps);
    if pending {
      let wrapped = ige(cursor, capacity);
      if wrapped {
        set cursor = 0_u64;
      }
      let room = ilt(cursor, capacity);
      if room {
        set cursor = cursor + 1_u64;
      }
      set taken = taken + 1_u64;
    } else {
      break;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  let last = fill_ring(capacity: 4_u64, steps: 10_u64);
  let correct = ieq(last, 2_u64);
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
