command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: labelled break escapes an inner ordinary loop from a nested search, outer for continues to completion";
  let grid = array_new<u8, 9>(0_u8);
  set grid[4_u64] = 7_u8;
  let hits = 0_u64;
  for @rows (row in 0_u64..3_u64) {
    let col = 0_u64;
    loop @cols (
      invariant bounded: ile(col, 3_u64)
    ) {
      let in_range = ilt(col, 3_u64);
      if in_range {
      } else {
        break @cols;
      }
      let scaled_row = row * 3_u64;
      let index = scaled_row +wrap col;
      let in_grid = ilt(index, 9_u64);
      if in_grid {
        let value = grid[index];
        let hit = ieq(value, 7_u8);
        if hit {
          set hits = hits +wrap 1_u64;
          break @cols;
        }
      }
      set col = col + 1_u64;
    }
  }
  if ieq(hits, 1_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
