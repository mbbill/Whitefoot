command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: labelled break escapes an inner ordinary loop from a nested search, outer for continues to completion";
  let grid = fixed_vector::<u8, 9>();
  for (
    at_grid in 0_u64..9_u64,
    invariant grown_grid: len_of(grid) >= at_grid,
    invariant spare_grid: room_of(grid) + at_grid >= 9_u64,
    invariant flat_grid: head_of(grid) <= 0_u64
  ) {
    set grid = place_back(vector: move grid, value: 0_u8);
  }
  set grid[4_u64] = 7_u8;
  let hits = 0_u64;
  for @rows (row in 0_u64..3_u64) {
    let col = 0_u64;
    loop @cols (
      invariant bounded: col <= 3_u64
    ) {
      let in_range = col < 3_u64;
      if in_range {
      } else {
        break @cols;
      }
      let scaled_row = row * 3_u64;
      let index = scaled_row +wrap col;
      let in_grid = index < 9_u64;
      if in_grid {
        let value = grid[index];
        let hit = value == 7_u8;
        if hit {
          set hits = hits +wrap 1_u64;
          break @cols;
        }
      }
      set col = col + 1_u64;
    }
  }
  if hits == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
