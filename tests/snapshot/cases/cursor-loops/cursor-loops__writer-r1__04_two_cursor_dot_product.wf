command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: an ordinary loop advances two independent cursors together over two equal-length arrays, guarding both against their bound before each step and accumulating a wrapped dot product.";
  let left = fixed_vector::<u32, 5>();
  set left = place_back(vector: move left, value: 0_u32);
  set left = place_back(vector: move left, value: 0_u32);
  set left = place_back(vector: move left, value: 0_u32);
  set left = place_back(vector: move left, value: 0_u32);
  set left = place_back(vector: move left, value: 0_u32);
  let right = fixed_vector::<u32, 5>();
  set right = place_back(vector: move right, value: 0_u32);
  set right = place_back(vector: move right, value: 0_u32);
  set right = place_back(vector: move right, value: 0_u32);
  set right = place_back(vector: move right, value: 0_u32);
  set right = place_back(vector: move right, value: 0_u32);
  set left[0_u64] = 2_u32;
  set left[1_u64] = 3_u32;
  set left[2_u64] = 4_u32;
  set left[3_u64] = 5_u32;
  set left[4_u64] = 6_u32;
  set right[0_u64] = 1_u32;
  set right[1_u64] = 1_u32;
  set right[2_u64] = 1_u32;
  set right[3_u64] = 1_u32;
  set right[4_u64] = 1_u32;
  let cursor_a = 0_u64;
  let cursor_b = 0_u64;
  let total = 0_u32;
  loop @walk {
    let a_in_bounds = cursor_a < 5_u64;
    if a_in_bounds {
    } else {
      break @walk;
    }
    let b_in_bounds = cursor_b < 5_u64;
    if b_in_bounds {
    } else {
      break @walk;
    }
    let lv = left[cursor_a];
    let rv = right[cursor_b];
    let product = lv *wrap rv;
    set total = total +wrap product;
    set cursor_a = cursor_a +wrap 1_u64;
    set cursor_b = cursor_b +wrap 1_u64;
  }
  if total == 20_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
