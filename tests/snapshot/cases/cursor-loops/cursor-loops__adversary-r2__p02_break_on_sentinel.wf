command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: loop breaks on sentinel 255 found at index 2, index kept in bounds";
  let data = array_new<u8, 6>(0_u8);
  set data[0_u64] = 3_u8;
  set data[1_u64] = 5_u8;
  set data[2_u64] = 255_u8;
  set data[3_u64] = 9_u8;
  set data[4_u64] = 1_u8;
  set data[5_u64] = 2_u8;
  let cursor = 0_u64;
  loop (
    invariant bounded: ile(cursor, 6_u64)
  ) {
    let in_range = ilt(cursor, 6_u64);
    if in_range {
      let byte = data[cursor];
      let hit = ieq(byte, 255_u8);
      if hit {
        break;
      } else {
        invariant advancing: ilt(cursor, 6_u64);
        set cursor = cursor + 1_u64;
      }
    } else {
      break;
    }
  }
  let correct = ieq(cursor, 2_u64);
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
