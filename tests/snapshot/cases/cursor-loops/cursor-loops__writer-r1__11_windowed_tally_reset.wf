command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: a counted for loop maintains a windowed tally cursor that resets to zero inside the body whenever it reaches a fixed window size, while a separate running grand total keeps accumulating across every window.";
  let values = fixed_vector::<u32, 9>();
  for (
    at_values in 0_u64..9_u64,
    invariant grown_values: len_of(values) >= at_values,
    invariant spare_values: room_of(values) + at_values >= 9_u64,
    invariant flat_values: head_of(values) <= 0_u64
  ) {
    set values = place_back(vector: move values, value: 1_u32);
  }
  let window_tally = 0_u32;
  let grand_total = 0_u32;
  let completed_windows = 0_u32;
  for (i in 0_u64..9_u64) {
    let value = values[i];
    set window_tally = window_tally +wrap value;
    set grand_total = grand_total +wrap value;
    let window_full = window_tally == 3_u32;
    if window_full {
      set window_tally = 0_u32;
      set completed_windows = completed_windows +wrap 1_u32;
    }
  }
  if grand_total == 9_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if completed_windows == 3_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
