command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT: inner loop col range 0..5 with row*4+col overruns the 12-slot grid when row=2,col=4 (flat=12)";
  let grid = fixed_vector::<u64, 12>();
  for (
    at_grid in 0_u64..12_u64,
    invariant grown_grid: len_of(grid) >= at_grid,
    invariant spare_grid: room_of(grid) + at_grid >= 12_u64,
    invariant flat_grid: head_of(grid) <= 0_u64
  ) {
    set grid = place_back(vector: move grid, value: 0_u64);
  }
  for (row in 0_u64..3_u64) {
    for (col in 0_u64..5_u64) {
      let base = row * 4_u64;
      let flat = base + col;
      set grid[flat] = flat;
    }
  }
  let total = 0_u64;
  for (k in 0_u64..12_u64) {
    let value = grid[k];
    set total = total +wrap value;
  }
  let correct = total == 66_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
