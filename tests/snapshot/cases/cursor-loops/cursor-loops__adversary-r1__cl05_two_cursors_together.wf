command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: two cursors advance together across paired buffers inside one counted for, i rises and j = 4 - i falls in lockstep to reverse-copy 5 bytes";
  let src = array_new::<u8, 5>(0_u8);
  set src[0_u64] = 10_u8;
  set src[1_u64] = 11_u8;
  set src[2_u64] = 12_u8;
  set src[3_u64] = 13_u8;
  set src[4_u64] = 14_u8;
  let dst = array_new::<u8, 5>(0_u8);
  for (i in 0_u64..5_u64) {
    let j = 4_u64 - i;
    let value = src[i];
    set dst[j] = value;
  }
  if dst[0_u64] == 14_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if dst[4_u64] == 10_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
