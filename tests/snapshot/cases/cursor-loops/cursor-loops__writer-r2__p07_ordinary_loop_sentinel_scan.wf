fn text_length<const n: u64>(text: own FixedVector<u8, n>) -> length: own u64 reads(text) {
  doc "ACCEPT: an ordinary loop walks a byte buffer and breaks, unlabelled, on the first zero terminator it finds.";
  let capacity = len_of(text);
  let cursor = 0_u64;
  loop (
    invariant bounded: cursor <= capacity
  ) {
    let inside = cursor < capacity;
    if inside {
    } else {
      break;
    }
    let byte = text[cursor];
    let terminator = byte == 0_u8;
    if terminator {
      break;
    } else {
      set cursor = cursor + 1_u64;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  let text = fixed_vector::<u8, 6>();
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text[0_u64] = 104_u8;
  set text[1_u64] = 105_u8;
  set text[2_u64] = 0_u8;
  set text[3_u64] = 33_u8;
  set text[4_u64] = 33_u8;
  set text[5_u64] = 33_u8;
  let length = text_length::<6>(text: move text);
  let correct = length == 2_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
