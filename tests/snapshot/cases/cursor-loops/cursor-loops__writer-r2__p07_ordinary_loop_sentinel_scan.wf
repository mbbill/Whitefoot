fn text_length(text: own buffer<u8>) -> length: own u64 reads(text) {
  doc "ACCEPT: an ordinary loop walks a byte buffer and breaks, unlabelled, on the first zero terminator it finds.";
  let capacity = len(text);
  let cursor = 0_u64;
  loop (
    invariant bounded: ile(cursor, capacity)
  ) {
    let inside = ilt(cursor, capacity);
    if inside {
    } else {
      break;
    }
    let byte = text[cursor];
    let terminator = ieq(byte, 0_u8);
    if terminator {
      break;
    } else {
      set cursor = cursor + 1_u64;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let text = buffer_new(6_u64, 0_u8);
  set text[0_u64] = 104_u8;
  set text[1_u64] = 105_u8;
  set text[2_u64] = 0_u8;
  set text[3_u64] = 33_u8;
  set text[4_u64] = 33_u8;
  set text[5_u64] = 33_u8;
  let length = text_length(text: move text);
  let correct = ieq(length, 2_u64);
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
