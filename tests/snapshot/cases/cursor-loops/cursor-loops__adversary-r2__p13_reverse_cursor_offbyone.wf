command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT: back = 5 - i for i in 0..5 reaches back=5 when i=0, one past the 5-slot array (OOB)";
  let data = fixed_vector::<u64, 5>();
  set data = place_back(vector: move data, value: 0_u64);
  set data = place_back(vector: move data, value: 0_u64);
  set data = place_back(vector: move data, value: 0_u64);
  set data = place_back(vector: move data, value: 0_u64);
  set data = place_back(vector: move data, value: 0_u64);
  set data[0_u64] = 1_u64;
  set data[1_u64] = 2_u64;
  set data[2_u64] = 3_u64;
  set data[3_u64] = 4_u64;
  set data[4_u64] = 5_u64;
  let total = 0_u64;
  for (i in 0_u64..5_u64) {
    let back = 5_u64 - i;
    let value = data[back];
    set total = total +wrap value;
  }
  let correct = total == 15_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
