fn countdown_sum(start: own u64) -> total: own u64 pure {
  doc "ACCEPT: an ordinary loop counts a cursor down to zero, guarded by an ige check before every wrap decrement.";
  let cursor = start;
  let total = 0_u64;
  loop (
    invariant bounded: ile(cursor, start)
  ) {
    let more = igt(cursor, 0_u64);
    if more {
      set total = total +wrap cursor;
      set cursor = cursor - 1_u64;
    } else {
      break;
    }
  }
  return total;
}

command fn main() -> status: own ExitStatus pure {
  let total = countdown_sum(start: 5_u64);
  let correct = ieq(total, 15_u64);
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
