command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: ordinary loop scans a byte array for a sentinel value, summing the bytes before it with a guarded, wrapping cursor increment that never runs past the array length.";
  let data = array_new::<u8, 8>(0_u8);
  set data[0_u64] = 3_u8;
  set data[1_u64] = 5_u8;
  set data[2_u64] = 255_u8;
  set data[3_u64] = 9_u8;
  let cursor = 0_u64;
  let total = 0_u32;
  loop @scan {
    let in_bounds = cursor < 8_u64;
    if in_bounds {
    } else {
      break @scan;
    }
    let byte = data[cursor];
    let is_sentinel = byte == 255_u8;
    if is_sentinel {
      break @scan;
    }
    let widened = cvt::<u8, u32>(byte);
    set total = total +wrap widened;
    set cursor = cursor +wrap 1_u64;
  }
  if total == 8_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
