command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: an outer labelled loop over grid rows and an inner labelled loop over columns search a small grid for a target value, and the inner loop breaks the outer label directly once it is found.";
  let grid = array_new::<u32, 9>(0_u32);
  set grid[0_u64] = 1_u32;
  set grid[1_u64] = 2_u32;
  set grid[2_u64] = 3_u32;
  set grid[3_u64] = 4_u32;
  set grid[4_u64] = 5_u32;
  set grid[5_u64] = 6_u32;
  set grid[6_u64] = 7_u32;
  set grid[7_u64] = 8_u32;
  set grid[8_u64] = 9_u32;
  let row = 0_u64;
  let found_row = 0_u64;
  let found_col = 0_u64;
  let found = False();
  loop @rows {
    let row_in_bounds = row < 3_u64;
    if row_in_bounds {
    } else {
      break @rows;
    }
    let col = 0_u64;
    loop @cols {
      let col_in_bounds = col < 3_u64;
      if col_in_bounds {
      } else {
        break @cols;
      }
      let index = row * 3_u64;
      let flat = index + col;
      let flat_in_bounds = flat < 9_u64;
      if flat_in_bounds {
      } else {
        break @cols;
      }
      let cell = grid[flat];
      let hit = cell == 6_u32;
      if hit {
        set found_row = row;
        set found_col = col;
        set found = True();
        break @rows;
      }
      set col = col + 1_u64;
    }
    set row = row + 1_u64;
  }
  if found {
  } else {
    return exit_status(code: 1_u8);
  }
  let row_scaled = found_row * 3_u64;
  let flat_found = row_scaled + found_col;
  if flat_found == 5_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
