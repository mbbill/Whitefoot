command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: counted for loop sums 0..7 into total using wrap-add, range facts discharge automatically";
  let total = 0_u64;
  for (i in 0_u64..8_u64) {
    set total = total +wrap i;
  }
  if ieq(total, 28_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
