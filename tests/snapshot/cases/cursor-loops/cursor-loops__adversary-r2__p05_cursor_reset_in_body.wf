command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: cursor resets to 0 once when a marker is seen, then continues within bounds";
  let data = fixed_vector::<u8, 5>();
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data[0_u64] = 1_u8;
  set data[1_u64] = 9_u8;
  set data[2_u64] = 3_u8;
  set data[3_u64] = 4_u8;
  set data[4_u64] = 5_u8;
  let cursor = 0_u64;
  let resets_left = 1_u64;
  let steps = 0_u64;
  loop (
    invariant bounded: cursor <= 5_u64,
    invariant steps_bounded: steps <= 20_u64
  ) {
    let steps_ok = steps < 20_u64;
    let in_range = cursor < 5_u64;
    let go = band(steps_ok, in_range);
    if go {
      let byte = data[cursor];
      let is_marker = byte == 9_u8;
      let can_reset = resets_left > 0_u64;
      let should_reset = band(is_marker, can_reset);
      if should_reset {
        set resets_left = 0_u64;
        set cursor = 0_u64;
      } else {
        invariant advancing: cursor < 5_u64;
        set cursor = cursor + 1_u64;
      }
      invariant steps_adv: steps < 20_u64;
      set steps = steps + 1_u64;
    } else {
      break;
    }
  }
  let correct = steps == 6_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
