command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: an outer counted for resets an inner cursor each pass and a labelled break from the inner loop skips to the next outer row on sentinel";
  let grid = fixed_vector::<u8, 12>();
  for (
    at_grid in 0_u64..12_u64,
    invariant grown_grid: len_of(grid) >= at_grid,
    invariant spare_grid: room_of(grid) + at_grid >= 12_u64,
    invariant flat_grid: head_of(grid) <= 0_u64
  ) {
    set grid = place_back(vector: move grid, value: 1_u8);
  }
  set grid[9_u64] = 0_u8;
  let zero_row = 0_u64;
  let found_zero_row = False();
  for @rows (row in 0_u64..3_u64) {
    let col = 0_u64;
    loop @cols (
      invariant bounded: col <= 4_u64
    ) {
      let in_range = col < 4_u64;
      if in_range {
      } else {
        break @cols;
      }
      let scaled_row = row * 4_u64;
      let index = scaled_row + col;
      let value = grid[index];
      let hit = value == 0_u8;
      if hit {
        set zero_row = row;
        set found_zero_row = True();
        break @cols;
      }
      set col = col + 1_u64;
    }
  }
  if found_zero_row {
  } else {
    return exit_status(code: 1_u8);
  }
  if zero_row == 2_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
