command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: a counted for loop increments a match counter only when a per-element guard passes, keeping the header invariant that the counter never exceeds the loop index.";
  let values = array_new<u32, 6>(0_u32);
  set values[0_u64] = 4_u32;
  set values[1_u64] = 9_u32;
  set values[2_u64] = 2_u32;
  set values[3_u64] = 11_u32;
  set values[4_u64] = 7_u32;
  set values[5_u64] = 3_u32;
  let matched_count = 0_u64;
  for (
    i in 0_u64..6_u64,
    invariant bounded_count: ile(matched_count, i)
  ) {
    let candidate = values[i];
    let is_large = igt(candidate, 5_u32);
    if is_large {
      set matched_count = matched_count + 1_u64;
    }
  }
  if ieq(matched_count, 3_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
