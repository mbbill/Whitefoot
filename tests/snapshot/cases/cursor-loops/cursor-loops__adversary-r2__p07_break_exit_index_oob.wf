command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT: after the guard loop, cursor equals limit=5, so data[cursor] reads data[5] (OOB)";
  let data = fixed_vector::<u8, 5>();
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data = place_back(vector: move data, value: 0_u8);
  set data[0_u64] = 1_u8;
  set data[1_u64] = 2_u8;
  set data[2_u64] = 3_u8;
  set data[3_u64] = 4_u8;
  set data[4_u64] = 5_u8;
  let cursor = 0_u64;
  let limit = 5_u64;
  loop (
    invariant bounded: cursor <= limit
  ) {
    let more = cursor < limit;
    if more {
      invariant guarded: cursor < limit;
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  let past_end = data[cursor];
  let correct = past_end == 0_u8;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
