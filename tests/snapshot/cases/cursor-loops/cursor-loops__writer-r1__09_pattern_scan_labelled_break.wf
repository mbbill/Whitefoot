command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: an outer labelled loop advances a scan cursor over a text buffer and an inner labelled loop compares a fixed pattern at each position, the inner loop breaking the outer label as soon as a full match is confirmed.";
  let text = fixed_vector::<u8, 6>();
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text = place_back(vector: move text, value: 0_u8);
  set text[0_u64] = 97_u8;
  set text[1_u64] = 98_u8;
  set text[2_u64] = 99_u8;
  set text[3_u64] = 98_u8;
  set text[4_u64] = 99_u8;
  set text[5_u64] = 100_u8;
  let pattern = fixed_vector::<u8, 2>();
  set pattern = place_back(vector: move pattern, value: 0_u8);
  set pattern = place_back(vector: move pattern, value: 0_u8);
  set pattern[0_u64] = 99_u8;
  set pattern[1_u64] = 100_u8;
  let scan_cursor = 0_u64;
  let match_start = 0_u64;
  let matched = False();
  loop @scan {
    let scan_in_bounds = scan_cursor < 5_u64;
    if scan_in_bounds {
    } else {
      break @scan;
    }
    let match_cursor = 0_u64;
    let all_equal = True();
    loop @check {
      let check_in_bounds = match_cursor < 2_u64;
      if check_in_bounds {
      } else {
        break @check;
      }
      let text_index = scan_cursor + match_cursor;
      let text_index_in_bounds = text_index < 6_u64;
      if text_index_in_bounds {
      } else {
        break @check;
      }
      let text_byte = text[text_index];
      let pattern_byte = pattern[match_cursor];
      let equal = text_byte == pattern_byte;
      if equal {
      } else {
        set all_equal = False();
        break @check;
      }
      set match_cursor = match_cursor + 1_u64;
    }
    if all_equal {
      set match_start = scan_cursor;
      set matched = True();
      break @scan;
    }
    set scan_cursor = scan_cursor + 1_u64;
  }
  let start_correct = match_start == 4_u64;
  let outcome_ok = band(matched, start_correct);
  if outcome_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
