fn diff(lo: own u64, hi: own u64) -> result: own u64 pure {
  doc "The lo <= hi fact is killed by the subsequent write to hi, so the later subtraction is unguarded [OP-1].";
  if lo <= hi {
    set hi = hi - 1_u64;
    let d = hi - lo;
    return d;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: the `<=` guard is killed by the write to hi before the subtraction.";
  let v = diff(lo: 5_u64, hi: 5_u64);
  return exit_status(code: 0_u8);
}
