fn doubled_floor(count: own u64) -> result: own u64 pure contract {
  ensures result == count;
} {
  doc "Expected REJECT [ENT-x contract]: claims result equals count exactly, but result is (count/2)*2, the even floor of count. Violating value count=9_u64 gives result=8_u64, not 9_u64, so the ensures clause is false for this input.";
  let quotient = count / 2_u64;
  let doubled = quotient * 2_u64;
  return doubled;
}

fn doubled_floor_correct(count: own u64) -> result: own u64 pure contract {
  ensures result <= count;
} {
  doc "Contrast: the true, provable postcondition is only result <= count, matching the existing conformance case this program is derived from.";
  let quotient = count / 2_u64;
  let doubled = quotient * 2_u64;
  return doubled;
}

command fn main() -> status: own ExitStatus pure {
  let result = doubled_floor(count: 9_u64);
  let correct_result = doubled_floor_correct(count: 9_u64);
  return exit_status(code: 0_u8);
}
