fn probe(n: own u64, d: own u64) -> result: own u64 pure {
  doc "Unsigned remainder is bounded strictly by its positive divisor [OP-2, ENT-6].";
  if d > 0_u64 {
    let r = n % d;
    invariant bounded: r < d;
    return r;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: remainder bound r<d holds for 100,7.";
  let v = probe(n: 100_u64, d: 7_u64);
  if v == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
