fn safe_mod(n: own u64, d: own u64) -> result: own u64 pure {
  doc "Expected REJECT [OP-2]: the early-return guard checks d == 1_u64, not d == 0, so it fails to exclude the zero-divisor case. Violating value d=0_u64 reaches n % d with d undefined for remainder.";
  if d == 1_u64 {
    return 0_u64;
  }
  let r = n % d;
  return r;
}

fn safe_mod_correct(n: own u64, d: own u64) -> result: own u64 pure {
  doc "Contrast: the correctly-worded guard checks d == 0_u64, the actual excluded case, unlike safe_mod above which checks the wrong constant.";
  if d == 0_u64 {
    return 0_u64;
  }
  let r = n % d;
  return r;
}

command fn main() -> status: own ExitStatus pure {
  let result = safe_mod(n: 10_u64, d: 0_u64);
  let correct_result = safe_mod_correct(n: 10_u64, d: 0_u64);
  return exit_status(code: 0_u8);
}
