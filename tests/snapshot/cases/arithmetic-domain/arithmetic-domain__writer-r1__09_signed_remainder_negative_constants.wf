command fn main() -> status: own ExitStatus pure {
  doc "ACCEPT: constant nonzero divisors put signed `%` in the total divisor class regardless of operand sign [OP-2].";
  let left = -40_i32 % 41_i32;
  let right = 2_i32 % 3_i32;
  let sum = left + right;
  if sum == -38_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  let both_negative = -17_i32 % -5_i32;
  if both_negative == -2_i32 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
