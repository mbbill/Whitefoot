fn safe_modulo(n: own u64, d: own u64) -> result: own u64 pure {
  doc "ACCEPT: `%` shares the divisor-class obligation with `/`, so the same igt guard discharges it [OP-2, ENT-6].";
  if igt(d, 0_u64) {
    let r = n % d;
    return r;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  let r = safe_modulo(n: 17_u64, d: 5_u64);
  if ieq(r, 2_u64) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
