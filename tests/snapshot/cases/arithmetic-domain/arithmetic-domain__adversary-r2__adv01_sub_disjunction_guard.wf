fn distance(upper: own u64, lower: own u64) -> result: own u64 pure {
  doc "Expected REJECT [OP-2]: guard is a tautological disjunction lower <= upper or lower > upper; inside the branch only one disjunct actually holds. Violating values lower=10_u64, upper=3_u64 take the `>` disjunct while `<=` is false, so upper - lower underflows u64.";
  let ordered = lower <= upper;
  let flipped = lower > upper;
  let either = bor(ordered, flipped);
  if either {
    let difference = upper - lower;
    return difference;
  } else {
    return 0_u64;
  }
}

command fn main() -> status: own ExitStatus pure {
  let result = distance(upper: 3_u64, lower: 10_u64);
  return exit_status(code: 0_u8);
}
