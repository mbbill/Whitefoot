fn checked_scale(count: own u32, factor: own u32) -> result: own u32 pure {
  doc "ACCEPT: *checked returns a Result, and matching it total-izes the write side without any static overflow proof.";
  let outcome = count *checked factor;
  let scaled = match outcome {
    Ok(value: product) => {
      give product;
    }
    Err(error: overflow) => {
      give 0_u32;
    }
  }
  return scaled;
}

command fn main() -> status: own ExitStatus pure {
  let scaled = checked_scale(count: 6_u32, factor: 7_u32);
  if scaled == 42_u32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
