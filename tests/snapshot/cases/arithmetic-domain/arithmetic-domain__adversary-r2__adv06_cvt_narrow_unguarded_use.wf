fn narrow_direct(x: own i32) -> result: own i8 pure {
  doc "Expected REJECT [OP-6, TYPE-4]: cvt<i32,i8> is not total (i32 -> i8 loses range), so it must return Result<i8, NarrowError> and be matched, not used directly as an i8. Violating value x=200_i32 is not representable in i8.";
  let narrowed = cvt<i32, i8>(x);
  return move narrowed;
}

fn narrow_matched(x: own i32) -> result: own i8 pure {
  doc "Contrast: the correct sibling matches the Result and picks a total fallback, unlike narrow_direct which tries to use the Result value bare as i8.";
  match cvt<i32, i8>(x) {
    Ok(value: v) => {
      return v;
    }
    Err(error: e) => {
      return 0_i8;
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  let result = narrow_direct(x: 200_i32);
  let ok_result = narrow_matched(x: 200_i32);
  return exit_status(code: 0_u8);
}
