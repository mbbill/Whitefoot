fn probe(n: own u64, d: own u64) -> result: own u64 pure {
  doc "Division and remainder satisfy the standard image relation n = (n / d) * d + (n % d); verified at runtime here [OP-2, ENT-6].";
  if igt(d, 0_u64) {
    let q = n / d;
    let r = n % d;
    return r;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: division image n=(n/d)*d+(n%d) holds for 17,5.";
  let v = probe(n: 17_u64, d: 5_u64);
  if ieq(v, 2_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
