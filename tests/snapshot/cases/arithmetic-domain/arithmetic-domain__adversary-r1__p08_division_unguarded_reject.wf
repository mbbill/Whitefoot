fn divide(n: own u64, d: own u64) -> result: own u64 pure {
  doc "Unguarded exact division must be rejected at compile time [OP-2, ENT-6].";
  let q = n / d;
  return q;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: exact division with no proof d!=0.";
  let v = divide(n: 10_u64, d: 0_u64);
  return exit_status(code: 0_u8);
}
