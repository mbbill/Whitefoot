fn widen_add(a: own i8, b: own i8) -> result: own i32 pure {
  doc "cvt widening followed by exact add stays in the i32 domain for any i8 pair [OP-6, OP-1].";
  let wa = cvt::<i8, i32>(a);
  let wb = cvt::<i8, i32>(b);
  let sum = wa + wb;
  return sum;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: cvt i8->i32 widen then add cannot overflow i32.";
  let v = widen_add(a: -128_i8, b: -128_i8);
  if v == -256_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
