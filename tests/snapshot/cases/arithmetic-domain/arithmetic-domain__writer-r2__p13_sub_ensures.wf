fn distance_to_end(index: own u64, length: own u64) -> result: own u64 pure contract {
  requires ile(index, length);
  ensures ile(result, length);
} {
  doc "expect ACCEPT: a bounded-index subtraction publishes its result bound through an ensures clause, discharging [OP-2] for the exact `-` and letting callers reuse the fact without restating it [FN-9].";
  let remaining = length - index;
  return remaining;
}

command fn main() -> status: own ExitStatus pure {
  let result = distance_to_end(index: 3_u64, length: 10_u64);
  if ieq(result, 7_u64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
