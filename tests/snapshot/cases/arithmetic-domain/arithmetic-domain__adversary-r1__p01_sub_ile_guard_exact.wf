fn diff(lo: own u64, hi: own u64) -> result: own u64 pure {
  doc "Guarded subtraction after a `<=` proof is exact [OP-1].";
  if lo <= hi {
    let d = hi - lo;
    return d;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT ACCEPT: sub after a `<=` guard is exact and safe (hi=lo=5 -> 0).";
  let v = diff(lo: 5_u64, hi: 5_u64);
  if v == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
