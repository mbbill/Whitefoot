fn distance(high: own u64, low: own u64) -> result: own u64 pure {
  doc "ACCEPT: a `>` branch bounds low below high, so exact unsigned `-` is total on the true edge [OP-2].";
  if high > low {
    let gap = high - low;
    return gap;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  let gap = distance(high: 10_u64, low: 4_u64);
  if gap == 6_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
