fn probe(i: own u64, count: own u64) -> result: own u64 pure {
  doc "A strict-less-than guard does not license subtracting the smaller operand from the larger one in reverse order [OP-1].";
  if ilt(i, count) {
    let bad = i - count;
    return bad;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT: ilt(i,count) does not license i-count subtraction.";
  let v = probe(i: 0_u64, count: 5_u64);
  return exit_status(code: 0_u8);
}
