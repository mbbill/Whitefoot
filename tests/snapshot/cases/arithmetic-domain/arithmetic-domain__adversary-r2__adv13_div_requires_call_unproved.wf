fn divide(n: own u64, d: own u64) -> result: own u64 pure contract {
  requires d != 0_u64;
} {
  let q = n / d;
  return q;
}

fn caller(d: own u64) -> result: own u64 pure {
  doc "Expected REJECT [contract/OP-2]: divide requires d != 0_u64, but caller passes its own parameter d straight through with no proof it is nonzero. Violating value d=0_u64 would enter divide with a zero divisor.";
  let v = divide(n: 84_u64, d: d);
  return v;
}

command fn main() -> status: own ExitStatus pure {
  let result = caller(d: 0_u64);
  return exit_status(code: 0_u8);
}
