fn gap(x: own i32, y: own i32) -> result: own i32 pure contract {
  requires ige(x, 0_i32);
  requires ige(y, 0_i32);
  requires ige(x, y);
} {
  doc "Expected ACCEPT: both operands are proven non-negative and x >= y, so x - y is bounded in [0, x] which stays within i32 range; unlike adv02, the guard here also rules out the negative-y case that caused overflow there.";
  let difference = x - y;
  return difference;
}

command fn main() -> status: own ExitStatus pure {
  let result = gap(x: 100_i32, y: 40_i32);
  if ieq(result, 60_i32) {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
