command fn main() -> status: own ExitStatus pure {
  doc "expect: ACCEPT - a<b<c derives a<c whose support is {a,c} only; mutating the middle term b afterward must not kill a<c, so buf[a] still discharges";
  let buf = buffer_new(10_u64, 4_u8);
  let a = 2_u64;
  let b = 5_u64;
  let c = len_of(buf);
  let a_lt_b = a < b;
  if a_lt_b {
  } else {
    return exit_status(code: 1_u8);
  }
  let b_lt_c = b < c;
  if b_lt_c {
  } else {
    return exit_status(code: 1_u8);
  }
  set b = 999_u64;
  let value = buf[a];
  if value == 4_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
