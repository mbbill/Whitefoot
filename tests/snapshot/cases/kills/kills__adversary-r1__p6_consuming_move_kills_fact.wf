fn sink(b: own buffer<u8>) -> result: own unit reads(b) {
  let first = b[0_u64];
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect: REJECT (OWN move rule, ENT-5(c) consuming use) - buf is moved into sink, then buf is indexed again after its root is consumed";
  let buf = buffer_new(4_u64, 5_u8);
  let limit = len_of(buf);
  let ok = 0_u64 < limit;
  if ok {
  } else {
    return exit_status(code: 1_u8);
  }
  sink(b: move buf);
  let value = buf[0_u64];
  if value == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
