fn read_after_kill<const n: u64>(buf: own FixedVector<u8, n>, i: own u64) -> value: own u8 reads(buf) contract {
  define spare = len_of(buf);
  requires i < spare;
} {
  doc "expect REJECT [OP-4]: set i = 9_u64 kills the i < len_of(buf) fact, so buf[i] is unproven; if wrongly accepted, i=9 reads past a 5-element buffer (OOB read).";
  set i = 9_u64;
  return buf[i];
}

command fn main() -> status: own ExitStatus pure {
  let buf = fixed_vector::<u8, 5>();
  set buf = place_back(vector: move buf, value: 1_u8);
  set buf = place_back(vector: move buf, value: 1_u8);
  set buf = place_back(vector: move buf, value: 1_u8);
  set buf = place_back(vector: move buf, value: 1_u8);
  set buf = place_back(vector: move buf, value: 1_u8);
  let value = read_after_kill::<5>(buf: move buf, i: 0_u64);
  return exit_status(code: value);
}
