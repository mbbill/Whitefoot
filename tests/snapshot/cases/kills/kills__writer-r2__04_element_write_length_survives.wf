command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- P16: an element write never kills the buffer's length fact, so `spare` stays live across every set into the buffer.";
  let line = buffer_new(6_u64, 0_u8);
  let spare = len_of(line);
  let fits_first = 0_u64 < spare;
  if fits_first {
  } else {
    return exit_status(code: 1_u8);
  }
  set line[0_u64] = 10_u8;
  let fits_second = 1_u64 < spare;
  if fits_second {
  } else {
    return exit_status(code: 1_u8);
  }
  set line[1_u64] = 20_u8;
  let fits_third = 2_u64 < spare;
  if fits_third {
  } else {
    return exit_status(code: 1_u8);
  }
  set line[2_u64] = 30_u8;
  let end = 3_u64;
  let fits = end <= spare;
  if fits {
  } else {
    return exit_status(code: 1_u8);
  }
  let a = line[0_u64];
  let b = line[1_u64];
  let c = line[2_u64];
  let a_wide = cvt::<u8, u32>(a);
  let b_wide = cvt::<u8, u32>(b);
  let c_wide = cvt::<u8, u32>(c);
  let ab = a_wide + b_wide;
  let total = ab + c_wide;
  let correct = total == 60_u32;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
