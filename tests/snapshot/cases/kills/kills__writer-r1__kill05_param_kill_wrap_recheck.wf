fn wrap_lookup(table: own FixedVector<u16, 10>, pos: own u64) -> result: own u16 reads(table) contract {
  requires len_of(table) >= 10_u64;
  requires pos < 10_u64;
} {
  doc "expect ACCEPT: set pos = pos +wrap 1 kills the requires-proved bound, so a fresh branch must re-establish the wrapped index's own bound before the second index.";
  let first = table[pos];
  let advanced = pos +wrap 1_u64;
  set pos = advanced;
  let in_range = pos < 10_u64;
  let second = if in_range {
    give table[pos];
  } else {
    give 0_u16;
  }
  return first +wrap second;
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u16, 10>();
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  set table = place_back(vector: move table, value: 3_u16);
  let value = wrap_lookup(table: move table, pos: 9_u64);
  if value == 3_u16 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
