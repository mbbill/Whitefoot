fn loopy2(limit: own u8, bump: own u8) -> result: own u8 pure contract {
  requires ile(limit, 5_u8);
} {
  let cursor = 0_u8;
  let lim = limit;
  loop (
    invariant bounded: ile(cursor, lim)
  ) {
    let remaining = ilt(cursor, lim);
    if remaining {
      invariant guarded: ilt(cursor, lim);
      set cursor = cursor +wrap 1_u8;
      set lim = bump;
    } else {
      break;
    }
  }
  let z = lim + 250_u8;
  return z;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT (invariant not maintained): loop body writes lim (named by invariant bounded) to bump each iteration; limit=5,bump=255 -> post-loop lim+250_u8 overflows u8";
  let r = loopy2(limit: 5_u8, bump: 255_u8);
  return exit_status(code: 0_u8);
}
