struct DelayLine {
  samples: FixedVector<u32, 4>;
}

struct Filter {
  delay: DelayLine;
  gain: u32;
}

command fn main() -> status: own ExitStatus pure {
  doc "SNAPSHOT REJECT [OP-2]: the finder expected ACCEPT, and the re-read chain after the middle-term replace is now accepted, but the later checked product after * filter.gain still has no proved domain.";
  let first_samples = fixed_vector::<u32, 4>();
  set first_samples = place_back(vector: move first_samples, value: 1_u32);
  set first_samples = place_back(vector: move first_samples, value: 1_u32);
  set first_samples = place_back(vector: move first_samples, value: 1_u32);
  set first_samples = place_back(vector: move first_samples, value: 1_u32);
  let first_delay = DelayLine(samples: move first_samples);
  let filter = Filter(delay: move first_delay, gain: 2_u32);
  let before_held = len_of(filter.delay.samples);
  let before_has_first = before_held > 0_u64;
  if before_has_first {
  } else {
    return exit_status(code: 1_u8);
  }
  let before = filter.delay.samples[0_u64];
  let before_ok = before == 1_u32;
  if before_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let second_samples = fixed_vector::<u32, 4>();
  set second_samples = place_back(vector: move second_samples, value: 9_u32);
  set second_samples = place_back(vector: move second_samples, value: 9_u32);
  set second_samples = place_back(vector: move second_samples, value: 9_u32);
  set second_samples = place_back(vector: move second_samples, value: 9_u32);
  let second_delay = DelayLine(samples: move second_samples);
  let old = replace filter.delay = move second_delay;
  let after_held = len_of(filter.delay.samples);
  let after_has_first = after_held > 0_u64;
  if after_has_first {
  } else {
    return exit_status(code: 1_u8);
  }
  let after = filter.delay.samples[0_u64];
  let after_ok = after == 9_u32;
  if after_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let scaled = after * filter.gain;
  let correct = scaled == 18_u32;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
