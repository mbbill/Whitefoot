fn chained_index(table: own buffer<u8>, a: own u64, b: own u64, c: own u64) -> value: own u8 reads(table) contract {
  define spare = len(table);
  requires a <= b;
  requires b <= c;
  requires c <= spare;
} {
  doc "expect REJECT [OP-4]: set b = 900_u64 kills the middle term of the a<=b<=c chain, so table[a] relying on a <= c via b is unproven; a wrong accept lets a=200 index a 100-slot table via a stale transitive fact.";
  set b = 900_u64;
  return table[a];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let table = buffer_new(100_u64, 1_u8);
  let value = chained_index(table: move table, a: 50_u64, b: 60_u64, c: 100_u64);
  return exit_status(code: value);
}
