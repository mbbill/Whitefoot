fn filled<T: copy, const n: u64>(value: own T) -> result: own FixedVector<T, n> pure contract {
  ensures len_of(result) >= n;
  ensures room_of(result) <= 0_u64;
  ensures head_of(result) <= 0_u64;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = fixed_vector::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: len_of(built) >= at,
    invariant spare: room_of(built) + at >= n,
    invariant flat: head_of(built) <= 0_u64
  ) {
    set built = place_back(vector: move built, value: value);
  }
  return move built;
}

fn chained_index<const n: u64>(table: own FixedVector<u8, n>, a: own u64, b: own u64, c: own u64) -> value: own u8 reads(table) contract {
  define spare = len_of(table);
  requires a <= b;
  requires b <= c;
  requires c <= spare;
} {
  doc "expect REJECT [OP-4]: set b = 900_u64 kills the middle term of the a<=b<=c chain, so table[a] relying on a <= c via b is unproven; a wrong accept lets a=200 index a 100-slot table via a stale transitive fact.";
  set b = 900_u64;
  return table[a];
}

command fn main() -> status: own ExitStatus pure {
  let table = filled::<u8, 100>(value: 1_u8);
  let value = chained_index::<100>(table: move table, a: 50_u64, b: 60_u64, c: 100_u64);
  return exit_status(code: value);
}
