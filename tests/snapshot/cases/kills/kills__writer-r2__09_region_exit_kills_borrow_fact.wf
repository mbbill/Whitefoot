fn borrowed_room(b: own Slice<u8>) -> result: own u64 reads(b) {
  return len_of(b);
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- a fact carried by a region-local borrow holder dies leaving the region [ENT-5](d); a fresh owned len_of() outside reestablishes it.";
  let data = fixed_vector::<u8, 4>();
  set data = place_back(vector: move data, value: 6_u8);
  set data = place_back(vector: move data, value: 6_u8);
  set data = place_back(vector: move data, value: 6_u8);
  set data = place_back(vector: move data, value: 6_u8);
  region {
    let data_view = slice_of(&data);
    let inner_room = borrowed_room(b: data_view);
    let inner_ok = 0_u64 < inner_room;
    if inner_ok {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  let spare = len_of(data);
  let outer_ok = 0_u64 < spare;
  if outer_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let sample = data[0_u64];
  let correct = sample == 6_u8;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
