fn f(x: own u8, w: own u8) -> result: own u8 pure contract {
  requires x <= 5_u8;
} {
  set x = w;
  let ok = x <= 5_u8;
  if ok {
    let z = x + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: set x=w but w is re-bounded by an if-guard before the add, so x<=5 is re-established before use";
  let r = f(x: 0_u8, w: 3_u8);
  return exit_status(code: 0_u8);
}
