struct Cursor {
  idx: u64;
  limit: u64;
  tag: u8;
}

fn read_after_tag_write<const n: u64>(table: own FixedVector<u8, n>, cursor: own Cursor) -> value: own u8 reads(table, cursor.idx), writes(cursor.tag) contract {
  define spare = len_of(table);
  requires cursor.idx < cursor.limit;
  requires cursor.limit <= spare;
} {
  doc "expect ACCEPT: writing cursor.tag does not touch cursor.idx or cursor.limit, so cursor.idx < cursor.limit survives the write; sanity check against over-killing unrelated fields.";
  set cursor.tag = 9_u8;
  return table[cursor.idx];
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 4>();
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  let start = Cursor(idx: 2_u64, limit: 4_u64, tag: 0_u8);
  let ok = start.idx < start.limit;
  if ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let spare = len_of(table);
  let fits = start.limit <= spare;
  if fits {
  } else {
    return exit_status(code: 1_u8);
  }
  let value = read_after_tag_write::<4>(table: move table, cursor: move start);
  return exit_status(code: value);
}
