fn wrap_then_index<const n: u64>(table: own FixedVector<u8, n>, i: own u64) -> value: own u8 reads(table) contract {
  define spare = len_of(table);
  requires i < spare;
} {
  doc "expect REJECT [OP-4]: set i = i +wrap 250_u64 kills the requires(i < len_of(table)) fact via unchecked wraparound before the index; a wrong accept lets i wrap to a huge value and read far past the 6-slot table.";
  set i = i +wrap 250_u64;
  return table[i];
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 6>();
  set table = place_back(vector: move table, value: 5_u8);
  set table = place_back(vector: move table, value: 5_u8);
  set table = place_back(vector: move table, value: 5_u8);
  set table = place_back(vector: move table, value: 5_u8);
  set table = place_back(vector: move table, value: 5_u8);
  set table = place_back(vector: move table, value: 5_u8);
  let value = wrap_then_index::<6>(table: move table, i: 2_u64);
  return exit_status(code: value);
}
