struct Cursor {
  pos: u64;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expect: REJECT (ENT-5) - obj.cursor is bound-checked, then set obj.cursor=99 (kill), reused for subscript unproven; cursor=99,cap=4 -> OOB";
  let buf = buffer_new(4_u64, 3_u8);
  let obj = Cursor(pos: 0_u64);
  let cap = len(buf);
  let ok = ilt(obj.pos, cap);
  if ok {
  } else {
    return exit_status(code: 1_u8);
  }
  set obj.pos = 99_u64;
  let value = buf[obj.pos];
  if ieq(value, 3_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
