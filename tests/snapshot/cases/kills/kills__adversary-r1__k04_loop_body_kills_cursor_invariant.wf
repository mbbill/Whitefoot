fn count_to(limit: own u64) -> reached: own u64 pure {
  doc "expect REJECT [INV-1]: the backedge sets cursor to a value that does not preserve bounded, so the invariant is unproved on re-entry; a wrong accept would let cursor race past limit.";
  let cursor = 0_u64;
  loop (
    invariant bounded: cursor <= limit
  ) {
    let remaining = cursor < limit;
    if remaining {
      set cursor = cursor + 3_u64;
    } else {
      break;
    }
  }
  return cursor;
}

command fn main() -> status: own ExitStatus pure {
  let reached = count_to(limit: 4_u64);
  return exit_status(code: 0_u8);
}
