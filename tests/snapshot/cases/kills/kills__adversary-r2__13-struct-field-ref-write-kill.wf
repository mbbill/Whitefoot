struct Cell {
  v: u8;
}

fn h3(b: &uniq Cell, w: own u8) -> result: own u8 reads(b.v), writes(b.v) {
  let old = deref(b).v;
  let bounded = old <= 5_u8;
  if bounded {
    set deref(b).v = w;
    let cur = deref(b).v;
    let z = cur + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT (OP-2): writing through &uniq deref(b).v=w kills old<=5; old=0(ok), w=255 -> cur+250_u8 overflows u8";
  let cell = Cell(v: 0_u8);
  region {
    let z = h3(b: &uniq cell, w: 255_u8);
  }
  return exit_status(code: 0_u8);
}
