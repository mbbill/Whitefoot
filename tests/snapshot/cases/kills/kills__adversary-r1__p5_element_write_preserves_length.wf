command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expect: ACCEPT - an element write never kills a length fact [ENT-5]; index 3 stays proven by len(buf)=4 after writing index 0";
  let buf = buffer_new(4_u64, 0_u8);
  let cap = len(buf);
  let last = cap -wrap 1_u64;
  let ok = ilt(last, cap);
  if ok {
  } else {
    return exit_status(code: 1_u8);
  }
  set buf[0_u64] = 9_u8;
  let value = buf[last];
  if ieq(value, 0_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
