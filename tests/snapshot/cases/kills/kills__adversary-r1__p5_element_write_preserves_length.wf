command fn main() -> status: own ExitStatus pure {
  doc "expect: ACCEPT - an element write never kills a length fact [ENT-5]; index 3 stays proven by len_of(buf)=4 after writing index 0";
  let buf = fixed_vector::<u8, 4>();
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf = place_back(vector: move buf, value: 0_u8);
  set buf = place_back(vector: move buf, value: 0_u8);
  let limit = len_of(buf);
  let last = limit -wrap 1_u64;
  let ok = last < limit;
  if ok {
  } else {
    return exit_status(code: 1_u8);
  }
  set buf[0_u64] = 9_u8;
  let value = buf[last];
  if value == 0_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
