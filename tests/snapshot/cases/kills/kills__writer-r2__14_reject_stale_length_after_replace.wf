command fn main() -> status: own ExitStatus pure {
  doc "expected: REJECT [OP-4] -- the whole-place replace of `line` kills the old `spare` length fact [ENT-5](a); the later index reuses that stale fact instead of a fresh len_of().";
  let line = fixed_vector::<u8, 10>();
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  set line = place_back(vector: move line, value: 0_u8);
  let spare = len_of(line);
  let shrunk = fixed_vector::<u8, 10>();
  set shrunk = place_back(vector: move shrunk, value: 3_u8);
  set shrunk = place_back(vector: move shrunk, value: 3_u8);
  let old = replace line = move shrunk;
  let end = 9_u64;
  let fits = end <= spare;
  if fits {
  } else {
    return exit_status(code: 1_u8);
  }
  let sample = line[end];
  let correct = sample == 3_u8;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
