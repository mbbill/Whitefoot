fn f(n: own u8, w: own u8) -> result: own u8 pure contract {
  requires n <= 5_u8;
} {
  let m = n;
  set m = w;
  let ok = m <= 5_u8;
  if ok {
    let z = m + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: set m=w kills the copied bound, but code reproves m <= 5_u8 via an if-guard before the add";
  let r = f(n: 0_u8, w: 3_u8);
  return exit_status(code: 0_u8);
}
