fn loopy(limit: own u8, w: own u8) -> result: own u8 pure contract {
  requires ile(limit, 5_u8);
} {
  let cursor = 0_u8;
  loop (
    invariant bounded: ile(cursor, limit)
  ) {
    let remaining = ilt(cursor, limit);
    if remaining {
      invariant guarded: ilt(cursor, limit);
      set cursor = cursor +wrap 1_u8;
    } else {
      break;
    }
  }
  set cursor = w;
  let z = cursor + 250_u8;
  return z;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT (OP-2): post-loop cursor<=limit<=5 is killed by set cursor=w; limit=5,w=255 -> cursor+250_u8 overflows u8";
  let r = loopy(limit: 5_u8, w: 255_u8);
  return exit_status(code: 0_u8);
}
