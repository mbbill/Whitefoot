struct Counter {
  value: u32;
  limit: u32;
}

fn bump(c: &uniq Counter) -> result: own Bool reads(c.value, c.limit), writes(c.value) {
  doc "expect ACCEPT: writing deref(c).value kills the old value fact, so the room check after the write reads the freshly written field, not a stale image.";
  let room = deref(c).value < deref(c).limit;
  if room {
  } else {
    return False();
  }
  let next = deref(c).value +wrap 1_u32;
  set deref(c).value = next;
  let still_room = deref(c).value < deref(c).limit;
  return still_room;
}

command fn main() -> status: own ExitStatus pure {
  let final_counter = Counter(value: 0_u32, limit: 3_u32);
  let has_room = True();
  region {
    set has_room = bump(c: &uniq final_counter);
  }
  region {
    set has_room = bump(c: &uniq final_counter);
  }
  region {
    set has_room = bump(c: &uniq final_counter);
  }
  if final_counter.value == 3_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
