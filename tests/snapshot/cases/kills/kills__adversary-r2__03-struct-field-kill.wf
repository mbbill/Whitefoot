struct Box {
  v: u8;
}

fn h(b: own Box, w: own u8) -> result: own u8 reads(b.v), writes(b.v) contract {
  requires b.v <= 5_u8;
} {
  set b.v = w;
  let z = b.v + 250_u8;
  return z;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT (OP-2 overflow obligation): set b.v=w kills requires b.v <= 5_u8; b.v=0,w=255 -> b.v+250_u8 = 255+250 overflows u8";
  let cell = Box(v: 0_u8);
  let r = h(b: move cell, w: 255_u8);
  return exit_status(code: 0_u8);
}
