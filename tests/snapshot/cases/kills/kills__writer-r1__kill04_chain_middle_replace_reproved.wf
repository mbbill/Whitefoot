fn blend(first: own u8, first_limit: own u8, second: own u8, second_limit: own u8, third: own u8, third_limit: own u8, replacement: own u8, replacement_limit: own u8) -> result: own u8 pure contract {
  requires ile(first, first_limit);
  requires ile(second, second_limit);
  requires ile(third, third_limit);
  requires ile(replacement, replacement_limit);
  requires ile(first_limit, 80_u8);
  requires ile(second_limit, 80_u8);
  requires ile(third_limit, 90_u8);
  requires ile(replacement_limit, 80_u8);
} {
  doc "expect ACCEPT: set first = replacement kills the old first/first_limit pairing, so total_bound is re-derived from replacement_limit rather than the dead first_limit fact.";
  invariant original_bound: ile(first + second + third, first_limit + second_limit + third_limit) {
    use ile(first, first_limit);
    use ile(second, second_limit);
    use ile(third, third_limit);
  }
  set first = replacement;
  invariant updated_bound: ile(first + second + third, replacement_limit + second_limit + third_limit) {
    use ile(first, replacement_limit);
    use ile(second, second_limit);
    use ile(third, third_limit);
  }
  invariant limit_sum: ile(replacement_limit + second_limit + third_limit, 250_u8);
  let result = first + second;
  return result;
}

command fn main() -> status: own ExitStatus pure {
  let picked = blend(first: 10_u8, first_limit: 40_u8, second: 5_u8, second_limit: 40_u8, third: 3_u8, third_limit: 50_u8, replacement: 20_u8, replacement_limit: 40_u8);
  if ieq(picked, 25_u8) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
