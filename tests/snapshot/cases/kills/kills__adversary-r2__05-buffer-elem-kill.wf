fn h2(buf: &uniq buffer<u8>, i: own u64, w: own u8) -> result: own u8 reads(buf), writes(buf) {
  let limit = len_of(deref(buf));
  let in_range = i < limit;
  if in_range {
    let old = deref(buf)[i];
    let bounded = old <= 5_u8;
    if bounded {
      set deref(buf)[i] = w;
      let cur = deref(buf)[i];
      let z = cur + 250_u8;
      return z;
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT (OP-2): after old=buf[0]<=5 is proved, set buf[0]=w kills it; re-read cur=buf[0] then cur+250_u8 overflows for w=255";
  let raw = buffer_new(1_u64, 0_u8);
  region {
    let z = h2(buf: &uniq raw, i: 0_u64, w: 255_u8);
  }
  return exit_status(code: 0_u8);
}
