fn h2(buf: &uniq MutSlice<u8>, i: own u64, w: own u8) -> result: own u8 reads(buf), writes(buf) {
  let limit = len_of(deref(buf));
  let in_range = i < limit;
  if in_range {
    let old = deref(buf)[i];
    let bounded = old <= 5_u8;
    if bounded {
      set deref(buf)[i] = w;
      let cur = deref(buf)[i];
      let z = cur + 250_u8;
      return z;
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT (OP-2): after old=buf[0]<=5 is proved, set buf[0]=w kills it; re-read cur=buf[0] then cur+250_u8 overflows for w=255";
  region 'w {
    let workspace = arena_frame::<1, 1, 'w>();
    region {
      let raw = arena_vector_proved::<u8>(store: &uniq workspace, count: 1_u64);
      for @fill_raw (
        at in 0_u64..1_u64,
        invariant grown_raw: len_of(raw) >= at,
        invariant spare_raw: room_of(raw) + at >= 1_u64,
        invariant flat_raw: head_of(raw) <= 0_u64
      ) {
        set raw = place_back(vector: move raw, value: 0_u8);
      }
      region {
        let view_raw = mut_slice_of(&uniq raw);
        region {
          let z = h2(buf: &uniq view_raw, i: 0_u64, w: 255_u8);
        }
      }
      return exit_status(code: 0_u8);
    }
  }
}
