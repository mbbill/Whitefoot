fn pick(b: own buffer<u8>, idx: own u64, stray: own u64) -> result: own u8 reads(b) {
  let cap = len(b);
  let ok = idx < cap;
  if ok {
  } else {
    return 0_u8;
  }
  set idx = stray;
  return b[idx];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expect: REJECT (ENT-5) - idx param is bound-checked at entry, then set idx=stray (kill), reused for subscript unproven; stray=50,len=6 -> OOB";
  let buf = buffer_new(6_u64, 8_u8);
  let value = pick(b: move buf, idx: 2_u64, stray: 50_u64);
  if value == 8_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
