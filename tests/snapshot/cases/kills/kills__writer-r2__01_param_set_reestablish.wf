fn clamp_and_read(b: own buffer<u8>, idx: own u64, stride: own u64) -> result: own u8 reads(b) {
  let spare = len(b);
  let in_range = idx < spare;
  if in_range {
  } else {
    return 0_u8;
  }
  let cursor = idx;
  set cursor = idx +wrap stride;
  let still_in_range = cursor < spare;
  if still_in_range {
  } else {
    return 0_u8;
  }
  return b[cursor];
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "expected: ACCEPT -- set on a param kills its old bound [ENT-5](a); a fresh branch reestablishes it before the subscript.";
  let data = buffer_new(8_u64, 5_u8);
  let value = clamp_and_read(b: move data, idx: 2_u64, stride: 1_u64);
  let correct = value == 5_u8;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
