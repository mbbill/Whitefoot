fn clamp_and_read<const n: u64>(b: own FixedVector<u8, n>, idx: own u64, stride: own u64) -> result: own u8 reads(b) {
  let spare = len_of(b);
  let in_range = idx < spare;
  if in_range {
  } else {
    return 0_u8;
  }
  let cursor = idx;
  set cursor = idx +wrap stride;
  let still_in_range = cursor < spare;
  if still_in_range {
  } else {
    return 0_u8;
  }
  return b[cursor];
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- set on a param kills its old bound [ENT-5](a); a fresh branch reestablishes it before the subscript.";
  let data = fixed_vector::<u8, 8>();
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  let value = clamp_and_read::<8>(b: move data, idx: 2_u64, stride: 1_u64);
  let correct = value == 5_u8;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
