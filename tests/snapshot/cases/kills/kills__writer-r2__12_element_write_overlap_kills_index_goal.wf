command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- a write to buf[at] kills the earlier read fact about that same index [ENT-5]; the program rereads it instead of reusing the stale value.";
  let buf = fixed_vector::<u8, 3>();
  set buf = place_back(vector: move buf, value: 1_u8);
  set buf = place_back(vector: move buf, value: 1_u8);
  set buf = place_back(vector: move buf, value: 1_u8);
  let at = 1_u64;
  let spare = len_of(buf);
  let ok = at < spare;
  if ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let old_value = buf[at];
  let old_ok = old_value == 1_u8;
  if old_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  set buf[at] = 9_u8;
  let fresh_value = buf[at];
  let fresh_ok = fresh_value == 9_u8;
  if fresh_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
