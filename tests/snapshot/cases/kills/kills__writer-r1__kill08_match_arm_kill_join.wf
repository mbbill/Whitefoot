enum Mode {
  Fast();
  Slow();
}

fn step_size(mode: own Mode, table: own FixedVector<u16, 4>) -> result: own u16 reads(table) contract {
  requires len_of(table) >= 4_u64;
} {
  doc "expect ACCEPT: pos is set to a different value in each arm, killing whatever fact reached the match from before it; each arm independently re-establishes pos's own bound before the join reads table[pos].";
  let pos = 0_u64;
  match mode {
    Fast() => {
      set pos = 1_u64;
    }
    Slow() => {
      set pos = 3_u64;
    }
  }
  let in_range = pos < 4_u64;
  if in_range {
  } else {
    return 0_u16;
  }
  return table[pos];
}

command fn main() -> status: own ExitStatus pure {
  let first_table = fixed_vector::<u16, 4>();
  set first_table = place_back(vector: move first_table, value: 0_u16);
  set first_table = place_back(vector: move first_table, value: 0_u16);
  set first_table = place_back(vector: move first_table, value: 0_u16);
  set first_table = place_back(vector: move first_table, value: 0_u16);
  set first_table[1_u64] = 5_u16;
  set first_table[3_u64] = 9_u16;
  let fast = Fast();
  let fast_step = step_size(mode: fast, table: move first_table);
  if fast_step == 5_u16 {
  } else {
    return exit_status(code: 1_u8);
  }
  let second_table = fixed_vector::<u16, 4>();
  set second_table = place_back(vector: move second_table, value: 0_u16);
  set second_table = place_back(vector: move second_table, value: 0_u16);
  set second_table = place_back(vector: move second_table, value: 0_u16);
  set second_table = place_back(vector: move second_table, value: 0_u16);
  set second_table[1_u64] = 5_u16;
  set second_table[3_u64] = 9_u16;
  let slow = Slow();
  let slow_step = step_size(mode: slow, table: move second_table);
  if slow_step == 9_u16 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
