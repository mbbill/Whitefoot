fn store_then_double(out: &uniq buffer<u32>, at: own u64, value: own u32) -> result: own u32 reads(out), writes(out) {
  doc "expect ACCEPT: set deref(out)[at] kills the buffer's prior image, so the immediately following read of the same slot must reuse the spare fact already proved for the write, not a fresh unproved one.";
  let spare = len_of(deref(out));
  let in_bounds = at < spare;
  if in_bounds {
  } else {
    return 0_u32;
  }
  set deref(out)[at] = value;
  let stored = deref(out)[at];
  let doubled = stored +wrap stored;
  return doubled;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let scratch = buffer_new(4_u64, 0_u32);
  let result = 0_u32;
  region {
    set result = store_then_double(out: &uniq scratch, at: 2_u64, value: 7_u32);
  }
  if result == 14_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
