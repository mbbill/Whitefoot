fn read_shifted<const n: u64>(b: own FixedVector<u8, n>, shift: own u64) -> result: own u8 reads(b) {
  let spare = len_of(b);
  let cursor = 0_u64;
  let in_range = cursor < spare;
  if in_range {
  } else {
    return 0_u8;
  }
  set cursor = shift;
  return b[cursor];
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: REJECT [OP-4] -- the bound check guards `cursor` before the set retargets it to the unbounded param `shift`; the later subscript has no surviving bound [ENT-5](a).";
  let data = fixed_vector::<u8, 8>();
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  set data = place_back(vector: move data, value: 5_u8);
  let value = read_shifted::<8>(b: move data, shift: 2_u64);
  let correct = value == 5_u8;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
