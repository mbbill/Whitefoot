fn loopy(limit: own u8, w: own u8) -> result: own u8 pure contract {
  requires ile(limit, 5_u8);
} {
  let cursor = 0_u8;
  loop (
    invariant bounded: ile(cursor, limit)
  ) {
    let remaining = ilt(cursor, limit);
    if remaining {
      invariant guarded: ilt(cursor, limit);
      set cursor = cursor +wrap 1_u8;
    } else {
      break;
    }
  }
  set cursor = w;
  let ok = ile(cursor, 5_u8);
  if ok {
    let z = cursor + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "expect ACCEPT: set cursor=w kills the loop-derived bound, but code reproves ile(cursor,5_u8) with an if-guard before the add";
  let r = loopy(limit: 5_u8, w: 2_u8);
  return exit_status(code: 0_u8);
}
