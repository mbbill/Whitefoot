struct Cursor {
  idx: u64;
  limit: u64;
}

fn cursor_read_at<const n: u64>(table: own FixedVector<u8, n>, cursor: own Cursor) -> value: own u8 reads(table, cursor.idx), writes(cursor.idx) contract {
  define spare = len_of(table);
  requires cursor.idx < cursor.limit;
  requires cursor.limit <= spare;
} {
  doc "expect REJECT [OP-4]: set cursor.idx = 9_u64 kills the fact tying idx to limit before the read; a wrong accept lets idx=9 index a 4-slot table (OOB read).";
  set cursor.idx = 9_u64;
  return table[cursor.idx];
}

command fn main() -> status: own ExitStatus pure {
  let table = fixed_vector::<u8, 4>();
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  set table = place_back(vector: move table, value: 7_u8);
  let start = Cursor(idx: 0_u64, limit: 4_u64);
  let value = cursor_read_at::<4>(table: move table, cursor: move start);
  return exit_status(code: value);
}
