fn touch_then_read(buf: own buffer<u8>, i: own u64) -> value: own u8 reads(buf), writes(buf) contract {
  define spare = len_of(buf);
  requires i < spare;
  requires 0_u64 < spare;
} {
  doc "expect ACCEPT: writing buf[0] does not change len_of(buf), so the i < len_of(buf) fact for a different index i still holds; sanity check that unrelated writes are not over-killed.";
  set buf[0_u64] = 42_u8;
  return buf[i];
}

command fn main() -> status: own ExitStatus pure {
  let buf = buffer_new(5_u64, 1_u8);
  let value = touch_then_read(buf: move buf, i: 2_u64);
  return exit_status(code: value);
}
