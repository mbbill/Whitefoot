fn second_or_zero(values: own array<u32, 6>, idx: own u64) -> result: own u32 pure {
  doc "expect ACCEPT: set kills the old bound on idx, but a fresh branch re-establishes the new value's bound before the index, so OP-4 is discharged from the live fact.";
  let in_range = ilt(idx, 6_u64);
  if in_range {
  } else {
    return 0_u32;
  }
  let first = values[idx];
  let bumped = idx +wrap 1_u64;
  set idx = bumped;
  let still_in_range = ilt(idx, 6_u64);
  if still_in_range {
  } else {
    return first;
  }
  let second = values[idx];
  return second;
}

command fn main() -> status: own ExitStatus pure {
  let values = array_new<u32, 6>(9_u32);
  let picked = second_or_zero(values: move values, idx: 2_u64);
  if ieq(picked, 9_u32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
