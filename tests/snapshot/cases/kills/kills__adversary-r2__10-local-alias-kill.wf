fn f(n: own u8, w: own u8) -> result: own u8 pure contract {
  requires n <= 5_u8;
} {
  let m = n;
  set m = w;
  let z = m + 250_u8;
  return z;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT (OP-2): let m=n copies the bound but set m=w kills it on m; n=0 (ok), w=255 -> m+250_u8 overflows u8";
  let r = f(n: 0_u8, w: 255_u8);
  return exit_status(code: 0_u8);
}
