struct Ring {
  samples: FixedVector<u32, 4>;
  cursor: u64;
}

command fn main() -> status: own ExitStatus pure {
  doc "expected: ACCEPT -- writing filter.cursor kills the old bound on that field [ENT-5](a); each iteration reestablishes it before indexing.";
  let samples = fixed_vector::<u32, 4>();
  set samples = place_back(vector: move samples, value: 0_u32);
  set samples = place_back(vector: move samples, value: 0_u32);
  set samples = place_back(vector: move samples, value: 0_u32);
  set samples = place_back(vector: move samples, value: 0_u32);
  let ring = Ring(samples: move samples, cursor: 0_u64);
  let total = 0_u32;
  let mark = 0_u32;
  for (step in 0_u64..6_u64) {
    let write_ok = ring.cursor < 4_u64;
    if write_ok {
    } else {
      return exit_status(code: 1_u8);
    }
    set ring.samples[ring.cursor] = mark;
    set mark = mark +wrap 1_u32;
    let read_ok = ring.cursor < 4_u64;
    if read_ok {
    } else {
      return exit_status(code: 1_u8);
    }
    let value = ring.samples[ring.cursor];
    set total = total +wrap value;
    let at_end = ring.cursor == 3_u64;
    let next_cursor = if at_end {
      give 0_u64;
    } else {
      give ring.cursor +wrap 1_u64;
    }
    set ring.cursor = next_cursor;
  }
  let correct = total == 15_u32;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
