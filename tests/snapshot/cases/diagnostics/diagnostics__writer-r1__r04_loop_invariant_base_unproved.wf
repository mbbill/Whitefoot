fn count_touched(limit: own u64) -> value: own u64 pure {
  let touched = 0_u64;
  for (
    i in 0_u64..limit,
    invariant nonneg: ile(0_u64, touched)
  ) {
    set touched = 1_u64;
  }
  return touched;
}

command fn main() -> status: own ExitStatus pure {
  doc "expect REJECT: [INV-1] the header invariant fails at the first loop header (base case)";
  for (
    i in 0_u64..0_u64,
    invariant seen_positive: ile(1_u64, i)
  ) {
  }
  return exit_status(code: 0_u8);
}
