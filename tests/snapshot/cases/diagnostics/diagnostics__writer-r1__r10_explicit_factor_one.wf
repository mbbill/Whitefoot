fn combined_span(first: own u64, first_cap: own u64, second: own u64, second_cap: own u64) -> result: own unit pure contract {
  requires ile(first, first_cap);
  requires ile(second, second_cap);
} {
  doc "expect REJECT: [PRF-1] the explicit factor `1 *` on the use source is not a canonical positive factor other than omitted";
  invariant span_bound: ile(first + second, first_cap + second_cap);
  invariant tripled_bound: ile(3_u64 * first + 3_u64 * second, 3_u64 * first_cap + 3_u64 * second_cap) {
    use 1 * span_bound;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
