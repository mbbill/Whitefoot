fn clamp_hint_ok(x: own u8, limit: own u8) -> value: own u8 pure contract {
  requires x <= limit;
} {
  invariant within_cap: x <= limit;
  return x;
}

fn clamp_hint(x: own u8, limit: own u8) -> value: own u8 pure {
  doc "expect REJECT: [PRF-1] the local invariant target is not established by anything in scope and carries no use block";
  invariant within_cap: x <= limit;
  return x;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
