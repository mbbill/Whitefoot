fn combined_span(first: own u64, first_cap: own u64, second: own u64, second_cap: own u64) -> result: own unit pure contract {
  requires first <= first_cap;
  requires second <= second_cap;
} {
  doc "expect REJECT: [PRF-1] the same normalized use source is listed three times instead of combined with one factor";
  invariant span_bound: first + second <= first_cap + second_cap;
  invariant tripled_bound: 3_u64 * first + 3_u64 * second <= 3_u64 * first_cap + 3_u64 * second_cap {
    use span_bound;
    use span_bound;
    use span_bound;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
