fn retain_plain(value: own u64, limit: own u64) -> result: own unit pure contract {
  requires value <= limit;
} {
  invariant upper_bound: value <= limit;
  return unit;
}

fn retain(value: own u64, limit: own u64) -> result: own unit pure contract {
  requires value <= limit;
} {
  doc "expect REJECT: [PRF-1] the invariant target is already provable by AUTO from the requirement alone, so the use block is redundant";
  invariant upper_bound: value <= limit {
    use value <= limit;
  }
  return unit;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
