fn main(args: own Args) -> status: own ExitStatus reads(args) {
  doc "EXPECT REJECT under OP-2: the ordinary args_count result may be zero; guard the divisor before dividing.";
  region {
    let divisor = args_count(args: &args);
    let pool = 100_u64;
    let bonus = 4_u64;
    let total = pool +wrap bonus;
    let doubled = total +wrap total;
    let tripled = doubled +wrap total;
    let quadrupled = tripled +wrap total;
    let share = quadrupled / divisor;
    let doc_zero = 0_u64;
    let final_code = 0_u8;
    return exit_status(code: final_code);
  }
}
