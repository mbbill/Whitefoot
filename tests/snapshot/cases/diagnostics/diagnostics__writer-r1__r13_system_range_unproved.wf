fn main['heap](args: own Args, heap: own Heap<'heap>) -> status: own ExitStatus reads(args, heap), writes(heap), allocates(heap) {
  doc "expect REJECT: [FN-8] the ordinary host_copy_bytes requirement lacks a proof that end is within the destination length";
  region {
    match heap_vector::<u8>(store: &uniq heap, count: 4_u64) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: fresh) => {
        let bytes = move fresh;
        for @scratch (
          at in 0_u64..4_u64,
          invariant grown: len_of(bytes) >= at,
          invariant spare: room_of(bytes) + at >= 4_u64,
          invariant flat: head_of(bytes) <= 0_u64
        ) {
          place_back(vector: &uniq bytes, value: 0_u8);
        }
        region {
          let window = mut_slice_of(&uniq bytes);
          region 'a {
            match arg_get(args: &args, position: 1_u64) {
              Ok(value: text) => {
                region 'v {
                  region {
                    let end = args_count(args: &'a args);
                    match host_copy_bytes(value: &'v text, destination: &uniq window, start: 0_u64, end: end) {
                      Ok(value: copied) => {
                        return exit_status(code: 10_u8);
                      }
                      Err(error: problem) => {
                        return exit_status(code: 11_u8);
                      }
                    }
                  }
                }
              }
              Err(error: absent) => {
                return exit_status(code: 12_u8);
              }
            }
          }
        }
      }
    }
  }
}
