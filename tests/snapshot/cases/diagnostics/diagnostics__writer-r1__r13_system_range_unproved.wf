command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args), allocates(heap) {
  doc "expect REJECT: [SYS-8] end is a runtime-derived offset never proved within the destination length";
  let bytes = buffer_new(4_u64, 0_u8);
  region 'a {
    match arg_get::<'a>(args: &'a args, position: 1_u64) {
      Ok(value: text) => {
        region 'v {
          region 'd {
            let end = args_count::<'a>(args: &'a args);
            match host_copy_bytes::<'v, 'd>(value: &'v text, destination: &uniq 'd bytes, start: 0_u64, end: end) {
              Ok(value: copied) => {
                return exit_status(code: 10_u8);
              }
              Err(error: problem) => {
                return exit_status(code: 11_u8);
              }
            }
          }
        }
      }
      Err(error: absent) => {
        return exit_status(code: 12_u8);
      }
    }
  }
}
