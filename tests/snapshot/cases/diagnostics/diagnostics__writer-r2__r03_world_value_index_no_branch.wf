fn main(args: own Args) -> status: own ExitStatus reads(args) {
  doc "EXPECT REJECT under OP-4: args_count has no ensures that bounds this result by the local run length; a real guard on index < spare is required before indexing.";
  region {
    let index = args_count(args: &args);
    let bytes = fixed_vector::<u8, 4>();
    region {
      place_back(vector: &uniq bytes, value: 0_u8);
    }
    region {
      place_back(vector: &uniq bytes, value: 0_u8);
    }
    region {
      place_back(vector: &uniq bytes, value: 0_u8);
    }
    region {
      place_back(vector: &uniq bytes, value: 0_u8);
    }
    let spare = len_of(bytes);
    let second = bytes[1_u64];
    let first = bytes[0_u64];
    let last = bytes[3_u64];
    let seed = first +wrap last;
    let value = bytes[index];
    let combined = seed +wrap value;
    return exit_status(code: combined);
  }
}
