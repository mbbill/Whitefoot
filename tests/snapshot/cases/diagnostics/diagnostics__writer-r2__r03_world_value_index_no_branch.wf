command fn main(command.args as args: own Args) -> status: own ExitStatus reads(args) {
  doc "EXPECT REJECT under Op4: index comes from args_count, a genuinely external world value the compiler cannot bound at compile time, so an invariant could never be written honestly here; the correct repair is a real dominating branch on index < spare, not an invariant.";
  region {
    let index = args_count(args: &args);
    let bytes = fixed_vector::<u8, 4>();
    set bytes = place_back(vector: move bytes, value: 0_u8);
    set bytes = place_back(vector: move bytes, value: 0_u8);
    set bytes = place_back(vector: move bytes, value: 0_u8);
    set bytes = place_back(vector: move bytes, value: 0_u8);
    let spare = len_of(bytes);
    let second = bytes[1_u64];
    let first = bytes[0_u64];
    let last = bytes[3_u64];
    let seed = first +wrap last;
    let value = bytes[index];
    let combined = seed +wrap value;
    return exit_status(code: combined);
  }
}
