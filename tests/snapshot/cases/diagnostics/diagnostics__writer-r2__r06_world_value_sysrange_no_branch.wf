fn publish(output: &uniq Output, source: &Slice<u8>, start: own u64, end: own u64) -> result: own unit reads(output, source), writes(output) {
  doc "EXPECT REJECT under Sys8: start and end are threaded straight through from an external world value with no compile-time bound, so an invariant asserting the range fits source would be dishonest here; the correct repair is a real dominating branch on the range before publishing.";
  region {
    match write_once(output: &uniq deref(output), source: source, start: start, end: end) {
      Ok(value: next) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return unit;
}

command fn main(command.args as args: own Args, command.stdout as output: own Output) -> status: own ExitStatus reads(args, output), writes(output) {
  region {
    let n = args_count(args: &args);
    let bytes = fixed_vector::<u8, 4>();
    for @fill (
      at in 0_u64..4_u64,
      invariant grown: len_of(bytes) >= at,
      invariant spare: room_of(bytes) + at >= 4_u64,
      invariant flat: head_of(bytes) <= 0_u64
    ) {
      set bytes = place_back(vector: move bytes, value: 65_u8);
    }
    region 'o {
      let payload = slice_of(&bytes);
      region {
        let result = publish(output: &uniq 'o output, source: &payload, start: 0_u64, end: n);
      }
    }
  }
  return exit_status(code: 0_u8);
}
