fn publish(factory: &uniq HandleFactory, output: &uniq OutputStream, source: &Slice<u8>, start: own u64, end: own u64) -> result: own unit reads(factory, output, source), writes(factory, output) {
  doc "EXPECT REJECT under FN-8: the ordinary write_once requirements have no proved ordering or source-length bound for these parameters; guard the actual range or require its bounds at the wrapper boundary.";
  region {
    match write_once(factory: &uniq deref(factory), output: &uniq deref(output), source: source, start: start, end: end) {
      Ok(value: next) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return unit;
}

fn main(factory: own HandleFactory, args: own Args, output: own OutputStream) -> status: own ExitStatus reads(factory, args, output), writes(factory, output) {
  region {
    let n = args_count(args: &args);
    let bytes = fixed_vector::<u8, 4>();
    for @fill (
      at in 0_u64..4_u64,
      invariant grown: len_of(bytes) >= at,
      invariant spare: room_of(bytes) + at >= 4_u64,
      invariant flat: head_of(bytes) <= 0_u64
    ) {
      place_back(vector: &uniq bytes, value: 65_u8);
    }
    region 'o {
      let payload = slice_of(&bytes);
      region {
        let result = publish(factory: &uniq factory, output: &uniq 'o output, source: &payload, start: 0_u64, end: n);
      }
    }
  }
  return exit_status(code: 0_u8);
}
