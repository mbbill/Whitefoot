fn touched_byte(limit: own u64, xs: own buffer<u8>) -> value: own u8 reads(xs) contract {
  define count = len_of(xs);
  requires limit <= count;
  requires limit >= 1_u64;
} {
  doc "EXPECT REJECT under Op4: the loop walks cursor up to limit through an ordinary if/break with no header invariant, so nothing survives the loop to prove xs[last] afterward even though cursor == limit on exit; the right repair is to write the invariant, not add another branch.";
  let cursor = 0_u64;
  loop {
    let more = cursor < limit;
    if more {
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  let last = cursor - 1_u64;
  return xs[last];
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
