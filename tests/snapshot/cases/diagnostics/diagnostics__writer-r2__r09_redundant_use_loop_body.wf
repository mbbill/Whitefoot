command fn main() -> status: own ExitStatus pure {
  doc "EXPECT REJECT under Prf1: AUTO already proves the body-local invariant directly from the counted for's own structural fact i < count, so the written use (block restates a residual AUTO already closes on its own); the correct repair is to remove the use block.";
  let count = 4_u64;
  let touched = 0_u64;
  let margin = 1_u64;
  let widened = count +wrap margin;
  for (i in 0_u64..count) {
    invariant bounded: i <= count {
      use (count >= 0_u64);
    }
    let seen = i;
    let doubled_seen = seen +wrap seen;
  }
  let base_code = 0_u8;
  return exit_status(code: base_code);
}
