fn increment_documented(x: own u8) -> result: own u8 pure contract {
  requires ile(x, 254_u8);
} {
  invariant upper_bound: ile(x, 254_u8);
  return x;
}

fn increment(x: own u8, middle: own u8) -> result: own u8 pure contract {
  requires ile(middle, 254_u8);
} {
  doc "expect REJECT: [PRF-1] the first use relation ile(x, middle) is not established by anything before the invariant statement";
  invariant upper_bound: ile(x, 254_u8) {
    use ile(x, middle);
    use ile(middle, 254_u8);
  }
  return x;
}

command fn main() -> status: own ExitStatus pure {
  return exit_status(code: 0_u8);
}
