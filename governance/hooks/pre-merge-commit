#!/bin/sh
# A merge commit does not run pre-commit, so the same released-specification
# protection runs here. The index holds the merge result, which is what
# spec-append-only-staged reads.
#
# Neither hook is the real guard — `--no-verify` and a clone whose
# core.hooksPath points elsewhere both skip them. `make check` is.
exec make --no-print-directory spec-append-only-staged
