#!/bin/sh
# A merge commit does not run pre-commit, so the same specification protection
# runs here. The index holds the merge result at this point, which is what
# spec-append-only-staged reads.
#
# This hook is not the real guard — `--no-verify` and a clone whose
# core.hooksPath points elsewhere both skip it. `make check` is.
exec make --no-print-directory spec-append-only-staged
