const minimum_value: i32 = -2147483648_i32;

fn divide_safely(n: own i32, d: own i32) -> own i32 traps requires {
  let dividend_ok = ine(n, -2147483648_i32);
  let divisor_ok = ine(d, -1_i32);
  let safe = bor(dividend_ok, divisor_ok);
  check safe else trap "division is defined on these operands";
} {
  doc "The requirement spells the bound as a typed literal.";
  let q = n / d;
  return q;
}

fn caller(n: own i32, d: own i32) -> own i32 traps {
  doc "Negative control: a named const of the same mathematical value is a different datum, and [FN-8] folds nothing.";
  let dividend_ok = ine(n, minimum_value);
  let divisor_ok = ine(d, -1_i32);
  let safe = bor(dividend_ok, divisor_ok);
  claim division_safe: safe because "the same value, spelled as a named const";
  let q = divide_safely(n: n, d: d);
  return q;
}

fn main() -> own unit traps {
  doc "Driver.";
  let observed = caller(n: 8_i32, d: 2_i32);
  return unit;
}
