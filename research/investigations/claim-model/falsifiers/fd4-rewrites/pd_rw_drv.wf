fn decode['r](out: &uniq 'r buffer<u8>, src: own buffer<u8>) -> result: own u64 reads(src), writes(out) contract {
  define output_length = len(deref(out));
  define source_length = len(src);
  define sufficient = ige(output_length, source_length);
  requires sufficient;
} {
  doc "Claim-free. The loop exit is spelled as the bound the source subscript states, so every head republishes it. The escape offsets are exact terms from two checked additions and one guard on the second, whose false edge is the literal-byte path the program already had. The output subscript is guarded against the source length, which the sufficiency requirement carries to the output length; its false edge stops the decode, which is what running out of output room means.";
  let source_length = len(src);
  let input_index = 0_u64;
  let output_index = 0_u64;
  loop @decode_loop {
    let more = ilt(input_index, source_length);
    if more {
    } else {
      break @decode_loop;
    }
    let byte = src[input_index];
    let is_percent = ieq(byte, 37_u8);
    let emitted = byte;
    let stride = 1_u64;
    if is_percent {
      match input_index +checked 1_u64 {
        Ok(value: next_index) => {
          match input_index +checked 2_u64 {
            Ok(value: last_index) => {
              let last_ok = ilt(last_index, source_length);
              if last_ok {
                let high_byte = src[next_index];
                let low_byte = src[last_index];
                let high_decimal_low = ige(high_byte, 48_u8);
                let high_decimal_high = ile(high_byte, 57_u8);
                let high_decimal = band(high_decimal_low, high_decimal_high);
                let high_upper_low = ige(high_byte, 65_u8);
                let high_upper_high = ile(high_byte, 70_u8);
                let high_upper = band(high_upper_low, high_upper_high);
                let high_lower_low = ige(high_byte, 97_u8);
                let high_lower_high = ile(high_byte, 102_u8);
                let high_lower = band(high_lower_low, high_lower_high);
                let high_alphabetic = bor(high_upper, high_lower);
                let high_valid = bor(high_decimal, high_alphabetic);
                let low_decimal_low = ige(low_byte, 48_u8);
                let low_decimal_high = ile(low_byte, 57_u8);
                let low_decimal = band(low_decimal_low, low_decimal_high);
                let low_upper_low = ige(low_byte, 65_u8);
                let low_upper_high = ile(low_byte, 70_u8);
                let low_upper = band(low_upper_low, low_upper_high);
                let low_lower_low = ige(low_byte, 97_u8);
                let low_lower_high = ile(low_byte, 102_u8);
                let low_lower = band(low_lower_low, low_lower_high);
                let low_alphabetic = bor(low_upper, low_lower);
                let low_valid = bor(low_decimal, low_alphabetic);
                let valid = band(high_valid, low_valid);
                if valid {
                  let high_is_decimal = ile(high_byte, 57_u8);
                  let high = if high_is_decimal {
                    let value = high_byte -wrap 48_u8;
                    give value;
                  } else {
                    let high_is_upper = ile(high_byte, 70_u8);
                    let value = if high_is_upper {
                      let offset = high_byte -wrap 65_u8;
                      give offset +wrap 10_u8;
                    } else {
                      let offset = high_byte -wrap 97_u8;
                      give offset +wrap 10_u8;
                    }
                    give value;
                  }
                  let low_is_decimal = ile(low_byte, 57_u8);
                  let low = if low_is_decimal {
                    let value = low_byte -wrap 48_u8;
                    give value;
                  } else {
                    let low_is_upper = ile(low_byte, 70_u8);
                    let value = if low_is_upper {
                      let offset = low_byte -wrap 65_u8;
                      give offset +wrap 10_u8;
                    } else {
                      let offset = low_byte -wrap 97_u8;
                      give offset +wrap 10_u8;
                    }
                    give value;
                  }
                  let shifted = high *wrap 16_u8;
                  let decoded = shifted +wrap low;
                  set emitted = decoded;
                  set stride = 3_u64;
                }
              }
            }
            Err(error: over_last) => {
            }
          }
        }
        Err(error: over_next) => {
        }
      }
    }
    let room_left = ilt(output_index, source_length);
    if room_left {
    } else {
      break @decode_loop;
    }
    set deref(out)[output_index] = emitted;
    set input_index = input_index +wrap stride;
    set output_index = output_index +wrap 1_u64;
  }
  return output_index;
}

fn publish_all['o, 's](output: &uniq 'o Output, source: &'s buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define source_length = len(deref(source));
  requires ile(length, source_length);
} {
  doc "Publishes one prefix of the source buffer, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = ilt(sent, length);
    if pending {
    } else {
      break @publish;
    }
    region 'attempt {
      match write_once<'attempt, 's>(output: &uniq 'attempt deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

command fn main(command.args as args: own Args, command.stdout as out: own Output) -> status: own ExitStatus reads(args, out), writes(out), allocates(heap) {
  doc "F-D4 differential driver: decodes argv[1] and publishes the produced count and the whole output buffer, sentinel fill included, so two builds can be compared byte for byte.";
  let staging = buffer_new(4096_u64, 0_u8);
  let argument_count = 0_u64;
  region 'invocation {
    set argument_count = args_count<'invocation>(args: &'invocation args);
  }
  let usable = ige(argument_count, 2_u64);
  if usable {
  } else {
    return exit_status(code: 3_u8);
  }
  let source_length = 0_u64;
  let startup = 0_u8;
  region 'lease {
    match arg_get<'lease>(args: &'lease args, position: 1_u64) {
      Ok(value: text) => {
        region 'copy {
          match host_copy_bytes<'copy, 'copy>(value: &'copy text, destination: &uniq 'copy staging, start: 0_u64, end: 4096_u64) {
            Ok(value: copied) => {
              set source_length = copied;
            }
            Err(error: too_small) => {
              set startup = 1_u8;
            }
          }
        }
      }
      Err(error: absent) => {
        set startup = 1_u8;
      }
    }
  }
  if ieq(startup, 0_u8) {
  } else {
    return exit_status(code: 3_u8);
  }
  let source = buffer_new(source_length, 0_u8);
  let output = buffer_new(source_length, 204_u8);
  let cursor = 0_u64;
  loop @copy_in {
    let more = ilt(cursor, source_length);
    if more {
    } else {
      break @copy_in;
    }
    let staging_room = len(staging);
    let readable = ilt(cursor, staging_room);
    if readable {
      let byte = staging[cursor];
      let source_room = len(source);
      let writable = ilt(cursor, source_room);
      if writable {
        set source[cursor] = byte;
      }
    }
    set cursor = cursor +wrap 1_u64;
  }
  let output_room = len(output);
  let source_room = len(source);
  let sufficient = ige(output_room, source_room);
  if sufficient {
  } else {
    return exit_status(code: 4_u8);
  }
  let produced = 0_u64;
  region 'decode_region {
    set produced = decode<'decode_region>(out: &uniq 'decode_region output, src: move source);
  }
  let head = buffer_new(8_u64, 0_u8);
  let shift = 0_u32;
  let head_index = 0_u64;
  loop @encode {
    let more = ilt(head_index, 8_u64);
    if more {
    } else {
      break @encode;
    }
    let moved = ishr.wrap(produced, shift);
    let low = iand(moved, 255_u64);
    let narrowed = cvt<u64, u8>(low);
    let byte = match narrowed {
      Ok(value: fitted) => {
        give fitted;
      }
      Err(error: failure) => {
        give 0_u8;
      }
    }
    let head_room = len(head);
    let writable = ilt(head_index, head_room);
    if writable {
      set head[head_index] = byte;
    }
    set shift = shift +wrap 8_u32;
    set head_index = head_index +wrap 1_u64;
  }
  region 'head_write {
    let head_length = len(head);
    match publish_all<'head_write, 'head_write>(output: &uniq 'head_write out, source: &'head_write head, length: head_length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
        return exit_status(code: 5_u8);
      }
    }
  }
  region 'body_write {
    let body_length = len(output);
    match publish_all<'body_write, 'body_write>(output: &uniq 'body_write out, source: &'body_write output, length: body_length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
        return exit_status(code: 5_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
