fn needs_flag(f: own Bool, v: own u64) -> result: own u64 pure contract {
  requires f;
} {
  return v;
}

fn drive(wide: own Bool) -> result: own u64 pure {
  doc "Observes whether S1 publishes the signed goal of a bare Bool parameter: the call's FN-8 goal is exactly `wide`, and it can only discharge from +wide at the then entry.";
  let out = 0_u64;
  if wide {
    let r = needs_flag(f: wide, v: 5_u64);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  let t = True();
  let a = drive(wide: t);
  return exit_status(code: 0_u8);
}
