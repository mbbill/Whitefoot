fn tail_byte['d](data: &'d buffer<u8>) -> result: own u8 reads(data) {
  doc "The control: the identical arithmetic and read fused into one arm. This accepts today, which pins that the only lost premise in g01 is the join, not the operation images.";
  let n = len(deref(data));
  let start = 0_u64;
  let have_room = ige(n, 8_u64);
  let out = 0_u8;
  if have_room {
    set start = n -wrap 8_u64;
    let checksum = 0_u8;
    set checksum = checksum +wrap 3_u8;
    let byte = deref(data)[start];
    set out = byte;
  }
  return out;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(4096_u64, 7_u8);
  region 'r {
    let b = tail_byte<'r>(data: &'r input);
  }
  return exit_status(code: 0_u8);
}
