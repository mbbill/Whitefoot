fn needs_one(f: own Bool, v: own u64) -> result: own u64 pure contract {
  requires f;
} {
  return v;
}

fn drive(a: own Bool) -> result: own u64 pure {
  doc "An opaque flag copied to a second binding. The goal `a` and the goal `copy` are distinct propositions to the checker, so testing the copy must not discharge a goal naming the original.";
  let copy = a;
  let out = 0_u64;
  if copy {
    let r = needs_one(f: a, v: 5_u64);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  let t = True();
  let x = drive(a: t);
  return exit_status(code: 0_u8);
}
