struct Head {
  body_at: u64;
  seen: u64;
}

fn bump['m](h: &uniq 'm Head) -> result: own u64 reads(h.seen), writes(h.seen) {
  let s = deref(h).seen;
  set deref(h).seen = s +wrap 1_u64;
  return s;
}

fn drive['d](data: &'d buffer<u8>, h: own Head) -> result: own u8 reads(data, h.body_at, h.seen), writes(h.seen) {
  doc "Pins the kill granularity the record route rests on, with the struct arriving as a parameter so no construction image is needed. The S1 fact `h.body_at - n <= -1` has support {h.body_at}; the call's EFF-2 write row projects onto h.seen. ACCEPT means a sibling-field write kills no fact about h.body_at, which is the transport a released delta fact over a record field receives.";
  let n = len(deref(data));
  let inside = ilt(h.body_at, n);
  let out = 0_u8;
  if inside {
    region 'm {
      let s = bump<'m>(h: &uniq 'm h);
    }
    let g = deref(data)[h.body_at];
    set out = g;
  }
  return out;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(4096_u64, 65_u8);
  let head = Head(body_at: 3_u64, seen: 0_u64);
  region 'r {
    let b = drive<'r>(data: &'r input, h: move head);
  }
  return exit_status(code: 0_u8);
}
