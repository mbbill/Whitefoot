fn needs_one(f: own Bool, v: own u64) -> result: own u64 pure contract {
  requires f;
} {
  return v;
}

fn drive(a: own Bool, b: own Bool) -> result: own u64 pure {
  doc "The converse of g08: one compound test, then a single-conjunct consumer. S1's signed decomposition must publish +a inside the band arm.";
  let out = 0_u64;
  let both = band(a, b);
  if both {
    let r = needs_one(f: a, v: 5_u64);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  let t = True();
  let x = drive(a: t, b: t);
  return exit_status(code: 0_u8);
}
