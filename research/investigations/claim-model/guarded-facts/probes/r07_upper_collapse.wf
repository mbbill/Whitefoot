fn needs_le7(x: own u64) -> result: own u64 pure contract {
  requires ile(x, 7_u64);
} {
  return x;
}

fn drive(n: own u64, t: own u64) -> result: own u64 pure contract {
  requires ile(t, n);
} {
  doc "The negative-edge half of the audit's DBM-collapse maximiser, and the driver of the flagship recount. One upper bound on n, published on the false edge of `if ige(n, 8)`, bounds EVERY term already known below n. a12 pins the positive side; this pins that a false-edge delta carries one member per such term, which is why layout.wf's negative entries are its large ones.";
  let big = ige(n, 8_u64);
  let out = 0_u64;
  if big {
  } else {
    let r = needs_le7(x: t);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  let x = drive(n: 3_u64, t: 1_u64);
  return exit_status(code: 0_u8);
}
