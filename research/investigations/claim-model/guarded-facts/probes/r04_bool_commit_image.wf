struct H {
  flag: Bool;
}

fn needs_flag(f: own Bool, v: own u64) -> result: own u64 pure contract {
  requires f;
} {
  return v;
}

fn drive(seed: own Bool) -> result: own u64 pure {
  doc "Does a value commit to a Bool field publish the destination's signed goal? After `set h.flag = yes;` the call's FN-8 goal `h.flag` can discharge only from a commit image. This is the second half of the [ENT-3.S5] Bool prerequisite the committed-flag key needs.";
  let yes = True();
  let h = H(flag: seed);
  set h.flag = yes;
  let r = needs_flag(f: h.flag, v: 5_u64);
  return r;
}

command fn main() -> status: own ExitStatus pure {
  let t = True();
  let x = drive(seed: t);
  return exit_status(code: 0_u8);
}
