fn needs_flag(f: own Bool, v: own u64) -> result: own u64 pure contract {
  requires f;
} {
  return v;
}

fn drive() -> result: own u64 pure {
  doc "Does `let yes = True();` publish the signed goal +yes? The call's FN-8 goal is exactly `yes`. ACCEPT means the Bool literal construction is a fact source today; REJECT means [ENT-3.S5]'s Bool clause must name it.";
  let yes = True();
  let r = needs_flag(f: yes, v: 5_u64);
  return r;
}

command fn main() -> status: own ExitStatus pure {
  let x = drive();
  return exit_status(code: 0_u8);
}
