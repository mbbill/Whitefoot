fn needs_ge4(v: own u64) -> result: own u64 pure contract {
  requires ige(v, 4_u64);
} {
  return v;
}

fn drive() -> result: own u64 pure {
  doc "The same question as r01 with no struct in the way: does `let no = False();` publish -no, so that the then edge of `if no` is contradictory? Separates the field destination from the Bool literal construction itself.";
  let no = False();
  let out = 0_u64;
  if no {
    let r = needs_ge4(v: 0_u64);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  let x = drive();
  return exit_status(code: 0_u8);
}
