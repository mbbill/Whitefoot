struct Head {
  body_at: u64;
}

fn drive['d](data: &'d buffer<u8>) -> result: own u8 reads(data) contract {
  define room = len(deref(data));
  requires ige(room, 4_u64);
} {
  doc "Contrast probe: a plain local literal versus the same literal held in a struct field.";
  let x = 3_u64;
  let g = deref(data)[x];
  return g;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(4096_u64, 65_u8);
  region 'r {
    let b = drive<'r>(data: &'r input);
  }
  return exit_status(code: 0_u8);
}
