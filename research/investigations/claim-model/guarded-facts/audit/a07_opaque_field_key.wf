struct H {
  flag: Bool;
}

fn needs_ge4(v: own u64) -> result: own u64 pure contract {
  requires ige(v, 4_u64);
} {
  return v;
}

fn drive['d](data: &'d buffer<u8>) -> result: own u64 reads(data) {
  doc "ISOLATING PROBE for the coverage gap the audit's second flagship exposes. The flag is COMPUTED as a comparison and STORED into a place under that comparison's branch; the use phase tests the place. If this REJECTS, then `if h.flag` publishes only the opaque signed goal +h.flag and no comparison projection, so a guarded entry keyed on [+room4] with projection `4 - n <= 0` is satisfied by neither of [ENT-5.G5]'s two routes at the use site, and [ENT-5.G] discharges nothing in the record-of-flags idiom.";
  let n = len(deref(data));
  let yes = True();
  let no = False();
  let h = H(flag: no);
  let room4 = ige(n, 4_u64);
  if room4 {
    set h.flag = yes;
  }
  let out = 0_u64;
  if h.flag {
    let r = needs_ge4(v: n);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(4096_u64, 65_u8);
  region 'r {
    let b = drive<'r>(data: &'r input);
  }
  return exit_status(code: 0_u8);
}
