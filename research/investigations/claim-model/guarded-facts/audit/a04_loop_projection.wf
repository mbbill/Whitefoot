fn broken_loop['d](data: &'d buffer<u8>, small: own u64) -> result: own u8 reads(data) contract {
  define room = len(deref(data));
  requires ige(room, 4_u64);
} {
  doc "REFUTATION WITNESS for the P-LOOP seam of [ENT-5.G3]. The entry [+fits] with projection `8 - m <= 0` and delta { idx - Z <= 3 } is formed before the loop. Its SUPPORT is {idx, Z, fits}; the projection's term m is not a support member, so [ENT-5.G3]'s head subtraction - which removes only entries with a support member a continuing kill may kill - keeps the entry at every iteration head even though the body writes m on every pass. Inside the body `if again` republishes `8 - m <= 0`, satisfying the stored projection, and step (2') releases `idx - Z <= 3` on every iteration. Called with small = 0 the else arm ran, idx = 50, and the buffer is 4 bytes.";
  let m = small;
  let fits = ige(m, 8_u64);
  let idx = if fits {
    let three = 3_u64;
    give three;
  } else {
    let fifty = 50_u64;
    give fifty;
  }
  let out = 0_u8;
  let k = 0_u64;
  loop @scan {
    let done = ige(k, 2_u64);
    if done {
      break @scan;
    }
    set m = 64_u64;
    let again = ige(m, 8_u64);
    if again {
      let byte = deref(data)[idx];
      set out = byte;
    }
    set k = k +wrap 1_u64;
  }
  return out;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(4_u64, 7_u8);
  region 'r {
    let b = broken_loop<'r>(data: &'r input, small: 0_u64);
  }
  return exit_status(code: 0_u8);
}
