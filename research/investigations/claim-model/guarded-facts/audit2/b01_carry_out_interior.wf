fn broken['d](data: &'d buffer<u8>, f0: own Bool, g: own Bool) -> result: own u8 reads(data) contract {
  define room = len(deref(data));
  requires ige(room, 4_u64);
} {
  doc "r09 with the else arm's write to f made unambiguously INTERIOR: two further statements and their own edges follow it, so `set f = yes;` is not an event of the edge that reaches the continuation. Under the literal reading of round 2's [ENT-5.G3](d) -- `put through every reaching edge's kill events` -- the else arm-exit edge carries only scope-exit kills for `yes` and `pad`, none of which touch support(+f), so the singly-present entry [+f, +g] IS carried and index 50 of a 4-byte buffer is read. Under the intended reading -- every kill event on any path to that edge -- it is not carried and the program stays a rejection. Two readings, two accepted sets, one of them unsound.";
  let f = f0;
  let x = 50_u64;
  let spare = 0_u64;
  if f {
    if g {
      set x = 3_u64;
    }
  } else {
    let yes = True();
    set f = yes;
    let pad = 1_u64;
    set spare = spare +wrap pad;
  }
  let out = 0_u8;
  if f {
    if g {
      let b = deref(data)[x];
      set out = b;
    }
  }
  return out;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(4_u64, 7_u8);
  let no = False();
  let yes = True();
  region 'r {
    let b = broken<'r>(data: &'r input, f0: no, g: yes);
  }
  return exit_status(code: 0_u8);
}
