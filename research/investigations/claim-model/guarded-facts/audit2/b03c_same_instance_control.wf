struct Head {
  flag: Bool;
  at: u64;
}

fn needs_flag(f: own Bool, v: own u64) -> result: own u64 pure contract {
  requires f;
} {
  return v;
}

fn drive(h1: own Head, h2: own Head) -> result: own u64 reads(h1.flag) {
  doc "The positive control for b03: the identical two-instance program with the test on h1 itself. ACCEPT means the two-instance shape is not itself the obstacle, so b03 REJECT isolates instance identity.";
  let out = 0_u64;
  if h1.flag {
    let r = needs_flag(f: h1.flag, v: 5_u64);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  let t = True();
  let f = False();
  let a = Head(flag: f, at: 50_u64);
  let b = Head(flag: t, at: 0_u64);
  let r = drive(h1: move a, h2: move b);
  return exit_status(code: 0_u8);
}
