struct Head {
  flag: Bool;
  seen: u64;
}

fn bump['m](h: &uniq 'm Head) -> result: own u64 reads(h.seen), writes(h.seen) {
  let s = deref(h).seen;
  set deref(h).seen = s +wrap 1_u64;
  return s;
}

fn needs_flag(f: own Bool, v: own u64) -> result: own u64 pure contract {
  requires f;
} {
  return v;
}

fn drive(h: own Head) -> result: own u64 reads(h.flag, h.seen), writes(h.seen) {
  doc "ALIASING THROUGH A BORROWED STRUCT, goal half. DRAFT 3.3.2 and 6.1 assert that a callee taking &uniq of the WHOLE struct and declaring writes(h.seen) kills no entry keyed on the signed goal +h.flag, and admit the claim is unprobed because the entry form needs P-S5B. It is probeable without P-S5B: S1 publishes +h.flag at the then entry, the borrow and the call intervene, and needs_flag's requires consumes the goal. ACCEPT means the goal survives the whole-struct &uniq borrow and the sibling-field write, which is exactly the transport flagship B's key needs across bump at a05 line 44.";
  let out = 0_u64;
  if h.flag {
    region 'm {
      let s = bump<'m>(h: &uniq 'm h);
    }
    let r = needs_flag(f: h.flag, v: 5_u64);
    set out = r;
  }
  return out;
}

command fn main() -> status: own ExitStatus pure {
  let t = True();
  let head = Head(flag: t, seen: 0_u64);
  let a = drive(h: move head);
  return exit_status(code: 0_u8);
}
