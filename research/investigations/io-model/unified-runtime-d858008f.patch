+#include <stdlib.h>
+#include <stdalign.h>
+static unsigned attempts, grants, releases;
+static alignas(16) unsigned char frame[512];
+static void (*callback)(void *);
+static int joined;
+static void require(int value) { if (!value) abort(); }
