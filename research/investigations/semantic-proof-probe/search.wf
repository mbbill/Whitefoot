fn scan_range(input: own Slice<u8>, needle: own u8, lo: own u64, hi: own u64) -> result: own u64 reads(input) contract {
  requires lo <= hi;
  requires hi <= len_of(input);
  ensures result >= lo;
  ensures result <= hi;
} {
  for (i in lo..hi) {
    let byte = input[i];
    if byte == needle {
      return i;
    }
  }
  return hi;
}

fn find_split(input: own Slice<u8>, needle: own u8, split: own u64) -> result: own u64 reads(input) contract {
  requires split <= len_of(input);
  ensures result <= len_of(input);
} {
  let size = len_of(input);
  let left = scan_range(input: input, needle: needle, lo: 0_u64, hi: split);
  if left < split {
    return left;
  }
  let right = scan_range(input: input, needle: needle, lo: split, hi: size);
  return right;
}

fn find_first(input: own Slice<u8>, needle: own u8) -> result: own u64 reads(input) contract {
  ensures result <= len_of(input);
} {
  let size = len_of(input);
  let split = size / 2_u64;
  let found = find_split(input: input, needle: needle, split: split);
  return found;
}

fn satisfies(input: own Slice<u8>, needle: own u8, lo: own u64, hi: own u64, found: own u64) -> result: own Bool reads(input) contract {
  requires lo <= hi;
  requires hi <= len_of(input);
} {
  if found < lo {
    return False();
  }
  if found > hi {
    return False();
  }
  if found < hi {
    let at = input[found];
    if at != needle {
      return False();
    }
  }
  for (before in lo..found) {
    let byte = input[before];
    if byte == needle {
      return False();
    }
  }
  return True();
}

command fn main() -> status: own ExitStatus pure {
  for (size in 0_u64..9_u64) {
    for (pattern in 0_u64..256_u64) {
      let bytes = fixed_vector::<u8, 8>();
      let remaining = pattern;
      for (
        i in 0_u64..size,
        invariant built_lo: len_of(bytes) >= i,
        invariant built_hi: len_of(bytes) <= i,
        invariant spare: room_of(bytes) + i >= 8_u64,
        invariant flat: head_of(bytes) <= 0_u64
      ) {
        let bit = remaining % 2_u64;
        set remaining = remaining / 2_u64;
        let value = 0_u8;
        if bit == 0_u64 {
        } else {
          set value = 255_u8;
        }
        set bytes = place_back(vector: move bytes, value: value);
      }
      region {
        let input = slice_of(&bytes);
        let length = len_of(input);
        let past_length = length + 1_u64;
        for (kind in 0_u64..3_u64) {
          let needle = 1_u8;
          if kind == 0_u64 {
            set needle = 0_u8;
          }
          if kind == 1_u64 {
            set needle = 255_u8;
          }
          let top = find_first(input: input, needle: needle);
          let top_ok = satisfies(input: input, needle: needle, lo: 0_u64, hi: length, found: top);
          if top_ok {
          } else {
            return exit_status(code: 1_u8);
          }
          for (split in 0_u64..past_length) {
            let composed = find_split(input: input, needle: needle, split: split);
            let composed_ok = satisfies(input: input, needle: needle, lo: 0_u64, hi: length, found: composed);
            if composed_ok {
            } else {
              return exit_status(code: 2_u8);
            }
          }
          for (hi in 0_u64..past_length) {
            let past_hi = hi + 1_u64;
            for (lo in 0_u64..past_hi) {
              let scanned = scan_range(input: input, needle: needle, lo: lo, hi: hi);
              let range_ok = satisfies(input: input, needle: needle, lo: lo, hi: hi, found: scanned);
              if range_ok {
              } else {
                return exit_status(code: 3_u8);
              }
            }
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
