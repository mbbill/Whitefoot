alias Job = app::data::Job;

const capacity: u64 = 4_u64;

nocopy struct Queue: drop;

observe fn len(queue: &Queue) -> result: own u64 reads(queue) contract {
  ensures result <= capacity;
};

fn new() -> made: own Queue pure contract {
  ensures len(queue: &made) == 0_u64;
};

fn push(queue: &Queue, job: own Job) -> result: own unit writes(queue) contract {
  requires len(queue: queue) < capacity;
  ensures len(queue: queue) == len(queue: entry(queue)) + 1_u64;
};

fn pop(queue: &Queue) -> job: own Job writes(queue) contract {
  requires len(queue: queue) > 0_u64;
  ensures len(queue: queue) + 1_u64 == len(queue: entry(queue));
};
