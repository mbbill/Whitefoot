alias Work = pkg::data::Job;

fn new() -> made: own Queue pure contract {
  ensures made.storage.len == 0_u64;
} {
  let storage = new_storage();
  let built = Queue(storage: move storage);
  return move built;
}

fn push(queue: &Queue, job: own Work) -> result: own unit writes(queue.storage) contract {
  requires deref(queue).storage.len < capacity;
  ensures deref(queue).storage.len == deref(entry(queue)).storage.len + 1_u64;
} {
  place_back(window: &deref(queue).storage, value: job);
  return unit;
}

fn pop(queue: &Queue) -> job: own Work writes(queue.storage) contract {
  requires deref(queue).storage.len > 0_u64;
  ensures deref(queue).storage.len + 1_u64 == deref(entry(queue)).storage.len;
} {
  let taken = take_front(window: &deref(queue).storage);
  return taken;
}
