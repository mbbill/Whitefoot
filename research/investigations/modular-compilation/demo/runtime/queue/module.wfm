alias Job = pkg::data::Job;

public const capacity: u64 = 4_u64;

public nocopy struct Queue {
  storage: Ring<Job, capacity>;
}

public fn len(queue: &Queue) -> result: own u64 reads(queue.storage.len) contract {
  ensures result == deref(queue).storage.len;
  ensures result <= capacity;
};

public fn new() -> made: own Queue pure contract {
  ensures made.storage.len == 0_u64;
};

public fn push(queue: &Queue, job: own Job) -> result: own unit writes(queue.storage) contract {
  requires deref(queue).storage.len < capacity;
  ensures deref(queue).storage.len == deref(entry(queue)).storage.len + 1_u64;
};

public fn pop(queue: &Queue) -> job: own Job writes(queue.storage) contract {
  requires deref(queue).storage.len > 0_u64;
  ensures deref(queue).storage.len + 1_u64 == deref(entry(queue)).storage.len;
};
