crate::data: [];
crate::runtime::queue: [crate::data];
crate::runtime: [crate::data, crate::runtime::queue];
crate::kernel: [crate::data, crate::runtime::queue, crate::runtime];
crate::tools::inspect: [crate::data, crate::runtime::queue, crate::runtime];

target kernel {
  entry crate::kernel::start;
  no_heap;
}

target inspect {
  entry crate::tools::inspect::run;
}
