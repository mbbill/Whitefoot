fn low_byte(value: u32) -> result: u8 pure {
  let masked = iand(value, 255_u32);
  match cvt::<u32, u8>(masked) {
    Ok(value: byte) => {
      return byte;
    }
    Err(error: refused) => {
      return 0_u8;
    }
  }
}

fn signed_low_byte(value: i32) -> result: i8 pure {
  let bits = reinterpret::<i32, u32>(value);
  let byte = low_byte(value: bits);
  return reinterpret::<u8, i8>(byte);
}

fn bounded_byte(value: u32) -> result: u8 pure contract {
  requires value <= 255_u32;
} {
  match cvt::<u32, u8>(value) {
    Ok(value: byte) => {
      return byte;
    }
    Err(error: refused) => {
      return 0_u8;
    }
  }
}

fn exact_byte(value: u32) -> result: Result<u8, NarrowError> pure {
  return cvt::<u32, u8>(value);
}

fn saturating_byte(value: i32) -> result: u8 pure {
  let nonnegative = imax(value, 0_i32);
  let bounded = imin(nonnegative, 255_i32);
  match cvt::<i32, u8>(bounded) {
    Ok(value: byte) => {
      return byte;
    }
    Err(error: refused) => {
      return 0_u8;
    }
  }
}

fn bit_resign(value: i32) -> result: u32 pure {
  return reinterpret::<i32, u32>(value);
}

fn value_resign(value: i32) -> result: Result<u32, NarrowError> pure {
  return cvt::<i32, u32>(value);
}

fn wide_unsigned(value: u32) -> result: u64 pure {
  return cvt::<u32, u64>(value);
}

fn exact_float(value: u32) -> result: Result<f32, NarrowError> pure {
  return cvt::<u32, f32>(value);
}

fn exact_small_float(value: u16) -> result: f32 pure {
  return cvt::<u16, f32>(value);
}

fn exact_small_double(value: u32) -> result: f64 pure {
  return cvt::<u32, f64>(value);
}

fn exact_integer(value: f64) -> result: Result<i32, NarrowError> pure {
  return cvt::<f64, i32>(value);
}

fn truncated_integer(value: f64) -> result: Result<i32, NarrowError> pure {
  let integral = ftrunc(value);
  return cvt::<f64, i32>(integral);
}

fn rounded_integer(value: f64) -> result: Result<i32, NarrowError> pure {
  let integral = froundeven(value);
  return cvt::<f64, i32>(integral);
}

fn saturating_integer(value: f64) -> result: i32 pure {
  if fne(value, value) {
    return 0_i32;
  }
  let low = fmax(value, -2147483648.0_f64);
  let bounded = fmin(low, 2147483647.0_f64);
  let integral = ftrunc(bounded);
  match cvt::<f64, i32>(integral) {
    Ok(value: integer) => {
      return integer;
    }
    Err(error: refused) => {
      return 0_i32;
    }
  }
}

fn narrow_float(value: f64) -> result: Result<f32, NarrowError> pure {
  return cvt::<f64, f32>(value);
}

fn saturating_wide_integer(value: f64) -> result: i64 pure {
  if fne(value, value) {
    return 0_i64;
  }
  let upper_exclusive = reinterpret::<u64, f64>(4890909195324358656_u64);
  if fge(value, upper_exclusive) {
    return 9223372036854775807_i64;
  }
  let lower = fneg(upper_exclusive);
  if fle(value, lower) {
    return -9223372036854775808_i64;
  }
  let integral = ftrunc(value);
  match cvt::<f64, i64>(integral) {
    Ok(value: integer) => {
      return integer;
    }
    Err(error: refused) => {
      return 0_i64;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Conversion boundary probes. The unreachable integer fallback arms make the current total wrappers writable; they are not a proof-required conversion interface. Float saturation explicitly selects NaN-to-zero policy.";
  let byte = low_byte(value: 305419896_u32);
  if byte == 120_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let signed = signed_low_byte(value: -129_i32);
  if signed == 127_i8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let bounded = bounded_byte(value: 255_u32);
  if bounded == 255_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  match exact_byte(value: 256_u32) {
    Ok(value: unexpected_byte) => {
      return exit_status(code: 4_u8);
    }
    Err(error: refused) => {
    }
  }
  let low = saturating_byte(value: -1_i32);
  let high = saturating_byte(value: 256_i32);
  if low == 0_u8 {
  } else {
    return exit_status(code: 5_u8);
  }
  if high == 255_u8 {
  } else {
    return exit_status(code: 6_u8);
  }
  let bits = bit_resign(value: -1_i32);
  if bits == 4294967295_u32 {
  } else {
    return exit_status(code: 7_u8);
  }
  match value_resign(value: -1_i32) {
    Ok(value: word) => {
      return exit_status(code: 8_u8);
    }
    Err(error: refused) => {
    }
  }
  let wide = wide_unsigned(value: 4294967295_u32);
  if wide == 4294967295_u64 {
  } else {
    return exit_status(code: 9_u8);
  }
  match exact_float(value: 16777216_u32) {
    Ok(value: number) => {
      let expected_float = reinterpret::<u32, f32>(1266679808_u32);
      if feq(number, expected_float) {
      } else {
        return exit_status(code: 10_u8);
      }
    }
    Err(error: refused) => {
      return exit_status(code: 11_u8);
    }
  }
  match exact_float(value: 16777217_u32) {
    Ok(value: number) => {
      return exit_status(code: 12_u8);
    }
    Err(error: refused) => {
    }
  }
  match exact_integer(value: 1.75_f64) {
    Ok(value: integer) => {
      return exit_status(code: 13_u8);
    }
    Err(error: refused) => {
    }
  }
  match truncated_integer(value: -1.75_f64) {
    Ok(value: integer) => {
      if integer == -1_i32 {
      } else {
        return exit_status(code: 14_u8);
      }
    }
    Err(error: refused) => {
      return exit_status(code: 15_u8);
    }
  }
  match rounded_integer(value: 2.5_f64) {
    Ok(value: integer) => {
      if integer == 2_i32 {
      } else {
        return exit_status(code: 16_u8);
      }
    }
    Err(error: refused) => {
      return exit_status(code: 17_u8);
    }
  }
  let infinity = finf::<f64>();
  match truncated_integer(value: infinity) {
    Ok(value: integer) => {
      return exit_status(code: 18_u8);
    }
    Err(error: refused) => {
    }
  }
  let nan = fnan::<f64>();
  let nan_integer = saturating_integer(value: nan);
  let max_integer = saturating_integer(value: infinity);
  if nan_integer == 0_i32 {
  } else {
    return exit_status(code: 19_u8);
  }
  if max_integer == 2147483647_i32 {
  } else {
    return exit_status(code: 20_u8);
  }
  match narrow_float(value: 1.5_f64) {
    Ok(value: number) => {
      if feq(number, 1.5_f32) {
      } else {
        return exit_status(code: 21_u8);
      }
    }
    Err(error: refused) => {
      return exit_status(code: 22_u8);
    }
  }
  match narrow_float(value: 1.1_f64) {
    Ok(value: number) => {
      return exit_status(code: 23_u8);
    }
    Err(error: refused) => {
    }
  }
  match narrow_float(value: -0.0_f64) {
    Ok(value: number) => {
      let zero_bits = reinterpret::<f32, u32>(number);
      if zero_bits == 2147483648_u32 {
      } else {
        return exit_status(code: 24_u8);
      }
    }
    Err(error: refused) => {
      return exit_status(code: 25_u8);
    }
  }
  match narrow_float(value: nan) {
    Ok(value: number) => {
      let nan_bits = reinterpret::<f32, u32>(number);
      if nan_bits == 2143289344_u32 {
      } else {
        return exit_status(code: 26_u8);
      }
    }
    Err(error: refused) => {
      return exit_status(code: 27_u8);
    }
  }
  let upper_exclusive = reinterpret::<u64, f64>(4890909195324358656_u64);
  let wide_max = saturating_wide_integer(value: upper_exclusive);
  if wide_max == 9223372036854775807_i64 {
  } else {
    return exit_status(code: 28_u8);
  }
  let below_upper = reinterpret::<u64, f64>(4890909195324358655_u64);
  let wide_below = saturating_wide_integer(value: below_upper);
  if wide_below == 9223372036854774784_i64 {
  } else {
    return exit_status(code: 29_u8);
  }
  let negative_infinity = fneg(infinity);
  let wide_min = saturating_wide_integer(value: negative_infinity);
  if wide_min == -9223372036854775808_i64 {
  } else {
    return exit_status(code: 30_u8);
  }
  let wide_nan = saturating_wide_integer(value: nan);
  if wide_nan == 0_i64 {
  } else {
    return exit_status(code: 31_u8);
  }
  return exit_status(code: 0_u8);
}
