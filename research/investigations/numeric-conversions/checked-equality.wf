const values: Array<u8, 4> =[11_u8, 22_u8, 33_u8, 44_u8];

fn selected(index: own u64) -> result: own u8 pure contract {
  requires index < 4_u64;
} {
  match cvt::<u64, u8>(index) {
    Ok(value: small) => {
      let restored = cvt::<u8, u64>(small);
      return values[restored];
    }
    Err(error: refused) => {
      return 0_u8;
    }
  }
}

fn main() -> status: own ExitStatus pure {
  let value = selected(index: 0_u64);
  return exit_status(code: value);
}
