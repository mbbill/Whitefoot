fn read_pair(table: own array<u8, 8>, low: own u64, high: own u64) -> own u8 traps {
  doc "O11 probe, D3b conjoined-check shape [obligation-discharge ACCEPTANCE driver 3]: under v0.30 the passed check establishes only the opaque positive conjunction, so neither subscript obligation discharges and this file rejects on OP-4. Under the O11 candidate the check establishes +ilt(low, 8) and +ilt(high, 8) with their projections, and both subscripts discharge.";
  let low_ok = ilt(low, 8_u64);
  let high_ok = ilt(high, 8_u64);
  let both = band(low_ok, high_ok);
  claim pair_out_of_range: both because "pair out of range";
  let first = table[low];
  let second = table[high];
  return second;
}

fn main() -> own unit traps {
  let table = array_new<u8, 8>(3_u8);
  let value = read_pair(table: move table, low: 1_u64, high: 2_u64);
  return unit;
}
