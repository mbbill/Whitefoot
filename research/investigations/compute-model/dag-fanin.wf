struct TaskCell {
  value: u64;
  evaluations: u64;
}

struct Notice {
  source_bit: u64;
  present: Bool;
  value: u64;
}

fn dag_task(id: u64, steps: u64, seed: u64, predecessor_mix: u64) -> result: u64 pure {
  doc "Every task uses the same serial recurrence. Each iteration consumes its preceding state, so its work cannot become an independent iteration map or an associative accumulator fold.";
  let initial = seed +wrap id;
  let state = ixor(initial, predecessor_mix);
  for (iteration in 0_u64..steps) {
    let rotated = irotl(state, 13_u32);
    let multiplied = rotated *wrap 6364136223846793005_u64;
    let advanced = multiplied +wrap 1442695040888963407_u64;
    set state = ixor(advanced, iteration);
  }
  return state;
}

fn evaluate(output: &[TaskCell], id: u64, steps: u64, seed: u64, predecessor_mix: u64) -> result: u64 writes(output) contract {
  requires 1_u64 <= deref(output).len;
} {
  let value = dag_task(id: id, steps: steps, seed: seed, predecessor_mix: predecessor_mix);
  let previous = deref(output)[0_u64].evaluations;
  set deref(output)[0_u64].value = value;
  set deref(output)[0_u64].evaluations = previous +wrap 1_u64;
  return value;
}

fn evaluate_join(output: &[TaskCell], steps: u64, seed: u64, a: u64, b: u64) -> result: u64 writes(output) contract {
  requires 1_u64 <= deref(output).len;
} {
  let shifted = irotl(a, 7_u32);
  let mixed = ixor(shifted, b);
  return evaluate(output: output, id: 2_u64, steps: steps, seed: seed, predecessor_mix: mixed);
}

fn spine_suffix(costs: &[u64], output: &[TaskCell], first_id: u64, seed: u64, predecessor_mix: u64) -> result: unit reads(costs), writes(output) contract {
  requires deref(costs).len == deref(output).len;
} {
  let count = deref(output).len;
  if count < 2_u64 {
    return unit;
  }
  let spine_cost = deref(costs)[0_u64];
  let leaf_cost = deref(costs)[1_u64];
  let spine_head = &deref(output)[0_u64..1_u64];
  let value = evaluate(output: spine_head, id: first_id, steps: spine_cost, seed: seed, predecessor_mix: predecessor_mix);
  let leaf_id = first_id +wrap 1_u64;
  let next_id = first_id +wrap 2_u64;
  let leaf_head = &deref(output)[1_u64..2_u64];
  let tail_costs = &deref(costs)[2_u64..count];
  let tail_output = &deref(output)[2_u64..count];
  let leaf = evaluate(output: leaf_head, id: leaf_id, steps: leaf_cost, seed: seed, predecessor_mix: value);
  let tail = spine_suffix(costs: tail_costs, output: tail_output, first_id: next_id, seed: seed, predecessor_mix: value);
  return unit;
}

fn dag_spine(count: u64, costs: &[u64], output: &[TaskCell], seed: u64) -> result: unit reads(costs), writes(output) contract {
  requires count <= 9223372036854775807_u64;
  requires 2_u64 * count <= deref(costs).len;
  requires 2_u64 * count <= deref(output).len;
} {
  doc "Task IDs alternate spine 2*i and leaf 2*i+1. Each suffix owns its output range; every leaf remains independent of later spine and leaf tasks.";
  let size = count * 2_u64;
  let selected_costs = &deref(costs)[0_u64..size];
  let selected_output = &deref(output)[0_u64..size];
  return spine_suffix(costs: selected_costs, output: selected_output, first_id: 0_u64, seed: seed, predecessor_mix: 0_u64);
}

fn notify_source(output: &[TaskCell], notices: &[Notice], id: u64, source_bit: u64, destinations: u64, steps: u64, seed: u64) -> result: unit writes(output), writes(notices) contract {
  requires 1_u64 <= deref(output).len;
  requires 2_u64 <= deref(notices).len;
} {
  let value = evaluate(output: output, id: id, steps: steps, seed: seed, predecessor_mix: 0_u64);
  let first_bit = iand(destinations, 1_u64);
  let second_bit = iand(destinations, 2_u64);
  let first_present = first_bit != 0_u64;
  let second_present = second_bit != 0_u64;
  set deref(notices)[0_u64] = Notice(source_bit: source_bit, present: first_present, value: value);
  set deref(notices)[1_u64] = Notice(source_bit: source_bit, present: second_present, value: value);
  return unit;
}

fn receive_owner(notices: &[Notice], output: &[TaskCell], receipts: &[u64], first: u64, second: u64, id: u64, steps: u64, seed: u64) -> result: unit reads(notices), writes(output), writes(receipts) contract {
  requires first < deref(notices).len;
  requires second < deref(notices).len;
  requires 1_u64 <= deref(output).len;
  requires 2_u64 <= deref(receipts).len;
} {
  doc "Each owner inspects exactly two source-private notices in source-ID order and changes only its own receipt and task cells.";
  let mixed = 0_u64;
  let received_mask = 0_u64;
  let received_count = 0_u64;
  let from_a = deref(notices)[first];
  let from_b = deref(notices)[second];
  if from_a.present {
    let shifted = irotl(mixed, 7_u32);
    set mixed = ixor(shifted, from_a.value);
    set received_mask = ior(received_mask, from_a.source_bit);
    set received_count = received_count +wrap 1_u64;
  }
  if from_b.present {
    let shifted = irotl(mixed, 7_u32);
    set mixed = ixor(shifted, from_b.value);
    set received_mask = ior(received_mask, from_b.source_bit);
    set received_count = received_count +wrap 1_u64;
  }
  set deref(receipts)[0_u64] = received_mask;
  set deref(receipts)[1_u64] = received_count;
  let value = evaluate(output: output, id: id, steps: steps, seed: seed, predecessor_mix: mixed);
  return unit;
}

fn dag_notify(mask: u64, costs: &[u64], output: &[TaskCell], receipts: &[u64], seed: u64) -> result: unit reads(costs), writes(output), writes(receipts) contract {
  requires mask < 16_u64;
  requires 4_u64 <= deref(costs).len;
  requires 4_u64 <= deref(output).len;
  requires 4_u64 <= deref(receipts).len;
} {
  doc "Mask bits are A-to-C, A-to-D, B-to-C and B-to-D. All four notice slots are initialized, written and inspected, including absent edges.";
  let absent = False();
  let empty = Notice(source_bit: 0_u64, present: absent, value: 0_u64);
  let notices = array_filled::<Notice, 4>(value: empty);
  let a = &deref(output)[0_u64..1_u64];
  let b = &deref(output)[1_u64..2_u64];
  let c = &deref(output)[2_u64..3_u64];
  let d = &deref(output)[3_u64..4_u64];
  let a_notices = &notices[0_u64..2_u64];
  let b_notices = &notices[2_u64..4_u64];
  let all_notices = &notices[0_u64..4_u64];
  let c_receipts = &deref(receipts)[0_u64..2_u64];
  let d_receipts = &deref(receipts)[2_u64..4_u64];
  let a_cost = deref(costs)[0_u64];
  let b_cost = deref(costs)[1_u64];
  let c_cost = deref(costs)[2_u64];
  let d_cost = deref(costs)[3_u64];
  let a_mask = iand(mask, 3_u64);
  let b_mask = mask / 4_u64;
  let sent_a = notify_source(output: a, notices: a_notices, id: 0_u64, source_bit: 1_u64, destinations: a_mask, steps: a_cost, seed: seed);
  let sent_b = notify_source(output: b, notices: b_notices, id: 1_u64, source_bit: 2_u64, destinations: b_mask, steps: b_cost, seed: seed);
  let received_c = receive_owner(notices: all_notices, output: c, receipts: c_receipts, first: 0_u64, second: 2_u64, id: 2_u64, steps: c_cost, seed: seed);
  let received_d = receive_owner(notices: all_notices, output: d, receipts: d_receipts, first: 1_u64, second: 3_u64, id: 3_u64, steps: d_cost, seed: seed);
  return unit;
}

fn run_ac(a_output: &[TaskCell], c_output: &[TaskCell], a_cost: u64, c_cost: u64, seed: u64, b: u64) -> result: unit writes(a_output), writes(c_output) contract {
  requires 1_u64 <= deref(a_output).len;
  requires 1_u64 <= deref(c_output).len;
} {
  let a = evaluate(output: a_output, id: 0_u64, steps: a_cost, seed: seed, predecessor_mix: 0_u64);
  let c = evaluate_join(output: c_output, steps: c_cost, seed: seed, a: a, b: b);
  return unit;
}

fn run_bd(b_output: &[TaskCell], d_output: &[TaskCell], b_cost: u64, d_cost: u64, seed: u64) -> result: u64 writes(b_output), writes(d_output) contract {
  requires 1_u64 <= deref(b_output).len;
  requires 1_u64 <= deref(d_output).len;
} {
  let b = evaluate(output: b_output, id: 1_u64, steps: b_cost, seed: seed, predecessor_mix: 0_u64);
  let d = evaluate(output: d_output, id: 3_u64, steps: d_cost, seed: seed, predecessor_mix: b);
  return b;
}

fn dag_n(mode: u64, costs: &[u64], output: &[TaskCell], seed: u64) -> result: unit reads(costs), writes(output) contract {
  requires mode < 4_u64;
  requires 4_u64 <= deref(costs).len;
  requires 4_u64 <= deref(output).len;
} {
  doc "All modes evaluate A-to-C, B-to-C and B-to-D exactly once. Modes zero to two expose three structured extensions; mode three is the diagnostic B,A,D,C order.";
  let a_output = &deref(output)[0_u64..1_u64];
  let b_output = &deref(output)[1_u64..2_u64];
  let c_output = &deref(output)[2_u64..3_u64];
  let d_output = &deref(output)[3_u64..4_u64];
  let a_cost = deref(costs)[0_u64];
  let b_cost = deref(costs)[1_u64];
  let c_cost = deref(costs)[2_u64];
  let d_cost = deref(costs)[3_u64];
  if mode == 0_u64 {
    let a = evaluate(output: a_output, id: 0_u64, steps: a_cost, seed: seed, predecessor_mix: 0_u64);
    let b = evaluate(output: b_output, id: 1_u64, steps: b_cost, seed: seed, predecessor_mix: 0_u64);
    let c = evaluate_join(output: c_output, steps: c_cost, seed: seed, a: a, b: b);
    let d = evaluate(output: d_output, id: 3_u64, steps: d_cost, seed: seed, predecessor_mix: b);
    return unit;
  }
  if mode == 1_u64 {
    let b = evaluate(output: b_output, id: 1_u64, steps: b_cost, seed: seed, predecessor_mix: 0_u64);
    let ac = run_ac(a_output: a_output, c_output: c_output, a_cost: a_cost, c_cost: c_cost, seed: seed, b: b);
    let d = evaluate(output: d_output, id: 3_u64, steps: d_cost, seed: seed, predecessor_mix: b);
    return unit;
  }
  if mode == 2_u64 {
    let a = evaluate(output: a_output, id: 0_u64, steps: a_cost, seed: seed, predecessor_mix: 0_u64);
    let b = run_bd(b_output: b_output, d_output: d_output, b_cost: b_cost, d_cost: d_cost, seed: seed);
    let c = evaluate_join(output: c_output, steps: c_cost, seed: seed, a: a, b: b);
    return unit;
  }
  let b = evaluate(output: b_output, id: 1_u64, steps: b_cost, seed: seed, predecessor_mix: 0_u64);
  let a = evaluate(output: a_output, id: 0_u64, steps: a_cost, seed: seed, predecessor_mix: 0_u64);
  let d = evaluate(output: d_output, id: 3_u64, steps: d_cost, seed: seed, predecessor_mix: b);
  let c = evaluate_join(output: c_output, steps: c_cost, seed: seed, a: a, b: b);
  return unit;
}

fn phased_leaf(pair: &[TaskCell], id: u64, steps: u64, seed: u64) -> result: unit writes(pair) contract {
  requires 2_u64 <= deref(pair).len;
} {
  doc "A leaf reads its completed spine value and writes its own cell within one iteration's two-cell range.";
  let predecessor_mix = deref(pair)[0_u64].value;
  let output = &deref(pair)[1_u64..2_u64];
  let value = evaluate(output: output, id: id, steps: steps, seed: seed, predecessor_mix: predecessor_mix);
  return unit;
}

fn dag_spine_phased(count: u64, costs: &[u64], output: &[TaskCell], seed: u64) -> result: unit reads(costs), writes(output) contract {
  requires count <= 9223372036854775807_u64;
  requires 2_u64 * count <= deref(costs).len;
  requires 2_u64 * count <= deref(output).len;
} {
  doc "Completes the serial spine before mapping leaves. Each leaf receives its full adjacent spine-and-leaf pair, preserving canonical interleaved task IDs without a copied spine buffer.";
  let predecessor_mix = 0_u64;
  for (i in 0_u64..count) {
    let id = i * 2_u64;
    let end = id + 1_u64;
    invariant cost_room: end <= deref(costs).len {
      use 2 times (i + 1_u64 <= count);
      use (2_u64 * count <= deref(costs).len);
    }
    invariant output_room: end <= deref(output).len {
      use 2 times (i + 1_u64 <= count);
      use (2_u64 * count <= deref(output).len);
    }
    let steps = deref(costs)[id];
    let spine_output = &deref(output)[id..end];
    let value = evaluate(output: spine_output, id: id, steps: steps, seed: seed, predecessor_mix: predecessor_mix);
    set predecessor_mix = value;
  }
  for (i in 0_u64..count) {
    let start = i * 2_u64;
    let end = start + 2_u64;
    let id = start + 1_u64;
    invariant cost_room: end <= deref(costs).len {
      use 2 times (i + 1_u64 <= count);
      use (2_u64 * count <= deref(costs).len);
    }
    invariant output_room: end <= deref(output).len {
      use 2 times (i + 1_u64 <= count);
      use (2_u64 * count <= deref(output).len);
    }
    let steps = deref(costs)[id];
    let pair = &deref(output)[start..end];
    let leaf = phased_leaf(pair: pair, id: id, steps: steps, seed: seed);
  }
  return unit;
}

fn dag_spine_phased_scalar(count: u64, leaf_steps: u64, output: &[TaskCell], seed: u64) -> result: unit writes(output) contract {
  requires count <= 9223372036854775807_u64;
  requires 2_u64 * count <= deref(output).len;
} {
  doc "Uses one recurrence step per spine task and a common captured bound for leaf work, retaining the same two phases and canonical output pairs as the uniform-cost phased spine.";
  let predecessor_mix = 0_u64;
  for (i in 0_u64..count) {
    let id = i * 2_u64;
    let end = id + 1_u64;
    invariant output_room: end <= deref(output).len {
      use 2 times (i + 1_u64 <= count);
      use (2_u64 * count <= deref(output).len);
    }
    let spine_output = &deref(output)[id..end];
    let value = evaluate(output: spine_output, id: id, steps: 1_u64, seed: seed, predecessor_mix: predecessor_mix);
    set predecessor_mix = value;
  }
  for (i in 0_u64..count) {
    let start = i * 2_u64;
    let end = start + 2_u64;
    let id = start + 1_u64;
    invariant output_room: end <= deref(output).len {
      use 2 times (i + 1_u64 <= count);
      use (2_u64 * count <= deref(output).len);
    }
    let pair = &deref(output)[start..end];
    let leaf = phased_leaf(pair: pair, id: id, steps: leaf_steps, seed: seed);
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  let empty = TaskCell(value: 0_u64, evaluations: 0_u64);
  let costs = array_filled::<u64, 4>(value: 1_u64);
  let spine_output = array_filled::<TaskCell, 4>(value: empty);
  let notice_output = array_filled::<TaskCell, 4>(value: empty);
  let n_output = array_filled::<TaskCell, 4>(value: empty);
  let receipts = array_filled::<u64, 4>(value: 0_u64);
  let spine = dag_spine(count: 2_u64, costs: &costs[0_u64..4_u64], output: &spine_output[0_u64..4_u64], seed: 17_u64);
  let notifications = dag_notify(mask: 15_u64, costs: &costs[0_u64..4_u64], output: &notice_output[0_u64..4_u64], receipts: &receipts[0_u64..4_u64], seed: 17_u64);
  let n = dag_n(mode: 0_u64, costs: &costs[0_u64..4_u64], output: &n_output[0_u64..4_u64], seed: 17_u64);
  let phased = dag_spine_phased(count: 2_u64, costs: &costs[0_u64..4_u64], output: &spine_output[0_u64..4_u64], seed: 17_u64);
  let scalar = dag_spine_phased_scalar(count: 2_u64, leaf_steps: 1_u64, output: &spine_output[0_u64..4_u64], seed: 17_u64);
  return exit_status(code: 0_u8);
}
