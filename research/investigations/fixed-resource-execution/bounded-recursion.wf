program no_heap;

const bytes: Array<u8, 32> =[0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8, 9_u8, 10_u8, 11_u8, 12_u8, 13_u8, 14_u8, 15_u8, 16_u8, 17_u8, 18_u8, 19_u8, 20_u8, 21_u8, 22_u8, 23_u8, 24_u8, 25_u8, 26_u8, 27_u8, 28_u8, 29_u8, 30_u8, 31_u8];

fn fold_hash(data: &[u8], remaining: own u64) -> result: own u64 reads(data) contract {
  requires remaining <= deref(data).len;
  requires remaining <= 32_u64;
} {
  if remaining == 0_u64 {
    return 0_u64;
  }
  let next = remaining - 1_u64;
  let child = fold_hash(data: data, remaining: next);
  let rotated = irotl(child, 5_u32);
  let byte = deref(data)[next];
  let wide = cvt::<u8, u64>(byte);
  return rotated +wrap wide;
}

fn main() -> status: own ExitStatus pure {
  let data = &bytes[0_u64..32_u64];
  for (length in 0_u64..33_u64) {
    let actual = fold_hash(data: data, remaining: length);
    let expected = 0_u64;
    for (index in 0_u64..length) {
      let rotated = irotl(expected, 5_u32);
      let byte = bytes[index];
      let wide = cvt::<u8, u64>(byte);
      set expected = rotated +wrap wide;
    }
    if actual == expected {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
