fn low_bits_entry(value: u64, count: u32) -> result: u64 pure contract {
  requires count <= 5_u32;
} {
  let table = array_filled::<u64, 32>(value: 0_u64);
  let high = ishl.wrap(1_u64, count);
  let mask = high - 1_u64;
  let bits = iand(value, mask);
  let entry = table[bits];
  return entry;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
