contract Order<T: linear, E: linear> {
  fn compare(env: &E, left: &T, right: &T) -> order: own i32 effects;
}

struct Item {
  rank: u64;
}

struct Ascending {
}

fn ascending_compare(env: &Ascending, left: &Item, right: &Item) -> order: own i32 reads(left.rank, right.rank) contract {
  ensures order >= -1_i32;
  ensures order <= 1_i32;
} {
  if deref(left).rank < deref(right).rank {
    return -1_i32;
  }
  if deref(left).rank > deref(right).rank {
    return 1_i32;
  }
  return 0_i32;
}

conform Ascending : Order<Item, Ascending> {
  compare = ascending_compare;
}

fn exchange_at<T: linear>(heap: &uniq FixedVector<T, 16>, left: own u64, right: own u64) -> result: own unit reads(heap), writes(heap) contract {
  requires left < len_of(deref(heap));
  requires right < len_of(deref(heap));
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == len_of(deref(entry(heap)));
  ensures head_of(deref(heap)) <= 0_u64;
} {
  doc "Single-place exchanges preserve an owner without LIV-2 dynamic-index read-out. The three-exchange path costs extra element transfers; it is not a native-performance claim.";
  if left == right {
    return unit;
  }
  region {
    let tail = take_back(vector: &uniq deref(heap));
    let end = len_of(deref(heap));
    if left == end {
      let previous = replace deref(heap)[right] = move tail;
      place_back(vector: &uniq deref(heap), value: move previous);
      return unit;
    }
    if right == end {
      let previous = replace deref(heap)[left] = move tail;
      place_back(vector: &uniq deref(heap), value: move previous);
      return unit;
    }
    let left_value = replace deref(heap)[left] = move tail;
    let right_value = replace deref(heap)[right] = move left_value;
    let saved_tail = replace deref(heap)[left] = move right_value;
    place_back(vector: &uniq deref(heap), value: move saved_tail);
    return unit;
  }
}

fn sift_rise<T: linear, E: linear + Order<T, E>>(heap: &uniq FixedVector<T, 16>, count: own u64, env: &E) -> result: own unit reads(heap), writes(heap), effects(E.compare(env: env, left: heap[], right: heap[])) contract {
  requires len_of(deref(heap)) == count;
  requires count >= 1_u64;
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == count;
  ensures head_of(deref(heap)) <= 0_u64;
} {
  region {
    let at = count - 1_u64;
    loop @rise (
      invariant live: at < count,
      invariant count_low: len_of(deref(heap)) >= count,
      invariant count_high: len_of(deref(heap)) <= count,
      invariant origin: head_of(deref(heap)) <= 0_u64
    ) {
      if at == 0_u64 {
        return unit;
      }
      let before = at - 1_u64;
      let parent = before / 2_u64;
      let order = E.compare(env: env, left: &deref(heap)[parent], right: &deref(heap)[at]);
      if order <= 0_i32 {
        return unit;
      }
      exchange_at::<T>(heap: &uniq deref(heap), left: parent, right: at);
      set at = parent;
    }
    return unit;
  }
}

fn sift_sink<T: linear, E: linear + Order<T, E>>(heap: &uniq FixedVector<T, 16>, count: own u64, env: &E) -> result: own unit reads(heap), writes(heap), effects(E.compare(env: env, left: heap[], right: heap[])) contract {
  requires len_of(deref(heap)) == count;
  requires count >= 1_u64;
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == count;
  ensures head_of(deref(heap)) <= 0_u64;
} {
  region {
    let at = 0_u64;
    loop @sink (
      invariant live: at < count,
      invariant count_low: len_of(deref(heap)) >= count,
      invariant count_high: len_of(deref(heap)) <= count,
      invariant origin: head_of(deref(heap)) <= 0_u64
    ) {
      let doubled = at * 2_u64;
      let left = doubled + 1_u64;
      if left >= count {
        return unit;
      }
      let best = left;
      let right = left + 1_u64;
      if right < count {
        let sibling_order = E.compare(env: env, left: &deref(heap)[right], right: &deref(heap)[left]);
        if sibling_order < 0_i32 {
          set best = right;
        }
      }
      let order = E.compare(env: env, left: &deref(heap)[at], right: &deref(heap)[best]);
      if order <= 0_i32 {
        return unit;
      }
      exchange_at::<T>(heap: &uniq deref(heap), left: at, right: best);
      set at = best;
    }
    return unit;
  }
}

fn push<T: linear, E: linear + Order<T, E>>(heap: &uniq FixedVector<T, 16>, value: own T, env: &E) -> result: own unit reads(heap), writes(heap), effects(E.compare(env: env, left: heap[], right: heap[])), effects(E.compare(env: env, left: value, right: value)), effects(exchange_at::<T>(heap: value, left: unit, right: unit)) contract {
  requires room_of(deref(heap)) >= 1_u64;
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == len_of(deref(entry(heap))) + 1_u64;
  ensures head_of(deref(heap)) <= 0_u64;
} {
  region {
    let entering = len_of(deref(heap));
    let count = entering + 1_u64;
    place_back(vector: &uniq deref(heap), value: move value);
    sift_rise::<T, E>(heap: &uniq deref(heap), count: count, env: env);
    return unit;
  }
}

fn pop<T: linear, E: linear + Order<T, E>>(heap: &uniq FixedVector<T, 16>, env: &E) -> minimum: own T reads(heap), writes(heap), effects(E.compare(env: env, left: heap[], right: heap[])) contract {
  requires len_of(deref(heap)) >= 1_u64;
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == len_of(deref(entry(heap))) - 1_u64;
  ensures head_of(deref(heap)) <= 0_u64;
} {
  region {
    let last = take_back(vector: &uniq deref(heap));
    let count = len_of(deref(heap));
    if count == 0_u64 {
      return move last;
    }
    let minimum = replace deref(heap)[0_u64] = move last;
    sift_sink::<T, E>(heap: &uniq deref(heap), count: count, env: env);
    return move minimum;
  }
}

command fn main() -> status: own ExitStatus pure {
  doc "D6 proposal source, not admitted by v0.56: a non-copy element, an explicit behavior type and environment, and retained ordinary owning storage.";
  let ordering = Ascending();
  let heap = fixed_vector::<Item, 16>();
  let first = Item(rank: 9_u64);
  let second = Item(rank: 2_u64);
  let third = Item(rank: 7_u64);
  region {
    push::<Item, Ascending>(heap: &uniq heap, value: move first, env: &ordering);
    push::<Item, Ascending>(heap: &uniq heap, value: move second, env: &ordering);
    push::<Item, Ascending>(heap: &uniq heap, value: move third, env: &ordering);
    let low = pop::<Item, Ascending>(heap: &uniq heap, env: &ordering);
    let middle = pop::<Item, Ascending>(heap: &uniq heap, env: &ordering);
    let high = pop::<Item, Ascending>(heap: &uniq heap, env: &ordering);
    if low.rank != 2_u64 {
      return exit_status(code: 1_u8);
    }
    if middle.rank != 7_u64 {
      return exit_status(code: 2_u8);
    }
    if high.rank != 9_u64 {
      return exit_status(code: 3_u8);
    }
    return exit_status(code: 0_u8);
  }
}
