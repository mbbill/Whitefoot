fn need(a: own u64, b: own u64) -> ok: own u64 pure contract {
  requires a + b;
} {
  doc "bare arithmetic clause: does it parse?";
  return a;
}

command fn main() -> status: own ExitStatus pure {
  doc "drive";
  let got = need(a: 1_u64, b: 2_u64);
  if got == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
