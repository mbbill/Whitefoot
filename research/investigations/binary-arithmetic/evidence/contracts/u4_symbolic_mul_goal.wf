fn need(n: own u64, m: own u64) -> ok: own u64 pure contract {
  requires n >= m;
} {
  doc "callee requires an ordering between two own integers";
  return n;
}

fn wrapper(k: own u64) -> ok: own u64 pure contract {
  requires k <= 100_u64;
} {
  doc "caller computes a symbolic actual with the exact * row and a literal";
  let s = 2_u64 * k;
  let g = need(n: s, m: k);
  return g;
}

command fn main() -> status: own ExitStatus pure {
  doc "drive";
  let got = wrapper(k: 5_u64);
  if got == 10_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
