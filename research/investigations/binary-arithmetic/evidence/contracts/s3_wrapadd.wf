fn encode(out: &uniq buffer<u8>, src: own buffer<u8>) -> written: own u64 reads(src), writes(out) contract {
  requires len(deref(out)) >= 1_u64;
  define room = len(deref(out));
  define count = len(src);
  define needed = count +wrap 2_u64;
  requires room >= needed;
} {
  doc "probe";
  let count = len(src);
  set deref(out)[0_u64] = 0_u8;
  return count;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "drive";
  let src = buffer_new(4_u64, 65_u8);
  let out = buffer_new(8_u64, 0_u8);
  region {
    let handle = &uniq out;
    let produced = encode(out: move handle, src: move src);
    if produced == 4_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
