fn banded_sum(pixels: &buffer<u8>, width: own u64, band_h: own u64, bands: own u64) -> total: own u64 reads(pixels) contract {
  requires width <= 65536_u64;
  requires band_h <= 64_u64;
  requires bands <= 65536_u64;
} {
  doc "NATURAL: cache-blocked row sum. The image is walked in horizontal bands of band_h rows.";
  let acc = 0_u64;
  for (b in 0_u64..bands) {
    let band_span = band_h * width;
    let band_base = b * band_span;
    for (rr in 0_u64..band_h) {
      let row_off = rr * width;
      let row_base = band_base + row_off;
      for (c in 0_u64..width) {
        let at = row_base + c;
        let byte = deref(pixels)[at];
        let wide = cvt::<u8, u64>(byte);
        set acc = acc +wrap wide;
      }
    }
  }
  return acc;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let pixels = buffer_new(16_u64, 1_u8);
  region {
    let p = &pixels;
    let t = banded_sum(pixels: p, width: 4_u64, band_h: 2_u64, bands: 2_u64);
    if t == 16_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
