fn rgba_alpha_sum(pixels: &buffer<u8>, pixel_count: own u64) -> total: own u64 reads(pixels) contract {
  requires pixel_count <= 1073741823_u64;
} {
  doc "CONTROL: the same shape with a compile-time stride. RGBA is 4 bytes per pixel, so the stride is a literal and nothing needs annotating.";
  let capacity = len(deref(pixels));
  let acc = 0_u64;
  for (i in 0_u64..pixel_count) {
    let base = i * 4_u64;
    let at = base + 3_u64;
    let fits = at < capacity;
    if fits {
    } else {
      return acc;
    }
    let byte = deref(pixels)[at];
    let wide = cvt::<u8, u64>(byte);
    set acc = acc +wrap wide;
  }
  return acc;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let pixels = buffer_new(12_u64, 1_u8);
  region {
    let p = &pixels;
    let t = rgba_alpha_sum(pixels: p, pixel_count: 3_u64);
    if t == 3_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
