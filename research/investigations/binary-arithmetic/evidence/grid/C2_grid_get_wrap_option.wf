fn grid_get(cells: &buffer<u8>, width: own u64, height: own u64, row: own u64, col: own u64) -> value: own Option<u8> reads(cells) contract {
  requires row < height;
  requires col < width;
} {
  doc "WORKAROUND: wrapping flatten plus one bounds guard. Cheaper than the checked-match specimen, but the flatten is now silently wrong on overflow and the result type is still widened.";
  let row_base = row *wrap width;
  let at = row_base +wrap col;
  let capacity = len(deref(cells));
  let fits = at < capacity;
  if fits {
  } else {
    return None<u8>();
  }
  let byte = deref(cells)[at];
  return Some<u8>(value: byte);
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let cells = buffer_new(12_u64, 0_u8);
  set cells[9_u64] = 99_u8;
  region {
    let p = &cells;
    let found = grid_get(cells: p, width: 4_u64, height: 3_u64, row: 2_u64, col: 1_u64);
    match found {
      Some(value: byte) => {
        if byte == 99_u8 {
        } else {
          return exit_status(code: 1_u8);
        }
      }
      None() => {
        return exit_status(code: 2_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
