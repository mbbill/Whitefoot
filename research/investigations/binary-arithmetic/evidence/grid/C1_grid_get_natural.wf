fn grid_get(cells: &buffer<u8>, width: own u64, height: own u64, row: own u64, col: own u64) -> value: own u8 reads(cells) contract {
  requires row < height;
  requires col < width;
} {
  doc "NATURAL: read one pixel of a width x height image. The caller has already promised row < height and col < width.";
  let row_base = row * width;
  let at = row_base + col;
  let byte = deref(cells)[at];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let cells = buffer_new(12_u64, 0_u8);
  set cells[9_u64] = 99_u8;
  region {
    let p = &cells;
    let byte = grid_get(cells: p, width: 4_u64, height: 3_u64, row: 2_u64, col: 1_u64);
    if byte == 99_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
