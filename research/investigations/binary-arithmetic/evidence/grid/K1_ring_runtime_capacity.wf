fn ring_drain(slots: &buffer<u8>, head: own u64, count: own u64) -> total: own u64 reads(slots) contract {
  requires head < len(deref(slots));
} {
  doc "CONTROL: a circular buffer whose capacity is a runtime value; the slot index needs a remainder, never a product.";
  let capacity = len(deref(slots));
  let acc = 0_u64;
  for (i in 0_u64..count) {
    let raw = head +wrap i;
    let slot = raw % capacity;
    let byte = deref(slots)[slot];
    let wide = cvt::<u8, u64>(byte);
    set acc = acc +wrap wide;
  }
  return acc;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let slots = buffer_new(5_u64, 2_u8);
  region {
    let p = &slots;
    let t = ring_drain(slots: p, head: 3_u64, count: 7_u64);
    if t == 14_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
