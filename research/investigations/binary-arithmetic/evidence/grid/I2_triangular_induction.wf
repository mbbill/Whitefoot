fn tri_trace(packed: &buffer<u32>, order: own u64) -> total: own u64 reads(packed) contract {
  requires order <= 4096_u64;
} {
  doc "WORKAROUND: carry the triangular row base as an induction variable; base grows by i+1 each row.";
  let capacity = len(deref(packed));
  let acc = 0_u64;
  let base = 0_u64;
  let left = capacity;
  for (
    i in 0_u64..order,
    invariant lo: base + left <= capacity,
    invariant hi: capacity <= base + left
  ) {
    let next = i + 1_u64;
    let row_ok = next <= left;
    if row_ok {
    } else {
      return acc;
    }
    invariant span: base + next <= capacity;
    for (j in 0_u64..next) {
      invariant slot: base + j < capacity;
      let at = base + j;
      let v = deref(packed)[at];
      let w = cvt::<u32, u64>(v);
      set acc = acc +wrap w;
    }
    set base = base + next;
    set left = left - next;
  }
  return acc;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let packed = buffer_new(6_u64, 1_u32);
  region {
    let p = &packed;
    let t = tri_trace(packed: p, order: 3_u64);
    if t == 6_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
