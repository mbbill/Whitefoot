fn flat(row: own u64, width: own u64) -> at: own u64 pure {
  doc "CONTROL: two unbounded u64 values.";
  let at = row * width;
  return at;
}

command fn main() -> status: own ExitStatus pure {
  let v = flat(row: 2_u64, width: 4_u64);
  if v == 8_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
