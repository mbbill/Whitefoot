fn image_sum(pixels: &buffer<u8>, width: own u64, height: own u64) -> total: own u64 reads(pixels) contract {
  requires width <= len(deref(pixels));
  requires height <= len(deref(pixels));
} {
  doc "NATURAL: row-major sum of a width x height 8-bit image held in one flat buffer.";
  let acc = 0_u64;
  for (r in 0_u64..height) {
    for (c in 0_u64..width) {
      let row_base = r * width;
      let at = row_base + c;
      let byte = deref(pixels)[at];
      let wide = cvt::<u8, u64>(byte);
      set acc = acc +wrap wide;
    }
  }
  return acc;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let pixels = buffer_new(12_u64, 1_u8);
  region {
    let p = &pixels;
    let total = image_sum(pixels: p, width: 4_u64, height: 3_u64);
    if total == 12_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
