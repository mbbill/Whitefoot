fn blit(src: &buffer<u8>, dst: &uniq buffer<u8>, src_stride: own u64, dst_stride: own u64, w: own u64, h: own u64) -> moved: own u64 reads(src), writes(dst) contract {
  requires w <= src_stride;
  requires w <= dst_stride;
} {
  doc "NATURAL: copy the top-left w x h rectangle out of one strided image into another.";
  let moved = 0_u64;
  for (r in 0_u64..h) {
    for (c in 0_u64..w) {
      let s_row = r * src_stride;
      let s_at = s_row + c;
      let d_row = r * dst_stride;
      let d_at = d_row + c;
      let byte = deref(src)[s_at];
      set deref(dst)[d_at] = byte;
      set moved = moved +wrap 1_u64;
    }
  }
  return moved;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let src = buffer_new(12_u64, 5_u8);
  let dst = buffer_new(9_u64, 0_u8);
  region {
    let s = &src;
    let d = &uniq dst;
    let moved = blit(src: s, dst: move d, src_stride: 4_u64, dst_stride: 3_u64, w: 2_u64, h: 3_u64);
    if moved == 6_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
