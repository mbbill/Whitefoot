fn interior_sum(pixels: &buffer<u8>, width: own u64) -> total: own u64 reads(pixels) contract {
  requires 2_u64 <= width;
} {
  doc "WORKAROUND: one flat scan over the whole buffer, recovering the column by division so the left and right border columns can be skipped.";
  let capacity = len(deref(pixels));
  let acc = 0_u64;
  for (at in 0_u64..capacity) {
    let c = at % width;
    let last = width - 1_u64;
    let on_left = c == 0_u64;
    let on_right = c == last;
    if on_left {
    } else if on_right {
    } else {
      let byte = deref(pixels)[at];
      let wide = cvt::<u8, u64>(byte);
      set acc = acc +wrap wide;
    }
  }
  return acc;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let pixels = buffer_new(12_u64, 1_u8);
  region {
    let p = &pixels;
    let t = interior_sum(pixels: p, width: 4_u64);
    if t == 6_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
