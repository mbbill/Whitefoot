fn matmul(a: &buffer<u32>, b: &buffer<u32>, out: &uniq buffer<u64>, m: own u64, k: own u64, n: own u64) -> written: own u64 reads(a, b), writes(out) {
  doc "NATURAL: C[m x n] = A[m x k] * B[k x n], all three flat row-major with runtime shapes.";
  let written = 0_u64;
  for (i in 0_u64..m) {
    for (j in 0_u64..n) {
      let acc = 0_u64;
      for (p in 0_u64..k) {
        let a_row = i * k;
        let a_at = a_row + p;
        let b_row = p * n;
        let b_at = b_row + j;
        let av = deref(a)[a_at];
        let bv = deref(b)[b_at];
        let aw = cvt::<u32, u64>(av);
        let bw = cvt::<u32, u64>(bv);
        let prod = aw * bw;
        set acc = acc +wrap prod;
      }
      let c_row = i * n;
      let c_at = c_row + j;
      set deref(out)[c_at] = acc;
      set written = written +wrap 1_u64;
    }
  }
  return written;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let a = buffer_new(6_u64, 2_u32);
  let b = buffer_new(6_u64, 3_u32);
  let out = buffer_new(4_u64, 0_u64);
  region {
    let pa = &a;
    let pb = &b;
    let pc = &uniq out;
    let written = matmul(a: pa, b: pb, out: move pc, m: 2_u64, k: 3_u64, n: 2_u64);
    if written == 4_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
