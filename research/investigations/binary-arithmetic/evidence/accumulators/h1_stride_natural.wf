command fn main() -> status: own ExitStatus allocates(heap) {
  doc "NATURAL FORM: write one channel of an interleaved frame buffer; the cursor advances by a runtime stride.";
  let cfg = buffer_new(2_u64, 0_u8);
  set cfg[0_u64] = 2_u8;
  set cfg[1_u64] = 1_u8;
  let channels = cvt::<u8, u64>(cfg[0_u64]);
  let channel = cvt::<u8, u64>(cfg[1_u64]);
  let out = buffer_new(16_u64, 0_u8);
  let frames = 8_u64;
  let cursor = channel;
  for (
    k in 0_u64..frames,
    invariant strided: cursor <= channel + k * channels
  ) {
    set out[cursor] = 7_u8;
    set cursor = cursor + channels;
  }
  return exit_status(code: 0_u8);
}
