command fn main() -> status: own ExitStatus allocates(heap) {
  doc "DERIVED-VARIABLE probe 1: carry budget = i * max_weight and state acc <= budget, with no literal cap.";
  let profile = buffer_new(1_u64, 5_u8);
  let max_weight = cvt::<u8, u64>(profile[0_u64]);
  let weights = buffer_new(8_u64, 3_u8);
  let acc = 0_u64;
  let budget = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant within: acc <= budget
  ) {
    let w = cvt::<u8, u64>(weights[i]);
    set acc = acc + w;
    set budget = budget + max_weight;
  }
  return exit_status(code: 0_u8);
}
