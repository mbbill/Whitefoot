command fn main() -> status: own ExitStatus allocates(heap) {
  doc "DERIVED-VARIABLE probe 4: the budget invariant holds only once a per-step guard establishes w <= max_weight.";
  let profile = buffer_new(1_u64, 5_u8);
  let max_weight = cvt::<u8, u64>(profile[0_u64]);
  let weights = buffer_new(8_u64, 3_u8);
  let acc = 0_u64;
  let budget = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant within: acc <= budget,
    invariant budget_cap: budget <= 255_u64 * i
  ) {
    let w = cvt::<u8, u64>(weights[i]);
    let w_ok = w <= max_weight;
    if w_ok {
    } else {
      return exit_status(code: 2_u8);
    }
    invariant step_fits: w <= max_weight;
    set acc = acc + w;
    set budget = budget + max_weight;
  }
  return exit_status(code: 0_u8);
}
