command fn main() -> status: own ExitStatus allocates(heap) {
  doc "WORKAROUND W1-exact: advance the cursor while it is still in range; the loop's own exit test carries the bound.";
  let cfg = buffer_new(2_u64, 0_u8);
  set cfg[0_u64] = 2_u8;
  set cfg[1_u64] = 1_u8;
  let channels = cvt::<u8, u64>(cfg[0_u64]);
  let channel = cvt::<u8, u64>(cfg[1_u64]);
  let out = buffer_new(16_u64, 0_u8);
  let room = len(out);
  let cursor = channel;
  loop @frames {
    let in_range = cursor < room;
    if in_range {
    } else {
      break @frames;
    }
    set out[cursor] = 7_u8;
    set cursor = cursor + channels;
  }
  return exit_status(code: 0_u8);
}
