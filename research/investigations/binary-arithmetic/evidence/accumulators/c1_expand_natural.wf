command fn main() -> status: own ExitStatus allocates(heap) {
  doc "NATURAL FORM: expand fixed-width records into an output buffer sized records*width.";
  let header = buffer_new(2_u64, 3_u8);
  let records = cvt::<u8, u64>(header[0_u64]);
  let width = cvt::<u8, u64>(header[1_u64]);
  let capacity = records * width;
  let out = buffer_new(capacity, 0_u8);
  let written = 0_u64;
  for (
    r in 0_u64..records,
    invariant fits: written <= r * width
  ) {
    for (
      c in 0_u64..width,
      invariant inner_fits: written <= r * width + c
    ) {
      set out[written] = 7_u8;
      set written = written + 1_u64;
    }
  }
  if written == 9_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
