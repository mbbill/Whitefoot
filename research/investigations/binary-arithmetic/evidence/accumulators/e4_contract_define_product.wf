fn write_records(out: &uniq buffer<u8>, records: own u64, width: own u64) -> result: own unit writes(out) contract {
  define room = len(deref(out));
  define needed = records * width;
  requires needed <= room;
} {
  let written = 0_u64;
  for (r in 0_u64..records) {
    for (c in 0_u64..width) {
      set deref(out)[written] = 7_u8;
      set written = written + 1_u64;
    }
  }
  return unit;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "CONTRACT probe: publish the product bound through a contract_define and require it at the caller.";
  let out = buffer_new(16_u64, 0_u8);
  region {
    let handle = &uniq out;
    write_records(out: move handle, records: 3_u64, width: 3_u64);
  }
  return exit_status(code: 0_u8);
}
