command fn main() -> status: own ExitStatus allocates(heap) {
  doc "grammar probe: two multiplications in one affine term, both literal factors.";
  let data = buffer_new(8_u64, 3_u8);
  let sum = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant per_byte: sum <= 5_u64 * 51_u64 * i
  ) {
    let byte = data[i];
    let wide = cvt::<u8, u64>(byte);
    set sum = sum + wide;
  }
  return exit_status(code: 0_u8);
}
