command fn main() -> status: own ExitStatus allocates(heap) {
  doc "WORKAROUND W3: do the runtime*runtime product in the narrowest type that fits, then widen; the narrow type's interval is the bound.";
  let config = buffer_new(1_u64, 4_u8);
  let gain = cvt::<u8, u16>(config[0_u64]);
  let samples = buffer_new(8_u64, 3_u8);
  let total = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant scaled_total: total <= 65535_u64 * i
  ) {
    let sample = cvt::<u8, u16>(samples[i]);
    let scaled = sample * gain;
    let wide = cvt::<u16, u64>(scaled);
    set total = total + wide;
  }
  if total == 96_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
