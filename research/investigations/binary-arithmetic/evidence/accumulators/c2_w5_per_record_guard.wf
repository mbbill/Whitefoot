command fn main() -> status: own ExitStatus allocates(heap) {
  doc "WORKAROUND W5: keep records x width, hoist the dead guard from per byte to per record with a use-directed invariant.";
  let header = buffer_new(2_u64, 3_u8);
  let records = cvt::<u8, u64>(header[0_u64]);
  let width = cvt::<u8, u64>(header[1_u64]);
  let out = buffer_new(16_u64, 0_u8);
  let room = len(out);
  let needed = records * width;
  let layout_ok = needed <= room;
  if layout_ok {
  } else {
    return exit_status(code: 2_u8);
  }
  let width_ok = width <= room;
  if width_ok {
  } else {
    return exit_status(code: 3_u8);
  }
  let limit = room - width;
  let written = 0_u64;
  for (r in 0_u64..records) {
    let have_room = written <= limit;
    if have_room {
    } else {
      return exit_status(code: 4_u8);
    }
    let start = written;
    for (
      c in 0_u64..width,
      invariant cell: written <= start + c
    ) {
      invariant in_room: written + 1_u64 <= room {
        use cell;
        use (start <= limit);
        use (c + 1_u64 <= width);
      }
      set out[written] = 7_u8;
      set written = written + 1_u64;
    }
  }
  if written == 9_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
