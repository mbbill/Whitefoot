command fn main() -> status: own ExitStatus allocates(heap) {
  doc "WORKAROUND W3: land the runtime*runtime product in u32 so its type interval bounds the accumulator step.";
  let cfg = buffer_new(1_u64, 0_u32);
  set cfg[0_u64] = 131072_u32;
  let gain = cfg[0_u64];
  let gain_ok = gain <= 262144_u32;
  if gain_ok {
  } else {
    return exit_status(code: 2_u8);
  }
  let samples = buffer_new(8_u64, 1000_u32);
  let total = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant scaled_total: total <= 4294967295_u64 * i
  ) {
    let raw = samples[i];
    let raw_ok = raw <= 4095_u32;
    if raw_ok {
    } else {
      return exit_status(code: 3_u8);
    }
    let product = raw * gain;
    let scaled = ishr(product, 16_u32);
    let wide = cvt::<u32, u64>(scaled);
    set total = total + wide;
  }
  if total == 16000_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
