command fn main() -> status: own ExitStatus allocates(heap) {
  doc "WORKAROUND W2b: re-guard the product's own result inside the loop, because operand guards do not reach it.";
  let cfg = buffer_new(1_u64, 0_u32);
  set cfg[0_u64] = 131072_u32;
  let gain = cvt::<u32, u64>(cfg[0_u64]);
  let samples = buffer_new(8_u64, 1000_u32);
  let total = 0_u64;
  for (
    i in 0_u64..8_u64,
    invariant scaled_total: total <= 16384_u64 * i
  ) {
    let sample = cvt::<u32, u64>(samples[i]);
    let product = sample * gain;
    let scaled = ishr(product, 16_u32);
    let scaled_ok = scaled <= 16384_u64;
    if scaled_ok {
    } else {
      return exit_status(code: 4_u8);
    }
    invariant step_bound: scaled <= 16384_u64;
    set total = total + scaled;
  }
  if total == 16000_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
