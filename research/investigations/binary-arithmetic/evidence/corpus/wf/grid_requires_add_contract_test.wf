fn grid_get(cells: own buffer<u8>, width: own u64, height: own u64, row: own u64, col: own u64) -> value: own u8 reads(cells) contract {
  requires row < height;
  requires col < width;
  requires width + height <= len(cells);
} {
  doc "PROBE: does a nonlinear *requires* clause (contract predicate, not an invariant) let the checker discharge the flattened row*width+col bare, with no *checked/Option ceremony and no per-step .defined dominating guards? Tests whether Face A's affine-formation bar is specific to header_invariant/invariant_stmt/proof_use, or reaches contract predicates too.";
  let row_base = row * width;
  let at = row_base + col;
  let byte = cells[at];
  return byte;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let cells = buffer_new(12_u64, 0_u8);
  set cells[9_u64] = 99_u8;
  let found = grid_get(cells: move cells, width: 4_u64, height: 3_u64, row: 2_u64, col: 1_u64);
  if found == 99_u8 {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
