command fn main() -> status: own ExitStatus pure {
  doc "WORKAROUND: same two-cursor dot product, but using *checked instead of *wrap to detect overflow instead of silently wrapping; costs one extra match arm per multiply, inside the hot loop.";
  let left = array_new::<u32, 5>(0_u32);
  let right = array_new::<u32, 5>(0_u32);
  set left[0_u64] = 2_u32;
  set left[1_u64] = 3_u32;
  set left[2_u64] = 4_u32;
  set left[3_u64] = 5_u32;
  set left[4_u64] = 6_u32;
  set right[0_u64] = 1_u32;
  set right[1_u64] = 1_u32;
  set right[2_u64] = 1_u32;
  set right[3_u64] = 1_u32;
  set right[4_u64] = 1_u32;
  let cursor_a = 0_u64;
  let cursor_b = 0_u64;
  let total = 0_u32;
  loop @walk {
    let a_in_bounds = cursor_a < 5_u64;
    if a_in_bounds {
    } else {
      break @walk;
    }
    let b_in_bounds = cursor_b < 5_u64;
    if b_in_bounds {
    } else {
      break @walk;
    }
    let lv = left[cursor_a];
    let rv = right[cursor_b];
    match lv *checked rv {
      Ok(value: product) => {
        set total = total +wrap product;
      }
      Err(error: overflow) => {
        return exit_status(code: 250_u8);
      }
    }
    set cursor_a = cursor_a +wrap 1_u64;
    set cursor_b = cursor_b +wrap 1_u64;
  }
  if total == 20_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
