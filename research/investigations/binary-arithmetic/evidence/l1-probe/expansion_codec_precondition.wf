fn hex_encode(out: &uniq buffer<u8>, src: own buffer<u8>) -> written: own u64 pure contract {
  define room = len(deref(out));
  define count = len(src);
  define needed = count * 2_u64;
  requires room >= needed;
} {
  doc "L1: an expansion codec states its own size precondition.";
  return 0_u64;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let src = buffer_new(4_u64, 0_u8);
  let out = buffer_new(8_u64, 0_u8);
  region {
    let n = hex_encode(out: &uniq out, src: move src);
  }
  return exit_status(code: 0_u8);
}
