fn escape_into(out: &uniq buffer<u8>, src: own buffer<u8>, width: own u64) -> written: own u64 reads(src), writes(out) contract {
  define room = len(deref(out));
  define count = len(src);
  define needed = count * width;
  requires room >= needed;
} {
  doc "probe: can a requires state a product of two runtime measures with exact *?";
  return 0_u64;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let src = buffer_new(4_u64, 65_u8);
  let out = buffer_new(16_u64, 0_u8);
  region {
    let handle = &uniq out;
    let produced = escape_into(out: move handle, src: move src, width: 4_u64);
    if produced == 0_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
