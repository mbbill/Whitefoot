fn column_sum(data: own buffer<u8>, record_width: own u64, record_count: own u64, field: own u64) -> total: own u64 reads(data) contract {
  define room = len(data);
  requires record_width >= 1_u64;
  requires record_width <= 64_u64;
  requires record_count <= 65535_u64;
  requires field < record_width;
  requires room >= record_count;
} {
  doc "NATURAL: sum one column of a fixed-width record table whose record width and record count both come from the file header.";
  let total = 0_u64;
  for (i in 0_u64..record_count) {
    let base = i * record_width;
    let at = base + field;
    let byte = data[at];
    let wide = cvt::<u8, u64>(byte);
    set total = total +wrap wide;
  }
  return total;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  doc "a 4-record table of 3-byte records; sum column 1";
  let table = buffer_new(12_u64, 0_u8);
  set table[1_u64] = 10_u8;
  set table[4_u64] = 20_u8;
  set table[7_u64] = 30_u8;
  set table[10_u64] = 40_u8;
  let total = column_sum(data: move table, record_width: 3_u64, record_count: 4_u64, field: 1_u64);
  if total == 100_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
