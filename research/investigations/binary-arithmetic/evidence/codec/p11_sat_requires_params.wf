fn needs_capacity(room: own u64, count: own u64, width: own u64) -> ok: own u64 pure contract {
  define needed = count *sat width;
  requires room >= needed;
} {
  doc "probe: minimal *sat capacity requirement";
  return 1_u64;
}

fn caller(room: own u64, count: own u64, width: own u64) -> ok: own u64 pure {
  doc "params have no defining RHS, so the goal expansion cannot fold them away";
  let needed = count *sat width;
  let enough = room >= needed;
  if enough {
  } else {
    return 0_u64;
  }
  let flag = needs_capacity(room: room, count: count, width: width);
  return flag;
}

command fn main() -> status: own ExitStatus pure {
  doc "drive the wrapper";
  let flag = caller(room: 32_u64, count: 4_u64, width: 3_u64);
  if flag == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
