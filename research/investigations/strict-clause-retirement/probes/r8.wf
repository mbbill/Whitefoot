deny_claims fn strict_division(n: own u64, d: own u64) -> own u64 traps {
  doc "A divisor-class division site inside a marked root, discharged in the complete view only by a claim [OP-2, ENT-6].";
  claim nonzero: ine(d, 0_u64) because "the caller passes a nonzero divisor";
  let q = n / d;
  return q;
}

fn main() -> own unit traps {
  doc "Driver.";
  let observed = strict_division(n: 84_u64, d: 2_u64);
  return unit;
}
