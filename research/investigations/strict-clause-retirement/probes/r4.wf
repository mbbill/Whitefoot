fn leaf(value: own u64, limit: own u64) -> own u64 traps ensures result {
  check ilt(result, limit) else trap "leaf result";
} {
  doc "Two levels below the strict root; only this claim proves the summary.";
  claim inside: ilt(value, limit) because "the caller passes a bounded value";
  return value;
}

fn middle(value: own u64, limit: own u64) -> own u64 traps ensures result {
  check ilt(result, limit) else trap "middle result";
} {
  doc "A claim-free relay between the root and the claim.";
  let relayed = leaf(value: value, limit: limit);
  return relayed;
}

deny_claims fn strict_read(values: own array<u8, 4>, index: own u64) -> own u8 traps {
  doc "The bounds obligation is discharged in the complete view only through a summary whose proof lives two components down.";
  let room = len_of(values);
  let safe = middle(value: index, limit: room);
  return values[safe];
}

fn main() -> own unit traps {
  doc "Driver.";
  let values = array_new<u8, 4>(7_u8);
  let selected = strict_read(values: move values, index: 0_u64);
  return unit;
}
