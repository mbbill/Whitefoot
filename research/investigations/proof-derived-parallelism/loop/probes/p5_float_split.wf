fn weight(i: own u64) -> result: own f64 pure {
  doc "Every term is the same inexact decimal, so the only difference between two sums of them is the order in which the roundings happen.";
  let odd = iand(i, 1_u64);
  let alternate = ieq(odd, 1_u64);
  if alternate {
    return 0.1_f64;
  }
  return 0.3_f64;
}

fn loop_total(n: own u64) -> result: own f64 pure {
  let acc = 0.0_f64;
  for @sum i in 0_u64..n {
    let w = weight(i: i);
    set acc = fadd.strict(acc, w);
  }
  return acc;
}

fn split_total(lo: own u64, hi: own u64) -> result: own f64 pure {
  let width = hi -wrap lo;
  let single = ieq(width, 1_u64);
  if single {
    return weight(i: lo);
  }
  let empty = ieq(width, 0_u64);
  if empty {
    return 0.0_f64;
  }
  let half = ishr.wrap(width, 1_u32);
  let mid = lo +wrap half;
  let a = split_total(lo: lo, hi: mid);
  let b = split_total(lo: mid, hi: hi);
  return fadd.strict(a, b);
}

fn hex_digit(v: own u64) -> result: own u8 pure {
  let nibble = iand(v, 15_u64);
  let small = ilt(nibble, 10_u64);
  match cvt<u64, u8>(nibble) {
    Ok(value: byte) => {
      if small {
        return byte +wrap 48_u8;
      }
      return byte +wrap 87_u8;
    }
    Err(error: wide) => {
      return 63_u8;
    }
  }
}

fn spell_hex['d](destination: &uniq 'd buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads('d), writes('d) {
  let cursor = at;
  let rest = value;
  let limit = at +wrap 16_u64;
  loop @digits {
    let done = ige(cursor, limit);
    if done {
      break @digits;
    }
    let shifted = irotl(rest, 4_u32);
    let digit = hex_digit(v: shifted);
    let room = len(deref(destination));
    let writable = ilt(cursor, room);
    if writable {
      set deref(destination)[cursor] = digit;
    }
    set rest = shifted;
    set cursor = cursor +wrap 1_u64;
  }
  return limit;
}

command fn main['q, 'ow](command.stdout as out: own Output<'q, 'ow>) -> status: own ExitStatus writes('q 'ow), allocates(heap) {
  let n = 65536_u64;
  let sequential = loop_total(n: n);
  let tree = split_total(lo: 0_u64, hi: n);
  let sequential_bits = reinterpret<f64, u64>(sequential);
  let tree_bits = reinterpret<f64, u64>(tree);
  let report = buffer_new(33_u64, 10_u8);
  region 'a {
    let first = spell_hex<'a>(destination: &uniq 'a report, at: 0_u64, value: sequential_bits);
  }
  region 'b {
    let second = spell_hex<'b>(destination: &uniq 'b report, at: 16_u64, value: tree_bits);
  }
  region 'o {
    region 's {
      match write_once<'o, 's, 'q, 'ow>(output: &uniq 'o out, source: &'s report, start: 0_u64, end: 33_u64) {
        Ok(value: next) => {
          return exit_status(code: 0_u8);
        }
        Err(error: problem) => {
          return exit_status(code: 1_u8);
        }
      }
    }
  }
}
