fn fill_range(dst: &uniq buffer<u8>, lo: own u64, hi: own u64) -> result: own unit reads(dst), writes(dst) {
  for @f i in lo..hi {
    let room = len(deref(dst));
    let ok = ilt(i, room);
    if ok {
      set deref(dst)[i] = 7_u8;
    }
  }
  return unit;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let data = buffer_new(64_u64, 0_u8);
  region {
    let a = fill_range(dst: &uniq data, lo: 0_u64, hi: 32_u64);
    let b = fill_range(dst: &uniq data, lo: 32_u64, hi: 64_u64);
    return exit_status(code: 0_u8);
  }
}
