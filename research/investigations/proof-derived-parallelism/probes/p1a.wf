enum LNode {
  Leaf(w: f64, h: f64, out: f64);
  Branch(left: box<LNode>, right: box<LNode>, w: f64, h: f64, out: f64);
}

fn boxed_leaf(w: own f64) -> result: own box<LNode> allocates(heap) {
  let leaf = Leaf(w: w, h: 0.5_f64, out: 0.0_f64);
  return box_new(move leaf);
}

fn build(depth: own u64, w: own f64) -> result: own box<LNode> allocates(heap) {
  let done = ieq(depth, 0_u64);
  if done {
    return boxed_leaf(w: w);
  }
  let next = depth -wrap 1_u64;
  let wl = fmul.strict(w, 1.0009765625_f64);
  let wr = fmul.strict(w, 0.9990234375_f64);
  let l = build(depth: next, w: wl);
  let r = build(depth: next, w: wr);
  let branch = Branch(left: move l, right: move r, w: w, h: 0.25_f64, out: 0.0_f64);
  return box_new(move branch);
}

fn cascade(inh: own f64, w: own f64, h: own f64) -> result: own f64 pure {
  let pad_l = fmul.strict(w, 0.0625_f64);
  let pad_r = fmul.strict(w, 0.03125_f64);
  let border = fmul.strict(h, 0.125_f64);
  let lr = fadd.strict(pad_l, pad_r);
  let lrb = ffma.strict(border, 2.0_f64, lr);
  let content = fsub.strict(w, lrb);
  let clamped_lo = fmax(content, 0.0_f64);
  let font = ffma.strict(inh, 0.5_f64, 8.0_f64);
  let line = fmul.strict(font, 1.25_f64);
  let words = fdiv.strict(clamped_lo, font);
  let lines_raw = fdiv.strict(words, 16.0_f64);
  let lines = fceil(lines_raw);
  let height = fmul.strict(lines, line);
  let margin = fmul.strict(h, 0.5_f64);
  let outer = fadd.strict(height, margin);
  let scaled = ffma.strict(outer, 1.0625_f64, border);
  let abs_scaled = fabs(scaled);
  let root = fsqrt.strict(abs_scaled);
  let mixed = ffma.strict(root, 3.25_f64, clamped_lo);
  let capped = fmin(mixed, 4096.0_f64);
  let floored = fmax(capped, 0.0625_f64);
  let rounded = ffloor(floored);
  let frac = fsub.strict(floored, rounded);
  let adj = ffma.strict(frac, 0.5_f64, rounded);
  let final_h = fadd.strict(adj, lrb);
  return final_h;
}

fn measure_words(words: &buffer<f64>, font: own f64) -> result: own f64 reads(words) {
  doc "Measures every word of the shared metric table at one font size. The walk is bounded by the table's own length, so its index obligation is discharged and the whole function is claim-free.";
  let widest = 0.0_f64;
  let total = 0.0_f64;
  let room = len_of(deref(words));
  let k = 0_u64;
  loop @scan {
    let done = ige(k, room);
    if done {
      break @scan;
    }
    let raw = deref(words)[k];
    let scaled = fmul.strict(raw, font);
    let above = fgt(scaled, widest);
    if above {
      set widest = scaled;
    }
    set total = fadd.strict(total, scaled);
    set k = k +wrap 1_u64;
  }
  return fadd.strict(total, widest);
}

fn measure_band(words: &buffer<f64>, count: own u64, font: own f64) -> result: own f64 reads(words), traps {
  doc "The same walk over a caller-supplied prefix. The bound comes from the caller, so the index obligation needs a claim, which is exactly what makes every call closure through this function permitted but not actualizable.";
  let widest = 0.0_f64;
  let total = 0.0_f64;
  let room = len_of(deref(words));
  let k = 0_u64;
  loop @scan {
    let done = ige(k, count);
    if done {
      break @scan;
    }
    let in_range = ilt(k, room);
    claim band_index_in_range: in_range because "the caller passes a count no larger than the metric table";
    let raw = deref(words)[k];
    let scaled = fmul.strict(raw, font);
    let above = fgt(scaled, widest);
    if above {
      set widest = scaled;
    }
    set total = fadd.strict(total, scaled);
    set k = k +wrap 1_u64;
  }
  return fadd.strict(total, widest);
}

fn layout(node: &uniq box<LNode>, words: &buffer<f64>, inh: own f64) -> result: own f64 reads(node, words), writes(node) {
  doc "Folds the box tree, writing each node's resolved height into its own slot. The two child calls are the permitted and actualizable pair: neither reads what the other defines, their written footprints are the disjoint sibling subtrees, neither carries a capability access or may-suspend target action, and no exit of the first skips the second.";
  match deref(deref(node)) {
    Leaf(w: lw, h: lh, out: lslot) => {
      let v = cascade(inh: inh, w: deref(lw), h: deref(lh));
      let m = measure_words(words: words, font: v);
      let total = fadd.strict(v, m);
      set deref(lslot) = total;
      return total;
    }
    Branch(left: l, right: r, w: bw, h: bh, out: bslot) => {
      let own_h = cascade(inh: inh, w: deref(bw), h: deref(bh));
      let m = measure_words(words: words, font: own_h);
      let child_inh = fmul.strict(own_h, 0.5_f64);
      let a = layout(node: move l, words: words, inh: child_inh);
      let gap = fmul.strict(child_inh, 1.5_f64);
      let b = layout(node: move r, words: words, inh: child_inh);
      let kids = fadd.strict(a, b);
      let mine = fadd.strict(own_h, m);
      let withgap = fadd.strict(kids, gap);
      let total = fadd.strict(withgap, mine);
      set deref(bslot) = total;
      return total;
    }
  }
}

fn layout_banded(node: &uniq box<LNode>, words: &buffer<f64>, count: own u64, inh: own f64) -> result: own f64 reads(node, words), writes(node), traps {
  doc "The same fold whose per-node measure takes a caller-supplied band. Its child pair satisfies every permission condition too, but a claim site is reachable from both callees, so the pair is permitted and not actualizable.";
  match deref(deref(node)) {
    Leaf(w: lw, h: lh, out: lslot) => {
      let v = cascade(inh: inh, w: deref(lw), h: deref(lh));
      let m = measure_band(words: words, count: count, font: v);
      let total = fadd.strict(v, m);
      set deref(lslot) = total;
      return total;
    }
    Branch(left: l, right: r, w: bw, h: bh, out: bslot) => {
      let own_h = cascade(inh: inh, w: deref(bw), h: deref(bh));
      let m = measure_band(words: words, count: count, font: own_h);
      let child_inh = fmul.strict(own_h, 0.5_f64);
      let a = layout_banded(node: move l, words: words, count: count, inh: child_inh);
      let b = layout_banded(node: move r, words: words, count: count, inh: child_inh);
      let kids = fadd.strict(a, b);
      let mine = fadd.strict(own_h, m);
      let total = fadd.strict(kids, mine);
      set deref(bslot) = total;
      return total;
    }
  }
}

fn hex_digit(v: own u64) -> result: own u8 pure {
  let nibble = iand(v, 15_u64);
  let small = ilt(nibble, 10_u64);
  match cvt<u64, u8>(nibble) {
    Ok(value: byte) => {
      if small {
        return byte +wrap 48_u8;
      }
      return byte +wrap 87_u8;
    }
    Err(error: wide) => {
      return 63_u8;
    }
  }
}

fn spell_hex(destination: &uniq buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination) {
  doc "Writes one 64-bit value as sixteen lowercase hexadecimal digits, most significant first.";
  let cursor = at;
  let rest = value;
  let limit = at +wrap 16_u64;
  loop @digits {
    let done = ige(cursor, limit);
    if done {
      break @digits;
    }
    let shifted = irotl(rest, 4_u32);
    let digit = hex_digit(v: shifted);
    let room = len_of(deref(destination));
    let writable = ilt(cursor, room);
    if writable {
      set deref(destination)[cursor] = digit;
    }
    set rest = shifted;
    set cursor = cursor +wrap 1_u64;
  }
  return limit;
}

command fn main(command.stdout as out: own OutputStream) -> status: own ExitStatus reads(out), writes(out), allocates(heap), traps {
  doc "Lays out one box tree many times, then publishes the exact bits of both folds as hexadecimal so any difference between two executions is a difference in the published bytes.";
  let tree = build(depth: 6_u64, w: 512.0_f64);
  let words = buffer_new(8192_u64, 0.25_f64);
  let room = len_of(words);
  let width = 6.5_f64;
  let w = 0_u64;
  loop @fill {
    let done = ige(w, room);
    if done {
      break @fill;
    }
    set words[w] = width;
    set width = fmul.strict(width, 1.0625_f64);
    let too_wide = fgt(width, 64.0_f64);
    if too_wide {
      set width = 6.5_f64;
    }
    set w = w +wrap 1_u64;
  }
  let i = 0_u64;
  let last = 0.0_f64;
  let seed = 16.0_f64;
  loop @reps {
    let done = ieq(i, 800_u64);
    if done {
      break @reps;
    }
    region 'tree {
      region {
        let total = layout(node: &uniq 'tree tree, words: &words, inh: seed);
        set last = total;
      }
    }
    set seed = fadd.strict(seed, 0.0625_f64);
    set i = i +wrap 1_u64;
  }
  let j = 0_u64;
  let banded = 0.0_f64;
  let band_seed = 16.0_f64;
  loop @band_reps {
    let done = ieq(j, 800_u64);
    if done {
      break @band_reps;
    }
    region 'banded_tree {
      region {
        let total = layout_banded(node: &uniq 'banded_tree tree, words: &words, count: 4096_u64, inh: band_seed);
        set banded = total;
      }
    }
    set band_seed = fadd.strict(band_seed, 0.0625_f64);
    set j = j +wrap 1_u64;
  }
  let last_bits = reinterpret<f64, u64>(last);
  let banded_bits = reinterpret<f64, u64>(banded);
  let report = buffer_new(34_u64, 10_u8);
  set report[16_u64] = 32_u8;
  region {
    let first = spell_hex(destination: &uniq report, at: 0_u64, value: last_bits);
  }
  region {
    let second = spell_hex(destination: &uniq report, at: 17_u64, value: banded_bits);
  }
  region 'o {
    region {
      match write_once(output: &'o out, source: &report, start: 0_u64, end: 34_u64) {
        Ok(value: next) => {
          return exit_status(code: 0_u8);
        }
        Err(error: problem) => {
          return exit_status(code: 1_u8);
        }
      }
    }
  }
}
