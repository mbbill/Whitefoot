fn window(input: &buffer<u8>, at: own u64) -> result: own u8 reads(input) {
  doc "Two adjacent reads admitted by one branch-guarded `band`. The function holds no claim site, so a caller's sibling pair over it stays eligible.";
  let nxt = at +wrap 1_u64;
  let room = len_of(deref(input));
  let a_ok = ilt(at, room);
  let b_ok = ilt(nxt, room);
  let both = band(a_ok, b_ok);
  if both {
    let x = deref(input)[at];
    let y = deref(input)[nxt];
    return x +wrap y;
  }
  return 0_u8;
}

fn scan(input: &buffer<u8>) -> result: own u8 reads(input) {
  let a = window(input: input, at: 0_u64);
  let b = window(input: input, at: 2_u64);
  return a +wrap b;
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let input = buffer_new(8_u64, 1_u8);
  region {
    let v = scan(input: &input);
    claim sum: ieq(v, 4_u8) because "four ones";
  }
  return exit_status(code: 0_u8);
}
