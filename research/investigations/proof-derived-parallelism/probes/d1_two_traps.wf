fn left(x: own u64) -> result: own u64 traps {
  claim left_small: ilt(x, 100_u64) because "caller passes a small value";
  return x;
}

fn right(y: own u64) -> result: own u64 traps {
  claim right_small: ilt(y, 100_u64) because "caller passes a small value";
  return y;
}

command fn main() -> status: own ExitStatus traps {
  let a = left(x: 150_u64);
  let b = right(y: 200_u64);
  let total = a +wrap b;
  claim total_ok: ieq(total, 350_u64) because "150 + 200";
  return exit_status(code: 0_u8);
}
