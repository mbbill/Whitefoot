enum Tree {
  Leaf(w: u64);
  Node(left: box<Tree>, right: box<Tree>, w: u64);
}

fn weigh(w: own u64) -> result: own u64 pure {
  let acc = w;
  loop @l {
    let stop = ieq(acc, 7_u64);
    if stop {
      break @l;
    }
    let done = ilt(acc, 7_u64);
    if done {
      break @l;
    }
  }
  return acc;
}

fn fold(tree: &box<Tree>) -> result: own u64 reads(tree) {
  match deref(deref(tree)) {
    Leaf(w: leaf_w) => {
      let value = weigh(w: deref(leaf_w));
      return value;
    }
    Node(left: l, right: r, w: node_w) => {
      let a = fold(tree: l);
      let b = fold(tree: r);
      return a +wrap b;
    }
  }
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let l0 = Leaf(w: 9_u64);
  let leaf0 = box_new(move l0);
  let l1 = Leaf(w: 4_u64);
  let leaf1 = box_new(move l1);
  let n = Node(left: move leaf0, right: move leaf1, w: 0_u64);
  let root = box_new(move n);
  region {
    let total = fold(tree: &root);
    claim total_ok: ieq(total, 13_u64) because "9 + 4";
  }
  return exit_status(code: 0_u8);
}
