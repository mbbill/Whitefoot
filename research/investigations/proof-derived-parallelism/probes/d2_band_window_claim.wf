fn window['i](input: &'i buffer<u8>, at: own u64) -> result: own u8 reads('i), traps {
  doc "The same two adjacent reads admitted by a written `claim` instead of a branch. The claim site is a trap site, so a caller's sibling pair over it is permitted but never actualizable.";
  let nxt = at +wrap 1_u64;
  let room = len(deref(input));
  let a_ok = ilt(at, room);
  let b_ok = ilt(nxt, room);
  let both = band(a_ok, b_ok);
  claim reads_in_range: both because "both offsets stay inside the buffer";
  let x = deref(input)[at];
  let y = deref(input)[nxt];
  return x +wrap y;
}

fn scan['i](input: &'i buffer<u8>) -> result: own u8 reads('i), traps {
  let a = window<'i>(input: input, at: 0_u64);
  let b = window<'i>(input: input, at: 2_u64);
  return a +wrap b;
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let input = buffer_new(8_u64, 1_u8);
  region 'i {
    let v = scan<'i>(input: &'i input);
    claim sum: ieq(v, 4_u8) because "four ones";
  }
  return exit_status(code: 0_u8);
}
