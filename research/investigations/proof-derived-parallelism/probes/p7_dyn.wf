fn mkbuf_dyn(n: own u64, v: own f64) -> result: own buffer<f64> allocates(heap), traps {
  doc "A per-node buffer whose length comes from the caller. The allocation fit obligation cannot be discharged locally, so it needs a claim, and that claim is the only reason the pair below is not actualizable.";
  claim node_buffer_fits: buffer_fits<f64>(n) because "the caller passes a node width no larger than the arena budget";
  return buffer_new(n, v);
}

fn shape_dyn(n: own u64, x: own f64) -> result: own u64 allocates(heap), traps {
  doc "Two adjacent independent per-node allocations: the shape a style-resolve phase actually has.";
  let ba = mkbuf_dyn(n: n, v: x);
  let bb = mkbuf_dyn(n: n, v: x);
  let la = len_of(ba);
  let lb = len_of(bb);
  return la +wrap lb;
}

command fn main() -> status: own ExitStatus allocates(heap), traps {
  let total = shape_dyn(n: 64_u64, x: 1.5_f64);
  let ok = ieq(total, 128_u64);
  if ok {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
