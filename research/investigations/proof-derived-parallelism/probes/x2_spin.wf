fn spin(n: own u64) -> result: own u64 pure {
  let acc = n;
  loop @l {
    let stop = ieq(acc, 7_u64);
    if stop {
      break @l;
    }
  }
  return acc;
}

command fn main() -> status: own ExitStatus traps {
  let v = spin(n: 3_u64);
  claim never: ieq(v, 7_u64) because "unreachable when spin diverges";
  return exit_status(code: 0_u8);
}
