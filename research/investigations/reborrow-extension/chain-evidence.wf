fn passthru['r0](x: &uniq 'r0 i32) -> &uniq 'r0 i32 pure {
  return &uniq 'r0 deref(x);
}

fn bump['r](n: &uniq 'r i32) -> own unit writes(n) {
  set deref(n) = 42_i32;
  return unit;
}

fn main() -> own unit traps {
  let v = 1_i32;
  region 'a {
    let h = &uniq 'a v;
    let r = passthru<'a>(x: &uniq 'a deref(h));
    region 'c {
      bump<'c>(n: &uniq 'c deref(r));
    }
  }
  check ieq(v, 42_i32) else trap "chain write lost";
  return unit;
}
