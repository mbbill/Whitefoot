fn passthru['r0](x: &uniq 'r0 i32) -> &uniq 'r0 i32 pure {
  return &uniq 'r0 deref(x);
}

fn bump(n: &uniq i32) -> own unit writes(n) {
  set deref(n) = 42_i32;
  return unit;
}

fn main() -> own unit traps {
  let v = 1_i32;
  region {
    let h = &uniq v;
    let r = passthru(x: &uniq deref(h));
    region {
      bump(n: &uniq deref(r));
    }
  }
  check ieq(v, 42_i32) else trap "chain write lost";
  return unit;
}
