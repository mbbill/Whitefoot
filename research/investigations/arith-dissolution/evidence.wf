fn digit_total['r](digits: &'r buffer<u8>, total_seed: own u64) -> own u64 reads('r), traps {
  let size = len(deref(digits));
  let offset = 0_u64;
  let total = total_seed;
  loop @walk {
    let more = ilt(offset, size);
    if more {
    } else {
      break @walk;
    }
    let byte = deref(digits)[offset];
    let wide = cvt<u8, u64>(byte);
    let grown = total + wide;
    set total = grown;
    let next = offset + 1_u64;
    set offset = next;
  }
  return total;
}

fn main() -> own unit allocates(heap), traps {
  let digits = buffer_new(5_u64, 0_u8);
  set digits[0_u64] = 3_u8;
  set digits[1_u64] = 1_u8;
  set digits[2_u64] = 4_u8;
  set digits[3_u64] = 1_u8;
  set digits[4_u64] = 5_u8;
  region 'walk_view {
    let view = &'walk_view digits;
    let total = digit_total<'walk_view>(digits: view, total_seed: 10_u64);
    claim digit_total: ieq(total, 24_u64) because "digit total";
    let folded = total *wrap 3_u64;
    claim wrapped_fold: ieq(folded, 72_u64) because "wrapped fold";
  }
  return unit;
}
