fn hash_words(input: &Box<Array<u64>>, seed: own u64) -> result: own u64 reads(input) {
  let count = deref(input).inner.len;
  let hash = seed;
  for (i in 0_u64..count) {
    let word = deref(input).inner[i];
    let mixed = ixor(hash, word);
    set hash = mixed *wrap 6364136223846793005_u64;
  }
  return hash;
}

fn batch(input: &Box<Array<u64>>, output: &[u64]) -> result: own u64 reads(input), writes(output) {
  let count = deref(output).len;
  for (i in 0_u64..count) {
    let seed = i +wrap 17_u64;
    set deref(output)[i] = hash_words(input: input, seed: seed);
  }
  return count;
}

fn main() -> status: own ExitStatus pure {
  let input = box_array_filled::<u64>(count: 1_u64, value: 7_u64);
  let output = array_filled::<u64, 1>(value: 0_u64);
  let count = batch(input: &input, output: &output[0_u64..1_u64]);
  return exit_status(code: 0_u8);
}
