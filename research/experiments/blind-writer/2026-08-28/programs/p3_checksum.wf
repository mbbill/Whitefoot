const separator: array<u8, 2> =[32_u8, 32_u8];

const line_break: array<u8, 1> =[10_u8];

struct Digest {
  digest: u64;
  bytes: u64;
  status: u8;
}

fn digit_byte(value: own u64) -> result: own u8 pure {
  doc "Renders one decimal digit value as its ASCII byte.";
  let shifted = value +wrap 48_u64;
  match cvt<u64, u8>(shifted) {
    Ok(value: byte) => {
      return byte;
    }
    Err(error: problem) => {
      return 63_u8;
    }
  }
}

fn put_byte['d](destination: &uniq 'd buffer<u8>, at: own u64, value: own u8) -> result: own u64 reads(destination), writes(destination) {
  doc "Stores one byte when the destination holds that position and reports the next position.";
  let capacity = len(deref(destination));
  let fits = ilt(at, capacity);
  if fits {
    set deref(destination)[at] = value;
    return at +wrap 1_u64;
  }
  return at;
}

fn put_text['d, 's](destination: &uniq 'd buffer<u8>, at: own u64, text: own slice<'s, u8>) -> result: own u64 reads(destination, text), writes(destination) {
  doc "Copies every byte of one read-only text view into the destination.";
  let cursor = at;
  let count = len(text);
  for @copy step in 0_u64..count {
    let byte = text[step];
    region 'one {
      set cursor = put_byte<'one>(destination: &uniq 'one deref(destination), at: cursor, value: byte);
    }
  }
  return cursor;
}

fn put_prefix['d, 's](destination: &uniq 'd buffer<u8>, at: own u64, source: &'s buffer<u8>, length: own u64) -> result: own u64 reads(destination, source), writes(destination) contract {
  define capacity = len(deref(source));
  requires ile(length, capacity);
} {
  doc "Copies one prefix of a byte buffer into the destination.";
  let cursor = at;
  for @copy step in 0_u64..length {
    let byte = deref(source)[step];
    region 'one {
      set cursor = put_byte<'one>(destination: &uniq 'one deref(destination), at: cursor, value: byte);
    }
  }
  return cursor;
}

fn put_decimal['d](destination: &uniq 'd buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination), allocates(heap) {
  doc "Renders one unsigned value in decimal into the destination.";
  let scratch = buffer_new(20_u64, 0_u8);
  let count = 0_u64;
  let rest = value;
  loop @split {
    let digit = rest % 10_u64;
    let byte = digit_byte(value: digit);
    let capacity = len(scratch);
    let room = ilt(count, capacity);
    if room {
      set scratch[count] = byte;
      set count = count +wrap 1_u64;
    }
    set rest = rest / 10_u64;
    let done = ieq(rest, 0_u64);
    if done {
      break @split;
    }
  }
  let cursor = at;
  loop @unwind {
    let empty = ieq(count, 0_u64);
    if empty {
      break @unwind;
    }
    set count = count -wrap 1_u64;
    let capacity = len(scratch);
    let inside = ilt(count, capacity);
    if inside {
      let byte = scratch[count];
      region 'one {
        set cursor = put_byte<'one>(destination: &uniq 'one deref(destination), at: cursor, value: byte);
      }
    }
  }
  return cursor;
}

fn emit_all['o, 's](output: &uniq 'o Output, source: &'s buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define capacity = len(deref(source));
  requires ile(length, capacity);
} {
  doc "Writes one prefix of the source buffer, reattempting until the host accepts every byte.";
  let sent = 0_u64;
  loop @publish {
    let pending = ilt(sent, length);
    if pending {
    } else {
      break @publish;
    }
    region 'attempt {
      match write_once<'attempt, 's>(output: &uniq 'attempt deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn checksum_file['f, 'c](handle: &'f ReadFile, chunk: &uniq 'c buffer<u8>, seed: own u64) -> result: own Digest reads(handle, chunk), writes(chunk) {
  doc "Folds one file's bytes into an FNV-1a digest, reading it in sixty-four kibibyte chunks.";
  let digest = seed;
  let total = 0_u64;
  let status = 0_u8;
  let offset = 0_u64;
  loop @chunks {
    let capacity = len(deref(chunk));
    let usable = ile(65536_u64, capacity);
    if usable {
    } else {
      set status = 6_u8;
      break @chunks;
    }
    let received = 0_u64;
    let ended = 0_u8;
    region 'read {
      match read_at<'f, 'read>(file: handle, destination: &uniq 'read deref(chunk), file_offset: offset, start: 0_u64, end: 65536_u64) {
        ReadBytes(next: produced) => {
          set received = produced;
        }
        ReadEnd() => {
          set ended = 1_u8;
        }
        ReadFailed(error: problem) => {
          set ended = 1_u8;
          set status = 7_u8;
        }
      }
    }
    let running = ieq(ended, 0_u8);
    if running {
    } else {
      break @chunks;
    }
    let room = len(deref(chunk));
    let fits = ile(received, room);
    if fits {
      for @fold at in 0_u64..received {
        let byte = deref(chunk)[at];
        let widened = cvt<u8, u64>(byte);
        let mixed = ixor(digest, widened);
        set digest = mixed *wrap 1099511628211_u64;
      }
      set total = total +wrap received;
      set offset = offset +wrap received;
    } else {
      set status = 6_u8;
      break @chunks;
    }
  }
  return Digest(digest: digest, bytes: total, status: status);
}

command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, out, files), writes(cwd, out, files), allocates(heap) {
  doc "Checksums every file named on the command line and publishes one digest line per file.";
  let supplied = 0_u64;
  region 'count_args {
    set supplied = args_count<'count_args>(args: &'count_args args);
  }
  let status = 0_u8;
  for @each index in 1_u64..supplied {
    let data = buffer_new(65536_u64, 0_u8);
    let name = buffer_new(4096_u64, 0_u8);
    let line = buffer_new(4200_u64, 0_u8);
    let name_end = 0_u64;
    let digest = 14695981039346656037_u64;
    let total = 0_u64;
    let outcome = 0_u8;
    region 'label {
      match arg_get<'label>(args: &'label args, position: index) {
        Ok(value: text) => {
          let room = len(name);
          region 'copy {
            match host_copy_bytes<'copy, 'copy>(value: &'copy text, destination: &uniq 'copy name, start: 0_u64, end: room) {
              Ok(value: next) => {
                set name_end = next;
              }
              Err(error: problem) => {
                set outcome = 2_u8;
              }
            }
          }
        }
        Err(error: problem) => {
          set outcome = 5_u8;
        }
      }
    }
    region 'target {
      match arg_get<'target>(args: &'target args, position: index) {
        Ok(value: text) => {
          match relative_path(value: move text) {
            Ok(value: path) => {
              region 'permit {
                match reserve_file<'permit>(factory: &uniq 'permit files) {
                  Ok(value: permit) => {
                    region 'open {
                      match open_read<'open, 'open>(permit: move permit, root: &'open cwd, path: &'open path) {
                        FileOpened(value: handle) => {
                          region 'scan {
                            let summary = checksum_file<'scan, 'scan>(handle: &'scan handle, chunk: &uniq 'scan data, seed: digest);
                            set digest = summary.digest;
                            set total = summary.bytes;
                            set outcome = summary.status;
                          }
                        }
                        FileOpenFailed(error: problem, permit: refused) => {
                          set outcome = 3_u8;
                        }
                      }
                    }
                  }
                  Err(error: spent) => {
                    set outcome = 9_u8;
                  }
                }
              }
            }
            Err(error: problem) => {
              set outcome = 4_u8;
            }
          }
        }
        Err(error: problem) => {
          set outcome = 5_u8;
        }
      }
    }
    let end = 0_u64;
    let name_room = len(name);
    let name_fits = ile(name_end, name_room);
    if name_fits {
      region 'name_put {
        set end = put_prefix<'name_put, 'name_put>(destination: &uniq 'name_put line, at: end, source: &'name_put name, length: name_end);
      }
    }
    region 'gap_view {
      let view = slice_of(&'gap_view separator);
      region 'gap_put {
        set end = put_text<'gap_put, 'gap_view>(destination: &uniq 'gap_put line, at: end, text: move view);
      }
    }
    region 'digest_put {
      set end = put_decimal<'digest_put>(destination: &uniq 'digest_put line, at: end, value: digest);
    }
    region 'size_gap_view {
      let view = slice_of(&'size_gap_view separator);
      region 'size_gap_put {
        set end = put_text<'size_gap_put, 'size_gap_view>(destination: &uniq 'size_gap_put line, at: end, text: move view);
      }
    }
    region 'size_put {
      set end = put_decimal<'size_put>(destination: &uniq 'size_put line, at: end, value: total);
    }
    region 'break_view {
      let view = slice_of(&'break_view line_break);
      region 'break_put {
        set end = put_text<'break_put, 'break_view>(destination: &uniq 'break_put line, at: end, text: move view);
      }
    }
    let line_room = len(line);
    let line_fits = ile(end, line_room);
    if line_fits {
      region 'publish {
        match emit_all<'publish, 'publish>(output: &uniq 'publish out, source: &'publish line, length: end) {
          Ok(value: sent) => {
          }
          Err(error: problem) => {
            set outcome = 8_u8;
          }
        }
      }
    } else {
      set outcome = 8_u8;
    }
    let clean = ieq(outcome, 0_u8);
    if clean {
    } else {
      set status = outcome;
    }
  }
  return exit_status(code: status);
}
