const separator: array<u8, 1> =[32_u8];

const path_separator: array<u8, 1> =[47_u8];

const line_break: array<u8, 1> =[10_u8];

const total_label: array<u8, 5> =[116_u8, 111_u8, 116_u8, 97_u8, 108_u8];

struct Counts {
  lines: u64;
  bytes: u64;
  status: u8;
}

fn digit_byte(value: own u64) -> result: own u8 pure {
  doc "Renders one decimal digit value as its ASCII byte.";
  let shifted = value +wrap 48_u64;
  match cvt<u64, u8>(shifted) {
    Ok(value: byte) => {
      return byte;
    }
    Err(error: problem) => {
      return 63_u8;
    }
  }
}

fn byte_at['s](source: &'s buffer<u8>, index: own u64) -> result: own u8 reads(source) {
  doc "Reads one byte, delivering zero for a position the buffer does not hold.";
  let capacity = len(deref(source));
  let inside = ilt(index, capacity);
  if inside {
    return deref(source)[index];
  }
  return 0_u8;
}

fn put_byte['d](destination: &uniq 'd buffer<u8>, at: own u64, value: own u8) -> result: own u64 reads(destination), writes(destination) {
  doc "Stores one byte when the destination holds that position and reports the next position.";
  let capacity = len(deref(destination));
  let fits = ilt(at, capacity);
  if fits {
    set deref(destination)[at] = value;
    return at +wrap 1_u64;
  }
  return at;
}

fn put_text['d, 's](destination: &uniq 'd buffer<u8>, at: own u64, text: own slice<'s, u8>) -> result: own u64 reads(destination, text), writes(destination) {
  doc "Copies every byte of one read-only text view into the destination.";
  let cursor = at;
  let count = len(text);
  for @copy step in 0_u64..count {
    let byte = text[step];
    region 'one {
      set cursor = put_byte<'one>(destination: &uniq 'one deref(destination), at: cursor, value: byte);
    }
  }
  return cursor;
}

fn put_range['d, 's](destination: &uniq 'd buffer<u8>, at: own u64, source: &'s buffer<u8>, start: own u64, end: own u64) -> result: own u64 reads(destination, source), writes(destination) {
  doc "Copies one half-open byte range of the source into the destination.";
  let cursor = at;
  for @copy step in start..end {
    let byte = byte_at<'s>(source: source, index: step);
    region 'one {
      set cursor = put_byte<'one>(destination: &uniq 'one deref(destination), at: cursor, value: byte);
    }
  }
  return cursor;
}

fn put_decimal['d](destination: &uniq 'd buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination), allocates(heap) {
  doc "Renders one unsigned value in decimal into the destination.";
  let scratch = buffer_new(20_u64, 0_u8);
  let count = 0_u64;
  let rest = value;
  loop @split {
    let digit = rest % 10_u64;
    let byte = digit_byte(value: digit);
    let capacity = len(scratch);
    let room = ilt(count, capacity);
    if room {
      set scratch[count] = byte;
      set count = count +wrap 1_u64;
    }
    set rest = rest / 10_u64;
    let done = ieq(rest, 0_u64);
    if done {
      break @split;
    }
  }
  let cursor = at;
  loop @unwind {
    let empty = ieq(count, 0_u64);
    if empty {
      break @unwind;
    }
    set count = count -wrap 1_u64;
    let capacity = len(scratch);
    let inside = ilt(count, capacity);
    if inside {
      let byte = scratch[count];
      region 'one {
        set cursor = put_byte<'one>(destination: &uniq 'one deref(destination), at: cursor, value: byte);
      }
    }
  }
  return cursor;
}

fn emit_all['o, 's](output: &uniq 'o Output, source: &'s buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define capacity = len(deref(source));
  requires ile(length, capacity);
} {
  doc "Writes one prefix of the source buffer, reattempting until the host accepts every byte.";
  let sent = 0_u64;
  loop @publish {
    let pending = ilt(sent, length);
    if pending {
    } else {
      break @publish;
    }
    region 'attempt {
      match write_once<'attempt, 's>(output: &uniq 'attempt deref(output), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn report_counts['o, 'p](output: &uniq 'o Output, path: &'p buffer<u8>, path_length: own u64, lines: own u64, bytes: own u64) -> result: own u8 reads(output, path), writes(output), allocates(heap) {
  doc "Publishes one line holding a line count, a byte count, and a path.";
  let line = buffer_new(4400_u64, 0_u8);
  let end = 0_u64;
  region 'lines_put {
    set end = put_decimal<'lines_put>(destination: &uniq 'lines_put line, at: end, value: lines);
  }
  region 'gap_one {
    let view = slice_of(&'gap_one separator);
    region 'gap_one_put {
      set end = put_text<'gap_one_put, 'gap_one>(destination: &uniq 'gap_one_put line, at: end, text: move view);
    }
  }
  region 'bytes_put {
    set end = put_decimal<'bytes_put>(destination: &uniq 'bytes_put line, at: end, value: bytes);
  }
  region 'gap_two {
    let view = slice_of(&'gap_two separator);
    region 'gap_two_put {
      set end = put_text<'gap_two_put, 'gap_two>(destination: &uniq 'gap_two_put line, at: end, text: move view);
    }
  }
  region 'path_put {
    set end = put_range<'path_put, 'p>(destination: &uniq 'path_put line, at: end, source: path, start: 0_u64, end: path_length);
  }
  region 'break_view {
    let view = slice_of(&'break_view line_break);
    region 'break_put {
      set end = put_text<'break_put, 'break_view>(destination: &uniq 'break_put line, at: end, text: move view);
    }
  }
  let room = len(line);
  let fits = ile(end, room);
  if fits {
    region 'publish {
      match emit_all<'publish, 'publish>(output: &uniq 'publish deref(output), source: &'publish line, length: end) {
        Ok(value: sent) => {
        }
        Err(error: problem) => {
          return 8_u8;
        }
      }
    }
  } else {
    return 8_u8;
  }
  return 0_u8;
}

fn count_file['f, 'c](handle: &'f ReadFile, chunk: &uniq 'c buffer<u8>) -> result: own Counts reads(handle, chunk), writes(chunk) {
  doc "Counts the line terminators and bytes of one file, reading it in sixty-four kibibyte chunks.";
  let lines = 0_u64;
  let bytes = 0_u64;
  let status = 0_u8;
  let offset = 0_u64;
  loop @chunks {
    let capacity = len(deref(chunk));
    let usable = ile(65536_u64, capacity);
    if usable {
    } else {
      set status = 6_u8;
      break @chunks;
    }
    let received = 0_u64;
    let ended = 0_u8;
    region 'read {
      match read_at<'f, 'read>(file: handle, destination: &uniq 'read deref(chunk), file_offset: offset, start: 0_u64, end: 65536_u64) {
        ReadBytes(next: produced) => {
          set received = produced;
        }
        ReadEnd() => {
          set ended = 1_u8;
        }
        ReadFailed(error: problem) => {
          set ended = 1_u8;
          set status = 7_u8;
        }
      }
    }
    let running = ieq(ended, 0_u8);
    if running {
    } else {
      break @chunks;
    }
    let room = len(deref(chunk));
    let fits = ile(received, room);
    if fits {
      for @scan at in 0_u64..received {
        let byte = deref(chunk)[at];
        let terminator = ieq(byte, 10_u8);
        if terminator {
          set lines = lines +wrap 1_u64;
        }
      }
      set bytes = bytes +wrap received;
      set offset = offset +wrap received;
    } else {
      set status = 6_u8;
      break @chunks;
    }
  }
  return Counts(lines: lines, bytes: bytes, status: status);
}

fn open_source_from['f, 'd](factory: &uniq 'f FileFactory, directory: &'d DirectoryRead) -> result: own Result<DirectorySource, IoError> reads(factory, directory), writes(factory) {
  doc "Reserves one permit and opens one enumeration over the named directory.";
  let permit = reserve_file<'f>(factory: move factory);
  return open_directory_source<'d>(permit: move permit, directory: directory);
}

fn open_child_from['f, 'd, 'n](factory: &uniq 'f FileFactory, root: &'d DirectoryRead, name: &'n buffer<u8>, start: own u64, end: own u64) -> result: own Result<DirectoryRead, IoError> reads(factory, root, name), writes(factory) contract {
  define ordered = ile(start, end);
  define capacity = len(deref(name));
  define within = ile(end, capacity);
  requires ordered;
  requires within;
} {
  doc "Reserves one permit and opens one named subdirectory of the given directory.";
  let permit = reserve_file<'f>(factory: move factory);
  return open_directory<'d, 'n>(permit: move permit, root: root, name: name, start: start, end: end);
}

fn open_regular_from['f, 'd, 'n](factory: &uniq 'f FileFactory, root: &'d DirectoryRead, name: &'n buffer<u8>, start: own u64, end: own u64) -> result: own Result<ReadFile, IoError> reads(factory, root, name), writes(factory) contract {
  define ordered = ile(start, end);
  define capacity = len(deref(name));
  define within = ile(end, capacity);
  requires ordered;
  requires within;
} {
  doc "Reserves one permit and opens one named regular file of the given directory.";
  let permit = reserve_file<'f>(factory: move factory);
  return open_file<'d, 'n>(permit: move permit, root: root, name: name, start: start, end: end);
}

fn is_dot['e](entries: &'e buffer<u8>, name_at: own u64, name_length: own u64) -> result: own Bool reads(entries) {
  doc "Reports whether one enumerated name is the self or parent directory entry.";
  let single = ieq(name_length, 1_u64);
  if single {
    let first = byte_at<'e>(source: entries, index: name_at);
    return ieq(first, 46_u8);
  }
  let double = ieq(name_length, 2_u64);
  if double {
    let first = byte_at<'e>(source: entries, index: name_at);
    let second_at = name_at +wrap 1_u64;
    let second = byte_at<'e>(source: entries, index: second_at);
    let leading = ieq(first, 46_u8);
    let trailing = ieq(second, 46_u8);
    return band(leading, trailing);
  }
  return False();
}

fn walk['f, 'c, 'p, 'o, 'b](factory: &uniq 'f FileFactory, dir: &'c DirectoryRead, prefix: &'p buffer<u8>, prefix_length: own u64, output: &uniq 'o Output, chunk: &uniq 'b buffer<u8>, depth: own u64) -> result: own Counts reads(factory, dir, prefix, output, chunk), writes(factory, output, chunk), allocates(heap) {
  doc "Walks one directory recursively, counting every regular file it reaches and publishing one line each.";
  let totals = Counts(lines: 0_u64, bytes: 0_u64, status: 0_u8);
  let deep = ige(depth, 64_u64);
  if deep {
    return move totals;
  }
  let entries = buffer_new(65536_u64, 0_u8);
  let deeper = depth +wrap 1_u64;
  region 'source {
    match open_source_from<'source, 'c>(factory: &uniq 'source deref(factory), directory: dir) {
      Ok(value: list) => {
        loop @batches {
          let room = len(entries);
          let usable = ile(65536_u64, room);
          if usable {
          } else {
            break @batches;
          }
          let produced = 0_u64;
          let found = 0_u64;
          let ended = 0_u8;
          region 'batch {
            match directory_next<'batch, 'batch>(source: &uniq 'batch list, destination: &uniq 'batch entries, start: 0_u64, end: 65536_u64) {
              ListBytes(next: reached, entries: records) => {
                set produced = reached;
                set found = records;
              }
              ListEnd() => {
                set ended = 1_u8;
              }
              ListFailed(error: problem) => {
                set ended = 1_u8;
                set totals.status = 9_u8;
              }
            }
          }
          let live = ieq(ended, 0_u8);
          if live {
          } else {
            break @batches;
          }
          let cursor = 0_u64;
          for @records step in 0_u64..found {
            let kind = 0_u8;
            let low = 0_u8;
            let high = 0_u8;
            let name_at = cursor +wrap 3_u64;
            let child = buffer_new(4400_u64, 0_u8);
            let child_end = 0_u64;
            let dotted = True();
            region 'head {
              let view = &'head entries;
              set kind = byte_at<'head>(source: view, index: cursor);
              let one = cursor +wrap 1_u64;
              set low = byte_at<'head>(source: view, index: one);
              let two = cursor +wrap 2_u64;
              set high = byte_at<'head>(source: view, index: two);
            }
            let low_part = cvt<u8, u64>(low);
            let high_part = cvt<u8, u64>(high);
            let scaled = high_part *wrap 256_u64;
            let name_length = low_part +wrap scaled;
            let name_end = name_at +wrap name_length;
            region 'compose {
              let view = &'compose entries;
              set dotted = is_dot<'compose>(entries: view, name_at: name_at, name_length: name_length);
              region 'prefix_put {
                set child_end = put_range<'prefix_put, 'p>(destination: &uniq 'prefix_put child, at: 0_u64, source: prefix, start: 0_u64, end: prefix_length);
              }
              region 'name_put {
                set child_end = put_range<'name_put, 'compose>(destination: &uniq 'name_put child, at: child_end, source: view, start: name_at, end: name_end);
              }
            }
            let ordered = ile(name_at, name_end);
            let limit = len(entries);
            let bounded = ile(name_end, limit);
            let is_directory = ieq(kind, 2_u8);
            let is_regular = ieq(kind, 1_u8);
            if ordered {
              if bounded {
                if dotted {
                } else {
                  if is_directory {
                    region 'slash {
                      set child_end = put_byte<'slash>(destination: &uniq 'slash child, at: child_end, value: 47_u8);
                    }
                    let sub = Counts(lines: 0_u64, bytes: 0_u64, status: 0_u8);
                    region 'descend {
                      match open_child_from<'descend, 'c, 'descend>(factory: &uniq 'descend deref(factory), root: dir, name: &'descend entries, start: name_at, end: name_end) {
                        Ok(value: opened) => {
                          region 'recurse {
                            let stale = replace sub = walk<'recurse, 'recurse, 'recurse, 'recurse, 'recurse>(factory: &uniq 'recurse deref(factory), dir: &'recurse opened, prefix: &'recurse child, prefix_length: child_end, output: &uniq 'recurse deref(output), chunk: &uniq 'recurse deref(chunk), depth: deeper);
                          }
                        }
                        Err(error: problem) => {
                        }
                      }
                    }
                    set totals.lines = totals.lines +wrap sub.lines;
                    set totals.bytes = totals.bytes +wrap sub.bytes;
                    let inherited = ine(sub.status, 0_u8);
                    if inherited {
                      set totals.status = sub.status;
                    }
                  }
                  if is_regular {
                    let counted = Counts(lines: 0_u64, bytes: 0_u64, status: 0_u8);
                    let measured = 0_u8;
                    region 'measure {
                      match open_regular_from<'measure, 'c, 'measure>(factory: &uniq 'measure deref(factory), root: dir, name: &'measure entries, start: name_at, end: name_end) {
                        Ok(value: handle) => {
                          region 'tally {
                            let stale = replace counted = count_file<'tally, 'tally>(handle: &'tally handle, chunk: &uniq 'tally deref(chunk));
                          }
                          set measured = 1_u8;
                        }
                        Err(error: problem) => {
                        }
                      }
                    }
                    let readable = ieq(measured, 1_u8);
                    if readable {
                      set totals.lines = totals.lines +wrap counted.lines;
                      set totals.bytes = totals.bytes +wrap counted.bytes;
                      region 'announce {
                        let noted = report_counts<'announce, 'announce>(output: &uniq 'announce deref(output), path: &'announce child, path_length: child_end, lines: counted.lines, bytes: counted.bytes);
                      }
                    }
                  }
                }
              }
            }
            let record_size = name_length +wrap 3_u64;
            set cursor = cursor +wrap record_size;
          }
        }
      }
      Err(error: problem) => {
        set totals.status = 9_u8;
      }
    }
  }
  return move totals;
}

command fn main(command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, out, files), writes(cwd, out, files), allocates(heap) {
  doc "Counts the lines and bytes of every regular file in the invocation directory tree and publishes one line each plus a total.";
  let chunk = buffer_new(65536_u64, 0_u8);
  let root = buffer_new(1_u64, 0_u8);
  let totals = Counts(lines: 0_u64, bytes: 0_u64, status: 0_u8);
  region 'walk {
    let scanned = walk<'walk, 'walk, 'walk, 'walk, 'walk>(factory: &uniq 'walk files, dir: &'walk cwd, prefix: &'walk root, prefix_length: 0_u64, output: &uniq 'walk out, chunk: &uniq 'walk chunk, depth: 0_u64);
    set totals.lines = scanned.lines;
    set totals.bytes = scanned.bytes;
    set totals.status = scanned.status;
  }
  let summary = buffer_new(64_u64, 0_u8);
  let end = 0_u64;
  region 'lines_put {
    set end = put_decimal<'lines_put>(destination: &uniq 'lines_put summary, at: end, value: totals.lines);
  }
  region 'gap_one {
    let view = slice_of(&'gap_one separator);
    region 'gap_one_put {
      set end = put_text<'gap_one_put, 'gap_one>(destination: &uniq 'gap_one_put summary, at: end, text: move view);
    }
  }
  region 'bytes_put {
    set end = put_decimal<'bytes_put>(destination: &uniq 'bytes_put summary, at: end, value: totals.bytes);
  }
  region 'gap_two {
    let view = slice_of(&'gap_two separator);
    region 'gap_two_put {
      set end = put_text<'gap_two_put, 'gap_two>(destination: &uniq 'gap_two_put summary, at: end, text: move view);
    }
  }
  region 'label_view {
    let view = slice_of(&'label_view total_label);
    region 'label_put {
      set end = put_text<'label_put, 'label_view>(destination: &uniq 'label_put summary, at: end, text: move view);
    }
  }
  region 'break_view {
    let view = slice_of(&'break_view line_break);
    region 'break_put {
      set end = put_text<'break_put, 'break_view>(destination: &uniq 'break_put summary, at: end, text: move view);
    }
  }
  let room = len(summary);
  let fits = ile(end, room);
  if fits {
    region 'publish {
      match emit_all<'publish, 'publish>(output: &uniq 'publish out, source: &'publish summary, length: end) {
        Ok(value: sent) => {
        }
        Err(error: problem) => {
          set totals.status = 8_u8;
        }
      }
    }
  } else {
    set totals.status = 8_u8;
  }
  return exit_status(code: totals.status);
}
