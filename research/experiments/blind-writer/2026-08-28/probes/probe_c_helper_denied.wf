fn digit_byte(value: own u64) -> result: own u8 pure {
  doc "Renders one decimal digit value as its ASCII byte.";
  let shifted = value +wrap 48_u64;
  match cvt<u64, u8>(shifted) {
    Ok(value: byte) => {
      return byte;
    }
    Err(error: problem) => {
      return 63_u8;
    }
  }
}

fn open_regular_from['f, 'n](factory: &uniq 'f FileFactory, root: &'f DirectoryRead, name: &'n buffer<u8>) -> result: own Result<ReadFile, IoError> reads(factory, root, name), writes(factory) contract {
  define capacity = len_of(deref(name));
  requires ile(2_u64, capacity);
} {
  doc "Reserves one file slot and opens one single-component name under the root, the helper form the reborrow rule pushes a writer towards.";
  match reserve_file<'f>(factory: move factory) {
    Ok(value: permit) => {
      return open_file<'f, 'n>(permit: move permit, root: root, name: name, start: 0_u64, end: 2_u64);
    }
    Err(error: spent) => {
      return Err<ReadFile, IoError>(error: move spent);
    }
  }
}

command fn main(command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, files), writes(cwd, files), allocates(heap) {
  doc "Probe A written with the reserve-and-open helper, which turns the granted staged verdict into a denial naming the factory loan.";
  let digest = 0_u64;
  for @scan index in 0_u64..8_u64 {
    let name = buffer_new(16_u64, 0_u8);
    let data = buffer_new(65536_u64, 0_u8);
    let glyph = digit_byte(value: index);
    set name[0_u64] = 102_u8;
    set name[1_u64] = glyph;
    let room_name = len_of(name);
    let name_fits = ile(2_u64, room_name);
    if name_fits {
    } else {
      break @scan;
    }
    region 'f {
      match open_regular_from<'f, 'f>(factory: &uniq 'f files, root: &'f cwd, name: &'f name) {
        Ok(value: handle) => {
          region 'read {
            match read_at<'read, 'read>(file: &'read handle, destination: &uniq 'read data, file_offset: 0_u64, start: 0_u64, end: 65536_u64) {
              ReadBytes(next: reached) => {
                let room = len_of(data);
                let fits = ile(reached, room);
                if fits {
                  for @fold at in 0_u64..reached {
                    let byte = data[at];
                    let widened = cvt<u8, u64>(byte);
                    set digest = digest +wrap widened;
                  }
                }
              }
              ReadEnd() => {
              }
              ReadFailed(error: problem) => {
              }
            }
          }
        }
        Err(error: problem) => {
        }
      }
    }
  }
  let low = digest % 256_u64;
  match cvt<u64, u8>(low) {
    Ok(value: code) => {
      return exit_status(code: code);
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
}
