+/// Closes the ordinary selection for a query without copying flow origins or
+/// the candidates closure never reads. This temporary state never enters flow:
+/// the input retains every independently live candidate for later kills.
+fn close_ordinary_query(
+    state: &FactState,
+    terms: &TermTable,
+    goals: &GoalTable,
+    ledger: &mut DerivationLedger,
+) -> Rc<ClosedState> {
+    if state.all_derivable || !state.postcondition_candidates {
+        return close(state, terms, goals, ledger);
+    }
+    let mut bounds = BoundStore::with_terms(terms.ids().count());
+    for (left, right, bound, proof) in state.bounds.cells() {
+        let selected = if !ledger.depends_on_postcondition_call(proof) {
+            // A surviving selection was already preferred to every extra.
+            Some((bound, proof))
+        } else {
+            state.bounds.extra.get(&(left, right)).and_then(|extra| {
+                extra
+                    .iter()
+                    .copied()
+                    .filter(|(_, proof)| !ledger.depends_on_postcondition_call(*proof))
+                    .reduce(|current, candidate| {
+                        if candidate.0 < current.0
+                            || (candidate.0 == current.0 && ledger.better(candidate.1, current.1))
+                        {
+                            candidate
+                        } else {
+                            current
+                        }
+                    })
+            })
+        };
+        if let Some((bound, proof)) = selected {
+            bounds.store_single(left, right, bound, proof);
+        }
+    }
+    let mut distinct = HashSet::default();
+    let mut distinct_proofs = HashMap::default();
+    for (&pair, candidates) in state.distinct_candidates.iter() {
+        let selected = candidates
+            .iter()
+            .copied()
+            .filter(|proof| !ledger.depends_on_postcondition_call(*proof))
+            .reduce(|current, candidate| {
+                if ledger.better(candidate, current) {
+                    candidate
+                } else {
+                    current
+                }
+            });
+        if let Some(proof) = selected {
+            distinct.insert(pair);
+            distinct_proofs.insert(pair, proof);
+        }
+    }
+    let ordinary = FactState {
+        closure: state.ordinary_closure.clone(),
+        bounds: Rc::new(bounds),
+        distinct: Rc::new(distinct),
+        distinct_proofs: Rc::new(distinct_proofs),
+        opaque: state.opaque.clone(),
+        opaque_proofs: state.opaque_proofs.clone(),
+        ..FactState::new()
+    };
+    close(&ordinary, terms, goals, ledger)
+}
