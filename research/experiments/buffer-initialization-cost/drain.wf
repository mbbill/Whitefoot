command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, files), writes(cwd, files), allocates(heap) {
  doc "Drains one named file through one reusable initialized buffer and reports a witness of what it read.";
  let page = buffer_new(4096_u64, 0_u8);
  let arguments = 0_u64;
  region {
    set arguments = args_count(args: &args);
  }
  let usable = arguments >= 2_u64;
  if usable {
  } else {
    return exit_status(code: 2_u8);
  }
  let failed = 0_u8;
  let witness = 0_u8;
  let total = 0_u64;
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text) => {
        match relative_path(value: move text) {
          Ok(value: path) => {
            region {
              match reserve_file(factory: &uniq files) {
                Ok(value: permit) => {
                  match open_read(permit: move permit, root: &cwd, path: &path) {
                    FileOpened(value: file) => {
                      let file_offset = 0_u64;
                      loop @chunks {
                        let taken = 0_u64;
                        let ended = 0_u8;
                        region {
                          match read_at(file: &file, destination: &uniq page, file_offset: file_offset, start: 0_u64, end: 4096_u64) {
                            ReadBytes(next: delivered) => {
                              set taken = delivered;
                              set file_offset = file_offset +wrap delivered;
                            }
                            ReadEnd() => {
                              set ended = 1_u8;
                            }
                            ReadFailed(error: problem) => {
                              set ended = 2_u8;
                            }
                          }
                        }
                        if ended == 0_u8 {
                        } else {
                          if ended == 2_u8 {
                            set failed = 1_u8;
                          }
                          break @chunks;
                        }
                        set total = total +wrap taken;
                        let byte = page[0_u64];
                        set witness = witness +wrap byte;
                      }
                    }
                    FileOpenFailed(error: problem, permit: refused) => {
                      set failed = 1_u8;
                    }
                  }
                }
                Err(error: spent) => {
                  set failed = 1_u8;
                }
              }
            }
          }
          Err(error: rejected) => {
            set failed = 1_u8;
          }
        }
      }
      Err(error: absent) => {
        set failed = 1_u8;
      }
    }
  }
  if failed == 0_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let empty = total == 0_u64;
  if empty {
    return exit_status(code: 1_u8);
  }
  let quiet = witness == 0_u8;
  if quiet {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
