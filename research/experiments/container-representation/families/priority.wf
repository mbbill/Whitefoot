fn push(heap: &uniq FixedVector<u64, 16>, value: own u64) -> result: own unit reads(heap), writes(heap) contract {
  requires room_of(deref(heap)) >= 1_u64;
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == len_of(deref(entry(heap))) + 1_u64;
  ensures room_of(deref(heap)) == room_of(deref(entry(heap))) - 1_u64;
  ensures head_of(deref(heap)) <= 0_u64;
} {
  region {
    let at = len_of(deref(heap));
    place_back(vector: &uniq deref(heap), value: value);
    let values = mut_slice_of(&uniq deref(heap));
    loop @rise (
      invariant live: at < len_of(values)
    ) {
      if at == 0_u64 {
        break @rise;
      }
      let before = at - 1_u64;
      let parent = before / 2_u64;
      let lower = values[at];
      let upper = values[parent];
      if upper <= lower {
        break @rise;
      }
      set values[parent] = lower;
      set values[at] = upper;
      set at = parent;
    }
    return unit;
  }
}

fn pop(heap: &uniq FixedVector<u64, 16>) -> minimum: own u64 reads(heap), writes(heap) contract {
  requires len_of(deref(heap)) >= 1_u64;
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == len_of(deref(entry(heap))) - 1_u64;
  ensures head_of(deref(heap)) <= 0_u64;
} {
  region {
    let minimum = deref(heap)[0_u64];
    let last = take_back(vector: &uniq deref(heap));
    let count = len_of(deref(heap));
    if count == 0_u64 {
      return minimum;
    }
    let values = mut_slice_of(&uniq deref(heap));
    set values[0_u64] = last;
    let at = 0_u64;
    loop @sink (
      invariant live: at < len_of(values)
    ) {
      let doubled = at * 2_u64;
      let left = doubled + 1_u64;
      if left >= count {
        break @sink;
      }
      let best = left;
      let right = left + 1_u64;
      if right < count {
        let left_value = values[left];
        let right_value = values[right];
        if right_value < left_value {
          set best = right;
        }
      }
      let lower = values[best];
      let upper = values[at];
      if upper <= lower {
        break @sink;
      }
      set values[at] = lower;
      set values[best] = upper;
      set at = best;
    }
    return minimum;
  }
}

fn empty_heap() -> heap: own FixedVector<u64, 16> pure contract {
  ensures len_of(heap) == 0_u64;
  ensures head_of(heap) <= 0_u64;
} {
  let heap = fixed_vector::<u64, 16>();
  return move heap;
}

fn priority_round(seed: own u64, entering: own u64) -> (checksum: own u64, next_state: own u64) pure {
  let checksum = entering;
  let state = seed;
  let heap = empty_heap();
  region {
    for (
      index in 0_u64..16_u64,
      invariant grown: len_of(heap) >= index,
      invariant spare: room_of(heap) + index >= 16_u64,
      invariant flat: head_of(heap) <= 0_u64
    ) {
      let product = state *wrap 6364136223846793005_u64;
      set state = product +wrap 1442695040888963407_u64;
      let value = state % 97_u64;
      push(heap: &uniq heap, value: value);
    }
    for (
      index in 0_u64..16_u64,
      invariant remaining: len_of(heap) + index >= 16_u64,
      invariant flat: head_of(heap) <= 0_u64
    ) {
      let value = pop(heap: &uniq heap);
      let product = checksum *wrap 1099511628211_u64;
      set checksum = product +wrap value;
    }
    return checksum, state;
  }
}

fn priority_trace(seed: own u64, rounds: own u64) -> checksum: own u64 pure {
  let checksum = 0_u64;
  let state = seed;
  for (round in 0_u64..rounds) {
    set (checksum, state) = priority_round(seed: state, entering: checksum);
  }
  return checksum;
}

command fn main() -> status: own ExitStatus pure {
  let heap = fixed_vector::<u64, 16>();
  region {
    push(heap: &uniq heap, value: 9_u64);
    push(heap: &uniq heap, value: 2_u64);
    push(heap: &uniq heap, value: 7_u64);
    push(heap: &uniq heap, value: 2_u64);
    push(heap: &uniq heap, value: 0_u64);
    push(heap: &uniq heap, value: 8_u64);
    push(heap: &uniq heap, value: 1_u64);
    let v0 = pop(heap: &uniq heap);
    let v1 = pop(heap: &uniq heap);
    let v2 = pop(heap: &uniq heap);
    let v3 = pop(heap: &uniq heap);
    let v4 = pop(heap: &uniq heap);
    let v5 = pop(heap: &uniq heap);
    let v6 = pop(heap: &uniq heap);
    if v0 != 0_u64 {
      return exit_status(code: 1_u8);
    }
    if v1 != 1_u64 {
      return exit_status(code: 2_u8);
    }
    if v2 != 2_u64 {
      return exit_status(code: 3_u8);
    }
    if v3 != 2_u64 {
      return exit_status(code: 4_u8);
    }
    if v4 != 7_u64 {
      return exit_status(code: 5_u8);
    }
    if v5 != 8_u64 {
      return exit_status(code: 6_u8);
    }
    if v6 != 9_u64 {
      return exit_status(code: 7_u8);
    }
    push(heap: &uniq heap, value: 5_u64);
    let value = pop(heap: &uniq heap);
    if value != 5_u64 {
      return exit_status(code: 8_u8);
    }
    return exit_status(code: 0_u8);
  }
}
