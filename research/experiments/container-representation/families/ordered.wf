struct LeafPair {
  low: u64;
  high: u64;
}

enum SplitResult['s] {
  Split(separator: u64, left: Box<'s, LeafPair>, right: Box<'s, LeafPair>);
  Duplicate();
  Refused();
}

fn allocate_split['s](store: &uniq Heap<'s>, first: own u64, second: own u64, third: own u64, fourth: own u64) -> result: own SplitResult<'s> reads(store), writes(store), allocates(store) {
  doc "Allocates both children of a B+ tree leaf split before publishing the result. If either allocation is refused, every successful temporary allocation is released and Refused is returned.";
  let left_leaf = LeafPair(low: first, high: second);
  region {
    match heap_box(store: &uniq deref(store), value: move left_leaf) {
      Err(error: left_back) => {
        return Refused<'s>();
      }
      Ok(value: left) => {
        let right_leaf = LeafPair(low: third, high: fourth);
        region {
          match heap_box(store: &uniq deref(store), value: move right_leaf) {
            Err(error: right_back) => {
              return Refused<'s>();
            }
            Ok(value: right) => {
              return Split(separator: third, left: move left, right: move right);
            }
          }
        }
      }
    }
  }
}

fn split_full_leaf['s](store: &uniq Heap<'s>, first: own u64, second: own u64, third: own u64, candidate: own u64) -> result: own SplitResult<'s> reads(store), writes(store), allocates(store) contract {
  requires first < second;
  requires second < third;
} {
  doc "One actual ordered-node component: insert a distinct key into a full three-key B+ tree leaf, split the sorted four keys into two owning heap cells, and copy the right minimum into the separator. Duplicate input performs no allocation. This is a node primitive, not a complete ordered map or a capacity claim about one.";
  if candidate == first {
    return Duplicate<'s>();
  }
  if candidate == second {
    return Duplicate<'s>();
  }
  if candidate == third {
    return Duplicate<'s>();
  }
  if candidate < first {
    return allocate_split(store: move store, first: candidate, second: first, third: second, fourth: third);
  }
  if candidate < second {
    return allocate_split(store: move store, first: first, second: candidate, third: second, fourth: third);
  }
  if candidate < third {
    return allocate_split(store: move store, first: first, second: second, third: candidate, fourth: third);
  }
  return allocate_split(store: move store, first: first, second: second, third: third, fourth: candidate);
}

fn main['heap](heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  doc "Independent expected behavior: inserting 25 into [10,20,30] yields owning leaves [10,20] and [25,30] with separator 25; inserting 5 exercises the leading position and yields [5,10] and [20,30] with separator 20; inserting duplicate 20 returns Duplicate without allocation. Any allocation refusal exits 70.";
  region {
    match split_full_leaf(store: &uniq heap, first: 10_u64, second: 20_u64, third: 30_u64, candidate: 25_u64) {
      Refused() => {
        return exit_status(code: 70_u8);
      }
      Duplicate() => {
        return exit_status(code: 10_u8);
      }
      Split(separator: promoted, left: left_child, right: right_child) => {
        if promoted == 25_u64 {
        } else {
          return exit_status(code: 11_u8);
        }
        if deref(left_child).low == 10_u64 {
        } else {
          return exit_status(code: 12_u8);
        }
        if deref(left_child).high == 20_u64 {
        } else {
          return exit_status(code: 13_u8);
        }
        if deref(right_child).low == 25_u64 {
        } else {
          return exit_status(code: 14_u8);
        }
        if deref(right_child).high == 30_u64 {
        } else {
          return exit_status(code: 15_u8);
        }
      }
    }
  }
  region {
    match split_full_leaf(store: &uniq heap, first: 10_u64, second: 20_u64, third: 30_u64, candidate: 5_u64) {
      Refused() => {
        return exit_status(code: 70_u8);
      }
      Duplicate() => {
        return exit_status(code: 20_u8);
      }
      Split(separator: leading_separator, left: leading_left, right: leading_right) => {
        if leading_separator == 20_u64 {
        } else {
          return exit_status(code: 21_u8);
        }
        if deref(leading_left).low == 5_u64 {
        } else {
          return exit_status(code: 22_u8);
        }
        if deref(leading_left).high == 10_u64 {
        } else {
          return exit_status(code: 23_u8);
        }
        if deref(leading_right).low == 20_u64 {
        } else {
          return exit_status(code: 24_u8);
        }
        if deref(leading_right).high == 30_u64 {
        } else {
          return exit_status(code: 25_u8);
        }
      }
    }
  }
  region {
    match split_full_leaf(store: &uniq heap, first: 10_u64, second: 20_u64, third: 30_u64, candidate: 20_u64) {
      Duplicate() => {
        return exit_status(code: 0_u8);
      }
      Refused() => {
        return exit_status(code: 30_u8);
      }
      Split(separator: unexpected_separator, left: unexpected_left, right: unexpected_right) => {
        return exit_status(code: 31_u8);
      }
    }
  }
}
