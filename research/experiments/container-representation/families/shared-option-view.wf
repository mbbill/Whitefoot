struct Entry {
  value: u64;
}

struct Slot {
  stored_entry: Option<Entry>;
}

fn view(stored_entry: &Option<Entry>) -> result: own u64 reads(stored_entry) {
  match deref(stored_entry) {
    Some(value: present) => {
      return deref(present).value;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn lookup(slots: &FixedVector<Slot, 1>) -> result: own u64 reads(slots) contract {
  requires 1_u64 <= len_of(deref(slots));
} {
  region {
    let found = view(stored_entry: &deref(slots)[0_u64].stored_entry);
    return found;
  }
}

command fn main() -> status: own ExitStatus pure {
  let present = Entry(value: 37_u64);
  let some = Some<Entry>(value: move present);
  let none = None<Entry>();
  let occupied = Slot(stored_entry: move some);
  let vacant = Slot(stored_entry: move none);
  let first = fixed_vector::<Slot, 1>();
  region {
    place_back(vector: &uniq first, value: move occupied);
  }
  let with_value = move first;
  let second = fixed_vector::<Slot, 1>();
  region {
    place_back(vector: &uniq second, value: move vacant);
  }
  let without_value = move second;
  region {
    let found = lookup(slots: &with_value);
    if found != 37_u64 {
      return exit_status(code: 1_u8);
    }
    let absent = lookup(slots: &without_value);
    if absent != 0_u64 {
      return exit_status(code: 2_u8);
    }
  }
  return exit_status(code: 0_u8);
}
