fn digest['heap](run: &Vector<'heap, u8>, status: own u64) -> result: own u64 reads(run) contract {
  requires head_of(deref(run)) <= 0_u64;
} {
  let result = status;
  let length = len_of(deref(run));
  for (index in 0_u64..length) {
    let byte = deref(run)[index];
    let word = cvt::<u8, u64>(byte);
    let prefix = result *wrap 131_u64;
    set result = prefix +wrap word;
  }
  return result;
}

fn growth_trace['heap](store: &uniq Heap<'heap>, seed: own u8, initial: own u64, count: own u64, limit: own u64) -> result: own u64 reads(store), writes(store), allocates(store) contract {
  requires initial >= 1_u64;
  requires initial <= count;
  requires count <= 1048576_u64;
  requires limit <= 1048576_u64;
} {
  region {
    match heap_vector::<u8>(store: &uniq deref(store), count: initial) {
      None() => {
        return 0_u64;
      }
      Some(value: original) => {
        let state = seed;
        for (
          index in 0_u64..initial,
          invariant filled: len_of(original) >= index,
          invariant bound: len_of(original) <= index,
          invariant spare: room_of(original) + index >= initial,
          invariant flat: head_of(original) <= 0_u64
        ) {
          let product = state *wrap 73_u8;
          set state = product +wrap 41_u8;
          place_back(vector: &uniq original, value: state);
        }
        if count == initial {
          region {
            return digest(run: &original, status: 1_u64);
          }
        }
        if count > limit {
          region {
            return digest(run: &original, status: 2_u64);
          }
        }
        region {
          match heap_vector::<u8>(store: &uniq deref(store), count: count) {
            None() => {
              region {
                return digest(run: &original, status: 3_u64);
              }
            }
            Some(value: grown) => {
              for (
                index in 0_u64..initial,
                invariant filled: len_of(grown) >= index,
                invariant bound: len_of(grown) <= index,
                invariant spare: room_of(grown) + index >= count,
                invariant flat: head_of(grown) <= 0_u64
              ) {
                let byte = original[index];
                place_back(vector: &uniq grown, value: byte);
              }
              dispose original;
              for (
                index in initial..count,
                invariant filled: len_of(grown) >= index,
                invariant bound: len_of(grown) <= index,
                invariant spare: room_of(grown) + index >= count,
                invariant flat: head_of(grown) <= 0_u64
              ) {
                let product = state *wrap 73_u8;
                set state = product +wrap 41_u8;
                place_back(vector: &uniq grown, value: state);
              }
              region {
                return digest(run: &grown, status: 1_u64);
              }
            }
          }
        }
      }
    }
  }
}

fn main['heap](heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  region {
    let result = growth_trace(store: &uniq heap, seed: 19_u8, initial: 16_u64, count: 32_u64, limit: 64_u64);
    if result == 0_u64 {
      return exit_status(code: 70_u8);
    }
    if result == 8731451624484636299_u64 {
      return exit_status(code: 70_u8);
    }
    if result != 15918187348717743889_u64 {
      return exit_status(code: 1_u8);
    }
    let refused = growth_trace(store: &uniq heap, seed: 19_u8, initial: 16_u64, count: 32_u64, limit: 16_u64);
    if refused == 0_u64 {
      return exit_status(code: 70_u8);
    }
    if refused != 9302688228678555466_u64 {
      return exit_status(code: 2_u8);
    }
    let retained = growth_trace(store: &uniq heap, seed: 19_u8, initial: 16_u64, count: 16_u64, limit: 16_u64);
    if retained == 0_u64 {
      return exit_status(code: 70_u8);
    }
    if retained != 9873924832872474633_u64 {
      return exit_status(code: 3_u8);
    }
    return exit_status(code: 0_u8);
  }
}
