struct Entry['s] {
  key: u64;
  payload: Box<'s, u64>;
}

enum FourBoxes['s] {
  Ready(first: Box<'s, u64>, second: Box<'s, u64>, replacement: Box<'s, u64>, inserted: Box<'s, u64>);
  Refused();
}

fn allocate_four['s](store: &uniq Heap<'s>) -> result: own FourBoxes<'s> reads(store), writes(store), allocates(store) {
  region {
    match heap_box(store: &uniq deref(store), value: 10_u64) {
      Err(error: first_back) => {
        return Refused<'s>();
      }
      Ok(value: first) => {
        region {
          match heap_box(store: &uniq deref(store), value: 20_u64) {
            Err(error: second_back) => {
              return Refused<'s>();
            }
            Ok(value: second) => {
              region {
                match heap_box(store: &uniq deref(store), value: 11_u64) {
                  Err(error: replacement_back) => {
                    return Refused<'s>();
                  }
                  Ok(value: replacement) => {
                    region {
                      match heap_box(store: &uniq deref(store), value: 30_u64) {
                        Err(error: inserted_back) => {
                          return Refused<'s>();
                        }
                        Ok(value: inserted) => {
                          return Ready(first: move first, second: move second, replacement: move replacement, inserted: move inserted);
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

enum BoxSlotView {
  Occupied(key: u64, value: u64);
  Empty();
}

fn view_box_entry['s](entry: &Option<Entry<'s>>, same: &Option<Entry<'s>>) -> result: own BoxSlotView reads(entry) {
  match deref(entry) {
    Some(value: present) => {
      return Occupied(key: deref(present).key, value: deref(deref(present).payload));
    }
    None() => {
      return Empty();
    }
  }
}

fn run_boxes['s](store: &uniq Heap<'s>, first: own Box<'s, u64>, second: own Box<'s, u64>, replacement: own Box<'s, u64>, inserted: own Box<'s, u64>) -> code: own u8 reads(first, second, inserted), writes(store, first, second, inserted) {
  let empty0 = None<Entry<'s>>();
  let first_entry = Entry(key: 1_u64, payload: move first);
  let first_slot = Some<Entry<'s>>(value: move first_entry);
  let second_entry = Entry(key: 5_u64, payload: move second);
  let second_slot = Some<Entry<'s>>(value: move second_entry);
  let inserted_entry = Entry(key: 9_u64, payload: move inserted);
  let inserted_slot = Some<Entry<'s>>(value: move inserted_entry);
  let entries = fixed_vector::<Option<Entry<'s>>, 4>();
  set entries = place_back(vector: move entries, value: move empty0);
  set entries = place_back(vector: move entries, value: move first_slot);
  set entries = place_back(vector: move entries, value: move second_slot);
  set entries = place_back(vector: move entries, value: move inserted_slot);
  let states = fixed_vector::<u64, 4>();
  set states = place_back(vector: move states, value: 0_u64);
  set states = place_back(vector: move states, value: 1_u64);
  set states = place_back(vector: move states, value: 1_u64);
  set states = place_back(vector: move states, value: 1_u64);
  let replacement_entry = Entry(key: 5_u64, payload: move replacement);
  let replacement_slot = Some<Entry<'s>>(value: move replacement_entry);
  let previous = replace entries[2_u64] = move replacement_slot;
  match previous {
    None() => {
      return 10_u8;
    }
    Some(value: previous_entry) => {
      let Entry(key: previous_key, payload: previous_payload) = move previous_entry;
      if previous_key == 5_u64 {
      } else {
        return 11_u8;
      }
      if deref(previous_payload) == 20_u64 {
      } else {
        return 12_u8;
      }
    }
  }
  let delete_empty = None<Entry<'s>>();
  let removed = replace entries[1_u64] = move delete_empty;
  let old_state = states[1_u64];
  set states[1_u64] = 2_u64;
  let recycled = match removed {
    None() => {
      return 20_u8;
    }
    Some(value: removed_entry) => {
      let Entry(key: removed_key, payload: removed_payload) = move removed_entry;
      if removed_key == 1_u64 {
      } else {
        return 21_u8;
      }
      if deref(removed_payload) == 10_u64 {
        give move removed_payload;
      }
      return 22_u8;
    }
  }
  if states[1_u64] == 2_u64 {
  } else {
    return 30_u8;
  }
  region {
    let through_first_collision = view_box_entry::<'s>(entry: &entries[2_u64], same: &entries[2_u64]);
    match through_first_collision {
      Empty() => {
        return 31_u8;
      }
      Occupied(key: found_five_key, value: found_five_value) => {
        if found_five_key == 5_u64 {
        } else {
          return 32_u8;
        }
        if found_five_value == 11_u64 {
        } else {
          return 33_u8;
        }
      }
    }
  }
  region {
    let through_second_collision = view_box_entry::<'s>(entry: &entries[3_u64], same: &entries[3_u64]);
    match through_second_collision {
      Empty() => {
        return 34_u8;
      }
      Occupied(key: found_nine_key, value: found_nine_value) => {
        if found_nine_key == 9_u64 {
        } else {
          return 35_u8;
        }
        if found_nine_value == 30_u64 {
        } else {
          return 36_u8;
        }
      }
    }
  }
  let reused_entry = Entry(key: 13_u64, payload: move recycled);
  let reused_slot = Some<Entry<'s>>(value: move reused_entry);
  let tombstone_contents = replace entries[1_u64] = move reused_slot;
  let tombstone_state = states[1_u64];
  set states[1_u64] = 1_u64;
  match tombstone_contents {
    Some(value: unexpected_tombstone_entry) => {
      return 40_u8;
    }
    None() => {
    }
  }
  let target_empty0 = None<Entry<'s>>();
  let target_empty1 = None<Entry<'s>>();
  let target_empty2 = None<Entry<'s>>();
  let target_empty3 = None<Entry<'s>>();
  let target_empty4 = None<Entry<'s>>();
  let target_empty5 = None<Entry<'s>>();
  let target_empty6 = None<Entry<'s>>();
  let target_empty7 = None<Entry<'s>>();
  let target = fixed_vector::<Option<Entry<'s>>, 8>();
  set target = place_back(vector: move target, value: move target_empty0);
  set target = place_back(vector: move target, value: move target_empty1);
  set target = place_back(vector: move target, value: move target_empty2);
  set target = place_back(vector: move target, value: move target_empty3);
  set target = place_back(vector: move target, value: move target_empty4);
  set target = place_back(vector: move target, value: move target_empty5);
  set target = place_back(vector: move target, value: move target_empty6);
  set target = place_back(vector: move target, value: move target_empty7);
  let target_states = fixed_vector::<u64, 8>();
  set target_states = place_back(vector: move target_states, value: 0_u64);
  set target_states = place_back(vector: move target_states, value: 0_u64);
  set target_states = place_back(vector: move target_states, value: 0_u64);
  set target_states = place_back(vector: move target_states, value: 0_u64);
  set target_states = place_back(vector: move target_states, value: 0_u64);
  set target_states = place_back(vector: move target_states, value: 0_u64);
  set target_states = place_back(vector: move target_states, value: 0_u64);
  set target_states = place_back(vector: move target_states, value: 0_u64);
  let observe_after = 2_u64;
  let visited = 0_u64;
  let observed_prefix = False();
  for (
    at in 0_u64..4_u64,
    invariant source_full: len_of(entries) >= 4_u64,
    invariant source_states_full: len_of(states) >= 4_u64,
    invariant target_full: len_of(target) >= 8_u64,
    invariant target_states_full: len_of(target_states) >= 8_u64
  ) {
    if visited == observe_after {
      if states[2_u64] == 1_u64 {
      } else {
        return 50_u8;
      }
      let observed_prefix_source = view_box_entry::<'s>(entry: &entries[2_u64], same: &entries[2_u64]);
      match observed_prefix_source {
        Empty() => {
          return 51_u8;
        }
        Occupied(key: remaining_key, value: remaining_value) => {
          if remaining_key == 5_u64 {
          } else {
            return 52_u8;
          }
          if remaining_value == 11_u64 {
          } else {
            return 53_u8;
          }
        }
      }
      if target_states[5_u64] == 1_u64 {
      } else {
        return 54_u8;
      }
      let observed_prefix_target = view_box_entry::<'s>(entry: &target[5_u64], same: &target[5_u64]);
      match observed_prefix_target {
        Empty() => {
          return 55_u8;
        }
        Occupied(key: observed_prefix_key, value: observed_prefix_value) => {
          if observed_prefix_key == 13_u64 {
          } else {
            return 56_u8;
          }
          if observed_prefix_value == 10_u64 {
          } else {
            return 57_u8;
          }
        }
      }
      set observed_prefix = True();
    }
    if states[at] == 1_u64 {
      let source_empty = None<Entry<'s>>();
      let extracted = replace entries[at] = move source_empty;
      match extracted {
        None() => {
          set states[at] = 0_u64;
        }
        Some(value: moved_entry) => {
          let key = moved_entry.key;
          let pending = Some<Entry<'s>>(value: move moved_entry);
          for (
            step in 0_u64..8_u64,
            invariant target_inner_full: len_of(target) >= 8_u64,
            invariant target_states_inner_full: len_of(target_states) >= 8_u64
          ) {
            let advanced = key +wrap step;
            let destination = advanced % 8_u64;
            if target_states[destination] == 0_u64 {
              let previous_target = replace target[destination] = move pending;
              set pending = move previous_target;
              set target_states[destination] = 1_u64;
              break;
            }
          }
          match pending {
            Some(value: unplaced_entry) => {
              let unplaced = Some<Entry<'s>>(value: move unplaced_entry);
              let source_previous = replace entries[at] = move unplaced;
              return 90_u8;
            }
            None() => {
              set states[at] = 0_u64;
            }
          }
        }
      }
    }
    set visited = visited +wrap 1_u64;
  }
  if observed_prefix {
  } else {
    return 55_u8;
  }
  if states[1_u64] == 0_u64 {
  } else {
    return 60_u8;
  }
  if states[2_u64] == 0_u64 {
  } else {
    return 61_u8;
  }
  if states[3_u64] == 0_u64 {
  } else {
    return 62_u8;
  }
  if target_states[1_u64] == 1_u64 {
  } else {
    return 63_u8;
  }
  if target_states[5_u64] == 1_u64 {
  } else {
    return 64_u8;
  }
  if target_states[6_u64] == 1_u64 {
  } else {
    return 65_u8;
  }
  let final_empty1 = None<Entry<'s>>();
  let final_option9 = replace target[1_u64] = move final_empty1;
  match final_option9 {
    None() => {
      return 70_u8;
    }
    Some(value: final_entry9) => {
      let Entry(key: final_key9, payload: final_payload9) = move final_entry9;
      if final_key9 == 9_u64 {
      } else {
        return 71_u8;
      }
      if deref(final_payload9) == 30_u64 {
      } else {
        return 72_u8;
      }
    }
  }
  let final_empty5 = None<Entry<'s>>();
  let final_option13 = replace target[5_u64] = move final_empty5;
  match final_option13 {
    None() => {
      return 73_u8;
    }
    Some(value: final_entry13) => {
      let Entry(key: final_key13, payload: final_payload13) = move final_entry13;
      if final_key13 == 13_u64 {
      } else {
        return 74_u8;
      }
      if deref(final_payload13) == 10_u64 {
      } else {
        return 75_u8;
      }
    }
  }
  let final_empty6 = None<Entry<'s>>();
  let final_option5 = replace target[6_u64] = move final_empty6;
  match final_option5 {
    None() => {
      return 76_u8;
    }
    Some(value: final_entry5) => {
      let Entry(key: final_key5, payload: final_payload5) = move final_entry5;
      if final_key5 == 5_u64 {
      } else {
        return 77_u8;
      }
      if deref(final_payload5) == 11_u64 {
        return 0_u8;
      }
      return 78_u8;
    }
  }
}

command fn main(command.heap as heap: own Heap) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  region {
    match allocate_four(store: &uniq heap) {
      Refused() => {
        return exit_status(code: 70_u8);
      }
      Ready(first: box_first, second: box_second, replacement: box_replacement, inserted: box_inserted) => {
        let code = run_boxes(store: &uniq heap, first: move box_first, second: move box_second, replacement: move box_replacement, inserted: move box_inserted);
        return exit_status(code: code);
      }
    }
  }
}
