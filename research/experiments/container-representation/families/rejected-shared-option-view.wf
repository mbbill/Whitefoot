struct Entry {
  value: u64;
}

struct Slot {
  entry: Option<Entry>;
}

fn view(entry: &Option<Entry>) -> result: own u64 reads(entry) {
  match deref(entry) {
    Some(value: present) => {
      return deref(present).value;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn lookup(slots: &FixedVector<Slot, 1>) -> result: own u64 reads(slots) contract {
  requires 1_u64 <= len_of(deref(slots));
} {
  region {
    let found = view(entry: &deref(slots)[0_u64].entry);
    return found;
  }
}
