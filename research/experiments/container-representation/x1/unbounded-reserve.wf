fn reserve(values: &Box<Slots<u64>>, count: own u64) -> result: own unit writes(values) contract {
  requires count >= deref(values).inner.cap;
} {
  grow(cell: values, capacity: count);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  let values = box_slots_new::<u64>(capacity: 0_u64);
  reserve(values: &values, count: 8_u64);
  return exit_status(code: 0_u8);
}
