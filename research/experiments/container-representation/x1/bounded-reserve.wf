fn reserve(values: &Box<Slots<u64>>, count: own u64) -> result: own unit writes(values) contract {
  requires count >= deref(values).inner.cap;
  requires count <= 1024_u64;
  ensures deref(values).inner.cap == count;
  ensures deref(values).inner.len == deref(entry(values)).inner.len;
} {
  grow(cell: values, capacity: count);
  return unit;
}

fn main() -> status: own ExitStatus pure {
  let values = box_slots_new::<u64>(capacity: 0_u64);
  reserve(values: &values, count: 8_u64);
  place_back(window: &values.inner, value: 7_u64);
  let got = take_back(window: &values.inner);
  if got == 7_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
