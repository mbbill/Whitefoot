fn fold(part: &[u64], seed: own u64) -> result: own u64 reads(part) {
  let result = seed;
  let count = deref(part).len;
  for (i in 0_u64..count) {
    let digit = deref(part)[i];
    let prefix = result *wrap 10_u64;
    set result = prefix +wrap digit;
  }
  return result;
}

fn main() -> status: own ExitStatus pure {
  let storage = array_filled::<u64, 8>(value: 0_u64);
  set storage[6_u64] = 1_u64;
  set storage[7_u64] = 2_u64;
  set storage[0_u64] = 3_u64;
  set storage[1_u64] = 4_u64;
  let first = fold(part: &storage[6_u64..8_u64], seed: 0_u64);
  let complete = fold(part: &storage[0_u64..2_u64], seed: first);
  if complete == 1234_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
