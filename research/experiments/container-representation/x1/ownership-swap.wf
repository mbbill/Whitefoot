nodrop struct Ticket {
  id: u64;
}

enum Occupancy<T> {
  Vacant();
  Live(value: T);
}

fn exchange<T>(slot: &Occupancy<T>, offered: own Occupancy<T>) -> previous: own Occupancy<T> writes(slot) {
  swap(first: slot, second: &offered);
  return move offered;
}

fn consume_ticket(state: own Occupancy<Ticket>) -> observed: own u64 pure {
  match move state {
    Vacant() => {
      return 0_u64;
    }
    Live(value: ticket) => {
      let Ticket(id: number) = move ticket;
      return number;
    }
  }
}

fn copy_exchange() -> observed: own u64 pure {
  let slot = Live<u64>(value: 11_u64);
  let offered = Live<u64>(value: 12_u64);
  let previous = exchange::<u64>(slot: &slot, offered: offered);
  match slot {
    Vacant() => {
      return 0_u64;
    }
    Live(value: installed) => {
      if installed != 12_u64 {
        return 0_u64;
      }
    }
  }
  match previous {
    Vacant() => {
      return 0_u64;
    }
    Live(value: number) => {
      return number;
    }
  }
}

fn read_box(slot: &Occupancy<Box<u64>>) -> observed: own u64 reads(slot) {
  match deref(slot) {
    Vacant() => {
      return 0_u64;
    }
    Live(value: owner) => {
      return deref(owner).inner;
    }
  }
}

fn box_exchange() -> observed: own u64 pure {
  let first = box_new::<u64>(value: 21_u64);
  let slot = Live<Box<u64>>(value: move first);
  let next = box_new::<u64>(value: 22_u64);
  let offered = Live<Box<u64>>(value: move next);
  let previous = exchange::<Box<u64>>(slot: &slot, offered: move offered);
  let installed = read_box(slot: &slot);
  if installed != 22_u64 {
    return 0_u64;
  }
  match move previous {
    Vacant() => {
      return 0_u64;
    }
    Live(value: owner) => {
      return owner.inner;
    }
  }
}

fn main() -> status: own ExitStatus pure {
  let cells = slots_new::<Occupancy<Ticket>, 2>();
  let vacant = Vacant<Ticket>();
  place_back(window: &cells, value: move vacant);
  let nine = Ticket(id: 9_u64);
  let occupied = Live<Ticket>(value: move nine);
  place_back(window: &cells, value: move occupied);
  let index = 0_u64;
  let seven = Ticket(id: 7_u64);
  let offered_first = Live<Ticket>(value: move seven);
  let first = exchange::<Ticket>(slot: &cells[index], offered: move offered_first);
  let was_empty = consume_ticket(state: move first);
  let eight = Ticket(id: 8_u64);
  let offered_second = Live<Ticket>(value: move eight);
  let replaced = exchange::<Ticket>(slot: &cells[index], offered: move offered_second);
  let old = consume_ticket(state: move replaced);
  let empty = Vacant<Ticket>();
  let removed = exchange::<Ticket>(slot: &cells[index], offered: move empty);
  let taken = consume_ticket(state: move removed);
  let back = take_back(window: &cells);
  let last = consume_ticket(state: move back);
  let front = take_back(window: &cells);
  let empty_again = consume_ticket(state: move front);
  free_empty(window: move cells);
  if was_empty != 0_u64 {
    return exit_status(code: 1_u8);
  }
  if old != 7_u64 {
    return exit_status(code: 2_u8);
  }
  if taken != 8_u64 {
    return exit_status(code: 3_u8);
  }
  if last != 9_u64 {
    return exit_status(code: 4_u8);
  }
  if empty_again != 0_u64 {
    return exit_status(code: 5_u8);
  }
  let copied = copy_exchange();
  if copied != 11_u64 {
    return exit_status(code: 6_u8);
  }
  let boxed = box_exchange();
  if boxed != 21_u64 {
    return exit_status(code: 7_u8);
  }
  return exit_status(code: 0_u8);
}
