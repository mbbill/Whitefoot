struct Record {
  bytes: array<u8, 4096>;
}

fn make_record(seed: own u8) -> result: own Result<Record, u8> pure {
  if seed == 0_u8 {
    return Err<Record, u8>(error: 7_u8);
  }
  let bytes = array_new::<u8, 4096>(seed);
  let record = Record(bytes: move bytes);
  return Ok<Record, u8>(value: move record);
}

fn build_record(seed: own u8) -> result: own FixedVector<Record, 2> pure {
  let rows = fixed_vector::<Record, 2>();
  match make_record(seed: seed) {
    Err(error: code) => {
      return move rows;
    }
    Ok(value: item) => {
      let built = place_back(vector: move rows, value: move item);
      return move built;
    }
  }
}

command fn main() -> status: own ExitStatus pure {
  let built = build_record(seed: 9_u8);
  let count = len_of(built);
  if count == 1_u64 {
    let (rest, record) = take_front(vector: move built);
    region {
      let bytes = slice_of(&record.bytes);
      for (at in 0_u64..4096_u64) {
        let byte = bytes[at];
        if byte == 9_u8 {
        } else {
          return exit_status(code: 1_u8);
        }
      }
    }
    let failed = build_record(seed: 0_u8);
    let remaining = len_of(failed);
    if remaining == 0_u64 {
      return exit_status(code: 0_u8);
    }
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 1_u8);
}
