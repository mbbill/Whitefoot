struct VectorDigest {
  value: u64;
}

fn vector_digest_accept(env: &uniq VectorDigest, value: own u64) -> result: own unit reads(env.value), writes(env.value) {
  let folded = deref(env).value *wrap 131_u64;
  set deref(env).value = folded +wrap value;
  return unit;
}

actual VectorDigestDrain : VectorDrain<u64, VectorDigest> {
  accept = vector_digest_accept;
}

fn vector_library_round['s](store: &uniq Heap<'s>, seed: own u64, reserve_first: own Bool) -> result: own u64 reads(store), writes(store), allocates(store) {
  region {
    match grow_vector_new::<u64>(store: &uniq deref(store)) {
      None() => {
        return 70_u64;
      }
      Some(value: values) => {
        if reserve_first {
          region {
            match grow_vector_reserve::<u64>(values: &uniq values, store: &uniq deref(store), total: 32_u64) {
              Err(error: marker) => {
                return 70_u64;
              }
              Ok(value: capacity) => {
              }
            }
          }
        }
        let initial = len_of(values.storage);
        if initial == 0_u64 {
        } else {
          return 71_u64;
        }
        for @append (
          index in 0_u64..32_u64,
          invariant length_lo: len_of(values.storage) >= index,
          invariant length_hi: len_of(values.storage) <= index
        ) {
          let item = seed +wrap index;
          region {
            match grow_vector_append::<u64>(values: &uniq values, store: &uniq deref(store), value: item) {
              Err(error: back) => {
                return 70_u64;
              }
              Ok(value: length) => {
              }
            }
          }
        }
        invariant complete_lo: len_of(values.storage) >= 32_u64;
        invariant complete_hi: len_of(values.storage) <= 32_u64;
        region {
          match grow_vector_insert::<u64>(values: &uniq values, store: &uniq deref(store), index: 16_u64, value: seed) {
            Err(error: back) => {
              return 70_u64;
            }
            Ok(value: length) => {
            }
          }
        }
        region {
          let removed = grow_vector_remove::<u64>(values: &uniq values, index: 16_u64);
          let digest = VectorDigest(value: removed);
          region {
            grow_vector_drain::<VectorDigestDrain>(values: &uniq values, env: &uniq digest);
          }
          return digest.value;
        }
      }
    }
  }
}

fn vector_library_reserved_trace['s](store: &uniq Heap<'s>, rounds: own u64, seed: own u64) -> result: own u64 reads(store), writes(store), allocates(store) {
  let digest = seed;
  for (round in 0_u64..rounds) {
    let next_seed = seed +wrap round;
    let reserve_first = True();
    let observed = vector_library_round(store: &uniq deref(store), seed: next_seed, reserve_first: reserve_first);
    let folded = digest *wrap 257_u64;
    set digest = folded +wrap observed;
  }
  return digest;
}

fn vector_library_growth_trace['s](store: &uniq Heap<'s>, rounds: own u64, seed: own u64) -> result: own u64 reads(store), writes(store), allocates(store) {
  let digest = seed;
  for (round in 0_u64..rounds) {
    let next_seed = seed +wrap round;
    let reserve_first = False();
    let observed = vector_library_round(store: &uniq deref(store), seed: next_seed, reserve_first: reserve_first);
    let folded = digest *wrap 257_u64;
    set digest = folded +wrap observed;
  }
  return digest;
}

fn main['heap](heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  region {
    let reserved = vector_library_reserved_trace(store: &uniq heap, rounds: 3_u64, seed: 17_u64);
    let growth = vector_library_growth_trace(store: &uniq heap, rounds: 3_u64, seed: 17_u64);
    if reserved == growth {
      return exit_status(code: 0_u8);
    }
    return exit_status(code: 1_u8);
  }
}
