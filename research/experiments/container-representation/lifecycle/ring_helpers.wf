fn wrapped() -> result: own FixedVector<u8, 4> pure contract {
  ensures len_of(result) == 4_u64;
} {
  let empty = fixed_vector::<u8, 4>();
  region {
    place_back(vector: &uniq empty, value: 1_u8);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: 2_u8);
  }
  let two = move one;
  region {
    place_back(vector: &uniq two, value: 3_u8);
  }
  let three = move two;
  region {
    let first = take_front(vector: &uniq three);
    let rest = move three;
    region {
      place_back(vector: &uniq rest, value: 4_u8);
    }
    let four = move rest;
    region {
      place_back(vector: &uniq four, value: 5_u8);
    }
    let five = move four;
    return move five;
  }
}
