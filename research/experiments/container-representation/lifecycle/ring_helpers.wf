fn wrapped() -> result: own FixedVector<u8, 4> pure contract {
  ensures len_of(result) == 4_u64;
} {
  let empty = fixed_vector::<u8, 4>();
  let one = place_back(vector: move empty, value: 1_u8);
  let two = place_back(vector: move one, value: 2_u8);
  let three = place_back(vector: move two, value: 3_u8);
  let (rest, first) = take_front(vector: move three);
  let four = place_back(vector: move rest, value: 4_u8);
  let five = place_back(vector: move four, value: 5_u8);
  return move five;
}
