struct Block['s] {
  bytes: Vector<'s, u8>;
}

fn pass_bytes['s: affine](bytes: own Vector<'s, u8>) -> result: own Vector<'s, u8> pure contract {
  ensures cap_of(result) == cap_of(bytes);
  ensures len_of(result) == len_of(bytes);
} {
  return move bytes;
}

fn take_block['s: affine](free: &uniq FixedVector<Vector<'s, u8>, 2>) -> block: own Vector<'s, u8> reads(free), writes(free) contract {
  requires len_of(deref(free)) > 0_u64;
  ensures len_of(deref(free)) + 1_u64 == len_of(deref(entry(free)));
  ensures room_of(deref(free)) == room_of(deref(entry(free))) + 1_u64;
} {
  region {
    let block = take_back(vector: &uniq deref(free));
    return move block;
  }
}

fn return_block['s: affine](free: &uniq FixedVector<Vector<'s, u8>, 2>, block: own Vector<'s, u8>) -> result: own unit reads(free), writes(free) contract {
  requires room_of(deref(free)) > 0_u64;
  ensures len_of(deref(free)) == len_of(deref(entry(free))) + 1_u64;
} {
  region {
    place_back(vector: &uniq deref(free), value: move block);
  }
  return unit;
}
