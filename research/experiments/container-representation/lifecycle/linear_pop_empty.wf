fn main() -> status: own ExitStatus pure {
  let empty = fixed_vector::<Ticket, 2>();
  let first_ticket = Ticket(number: 1_u8);
  let second_ticket = Ticket(number: 2_u8);
  region {
    place_back(vector: &uniq empty, value: move first_ticket);
  }
  let one = move empty;
  region {
    place_back(vector: &uniq one, value: move second_ticket);
  }
  let two = move one;
  region {
    let second = take_back(vector: &uniq two);
    let rest = move two;
    region {
      let first = take_back(vector: &uniq rest);
      let drained = move rest;
      let second_number = consume(ticket: move second);
      let first_number = consume(ticket: move first);
      invariant empty_again: len_of(drained) <= 0_u64;
      return exit_status(code: 0_u8);
    }
  }
}
