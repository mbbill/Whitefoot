fn filter_tile(input: &buffer<f64>, taps: &buffer<f64>, first: own u64, end: own u64, last_tap: own u64) -> result: own box<FirTiles> reads(input, taps) contract {
  define input_count = len_of(deref(input));
  define tap_count = len_of(deref(taps));
  requires last_tap < tap_count;
  requires last_tap <= 63_u64;
  requires last_tap <= first;
  requires first <= end;
  requires end <= input_count;
  requires end <= 16777216_u64;
} {
  doc "Computes each causal FIR output from the shared history-prefixed input, in ascending tap order with separate strict multiplication and addition. The leaf owns every output sample.";
  let count = end - first;
  invariant bounded: count <= 16777216_u64;
  let samples = buffer_new(count, 0.0_f64);
  let tap_count = last_tap + 1_u64;
  for (position in first..end) {
    let sum = 0.0_f64;
    for (k in 0_u64..tap_count) {
      let source = position - k;
      let coefficient = deref(taps)[k];
      let sample = deref(input)[source];
      let product = fmul.strict(coefficient, sample);
      set sum = fadd.strict(sum, product);
    }
    let i = position - first;
    set samples[i] = sum;
  }
  let tile = Values(samples: move samples);
  return box_new(move tile);
}
