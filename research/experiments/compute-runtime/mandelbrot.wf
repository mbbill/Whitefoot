fn escape_count(real: own f64, imaginary: own f64, limit: own u64) -> result: own u64 pure contract {
  requires limit <= 65536_u64;
} {
  doc "Returns the first iteration whose squared magnitude exceeds four, or the iteration limit. Iteration zero tests z=0; arithmetic uses separate strict binary64 operations.";
  let x = 0.0_f64;
  let y = 0.0_f64;
  for (iteration in 0_u64..limit) {
    let xx = fmul.strict(x, x);
    let yy = fmul.strict(y, y);
    let magnitude = fadd.strict(xx, yy);
    if fgt(magnitude, 4.0_f64) {
      return iteration;
    }
    let xy = fmul.strict(x, y);
    let twice_xy = fadd.strict(xy, xy);
    let difference = fsub.strict(xx, yy);
    set y = fadd.strict(twice_xy, imaginary);
    set x = fadd.strict(difference, real);
  }
  return limit;
}

fn render_points(real: &buffer<f64>, imaginary: &buffer<f64>, first: own u64, end: own u64, limit: own u64) -> result: own buffer<u64> reads(real, imaginary) contract {
  define real_count = len_of(deref(real));
  define imaginary_count = len_of(deref(imaginary));
  requires first <= end;
  requires end <= real_count;
  requires end <= imaginary_count;
  requires end <= 1048576_u64;
  requires limit <= 65536_u64;
} {
  doc "Renders independently supplied complex coordinates in input order. The sequential map owns its result buffer; iteration counts vary with each point, not its index.";
  let count = end - first;
  let output = buffer_new(count, 0_u64);
  for (target in 0_u64..count) {
    let point = first + target;
    let value = escape_count(real: deref(real)[point], imaginary: deref(imaginary)[point], limit: limit);
    set output[target] = value;
  }
  return move output;
}

fn release_points(output: own buffer<u64>) -> result: own u64 pure {
  return 0_u64;
}

fn command_smoke() -> status: own ExitStatus pure {
  let real = buffer_new(3_u64, 0.0_f64);
  let imaginary = buffer_new(3_u64, 0.0_f64);
  set real[1_u64] = 2.0_f64;
  set real[2_u64] = 3.0_f64;
  region {
    let results = render_points(real: &real, imaginary: &imaginary, first: 0_u64, end: 3_u64, limit: 16_u64);
    let count = len_of(results);
    if count != 3_u64 {
      return exit_status(code: 1_u8);
    }
    if results[0_u64] != 16_u64 {
      return exit_status(code: 1_u8);
    }
    if results[1_u64] != 2_u64 {
      return exit_status(code: 1_u8);
    }
    if results[2_u64] != 1_u64 {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
