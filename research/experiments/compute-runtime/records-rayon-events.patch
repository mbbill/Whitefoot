+//! Diagnostic-only, single-pool event accounting; never reset during execution.
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const EVENTS: usize = 13;
+const EXTERNAL: usize = 4;
+
+#[repr(align(128))]
+struct Bank([AtomicU64; EVENTS]);
+impl Bank {
+    const fn new() -> Self {
+        Self([const { AtomicU64::new(0) }; EVENTS])
+    }
+}
+// Every runtime worker writes a different cache-separated bank. Only submissions
+// made outside a registered worker share the explicitly separate external bank.
+static BANKS: [Bank; 5] = [const { Bank::new() }; 5];
+
+pub(super) fn record_for(worker: usize, event: usize) {
+    assert!(worker < EXTERNAL, "diagnostic supports one pool of at most four workers");
+    BANKS[worker].0[event].fetch_add(1, Ordering::Relaxed);
+}
+pub(super) fn record(event: usize) {
+    let index = crate::current_thread_index().unwrap_or(EXTERNAL);
+    assert!(index <= EXTERNAL);
+    BANKS[index].0[event].fetch_add(1, Ordering::Relaxed);
+}
+pub(super) fn read(worker: usize, event: usize) -> u64 {
+    BANKS[worker].0[event].load(Ordering::Relaxed)
+}
+pub(super) fn complete_stack(inline: bool) {
+    record(3);
+    record(if inline { 4 } else { 5 });
+}
+// The guard owns only a worker index, never a job/frame pointer. Its destructor
+// runs on return or unwinding before run_inline relinquishes its caller's frame.
+pub(super) struct InlineCompletion(usize);
+impl InlineCompletion {
+    pub(super) fn new() -> Self {
+        Self(crate::current_thread_index().expect("inline job outside worker"))
+    }
+}
+impl Drop for InlineCompletion {
+    fn drop(&mut self) {
+        record_for(self.0, 3);
+        record_for(self.0, 4);
+    }
+}
