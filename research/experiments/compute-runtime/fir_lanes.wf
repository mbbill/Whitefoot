fn filter_tile(input: &buffer<f64>, taps: &buffer<f64>, first: own u64, end: own u64, last_tap: own u64) -> result: own box<FirTiles> reads(input, taps), allocates(heap) contract {
  define input_count = len(deref(input));
  define tap_count = len(deref(taps));
  requires last_tap < tap_count;
  requires last_tap <= 63_u64;
  requires last_tap <= first;
  requires first <= end;
  requires end <= input_count;
  requires end <= 16777216_u64;
} {
  doc "Computes sixteen independent outputs together, preserving ascending tap order and separate strict multiply/add rounding for each output. Finite source proofs justify the complete group and scalar tail; the leaf owns every output sample.";
  let count = end - first;
  invariant bounded: count <= 16777216_u64;
  let samples = buffer_new(count, 0.0_f64);
  let tap_count = last_tap + 1_u64;
  let groups = count / 16_u64;
  for (group in 0_u64..groups) {
    invariant group_end: 16_u64 * group + 16_u64 <= count {
      use 16 times (group < groups);
      use (16_u64 * groups <= count);
    }
    let offset = group * 16_u64;
    let position = first + offset;
    let sum0 = 0.0_f64;
    let sum1 = 0.0_f64;
    let sum2 = 0.0_f64;
    let sum3 = 0.0_f64;
    let sum4 = 0.0_f64;
    let sum5 = 0.0_f64;
    let sum6 = 0.0_f64;
    let sum7 = 0.0_f64;
    let sum8 = 0.0_f64;
    let sum9 = 0.0_f64;
    let sum10 = 0.0_f64;
    let sum11 = 0.0_f64;
    let sum12 = 0.0_f64;
    let sum13 = 0.0_f64;
    let sum14 = 0.0_f64;
    let sum15 = 0.0_f64;
    for (k in 0_u64..tap_count) {
      let source = position - k;
      let coefficient = deref(taps)[k];
      let source0 = source + 0_u64;
      let sample0 = deref(input)[source0];
      let product0 = fmul.strict(coefficient, sample0);
      set sum0 = fadd.strict(sum0, product0);
      let source1 = source + 1_u64;
      let sample1 = deref(input)[source1];
      let product1 = fmul.strict(coefficient, sample1);
      set sum1 = fadd.strict(sum1, product1);
      let source2 = source + 2_u64;
      let sample2 = deref(input)[source2];
      let product2 = fmul.strict(coefficient, sample2);
      set sum2 = fadd.strict(sum2, product2);
      let source3 = source + 3_u64;
      let sample3 = deref(input)[source3];
      let product3 = fmul.strict(coefficient, sample3);
      set sum3 = fadd.strict(sum3, product3);
      let source4 = source + 4_u64;
      let sample4 = deref(input)[source4];
      let product4 = fmul.strict(coefficient, sample4);
      set sum4 = fadd.strict(sum4, product4);
      let source5 = source + 5_u64;
      let sample5 = deref(input)[source5];
      let product5 = fmul.strict(coefficient, sample5);
      set sum5 = fadd.strict(sum5, product5);
      let source6 = source + 6_u64;
      let sample6 = deref(input)[source6];
      let product6 = fmul.strict(coefficient, sample6);
      set sum6 = fadd.strict(sum6, product6);
      let source7 = source + 7_u64;
      let sample7 = deref(input)[source7];
      let product7 = fmul.strict(coefficient, sample7);
      set sum7 = fadd.strict(sum7, product7);
      let source8 = source + 8_u64;
      let sample8 = deref(input)[source8];
      let product8 = fmul.strict(coefficient, sample8);
      set sum8 = fadd.strict(sum8, product8);
      let source9 = source + 9_u64;
      let sample9 = deref(input)[source9];
      let product9 = fmul.strict(coefficient, sample9);
      set sum9 = fadd.strict(sum9, product9);
      let source10 = source + 10_u64;
      let sample10 = deref(input)[source10];
      let product10 = fmul.strict(coefficient, sample10);
      set sum10 = fadd.strict(sum10, product10);
      let source11 = source + 11_u64;
      let sample11 = deref(input)[source11];
      let product11 = fmul.strict(coefficient, sample11);
      set sum11 = fadd.strict(sum11, product11);
      let source12 = source + 12_u64;
      let sample12 = deref(input)[source12];
      let product12 = fmul.strict(coefficient, sample12);
      set sum12 = fadd.strict(sum12, product12);
      let source13 = source + 13_u64;
      let sample13 = deref(input)[source13];
      let product13 = fmul.strict(coefficient, sample13);
      set sum13 = fadd.strict(sum13, product13);
      let source14 = source + 14_u64;
      let sample14 = deref(input)[source14];
      let product14 = fmul.strict(coefficient, sample14);
      set sum14 = fadd.strict(sum14, product14);
      let source15 = source + 15_u64;
      let sample15 = deref(input)[source15];
      let product15 = fmul.strict(coefficient, sample15);
      set sum15 = fadd.strict(sum15, product15);
    }
    let output0 = offset + 0_u64;
    set samples[output0] = sum0;
    let output1 = offset + 1_u64;
    set samples[output1] = sum1;
    let output2 = offset + 2_u64;
    set samples[output2] = sum2;
    let output3 = offset + 3_u64;
    set samples[output3] = sum3;
    let output4 = offset + 4_u64;
    set samples[output4] = sum4;
    let output5 = offset + 5_u64;
    set samples[output5] = sum5;
    let output6 = offset + 6_u64;
    set samples[output6] = sum6;
    let output7 = offset + 7_u64;
    set samples[output7] = sum7;
    let output8 = offset + 8_u64;
    set samples[output8] = sum8;
    let output9 = offset + 9_u64;
    set samples[output9] = sum9;
    let output10 = offset + 10_u64;
    set samples[output10] = sum10;
    let output11 = offset + 11_u64;
    set samples[output11] = sum11;
    let output12 = offset + 12_u64;
    set samples[output12] = sum12;
    let output13 = offset + 13_u64;
    set samples[output13] = sum13;
    let output14 = offset + 14_u64;
    set samples[output14] = sum14;
    let output15 = offset + 15_u64;
    set samples[output15] = sum15;
  }
  let tail_count = groups * 16_u64;
  let tail_first = first + tail_count;
  invariant tail_lower: last_tap <= tail_first;
  for (position in tail_first..end) {
    invariant output_lower: last_tap <= position;
    let sum = 0.0_f64;
    for (k in 0_u64..tap_count) {
      let source = position - k;
      let coefficient = deref(taps)[k];
      let sample = deref(input)[source];
      let product = fmul.strict(coefficient, sample);
      set sum = fadd.strict(sum, product);
    }
    let i = position - first;
    set samples[i] = sum;
  }
  let tile = Values(samples: move samples);
  return box_new(move tile);
}
