enum FirTiles {
  Values(samples: buffer<f64>);
  Split(count: u64, left_count: u64, left: box<FirTiles>, right: box<FirTiles>);
}

fn filter_tiles(input: &buffer<f64>, taps: &buffer<f64>, first: own u64, end: own u64, last_tap: own u64, tile_size: own u64) -> result: own box<FirTiles> reads(input, taps), allocates(heap) contract {
  define input_count = len(deref(input));
  define tap_count = len(deref(taps));
  requires last_tap < tap_count;
  requires last_tap <= 63_u64;
  requires last_tap <= first;
  requires first <= end;
  requires end <= input_count;
  requires end <= 16777216_u64;
  requires 1_u64 <= tile_size;
  requires tile_size <= 65536_u64;
} {
  doc "Splits independent output intervals while retaining the same input history across tile boundaries. Consecutive child calls return disjoint owned trees; tree and initialized leaf allocation remain part of this representation.";
  let count = end - first;
  if count <= tile_size {
    return filter_tile(input: input, taps: taps, first: first, end: end, last_tap: last_tap);
  }
  let half = count / 2_u64;
  let middle = first + half;
  let left = filter_tiles(input: input, taps: taps, first: first, end: middle, last_tap: last_tap, tile_size: tile_size);
  let right = filter_tiles(input: input, taps: taps, first: middle, end: end, last_tap: last_tap, tile_size: tile_size);
  let split = Split(count: count, left_count: half, left: move left, right: move right);
  return box_new(move split);
}

fn sample_count(tiles: &box<FirTiles>) -> result: own u64 reads(tiles) {
  match deref(deref(tiles)) {
    Values(samples: values) => {
      return len(deref(values));
    }
    Split(count: size, left_count: half, left: l, right: r) => {
      return deref(size);
    }
  }
}

fn sample_get(tiles: &box<FirTiles>, index: own u64, output: &uniq f64) -> result: own u64 reads(tiles), writes(output) {
  doc "Returns one for a present sample. An absent index returns zero and preserves the caller output; the oracle checks all expected hits, exact count and misses.";
  match deref(deref(tiles)) {
    Values(samples: values) => {
      let count = len(deref(values));
      if index < count {
        set deref(output) = deref(values)[index];
        return 1_u64;
      }
      return 0_u64;
    }
    Split(count: size, left_count: half, left: l, right: r) => {
      let left_size = deref(half);
      if index < left_size {
        return sample_get(tiles: l, index: index, output: move output);
      }
      let local = index - left_size;
      return sample_get(tiles: r, index: local, output: move output);
    }
  }
}

fn history_get(input: &buffer<f64>, history_count: own u64, index: own u64, output: &uniq f64) -> result: own u64 reads(input), writes(output) contract {
  define input_count = len(deref(input));
  requires history_count <= input_count;
} {
  doc "Reads the final oldest-first history from the held input prefix, including empty blocks. The research host performs these state queries outside the filter core and uses them as history for the next real call.";
  if index >= history_count {
    return 0_u64;
  }
  let input_count = len(deref(input));
  let first = input_count - history_count;
  let position = first + index;
  set deref(output) = deref(input)[position];
  return 1_u64;
}

fn release_tiles(tiles: own box<FirTiles>) -> result: own u64 pure {
  return 0_u64;
}

fn check_impulse(tiles: &box<FirTiles>) -> result: own u64 reads(tiles) {
  let count = sample_count(tiles: tiles);
  if count != 5_u64 {
    return 1_u64;
  }
  for (i in 0_u64..5_u64) {
    let expected = if i < 3_u64 {
      give 1.0_f64;
    } else {
      give 0.0_f64;
    }
    let actual = 99.0_f64;
    let hit = 0_u64;
    region {
      set hit = sample_get(tiles: tiles, index: i, output: &uniq actual);
    }
    if hit != 1_u64 {
      return 2_u64;
    }
    if feq(actual, expected) {
    } else {
      return 3_u64;
    }
  }
  let sentinel = 99.0_f64;
  let hit = 1_u64;
  region {
    set hit = sample_get(tiles: tiles, index: 5_u64, output: &uniq sentinel);
  }
  if hit != 0_u64 {
    return 4_u64;
  }
  if feq(sentinel, 99.0_f64) {
  } else {
    return 5_u64;
  }
  return 0_u64;
}

command fn main() -> status: own ExitStatus allocates(heap) {
  let input = buffer_new(7_u64, 0.0_f64);
  set input[2_u64] = 8.0_f64;
  let taps = buffer_new(3_u64, 0.125_f64);
  region {
    let tiles = filter_tiles(input: &input, taps: &taps, first: 2_u64, end: 7_u64, last_tap: 2_u64, tile_size: 2_u64);
    let verdict = 99_u64;
    region {
      set verdict = check_impulse(tiles: &tiles);
    }
    if verdict != 0_u64 {
      return exit_status(code: 1_u8);
    }
    let released = release_tiles(tiles: move tiles);
  }
  return exit_status(code: 0_u8);
}
