const usage_text: array<u8, 30> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 32_u8, 80_u8, 65_u8, 84_u8, 84_u8, 69_u8, 82_u8, 78_u8, 32_u8, 70_u8, 73_u8, 76_u8, 69_u8, 46_u8, 46_u8, 46_u8, 10_u8];

const error_prefix: array<u8, 8> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8];

const error_separator: array<u8, 2> =[58_u8, 32_u8];

const reason_missing: array<u8, 26> =[110_u8, 111_u8, 32_u8, 115_u8, 117_u8, 99_u8, 104_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 111_u8, 114_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_denied: array<u8, 18> =[112_u8, 101_u8, 114_u8, 109_u8, 105_u8, 115_u8, 115_u8, 105_u8, 111_u8, 110_u8, 32_u8, 100_u8, 101_u8, 110_u8, 105_u8, 101_u8, 100_u8, 10_u8];

const reason_directory: array<u8, 15> =[105_u8, 115_u8, 32_u8, 97_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_invalid_path: array<u8, 22> =[105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 114_u8, 101_u8, 108_u8, 97_u8, 116_u8, 105_u8, 118_u8, 101_u8, 32_u8, 112_u8, 97_u8, 116_u8, 104_u8, 10_u8];

const reason_long_line: array<u8, 14> =[108_u8, 105_u8, 110_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

const reason_unreadable: array<u8, 12> =[99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 10_u8];

const reason_broken_pipe: array<u8, 20> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 98_u8, 114_u8, 111_u8, 107_u8, 101_u8, 110_u8, 32_u8, 112_u8, 105_u8, 112_u8, 101_u8, 10_u8];

const reason_write_error: array<u8, 20> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 119_u8, 114_u8, 105_u8, 116_u8, 101_u8, 32_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 10_u8];

const reason_pattern_too_long: array<u8, 25> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 112_u8, 97_u8, 116_u8, 116_u8, 101_u8, 114_u8, 110_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

fn io_class(error: own IoError) -> result: own u8 pure {
  doc "Reduces one portable IoError class to the distinctions wfgrep reports.";
  match error {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 9_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 9_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 4_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn append_slice(destination: &uniq buffer<u8>, filled: own u64, text: own slice<u8>) -> result: own u64 reads(destination, text), writes(destination) contract {
  define capacity = len(deref(destination));
  ensures ile(result, capacity);
} {
  doc "Appends as much of one static message as the destination still holds.";
  let capacity = len(deref(destination));
  let admitted = ile(filled, capacity);
  let length = len(text);
  if admitted {
    for @append at in filled..capacity {
      let taken = at -wrap filled;
      let done = ige(taken, length);
      if done {
        return at;
      }
      let byte = text[taken];
      set deref(destination)[at] = byte;
    }
    return capacity;
  } else {
    return capacity;
  }
}

fn copy_range(destination: &uniq buffer<u8>, at: own u64, source: &buffer<u8>, from: own u64, to: own u64) -> result: own u64 reads(destination, source), writes(destination) contract {
  define destination_room = len(deref(destination));
  ensures ile(result, destination_room);
} {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = len(deref(source));
  let destination_room = len(deref(destination));
  let admitted = ile(at, destination_room);
  if admitted {
  } else {
    return destination_room;
  }
  let target = at;
  let cursor = from;
  loop @copy {
    let done = ige(cursor, to);
    if done {
      break @copy;
    }
    let read_ok = ilt(cursor, source_room);
    if read_ok {
    } else {
      let target_fits = ile(target, destination_room);
      if target_fits {
        return target;
      } else {
        return destination_room;
      }
    }
    let byte = deref(source)[cursor];
    let write_ok = ilt(target, destination_room);
    if write_ok {
    } else {
      return destination_room;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  let target_fits = ile(target, destination_room);
  if target_fits {
    return target;
  } else {
    return destination_room;
  }
}

fn line_matches(source: &buffer<u8>, start: own u64, stop: own u64, pattern: &buffer<u8>, length: own u64) -> result: own Bool reads(source, pattern) {
  doc "Reports whether the literal pattern bytes occur in one line's byte range.";
  let source_room = len(deref(source));
  let pattern_room = len(deref(pattern));
  let ordered = ile(start, stop);
  if ordered {
  } else {
    return False();
  }
  let source_fits = ile(stop, source_room);
  if source_fits {
  } else {
    return False();
  }
  let pattern_fits = ile(length, pattern_room);
  if pattern_fits {
  } else {
    return False();
  }
  let empty = ieq(length, 0_u64);
  if empty {
    return True();
  }
  let span = stop -wrap start;
  let fits = ige(span, length);
  if fits {
  } else {
    return False();
  }
  let last = span -wrap length;
  let offset = 0_u64;
  loop @candidates {
    let past = igt(offset, last);
    if past {
      break @candidates;
    }
    let base = start +wrap offset;
    let base_ok = ilt(base, source_room);
    if base_ok {
    } else {
      return False();
    }
    let probe = 0_u64;
    let same = True();
    loop @compare {
      let done = ige(probe, length);
      if done {
        break @compare;
      }
      let position = base +wrap probe;
      let position_ok = ilt(position, source_room);
      if position_ok {
      } else {
        set same = False();
        break @compare;
      }
      let probe_ok = ilt(probe, pattern_room);
      if probe_ok {
      } else {
        set same = False();
        break @compare;
      }
      let left = deref(source)[position];
      let right = deref(pattern)[probe];
      let equal = ieq(left, right);
      if equal {
      } else {
        set same = False();
        break @compare;
      }
      set probe = probe +wrap 1_u64;
    }
    if same {
      return True();
    }
    set offset = offset +wrap 1_u64;
  }
  return False();
}

fn publish_all(output: &uniq Output, source: &buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define source_length = len(deref(source));
  requires ile(length, source_length);
} {
  doc "Publishes one prefix of the source buffer, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = ilt(sent, length);
    if pending {
    } else {
      break @publish;
    }
    region {
      match write_once(output: &uniq deref(output), source: source, start: sent, end: length) {
        Ok(value: written) => {
          set sent = written;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn report_failure(args: &Args, err: &uniq Output, report: &uniq buffer<u8>, status: own u8, position: own u64) -> result: own unit reads(args, err, report), writes(err, report) contract {
  define report_room = len(deref(report));
  requires ile(256_u64, report_room);
} {
  doc "Assembles one `wfgrep: NAME: reason` diagnostic in the reusable report buffer and publishes it to standard error.";
  let length = 0_u64;
  region {
    let view = slice_of(&error_prefix);
    region {
      set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
    }
  }
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      let name_start_ok = ile(length, 256_u64);
      if name_start_ok {
        region {
          match host_copy_bytes(value: &text, destination: &uniq deref(report), start: length, end: 256_u64) {
            Ok(value: copied) => {
              set length = copied;
            }
            Err(error: too_small) => {
            }
          }
        }
      }
    }
    Err(error: absent) => {
    }
  }
  region {
    let view = slice_of(&error_separator);
    region {
      set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
    }
  }
  let named = 0_u8;
  if ieq(status, 1_u8) {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_missing);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
      }
    }
  }
  if ieq(status, 2_u8) {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_denied);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
      }
    }
  }
  if ieq(status, 3_u8) {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_directory);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
      }
    }
  }
  if ieq(status, 5_u8) {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_invalid_path);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
      }
    }
  }
  if ieq(status, 6_u8) {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_long_line);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
      }
    }
  }
  if ieq(named, 0_u8) {
    region {
      let view = slice_of(&reason_unreadable);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: move view);
      }
    }
  }
  region {
    match publish_all(output: &uniq deref(err), source: &deref(report), length: length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return unit;
}

command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.stderr as err: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, out, err, files), writes(cwd, out, err, files), allocates(heap) {
  doc "Publishes every line of every named file that contains the literal pattern bytes; 0 matched, 1 none, 2 error.";
  let input = buffer_new(4096_u64, 0_u8);
  let batch = buffer_new(4096_u64, 0_u8);
  let pattern = buffer_new(4096_u64, 0_u8);
  let report = buffer_new(512_u64, 0_u8);
  let arguments = 0_u64;
  region {
    set arguments = args_count(args: &args);
  }
  let startup = 0_u8;
  let pattern_length = 0_u64;
  let usable = ige(arguments, 3_u64);
  if usable {
    region {
      match arg_get(args: &args, position: 1_u64) {
        Ok(value: text) => {
          region {
            match host_copy_bytes(value: &text, destination: &uniq pattern, start: 0_u64, end: 4096_u64) {
              Ok(value: copied) => {
                set pattern_length = copied;
              }
              Err(error: too_small) => {
                set startup = 2_u8;
              }
            }
          }
        }
        Err(error: absent) => {
          set startup = 1_u8;
        }
      }
    }
  } else {
    set startup = 1_u8;
  }
  if ieq(startup, 0_u8) {
  } else {
    let length = 0_u64;
    if ieq(startup, 1_u8) {
      region {
        let view = slice_of(&usage_text);
        set length = append_slice(destination: &uniq report, filled: length, text: move view);
      }
    } else {
      region {
        let view = slice_of(&reason_pattern_too_long);
        set length = append_slice(destination: &uniq report, filled: length, text: move view);
      }
    }
    region {
      match publish_all(output: &uniq err, source: &report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
    return exit_status(code: 2_u8);
  }
  let failed = 0_u8;
  let matched = 0_u8;
  let filled = 0_u64;
  let write_failed = 0_u8;
  let write_class = 0_u8;
  let position = 2_u64;
  loop @files {
    let more = ilt(position, arguments);
    if more {
    } else {
      break @files;
    }
    let status = 0_u8;
    region {
      match arg_get(args: &args, position: position) {
        Ok(value: text) => {
          match relative_path(value: move text) {
            Ok(value: path) => {
              region {
                let permit = reserve_file(factory: &uniq files);
                match open_read(permit: move permit, root: &cwd, path: &path) {
                  Ok(value: file) => {
                    let carry = 0_u64;
                    let file_offset = 0_u64;
                    loop @chunks {
                      let carry_fits = ilt(carry, 4096_u64);
                      if carry_fits {
                      } else {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let room = 4096_u64 -wrap carry;
                      let overlong = ieq(room, 0_u64);
                      if overlong {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let available = 0_u64;
                      let ended = 0_u8;
                      region {
                        match read_at(file: &file, destination: &uniq input, file_offset: file_offset, start: carry, end: 4096_u64) {
                          ReadBytes(next: taken) => {
                            set available = taken;
                            let delivered = taken -wrap carry;
                            set file_offset = file_offset +wrap delivered;
                          }
                          ReadEnd() => {
                            set ended = 1_u8;
                          }
                          ReadFailed(error: problem) => {
                            set status = io_class(error: move problem);
                            set ended = 2_u8;
                          }
                        }
                      }
                      if ieq(ended, 2_u8) {
                        break @chunks;
                      }
                      if ieq(ended, 1_u8) {
                        let trailing = igt(carry, 0_u64);
                        if trailing {
                          set input[carry] = 10_u8;
                          set available = carry +wrap 1_u64;
                        }
                      }
                      let available_fits = ile(available, 4096_u64);
                      if available_fits {
                      } else {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let scan = 0_u64;
                      loop @lines {
                        let terminator = available;
                        let probe = scan;
                        loop @findword {
                          let probe_word_fits = ile(probe, 4088_u64);
                          if probe_word_fits {
                          } else {
                            break @findword;
                          }
                          let next = probe + 8_u64;
                          let roomy = ile(next, available);
                          if roomy {
                          } else {
                            break @findword;
                          }
                          let byte0 = input[probe];
                          let at1 = probe + 1_u64;
                          let byte1 = input[at1];
                          let at2 = probe + 2_u64;
                          let byte2 = input[at2];
                          let at3 = probe + 3_u64;
                          let byte3 = input[at3];
                          let at4 = probe + 4_u64;
                          let byte4 = input[at4];
                          let at5 = probe + 5_u64;
                          let byte5 = input[at5];
                          let at6 = probe + 6_u64;
                          let byte6 = input[at6];
                          let at7 = probe + 7_u64;
                          let byte7 = input[at7];
                          let wide0 = cvt<u8, u64>(byte0);
                          let wide1 = cvt<u8, u64>(byte1);
                          let wide2 = cvt<u8, u64>(byte2);
                          let wide3 = cvt<u8, u64>(byte3);
                          let wide4 = cvt<u8, u64>(byte4);
                          let wide5 = cvt<u8, u64>(byte5);
                          let wide6 = cvt<u8, u64>(byte6);
                          let wide7 = cvt<u8, u64>(byte7);
                          let lane1 = ishl.wrap(wide1, 8_u32);
                          let lane2 = ishl.wrap(wide2, 16_u32);
                          let lane3 = ishl.wrap(wide3, 24_u32);
                          let lane4 = ishl.wrap(wide4, 32_u32);
                          let lane5 = ishl.wrap(wide5, 40_u32);
                          let lane6 = ishl.wrap(wide6, 48_u32);
                          let lane7 = ishl.wrap(wide7, 56_u32);
                          let pair01 = ior(wide0, lane1);
                          let pair23 = ior(lane2, lane3);
                          let pair45 = ior(lane4, lane5);
                          let pair67 = ior(lane6, lane7);
                          let quad03 = ior(pair01, pair23);
                          let quad47 = ior(pair45, pair67);
                          let word = ior(quad03, quad47);
                          let marked = ixor(word, 723401728380766730_u64);
                          let borrowed = marked -wrap 72340172838076673_u64;
                          let inverted = inot(marked);
                          let carried = iand(borrowed, inverted);
                          let hits = iand(carried, 9259542123273814144_u64);
                          let found = ine(hits, 0_u64);
                          if found {
                            break @findword;
                          }
                          set probe = next;
                        }
                        loop @find {
                          let done = ige(probe, available);
                          if done {
                            break @find;
                          }
                          let byte = input[probe];
                          let newline = ieq(byte, 10_u8);
                          if newline {
                            set terminator = probe;
                            break @find;
                          }
                          set probe = probe +wrap 1_u64;
                        }
                        let complete = ilt(terminator, available);
                        if complete {
                        } else {
                          break @lines;
                        }
                        let hit = False();
                        region {
                          set hit = line_matches(source: &input, start: scan, stop: terminator, pattern: &pattern, length: pattern_length);
                        }
                        if hit {
                          set matched = 1_u8;
                          let stop = terminator +wrap 1_u64;
                          let span = stop -wrap scan;
                          let need = filled +wrap span;
                          let overfull = igt(need, 4096_u64);
                          if overfull {
                            let filled_fits = ile(filled, 4096_u64);
                            if filled_fits {
                              region {
                                match publish_all(output: &uniq out, source: &batch, length: filled) {
                                  Ok(value: published) => {
                                  }
                                  Err(error: problem) => {
                                    set write_failed = 1_u8;
                                    set write_class = io_class(error: move problem);
                                  }
                                }
                              }
                            } else {
                              set write_failed = 1_u8;
                            }
                            set filled = 0_u64;
                          }
                          if ieq(write_failed, 0_u8) {
                            region {
                              set filled = copy_range(destination: &uniq batch, at: filled, source: &input, from: scan, to: stop);
                            }
                          } else {
                            break @files;
                          }
                        }
                        set scan = terminator +wrap 1_u64;
                      }
                      if ieq(ended, 1_u8) {
                        break @chunks;
                      }
                      let tail = available -wrap scan;
                      let moved = 0_u64;
                      loop @shift {
                        let done = ige(moved, tail);
                        if done {
                          break @shift;
                        }
                        let source_index = scan +wrap moved;
                        let source_fits = ilt(source_index, 4096_u64);
                        let target_fits = ilt(moved, 4096_u64);
                        if source_fits {
                        } else {
                          break @shift;
                        }
                        if target_fits {
                        } else {
                          break @shift;
                        }
                        let byte = input[source_index];
                        set input[moved] = byte;
                        set moved = moved +wrap 1_u64;
                      }
                      set carry = tail;
                    }
                  }
                  Err(error: problem) => {
                    set status = io_class(error: move problem);
                  }
                }
              }
            }
            Err(error: rejected) => {
              set status = 5_u8;
            }
          }
        }
        Err(error: absent) => {
          set status = 9_u8;
        }
      }
    }
    let reportable = ine(status, 0_u8);
    if reportable {
      set failed = 1_u8;
      region {
        report_failure(args: &args, err: &uniq err, report: &uniq report, status: status, position: position);
      }
    }
    set position = position +wrap 1_u64;
  }
  if ieq(write_failed, 0_u8) {
    let filled_fits = ile(filled, 4096_u64);
    if filled_fits {
      region {
        match publish_all(output: &uniq out, source: &batch, length: filled) {
          Ok(value: published) => {
          }
          Err(error: problem) => {
            set write_failed = 1_u8;
            set write_class = io_class(error: move problem);
          }
        }
      }
    } else {
      set write_failed = 1_u8;
    }
  }
  if ieq(write_failed, 0_u8) {
  } else {
    set failed = 1_u8;
    let length = 0_u64;
    if ieq(write_class, 4_u8) {
      region {
        let view = slice_of(&reason_broken_pipe);
        set length = append_slice(destination: &uniq report, filled: length, text: move view);
      }
    } else {
      region {
        let view = slice_of(&reason_write_error);
        set length = append_slice(destination: &uniq report, filled: length, text: move view);
      }
    }
    region {
      match publish_all(output: &uniq err, source: &report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
  }
  if ieq(failed, 0_u8) {
  } else {
    return exit_status(code: 2_u8);
  }
  if ieq(matched, 0_u8) {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
