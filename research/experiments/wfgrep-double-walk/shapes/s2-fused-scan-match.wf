const usage_text: array<u8, 30> =[117_u8, 115_u8, 97_u8, 103_u8, 101_u8, 58_u8, 32_u8, 119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 32_u8, 80_u8, 65_u8, 84_u8, 84_u8, 69_u8, 82_u8, 78_u8, 32_u8, 70_u8, 73_u8, 76_u8, 69_u8, 46_u8, 46_u8, 46_u8, 10_u8];

const error_prefix: array<u8, 8> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8];

const error_separator: array<u8, 2> =[58_u8, 32_u8];

const reason_missing: array<u8, 26> =[110_u8, 111_u8, 32_u8, 115_u8, 117_u8, 99_u8, 104_u8, 32_u8, 102_u8, 105_u8, 108_u8, 101_u8, 32_u8, 111_u8, 114_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_denied: array<u8, 18> =[112_u8, 101_u8, 114_u8, 109_u8, 105_u8, 115_u8, 115_u8, 105_u8, 111_u8, 110_u8, 32_u8, 100_u8, 101_u8, 110_u8, 105_u8, 101_u8, 100_u8, 10_u8];

const reason_directory: array<u8, 15> =[105_u8, 115_u8, 32_u8, 97_u8, 32_u8, 100_u8, 105_u8, 114_u8, 101_u8, 99_u8, 116_u8, 111_u8, 114_u8, 121_u8, 10_u8];

const reason_invalid_path: array<u8, 22> =[105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 114_u8, 101_u8, 108_u8, 97_u8, 116_u8, 105_u8, 118_u8, 101_u8, 32_u8, 112_u8, 97_u8, 116_u8, 104_u8, 10_u8];

const reason_long_line: array<u8, 14> =[108_u8, 105_u8, 110_u8, 101_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

const reason_unreadable: array<u8, 12> =[99_u8, 97_u8, 110_u8, 110_u8, 111_u8, 116_u8, 32_u8, 114_u8, 101_u8, 97_u8, 100_u8, 10_u8];

const reason_broken_pipe: array<u8, 20> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 98_u8, 114_u8, 111_u8, 107_u8, 101_u8, 110_u8, 32_u8, 112_u8, 105_u8, 112_u8, 101_u8, 10_u8];

const reason_write_error: array<u8, 20> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 119_u8, 114_u8, 105_u8, 116_u8, 101_u8, 32_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 10_u8];

const reason_pattern_too_long: array<u8, 25> =[119_u8, 102_u8, 103_u8, 114_u8, 101_u8, 112_u8, 58_u8, 32_u8, 112_u8, 97_u8, 116_u8, 116_u8, 101_u8, 114_u8, 110_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 108_u8, 111_u8, 110_u8, 103_u8, 10_u8];

fn io_class(error: own IoError) -> result: own u8 pure {
  doc "Reduces one portable IoError class to the distinctions wfgrep reports.";
  match error {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 9_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 9_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 4_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn append_slice['d, 'm](destination: &uniq 'd buffer<u8>, filled: own u64, text: own slice<'m, u8>) -> result: own u64 reads(destination, text), writes(destination) contract {
  define capacity = len(deref(destination));
  ensures result <= capacity;
} {
  doc "Appends as much of one static message as the destination still holds.";
  let capacity = len(deref(destination));
  let admitted = filled <= capacity;
  let length = len(text);
  if admitted {
    for @append (at in filled..capacity) {
      let taken = at -wrap filled;
      let done = taken >= length;
      if done {
        return at;
      }
      let byte = text[taken];
      set deref(destination)[at] = byte;
    }
    return capacity;
  } else {
    return capacity;
  }
}

fn copy_range['d, 's](destination: &uniq 'd buffer<u8>, at: own u64, source: &'s buffer<u8>, from: own u64, to: own u64) -> result: own u64 reads(destination, source), writes(destination) contract {
  define destination_room = len(deref(destination));
  ensures result <= destination_room;
} {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = len(deref(source));
  let destination_room = len(deref(destination));
  let admitted = at <= destination_room;
  if admitted {
  } else {
    return destination_room;
  }
  let target = at;
  let cursor = from;
  loop @copy {
    let done = cursor >= to;
    if done {
      break @copy;
    }
    let read_ok = cursor < source_room;
    if read_ok {
    } else {
      let target_fits = target <= destination_room;
      if target_fits {
        return target;
      } else {
        return destination_room;
      }
    }
    let byte = deref(source)[cursor];
    let write_ok = target < destination_room;
    if write_ok {
    } else {
      return destination_room;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  let target_fits = target <= destination_room;
  if target_fits {
    return target;
  } else {
    return destination_room;
  }
}

fn publish_all['o, 's](output: &uniq 'o Output, source: &'s buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(output, source), writes(output) contract {
  define source_length = len(deref(source));
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source buffer, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    region 'attempt {
      match write_once::<'attempt, 's>(output: &uniq 'attempt deref(output), source: source, start: sent, end: length) {
        Ok(value: written) => {
          set sent = written;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn report_failure['a, 'e, 'r](args: &'a Args, err: &uniq 'e Output, report: &uniq 'r buffer<u8>, status: own u8, position: own u64) -> result: own unit reads(args, err, report), writes(err, report) contract {
  define report_room = len(deref(report));
  requires 256_u64 <= report_room;
} {
  doc "Assembles one `wfgrep: NAME: reason` diagnostic in the reusable report buffer and publishes it to standard error.";
  let length = 0_u64;
  region 'report_prefix {
    let view = slice_of(&'report_prefix error_prefix);
    region 'prefix_append {
      set length = append_slice::<'prefix_append, 'report_prefix>(destination: &uniq 'prefix_append deref(report), filled: length, text: move view);
    }
  }
  match arg_get::<'a>(args: args, position: position) {
    Ok(value: text) => {
      let name_start_ok = length <= 256_u64;
      if name_start_ok {
        region 'report_name {
          match host_copy_bytes::<'report_name, 'report_name>(value: &'report_name text, destination: &uniq 'report_name deref(report), start: length, end: 256_u64) {
            Ok(value: copied) => {
              set length = copied;
            }
            Err(error: too_small) => {
            }
          }
        }
      }
    }
    Err(error: absent) => {
    }
  }
  region 'report_separator {
    let view = slice_of(&'report_separator error_separator);
    region 'separator_append {
      set length = append_slice::<'separator_append, 'report_separator>(destination: &uniq 'separator_append deref(report), filled: length, text: move view);
    }
  }
  let named = 0_u8;
  if status == 1_u8 {
    set named = 1_u8;
    region 'reason_missing_view {
      let view = slice_of(&'reason_missing_view reason_missing);
      region 'reason_missing_append {
        set length = append_slice::<'reason_missing_append, 'reason_missing_view>(destination: &uniq 'reason_missing_append deref(report), filled: length, text: move view);
      }
    }
  }
  if status == 2_u8 {
    set named = 1_u8;
    region 'reason_denied_view {
      let view = slice_of(&'reason_denied_view reason_denied);
      region 'reason_denied_append {
        set length = append_slice::<'reason_denied_append, 'reason_denied_view>(destination: &uniq 'reason_denied_append deref(report), filled: length, text: move view);
      }
    }
  }
  if status == 3_u8 {
    set named = 1_u8;
    region 'reason_directory_view {
      let view = slice_of(&'reason_directory_view reason_directory);
      region 'reason_directory_append {
        set length = append_slice::<'reason_directory_append, 'reason_directory_view>(destination: &uniq 'reason_directory_append deref(report), filled: length, text: move view);
      }
    }
  }
  if status == 5_u8 {
    set named = 1_u8;
    region 'reason_path_view {
      let view = slice_of(&'reason_path_view reason_invalid_path);
      region 'reason_path_append {
        set length = append_slice::<'reason_path_append, 'reason_path_view>(destination: &uniq 'reason_path_append deref(report), filled: length, text: move view);
      }
    }
  }
  if status == 6_u8 {
    set named = 1_u8;
    region 'reason_long_view {
      let view = slice_of(&'reason_long_view reason_long_line);
      region 'reason_long_append {
        set length = append_slice::<'reason_long_append, 'reason_long_view>(destination: &uniq 'reason_long_append deref(report), filled: length, text: move view);
      }
    }
  }
  if named == 0_u8 {
    region 'reason_other_view {
      let view = slice_of(&'reason_other_view reason_unreadable);
      region 'reason_other_append {
        set length = append_slice::<'reason_other_append, 'reason_other_view>(destination: &uniq 'reason_other_append deref(report), filled: length, text: move view);
      }
    }
  }
  region 'report_write {
    match publish_all::<'report_write, 'report_write>(output: &uniq 'report_write deref(err), source: &'report_write deref(report), length: length) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
  }
  return unit;
}

command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.stderr as err: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, out, err, files), writes(cwd, out, err, files), allocates(heap) {
  doc "Publishes every line of every named file that contains the literal pattern bytes; 0 matched, 1 none, 2 error.";
  let input = buffer_new(4096_u64, 0_u8);
  let batch = buffer_new(4096_u64, 0_u8);
  let pattern = buffer_new(4096_u64, 0_u8);
  let report = buffer_new(512_u64, 0_u8);
  let arguments = 0_u64;
  region 'invocation {
    set arguments = args_count::<'invocation>(args: &'invocation args);
  }
  let startup = 0_u8;
  let pattern_length = 0_u64;
  let usable = arguments >= 3_u64;
  if usable {
    region 'pattern_lease {
      match arg_get::<'pattern_lease>(args: &'pattern_lease args, position: 1_u64) {
        Ok(value: text) => {
          region 'pattern_copy {
            match host_copy_bytes::<'pattern_copy, 'pattern_copy>(value: &'pattern_copy text, destination: &uniq 'pattern_copy pattern, start: 0_u64, end: 4096_u64) {
              Ok(value: copied) => {
                set pattern_length = copied;
              }
              Err(error: too_small) => {
                set startup = 2_u8;
              }
            }
          }
        }
        Err(error: absent) => {
          set startup = 1_u8;
        }
      }
    }
  } else {
    set startup = 1_u8;
  }
  if startup == 0_u8 {
  } else {
    let length = 0_u64;
    if startup == 1_u8 {
      region 'startup_usage {
        let view = slice_of(&'startup_usage usage_text);
        set length = append_slice::<'startup_usage, 'startup_usage>(destination: &uniq 'startup_usage report, filled: length, text: move view);
      }
    } else {
      region 'startup_pattern {
        let view = slice_of(&'startup_pattern reason_pattern_too_long);
        set length = append_slice::<'startup_pattern, 'startup_pattern>(destination: &uniq 'startup_pattern report, filled: length, text: move view);
      }
    }
    region 'startup_write {
      match publish_all::<'startup_write, 'startup_write>(output: &uniq 'startup_write err, source: &'startup_write report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
    return exit_status(code: 2_u8);
  }
  let first_pattern_byte = pattern[0_u64];
  let empty_pattern = pattern_length == 0_u64;
  let failed = 0_u8;
  let matched = 0_u8;
  let filled = 0_u64;
  let write_failed = 0_u8;
  let write_class = 0_u8;
  let position = 2_u64;
  loop @files {
    let more = position < arguments;
    if more {
    } else {
      break @files;
    }
    let status = 0_u8;
    region 'file_lease {
      match arg_get::<'file_lease>(args: &'file_lease args, position: position) {
        Ok(value: text) => {
          match relative_path(value: move text) {
            Ok(value: path) => {
              region 'open_call {
                let permit = reserve_file::<'open_call>(factory: &uniq 'open_call files);
                match open_read::<'open_call, 'open_call>(permit: move permit, root: &'open_call cwd, path: &'open_call path) {
                  Ok(value: file) => {
                    let carry = 0_u64;
                    let file_offset = 0_u64;
                    loop @chunks {
                      let carry_fits = carry < 4096_u64;
                      if carry_fits {
                      } else {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let room = 4096_u64 -wrap carry;
                      let overlong = room == 0_u64;
                      if overlong {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let available = 0_u64;
                      let ended = 0_u8;
                      region 'read_call {
                        match read_at::<'read_call, 'read_call>(file: &'read_call file, destination: &uniq 'read_call input, file_offset: file_offset, start: carry, end: 4096_u64) {
                          ReadBytes(next: taken) => {
                            set available = taken;
                            let delivered = taken -wrap carry;
                            set file_offset = file_offset +wrap delivered;
                          }
                          ReadEnd() => {
                            set ended = 1_u8;
                          }
                          ReadFailed(error: problem) => {
                            set status = io_class(error: move problem);
                            set ended = 2_u8;
                          }
                        }
                      }
                      if ended == 2_u8 {
                        break @chunks;
                      }
                      if ended == 1_u8 {
                        let trailing = carry > 0_u64;
                        if trailing {
                          set input[carry] = 10_u8;
                          set available = carry +wrap 1_u64;
                        }
                      }
                      let available_fits = available <= 4096_u64;
                      if available_fits {
                      } else {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let scan = 0_u64;
                      loop @lines {
                        let terminator = available;
                        let hit = empty_pattern;
                        let probe = scan;
                        loop @walk {
                          let done = probe >= available;
                          if done {
                            break @walk;
                          }
                          let byte = input[probe];
                          let newline = byte == 10_u8;
                          if newline {
                            set terminator = probe;
                            break @walk;
                          }
                          if hit {
                          } else {
                            let lead = byte == first_pattern_byte;
                            if lead {
                              let same = True();
                              let ahead = 1_u64;
                              loop @verify {
                                let proven = ahead >= pattern_length;
                                if proven {
                                  break @verify;
                                }
                                let spot = probe +wrap ahead;
                                let inside = spot < available;
                                if inside {
                                } else {
                                  set same = False();
                                  break @verify;
                                }
                                let ahead_fits = ahead < 4096_u64;
                                if ahead_fits {
                                } else {
                                  set same = False();
                                  break @verify;
                                }
                                let candidate = input[spot];
                                let stopper = candidate == 10_u8;
                                if stopper {
                                  set same = False();
                                  break @verify;
                                }
                                let expected = pattern[ahead];
                                let equal = candidate == expected;
                                if equal {
                                } else {
                                  set same = False();
                                  break @verify;
                                }
                                set ahead = ahead +wrap 1_u64;
                              }
                              if same {
                                set hit = True();
                              }
                            }
                          }
                          set probe = probe +wrap 1_u64;
                        }
                        let complete = terminator < available;
                        if complete {
                        } else {
                          break @lines;
                        }
                        if hit {
                          set matched = 1_u8;
                          let stop = terminator +wrap 1_u64;
                          let span = stop -wrap scan;
                          let need = filled +wrap span;
                          let overfull = need > 4096_u64;
                          if overfull {
                            let filled_fits = filled <= 4096_u64;
                            if filled_fits {
                              region 'batch_write {
                                match publish_all::<'batch_write, 'batch_write>(output: &uniq 'batch_write out, source: &'batch_write batch, length: filled) {
                                  Ok(value: published) => {
                                  }
                                  Err(error: problem) => {
                                    set write_failed = 1_u8;
                                    set write_class = io_class(error: move problem);
                                  }
                                }
                              }
                            } else {
                              set write_failed = 1_u8;
                            }
                            set filled = 0_u64;
                          }
                          if write_failed == 0_u8 {
                            region 'emit_line {
                              set filled = copy_range::<'emit_line, 'emit_line>(destination: &uniq 'emit_line batch, at: filled, source: &'emit_line input, from: scan, to: stop);
                            }
                          } else {
                            break @files;
                          }
                        }
                        set scan = terminator +wrap 1_u64;
                      }
                      if ended == 1_u8 {
                        break @chunks;
                      }
                      let tail = available -wrap scan;
                      let moved = 0_u64;
                      loop @shift {
                        let done = moved >= tail;
                        if done {
                          break @shift;
                        }
                        let source_index = scan +wrap moved;
                        let source_fits = source_index < 4096_u64;
                        let target_fits = moved < 4096_u64;
                        if source_fits {
                        } else {
                          break @shift;
                        }
                        if target_fits {
                        } else {
                          break @shift;
                        }
                        let byte = input[source_index];
                        set input[moved] = byte;
                        set moved = moved +wrap 1_u64;
                      }
                      set carry = tail;
                    }
                  }
                  Err(error: problem) => {
                    set status = io_class(error: move problem);
                  }
                }
              }
            }
            Err(error: rejected) => {
              set status = 5_u8;
            }
          }
        }
        Err(error: absent) => {
          set status = 9_u8;
        }
      }
    }
    let reportable = status != 0_u8;
    if reportable {
      set failed = 1_u8;
      region 'report_call {
        report_failure::<'report_call, 'report_call, 'report_call>(args: &'report_call args, err: &uniq 'report_call err, report: &uniq 'report_call report, status: status, position: position);
      }
    }
    set position = position +wrap 1_u64;
  }
  if write_failed == 0_u8 {
    let filled_fits = filled <= 4096_u64;
    if filled_fits {
      region 'final_write {
        match publish_all::<'final_write, 'final_write>(output: &uniq 'final_write out, source: &'final_write batch, length: filled) {
          Ok(value: published) => {
          }
          Err(error: problem) => {
            set write_failed = 1_u8;
            set write_class = io_class(error: move problem);
          }
        }
      }
    } else {
      set write_failed = 1_u8;
    }
  }
  if write_failed == 0_u8 {
  } else {
    set failed = 1_u8;
    let length = 0_u64;
    if write_class == 4_u8 {
      region 'fail_pipe_view {
        let view = slice_of(&'fail_pipe_view reason_broken_pipe);
        set length = append_slice::<'fail_pipe_view, 'fail_pipe_view>(destination: &uniq 'fail_pipe_view report, filled: length, text: move view);
      }
    } else {
      region 'fail_write_view {
        let view = slice_of(&'fail_write_view reason_write_error);
        set length = append_slice::<'fail_write_view, 'fail_write_view>(destination: &uniq 'fail_write_view report, filled: length, text: move view);
      }
    }
    region 'fail_write {
      match publish_all::<'fail_write, 'fail_write>(output: &uniq 'fail_write err, source: &'fail_write report, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
  }
  if failed == 0_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  if matched == 0_u8 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
