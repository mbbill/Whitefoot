fn byte_at(store: &buffer<u8>, index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the buffer does not hold.";
  let room = len(deref(store));
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn parse_number(digits: &buffer<u8>, length: own u64) -> result: own u64 reads(digits) {
  doc "Reads one decimal number out of the argument bytes the invocation supplied; a byte that is not a digit ends the number.";
  let value = 0_u64;
  let ended = 0_u8;
  let index = 0_u64;
  loop @scan {
    let more = index < length;
    if more {
    } else {
      break @scan;
    }
    let byte = byte_at(store: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
      let value_byte = byte -wrap 48_u8;
      let widened = cvt::<u8, u64>(value_byte);
      let scaled = value *wrap 10_u64;
      set value = scaled +wrap widened;
    } else {
      set ended = 1_u8;
    }
    if ended == 0_u8 {
      set index = index +wrap 1_u64;
    } else {
      break @scan;
    }
  }
  return value;
}

fn argument(args: &Args, position: own u64) -> result: own u64 reads(args), allocates(heap) {
  doc "One decimal invocation argument, through the text route, so the digits are the same bytes on every host string family [HOST-2]; zero when the argument is absent or not text.";
  let digits = buffer_new(24_u64, 0_u8);
  let carried = 0_u64;
  region {
    match arg_get(args: args, position: position) {
      Ok(value: text) => {
        region {
          match host_copy_utf8(value: &text, destination: &uniq digits, start: 0_u64, end: 24_u64) {
            Ok(value: written) => {
              set carried = written;
            }
            Err(error: problem) => {
              set carried = 0_u64;
            }
          }
        }
      }
      Err(error: problem) => {
        set carried = 0_u64;
      }
    }
  }
  let value = 0_u64;
  region {
    set value = parse_number(digits: &digits, length: carried);
  }
  return value;
}

fn send_all(send: &uniq TcpSend, source: &buffer<u8>, length: own u64) -> result: own Result<unit, IoError> reads(send, source), writes(send) contract {
  define source_length = len(deref(source));
  requires length <= source_length;
} {
  doc "Sends one prefix of the source buffer, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    region {
      match send_once(send: &uniq deref(send), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn serve_one(listener: &TcpListener, permit: own HandlePermit) -> result: own u8 reads(listener, permit), writes(permit), allocates(heap) {
  doc "Takes one connection from the listener and returns every chunk the peer sends until the peer stops sending, then releases the pair [SYS-17, SYS-18]. The chunk loop is this connection's own sequential loop; the caller's fixed-trip loop keeps one of these in flight per connection.";
  let outcome = 0_u8;
  region {
    match tcp_accept(permit: move permit, listener: listener) {
      Accepted(connection: link, peer: from) => {
        let scratch = buffer_new(65536_u64, 0_u8);
        loop @chunks {
          let available = 0_u64;
          let ended = 0_u8;
          region {
            match receive_next(receive: &uniq link.receive, destination: &uniq scratch, start: 0_u64, end: 65536_u64) {
              ReadBytes(next: endpoint) => {
                set available = endpoint;
              }
              ReadEnd() => {
                set ended = 1_u8;
              }
              ReadFailed(error: problem) => {
                set outcome = 3_u8;
                set ended = 2_u8;
              }
            }
          }
          if ended == 0_u8 {
            region {
              match send_all(send: &uniq link.send, source: &scratch, length: available) {
                Ok(value: delivered) => {
                }
                Err(error: problem) => {
                  set outcome = 4_u8;
                  set ended = 2_u8;
                }
              }
            }
          }
          if ended == 0_u8 {
          } else {
            break @chunks;
          }
        }
        let credit = close_connection(connection: move link);
      }
      AcceptFailed(error: problem, permit: handed_back) => {
        set outcome = 5_u8;
      }
    }
  }
  return outcome;
}

command fn main(command.args as args: own Args, command.handles as handles: own HandleFactory) -> status: own ExitStatus reads(args, handles), writes(handles), allocates(heap) {
  doc "The Whitefoot line of the TCP echo workload: listens on the loopback port named by the first argument, serves exactly the number of connections named by the second in a fixed-trip loop the staged permission admits, echoing every byte each peer sends until that peer stops, and exits zero once every connection has closed [PAR-3, SYS-17, SYS-18]. Each iteration takes its own permit; the callee owns an initialized scratch buffer after accepting its connection, so each exchange can remain in flight until its peer stops sending.";
  let arguments = 0_u64;
  region {
    set arguments = args_count(args: &args);
  }
  let named = arguments >= 3_u64;
  if named {
  } else {
    return exit_status(code: 1_u8);
  }
  let port_value = 0_u64;
  let count = 0_u64;
  region {
    set port_value = argument(args: &args, position: 1_u64);
    set count = argument(args: &args, position: 2_u64);
  }
  let port_named = port_value <= 65535_u64;
  let count_named = count >= 1_u64;
  let usable = band(port_named, count_named);
  if usable {
  } else {
    return exit_status(code: 2_u8);
  }
  let port = 0_u16;
  region {
    match cvt::<u64, u16>(port_value) {
      Ok(value: narrowed) => {
        set port = narrowed;
      }
      Err(error: problem) => {
        return exit_status(code: 2_u8);
      }
    }
  }
  let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let outcome = 0_u8;
  region {
    match reserve_handle(factory: &uniq handles) {
      Ok(value: listen_permit) => {
        region {
          match tcp_listen(permit: move listen_permit, address: &address) {
            Listening(listener: bound) => {
              for (
                served in 0_u64..count,
                invariant progress: served <= count
              ) {
                match reserve_handle(factory: &uniq handles) {
                  Ok(value: accept_permit) => {
                    let reported = serve_one(listener: &bound, permit: move accept_permit);
                    if reported == 0_u8 {
                    } else {
                      set outcome = reported;
                    }
                  }
                  Err(error: problem) => {
                    return exit_status(code: 6_u8);
                  }
                }
              }
              let listener_credit = close_listener(listener: move bound);
            }
            ListenFailed(error: problem, permit: handed_back) => {
              set outcome = 7_u8;
            }
          }
        }
      }
      Err(error: problem) => {
        set outcome = 8_u8;
      }
    }
  }
  return exit_status(code: outcome);
}
