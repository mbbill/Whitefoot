fn name_at['n](name: &uniq 'n buffer<u8>, index: own u64) -> result: own unit reads(name), writes(name) {
  doc "Renders the fixed ten-byte generated file name for one index as f00000.dat.";
  let room = len(deref(name));
  let sized = room >= 10_u64;
  if sized {
  } else {
    return unit;
  }
  set deref(name)[0_u64] = 102_u8;
  let value = index;
  let position = 5_u64;
  loop @digits {
    let digit = value % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(name)[position] = byte;
    }
    set value = value / 10_u64;
    let done = position == 1_u64;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
  }
  set deref(name)[6_u64] = 46_u8;
  set deref(name)[7_u64] = 100_u8;
  set deref(name)[8_u64] = 97_u8;
  set deref(name)[9_u64] = 116_u8;
  return unit;
}

fn render_u64['d](destination: &uniq 'd buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination) {
  doc "Renders one twenty-digit zero-padded decimal number and reports the position after it.";
  let room = len(deref(destination));
  let remaining = value;
  let position = at +wrap 20_u64;
  loop @digits {
    let done = position <= at;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
    let digit = remaining % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(destination)[position] = byte;
    }
    set remaining = remaining / 10_u64;
  }
  return at +wrap 20_u64;
}

fn fold_bytes['b](source: &'b buffer<u8>, produced: own u64, seed: own u64) -> result: own u64 reads(source) {
  doc "Folds one read prefix into a running order-sensitive checksum.";
  let room = len(deref(source));
  let sum = seed;
  let at = 0_u64;
  loop @fold {
    let scanned = at >= produced;
    if scanned {
      break @fold;
    }
    let readable = at < room;
    if readable {
    } else {
      break @fold;
    }
    let byte = deref(source)[at];
    let widened = cvt::<u8, u64>(byte);
    set sum = sum *wrap 31_u64;
    set sum = sum +wrap widened;
    set at = at +wrap 1_u64;
  }
  return sum;
}

fn block_at(index: own u64) -> result: own u64 pure {
  doc "Renders the read schedule's window index for one read position, from that position alone.";
  let mixed = index *wrap 11400714819323198485_u64;
  let folded = ishr.wrap(mixed, 33_u32);
  set mixed = ixor(mixed, folded);
  set mixed = mixed *wrap 18397679294719823053_u64;
  set folded = ishr.wrap(mixed, 33_u32);
  set mixed = ixor(mixed, folded);
  set mixed = mixed *wrap 14181476777654086739_u64;
  set folded = ishr.wrap(mixed, 33_u32);
  set mixed = ixor(mixed, folded);
  return mixed % 16384_u64;
}

command fn main(command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, out, files), writes(cwd, out, files), allocates(heap) {
  doc "Opens the eight generated files once and then reads them one positioned window at a time, publishing one folded checksum.";
  let name_0 = buffer_new(16_u64, 0_u8);
  let name_1 = buffer_new(16_u64, 0_u8);
  let name_2 = buffer_new(16_u64, 0_u8);
  let name_3 = buffer_new(16_u64, 0_u8);
  let name_4 = buffer_new(16_u64, 0_u8);
  let name_5 = buffer_new(16_u64, 0_u8);
  let name_6 = buffer_new(16_u64, 0_u8);
  let name_7 = buffer_new(16_u64, 0_u8);
  let data = buffer_new(4096_u64, 0_u8);
  let line = buffer_new(64_u64, 0_u8);
  let sum = 0_u64;
  let bytes = 0_u64;
  region 'name_0 {
    let rendered_0 = name_at::<'name_0>(name: &uniq 'name_0 name_0, index: 0_u64);
  }
  region 'name_1 {
    let rendered_1 = name_at::<'name_1>(name: &uniq 'name_1 name_1, index: 1_u64);
  }
  region 'name_2 {
    let rendered_2 = name_at::<'name_2>(name: &uniq 'name_2 name_2, index: 2_u64);
  }
  region 'name_3 {
    let rendered_3 = name_at::<'name_3>(name: &uniq 'name_3 name_3, index: 3_u64);
  }
  region 'name_4 {
    let rendered_4 = name_at::<'name_4>(name: &uniq 'name_4 name_4, index: 4_u64);
  }
  region 'name_5 {
    let rendered_5 = name_at::<'name_5>(name: &uniq 'name_5 name_5, index: 5_u64);
  }
  region 'name_6 {
    let rendered_6 = name_at::<'name_6>(name: &uniq 'name_6 name_6, index: 6_u64);
  }
  region 'name_7 {
    let rendered_7 = name_at::<'name_7>(name: &uniq 'name_7 name_7, index: 7_u64);
  }
  region 'f {
    let permit_0 = reserve_file::<'f>(factory: &uniq 'f files);
    let permit_1 = reserve_file::<'f>(factory: &uniq 'f files);
    let permit_2 = reserve_file::<'f>(factory: &uniq 'f files);
    let permit_3 = reserve_file::<'f>(factory: &uniq 'f files);
    let permit_4 = reserve_file::<'f>(factory: &uniq 'f files);
    let permit_5 = reserve_file::<'f>(factory: &uniq 'f files);
    let permit_6 = reserve_file::<'f>(factory: &uniq 'f files);
    let permit_7 = reserve_file::<'f>(factory: &uniq 'f files);
    region 'n {
      let opened_0 = open_file::<'f, 'n>(permit: move permit_0, root: &'f cwd, name: &'n name_0, start: 0_u64, end: 10_u64);
      let opened_1 = open_file::<'f, 'n>(permit: move permit_1, root: &'f cwd, name: &'n name_1, start: 0_u64, end: 10_u64);
      let opened_2 = open_file::<'f, 'n>(permit: move permit_2, root: &'f cwd, name: &'n name_2, start: 0_u64, end: 10_u64);
      let opened_3 = open_file::<'f, 'n>(permit: move permit_3, root: &'f cwd, name: &'n name_3, start: 0_u64, end: 10_u64);
      let opened_4 = open_file::<'f, 'n>(permit: move permit_4, root: &'f cwd, name: &'n name_4, start: 0_u64, end: 10_u64);
      let opened_5 = open_file::<'f, 'n>(permit: move permit_5, root: &'f cwd, name: &'n name_5, start: 0_u64, end: 10_u64);
      let opened_6 = open_file::<'f, 'n>(permit: move permit_6, root: &'f cwd, name: &'n name_6, start: 0_u64, end: 10_u64);
      let opened_7 = open_file::<'f, 'n>(permit: move permit_7, root: &'f cwd, name: &'n name_7, start: 0_u64, end: 10_u64);
      match opened_0 {
        Ok(value: handle_0) => {
          match opened_1 {
            Ok(value: handle_1) => {
              match opened_2 {
                Ok(value: handle_2) => {
                  match opened_3 {
                    Ok(value: handle_3) => {
                      match opened_4 {
                        Ok(value: handle_4) => {
                          match opened_5 {
                            Ok(value: handle_5) => {
                              match opened_6 {
                                Ok(value: handle_6) => {
                                  match opened_7 {
                                    Ok(value: handle_7) => {
                                      let position_0 = 0_u64;
                                      loop @lane_0 {
                                        let done_0 = position_0 >= 32768_u64;
                                        if done_0 {
                                          break @lane_0;
                                        }
                                        let block_0 = block_at(index: position_0);
                                        let offset_0 = block_0 *wrap 4096_u64;
                                        region 'h_0 {
                                          region 'd_0 {
                                            match read_at::<'h_0, 'd_0>(file: &'h_0 handle_0, destination: &uniq 'd_0 data, file_offset: offset_0, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_0) => {
                                                let digest_0 = 0_u64;
                                                region 'fold_0 {
                                                  set digest_0 = fold_bytes::<'fold_0>(source: &'fold_0 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_0 = position_0 +wrap 1_u64;
                                                set digest_0 = digest_0 *wrap weight_0;
                                                set sum = sum +wrap digest_0;
                                                set bytes = bytes +wrap produced_0;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_0) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_0 = position_0 +wrap 8_u64;
                                      }
                                      let position_1 = 1_u64;
                                      loop @lane_1 {
                                        let done_1 = position_1 >= 32768_u64;
                                        if done_1 {
                                          break @lane_1;
                                        }
                                        let block_1 = block_at(index: position_1);
                                        let offset_1 = block_1 *wrap 4096_u64;
                                        region 'h_1 {
                                          region 'd_1 {
                                            match read_at::<'h_1, 'd_1>(file: &'h_1 handle_1, destination: &uniq 'd_1 data, file_offset: offset_1, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_1) => {
                                                let digest_1 = 0_u64;
                                                region 'fold_1 {
                                                  set digest_1 = fold_bytes::<'fold_1>(source: &'fold_1 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_1 = position_1 +wrap 1_u64;
                                                set digest_1 = digest_1 *wrap weight_1;
                                                set sum = sum +wrap digest_1;
                                                set bytes = bytes +wrap produced_1;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_1) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_1 = position_1 +wrap 8_u64;
                                      }
                                      let position_2 = 2_u64;
                                      loop @lane_2 {
                                        let done_2 = position_2 >= 32768_u64;
                                        if done_2 {
                                          break @lane_2;
                                        }
                                        let block_2 = block_at(index: position_2);
                                        let offset_2 = block_2 *wrap 4096_u64;
                                        region 'h_2 {
                                          region 'd_2 {
                                            match read_at::<'h_2, 'd_2>(file: &'h_2 handle_2, destination: &uniq 'd_2 data, file_offset: offset_2, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_2) => {
                                                let digest_2 = 0_u64;
                                                region 'fold_2 {
                                                  set digest_2 = fold_bytes::<'fold_2>(source: &'fold_2 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_2 = position_2 +wrap 1_u64;
                                                set digest_2 = digest_2 *wrap weight_2;
                                                set sum = sum +wrap digest_2;
                                                set bytes = bytes +wrap produced_2;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_2) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_2 = position_2 +wrap 8_u64;
                                      }
                                      let position_3 = 3_u64;
                                      loop @lane_3 {
                                        let done_3 = position_3 >= 32768_u64;
                                        if done_3 {
                                          break @lane_3;
                                        }
                                        let block_3 = block_at(index: position_3);
                                        let offset_3 = block_3 *wrap 4096_u64;
                                        region 'h_3 {
                                          region 'd_3 {
                                            match read_at::<'h_3, 'd_3>(file: &'h_3 handle_3, destination: &uniq 'd_3 data, file_offset: offset_3, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_3) => {
                                                let digest_3 = 0_u64;
                                                region 'fold_3 {
                                                  set digest_3 = fold_bytes::<'fold_3>(source: &'fold_3 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_3 = position_3 +wrap 1_u64;
                                                set digest_3 = digest_3 *wrap weight_3;
                                                set sum = sum +wrap digest_3;
                                                set bytes = bytes +wrap produced_3;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_3) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_3 = position_3 +wrap 8_u64;
                                      }
                                      let position_4 = 4_u64;
                                      loop @lane_4 {
                                        let done_4 = position_4 >= 32768_u64;
                                        if done_4 {
                                          break @lane_4;
                                        }
                                        let block_4 = block_at(index: position_4);
                                        let offset_4 = block_4 *wrap 4096_u64;
                                        region 'h_4 {
                                          region 'd_4 {
                                            match read_at::<'h_4, 'd_4>(file: &'h_4 handle_4, destination: &uniq 'd_4 data, file_offset: offset_4, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_4) => {
                                                let digest_4 = 0_u64;
                                                region 'fold_4 {
                                                  set digest_4 = fold_bytes::<'fold_4>(source: &'fold_4 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_4 = position_4 +wrap 1_u64;
                                                set digest_4 = digest_4 *wrap weight_4;
                                                set sum = sum +wrap digest_4;
                                                set bytes = bytes +wrap produced_4;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_4) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_4 = position_4 +wrap 8_u64;
                                      }
                                      let position_5 = 5_u64;
                                      loop @lane_5 {
                                        let done_5 = position_5 >= 32768_u64;
                                        if done_5 {
                                          break @lane_5;
                                        }
                                        let block_5 = block_at(index: position_5);
                                        let offset_5 = block_5 *wrap 4096_u64;
                                        region 'h_5 {
                                          region 'd_5 {
                                            match read_at::<'h_5, 'd_5>(file: &'h_5 handle_5, destination: &uniq 'd_5 data, file_offset: offset_5, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_5) => {
                                                let digest_5 = 0_u64;
                                                region 'fold_5 {
                                                  set digest_5 = fold_bytes::<'fold_5>(source: &'fold_5 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_5 = position_5 +wrap 1_u64;
                                                set digest_5 = digest_5 *wrap weight_5;
                                                set sum = sum +wrap digest_5;
                                                set bytes = bytes +wrap produced_5;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_5) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_5 = position_5 +wrap 8_u64;
                                      }
                                      let position_6 = 6_u64;
                                      loop @lane_6 {
                                        let done_6 = position_6 >= 32768_u64;
                                        if done_6 {
                                          break @lane_6;
                                        }
                                        let block_6 = block_at(index: position_6);
                                        let offset_6 = block_6 *wrap 4096_u64;
                                        region 'h_6 {
                                          region 'd_6 {
                                            match read_at::<'h_6, 'd_6>(file: &'h_6 handle_6, destination: &uniq 'd_6 data, file_offset: offset_6, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_6) => {
                                                let digest_6 = 0_u64;
                                                region 'fold_6 {
                                                  set digest_6 = fold_bytes::<'fold_6>(source: &'fold_6 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_6 = position_6 +wrap 1_u64;
                                                set digest_6 = digest_6 *wrap weight_6;
                                                set sum = sum +wrap digest_6;
                                                set bytes = bytes +wrap produced_6;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_6) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_6 = position_6 +wrap 8_u64;
                                      }
                                      let position_7 = 7_u64;
                                      loop @lane_7 {
                                        let done_7 = position_7 >= 32768_u64;
                                        if done_7 {
                                          break @lane_7;
                                        }
                                        let block_7 = block_at(index: position_7);
                                        let offset_7 = block_7 *wrap 4096_u64;
                                        region 'h_7 {
                                          region 'd_7 {
                                            match read_at::<'h_7, 'd_7>(file: &'h_7 handle_7, destination: &uniq 'd_7 data, file_offset: offset_7, start: 0_u64, end: 4096_u64) {
                                              ReadBytes(next: produced_7) => {
                                                let digest_7 = 0_u64;
                                                region 'fold_7 {
                                                  set digest_7 = fold_bytes::<'fold_7>(source: &'fold_7 data, produced: 64_u64, seed: 0_u64);
                                                }
                                                let weight_7 = position_7 +wrap 1_u64;
                                                set digest_7 = digest_7 *wrap weight_7;
                                                set sum = sum +wrap digest_7;
                                                set bytes = bytes +wrap produced_7;
                                              }
                                              ReadEnd() => {
                                              }
                                              ReadFailed(error: problem_7) => {
                                              }
                                            }
                                          }
                                        }
                                        set position_7 = position_7 +wrap 8_u64;
                                      }
                                    }
                                    Err(error: failed_7) => {
                                      return exit_status(code: 11_u8);
                                    }
                                  }
                                }
                                Err(error: failed_6) => {
                                  return exit_status(code: 10_u8);
                                }
                              }
                            }
                            Err(error: failed_5) => {
                              return exit_status(code: 9_u8);
                            }
                          }
                        }
                        Err(error: failed_4) => {
                          return exit_status(code: 8_u8);
                        }
                      }
                    }
                    Err(error: failed_3) => {
                      return exit_status(code: 7_u8);
                    }
                  }
                }
                Err(error: failed_2) => {
                  return exit_status(code: 6_u8);
                }
              }
            }
            Err(error: failed_1) => {
              return exit_status(code: 5_u8);
            }
          }
        }
        Err(error: failed_0) => {
          return exit_status(code: 4_u8);
        }
      }
    }
  }
  let room = len(line);
  let cursor = 0_u64;
  region 'render_sum {
    set cursor = render_u64::<'render_sum>(destination: &uniq 'render_sum line, at: cursor, value: sum);
  }
  let space_fits = cursor < room;
  if space_fits {
    set line[cursor] = 32_u8;
    set cursor = cursor +wrap 1_u64;
  }
  region 'render_bytes {
    set cursor = render_u64::<'render_bytes>(destination: &uniq 'render_bytes line, at: cursor, value: bytes);
  }
  let end_fits = cursor < room;
  if end_fits {
    set line[cursor] = 10_u8;
    set cursor = cursor +wrap 1_u64;
  }
  let status = 0_u8;
  let publishable = cursor <= room;
  if publishable {
    region 'publish {
      match write_once::<'publish, 'publish>(output: &uniq 'publish out, source: &'publish line, start: 0_u64, end: cursor) {
        Ok(value: written) => {
        }
        Err(error: problem) => {
          set status = 2_u8;
        }
      }
    }
  } else {
    set status = 3_u8;
  }
  return exit_status(code: status);
}
