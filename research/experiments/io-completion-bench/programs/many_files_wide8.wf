fn name_at(name: &uniq buffer<u8>, index: own u64) -> result: own unit reads(name), writes(name) {
  doc "Renders the fixed ten-byte generated file name for one index as f00000.dat.";
  let room = len(deref(name));
  let sized = room >= 10_u64;
  if sized {
  } else {
    return unit;
  }
  set deref(name)[0_u64] = 102_u8;
  let value = index;
  let position = 5_u64;
  loop @digits {
    let digit = value % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(name)[position] = byte;
    }
    set value = value / 10_u64;
    let done = position == 1_u64;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
  }
  set deref(name)[6_u64] = 46_u8;
  set deref(name)[7_u64] = 100_u8;
  set deref(name)[8_u64] = 97_u8;
  set deref(name)[9_u64] = 116_u8;
  return unit;
}

fn render_u64(destination: &uniq buffer<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination) {
  doc "Renders one twenty-digit zero-padded decimal number and reports the position after it.";
  let room = len(deref(destination));
  let remaining = value;
  let position = at +wrap 20_u64;
  loop @digits {
    let done = position <= at;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
    let digit = remaining % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(destination)[position] = byte;
    }
    set remaining = remaining / 10_u64;
  }
  return at +wrap 20_u64;
}

fn fold_bytes(source: &buffer<u8>, produced: own u64, seed: own u64) -> result: own u64 reads(source) {
  doc "Folds one read prefix into a running order-sensitive checksum.";
  let room = len(deref(source));
  let sum = seed;
  let at = 0_u64;
  loop @fold {
    let scanned = at >= produced;
    if scanned {
      break @fold;
    }
    let readable = at < room;
    if readable {
    } else {
      break @fold;
    }
    let byte = deref(source)[at];
    let widened = cvt::<u8, u64>(byte);
    set sum = sum *wrap 31_u64;
    set sum = sum +wrap widened;
    set at = at +wrap 1_u64;
  }
  return sum;
}

command fn main(command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(cwd, out, files), writes(cwd, out, files), allocates(heap) {
  doc "Opens and reads the generated file set eight independent files at a time and publishes one folded checksum.";
  let name_a = buffer_new(16_u64, 0_u8);
  let name_b = buffer_new(16_u64, 0_u8);
  let name_c = buffer_new(16_u64, 0_u8);
  let name_d = buffer_new(16_u64, 0_u8);
  let name_e = buffer_new(16_u64, 0_u8);
  let name_f = buffer_new(16_u64, 0_u8);
  let name_g = buffer_new(16_u64, 0_u8);
  let name_h = buffer_new(16_u64, 0_u8);
  let data_a = buffer_new(65536_u64, 0_u8);
  let data_b = buffer_new(65536_u64, 0_u8);
  let data_c = buffer_new(65536_u64, 0_u8);
  let data_d = buffer_new(65536_u64, 0_u8);
  let data_e = buffer_new(65536_u64, 0_u8);
  let data_f = buffer_new(65536_u64, 0_u8);
  let data_g = buffer_new(65536_u64, 0_u8);
  let data_h = buffer_new(65536_u64, 0_u8);
  let line = buffer_new(64_u64, 0_u8);
  let sum_a = 0_u64;
  let sum_b = 0_u64;
  let sum_c = 0_u64;
  let sum_d = 0_u64;
  let sum_e = 0_u64;
  let sum_f = 0_u64;
  let sum_g = 0_u64;
  let sum_h = 0_u64;
  let bytes = 0_u64;
  let index = 0_u64;
  loop @scan {
    let done = index >= 8192_u64;
    if done {
      break @scan;
    }
    let second = index +wrap 1_u64;
    let third = index +wrap 2_u64;
    let fourth = index +wrap 3_u64;
    let fifth = index +wrap 4_u64;
    let sixth = index +wrap 5_u64;
    let seventh = index +wrap 6_u64;
    let eighth = index +wrap 7_u64;
    region {
      let rendered_a = name_at(name: &uniq name_a, index: index);
    }
    region {
      let rendered_b = name_at(name: &uniq name_b, index: second);
    }
    region {
      let rendered_c = name_at(name: &uniq name_c, index: third);
    }
    region {
      let rendered_d = name_at(name: &uniq name_d, index: fourth);
    }
    region {
      let rendered_e = name_at(name: &uniq name_e, index: fifth);
    }
    region {
      let rendered_f = name_at(name: &uniq name_f, index: sixth);
    }
    region {
      let rendered_g = name_at(name: &uniq name_g, index: seventh);
    }
    region {
      let rendered_h = name_at(name: &uniq name_h, index: eighth);
    }
    region 'f {
      match reserve_file(factory: &uniq files) {
        Ok(value: permit_a) => {
          match reserve_file(factory: &uniq files) {
            Ok(value: permit_b) => {
              match reserve_file(factory: &uniq files) {
                Ok(value: permit_c) => {
                  match reserve_file(factory: &uniq files) {
                    Ok(value: permit_d) => {
                      match reserve_file(factory: &uniq files) {
                        Ok(value: permit_e) => {
                          match reserve_file(factory: &uniq files) {
                            Ok(value: permit_f) => {
                              match reserve_file(factory: &uniq files) {
                                Ok(value: permit_g) => {
                                  match reserve_file(factory: &uniq files) {
                                    Ok(value: permit_h) => {
                                      region {
                                        let opened_a = open_file(permit: move permit_a, root: &'f cwd, name: &name_a, start: 0_u64, end: 10_u64);
                                        let opened_b = open_file(permit: move permit_b, root: &'f cwd, name: &name_b, start: 0_u64, end: 10_u64);
                                        let opened_c = open_file(permit: move permit_c, root: &'f cwd, name: &name_c, start: 0_u64, end: 10_u64);
                                        let opened_d = open_file(permit: move permit_d, root: &'f cwd, name: &name_d, start: 0_u64, end: 10_u64);
                                        let opened_e = open_file(permit: move permit_e, root: &'f cwd, name: &name_e, start: 0_u64, end: 10_u64);
                                        let opened_f = open_file(permit: move permit_f, root: &'f cwd, name: &name_f, start: 0_u64, end: 10_u64);
                                        let opened_g = open_file(permit: move permit_g, root: &'f cwd, name: &name_g, start: 0_u64, end: 10_u64);
                                        let opened_h = open_file(permit: move permit_h, root: &'f cwd, name: &name_h, start: 0_u64, end: 10_u64);
                                        match opened_a {
                                          FileOpened(value: handle_a) => {
                                            match opened_b {
                                              FileOpened(value: handle_b) => {
                                                match opened_c {
                                                  FileOpened(value: handle_c) => {
                                                    match opened_d {
                                                      FileOpened(value: handle_d) => {
                                                        match opened_e {
                                                          FileOpened(value: handle_e) => {
                                                            match opened_f {
                                                              FileOpened(value: handle_f) => {
                                                                match opened_g {
                                                                  FileOpened(value: handle_g) => {
                                                                    match opened_h {
                                                                      FileOpened(value: handle_h) => {
                                                                        region 'h {
                                                                          region {
                                                                            let read_a = read_at(file: &'h handle_a, destination: &uniq data_a, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            let read_b = read_at(file: &'h handle_b, destination: &uniq data_b, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            let read_c = read_at(file: &'h handle_c, destination: &uniq data_c, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            let read_d = read_at(file: &'h handle_d, destination: &uniq data_d, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            let read_e = read_at(file: &'h handle_e, destination: &uniq data_e, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            let read_f = read_at(file: &'h handle_f, destination: &uniq data_f, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            let read_g = read_at(file: &'h handle_g, destination: &uniq data_g, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            let read_h = read_at(file: &'h handle_h, destination: &uniq data_h, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            match read_a {
                                                                              ReadBytes(next: produced_a) => {
                                                                                let digest_a = 0_u64;
                                                                                region {
                                                                                  set digest_a = fold_bytes(source: &data_a, produced: produced_a, seed: 0_u64);
                                                                                }
                                                                                let weight_a = index +wrap 1_u64;
                                                                                set digest_a = digest_a *wrap weight_a;
                                                                                set sum_a = sum_a +wrap digest_a;
                                                                                set bytes = bytes +wrap produced_a;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_a) => {
                                                                              }
                                                                            }
                                                                            match read_b {
                                                                              ReadBytes(next: produced_b) => {
                                                                                let digest_b = 0_u64;
                                                                                region {
                                                                                  set digest_b = fold_bytes(source: &data_b, produced: produced_b, seed: 0_u64);
                                                                                }
                                                                                let weight_b = second +wrap 1_u64;
                                                                                set digest_b = digest_b *wrap weight_b;
                                                                                set sum_b = sum_b +wrap digest_b;
                                                                                set bytes = bytes +wrap produced_b;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_b) => {
                                                                              }
                                                                            }
                                                                            match read_c {
                                                                              ReadBytes(next: produced_c) => {
                                                                                let digest_c = 0_u64;
                                                                                region {
                                                                                  set digest_c = fold_bytes(source: &data_c, produced: produced_c, seed: 0_u64);
                                                                                }
                                                                                let weight_c = third +wrap 1_u64;
                                                                                set digest_c = digest_c *wrap weight_c;
                                                                                set sum_c = sum_c +wrap digest_c;
                                                                                set bytes = bytes +wrap produced_c;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_c) => {
                                                                              }
                                                                            }
                                                                            match read_d {
                                                                              ReadBytes(next: produced_d) => {
                                                                                let digest_d = 0_u64;
                                                                                region {
                                                                                  set digest_d = fold_bytes(source: &data_d, produced: produced_d, seed: 0_u64);
                                                                                }
                                                                                let weight_d = fourth +wrap 1_u64;
                                                                                set digest_d = digest_d *wrap weight_d;
                                                                                set sum_d = sum_d +wrap digest_d;
                                                                                set bytes = bytes +wrap produced_d;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_d) => {
                                                                              }
                                                                            }
                                                                            match read_e {
                                                                              ReadBytes(next: produced_e) => {
                                                                                let digest_e = 0_u64;
                                                                                region {
                                                                                  set digest_e = fold_bytes(source: &data_e, produced: produced_e, seed: 0_u64);
                                                                                }
                                                                                let weight_e = fifth +wrap 1_u64;
                                                                                set digest_e = digest_e *wrap weight_e;
                                                                                set sum_e = sum_e +wrap digest_e;
                                                                                set bytes = bytes +wrap produced_e;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_e) => {
                                                                              }
                                                                            }
                                                                            match read_f {
                                                                              ReadBytes(next: produced_f) => {
                                                                                let digest_f = 0_u64;
                                                                                region {
                                                                                  set digest_f = fold_bytes(source: &data_f, produced: produced_f, seed: 0_u64);
                                                                                }
                                                                                let weight_f = sixth +wrap 1_u64;
                                                                                set digest_f = digest_f *wrap weight_f;
                                                                                set sum_f = sum_f +wrap digest_f;
                                                                                set bytes = bytes +wrap produced_f;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_f) => {
                                                                              }
                                                                            }
                                                                            match read_g {
                                                                              ReadBytes(next: produced_g) => {
                                                                                let digest_g = 0_u64;
                                                                                region {
                                                                                  set digest_g = fold_bytes(source: &data_g, produced: produced_g, seed: 0_u64);
                                                                                }
                                                                                let weight_g = seventh +wrap 1_u64;
                                                                                set digest_g = digest_g *wrap weight_g;
                                                                                set sum_g = sum_g +wrap digest_g;
                                                                                set bytes = bytes +wrap produced_g;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_g) => {
                                                                              }
                                                                            }
                                                                            match read_h {
                                                                              ReadBytes(next: produced_h) => {
                                                                                let digest_h = 0_u64;
                                                                                region {
                                                                                  set digest_h = fold_bytes(source: &data_h, produced: produced_h, seed: 0_u64);
                                                                                }
                                                                                let weight_h = eighth +wrap 1_u64;
                                                                                set digest_h = digest_h *wrap weight_h;
                                                                                set sum_h = sum_h +wrap digest_h;
                                                                                set bytes = bytes +wrap produced_h;
                                                                              }
                                                                              ReadEnd() => {
                                                                              }
                                                                              ReadFailed(error: problem_h) => {
                                                                              }
                                                                            }
                                                                          }
                                                                        }
                                                                      }
                                                                      FileOpenFailed(error: failed_h, permit: refused) => {
                                                                        return exit_status(code: 11_u8);
                                                                      }
                                                                    }
                                                                  }
                                                                  FileOpenFailed(error: failed_g, permit: refused) => {
                                                                    return exit_status(code: 10_u8);
                                                                  }
                                                                }
                                                              }
                                                              FileOpenFailed(error: failed_f, permit: refused) => {
                                                                return exit_status(code: 9_u8);
                                                              }
                                                            }
                                                          }
                                                          FileOpenFailed(error: failed_e, permit: refused) => {
                                                            return exit_status(code: 8_u8);
                                                          }
                                                        }
                                                      }
                                                      FileOpenFailed(error: failed_d, permit: refused) => {
                                                        return exit_status(code: 7_u8);
                                                      }
                                                    }
                                                  }
                                                  FileOpenFailed(error: failed_c, permit: refused) => {
                                                    return exit_status(code: 6_u8);
                                                  }
                                                }
                                              }
                                              FileOpenFailed(error: failed_b, permit: refused) => {
                                                return exit_status(code: 5_u8);
                                              }
                                            }
                                          }
                                          FileOpenFailed(error: failed_a, permit: refused) => {
                                            return exit_status(code: 4_u8);
                                          }
                                        }
                                      }
                                    }
                                    Err(error: spent) => {
                                      return exit_status(code: 19_u8);
                                    }
                                  }
                                }
                                Err(error: spent) => {
                                  return exit_status(code: 18_u8);
                                }
                              }
                            }
                            Err(error: spent) => {
                              return exit_status(code: 17_u8);
                            }
                          }
                        }
                        Err(error: spent) => {
                          return exit_status(code: 16_u8);
                        }
                      }
                    }
                    Err(error: spent) => {
                      return exit_status(code: 15_u8);
                    }
                  }
                }
                Err(error: spent) => {
                  return exit_status(code: 14_u8);
                }
              }
            }
            Err(error: spent) => {
              return exit_status(code: 13_u8);
            }
          }
        }
        Err(error: spent) => {
          return exit_status(code: 12_u8);
        }
      }
    }
    set index = index +wrap 8_u64;
  }
  let sum = sum_a;
  set sum = sum +wrap sum_b;
  set sum = sum +wrap sum_c;
  set sum = sum +wrap sum_d;
  set sum = sum +wrap sum_e;
  set sum = sum +wrap sum_f;
  set sum = sum +wrap sum_g;
  set sum = sum +wrap sum_h;
  let room = len(line);
  let cursor = 0_u64;
  region {
    set cursor = render_u64(destination: &uniq line, at: cursor, value: sum);
  }
  let space_fits = cursor < room;
  if space_fits {
    set line[cursor] = 32_u8;
    set cursor = cursor +wrap 1_u64;
  }
  region {
    set cursor = render_u64(destination: &uniq line, at: cursor, value: bytes);
  }
  let end_fits = cursor < room;
  if end_fits {
    set line[cursor] = 10_u8;
    set cursor = cursor +wrap 1_u64;
  }
  let status = 0_u8;
  let publishable = cursor <= room;
  if publishable {
    region {
      match write_once(output: &uniq out, source: &line, start: 0_u64, end: cursor) {
        Ok(value: written) => {
        }
        Err(error: problem) => {
          set status = 2_u8;
        }
      }
    }
  } else {
    set status = 3_u8;
  }
  return exit_status(code: status);
}
