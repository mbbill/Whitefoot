fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn discard_open_result(factory: &uniq HandleFactory, outcome: own FileOpenOutcome) -> result: own unit reads(factory), writes(factory) {
  match move outcome {
    FileOpened(value: file) => {
      region {
        close_read(factory: &uniq deref(factory), file: move file);
      }
    }
    FileOpenFailed(error: problem) => {
    }
  }
  return unit;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &uniq OutputStream, files: &uniq HandleFactory) -> status: own ExitStatus reads(args, cwd, out, files), writes(out, files) {
  doc "Copies two target-native argument names into component buffers, opens them without following terminal links, and publishes their first bytes.";
  let name_a = buffer_new(32_u64, 0_u8);
  let name_b = buffer_new(32_u64, 0_u8);
  let data_a = buffer_new(1_u64, 0_u8);
  let data_b = buffer_new(1_u64, 0_u8);
  let pair = buffer_new(2_u64, 0_u8);
  region {
    match arg_get(args: args, position: 1_u64) {
      Ok(value: text_a) => {
        region {
          let native_window_128 = mut_slice_of(&uniq name_a);
          region {
            match host_copy_bytes(value: &text_a, destination: &uniq native_window_128, start: 0_u64, end: 32_u64) {
              Ok(value: name_end_a) => {
                region {
                  match arg_get(args: args, position: 2_u64) {
                    Ok(value: text_b) => {
                      region {
                        let native_window_127 = mut_slice_of(&uniq name_b);
                        region {
                          match host_copy_bytes(value: &text_b, destination: &uniq native_window_127, start: 0_u64, end: 32_u64) {
                            Ok(value: name_end_b) => {
                              region {
                                let native_window_122 = slice_of(&name_a);
                                region {
                                  let opened_a = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_122, start: 0_u64, end: name_end_a);
                                  region {
                                    let native_window_123 = slice_of(&name_b);
                                    region {
                                      let opened_b = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_123, start: 0_u64, end: name_end_b);
                                      match move opened_a {
                                        FileOpened(value: file_a) => {
                                          match move opened_b {
                                            FileOpened(value: file_b) => {
                                              region {
                                                let native_window_124 = mut_slice_of(&uniq data_a);
                                                region {
                                                  region {
                                                    let read_a = read_at(factory: &uniq deref(files), file: &uniq file_a, destination: &uniq native_window_124, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                                    region {
                                                      let native_window_125 = mut_slice_of(&uniq data_b);
                                                      region {
                                                        let read_b = read_at(factory: &uniq deref(files), file: &uniq file_b, destination: &uniq native_window_125, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                                        match move read_a {
                                                          Ok(value: next_a) => {
                                                            if next_a == 1_u64 {
                                                            } else {
                                                              close_read(factory: &uniq deref(files), file: move file_b);
                                                              close_read(factory: &uniq deref(files), file: move file_a);
                                                              return exit_status(code: 9_u8);
                                                            }
                                                          }
                                                          Err(error: read_stop_120) => {
                                                            match read_stop_120 {
                                                              ReadEnd() => {
                                                                close_read(factory: &uniq deref(files), file: move file_b);
                                                                close_read(factory: &uniq deref(files), file: move file_a);
                                                                return exit_status(code: 10_u8);
                                                              }
                                                              ReadFailed(error: problem_a) => {
                                                                close_read(factory: &uniq deref(files), file: move file_b);
                                                                close_read(factory: &uniq deref(files), file: move file_a);
                                                                return exit_status(code: 11_u8);
                                                              }
                                                            }
                                                          }
                                                        }
                                                        match move read_b {
                                                          Ok(value: next_b) => {
                                                            if next_b == 1_u64 {
                                                            } else {
                                                              close_read(factory: &uniq deref(files), file: move file_b);
                                                              close_read(factory: &uniq deref(files), file: move file_a);
                                                              return exit_status(code: 12_u8);
                                                            }
                                                          }
                                                          Err(error: read_stop_121) => {
                                                            match read_stop_121 {
                                                              ReadEnd() => {
                                                                close_read(factory: &uniq deref(files), file: move file_b);
                                                                close_read(factory: &uniq deref(files), file: move file_a);
                                                                return exit_status(code: 13_u8);
                                                              }
                                                              ReadFailed(error: problem_b) => {
                                                                close_read(factory: &uniq deref(files), file: move file_b);
                                                                close_read(factory: &uniq deref(files), file: move file_a);
                                                                return exit_status(code: 14_u8);
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                  set pair[0_u64] = data_a[0_u64];
                                                  set pair[1_u64] = data_b[0_u64];
                                                  region {
                                                    let native_window_126 = slice_of(&pair);
                                                    region {
                                                      match write_once(factory: &uniq deref(files), output: &uniq deref(out), source: &native_window_126, start: 0_u64, end: 2_u64) {
                                                        Ok(value: published) => {
                                                          if published == 2_u64 {
                                                            close_read(factory: &uniq deref(files), file: move file_b);
                                                            close_read(factory: &uniq deref(files), file: move file_a);
                                                            return exit_status(code: 0_u8);
                                                          }
                                                          close_read(factory: &uniq deref(files), file: move file_b);
                                                          close_read(factory: &uniq deref(files), file: move file_a);
                                                          return exit_status(code: 15_u8);
                                                        }
                                                        Err(error: output_problem) => {
                                                          close_read(factory: &uniq deref(files), file: move file_b);
                                                          close_read(factory: &uniq deref(files), file: move file_a);
                                                          return exit_status(code: 16_u8);
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                            FileOpenFailed(error: problem_b) => {
                                              region {
                                                let failure_status = if factory_refusal(error: &problem_b) {
                                                  give 18_u8;
                                                } else {
                                                  give 8_u8;
                                                }
                                                close_read(factory: &uniq deref(files), file: move file_a);
                                                return exit_status(code: failure_status);
                                              }
                                            }
                                          }
                                        }
                                        FileOpenFailed(error: problem_a) => {
                                          region {
                                            let failure_status = if factory_refusal(error: &problem_a) {
                                              give 17_u8;
                                            } else {
                                              give 7_u8;
                                            }
                                            discard_open_result(factory: &uniq deref(files), outcome: move opened_b);
                                            return exit_status(code: failure_status);
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                            Err(error: too_small_b) => {
                              return exit_status(code: 6_u8);
                            }
                          }
                        }
                      }
                    }
                    Err(error: absent_b) => {
                      return exit_status(code: 5_u8);
                    }
                  }
                }
              }
              Err(error: too_small_a) => {
                return exit_status(code: 4_u8);
              }
            }
          }
        }
      }
      Err(error: absent_a) => {
        return exit_status(code: 3_u8);
      }
    }
  }
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, out: &uniq out, files: &uniq files);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
