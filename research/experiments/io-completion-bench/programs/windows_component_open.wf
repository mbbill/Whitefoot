command fn main(command.args as args: own Args, command.cwd as cwd: own DirectoryRead, command.stdout as out: own Output, command.files as files: own FileFactory) -> status: own ExitStatus reads(args, cwd, out, files), writes(cwd, out, files), allocates(heap) {
  doc "Copies two target-native argument names into component buffers, opens them without following terminal links, and publishes their first bytes.";
  let name_a = buffer_new(32_u64, 0_u8);
  let name_b = buffer_new(32_u64, 0_u8);
  let data_a = buffer_new(1_u64, 0_u8);
  let data_b = buffer_new(1_u64, 0_u8);
  let pair = buffer_new(2_u64, 0_u8);
  region {
    match arg_get(args: &args, position: 1_u64) {
      Ok(value: text_a) => {
        region {
          match host_copy_bytes(value: &text_a, destination: &uniq name_a, start: 0_u64, end: 32_u64) {
            Ok(value: name_end_a) => {
              region {
                match arg_get(args: &args, position: 2_u64) {
                  Ok(value: text_b) => {
                    region {
                      match host_copy_bytes(value: &text_b, destination: &uniq name_b, start: 0_u64, end: 32_u64) {
                        Ok(value: name_end_b) => {
                          region {
                            match reserve_file(factory: &uniq files) {
                              Ok(value: permit_a) => {
                                match reserve_file(factory: &uniq files) {
                                  Ok(value: permit_b) => {
                                    let opened_a = open_file(permit: move permit_a, root: &cwd, name: &name_a, start: 0_u64, end: name_end_a);
                                    let opened_b = open_file(permit: move permit_b, root: &cwd, name: &name_b, start: 0_u64, end: name_end_b);
                                    match move opened_a {
                                      FileOpened(value: file_a) => {
                                        match move opened_b {
                                          FileOpened(value: file_b) => {
                                            region 'files {
                                              region {
                                                let read_a = read_at(file: &'files file_a, destination: &uniq data_a, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                                let read_b = read_at(file: &'files file_b, destination: &uniq data_b, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                                                match move read_a {
                                                  ReadBytes(next: next_a) => {
                                                    if next_a == 1_u64 {
                                                    } else {
                                                      return exit_status(code: 9_u8);
                                                    }
                                                  }
                                                  ReadEnd() => {
                                                    return exit_status(code: 10_u8);
                                                  }
                                                  ReadFailed(error: problem_a) => {
                                                    return exit_status(code: 11_u8);
                                                  }
                                                }
                                                match move read_b {
                                                  ReadBytes(next: next_b) => {
                                                    if next_b == 1_u64 {
                                                    } else {
                                                      return exit_status(code: 12_u8);
                                                    }
                                                  }
                                                  ReadEnd() => {
                                                    return exit_status(code: 13_u8);
                                                  }
                                                  ReadFailed(error: problem_b) => {
                                                    return exit_status(code: 14_u8);
                                                  }
                                                }
                                              }
                                            }
                                            set pair[0_u64] = data_a[0_u64];
                                            set pair[1_u64] = data_b[0_u64];
                                            region {
                                              match write_once(output: &uniq out, source: &pair, start: 0_u64, end: 2_u64) {
                                                Ok(value: published) => {
                                                  if published == 2_u64 {
                                                    return exit_status(code: 0_u8);
                                                  }
                                                  return exit_status(code: 15_u8);
                                                }
                                                Err(error: output_problem) => {
                                                  return exit_status(code: 16_u8);
                                                }
                                              }
                                            }
                                          }
                                          FileOpenFailed(error: problem_b, permit: refused) => {
                                            return exit_status(code: 8_u8);
                                          }
                                        }
                                      }
                                      FileOpenFailed(error: problem_a, permit: refused) => {
                                        return exit_status(code: 7_u8);
                                      }
                                    }
                                  }
                                  Err(error: spent) => {
                                    return exit_status(code: 18_u8);
                                  }
                                }
                              }
                              Err(error: spent) => {
                                return exit_status(code: 17_u8);
                              }
                            }
                          }
                        }
                        Err(error: too_small_b) => {
                          return exit_status(code: 6_u8);
                        }
                      }
                    }
                  }
                  Err(error: absent_b) => {
                    return exit_status(code: 5_u8);
                  }
                }
              }
            }
            Err(error: too_small_a) => {
              return exit_status(code: 4_u8);
            }
          }
        }
      }
      Err(error: absent_a) => {
        return exit_status(code: 3_u8);
      }
    }
  }
}
