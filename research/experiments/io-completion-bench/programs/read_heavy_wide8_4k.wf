                                      let opened_2 = open_file(permit: move permit_2, root: &'f cwd, name: &name_2, start: 0_u64, end: name_end_2);
                                      let opened_3 = open_file(permit: move permit_3, root: &'f cwd, name: &name_3, start: 0_u64, end: name_end_3);
                                      let opened_4 = open_file(permit: move permit_4, root: &'f cwd, name: &name_4, start: 0_u64, end: name_end_4);
