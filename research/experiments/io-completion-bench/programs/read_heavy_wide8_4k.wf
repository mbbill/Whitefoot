                                                                        let offset_5 = block_5 *wrap 4096_u64;
                                                                        let block_6 = block_at(index: position_6);
                                                                        let offset_6 = block_6 *wrap 4096_u64;
                                                                        let block_7 = block_at(index: position_7);
                                                                        let offset_7 = block_7 *wrap 4096_u64;
                                                                        region 'h {
                                                                          region {
                                                                            let read_0 = read_at(file: &'h handle_0, destination: &uniq data_0, file_offset: offset_0, start: 0_u64, end: 4096_u64);
                                                                            let read_1 = read_at(file: &'h handle_1, destination: &uniq data_1, file_offset: offset_1, start: 0_u64, end: 4096_u64);
                                                                            let read_2 = read_at(file: &'h handle_2, destination: &uniq data_2, file_offset: offset_2, start: 0_u64, end: 4096_u64);
                                                                            let read_3 = read_at(file: &'h handle_3, destination: &uniq data_3, file_offset: offset_3, start: 0_u64, end: 4096_u64);
                                                                            let read_4 = read_at(file: &'h handle_4, destination: &uniq data_4, file_offset: offset_4, start: 0_u64, end: 4096_u64);
                                                                            let read_5 = read_at(file: &'h handle_5, destination: &uniq data_5, file_offset: offset_5, start: 0_u64, end: 4096_u64);
                                                                            let read_6 = read_at(file: &'h handle_6, destination: &uniq data_6, file_offset: offset_6, start: 0_u64, end: 4096_u64);
                                                                            let read_7 = read_at(file: &'h handle_7, destination: &uniq data_7, file_offset: offset_7, start: 0_u64, end: 4096_u64);
                                                                            match read_0 {
                                                                              ReadBytes(next: produced_0) => {
                                                                                let digest_0 = 0_u64;
                                                                                region {
                                                                                  set digest_0 = fold_bytes(source: &data_0, produced: 64_u64, seed: 0_u64);
                                                                                }
                                                                                let weight_0 = position_0 +wrap 1_u64;
                                                                                set digest_0 = digest_0 *wrap weight_0;
                                                                                set sum_0 = sum_0 +wrap digest_0;
                                                                                set bytes = bytes +wrap produced_0;
