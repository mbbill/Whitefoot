struct GrowVector<T> {
  storage: Box<Slots<T>>;
}

formal VectorDrain<T, E> {
  fn accept(env: &E, value: own T) -> result: own unit writes(env);
}

fn grow_vector_new<T>() -> made: own GrowVector<T> pure {
  doc "One empty vector over a zero-capacity backing window. A runtime-capacity window exists only as the content of a cell [TYPE-9], and allocation is total in the source [STOR-8], so the construction has no refusal arm and hands back no Result.";
  let storage = box_slots_new::<T>(capacity: 0_u64);
  return GrowVector<T>(storage: move storage);
}

fn grow_vector_reserve<T>(values: &GrowVector<T>, total: own u64) -> capacity: own u64 writes(values.storage) contract {
  ensures capacity == deref(values).storage.inner.cap;
  ensures capacity >= total;
  ensures deref(values).storage.inner.len == deref(entry(values)).storage.inner.len;
} {
  doc "Raises capacity to at least total, preserving the window. grow remakes the cell's content whole and may reallocate in place [OP-10], so there is no superseded backing to release here.";
  let current = deref(values).storage.inner.cap;
  if current >= total {
    return current;
  }
  grow(cell: &deref(values).storage, capacity: total);
  return total;
}

fn grow_vector_append<T>(values: &GrowVector<T>, value: own T) -> length: own u64 writes(values.storage) contract {
  ensures length == deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len == deref(entry(values)).storage.inner.len + 1_u64;
} {
  doc "Appends one value, doubling full nonempty backing and taking one slot when the backing is empty. The doubling ceiling is what discharges the allocation-size obligation [OP-9].";
  let spare = deref(values).storage.inner.cap - deref(values).storage.inner.len;
  if spare > 0_u64 {
    place_back(window: &deref(values).storage.inner, value: move value);
    let reached = deref(values).storage.inner.len;
    return reached;
  }
  let current = deref(values).storage.inner.cap;
  if current == 0_u64 {
    let opened = grow_vector_reserve::<T>(values: values, total: 1_u64);
    place_back(window: &deref(values).storage.inner, value: move value);
    let reached = deref(values).storage.inner.len;
    return reached;
  }
  if current <= 9223372036854775807_u64 {
    let doubled = current + current;
    let widened = grow_vector_reserve::<T>(values: values, total: doubled);
    place_back(window: &deref(values).storage.inner, value: move value);
    let reached = deref(values).storage.inner.len;
    return reached;
  }
  let stretched = grow_vector_reserve::<T>(values: values, total: 18446744073709551615_u64);
  place_back(window: &deref(values).storage.inner, value: move value);
  let reached = deref(values).storage.inner.len;
  return reached;
}

fn grow_vector_insert<T>(values: &GrowVector<T>, index: own u64, value: own T) -> length: own u64 writes(values.storage) contract {
  requires index <= deref(values).storage.inner.len;
  ensures length == deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len == deref(entry(values)).storage.inner.len + 1_u64;
} {
  doc "Inserts before a proved index and preserves order. The manual exchange-and-shift loop v0.59 wrote for this retired with [OP-10]'s insert_at, which is the one operation that writes the append slot and the filled run together.";
  let spare = deref(values).storage.inner.cap - deref(values).storage.inner.len;
  if spare > 0_u64 {
    insert_at(window: &deref(values).storage.inner, index: index, value: move value);
    let reached = deref(values).storage.inner.len;
    return reached;
  }
  let current = deref(values).storage.inner.cap;
  if current == 0_u64 {
    let opened = grow_vector_reserve::<T>(values: values, total: 1_u64);
    insert_at(window: &deref(values).storage.inner, index: index, value: move value);
    let reached = deref(values).storage.inner.len;
    return reached;
  }
  if current <= 9223372036854775807_u64 {
    let doubled = current + current;
    let widened = grow_vector_reserve::<T>(values: values, total: doubled);
    insert_at(window: &deref(values).storage.inner, index: index, value: move value);
    let reached = deref(values).storage.inner.len;
    return reached;
  }
  let stretched = grow_vector_reserve::<T>(values: values, total: 18446744073709551615_u64);
  insert_at(window: &deref(values).storage.inner, index: index, value: move value);
  let reached = deref(values).storage.inner.len;
  return reached;
}

fn grow_vector_remove<T>(values: &GrowVector<T>, index: own u64) -> removed: own T writes(values.storage) contract {
  requires index < deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len + 1_u64 == deref(entry(values)).storage.inner.len;
  ensures deref(values).storage.inner.cap == deref(entry(values)).storage.inner.cap;
} {
  doc "Removes a proved index and preserves order. As with insert, the shift loop retired with [OP-10]'s remove_at.";
  let taken = remove_at(window: &deref(values).storage.inner, index: index);
  return move taken;
}

fn grow_vector_drain<VectorDrain<T, E>>(values: &GrowVector<T>, env: &E) -> result: own unit writes(values.storage), writes(env) contract {
  ensures deref(values).storage.inner.len == 0_u64;
  ensures deref(values).storage.inner.cap == deref(entry(values)).storage.inner.cap;
} {
  doc "Moves every value front to back into the caller's monomorphized behavior, leaving the backing in place and the window empty.";
  loop @drain {
    let remaining = deref(values).storage.inner.len;
    if remaining == 0_u64 {
      break @drain;
    }
    let value = remove_at(window: &deref(values).storage.inner, index: 0_u64);
    VectorDrain::accept(env: env, value: move value);
  }
  return unit;
}
