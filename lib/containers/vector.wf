struct GrowVector<T: linear>['s] {
  storage: Vector<'s, T>;
}

formal VectorDrain<T: linear, E: linear> {
  fn accept(env: &uniq E, value: own T) -> result: own unit reads(env), writes(env);
}

fn grow_vector_new<T: linear>['s](store: &uniq Heap<'s>) -> made: own Option<GrowVector<'s, T>> reads(store), writes(store), allocates(store) {
  region {
    match heap_vector::<T>(store: &uniq deref(store), count: 0_u64) {
      None() => {
        return None<GrowVector<'s, T>>();
      }
      Some(value: storage) => {
        let result = GrowVector<T>(storage: move storage);
        return Some<GrowVector<'s, T>>(value: move result);
      }
    }
  }
}

fn grow_vector_reallocate<T: linear>['s](values: &uniq GrowVector<'s, T>, store: &uniq Heap<'s>, total: own u64, original: own u64) -> outcome: own Result<u64, unit> reads(values.storage, store), writes(values.storage, store), allocates(store) contract {
  requires total > cap_of(deref(values).storage);
  requires original == len_of(deref(values).storage);
  ensures len_of(deref(values).storage) == original;
  ensures when Ok(value: capacity): capacity == cap_of(deref(values).storage);
  ensures when Ok(value: capacity): capacity == total;
  ensures when Ok(value: capacity): room_of(deref(values).storage) > 0_u64;
} {
  let representable = buffer_fits::<T>(total);
  if representable {
  } else {
    return Err<u64, unit>(error: unit);
  }
  let count = original;
  region {
    match heap_vector::<T>(store: &uniq deref(store), count: total) {
      None() => {
        return Err<u64, unit>(error: unit);
      }
      Some(value: fresh) => {
        let built = move fresh;
        for @move (
          at in 0_u64..count,
          invariant left_lo: len_of(deref(values).storage) + at >= count,
          invariant left_hi: len_of(deref(values).storage) + at <= count,
          invariant wider: total >= count + 1_u64,
          invariant made_lo: len_of(built) >= at,
          invariant made_hi: len_of(built) <= at,
          invariant spare_lo: room_of(built) + at >= total,
          invariant spare_hi: room_of(built) + at <= total,
          invariant usable: room_of(built) + at >= count + 1_u64,
          invariant cap_lo: cap_of(built) >= total,
          invariant cap_hi: cap_of(built) <= total,
          invariant flat: head_of(built) <= 0_u64
        ) {
          let value = take_front(vector: &uniq deref(values).storage);
          place_back(vector: &uniq built, value: move value);
        }
        let old = replace deref(values).storage = move built;
        dispose old;
        return Ok<u64, unit>(value: total);
      }
    }
  }
}

fn grow_vector_reserve<T: linear>['s](values: &uniq GrowVector<'s, T>, store: &uniq Heap<'s>, total: own u64) -> outcome: own Result<u64, unit> reads(values.storage, store), writes(values.storage, store), allocates(store) contract {
  ensures len_of(deref(values).storage) == len_of(deref(entry(values)).storage);
  ensures when Ok(value: capacity): capacity == cap_of(deref(values).storage);
  ensures when Ok(value: capacity): capacity >= total;
} {
  let current = cap_of(deref(values).storage);
  let original = len_of(deref(values).storage);
  if current >= total {
    return Ok<u64, unit>(value: current);
  }
  region {
    match grow_vector_reallocate::<T>(values: &uniq deref(values), store: &uniq deref(store), total: total, original: original) {
      Err(error: marker) => {
        return Err<u64, unit>(error: unit);
      }
      Ok(value: capacity) => {
        return Ok<u64, unit>(value: capacity);
      }
    }
  }
}

fn grow_vector_append<T: linear>['s](values: &uniq GrowVector<'s, T>, store: &uniq Heap<'s>, value: own T) -> outcome: own Result<u64, T> reads(values.storage, store), writes(values.storage, store), allocates(store) contract {
  ensures len_of(deref(values).storage) >= len_of(deref(entry(values)).storage);
  ensures len_of(deref(values).storage) <= len_of(deref(entry(values)).storage) + 1_u64;
  ensures when Ok(value: length): length == len_of(deref(values).storage);
  ensures when Ok(value: length): len_of(deref(values).storage) == len_of(deref(entry(values)).storage) + 1_u64;
} {
  let spare = room_of(deref(values).storage);
  if spare > 0_u64 {
    region {
      place_back(vector: &uniq deref(values).storage, value: move value);
      let length = len_of(deref(values).storage);
      return Ok<u64, T>(value: length);
    }
  }
  let current = cap_of(deref(values).storage);
  let original = len_of(deref(values).storage);
  if current > 0_u64 {
    if current <= 9223372036854775807_u64 {
      let doubled = current + current;
      region {
        match grow_vector_reallocate::<T>(values: &uniq deref(values), store: &uniq deref(store), total: doubled, original: original) {
          Err(error: marker) => {
            return Err<u64, T>(error: move value);
          }
          Ok(value: capacity) => {
            place_back(vector: &uniq deref(values).storage, value: move value);
            let length = len_of(deref(values).storage);
            return Ok<u64, T>(value: length);
          }
        }
      }
    }
    return Err<u64, T>(error: move value);
  }
  region {
    match grow_vector_reallocate::<T>(values: &uniq deref(values), store: &uniq deref(store), total: 1_u64, original: original) {
      Err(error: marker) => {
        return Err<u64, T>(error: move value);
      }
      Ok(value: capacity) => {
        place_back(vector: &uniq deref(values).storage, value: move value);
        let length = len_of(deref(values).storage);
        return Ok<u64, T>(value: length);
      }
    }
  }
}

fn grow_vector_exchange<T: linear>['s](values: &uniq GrowVector<'s, T>, left: own u64, right: own u64) -> result: own unit reads(values.storage), writes(values.storage) contract {
  requires left < len_of(deref(values).storage);
  requires right < len_of(deref(values).storage);
  ensures len_of(deref(values).storage) == len_of(deref(entry(values)).storage);
  ensures room_of(deref(values).storage) == room_of(deref(entry(values)).storage);
  ensures cap_of(deref(values).storage) == cap_of(deref(entry(values)).storage);
  ensures head_of(deref(values).storage) == head_of(deref(entry(values)).storage);
} {
  if left == right {
    return unit;
  }
  region {
    let tail = take_back(vector: &uniq deref(values).storage);
    let end = len_of(deref(values).storage);
    if left == end {
      let previous = replace deref(values).storage[right] = move tail;
      place_back(vector: &uniq deref(values).storage, value: move previous);
      return unit;
    }
    if right == end {
      let previous = replace deref(values).storage[left] = move tail;
      place_back(vector: &uniq deref(values).storage, value: move previous);
      return unit;
    }
    let left_value = replace deref(values).storage[left] = move tail;
    let right_value = replace deref(values).storage[right] = move left_value;
    let saved_tail = replace deref(values).storage[left] = move right_value;
    place_back(vector: &uniq deref(values).storage, value: move saved_tail);
    return unit;
  }
}

fn grow_vector_insert<T: linear>['s](values: &uniq GrowVector<'s, T>, store: &uniq Heap<'s>, index: own u64, value: own T) -> outcome: own Result<u64, T> reads(values.storage, store), writes(values.storage, store), allocates(store) contract {
  requires index <= len_of(deref(values).storage);
  ensures len_of(deref(values).storage) >= len_of(deref(entry(values)).storage);
  ensures len_of(deref(values).storage) <= len_of(deref(entry(values)).storage) + 1_u64;
  ensures when Ok(value: length): length == len_of(deref(values).storage);
  ensures when Ok(value: length): len_of(deref(values).storage) == len_of(deref(entry(values)).storage) + 1_u64;
} {
  let before = len_of(deref(values).storage);
  region {
    match grow_vector_append::<T>(values: &uniq deref(values), store: &uniq deref(store), value: move value) {
      Err(error: back) => {
        return Err<u64, T>(error: move back);
      }
      Ok(value: length) => {
        let cursor = before;
        loop @shift (
          invariant floor: cursor >= index,
          invariant live: cursor < len_of(deref(values).storage),
          invariant held: len_of(deref(values).storage) >= before + 1_u64,
          invariant ceiling: len_of(deref(values).storage) <= before + 1_u64
        ) {
          if cursor > index {
            let previous = cursor - 1_u64;
            grow_vector_exchange::<T>(values: &uniq deref(values), left: previous, right: cursor);
            set cursor = previous;
          } else {
            return Ok<u64, T>(value: length);
          }
        }
        return Ok<u64, T>(value: length);
      }
    }
  }
}

fn grow_vector_remove_shift<T: linear>['s](values: &uniq GrowVector<'s, T>, index: own u64, original: own u64, spare: own u64, capacity: own u64, origin: own u64) -> removed: own T reads(values.storage), writes(values.storage) contract {
  requires index < len_of(deref(values).storage);
  requires original == len_of(deref(values).storage);
  requires spare == room_of(deref(values).storage);
  requires capacity == cap_of(deref(values).storage);
  requires origin == head_of(deref(values).storage);
  ensures len_of(deref(values).storage) + 1_u64 == original;
  ensures room_of(deref(values).storage) == spare + 1_u64;
  ensures cap_of(deref(values).storage) == capacity;
  ensures head_of(deref(values).storage) == origin;
} {
  let count = original;
  let last = count - 1_u64;
  let cursor = index;
  loop @shift (
    invariant floor: cursor >= index,
    invariant live: cursor < count,
    invariant length_lo: len_of(deref(values).storage) >= count,
    invariant length_hi: len_of(deref(values).storage) <= count,
    invariant room_lo: room_of(deref(values).storage) >= spare,
    invariant room_hi: room_of(deref(values).storage) <= spare,
    invariant cap_lo: cap_of(deref(values).storage) >= capacity,
    invariant cap_hi: cap_of(deref(values).storage) <= capacity,
    invariant head_lo: head_of(deref(values).storage) >= origin,
    invariant head_hi: head_of(deref(values).storage) <= origin
  ) {
    if cursor < last {
      let next = cursor + 1_u64;
      grow_vector_exchange::<T>(values: &uniq deref(values), left: cursor, right: next);
      set cursor = next;
    } else {
      let result = take_back(vector: &uniq deref(values).storage);
      return move result;
    }
  }
  region {
    let result = take_back(vector: &uniq deref(values).storage);
    return move result;
  }
}

fn grow_vector_remove<T: linear>['s](values: &uniq GrowVector<'s, T>, index: own u64) -> removed: own T reads(values.storage), writes(values.storage) contract {
  requires index < len_of(deref(values).storage);
  ensures len_of(deref(values).storage) + 1_u64 == len_of(deref(entry(values)).storage);
  ensures room_of(deref(values).storage) == room_of(deref(entry(values)).storage) + 1_u64;
  ensures cap_of(deref(values).storage) == cap_of(deref(entry(values)).storage);
  ensures head_of(deref(values).storage) == head_of(deref(entry(values)).storage);
} {
  let original = len_of(deref(values).storage);
  let spare = room_of(deref(values).storage);
  let capacity = cap_of(deref(values).storage);
  let origin = head_of(deref(values).storage);
  region {
    let result = grow_vector_remove_shift::<T>(values: &uniq deref(values), index: index, original: original, spare: spare, capacity: capacity, origin: origin);
    return move result;
  }
}

fn grow_vector_drain<VectorDrain<T, E>>['s](values: &uniq GrowVector<'s, T>, env: &uniq E) -> result: own unit reads(values.storage, env), writes(values.storage, env) contract {
  ensures len_of(deref(values).storage) == 0_u64;
  ensures cap_of(deref(values).storage) == cap_of(deref(entry(values)).storage);
} {
  let count = len_of(deref(values).storage);
  let capacity = cap_of(deref(values).storage);
  for @drain (
    at in 0_u64..count,
    invariant left_lo: len_of(deref(values).storage) + at >= count,
    invariant left_hi: len_of(deref(values).storage) + at <= count,
    invariant room_lo: room_of(deref(values).storage) >= at,
    invariant room_hi: room_of(deref(values).storage) <= cap_of(deref(values).storage),
    invariant cap_lo: cap_of(deref(values).storage) >= capacity,
    invariant cap_hi: cap_of(deref(values).storage) <= capacity
  ) {
    let value = take_front(vector: &uniq deref(values).storage);
    VectorDrain::accept(env: &uniq deref(env), value: move value);
  }
  return unit;
}
