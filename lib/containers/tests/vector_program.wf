struct Sum {
  total: u64;
}

struct OwnedItem {
  id: u64;
}

fn sum_accept(env: &uniq Sum, value: own u64) -> result: own unit reads(env.total), writes(env.total) {
  set deref(env).total = deref(env).total +wrap value;
  return unit;
}

actual SumDrain : VectorDrain<u64, Sum> {
  accept = sum_accept;
}

fn owned_item_id['s](item: &Box<'s, OwnedItem>) -> result: own u64 reads(item) {
  return deref(deref(item)).id;
}

fn main['heap](heap: own Heap<'heap>) -> status: own ExitStatus reads(heap), writes(heap), allocates(heap) {
  region {
    match grow_vector_new::<u64>(store: &uniq heap) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: values) => {
        region {
          let first = grow_vector_append::<u64>(values: &uniq values, store: &uniq heap, value: 11_u64);
          match first {
            Ok(value: length) => {
            }
            Err(error: back) => {
              return exit_status(code: 70_u8);
            }
          }
        }
        region {
          let second = grow_vector_append::<u64>(values: &uniq values, store: &uniq heap, value: 33_u64);
          match second {
            Ok(value: length) => {
            }
            Err(error: back) => {
              return exit_status(code: 70_u8);
            }
          }
        }
        let before_insert = len_of(values.storage);
        if before_insert >= 1_u64 {
        } else {
          return exit_status(code: 1_u8);
        }
        region {
          let middle = grow_vector_insert::<u64>(values: &uniq values, store: &uniq heap, index: 1_u64, value: 22_u64);
          match middle {
            Ok(value: length) => {
            }
            Err(error: back) => {
              return exit_status(code: 70_u8);
            }
          }
        }
        let held = len_of(values.storage);
        if held == 3_u64 {
        } else {
          return exit_status(code: 1_u8);
        }
        let first_value = values.storage[0_u64];
        let middle_value = values.storage[1_u64];
        let last_value = values.storage[2_u64];
        if first_value == 11_u64 {
        } else {
          return exit_status(code: 2_u8);
        }
        if middle_value == 22_u64 {
        } else {
          return exit_status(code: 3_u8);
        }
        if last_value == 33_u64 {
        } else {
          return exit_status(code: 4_u8);
        }
        region {
          let removed = grow_vector_remove::<u64>(values: &uniq values, index: 1_u64);
          if removed == 22_u64 {
          } else {
            return exit_status(code: 5_u8);
          }
        }
        let sum = Sum(total: 0_u64);
        region {
          grow_vector_drain::<SumDrain>(values: &uniq values, env: &uniq sum);
        }
        if sum.total == 44_u64 {
        } else {
          return exit_status(code: 6_u8);
        }
        let empty = len_of(values.storage);
        if empty == 0_u64 {
        } else {
          return exit_status(code: 7_u8);
        }
      }
    }
  }
  region {
    match grow_vector_new::<Box<'heap, OwnedItem>>(store: &uniq heap) {
      None() => {
        return exit_status(code: 70_u8);
      }
      Some(value: owners) => {
        let first_item = OwnedItem(id: 101_u64);
        match heap_box(store: &uniq heap, value: move first_item) {
          Err(error: item) => {
            return exit_status(code: 70_u8);
          }
          Ok(value: first) => {
            region {
              match grow_vector_append::<Box<'heap, OwnedItem>>(values: &uniq owners, store: &uniq heap, value: move first) {
                Err(error: back) => {
                  dispose back;
                  return exit_status(code: 70_u8);
                }
                Ok(value: length) => {
                }
              }
            }
          }
        }
        let third_item = OwnedItem(id: 303_u64);
        match heap_box(store: &uniq heap, value: move third_item) {
          Err(error: item) => {
            return exit_status(code: 70_u8);
          }
          Ok(value: third) => {
            region {
              match grow_vector_append::<Box<'heap, OwnedItem>>(values: &uniq owners, store: &uniq heap, value: move third) {
                Err(error: back) => {
                  dispose back;
                  return exit_status(code: 70_u8);
                }
                Ok(value: length) => {
                }
              }
            }
          }
        }
        let before_owned_insert = len_of(owners.storage);
        if before_owned_insert >= 1_u64 {
        } else {
          return exit_status(code: 8_u8);
        }
        let second_item = OwnedItem(id: 202_u64);
        match heap_box(store: &uniq heap, value: move second_item) {
          Err(error: item) => {
            return exit_status(code: 70_u8);
          }
          Ok(value: second) => {
            region {
              match grow_vector_insert::<Box<'heap, OwnedItem>>(values: &uniq owners, store: &uniq heap, index: 1_u64, value: move second) {
                Err(error: back) => {
                  dispose back;
                  return exit_status(code: 70_u8);
                }
                Ok(value: length) => {
                }
              }
            }
          }
        }
        let owned_length = len_of(owners.storage);
        if owned_length == 3_u64 {
        } else {
          return exit_status(code: 9_u8);
        }
        region {
          let removed = grow_vector_remove::<Box<'heap, OwnedItem>>(values: &uniq owners, index: 1_u64);
          if deref(removed).id == 202_u64 {
          } else {
            return exit_status(code: 10_u8);
          }
          dispose removed;
        }
        region {
          let first_id = owned_item_id(item: &owners.storage[0_u64]);
          if first_id == 101_u64 {
          } else {
            return exit_status(code: 11_u8);
          }
        }
        region {
          let last_id = owned_item_id(item: &owners.storage[1_u64]);
          if last_id == 303_u64 {
          } else {
            return exit_status(code: 12_u8);
          }
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
